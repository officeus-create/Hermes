#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${HERMES_REPO_ROOT:-$(cd "$SCRIPT_DIR/../.." && pwd)}"
HERMES_AI_HOME="${HERMES_AI_HOME:-$HOME/.hermes-ai}"
FCC_VENV="${HERMES_FCC_VENV:-$HERMES_AI_HOME/fcc-venv}"
FCC_CODEX="$FCC_VENV/bin/fcc-codex"
export CODEX_HOME="${HERMES_CODEX_HOME:-$HOME/.codex-hermes}"

if [[ ! -x "$FCC_CODEX" ]]; then
  printf '[codex-hermes] FCC runtime is missing at %s\n' "$FCC_CODEX" >&2
  printf '[codex-hermes] Run: ./scripts/ai/setup-codex-hermes.sh\n' >&2
  exit 127
fi

if ! command -v codex >/dev/null 2>&1; then
  printf '[codex-hermes] Official Codex CLI is not on PATH. This wrapper will not install or replace it.\n' >&2
  exit 127
fi

[[ -f "$REPO_ROOT/AGENTS.md" ]] || {
  printf '[codex-hermes] Hermes repository boundary not found at %s\n' "$REPO_ROOT" >&2
  exit 2
}

mkdir -p "$CODEX_HOME"
chmod 700 "$CODEX_HOME" 2>/dev/null || true

# Detect the browser-queued Internal AI path before removing its transport
# credential from the child environment. Manual codex-hermes usage intentionally
# keeps the historical direct exec path below.
RUNNER_SANITIZE=0
if [[ -n "${HERMES_INTERNAL_AI_RUNNER_TOKEN:-}" ]]; then
  RUNNER_SANITIZE=1
fi

# Internal AI transport/bootstrap credentials belong to the parent control
# plane only. Never inherit them into FCC/Codex, even when the runner starts
# this wrapper with a copied environment.
unset HERMES_INTERNAL_AI_RUNNER_TOKEN
unset HERMES_INTERNAL_OWNER_BOOTSTRAP_TOKEN

# FCC writes an external-auth helper into its temporary Codex configuration.
# Keep only FCC's isolated virtualenv ahead of the inherited PATH so routed
# requests can resolve that helper without replacing the ordinary Codex CLI or
# changing the user's system PATH outside this process.
export PATH="$FCC_VENV/bin:$PATH"

# Optional per-run route overrides. When unset, FCC's managed Model Config owns
# the primary model and fallback chain. Values must use FCC provider/model refs.
if [[ -n "${HERMES_CODEX_MODEL:-}" ]]; then
  export MODEL="$HERMES_CODEX_MODEL"
fi
if [[ -n "${HERMES_CODEX_FALLBACKS:-}" ]]; then
  export MODEL_FALLBACKS="$HERMES_CODEX_FALLBACKS"
fi

export HERMES_CODEX_RUNTIME="fcc"
export HERMES_CODEX_REPO="$REPO_ROOT"

cd "$REPO_ROOT"

if [[ "$RUNNER_SANITIZE" == "1" ]]; then
  SANITIZER="$SCRIPT_DIR/hermes-internal-ai-sanitize.py"
  [[ -r "$SANITIZER" ]] || {
    printf '[codex-hermes] Internal AI output sanitizer is missing or unreadable at %s; refusing to start unsanitized runner execution.\n' "$SANITIZER" >&2
    exit 74
  }
  command -v python3 >/dev/null 2>&1 || {
    printf '[codex-hermes] python3 is required for the Internal AI output sanitizer; refusing to start unsanitized runner execution.\n' >&2
    exit 74
  }

  # Defense in depth: the streaming filter removes credential-shaped output
  # before it reaches the Python runner. The runner applies its own sanitizer
  # again before uploading events/results. Preserve the FCC/Codex exit code and
  # fail closed if the sanitizer itself fails.
  set +e
  "$FCC_CODEX" "$@" 2>&1 | python3 "$SANITIZER"
  pipeline_status=("${PIPESTATUS[@]}")
  set -e

  if [[ "${pipeline_status[1]:-1}" -ne 0 ]]; then
    printf '[codex-hermes] Internal AI output sanitizer failed; refusing to treat output as safe evidence.\n' >&2
    exit 74
  fi
  exit "${pipeline_status[0]:-1}"
fi

exec "$FCC_CODEX" "$@"
