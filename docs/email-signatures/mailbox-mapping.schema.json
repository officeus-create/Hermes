{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Gmail signature mailbox mapping",
  "type": "object",
  "required": ["version", "mailboxes"],
  "properties": {
    "version": { "const": "1" },
    "mailboxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["email", "accountType", "department", "signatureFile", "verification"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "accountType": { "enum": ["personal", "generic"] },
          "department": { "enum": ["Partnerships", "Logistics", "Marketing", "Academy", "Technology / IT", "Hermes Connect", "HR / Recruiting", "General Office"] },
          "signatureFile": { "type": "string", "pattern": "^html/[a-z0-9-]+\\.html$" },
          "displayName": { "type": "string", "minLength": 2 },
          "role": { "type": "string", "minLength": 2 },
          "phone": { "type": "string", "minLength": 7 },
          "verification": {
            "type": "object",
            "required": ["source", "verifiedAt", "verifiedBy"],
            "properties": {
              "source": { "type": "string", "minLength": 3 },
              "verifiedAt": { "type": "string", "format": "date" },
              "verifiedBy": { "type": "string", "minLength": 2 }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": { "properties": { "accountType": { "const": "personal" } } },
            "then": { "required": ["displayName", "role"] }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
