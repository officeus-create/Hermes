# Preview is the safe default and performs no network request.
PUBLIC_CONTACT_MODE=preview

# Secret required later, not used in v1.1.
# Set only to an approved HTTPS endpoint when PUBLIC_CONTACT_MODE=live.
PUBLIC_CONTACT_ENDPOINT=

# Hermes Connect scheduled inactivity reminders authenticate GitHub Actions with
# short-lived GitHub OIDC tokens. No shared scheduler secret is required.
#
# Optional key separation for one-click reminder unsubscribe signatures.
# If omitted, the server derives this purpose from the already-required
# LEAD_SERVICE_TOKEN used by the account-email delivery service.
# Never expose a real value to browser code or commit it.
HERMES_CONNECT_REMINDER_UNSUBSCRIBE_SECRET=
