# Preview is the safe default and performs no network request.
PUBLIC_CONTACT_MODE=preview

# Secret required later, not used in v1.1.
# Set only to an approved HTTPS endpoint when PUBLIC_CONTACT_MODE=live.
PUBLIC_CONTACT_ENDPOINT=

# Server-only token for the Hermes Connect scheduled inactivity-reminder endpoint.
# Configure the same secret in the production runtime and GitHub Actions before enabling delivery.
# Never expose this value to browser code or commit a real token.
HERMES_CONNECT_REMINDER_JOB_TOKEN=
