{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hermes",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-07-29",
  "vars": {
    "ALLOWED_ORIGIN": "https://hermeslogisticsus.com",
    "SALES_DESTINATION": "officeus@hermeslogisticsus.com",
    "SALES_SENDER": "website@hermeslogisticsus.com"
  }

  // LEAD_LIMITS and LEAD_EMAIL stay intentionally disabled.
  // Add the approved KV namespace and verified Email Sending binding only
  // after the Cloudflare account is connected and a preview deployment passes.
}
