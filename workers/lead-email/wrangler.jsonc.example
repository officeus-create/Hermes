{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hermes-lead-email",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "no_bundle": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "SALES_DESTINATION": "officeus@hermeslogisticsus.com",
    "SALES_SENDER": "website@hermeslogisticsus.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "officeus@hermeslogisticsus.com",
      "allowed_sender_addresses": [
        "website@hermeslogisticsus.com"
      ]
    }
  ]
}
