{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hermes-lead-email",
  "main": "src/entry.mjs",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "no_bundle": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "SALES_DESTINATION": "officeus@hermeslogisticsus.com",
    "SALES_SENDER": "website@hermeslogisticsus.com",
    "LOADBOARD_EMAIL_RECIPIENT": "loads@hermeslogisticsus.com",
    "LOADBOARD_INGEST_URL": "https://hermeslogisticsus.com/api/load-board/intake",
    "LOADBOARD_EMAIL_SOURCE_CONFIG": "{\"approved-source@example.com\":{\"id\":\"source_example\",\"name\":\"Approved Source\",\"redistribution_permission\":\"internal_only\",\"requested_visibility\":\"internal_only\",\"contact_reveal_permission\":\"hidden\",\"ttl_hours\":12}}"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "officeus@hermeslogisticsus.com",
      "allowed_sender_addresses": [
        "website@hermeslogisticsus.com"
      ]
    }
  ]
}
