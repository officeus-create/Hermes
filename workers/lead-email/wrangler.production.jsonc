{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hermes-lead-email",
  "account_id": "ec00de0c2f5ffd6fda4034ca98f992f9",
  "main": "src/entry.mjs",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "no_bundle": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "SALES_DESTINATION": "officeus@hermeslogisticsus.com",
    "SALES_SENDER": "website@hermeslogisticsus.com",
    "CARRIER_CONTRACT_INTERNAL_RECIPIENTS": "officeus@hermeslogisticsus.com",
    "LOADBOARD_EMAIL_RECIPIENT": "loads@hermeslogisticsus.com",
    "LOADBOARD_INGEST_URL": "https://hermeslogisticsus.com/api/load-board/intake"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "website@hermeslogisticsus.com"
      ]
    }
  ]
}
