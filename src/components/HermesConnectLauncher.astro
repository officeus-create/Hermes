---
import { ArrowUpRight } from "@lucide/astro";
import "../styles/hermes-connect-knot-core.css";

export interface Props {
  variant?: "header" | "mobile" | "footer" | "banner" | "inline";
  label?: string;
  sublabel?: string;
  context?: "logistics" | "marketing" | "academy" | "technology" | "beauty" | "general";
  href?: string;
  class?: string;
}

const {
  variant = "header",
  label,
  sublabel,
  context = "general",
  href,
  class: className = "",
} = Astro.props;

const path = Astro.url.pathname;
const isHermesConnectRoute = path.startsWith("/services/hermes-connect");
const requestedLocale = Astro.url.searchParams.get("lang");
const routeLocale = path === "/ru" || path.startsWith("/ru/") ? "ru" : "en";
const activeLocale = isHermesConnectRoute && requestedLocale === "ru" ? "ru" : routeLocale;

const copy = {
  en: {
    context: {
      general: "Repair Shops is the current live pilot",
      logistics: "Repair Shops is live; logistics modules are reference capabilities",
      marketing: "Repair Shops is live; growth modules are reference capabilities",
      academy: "Repair Shops is live; training modules are reference capabilities",
      technology: "Repair Shops is live; automation modules are reference capabilities",
      beauty: "Repair Shops is live; beauty modules are reference capabilities",
    },
    openProduct: "Open product",
    currentProduct: "Current product",
    footerBody: "One product family. Repair Shops is the current live pilot; other modules are reference capabilities until production verification.",
    openHub: "Open Hermes Connect Product Hub",
    currentFamily: "Hermes Connect · Current product family",
    explore: "Explore Hermes Connect",
    bannerSuffix: "No legacy workspace or historical pricing is presented as the current product.",
  },
  ru: {
    context: {
      general: "СТО — текущий рабочий пилот",
      logistics: "СТО уже работает; логистические модули пока показаны как справочные возможности",
      marketing: "СТО уже работает; модули роста пока показаны как справочные возможности",
      academy: "СТО уже работает; учебные модули пока показаны как справочные возможности",
      technology: "СТО уже работает; модули автоматизации пока показаны как справочные возможности",
      beauty: "СТО уже работает; beauty-модули пока показаны как справочные возможности",
    },
    openProduct: "Открыть продукт",
    currentProduct: "Текущий продукт",
    footerBody: "Единое семейство продуктов. СТО — текущий рабочий пилот; остальные модули остаются справочными возможностями до проверки в production.",
    openHub: "Открыть центр Hermes Connect",
    currentFamily: "Hermes Connect · текущее семейство продуктов",
    explore: "Открыть Hermes Connect",
    bannerSuffix: "Устаревшие рабочие пространства и исторические цены не показываются как текущий продукт.",
  },
} as const;

const localeCopy = copy[activeLocale];
const displayTitle = label || "Hermes Connect";
const providedSublabel = activeLocale === "ru" && sublabel === "Repair Shops · current live pilot"
  ? "СТО · текущий рабочий пилот"
  : sublabel;
const displaySubtitle = providedSublabel || localeCopy.context[context] || localeCopy.context.general;
const computedHref = href || "/services/hermes-connect/";
const localizedHref = (() => {
  if (activeLocale !== "ru" || !computedHref.startsWith("/services/hermes-connect/")) return computedHref;
  const url = new URL(computedHref, "https://hermeslogisticsus.com");
  url.searchParams.set("lang", "ru");
  return `${url.pathname}${url.search}${url.hash}`;
})();
const connectMark = "/demos/hermes-connect/icon-192.svg";
---

{isHermesConnectRoute && variant === "header" && <span hidden data-hc-server-route="connect"></span>}

{variant === "header" && (
  <a href={localizedHref} class={`hc-launcher hc-launcher-header hermes-connect-header-launcher ${className}`} data-hermes-connect-launcher="header" aria-label={`${displayTitle} — ${displaySubtitle}`}>
    <img class="hc-brand-mark hermes-knot-mark" src={connectMark} width="22" height="22" loading="eager" alt="Hermes Connect mark" />
    <span>{displayTitle}</span>
    <ArrowUpRight size={15} aria-hidden="true" />
  </a>
)}

{variant === "mobile" && (
  <a href={localizedHref} class={`hc-launcher-mobile ${className}`} data-hermes-connect-launcher="mobile">
    <img class="hc-brand-mark hc-brand-mark-mobile hermes-knot-mark" src={connectMark} width="30" height="30" loading="eager" alt="Hermes Connect mark" />
    <div><strong>{displayTitle}</strong><small>{displaySubtitle}</small></div>
    <span>{localeCopy.openProduct} <ArrowUpRight size={16} aria-hidden="true" /></span>
  </a>
)}

{variant === "footer" && (
  <div class={`hc-launcher-panel ${className}`} data-hermes-connect-launcher="footer">
    <div class="hc-launcher-panel-head">
      <span class="hc-launcher-panel-brand"><img class="hc-brand-mark hermes-knot-mark" src={connectMark} width="24" height="24" loading="lazy" alt="Hermes Connect mark" /><strong>Hermes Connect</strong></span>
      <span>{localeCopy.currentProduct}</span>
    </div>
    <p>{localeCopy.footerBody}</p>
    <a href={localizedHref}><img class="hc-brand-mark hc-brand-mark-link hermes-knot-mark" src={connectMark} width="20" height="20" loading="lazy" alt="Hermes Connect mark" />{localeCopy.openHub} <ArrowUpRight size={16} aria-hidden="true" /></a>
  </div>
)}

{variant === "banner" && (
  <section class={`hc-launcher-banner ${className}`} data-hermes-connect-launcher="banner">
    <div>
      <span class="hc-launcher-badge"><img class="hc-brand-mark hermes-knot-mark" src={connectMark} width="20" height="20" loading="lazy" alt="Hermes Connect mark" /> {localeCopy.currentFamily}</span>
      <h3>{displayTitle}</h3>
      <p>{displaySubtitle}. {localeCopy.bannerSuffix}</p>
    </div>
    <a href={localizedHref}><img class="hc-brand-mark hc-brand-mark-link hermes-knot-mark" src={connectMark} width="20" height="20" loading="lazy" alt="Hermes Connect mark" />{localeCopy.explore} <ArrowUpRight size={17} aria-hidden="true" /></a>
  </section>
)}

{variant === "inline" && (
  <a href={localizedHref} class={`hc-launcher-inline ${className}`} data-hermes-connect-launcher="inline">
    <img class="hc-brand-mark hc-brand-mark-inline hermes-knot-mark" src={connectMark} width="18" height="18" loading="lazy" alt="Hermes Connect mark" /><span>{displayTitle}</span><ArrowUpRight size={14} aria-hidden="true" />
  </a>
)}

<style>
  .hc-brand-mark{display:block;flex:0 0 auto;border-radius:6px;box-shadow:0 6px 18px rgba(92,78,255,.18)}
  .hc-brand-mark-mobile{grid-row:1 / span 2}.hc-brand-mark-link{margin-right:.05rem}.hc-brand-mark-inline{border-radius:5px}
  .hc-launcher{display:inline-flex;align-items:center;gap:.42rem;text-decoration:none}.hc-launcher-header{padding:.35rem .72rem .35rem .38rem;border:1px solid rgba(157,136,255,.3);border-radius:999px;background:rgba(109,40,217,.12);color:#f8fafc;font-size:.82rem;font-weight:700}.hc-launcher-header:hover{background:rgba(109,40,217,.24);border-color:rgba(157,136,255,.5)}
  .hc-launcher-mobile{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.75rem 1rem;padding:1rem;border:1px solid rgba(157,136,255,.22);border-radius:14px;background:rgba(13,17,27,.9);color:#fff;text-decoration:none}.hc-launcher-mobile div{min-width:0}.hc-launcher-mobile strong,.hc-launcher-mobile small{display:block}.hc-launcher-mobile small{margin-top:.2rem;color:#9ba7ba;font-size:.72rem;line-height:1.35}.hc-launcher-mobile>span{display:inline-flex;align-items:center;gap:.3rem;white-space:nowrap;color:#bcaeff;font-size:.8rem;font-weight:700}
  .hc-launcher-panel{display:grid;gap:.7rem;padding:1.15rem;border:1px solid rgba(255,255,255,.1);border-radius:18px;background:rgba(11,15,24,.55);backdrop-filter:blur(18px)}.hc-launcher-panel-head{display:flex;align-items:center;justify-content:space-between;gap:.5rem}.hc-launcher-panel-brand{display:inline-flex!important;align-items:center;gap:.5rem;padding:0!important;background:transparent!important;color:#fff!important;font-size:inherit!important;text-transform:none!important}.hc-launcher-panel-head>span:last-child{padding:.2rem .45rem;border-radius:999px;background:rgba(52,211,153,.1);color:#6ee7b7;font-size:.68rem;font-weight:800;text-transform:uppercase}.hc-launcher-panel p{margin:0;color:#c0c8d6;font-size:.8rem;line-height:1.5}.hc-launcher-panel a{display:inline-flex;align-items:center;gap:.35rem;color:#fff;text-decoration:none;font-size:.82rem;font-weight:750}
  .hc-launcher-banner{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;max-width:1160px;margin:2.5rem auto;padding:1.5rem;border:1px solid rgba(157,136,255,.25);border-radius:20px;background:linear-gradient(140deg,rgba(109,40,217,.12),rgba(11,15,24,.9))}.hc-launcher-badge{display:inline-flex;align-items:center;gap:.4rem;color:#9d88ff;font-size:.72rem;font-weight:800;text-transform:uppercase}.hc-launcher-banner h3{margin:.35rem 0}.hc-launcher-banner p{margin:0;color:#9ba7ba;line-height:1.5;font-size:.86rem}.hc-launcher-banner>a{display:inline-flex;align-items:center;gap:.4rem;white-space:nowrap;padding:.58rem .82rem .58rem .58rem;border-radius:12px;background:#6d28d9;color:#fff;text-decoration:none;font-size:.84rem;font-weight:750}
  .hc-launcher-inline{display:inline-flex;align-items:center;gap:.35rem;padding:.25rem .55rem .25rem .3rem;border:1px solid rgba(157,136,255,.25);border-radius:999px;background:rgba(109,40,217,.08);color:#bcaeff;text-decoration:none;font-size:.76rem;font-weight:700}
  @media(max-width:760px){.hc-launcher-banner{margin-inline:.75rem;flex-direction:column;align-items:flex-start}.hc-launcher-banner>a{width:100%;justify-content:center}.hc-launcher-mobile{grid-template-columns:auto 1fr}.hc-launcher-mobile>span{grid-column:1 / -1;white-space:normal}}
</style>

<style is:global>
  /* D036B — server-visible Connect marker prevents a dark-to-Pearl first-paint flash before JS adds .hc-experience. */
  .site-header:has([data-hc-server-route="connect"]) {
    color: #0b0d12 !important;
    background: rgba(247,246,243,.88) !important;
    border-bottom-color: rgba(11,13,18,.08) !important;
    backdrop-filter: blur(20px) saturate(1.05);
  }
  .site-header:has([data-hc-server-route="connect"]).site-header-scrolled {
    color: #0b0d12 !important;
    background: rgba(247,246,243,.95) !important;
    border-bottom-color: rgba(11,13,18,.09) !important;
  }
  .site-header:has([data-hc-server-route="connect"]) .desktop-nav,
  .site-header:has([data-hc-server-route="connect"]) .header-cta {
    display: none;
  }
  .site-header:has([data-hc-server-route="connect"]) .wordmark-mark {
    border-color: rgba(11,13,18,.24) !important;
  }
  .site-header:has([data-hc-server-route="connect"]) .language-menu summary {
    color: #0b0d12 !important;
    border-color: rgba(11,13,18,.14) !important;
    background: rgba(255,255,255,.58) !important;
  }
  .site-header:has([data-hc-server-route="connect"]) .language-menu nav {
    border-color: rgba(11,13,18,.10) !important;
    background: #fff !important;
    box-shadow: 0 14px 34px rgba(11,13,18,.10) !important;
  }
  .site-header:has([data-hc-server-route="connect"]) .language-menu nav a {
    color: #0b0d12 !important;
  }
</style>