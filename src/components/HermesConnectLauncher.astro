---
import { ArrowUpRight, Sparkles } from "@lucide/astro";

export interface Props {
  variant?: "header" | "mobile" | "footer" | "banner" | "inline";
  label?: string;
  sublabel?: string;
  context?: "logistics" | "marketing" | "academy" | "technology" | "beauty" | "general";
  href?: string;
  class?: string;
}

const {
  variant = "header",
  label,
  sublabel,
  context = "general",
  href,
  class: className = "",
} = Astro.props;

const defaultLabels = {
  general: {
    title: "Explore Hermes Connect",
    subtitle: "Current product: Repair Shop Partner Beta",
  },
  logistics: {
    title: "Explore Hermes Connect",
    subtitle: "Current live pilot: Repair Shop Partner Beta; logistics tools remain demo",
  },
  marketing: {
    title: "Explore Hermes Connect",
    subtitle: "Current live pilot: Repair Shop Partner Beta; growth tools remain demo",
  },
  academy: {
    title: "Explore Hermes Connect",
    subtitle: "Current live pilot: Repair Shop Partner Beta; training tools remain demo",
  },
  technology: {
    title: "Explore Hermes Connect",
    subtitle: "Current live pilot: Repair Shop Partner Beta; automation tools remain demo",
  },
  beauty: {
    title: "Explore Hermes Connect",
    subtitle: "Current live pilot: Repair Shop Partner Beta; beauty tools remain demo",
  },
};

const displayTitle = label || defaultLabels[context]?.title || defaultLabels.general.title;
const displaySubtitle = sublabel || defaultLabels[context]?.subtitle || defaultLabels.general.subtitle;
const computedHref = href || "/services/hermes-connect/";
---

{variant === "header" && (
  <a
    href={computedHref}
    class={`hermes-connect-header-launcher ${className}`}
    data-hermes-connect-launcher="header"
    aria-label={`${displayTitle} - ${displaySubtitle}`}
  >
    <svg class="hermes-knot-mark" viewBox="0 0 44 44" aria-hidden="true" width="18" height="18">
      <path d="M8 12c0-3 2.4-5.4 5.4-5.4h7.2c2.6 0 4.7 2.1 4.7 4.7v3.4c0 2.6-2.1 4.7-4.7 4.7h-7.2A5.4 5.4 0 0 0 8 24.8V28" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
      <path d="M36 32c0 3-2.4 5.4-5.4 5.4h-7.2a4.7 4.7 0 0 1-4.7-4.7v-3.4c0-2.6 2.1-4.7 4.7-4.7h7.2a5.4 5.4 0 0 0 5.4-5.4V16" fill="none" stroke="#5AC8FA" stroke-width="5" stroke-linecap="round"/>
    </svg>
    <span class="launcher-text">{displayTitle}</span>
    <ArrowUpRight size={15} class="launcher-arrow" aria-hidden="true" />
  </a>
)}

{variant === "mobile" && (
  <a
    href={computedHref}
    class={`hermes-connect-mobile-launcher ${className}`}
    data-hermes-connect-launcher="mobile"
  >
    <div class="mobile-launcher-brand">
      <svg class="hermes-knot-mark" viewBox="0 0 44 44" aria-hidden="true" width="22" height="22">
        <path d="M8 12c0-3 2.4-5.4 5.4-5.4h7.2c2.6 0 4.7 2.1 4.7 4.7v3.4c0 2.6-2.1 4.7-4.7 4.7h-7.2A5.4 5.4 0 0 0 8 24.8V28" fill="none" stroke="#9D88FF" stroke-width="5" stroke-linecap="round"/>
        <path d="M36 32c0 3-2.4 5.4-5.4 5.4h-7.2a4.7 4.7 0 0 1-4.7-4.7v-3.4c0-2.6 2.1-4.7 4.7-4.7h7.2a5.4 5.4 0 0 0 5.4-5.4V16" fill="none" stroke="#5AC8FA" stroke-width="5" stroke-linecap="round"/>
      </svg>
      <div>
        <strong>Hermes Connect</strong>
        <small>{displaySubtitle}</small>
      </div>
    </div>
    <span class="mobile-launcher-action">
      {displayTitle} <ArrowUpRight size={16} aria-hidden="true" />
    </span>
  </a>
)}

{variant === "footer" && (
  <div class={`hermes-connect-footer-widget ${className}`} data-hermes-connect-launcher="footer">
    <div class="footer-widget-header">
      <svg class="hermes-knot-mark" viewBox="0 0 44 44" aria-hidden="true" width="20" height="20">
        <path d="M8 12c0-3 2.4-5.4 5.4-5.4h7.2c2.6 0 4.7 2.1 4.7 4.7v3.4c0 2.6-2.1 4.7-4.7 4.7h-7.2A5.4 5.4 0 0 0 8 24.8V28" fill="none" stroke="#9D88FF" stroke-width="5" stroke-linecap="round"/>
        <path d="M36 32c0 3-2.4 5.4-5.4 5.4h-7.2a4.7 4.7 0 0 1-4.7-4.7v-3.4c0-2.6 2.1-4.7 4.7-4.7h7.2a5.4 5.4 0 0 0 5.4-5.4V16" fill="none" stroke="#5AC8FA" stroke-width="5" stroke-linecap="round"/>
      </svg>
      <strong>Hermes Connect</strong>
      <span class="status-badge" title="Current Hermes Connect product">Current Product</span>
    </div>
    <p class="footer-widget-desc">Repair Shop Partner Beta is the current live pilot. Other Hermes Connect modules are clearly labeled demo capabilities.</p>
    <a href={computedHref} class="footer-widget-button">
      Open Hermes Connect Product Hub <ArrowUpRight size={16} aria-hidden="true" />
    </a>
  </div>
)}

{variant === "banner" && (
  <section class={`hermes-connect-banner-cta ${className}`} data-hermes-connect-launcher="banner">
    <div class="banner-inner">
      <div class="banner-brand-icon">
        <svg class="hermes-knot-mark" viewBox="0 0 44 44" aria-hidden="true" width="32" height="32">
          <path d="M8 12c0-3 2.4-5.4 5.4-5.4h7.2c2.6 0 4.7 2.1 4.7 4.7v3.4c0 2.6-2.1 4.7-4.7 4.7h-7.2A5.4 5.4 0 0 0 8 24.8V28" fill="none" stroke="#9D88FF" stroke-width="5" stroke-linecap="round"/>
          <path d="M36 32c0 3-2.4 5.4-5.4 5.4h-7.2a4.7 4.7 0 0 1-4.7-4.7v-3.4c0-2.6 2.1-4.7 4.7-4.7h7.2a5.4 5.4 0 0 0 5.4-5.4V16" fill="none" stroke="#5AC8FA" stroke-width="5" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="banner-content">
        <span class="banner-badge">
          <Sparkles size={13} aria-hidden="true" /> Hermes Connect · Current Product
        </span>
        <h3 class="banner-title">{displayTitle}</h3>
        <p class="banner-desc">{displaySubtitle}. Repair Shops are the current live pilot; other capabilities remain clearly labeled demos.</p>
      </div>
      <div class="banner-actions">
        <a href={computedHref} class="banner-primary-btn">
          Explore Hermes Connect <ArrowUpRight size={17} aria-hidden="true" />
        </a>
        <a href="/services/hermes-connect/" class="banner-secondary-link">
          Product Details
        </a>
      </div>
    </div>
  </section>
)}

{variant === "inline" && (
  <a href={computedHref} class={`hermes-connect-inline-chip ${className}`} data-hermes-connect-launcher="inline">
    <svg class="hermes-knot-mark" viewBox="0 0 44 44" aria-hidden="true" width="16" height="16">
      <path d="M8 12c0-3 2.4-5.4 5.4-5.4h7.2c2.6 0 4.7 2.1 4.7 4.7v3.4c0 2.6-2.1 4.7-4.7 4.7h-7.2A5.4 5.4 0 0 0 8 24.8V28" fill="none" stroke="#9D88FF" stroke-width="4.5" stroke-linecap="round"/>
      <path d="M36 32c0 3-2.4 5.4-5.4 5.4h-7.2a4.7 4.7 0 0 1-4.7-4.7v-3.4c0-2.6 2.1-4.7 4.7-4.7h7.2a5.4 5.4 0 0 0 5.4-5.4V16" fill="none" stroke="#5AC8FA" stroke-width="4.5" stroke-linecap="round"/>
    </svg>
    <span>{displayTitle}</span>
    <ArrowUpRight size={14} aria-hidden="true" />
  </a>
)}

<style>
  .hermes-connect-header-launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    background: rgba(109, 40, 217, 0.15);
    border: 1px solid rgba(157, 136, 255, 0.35);
    color: #f8f6f0;
    font-size: 0.825rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .hermes-connect-header-launcher:hover {
    background: rgba(109, 40, 217, 0.3);
    border-color: rgba(157, 136, 255, 0.6);
    box-shadow: 0 0 16px rgba(109, 40, 217, 0.3);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .hermes-knot-mark { flex-shrink: 0; }
  .launcher-arrow { opacity: 0.8; transition: transform 0.2s ease; }
  .hermes-connect-header-launcher:hover .launcher-arrow { transform: translate(2px, -2px); opacity: 1; }

  .hermes-connect-mobile-launcher {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(11, 13, 18, 0.95), rgba(20, 24, 33, 0.95));
    border: 1px solid rgba(157, 136, 255, 0.25);
    color: #f8f6f0;
    text-decoration: none;
    margin: 0.5rem 0;
  }

  .mobile-launcher-brand { display: flex; align-items: center; gap: 0.65rem; }
  .mobile-launcher-brand strong { display: block; font-size: 0.95rem; color: #ffffff; }
  .mobile-launcher-brand small { display: block; font-size: 0.75rem; color: rgba(248, 246, 240, 0.65); }
  .mobile-launcher-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.55rem 0.9rem;
    border-radius: 8px;
    background: #6d28d9;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.85rem;
  }

  .hermes-connect-footer-widget {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border-radius: 14px;
    background: rgba(11, 13, 18, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    margin-top: 1rem;
  }

  .footer-widget-header { display: flex; align-items: center; gap: 0.5rem; color: #ffffff; }
  .footer-widget-header strong { font-size: 0.95rem; }
  .status-badge {
    margin-left: auto;
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    background: rgba(52, 211, 153, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.3);
    color: #6ee7b7;
    font-weight: 600;
  }

  .footer-widget-desc { font-size: 0.825rem; color: rgba(248, 246, 240, 0.75); margin: 0; line-height: 1.4; }
  .footer-widget-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    border-radius: 8px;
    background: linear-gradient(135deg, #6d28d9, #4c1d95);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .footer-widget-button:hover { background: linear-gradient(135deg, #7c3aed, #5b21b6); box-shadow: 0 4px 16px rgba(109, 40, 217, 0.4); }

  .hermes-connect-banner-cta { margin: 3rem auto; max-width: 1200px; padding: 0 1.25rem; }
  .banner-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
    border-radius: 20px;
    background: radial-gradient(120% 120% at 0% 0%, rgba(109, 40, 217, 0.25) 0%, rgba(9, 10, 15, 0.95) 70%);
    border: 1px solid rgba(157, 136, 255, 0.3);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }
  .banner-brand-icon { display: flex; align-items: center; justify-content: center; width: 60px; height: 60px; border-radius: 16px; background: rgba(109, 40, 217, 0.2); border: 1px solid rgba(157, 136, 255, 0.35); }
  .banner-badge { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #9d88ff; margin-bottom: 0.4rem; }
  .banner-title { margin: 0 0 0.4rem; font-size: 1.35rem; font-weight: 700; color: #ffffff; }
  .banner-desc { margin: 0; font-size: 0.9rem; color: rgba(248, 246, 240, 0.8); line-height: 1.5; }
  .banner-actions { display: flex; flex-direction: column; gap: 0.6rem; }
  .banner-primary-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; padding: 0.75rem 1.4rem; border-radius: 10px; background: #6d28d9; color: #ffffff; font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: all 0.2s ease; white-space: nowrap; }
  .banner-primary-btn:hover { background: #7c3aed; box-shadow: 0 0 20px rgba(109, 40, 217, 0.5); }
  .banner-secondary-link { text-align: center; font-size: 0.8rem; color: rgba(248, 246, 240, 0.7); text-decoration: underline; }

  .hermes-connect-inline-chip { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.25rem 0.65rem; border-radius: 9999px; background: rgba(109, 40, 217, 0.12); border: 1px solid rgba(157, 136, 255, 0.25); color: #9d88ff; font-size: 0.775rem; font-weight: 600; text-decoration: none; }
  .hermes-connect-inline-chip:hover { background: rgba(109, 40, 217, 0.25); color: #ffffff; }

  @media (max-width: 820px) {
    .banner-inner { grid-template-columns: 1fr; text-align: center; }
    .banner-brand-icon { margin: 0 auto; }
    .banner-actions { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hermes-connect-header-launcher,
    .launcher-arrow,
    .footer-widget-button,
    .banner-primary-btn {
      transition: none !important;
      transform: none !important;
    }
  }
</style>