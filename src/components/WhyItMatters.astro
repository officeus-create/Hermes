---
import { ArrowRight } from "@lucide/astro";
---

<span id="journey" style="position:absolute;width:1px;height:1px;overflow:hidden;" aria-hidden="true"></span>
<section class="why-matters section" id="why" data-analytics-scope="home">
  <div class="shell why-matters-grid" data-reveal>
    <div class="why-primary">
      <p class="eyebrow">How Hermes works</p>
      <h2>Start with one operating problem. Add more capability only when it helps.</h2>
      <p class="problem-banner">
        Hermes keeps logistics, growth, training, and software accountable as specialist teams instead of selling one oversized package.
      </p>
      <p>
        You do not need to map the company before you can work with it. Start with the job that needs to be done, work with
        the matching team, and connect another Hermes capability only when the operating need is real.
      </p>
      <a class="button button-primary" href="#contact" data-cta="home_why_cta">
        Talk to the right team <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>
    <aside class="why-supporting" aria-label="A simpler way to work with Hermes">
      <h3>A simpler buying path</h3>
      <ol>
        <li><strong>Start with the current job</strong> — move freight, grow demand, learn a role, or build a system.</li>
        <li><strong>Work with the matching team</strong> — ownership stays clear instead of bouncing through a generic catalog.</li>
        <li><strong>Expand only when it earns its place</strong> — another capability joins the work when it solves a real dependency.</li>
      </ol>
      <details class="why-optional" data-case-id="home-journey-optional">
        <summary>How work moves after the first conversation</summary>
        <p>Clarify → plan → deliver → review → improve. The process stays available without turning every step into another homepage decision.</p>
      </details>
    </aside>
  </div>
</section>

<script>
  import { trackCaseOpened, trackCtaClicked } from "../lib/analytics.ts";

  document.querySelectorAll<HTMLElement>("[data-analytics-scope='home'] [data-cta]").forEach((el) => {
    el.addEventListener("click", () => {
      if (el.dataset.cta) trackCtaClicked(el.dataset.cta);
    });
  });

  document.querySelectorAll<HTMLDetailsElement>("[data-analytics-scope='home'] [data-case-id]").forEach((el) => {
    el.addEventListener("toggle", () => {
      if (el.open && el.dataset.caseId) trackCaseOpened(el.dataset.caseId);
    });
  });
</script>
