---
import { ArrowRight, Check, Mail, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

export type ItalianCommercialPageContent = {
  id: "marketing" | "technology";
  metaTitle: string;
  metaDescription: string;
  eyebrow: string;
  title: string;
  lead: string;
  image: string;
  imageAlt: string;
  serviceName: string;
  scopeNote: string;
  services: { title: string; body: string; items: string[] }[];
  process: { number: string; title: string; body: string }[];
  principles: { title: string; body: string }[];
  faq: { question: string; answer: string }[];
  related: { label: string; href: string; description: string }[];
  ctaTitle: string;
  ctaBody: string;
  emailSubject: string;
  alternates: { lang: string; href: string }[];
};

interface Props {
  content: ItalianCommercialPageContent;
}

const { content } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const mailto = `mailto:officeus@hermeslogisticsus.com?subject=${encodeURIComponent(content.emailSubject)}&body=${encodeURIComponent("Azienda:\nCittà / regione:\nSito attuale:\nObiettivo principale:\nServizi di interesse:\nCosa deve migliorare nei prossimi 90 giorni:\nBudget o ritmo di investimento indicativo:\n")}`;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: content.serviceName,
  description: content.metaDescription,
  url: canonicalUrl,
  areaServed: { "@type": "Country", name: "Italy" },
  provider: { "@id": "https://hermeslogisticsus.com/#organization" },
  serviceType: content.services.map((service) => service.title),
  inLanguage: "it-IT",
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Hermes Italia", item: "https://hermeslogisticsus.com/it/" },
    { "@type": "ListItem", position: 2, name: content.serviceName, item: canonicalUrl },
  ],
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  image={content.image}
  locale="it"
  htmlLang="it-IT"
  ogLocaleOverride="it_IT"
  alternates={content.alternates}
  schema={[serviceSchema, breadcrumbSchema, faqSchema]}
>
  <SiteHeader theme="light" locale="it" />
  <main id="main-content" class:list={["it-commercial", `it-commercial--${content.id}`]} data-hermes-vertical={content.id}>
    <section class="it-commercial-hero hermes-surface-obsidian" id="top">
      <div class="it-commercial-hero-media" aria-hidden="true"><img src={content.image} alt="" width="1600" height="1000" /></div>
      <div class="shell it-commercial-hero-grid">
        <div class="it-commercial-hero-copy">
          <p class="eyebrow">{content.eyebrow}</p>
          <h1 class="hermes-display">{content.title}</h1>
          <p class="it-commercial-lead">{content.lead}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#servizi">Scopri i servizi<ArrowRight size={18} aria-hidden="true" /></a>
            <a class="button button-ghost" href={mailto}>Parla del progetto<Mail size={18} aria-hidden="true" /></a>
          </div>
          <div class="it-commercial-truth"><ShieldCheck size={20} aria-hidden="true" /><p>{content.scopeNote}</p></div>
        </div>
      </div>
    </section>

    <section class="section it-commercial-services" id="servizi" aria-labelledby="it-services-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Servizi</p><h2 id="it-services-title">Un sistema, non una raccolta di attività scollegate.</h2></div>
          <p>Partiamo dall'obiettivo commerciale e colleghiamo strategia, tecnologia, acquisizione e misurazione nel percorso più corto che possa produrre un risultato verificabile.</p>
        </div>
        <div class="it-service-grid">
          {content.services.map((service, index) => (
            <article class="it-service-card hermes-card">
              <span class="it-service-index">{String(index + 1).padStart(2, "0")}</span>
              <h3>{service.title}</h3>
              <p>{service.body}</p>
              <ul>{service.items.map((item) => <li><Check size={16} aria-hidden="true" />{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section it-commercial-process hermes-surface-obsidian" aria-labelledby="it-process-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Metodo</p><h2 id="it-process-title">Prima la diagnosi. Poi il lavoro che conta.</h2></div>
          <p>Niente pacchetti automatici: definiamo baseline, priorità, responsabilità, misura del risultato e solo dopo costruiamo il ciclo operativo.</p>
        </div>
        <div class="it-process-grid">
          {content.process.map((step) => <article><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section it-commercial-principles" aria-labelledby="it-principles-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Standard Hermes</p><h2 id="it-principles-title">Chiarezza prima delle promesse.</h2></div>
          <p>Separiamo ciò che è già pubblico e verificabile da ciò che deve essere progettato, testato o validato sul mercato.</p>
        </div>
        <div class="it-principle-grid">
          {content.principles.map((item) => <article class="hermes-card"><h3>{item.title}</h3><p>{item.body}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section it-commercial-related" aria-labelledby="it-related-title">
      <div class="shell">
        <div class="section-heading"><p class="eyebrow">Ecosistema</p><h2 id="it-related-title">Collega il progetto al prossimo passaggio.</h2></div>
        <div class="it-related-grid">
          {content.related.map((item) => <a class="hermes-card" href={item.href}><strong>{item.label}</strong><span>{item.description}</span><ArrowRight size={18} aria-hidden="true" /></a>)}
        </div>
      </div>
    </section>

    <section class="section it-commercial-faq" aria-labelledby="it-faq-title">
      <div class="shell">
        <div class="section-heading"><p class="eyebrow">FAQ</p><h2 id="it-faq-title">Domande frequenti.</h2></div>
        <div class="it-faq-list">{content.faq.map((item) => <details class="hermes-card"><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
      </div>
    </section>

    <section class="section it-commercial-contact" id="contact">
      <div class="shell it-commercial-contact-card hermes-workspace-panel">
        <div><p class="eyebrow">Prossimo passo</p><h2>{content.ctaTitle}</h2><p>{content.ctaBody}</p></div>
        <a class="button button-primary" href={mailto}><Mail size={18} aria-hidden="true" />Invia il brief</a>
      </div>
    </section>
  </main>
  <SiteFooter locale="it" />
</BaseLayout>

<style>
  .it-commercial{background:var(--hermes-pearl);color:var(--hermes-ink)}
  .it-commercial-hero{position:relative;min-height:720px;display:grid;align-items:end;overflow:hidden;color:#fff}
  .it-commercial-hero-media{position:absolute;inset:0}
  .it-commercial-hero-media:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,13,18,.96) 0%,rgba(11,13,18,.78) 46%,rgba(11,13,18,.18) 100%),linear-gradient(0deg,rgba(11,13,18,.5),transparent 55%)}
  .it-commercial-hero-media img{width:100%;height:100%;object-fit:cover}
  .it-commercial-hero-grid{position:relative;z-index:1;width:100%;padding-top:180px;padding-bottom:86px}
  .it-commercial-hero-copy{max-width:790px}
  .it-commercial-hero h1{max-width:16ch;margin:.65rem 0 1.1rem;font-size:clamp(3rem,6vw,6.4rem)}
  .it-commercial-lead{max-width:68ch;font-size:clamp(1.05rem,1.5vw,1.3rem);line-height:var(--hermes-copy-leading);color:var(--hermes-muted-dark)}
  .it-commercial-truth{display:flex;gap:.65rem;align-items:flex-start;max-width:720px;margin-top:1.2rem;padding:1rem 1.1rem;border:1px solid var(--hermes-line-dark);border-radius:var(--hermes-radius-control);background:var(--hermes-glass-dark);backdrop-filter:blur(10px)}
  .it-commercial-truth p{margin:0;color:var(--hermes-muted-dark);line-height:1.55}
  .it-commercial .section{padding:var(--hermes-section-space) 0}
  .it-service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:2rem}
  .it-service-card,.it-process-grid article,.it-principle-grid article{padding:1.45rem}
  .it-service-index,.it-process-grid span{display:inline-flex;margin-bottom:1.7rem;font-size:.78rem;font-weight:800;letter-spacing:.15em;color:var(--hermes-vertical-accent)}
  .it-service-card h3,.it-process-grid h3,.it-principle-grid h3{margin:0 0 .65rem;font-size:1.22rem}
  .it-service-card p,.it-process-grid p,.it-principle-grid p{color:var(--hermes-muted);line-height:var(--hermes-copy-leading)}
  .it-service-card ul{display:grid;gap:.6rem;margin:1rem 0 0;padding:0;list-style:none}
  .it-service-card li{display:flex;gap:.55rem;align-items:flex-start;color:var(--hermes-graphite);line-height:1.45}
  .it-service-card li svg{flex:0 0 auto;margin-top:.15rem;color:var(--hermes-vertical-accent)}
  .it-commercial-process .section-heading>p,.it-commercial-process .it-process-grid p{color:var(--hermes-muted-dark)}
  .it-process-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin-top:2rem}
  .it-process-grid article{border:1px solid var(--hermes-line-dark);border-radius:var(--hermes-radius-card);background:var(--hermes-glass-dark);box-shadow:none}
  .it-process-grid h3{color:#fff}
  .it-principle-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:2rem}
  .it-related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:2rem}
  .it-related-grid a{display:grid;grid-template-columns:1fr auto;gap:.55rem 1rem;align-items:center;padding:1.25rem;color:var(--hermes-graphite);text-decoration:none}
  .it-related-grid a strong{font-size:1.05rem}
  .it-related-grid a span{grid-column:1;color:var(--hermes-muted);line-height:1.5}
  .it-related-grid a svg{grid-column:2;grid-row:1/3;color:var(--hermes-vertical-accent)}
  .it-commercial-faq{background:color-mix(in srgb,var(--hermes-paper) 58%,var(--hermes-pearl))}
  .it-faq-list{display:grid;gap:.75rem;max-width:920px;margin-top:2rem}
  .it-faq-list details{padding:1rem 1.15rem}
  .it-faq-list summary{cursor:pointer;font-weight:800}
  .it-faq-list p{margin:.8rem 0 .1rem;color:var(--hermes-muted);line-height:var(--hermes-copy-leading)}
  .it-commercial-contact{background:var(--hermes-pearl)}
  .it-commercial-contact-card{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding:2rem}
  .it-commercial-contact-card h2{max-width:18ch;margin:.45rem 0 .7rem;font-size:clamp(2rem,4vw,3.8rem);line-height:var(--hermes-display-leading);letter-spacing:var(--hermes-display-tracking)}
  .it-commercial-contact-card p{max-width:64ch;color:var(--hermes-muted-dark);line-height:var(--hermes-copy-leading)}
  @media(max-width:980px){.it-service-grid,.it-principle-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.it-process-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.it-related-grid{grid-template-columns:1fr}}
  @media(max-width:680px){.it-commercial-hero{min-height:680px}.it-commercial-hero-grid{padding-top:150px;padding-bottom:60px}.it-commercial-hero h1{font-size:clamp(2.65rem,13vw,4.4rem)}.it-service-grid,.it-process-grid,.it-principle-grid{grid-template-columns:1fr}.it-commercial-contact-card{display:grid;align-items:start}.hero-actions{display:grid;grid-template-columns:1fr}.hero-actions .button{justify-content:center}}
</style>
