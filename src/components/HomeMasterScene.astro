---
import { publicPaths } from "../data/public-paths";

const routeMeta: Record<string, { accent: string; detail: string; searchDetail?: string; displayNumber: string; crop: number; goal: string; flow: readonly [string, string, string, string] }> = {
  logistics: {
    accent: "var(--hermes-logistics)",
    detail: "Dealers · shippers · carriers · dispatch service",
    searchDetail: "Car hauling · dealers · shippers · carriers",
    flow: ["Request", "Route fit", "Human review", "Handoff"],
    displayNumber: "01", crop: 20, goal: "Move freight",
  },
  marketing: {
    accent: "var(--hermes-marketing)",
    detail: "Websites · SMM · SEO/GEO · customer acquisition",
    searchDetail: "Website · SEO/GEO · customer acquisition",
    flow: ["Content + news", "Search + social", "Website action", "CRM evidence"],
    displayNumber: "04", crop: 296, goal: "Grow demand",
  },
  technology: {
    accent: "var(--hermes-technology)",
    detail: "CRM systems · websites · IT development",
    searchDetail: "CRM · automation · custom software",
    flow: ["Hermes Connect", "Website Factory", "Social connectors", "QA readback"],
    displayNumber: "02", crop: 556, goal: "Build systems",
  },
  academy: {
    accent: "var(--hermes-academy)",
    detail: "U.S. logistics · sales · marketing · operations",
    searchDetail: "Logistics · marketing · IT/AI · sales · operations",
    flow: ["Task", "Practice", "Feedback", "Next level"],
    displayNumber: "03", crop: 818, goal: "Learn by doing",
  },
};
---
<section class="home-master" id="top" aria-labelledby="home-master-title">
  <div class="home-master-shell">
    <header class="home-master-intro" id="about">
      <h1 id="home-master-title" class="home-master-display" aria-label="Four directions."><span data-home-dot-target="f">F</span>our <span class="home-display-word">d<span class="home-display-i" data-home-dot-target="i1">i</span>r<span data-home-dot-target="e">e</span>ct<span class="home-display-i" data-home-dot-target="i2">i</span>ons<span data-home-dot-target="end">.</span></span><span class="home-display-travel-dot" data-home-travel-dot aria-hidden="true"></span></h1>
      <p class="home-master-script">Choose yours.</p>
      <p class="home-master-ink-note">Logistics, technology, learning and marketing for your business — one Hermes ecosystem.</p>
    </header>
    <span id="journey" class="home-legacy-anchor" aria-hidden="true"></span>
    <nav class="home-master-stage" id="paths" aria-label="Hermes operating directions">
      {publicPaths.map((path) => {
        const meta = routeMeta[path.id] ?? routeMeta.logistics;
        // Retain the accessible workflow summary even when visual workflow HUDs are hidden.
        const flowLabel = meta.flow.join(", ").toLowerCase();
        return (
          <a class={`home-master-route home-master-route-${path.id}`} href={`/paths/${path.id}/`}
            style={`--route-accent:${meta.accent}`}
            aria-label={`${meta.goal}: ${path.brandLabel} — ${meta.searchDetail ? `${meta.searchDetail}. ` : ""}${meta.detail}. Example flow: ${flowLabel}.`} data-home-route data-route-id={path.id}>
            <span class="home-portal-art" aria-hidden="true">
              {path.id === "logistics" ? (
                <span class="home-logistics-layer-stack" data-home-cinematic-slot="logistics" data-cinematic-source-policy="local-only">
                  <video
                    class="home-logistics-cinematic"
                    data-home-cinematic-video="logistics"
                    data-home-cinematic-version="v2"
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster="/images/logistics-living/car-hauler-512.webp"
                    aria-hidden="true"
                    tabindex="-1"
                  >
                    <source data-cinematic-src="/media/home/logistics-film-v2-540.mp4" type="video/mp4" />
                  </video>
                  <img
                    data-home-logistics-scene-image
                    data-logistics-scene-ready="car-hauler"
                    src="/images/logistics-living/car-hauler-512.webp"
                    srcset="/images/logistics-living/car-hauler-512.webp 512w, /images/logistics-living/car-hauler-768.webp 768w, /images/logistics-living/car-hauler-887.webp 887w"
                    sizes="(max-width:700px) calc(100vw - 24px), (hover: none) and (pointer: coarse) and (min-width:701px) and (max-width:820px) calc(100vw - 24px), (min-width:701px) and (max-width:1000px) calc((100vw - 40px) / 2), (min-width:1520px) 368px, calc((100vw - 50px) / 4)"
                    width="887"
                    height="1590"
                    aria-hidden="true"
                    alt="Illustrative aerial U.S. logistics route with changing freight equipment and weather"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                </span>
              ) : path.id === "marketing" ? (
                <span class="home-marketing-layer-stack" data-home-marketing-cinematic data-home-progressive-cinematic data-media-state="poster">
                  <img
                    src="/media/home/marketing-film-v2-poster.jpg"
                    width="281"
                    height="500"
                    alt="Illustrative stock footage of a business team discussing plans"
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                  />
                  <video
                    data-home-marketing-video
                    data-home-progressive-video
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster="/media/home/marketing-film-v2-poster.jpg"
                    aria-hidden="true"
                    tabindex="-1"
                  >
                    <source
                      data-home-marketing-source
                      data-home-progressive-source
                      data-desktop-src="/media/home/marketing-film-v2-540.mp4"
                      data-hd-src="/media/home/marketing-film-v2-720.mp4"
                      data-mobile-src="/media/home/marketing-film-v2-540.mp4"
                      type="video/mp4"
                    />
                  </video>
                </span>
              ) : path.id === "technology" ? (
                <span class="home-cinematic-layer-stack" data-home-progressive-cinematic data-home-technology-cinematic data-media-state="poster">
                  <img
                    src="/media/home/technology-film-v2-poster.jpg"
                    width="540"
                    height="960"
                    sizes="(max-width:700px) calc(100vw - 24px), (hover: none) and (pointer: coarse) and (min-width:701px) and (max-width:820px) calc(100vw - 24px), (min-width:701px) and (max-width:1000px) calc((100vw - 40px) / 2), (min-width:1520px) 368px, calc((100vw - 50px) / 4)"
                    alt="Illustrative footage of developers collaborating at a computer"
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                  />
                  <video
                    data-home-progressive-video
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster="/media/home/technology-film-v2-poster.jpg"
                    aria-hidden="true"
                    tabindex="-1"
                  >
                    <source
                      data-home-progressive-source
                      data-desktop-src="/media/home/technology-film-v2-540.mp4"
                      data-hd-src="/media/home/technology-film-v2-720.mp4"
                      data-mobile-src="/media/home/technology-film-v2-540.mp4"
                      type="video/mp4"
                    />
                  </video>
                </span>
              ) : path.id === "academy" ? (
                <span class="home-cinematic-layer-stack" data-home-progressive-cinematic data-home-academy-cinematic data-media-state="poster">
                  <img
                    src="/media/home/academy-film-v2-poster.jpg"
                    width="540"
                    height="960"
                    sizes="(max-width:700px) calc(100vw - 24px), (hover: none) and (pointer: coarse) and (min-width:701px) and (max-width:820px) calc(100vw - 24px), (min-width:701px) and (max-width:1000px) calc((100vw - 40px) / 2), (min-width:1520px) 368px, calc((100vw - 50px) / 4)"
                    alt="Illustrative footage of a business training presentation"
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                  />
                  <video
                    data-home-progressive-video
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster="/media/home/academy-film-v2-poster.jpg"
                    aria-hidden="true"
                    tabindex="-1"
                  >
                    <source
                      data-home-progressive-source
                      data-desktop-src="/media/home/academy-film-v2-540.mp4"
                      data-hd-src="/media/home/academy-film-v2-720.mp4"
                      data-mobile-src="/media/home/academy-film-v2-540.mp4"
                      type="video/mp4"
                    />
                  </video>
                </span>
              ) : null}
            </span>
            {path.id === "logistics" && (
              <span
                class="home-logistics-living"
                aria-hidden="true"
                data-home-logistics-echo
                data-logistics-echo-scene="car-hauler"
                data-logistics-weather-state="sun"
                data-logistics-echo-count="6"
                data-logistics-equipment-cycle-ms="15600"
                data-logistics-weather-cycle-ms="5200"
                data-logistics-echo-scenes="car-hauler,dry-van,reefer,flatbed,step-deck,hotshot"
                data-logistics-echo-motion="idle"
              >
                <span class="home-logistics-weather"></span>
              </span>
            )}
            <span class="home-master-route-copy">
              <small><i aria-hidden="true" data-home-route-bar></i>{meta.goal}</small>
              <strong>Hermes<br />{path.brandLabel.replace("Hermes ", "")}</strong>
              <span class="home-route-detail">{meta.detail}</span>
            </span>
          </a>
        );
      })}
    </nav>
  </div>
</section>
<script>
  import { trackCtaClicked, trackEvent, trackTrackSelected } from "../lib/analytics.ts";

  // Owner-approved Claude Home v3: five-step 5.6 s flight inside a 9 s cycle.
  // The dot lands F → first i → e → second i → final period. Each landing
  // briefly answers in the matching direction bar. Hidden tabs cancel the cycle.
  const dotHeading = document.querySelector<HTMLElement>(".home-master-display");
  const travelDot = dotHeading?.querySelector<HTMLElement>("[data-home-travel-dot]");
  const dotTargets = Array.from(dotHeading?.querySelectorAll<HTMLElement>("[data-home-dot-target]") ?? []);
  if (dotHeading && travelDot && dotTargets.length === 5) {
    const dotReducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const steps = [
      { color: "--dir-logistics", route: "logistics", at: 0 },
      { color: "--dir-technology", route: "technology", at: 1400 },
      { color: "--dir-academy", route: "academy", at: 2800 },
      { color: "--dir-marketing", route: "marketing", at: 4200 },
      { color: "--dir-marketing", route: "marketing", at: 5600 },
    ] as const;
    let cycleTimer: number | undefined;
    let stepTimers: number[] = [];
    const clearDotTimers = () => {
      if (cycleTimer !== undefined) window.clearTimeout(cycleTimer);
      cycleTimer = undefined;
      stepTimers.forEach((timer) => window.clearTimeout(timer));
      stepTimers = [];
    };
    const land = (index: number, fromAbove = false) => {
      if (document.hidden || dotReducedMotion.matches) return;
      const target = dotTargets[index];
      const headingRect = dotHeading.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      if (!targetRect.width) return;
      travelDot.style.transition = fromAbove ? "none" : "";
      travelDot.style.left = `${targetRect.left - headingRect.left + targetRect.width / 2}px`;
      travelDot.style.top = `${targetRect.top - headingRect.top + targetRect.height * 0.08}px`;
      travelDot.style.backgroundColor = `var(${steps[index].color})`;
      travelDot.dataset.homeDotPosition = target.dataset.homeDotTarget ?? String(index);
      if (fromAbove) {
        travelDot.style.transform = "translate(-50%,-320%)";
        requestAnimationFrame(() => requestAnimationFrame(() => {
          travelDot.style.transition = "";
          travelDot.style.transform = "translate(-50%,-40%)";
        }));
      }
      travelDot.classList.add("is-ready");
      travelDot.classList.remove("home-dot-final-bounce");
      if (index === steps.length - 1) {
        void travelDot.offsetWidth;
        travelDot.classList.add("home-dot-final-bounce");
      }
      target.classList.remove("home-dot-impact");
      void target.offsetWidth;
      target.classList.add("home-dot-impact");
      const bar = document.querySelector<HTMLElement>(`[data-home-route][data-route-id="${steps[index].route}"] [data-home-route-bar]`);
      bar?.classList.remove("home-route-bar-impact");
      if (bar) {
        void bar.offsetWidth;
        bar.classList.add("home-route-bar-impact");
      }
      // The same-colour stripe in the header answers too (Claude Design spec).
      const navStripe = document.querySelector<HTMLElement>(`.desktop-nav [data-nav-tone="${steps[index].route}"]`);
      navStripe?.classList.remove("is-dot-landing");
      if (navStripe) {
        void navStripe.offsetWidth;
        navStripe.classList.add("is-dot-landing");
      }
      window.setTimeout(() => {
        navStripe?.classList.remove("is-dot-landing");
        target.classList.remove("home-dot-impact");
        bar?.classList.remove("home-route-bar-impact");
      }, 620);
    };
    const runCycle = () => {
      clearDotTimers();
      if (document.hidden || dotReducedMotion.matches) {
        travelDot.classList.remove("is-ready");
        return;
      }
      steps.forEach((step, index) => {
        stepTimers.push(window.setTimeout(() => land(index, index === 0), step.at));
      });
      cycleTimer = window.setTimeout(runCycle, 9000);
    };
    runCycle();
    document.addEventListener("visibilitychange", runCycle);
    dotReducedMotion.addEventListener?.("change", runCycle);
    window.addEventListener("resize", () => {
      const current = dotTargets.findIndex((target) => target.dataset.homeDotTarget === travelDot.dataset.homeDotPosition);
      if (current >= 0 && !document.hidden && !dotReducedMotion.matches) land(current);
    }, { passive: true });
    void document.fonts?.ready.then(runCycle);
    window.addEventListener("pagehide", clearDotTimers, { once: true });
  }

  const logisticsEcho = document.querySelector<HTMLElement>("[data-home-logistics-echo]");
  if (logisticsEcho && window.IntersectionObserver) {
    const scenes = ["car-hauler", "dry-van", "reefer", "flatbed", "step-deck", "hotshot"] as const;
    const weatherStates = ["sun", "fog", "dusk", "rain"] as const;
    const sceneImage = document.querySelector<HTMLImageElement>("[data-home-logistics-scene-image]");
    const cinematicVideo = document.querySelector<HTMLVideoElement>('[data-home-cinematic-video="logistics"]');
    const cinematicSource = cinematicVideo?.querySelector<HTMLSourceElement>("[data-cinematic-src]");
    const logisticsRoute = logisticsEcho.closest<HTMLElement>("[data-home-route]");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const connection = (navigator as Navigator & {
      connection?: { saveData?: boolean; addEventListener?: (type: string, callback: () => void) => void }
    }).connection;
    let cinematicSourceAttached = false;
    let cinematicAvailable = Boolean(cinematicVideo);
    let sceneIndex = 0;
    let weatherIndex = 0;
    let sceneTimer: number | undefined;
    let weatherTimer: number | undefined;
    let visible = false;

    const setMotionState = (state: "running" | "paused" | "reduced") => {
      logisticsEcho.dataset.logisticsEchoMotion = state;
      logisticsRoute?.setAttribute("data-logistics-motion", state);
    };

    let sceneRequest = 0;
    const preloadScene = (scene: (typeof scenes)[number]) => {
      if (!sceneImage) return Promise.resolve();
      const candidate = new Image();
      candidate.sizes = sceneImage.sizes;
      candidate.srcset = `/images/logistics-living/${scene}-512.webp 512w, /images/logistics-living/${scene}-768.webp 768w, /images/logistics-living/${scene}-887.webp 887w`;
      candidate.src = `/images/logistics-living/${scene}-512.webp`;
      if (candidate.decode) return candidate.decode();
      return new Promise<void>((resolve, reject) => {
        candidate.addEventListener("load", () => resolve(), { once: true });
        candidate.addEventListener("error", () => reject(new Error(`Failed to decode ${scene}`)), { once: true });
      });
    };
    const applyScene = async () => {
      const scene = scenes[sceneIndex];
      const request = ++sceneRequest;
      if (sceneImage) {
        try {
          await preloadScene(scene);
        } catch {
          return;
        }
        if (request !== sceneRequest) return;
        sceneImage.src = `/images/logistics-living/${scene}-512.webp`;
        sceneImage.srcset = `/images/logistics-living/${scene}-512.webp 512w, /images/logistics-living/${scene}-768.webp 768w, /images/logistics-living/${scene}-887.webp 887w`;
        sceneImage.dataset.logisticsSceneReady = scene;
      }
      logisticsEcho.dataset.logisticsEchoScene = scene;
    };
    const applyWeather = () => {
      logisticsEcho.dataset.logisticsWeatherState = weatherStates[weatherIndex];
    };
    const stop = () => {
      if (sceneTimer) window.clearInterval(sceneTimer);
      if (weatherTimer) window.clearInterval(weatherTimer);
      sceneTimer = undefined;
      weatherTimer = undefined;
    };
    const syncCinematic = () => {
      if (!cinematicVideo) return;
      // A hidden, reduced-motion or Save-Data visit must not download the movie.
      const shouldPause = reduced.matches || Boolean(connection?.saveData) || !visible || document.hidden || !cinematicAvailable;
      if (shouldPause) {
        cinematicVideo.pause();
        return;
      }
      if (!cinematicSourceAttached) {
        const src = cinematicSource?.dataset.cinematicSrc;
        if (!src?.startsWith("/media/home/") || !cinematicSource) {
          cinematicAvailable = false;
          cinematicVideo.hidden = true;
          logisticsRoute?.setAttribute("data-logistics-cinematic", "fallback");
          return;
        }
        cinematicSource.src = src;
        cinematicSourceAttached = true;
        cinematicVideo.load();
      }
      if (cinematicVideo.paused) {
        void cinematicVideo.play().catch(() => {
          // Autoplay can still be blocked: keep the image/poster fallback visible.
        });
      }
    };
    const update = () => {
      if (reduced.matches) {
        stop();
        sceneIndex = 0;
        weatherIndex = 0;
        applyWeather();
        sceneRequest += 1;
        if (sceneImage && sceneImage.dataset.logisticsSceneReady !== scenes[0]) {
          sceneImage.src = `/images/logistics-living/${scenes[0]}-512.webp`;
          sceneImage.srcset = `/images/logistics-living/${scenes[0]}-512.webp 512w, /images/logistics-living/${scenes[0]}-768.webp 768w, /images/logistics-living/${scenes[0]}-887.webp 887w`;
          sceneImage.dataset.logisticsSceneReady = scenes[0];
          logisticsEcho.dataset.logisticsEchoScene = scenes[0];
        }
        setMotionState("reduced");
        syncCinematic();
        return;
      }
      if (!visible || document.hidden) {
        stop();
        setMotionState("paused");
        syncCinematic();
        return;
      }
      setMotionState("running");
      syncCinematic();
      if (!cinematicAvailable && !sceneTimer) {
        sceneTimer = window.setInterval(() => {
          sceneIndex = (sceneIndex + 1) % scenes.length;
          applyScene();
        }, 15600);
      } else if (cinematicAvailable && sceneTimer) {
        window.clearInterval(sceneTimer);
        sceneTimer = undefined;
      }
      if (!weatherTimer) {
        weatherTimer = window.setInterval(() => {
          weatherIndex = (weatherIndex + 1) % weatherStates.length;
          applyWeather();
        }, 5200);
      }
    };

    const observer = new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= .2);
      update();
    }, { threshold: .2 });
    observer.observe(logisticsEcho);
    const nudgeWeather = () => {
      if (reduced.matches) return;
      weatherIndex = (weatherIndex + 1) % weatherStates.length;
      applyWeather();
      if (weatherTimer) {
        window.clearInterval(weatherTimer);
        weatherTimer = undefined;
      }
      update();
    };
    cinematicVideo?.addEventListener("canplay", () => {
      cinematicAvailable = true;
      cinematicVideo.dataset.cinematicReady = "true";
      logisticsRoute?.setAttribute("data-logistics-cinematic", "ready");
      update();
    }, { once: true });
    cinematicVideo?.addEventListener("error", () => {
      cinematicAvailable = false;
      cinematicVideo.dataset.cinematicFailed = "true";
      cinematicVideo.hidden = true;
      logisticsRoute?.setAttribute("data-logistics-cinematic", "fallback");
      update();
    });
    logisticsRoute?.addEventListener("pointerenter", nudgeWeather);
    logisticsRoute?.addEventListener("focusin", nudgeWeather);
    reduced.addEventListener("change", update);
    connection?.addEventListener?.("change", update);
    document.addEventListener("visibilitychange", update);
    update();
  }

  document.querySelectorAll<HTMLAnchorElement>("[data-home-route]").forEach((link) => {
    link.addEventListener("click", () => {
      const id = link.dataset.routeId;
      if (!id) return;
      trackTrackSelected(id);
      trackCtaClicked(`home_direction_${id}`);
      if (["logistics", "marketing", "technology", "academy"].includes(id)) {
        trackEvent(`home_direction_${id}_selected`, { page_group: "home" });
      }
    });
  });
</script>
<script is:inline src="/scripts/home-marketing-video.js"></script>
<style>
.home-master{--hermes-logistics:var(--dir-logistics);--hermes-technology:var(--dir-technology);--hermes-academy:var(--dir-academy);--hermes-marketing:var(--dir-marketing);position:relative;overflow:hidden;padding:8.5rem 0 1.5rem;background:#f7f6f3;color:#111318;
  /* Home-only preview; do not change Hermes Connect or division pages. */
  /* Four directions use approved shared brand tokens; avoid overriding them locally. */
}
.home-master::before{content:"";display:none}
.home-master-shell{position:relative;width:min(1480px,calc(100% - 40px));margin:auto}
.home-master-intro{padding:0 24px 26px;scroll-margin-top:6rem}
.home-master-display{margin:0;font:800 clamp(3.8rem,7.6vw,7.8rem)/1.02 var(--font-display);letter-spacing:-.075em}
.home-master-display span{color:inherit}
.home-master-display{position:relative}
.home-master-display .home-display-word{color:inherit}
.home-master-display [data-home-dot-target]{color:inherit}
.home-master-display .home-display-travel-dot{position:absolute;z-index:2;left:0;top:0;width:.13em;height:.13em;border-radius:50%;pointer-events:none;opacity:0;transform:translate(-50%,-40%);background:var(--dir-logistics);transition:left 1.08s cubic-bezier(.22,1,.36,1),top 1.08s cubic-bezier(.22,1,.36,1),transform .42s cubic-bezier(.22,1,.36,1),background-color .38s ease,opacity .18s ease}
.home-master-display .home-display-travel-dot.is-ready{opacity:1}
.home-master-display [data-home-dot-target].home-dot-impact{animation:home-dot-letter-impact .62s cubic-bezier(.2,.8,.2,1)}
.home-master-route-copy [data-home-route-bar].home-route-bar-impact{animation:home-route-bar-impact .62s cubic-bezier(.2,.8,.2,1)}
@keyframes home-dot-letter-impact{0%,100%{transform:translateY(0) scale(1)}38%{transform:translateY(.055em) scale(1.06,.78)}68%{transform:translateY(-.018em) scale(.97,1.04)}}
.home-master-display .home-display-travel-dot.home-dot-final-bounce{animation:home-dot-final-bounce .58s cubic-bezier(.22,1,.36,1)}
@keyframes home-dot-final-bounce{0%,100%{transform:translate(-50%,-40%)}34%{transform:translate(-50%,8%) scale(1.14,.78)}62%{transform:translate(-50%,-92%) scale(.94,1.08)}82%{transform:translate(-50%,-28%)}}
@keyframes home-route-bar-impact{0%,100%{transform:translateY(0) scale(1,1)}42%{transform:translateY(-7px) scale(.8,1.45)}72%{transform:translateY(-2px) scale(1.35,.7)}}
@media(prefers-reduced-motion:reduce){.home-master-display .home-display-travel-dot{display:none!important;transition:none!important;animation:none!important}.home-master-display [data-home-dot-target],.home-master-route-copy [data-home-route-bar]{animation:none!important}}
.home-master-script{position:relative;width:max-content;max-width:100%;margin:.55rem 0 1rem;color:#59606b;font:650 clamp(.98rem,1.35vw,1.15rem)/1.35 var(--font-body);letter-spacing:.08em;text-transform:uppercase;transform:none}
