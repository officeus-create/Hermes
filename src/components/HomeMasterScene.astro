---
import { ArrowUpRight } from "@lucide/astro";
import { publicPaths } from "../data/public-paths";

const routeMeta: Record<string, { accent: string; detail: string; displayNumber: string; crop: number; goal: string }> = {
  logistics: {
    accent: "var(--hermes-logistics)",
    detail: "Car hauling · dealers · shippers · carriers",
    displayNumber: "01", crop: 20, goal: "Move freight",
  },
  marketing: {
    accent: "var(--hermes-marketing)",
    detail: "Website · SEO/GEO · customer acquisition",
    displayNumber: "02", crop: 296, goal: "Grow demand",
  },
  technology: {
    accent: "var(--hermes-technology)",
    detail: "CRM · automation · custom software",
    displayNumber: "03", crop: 556, goal: "Build systems",
  },
  academy: {
    accent: "var(--hermes-academy)",
    detail: "U.S. logistics · sales · marketing · operations",
    displayNumber: "04", crop: 818, goal: "Develop people",
  },
};
---
<section class="home-master" id="top" aria-labelledby="home-master-title">
  <div class="home-master-shell">
    <header class="home-master-intro" id="about">
      <h1 id="home-master-title" class="home-master-display">Four <span>directions.</span></h1>
      <p class="home-master-script">Choose yours.</p>
      <p class="home-master-ink-note">Logistics, marketing, technology and learning for your business. One Hermes ecosystem.</p>
    </header>
    <span id="journey" class="home-legacy-anchor" aria-hidden="true"></span>
    <nav class="home-master-stage" id="paths" aria-label="Hermes operating directions">
      {publicPaths.map((path) => {
        const meta = routeMeta[path.id] ?? routeMeta.logistics;
        return (
          <a class={`home-master-route home-master-route-${path.id}`} href={`/paths/${path.id}/`}
            style={`--route-accent:${meta.accent};--art-x:${-meta.crop / 267 * 100}%`}
            aria-label={`${meta.goal}: ${path.brandLabel} — ${meta.detail}`} data-home-route data-route-id={path.id}>
            <span class="home-portal-art" aria-hidden="true"></span>
            <span class="home-master-route-copy">
              <small><i aria-hidden="true"></i>{meta.goal}</small>
              <strong>Hermes<br />{path.brandLabel.replace("Hermes ", "")}</strong>
              <span class="home-route-detail">{meta.detail}</span>
            </span>
            <span class="home-master-route-arrow" aria-hidden="true"><ArrowUpRight size={24} /></span>
          </a>
        );
      })}
    </nav>
  </div>
</section>
<script>
  import { trackCtaClicked, trackTrackSelected } from "../lib/analytics.ts";

  document.querySelectorAll<HTMLAnchorElement>("[data-home-route]").forEach((link) => {
    link.addEventListener("click", () => {
      const id = link.dataset.routeId;
      if (!id) return;
      trackTrackSelected(id);
      trackCtaClicked(`home_direction_${id}`);
    });
  });
</script>
<style>
.home-master{position:relative;overflow:hidden;padding:8.5rem 0 1.5rem;background:radial-gradient(ellipse at 95% 24%,#e3dbff88,transparent 45%),radial-gradient(ellipse at 70% 35%,#c4eeff88,transparent 40%),#f8faff;color:#090b31}
.home-master::before{content:"";position:absolute;pointer-events:none;width:90%;height:24rem;right:-25%;top:10rem;transform:rotate(-17deg);border:1px solid #fff;border-radius:50%;background:linear-gradient(180deg,#cabaff44,#fff9,#b9e8ff55);filter:blur(.5px)}
.home-master-shell{position:relative;width:min(1480px,calc(100% - 40px));margin:auto}
.home-master-intro{padding:0 24px 26px;scroll-margin-top:6rem}
.home-master-display{margin:0;font:800 clamp(3.8rem,7.6vw,7.8rem)/1.02 var(--font-display);letter-spacing:-.075em}
.home-master-display span{background:linear-gradient(100deg,#0a0c35 10%,#7364e8 74%,#867cff);background-clip:text;-webkit-text-fill-color:transparent}
.home-master-script{position:relative;width:max-content;max-width:100%;margin:.2rem 0 1.6rem;color:#0c103b;font:400 clamp(2.8rem,5.2vw,5rem)/1.1 "Nothing You Could Do",cursive;letter-spacing:-.07em;transform:rotate(-3deg)}
.home-master-script::after{content:"";position:absolute;bottom:-.3rem;left:0;width:100%;height:3px;border-radius:50%;background:linear-gradient(90deg,#5b83ff,#8b72ed,transparent);transform:rotate(-2deg)}
.home-master-ink-note{margin:0;color:#505680;font-size:clamp(.96rem,1.35vw,1.25rem);line-height:1.6}
.home-legacy-anchor{display:block;scroll-margin-top:6rem}
.home-master-stage{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2px;border:2px solid #fff;border-radius:34px;overflow:hidden;box-shadow:0 16px 48px #293b6414;scroll-margin-top:6rem;background:#fff}
.home-master-route{position:relative;isolation:isolate;aspect-ratio:267/568;min-width:0;display:flex;align-items:end;padding:clamp(18px,2.6vw,40px);text-decoration:none;color:#fff;overflow:hidden;background:#18273d}
.home-portal-art{position:absolute;z-index:-2;inset:0;overflow:hidden}
.home-portal-art::before{content:"";position:absolute;top:-64.26%;left:var(--art-x);width:416.1%;aspect-ratio:1111/1416;background:url('/images/home-approved-20260930.webp') center/100% 100% no-repeat;transition:filter 180ms ease}
.home-master-route::after{content:"";position:absolute;z-index:-1;inset:65% 0 0;background:linear-gradient(180deg,transparent 0%,#122940 27%,#122940 100%)}
.home-master-route-marketing::after{background:linear-gradient(180deg,transparent,#172a23 27%,#172a23)}
.home-master-route-technology::after{background:linear-gradient(180deg,transparent,#44362e 27%,#44362e)}
.home-master-route-academy::after{background:linear-gradient(180deg,transparent,#382b50 27%,#382b50)}
.home-master-route-copy{display:grid;gap:12px;min-width:0;width:100%}
.home-master-route-copy small{display:flex;align-items:center;gap:10px;font:700 clamp(.58rem,.85vw,.85rem)/1.3 var(--font-body);letter-spacing:.12em;text-transform:uppercase}
.home-master-route-copy i{display:block;width:5px;height:18px;border-radius:5px;background:var(--route-accent)}
.home-master-route-copy strong{font:800 clamp(1.45rem,2.8vw,2.7rem)/1.03 var(--font-display);letter-spacing:-.055em;padding-right:26px;color:#fff}
.home-route-detail{font-size:clamp(.7rem,.85vw,.85rem);line-height:1.45;color:#f0f2fa;max-width:28ch}
.home-master-route-arrow{position:absolute;right:clamp(12px,2vw,28px);top:60%;display:grid;place-items:center;width:48px;height:48px;border:1px solid #ffffff80;border-radius:50%;background:#ffffff12}
.home-master-route:hover .home-portal-art::before{filter:brightness(1.07)}
.home-master-route:focus-visible{outline:4px solid #fff;outline-offset:-7px;box-shadow:inset 0 0 0 10px #131b52}
@media(max-width:1000px){.home-master{padding-top:7rem}.home-master-route{padding:18px}.home-master-route-arrow{width:36px;height:36px;right:12px;top:60%}.home-master-route-copy strong{font-size:1.5rem}.home-route-detail{font-size:.73rem}.home-master-route-copy small{font-size:.6rem}}
@media(max-width:700px){.home-master{padding-top:6rem}.home-master-shell{width:calc(100% - 24px)}.home-master-intro{padding:0 8px 24px}.home-master-display{font-size:clamp(2.5rem,10.2vw,4.4rem);letter-spacing:-.065em}.home-master-script{font-size:2.6rem}.home-master-stage{grid-template-columns:repeat(2,minmax(0,1fr));gap:2px;border-radius:26px}.home-master-route{padding:16px 12px;aspect-ratio:267/620}.home-master-route-copy{gap:8px}.home-master-route-copy strong{font-size:clamp(1.35rem,5vw,2rem);padding:0}.home-master-route-copy small{font-size:.56rem;gap:6px;letter-spacing:.08em}.home-route-detail{font-size:.7rem}.home-master-route-arrow{right:12px;top:52%;width:36px;height:36px}.home-portal-art::before{top:-58.87%}.home-master-route::after{inset:56% 0 0}}
@media(prefers-reduced-motion:reduce){.home-portal-art::before{transition:none}}
</style>
