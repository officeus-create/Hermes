---
import { ArrowUpRight } from "@lucide/astro";
import { publicPaths } from "../data/public-paths";

const flowStages = ["event", "system", "human", "outcome"] as const;
const routeMeta: Record<string, { accent: string; detail: string; displayNumber: string; crop: number; goal: string; flow: readonly [string, string, string, string]; flowPath: string }> = {
  logistics: {
    accent: "var(--hermes-logistics)",
    detail: "Car hauling · dealers · shippers · carriers",
    flow: ["Request", "Route fit", "Human review", "Handoff"],
    flowPath: "M10 14 C26 8 31 39 47 34 S67 12 88 20",
    displayNumber: "01", crop: 20, goal: "Move freight",
  },
  marketing: {
    accent: "var(--hermes-marketing)",
    detail: "Website · SEO/GEO · customer acquisition",
    flow: ["Content", "Search + social", "Site action", "Inquiry"],
    flowPath: "M9 37 C25 13 39 49 54 31 S75 15 91 19",
    displayNumber: "02", crop: 296, goal: "Grow demand",
  },
  technology: {
    accent: "var(--hermes-technology)",
    detail: "CRM · automation · custom software",
    flow: ["Request", "CRM context", "Automation", "Receipt"],
    flowPath: "M9 18 H31 V41 H56 V25 H77 V40 H91",
    displayNumber: "03", crop: 556, goal: "Build systems",
  },
  academy: {
    accent: "var(--hermes-academy)",
    detail: "U.S. logistics · sales · marketing · operations",
    flow: ["Lesson", "Practice", "Review", "Progression"],
    flowPath: "M9 48 H30 V38 H51 V28 H71 V18 H91",
    displayNumber: "04", crop: 818, goal: "Develop people",
  },
};
---
<section class="home-master" id="top" aria-labelledby="home-master-title">
  <div class="home-master-shell">
    <header class="home-master-intro" id="about">
      <h1 id="home-master-title" class="home-master-display" aria-label="Four directions.">Four <span>direct<span class="home-display-i">i</span>ons.</span></h1>
      <p class="home-master-script">Choose yours.</p>
      <p class="home-master-ink-note">Logistics, marketing, technology and learning for your business. One Hermes ecosystem.</p>
    </header>
    <span id="journey" class="home-legacy-anchor" aria-hidden="true"></span>
    <nav class="home-master-stage" id="paths" aria-label="Hermes operating directions">
      {publicPaths.map((path) => {
        const meta = routeMeta[path.id] ?? routeMeta.logistics;
        const flowLabel = meta.flow.join(", ").toLowerCase();
        return (
          <a class={`home-master-route home-master-route-${path.id}`} href={`/paths/${path.id}/`}
            style={`--route-accent:${meta.accent}`}
            aria-label={`${meta.goal}: ${path.brandLabel} — ${meta.detail}. Example flow: ${flowLabel}.`} data-home-route data-route-id={path.id}>
            <span class="home-portal-art" aria-hidden="true">
              {path.id === "logistics" ? (
                <>
                  <img
                    data-home-logistics-scene-image
                    data-logistics-layer-state="active"
                    data-logistics-scene-ready="car-hauler"
                    src="/images/logistics-living/car-hauler-512.webp"
                    srcset="/images/logistics-living/car-hauler-512.webp 512w, /images/logistics-living/car-hauler-887.webp 887w"
                    sizes="(max-width:700px) calc(100vw - 24px), (min-width:1520px) 368px, calc((100vw - 50px) / 4)"
                    width="887"
                    height="1590"
                    aria-hidden="true"
                    alt="Illustrative aerial U.S. logistics route with changing freight equipment and weather"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                  <img
                    data-home-logistics-scene-image
                    data-logistics-layer-state="idle"
                    data-logistics-scene-ready="car-hauler"
                    src="/images/logistics-living/car-hauler-512.webp"
                    srcset="/images/logistics-living/car-hauler-512.webp 512w, /images/logistics-living/car-hauler-887.webp 887w"
                    sizes="(max-width:700px) calc(100vw - 24px), (min-width:1520px) 368px, calc((100vw - 50px) / 4)"
                    width="887"
                    height="1590"
                    aria-hidden="true"
                    alt="Illustrative aerial U.S. logistics route with changing freight equipment and weather"
                    loading="eager"
                    decoding="async"
                    fetchpriority="low"
                  />
                </>
              ) : (
                <picture>
                  <source type="image/avif" srcset={`/images/home-20261001/${path.id}-512.avif 512w, /images/home-20261001/${path.id}-887.avif 887w`} sizes="(max-width:700px) calc(100vw - 24px), (min-width:1520px) 368px, calc((100vw - 50px) / 4)" />
                  <img src={`/images/home-20261001/${path.id}-512.webp`} srcset={`/images/home-20261001/${path.id}-512.webp 512w, /images/home-20261001/${path.id}-887.webp 887w`} sizes="(max-width:700px) calc(100vw - 24px), (min-width:1520px) 368px, calc((100vw - 50px) / 4)" width="887" height="1774" aria-hidden="true" alt={`${path.brandLabel} architectural scene`} loading={path.id === "marketing" ? "eager" : "lazy"} decoding="async" fetchpriority="auto" />
                </picture>
              )}
            </span>
            {path.id === "logistics" && (
              <span
                class="home-logistics-living"
                aria-hidden="true"
                data-home-logistics-echo
                data-logistics-echo-scene="car-hauler"
                data-logistics-echo-count="6"
                data-logistics-echo-scenes="car-hauler,dry-van,reefer,flatbed,step-deck,hotshot"
                data-logistics-echo-motion="idle"
              >
                <span class="home-logistics-scene-layer" data-home-logistics-weather-layer data-logistics-layer-state="active" data-logistics-echo-scene="car-hauler">
                  <span class="home-logistics-weather"></span>
                </span>
                <span class="home-logistics-scene-layer" data-home-logistics-weather-layer data-logistics-layer-state="idle" data-logistics-echo-scene="car-hauler">
                  <span class="home-logistics-weather"></span>
                </span>
              </span>
            )}
            
            {path.id === "logistics" && <span class="home-scene-detail home-road-flow" aria-hidden="true"><i></i><i></i><i></i></span>}
            <span class={`home-live-explainer home-live-explainer-${path.id}`} data-home-explainer={path.id} aria-hidden="true">
              <span class="home-live-kicker">Example workflow</span>
              <svg class="home-live-path" viewBox="0 0 100 58" preserveAspectRatio="none" aria-hidden="true">
                <path d={meta.flowPath} />
              </svg>
              {meta.flow.map((label, index) => (
                <span class="home-live-step" data-live-step={flowStages[index]} data-live-index={index}>
                  <b>{String(index + 1).padStart(2, "0")}</b><em>{label}</em>
                </span>
              ))}
            </span>
            {path.id === "marketing" && <span class="home-scene-detail home-attention-signal" aria-hidden="true" data-home-pillar-proof="attention"><i></i></span>}
            {path.id === "technology" && <span class="home-scene-detail home-system-display" aria-hidden="true" data-home-pillar-proof="systems"><i class="home-system-scan"></i><span class="home-system-code"><b></b><b></b><b></b><b></b></span><span class="home-system-output"><i></i><b></b></span><i class="home-system-node"></i><i class="home-system-node"></i><i class="home-system-node"></i><i class="home-system-node"></i></span>}
            {path.id === "academy" && <span class="home-scene-detail home-learning-detail" aria-hidden="true" data-home-pillar-proof="progress"><i class="home-book-page"><svg viewBox="0 0 100 30" preserveAspectRatio="none"><path d="M13 20 C24 12 30 17 41 10 S61 14 74 7" /></svg></i><i class="home-academy-pen"></i><span class="home-academy-track"><i>Logistics</i><i>Sales</i><i>Marketing</i><i>Operations</i></span></span>}
            <span class="home-master-route-copy">
              <small><i aria-hidden="true"></i>{meta.goal}</small>
              <strong>Hermes<br />{path.brandLabel.replace("Hermes ", "")}</strong>
              <span class="home-route-detail">{meta.detail}</span>
            </span>
            <span class="home-master-route-arrow" aria-hidden="true"><ArrowUpRight size={24} /></span>
          </a>
        );
      })}
    </nav>
  </div>
</section>
<script>
  import { trackCtaClicked, trackTrackSelected } from "../lib/analytics.ts";

  const logisticsEcho = document.querySelector<HTMLElement>("[data-home-logistics-echo]");
  if (logisticsEcho && window.IntersectionObserver) {
    const scenes = ["car-hauler", "dry-van", "reefer", "flatbed", "step-deck", "hotshot"] as const;
    const sceneImages = Array.from(document.querySelectorAll<HTMLImageElement>("[data-home-logistics-scene-image]"));
    const weatherLayers = Array.from(logisticsEcho.querySelectorAll<HTMLElement>("[data-home-logistics-weather-layer]"));
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let sceneIndex = 0;
    let sceneTimer: number | undefined;
    let visible = false;
    let activeLayer = 0;

    let sceneRequest = 0;
    const preloadScene = (scene: (typeof scenes)[number]) => {
      const referenceImage = sceneImages[0];
      if (!referenceImage) return Promise.resolve();
      const candidate = new Image();
      candidate.sizes = referenceImage.sizes;
      candidate.srcset = `/images/logistics-living/${scene}-512.webp 512w, /images/logistics-living/${scene}-887.webp 887w`;
      candidate.src = `/images/logistics-living/${scene}-512.webp`;
      if (candidate.decode) return candidate.decode();
      return new Promise<void>((resolve, reject) => {
        candidate.addEventListener("load", () => resolve(), { once: true });
        candidate.addEventListener("error", () => reject(new Error(`Failed to decode ${scene}`)), { once: true });
      });
    };
    const setLayerState = (nextLayer: number) => {
      sceneImages.forEach((image, index) => {
        image.dataset.logisticsLayerState = index === nextLayer ? "active" : "idle";
      });
      weatherLayers.forEach((layer, index) => {
        layer.dataset.logisticsLayerState = index === nextLayer ? "active" : "idle";
      });
      activeLayer = nextLayer;
    };
    const applyScene = async (immediate = false) => {
      const scene = scenes[sceneIndex];
      const request = ++sceneRequest;
      const targetLayer = immediate ? activeLayer : (activeLayer + 1) % Math.max(sceneImages.length, 1);
      const targetImage = sceneImages[targetLayer];
      const targetWeather = weatherLayers[targetLayer];
      if (targetImage) {
        try {
          await preloadScene(scene);
        } catch {
          return;
        }
        if (request !== sceneRequest) return;
        targetImage.src = `/images/logistics-living/${scene}-512.webp`;
        targetImage.srcset = `/images/logistics-living/${scene}-512.webp 512w, /images/logistics-living/${scene}-887.webp 887w`;
        targetImage.dataset.logisticsSceneReady = scene;
      }
      if (targetWeather) targetWeather.dataset.logisticsEchoScene = scene;

      const commitScene = () => {
        if (request !== sceneRequest) return;
        setLayerState(targetLayer);
        logisticsEcho.dataset.logisticsEchoScene = scene;
      };
      if (immediate || reduced.matches || sceneImages.length < 2 || weatherLayers.length < 2) {
        commitScene();
      } else {
        requestAnimationFrame(() => requestAnimationFrame(commitScene));
      }

      const next = scenes[(sceneIndex + 1) % scenes.length];
      void preloadScene(next).catch(() => undefined);
    };
    const stop = () => {
      if (sceneTimer) window.clearInterval(sceneTimer);
      sceneTimer = undefined;
    };
    const update = () => {
      if (reduced.matches) {
        stop();
        sceneIndex = 0;
        void applyScene(true);
        logisticsEcho.dataset.logisticsEchoMotion = "reduced";
        return;
      }
      if (!visible || document.hidden) {
        stop();
        logisticsEcho.dataset.logisticsEchoMotion = "paused";
        return;
      }
      logisticsEcho.dataset.logisticsEchoMotion = "running";
      if (sceneTimer) return;
      sceneTimer = window.setInterval(() => {
        sceneIndex = (sceneIndex + 1) % scenes.length;
        void applyScene();
      }, 5200);
    };

    const observer = new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= .2);
      update();
    }, { threshold: .2 });
    observer.observe(logisticsEcho);
    reduced.addEventListener("change", update);
    document.addEventListener("visibilitychange", update);
    void applyScene(true);
    update();
  }

  document.querySelectorAll<HTMLAnchorElement>("[data-home-route]").forEach((link) => {
    link.addEventListener("click", () => {
      const id = link.dataset.routeId;
      if (!id) return;
      trackTrackSelected(id);
      trackCtaClicked(`home_direction_${id}`);
    });
  });
</script>
<style>
.home-master{position:relative;overflow:hidden;padding:8.5rem 0 1.5rem;background:#f7f6f3;color:#111318}
.home-master::before{content:"";display:none}
.home-master-shell{position:relative;width:min(1480px,calc(100% - 40px));margin:auto}
.home-master-intro{padding:0 24px 26px;scroll-margin-top:6rem}
.home-master-display{margin:0;font:800 clamp(3.8rem,7.6vw,7.8rem)/1.02 var(--font-display);letter-spacing:-.075em}
.home-master-display span{color:inherit}
.home-display-i{display:inline-block;transform-origin:50% 90%;animation:home-letter-hop 1.15s ease-out .7s 2}
.home-master-script{position:relative;width:max-content;max-width:100%;margin:.55rem 0 1rem;color:#59606b;font:650 clamp(.98rem,1.35vw,1.15rem)/1.35 var(--font-body);letter-spacing:.08em;text-transform:uppercase;transform:none}
.home-master-script::after{content:none}
.home-master-ink-note{max-width:60ch;margin:0;color:#666c79;font-size:clamp(.96rem,1.22vw,1.16rem);line-height:1.6}
.home-legacy-anchor{display:block;scroll-margin-top:6rem}
.home-master-stage{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;border:1px solid #dfe2e7;border-radius:34px;overflow:hidden;box-shadow:0 20px 54px rgba(17,19,24,.08);scroll-margin-top:6rem;background:#dfe2e7}
.home-master-route{position:relative;isolation:isolate;aspect-ratio:267/568;min-width:0;display:flex;align-items:end;padding:clamp(18px,2.6vw,40px);text-decoration:none;color:#fff;overflow:hidden;background:#18273d}
.home-master-route-logistics{--flow-panel:#0b2139d9;--flow-kicker:#0b2139c7;--flow-border:#dff3ff99;--flow-dot:#a9e4ff;--flow-light:#9ed8ff;--flow-line:#d8f4ff;--flow-glow:#51bfff}
.home-master-route-marketing{--flow-panel:#102c25dc;--flow-kicker:#102c25c9;--flow-border:#dfffe999;--flow-dot:#9de7b7;--flow-light:#a9edbf;--flow-line:#dcffe7;--flow-glow:#45ce78}
.home-master-route-technology{--flow-panel:#3a281edc;--flow-kicker:#3a281ec9;--flow-border:#ffe8c799;--flow-dot:#ffc274;--flow-light:#ffd096;--flow-line:#ffe4b5;--flow-glow:#ff9f4b}
.home-master-route-academy{--flow-panel:#2d2044dc;--flow-kicker:#2d2044c9;--flow-border:#eee0ff99;--flow-dot:#c7a6ff;--flow-light:#d5bdff;--flow-line:#efe3ff;--flow-glow:#a979ff}
.home-portal-art{position:absolute;z-index:-2;inset:0;overflow:hidden}
.home-portal-art picture{display:block;width:100%;height:92%}
.home-portal-art img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:filter 180ms ease}
.home-master-route-logistics .home-portal-art img{position:absolute;inset:0;object-position:center center;opacity:0;animation:home-logistics-camera 9.5s ease-in-out infinite alternate;transition:opacity .72s cubic-bezier(.4,0,.2,1),filter .45s ease,transform .8s ease;will-change:opacity,transform}
.home-master-route-logistics .home-portal-art img[data-logistics-layer-state="active"]{opacity:1}
.home-portal-motion{position:absolute;z-index:-2;pointer-events:none;display:block}
.home-portal-motion img{display:block;width:100%;height:auto}
.home-logistics-living{position:absolute;z-index:-1;inset:0;display:block;overflow:hidden;pointer-events:none}
.home-logistics-scene-layer{position:absolute;inset:0;display:block;opacity:0;transition:opacity .72s cubic-bezier(.4,0,.2,1);will-change:opacity}
.home-logistics-scene-layer[data-logistics-layer-state="active"]{opacity:1}
.home-logistics-weather{position:absolute;z-index:1;inset:0;display:block;opacity:.28}
.home-logistics-scene-layer::before{content:"";position:absolute;z-index:1;inset:0;background:linear-gradient(180deg,rgba(5,22,38,.04),rgba(5,22,38,.18));opacity:.45}
