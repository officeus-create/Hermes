.home-tech-readback-ui{display:grid;grid-template-columns:1fr 1fr}.home-tech-readback-ui i{text-align:center}
.home-system-connect{left:0;top:14%;width:46%}.home-system-factory{right:0;top:22%;width:46%}.home-system-social{left:2%;bottom:1%;width:47%}.home-system-readback{right:0;bottom:0;width:47%}
