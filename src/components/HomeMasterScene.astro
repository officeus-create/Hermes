.home-logistics-scene-layer[data-logistics-echo-scene="dry-van"] .home-logistics-weather{background:radial-gradient(ellipse at 42% 3%,rgba(225,240,247,.22),transparent 52%),repeating-linear-gradient(101deg,transparent 0 28px,rgba(222,241,248,.18) 30px 31px,transparent 33px 58px),repeating-linear-gradient(103deg,transparent 0 43px,rgba(242,249,252,.1) 45px 46px,transparent 48px 88px);background-size:100% 100%,185% 165%,245% 190%;-webkit-mask-image:linear-gradient(to bottom,#000 0 68%,rgba(0,0,0,.72) 82%,transparent 100%);mask-image:linear-gradient(to bottom,#000 0 68%,rgba(0,0,0,.72) 82%,transparent 100%);filter:blur(.22px);animation:home-logistics-rain 1.7s linear infinite;opacity:.3}
.home-logistics-scene-layer[data-logistics-echo-scene="dry-van"]::before{background:linear-gradient(180deg,rgba(13,36,52,.16),rgba(3,18,29,.35));opacity:.58}
.home-logistics-scene-layer[data-logistics-echo-scene="reefer"] .home-logistics-weather{background:radial-gradient(circle,#fff 0 1px,transparent 1.6px) 0 0/20px 25px,radial-gradient(circle,#edf8ff 0 1px,transparent 1.6px) 10px 8px/27px 30px;animation:home-logistics-snow 4.4s linear infinite;opacity:.72}
.home-logistics-scene-layer[data-logistics-echo-scene="reefer"]::before{background:linear-gradient(180deg,rgba(226,242,248,.08),rgba(93,130,148,.3));opacity:.72}
.home-logistics-scene-layer[data-logistics-echo-scene="flatbed"] .home-logistics-weather{background:radial-gradient(ellipse at 72% 23%,rgba(255,221,146,.38),transparent 30%),linear-gradient(180deg,rgba(191,126,72,.05),rgba(131,78,42,.18));animation:home-logistics-heat 3.2s ease-in-out infinite alternate;opacity:.64}
.home-logistics-scene-layer[data-logistics-echo-scene="step-deck"] .home-logistics-weather{background:radial-gradient(ellipse at 22% 25%,rgba(245,250,250,.35),transparent 24%),radial-gradient(ellipse at 72% 19%,rgba(235,243,245,.38),transparent 31%);animation:home-logistics-cloud 6.8s ease-in-out infinite alternate;opacity:.65}
.home-logistics-scene-layer[data-logistics-echo-scene="hotshot"] .home-logistics-weather{background:radial-gradient(circle at 80% 19%,rgba(251,174,126,.34),transparent 25%),linear-gradient(180deg,rgba(14,29,51,.08),rgba(7,16,28,.44));opacity:.58}
.home-logistics-scene-layer[data-logistics-echo-scene="hotshot"]::before{background:linear-gradient(180deg,rgba(8,25,45,.12),rgba(5,12,26,.48));opacity:.68}
[data-logistics-scene-ready="hotshot"]{filter:brightness(1.04)}
.home-scene-detail{position:absolute;z-index:-2;display:block;pointer-events:none}
.home-road-flow{inset:23% 8% auto 26%;height:38%}
.home-road-flow i{position:absolute;display:block;width:10%;height:2px;border-radius:3px;background:#d0f4ff;box-shadow:0 0 8px 2px #63c7ffb0;opacity:0;transform:rotate(-51deg)}
.home-road-flow i:nth-child(1){left:12%;top:14%}.home-road-flow i:nth-child(2){left:44%;top:37%}.home-road-flow i:nth-child(3){left:74%;top:13%}
.home-master-route-logistics:is(:hover,:focus-visible) .home-road-flow i{animation:home-road-streak 1.9s ease-in-out 2}
.home-master-route-logistics:is(:hover,:focus-visible) .home-road-flow i:nth-child(2){animation-delay:.28s}.home-master-route-logistics:is(:hover,:focus-visible) .home-road-flow i:nth-child(3){animation-delay:.56s}
.home-live-explainer{position:absolute;z-index:1;inset:9% 5% 37%;pointer-events:none;opacity:0;transform:translateY(7px);transition:opacity .28s ease .08s,transform .38s cubic-bezier(.16,1,.3,1) .08s}
.home-live-kicker{position:absolute;left:1%;top:0;padding:5px 8px;border:1px solid var(--flow-border);border-radius:999px;background:var(--flow-kicker);box-shadow:0 7px 18px #0715272e;backdrop-filter:blur(7px);color:#fff;font:700 .5rem/1 var(--font-body);letter-spacing:.12em;text-transform:uppercase}
.home-live-path{position:absolute;inset:9% 0 0;width:100%;height:82%;overflow:visible}
.home-live-path path{fill:none;stroke:var(--flow-line);stroke-width:.75;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:180;stroke-dashoffset:180;filter:drop-shadow(0 0 4px var(--flow-glow));opacity:.88}
.home-live-step{position:absolute;display:flex;align-items:center;gap:5px;min-width:0;padding:6px 8px;border:1px solid var(--flow-border);border-radius:999px;background:var(--flow-panel);box-shadow:0 8px 20px #0715273b;backdrop-filter:blur(7px);opacity:0;transform:translateY(6px) scale(.96);transition:opacity .3s ease,transform .42s cubic-bezier(.16,1,.3,1)}
.home-live-step::before{content:"";flex:none;width:5px;height:5px;border-radius:50%;background:var(--flow-dot);box-shadow:0 0 0 3px color-mix(in srgb,var(--flow-dot) 22%,transparent),0 0 9px var(--flow-glow)}
.home-live-step b{color:var(--flow-light);font:700 .48rem/1 var(--font-mono);letter-spacing:.04em}
.home-live-step em{overflow:hidden;color:#fff;font:700 clamp(.48rem,.62vw,.64rem)/1.1 var(--font-body);font-style:normal;white-space:nowrap;text-overflow:ellipsis}
.home-live-step[data-live-step="event"]{left:2%;top:21%}
.home-live-step[data-live-step="system"]{left:29%;top:48%}
.home-live-step[data-live-step="human"]{left:55%;top:24%}
.home-live-step[data-live-step="outcome"]{right:1%;top:37%}
.home-master-route-marketing .home-live-step[data-live-step="event"]{left:2%;top:39%}
.home-master-route-marketing .home-live-step[data-live-step="system"]{left:21%;top:14%}
.home-master-route-marketing .home-live-step[data-live-step="human"]{left:49%;top:45%}
.home-master-route-marketing .home-live-step[data-live-step="outcome"]{right:1%;top:22%}
.home-master-route-technology .home-live-step[data-live-step="event"]{left:2%;top:18%}
.home-master-route-technology .home-live-step[data-live-step="system"]{left:28%;top:49%}
.home-master-route-technology .home-live-step[data-live-step="human"]{left:54%;top:26%}
.home-master-route-technology .home-live-step[data-live-step="outcome"]{right:1%;top:48%}
.home-master-route-academy .home-live-step[data-live-step="event"]{left:2%;top:60%}
