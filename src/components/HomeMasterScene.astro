.home-product-choreography[data-motion-state="running"] .home-system-factory{animation-delay:-1.8s}
.home-product-choreography[data-motion-state="running"] .home-system-social{animation-delay:-3.6s}
.home-product-choreography[data-motion-state="running"] .home-system-readback{animation-delay:-5.4s}
