---
import { ArrowUpRight } from "@lucide/astro";
import { publicPaths } from "../data/public-paths";

const flowStages = ["event", "system", "human", "outcome"] as const;
const logisticsMotionAssets = {
  roadPlate: "https://d2ol7oe51mr4n9.cloudfront.net/user_3K2RIb8GaEmI9eYSW3sHa7Z6C2J/1be856c6-56bc-4bc5-ba98-a9e4f1afd4f4.png",
  truckLayer: "https://d2ol7oe51mr4n9.cloudfront.net/user_3K2RIb8GaEmI9eYSW3sHa7Z6C2J/c0fa738b-9af6-4c84-9d8c-1445ea0ba6d0.png",
} as const;
const routeMeta: Record<string, { accent: string; detail: string; displayNumber: string; crop: number; goal: string; flow: readonly [string, string, string, string]; flowPath: string }> = {
  logistics: {
    accent: "var(--hermes-logistics)",
    detail: "Car hauling · dealers · shippers · carriers",
    flow: ["Request", "Route fit", "Human review", "Handoff"],
    flowPath: "M10 14 C26 8 31 39 47 34 S67 12 88 20",
    displayNumber: "01", crop: 20, goal: "Move freight",
  },
  marketing: {
    accent: "var(--hermes-marketing)",
    detail: "Website · SEO/GEO · customer acquisition",
    flow: ["Content + news", "Search + social", "Website action", "CRM evidence"],
    flowPath: "M9 37 C25 13 39 49 54 31 S75 15 91 19",
    displayNumber: "02", crop: 296, goal: "Grow demand",
  },
  technology: {
    accent: "var(--hermes-technology)",
    detail: "CRM · automation · custom software",
    flow: ["Hermes Connect", "Website Factory", "Social connectors", "QA readback"],
    flowPath: "M9 18 H31 V41 H56 V25 H77 V40 H91",
    displayNumber: "03", crop: 556, goal: "Build systems",
  },
  academy: {
    accent: "var(--hermes-academy)",
    detail: "Logistics · marketing · IT/AI · sales · operations",
    flow: ["Task", "Practice", "Feedback", "Next level"],
    flowPath: "M9 48 H30 V38 H51 V28 H71 V18 H91",
    displayNumber: "04", crop: 818, goal: "Develop people",
  },
};
---
<section class="home-master" id="top" aria-labelledby="home-master-title">
  <div class="home-master-shell">
    <header class="home-master-intro" id="about">
      <h1 id="home-master-title" class="home-master-display" aria-label="Four directions.">Four <span>direct<span class="home-display-i">i</span>ons.</span></h1>
      <p class="home-master-script">Choose yours.</p>
      <p class="home-master-ink-note">Logistics, marketing, technology and learning for your business. One Hermes ecosystem.</p>
    </header>
    <span id="journey" class="home-legacy-anchor" aria-hidden="true"></span>
    <nav class="home-master-stage" id="paths" aria-label="Hermes operating directions">
      {publicPaths.map((path) => {
        const meta = routeMeta[path.id] ?? routeMeta.logistics;
        const flowLabel = meta.flow.join(", ").toLowerCase();
        return (
          <a class={`home-master-route home-master-route-${path.id}`} href={`/paths/${path.id}/`}
            style={`--route-accent:${meta.accent}`}
            aria-label={`${meta.goal}: ${path.brandLabel} — ${meta.detail}. Example flow: ${flowLabel}.`} data-home-route data-route-id={path.id}>
            <span class="home-portal-art" aria-hidden="true">
              {path.id === "logistics" ? (
                <span class="home-logistics-layer-stack">
                  <img
                    data-home-logistics-scene-image
                    data-logistics-scene-ready="car-hauler"
                    src="/images/logistics-living/car-hauler-512.webp"
                    srcset="/images/logistics-living/car-hauler-512.webp 512w, /images/logistics-living/car-hauler-768.webp 768w, /images/logistics-living/car-hauler-887.webp 887w"
                    sizes="(max-width:700px) calc(100vw - 24px), (min-width:701px) and (max-width:1000px) calc((100vw - 40px) / 2), (min-width:1520px) 368px, calc((100vw - 50px) / 4)"
                    width="887"
                    height="1590"
                    aria-hidden="true"
                    alt="Illustrative aerial U.S. logistics route with changing freight equipment and weather"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                  <img
                    class="home-logistics-road-plate"
                    data-home-logistics-road-plate
                    data-logistics-source={logisticsMotionAssets.roadPlate}
                    width="768"
                    height="1376"
                    aria-hidden="true"
                    alt="Aerial U.S. highway road plate for the Hermes Logistics living scene"
                    loading="eager"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                  <img
                    class="home-logistics-truck-layer"
                    data-home-logistics-truck-layer
                    data-logistics-source={logisticsMotionAssets.truckLayer}
                    width="887"
                    height="1590"
                    aria-hidden="true"
                    alt="Single car-hauler truck motion layer for the Hermes Logistics living scene"
                    loading="eager"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                </span>
              ) : path.id === "technology" ? (
                <picture>
                  <source type="image/avif" srcset="/images/home-20261001/technology-512.avif 512w, /images/home-20261001/technology-887.avif 887w" sizes="(max-width:700px) calc(100vw - 24px), (min-width:701px) and (max-width:1000px) calc((100vw - 40px) / 2), (min-width:1520px) 368px, calc((100vw - 50px) / 4)" />
                  <img src="/images/home-20261001/technology-512.webp" srcset="/images/home-20261001/technology-512.webp 512w, /images/home-20261001/technology-887.webp 887w" sizes="(max-width:700px) calc(100vw - 24px), (min-width:701px) and (max-width:1000px) calc((100vw - 40px) / 2), (min-width:1520px) 368px, calc((100vw - 50px) / 4)" width="887" height="1774" aria-hidden="true" alt="Hermes Technology architectural scene" loading="lazy" decoding="async" fetchpriority="auto" />
                </picture>
              ) : path.id === "academy" ? (
                <picture>
                  <source type="image/avif" srcset="/images/home-20261001/academy-512.avif 512w, /images/home-20261001/academy-887.avif 887w" sizes="(max-width:700px) calc(100vw - 24px), (min-width:701px) and (max-width:1000px) calc((100vw - 40px) / 2), (min-width:1520px) 368px, calc((100vw - 50px) / 4)" />
                  <img src="/images/home-20261001/academy-512.webp" srcset="/images/home-20261001/academy-512.webp 512w, /images/home-20261001/academy-887.webp 887w" sizes="(max-width:700px) calc(100vw - 24px), (min-width:701px) and (max-width:1000px) calc((100vw - 40px) / 2), (min-width:1520px) 368px, calc((100vw - 50px) / 4)" width="887" height="1774" aria-hidden="true" alt="Hermes Academy warm architectural study environment" loading="lazy" decoding="async" fetchpriority="auto" />
                </picture>
              ) : null}
            </span>
            {path.id === "logistics" && (
              <span
                class="home-logistics-living"
                aria-hidden="true"
                data-home-logistics-echo
                data-logistics-echo-scene="car-hauler"
                data-logistics-weather-state="sun"
                data-logistics-echo-count="6"
                data-logistics-equipment-cycle-ms="15600"
                data-logistics-weather-cycle-ms="5200"
                data-logistics-echo-scenes="car-hauler,dry-van,reefer,flatbed,step-deck,hotshot"
                data-logistics-echo-motion="idle"
              >
                <span class="home-logistics-weather"></span>
              </span>
            )}
            
            {path.id === "logistics" && <span class="home-scene-detail home-road-flow" aria-hidden="true"><i></i><i></i><i></i></span>}
            <span class={`home-live-explainer home-live-explainer-${path.id}`} data-home-explainer={path.id} aria-hidden="true">
              <span class="home-live-kicker">Example workflow</span>
              <svg class="home-live-path" viewBox="0 0 100 58" preserveAspectRatio="none" aria-hidden="true">
                <path d={meta.flowPath} />
              </svg>
              {meta.flow.map((label, index) => (
                <span class="home-live-step" data-live-step={flowStages[index]} data-live-index={index}>
                  <b>{String(index + 1).padStart(2, "0")}</b><em>{label}</em>
                </span>
              ))}
            </span>
            {path.id === "marketing" && (
              <span class="home-scene-detail home-marketing-journey" data-home-pillar-proof="attention" data-home-marketing-journey data-journey-motion="paused" aria-hidden="true">
                <span class="home-marketing-caption">ATTENTION <i></i> DEMAND</span>
                <svg class="home-marketing-conductor" viewBox="0 0 300 480" preserveAspectRatio="none" aria-hidden="true">
                  <path class="home-marketing-track" d="M104 82 C240 105 248 153 192 188 S55 252 132 296 S258 361 205 408" />
                  <path class="home-marketing-pulse" d="M104 82 C240 105 248 153 192 188 S55 252 132 296 S258 361 205 408" />
                </svg>
                <span class="home-marketing-card home-marketing-content">
                  <small><i></i> 01 / CONTENT + NEWS</small>
                  <span class="home-marketing-media"><b class="home-marketing-play"></b><em></em></span>
                  <span class="home-marketing-card-lines"><i></i><i></i></span>
                </span>
                <span class="home-marketing-card home-marketing-discovery">
                  <small><i></i> 02 / DISCOVERY + DISTRIBUTION</small>
                  <span class="home-marketing-channels"><i>Search</i><i>Threads</i><i>IG</i><i>FB</i><i>TG</i></span>
                  <span class="home-marketing-search"><i></i><b></b></span>
                </span>
                <span class="home-marketing-card home-marketing-site">
                  <small><i></i> 03 / WEBSITE ACTION</small>
                  <span class="home-marketing-browser"><b></b><i></i><em></em></span>
                </span>
                <span class="home-marketing-card home-marketing-inquiry">
                  <small><i></i> 04 / INQUIRY → CRM EVIDENCE</small>
                  <span class="home-marketing-person"><i></i><b></b><em></em></span>
                  <span class="home-marketing-beacon" aria-hidden="true"><i></i></span>
                </span>
              </span>
            )}
            {path.id === "technology" && (
              <span class="home-scene-detail home-system-display home-product-choreography" aria-hidden="true" data-home-pillar-proof="systems" data-home-living-motion data-motion-state="idle">
                <span class="home-system-caption">REAL PRODUCT UI <i></i> TRUTHFUL STATES</span>
                <span class="home-system-card home-system-connect" data-tech-source="/services/hermes-connect/repair-shops/dashboard/">
                  <small>01 / HERMES CONNECT</small>
                  <strong>SHOP OWNER WORKSPACE</strong>
                  <span class="home-tech-mini home-tech-connect-ui"><i>Services</i><i>Booking inbox</i><i>Catalog inquiries</i></span>
                  <em>private CRM surface</em>
                </span>
                <span class="home-system-wire home-system-wire-a"><i></i></span>
                <span class="home-system-card home-system-factory" data-tech-source="/services/website-development/">
                  <small>02 / WEBSITE DELIVERY</small>
                  <strong>SEMANTIC BUILD</strong>
                  <span class="home-tech-mini home-tech-factory-ui"><i>Responsive</i><i>Canonical</i><i>Schema</i></span>
                  <em>business context → release evidence</em>
                </span>
                <span class="home-system-wire home-system-wire-b"><i></i></span>
                <span class="home-system-card home-system-social" data-tech-source="/services/hermes-connect/repair-shops/social/">
                  <small>03 / SOCIAL STUDIO</small>
                  <strong>OWNER AUTHORIZATION</strong>
                  <span class="home-tech-mini home-tech-social-ui"><i>IG</i><i>f</i><i>@</i><b>provider readback</b></span>
                  <em>connect ≠ writable until verified</em>
                </span>
                <span class="home-system-wire home-system-wire-c"><i></i></span>
                <span class="home-system-card home-system-readback" data-tech-source="/services/website-development/">
                  <small>04 / QA + READBACK</small>
                  <strong><i></i> RELEASE EVIDENCE</strong>
                  <span class="home-tech-mini home-tech-readback-ui"><i>Build</i><i>Browser</i><i>390 / 1440</i><i>Readback</i></span>
                  <em>deploy ≠ live until readback</em>
                </span>
              </span>
            )}
            {path.id === "academy" && (
              <span class="home-scene-detail home-learning-detail home-academy-living" aria-hidden="true" data-home-pillar-proof="progress" data-home-living-motion data-motion-state="idle" data-academy-source="/services/hermes-connect/academy/">
                <span class="home-academy-caption">HUMAN PROGRESS <i></i> REVIEWED EVIDENCE</span>
                <span class="home-academy-sunlight"></span>
                <span class="home-academy-leaf-shadow"><i></i><i></i><i></i></span>
                <span class="home-academy-workflow">
                  <span class="home-academy-state home-academy-attempt">
                    <small>01 / TASK + PRACTICE</small>
                    <strong>Practice before consequence</strong>
                    <em>attempt becomes evidence</em>
                  </span>
                  <span class="home-academy-state home-academy-feedback">
                    <small>02 / HUMAN FEEDBACK</small>
                    <strong>One precise correction</strong>
                    <em>reviewer feedback</em>
                  </span>
                  <span class="home-academy-state home-academy-retry">
                    <small>03 / RETRY</small>
                    <strong>Show the change</strong>
                    <em>reviewed second attempt</em>
                  </span>
                  <span class="home-academy-state home-academy-gate">
                    <small>04 / PROGRESSION</small>
                    <strong>Human decision</strong>
                    <em>not automatic</em>
                  </span>
                </span>
                <span class="home-academy-progress"><small>TASK</small><i></i><small>PRACTICE</small><i></i><small>FEEDBACK</small><i></i><small>NEXT STEP</small></span>
              </span>
            )}
            <span class="home-master-route-copy">
              <small><i aria-hidden="true"></i>{meta.goal}</small>
              <strong>Hermes<br />{path.brandLabel.replace("Hermes ", "")}</strong>
              <span class="home-route-detail">{meta.detail}</span>
            </span>
            <span class="home-master-route-arrow" aria-hidden="true"><ArrowUpRight size={24} /></span>
          </a>
        );
      })}
    </nav>
  </div>
</section>
<script>
  import { trackCtaClicked, trackEvent, trackTrackSelected } from "../lib/analytics.ts";

  const logisticsEcho = document.querySelector<HTMLElement>("[data-home-logistics-echo]");
  if (logisticsEcho && window.IntersectionObserver) {
    const scenes = ["car-hauler", "dry-van", "reefer", "flatbed", "step-deck", "hotshot"] as const;
    const weatherStates = ["sun", "fog", "dusk", "rain"] as const;
    const sceneImage = document.querySelector<HTMLImageElement>("[data-home-logistics-scene-image]");
    const roadPlate = document.querySelector<HTMLImageElement>("[data-home-logistics-road-plate]");
    const truckLayer = document.querySelector<HTMLImageElement>("[data-home-logistics-truck-layer]");
    const logisticsRoute = logisticsEcho.closest<HTMLElement>("[data-home-route]");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let sceneIndex = 0;
    let weatherIndex = 0;
    let sceneTimer: number | undefined;
    let weatherTimer: number | undefined;
    let visible = false;
    let layerReady = false;

    const syncLayerMode = () => {
      const active = layerReady && scenes[sceneIndex] === "car-hauler" && !reduced.matches;
      logisticsRoute?.setAttribute("data-logistics-layered", active ? "true" : "false");
    };
    const syncLayerReadiness = () => {
      layerReady = Boolean(roadPlate?.complete && roadPlate.naturalWidth > 0 && truckLayer?.complete && truckLayer.naturalWidth > 0);
      logisticsEcho.dataset.logisticsLayerReady = layerReady ? "true" : "false";
      syncLayerMode();
    };
    // Enhancement remains optional: reduce requests to external image providers.
    const requestEnhancementLayers = () => {
      if (reduced.matches || !visible || document.hidden) return;
      for (const image of [roadPlate, truckLayer]) {
        if (!image || image.hasAttribute("src")) continue;
        const source = image.dataset.logisticsSource;
        if (source) image.src = source;
      }
    };
    const setMotionState = (state: "running" | "paused" | "reduced") => {
      logisticsEcho.dataset.logisticsEchoMotion = state;
      logisticsRoute?.setAttribute("data-logistics-motion", state);
    };
    roadPlate?.addEventListener("load", syncLayerReadiness);
    roadPlate?.addEventListener("error", syncLayerReadiness);
    truckLayer?.addEventListener("load", syncLayerReadiness);
    truckLayer?.addEventListener("error", syncLayerReadiness);

    let sceneRequest = 0;
    const preloadScene = (scene: (typeof scenes)[number]) => {
      if (!sceneImage) return Promise.resolve();
      const candidate = new Image();
      candidate.sizes = sceneImage.sizes;
      candidate.srcset = `/images/logistics-living/${scene}-512.webp 512w, /images/logistics-living/${scene}-768.webp 768w, /images/logistics-living/${scene}-887.webp 887w`;
      candidate.src = `/images/logistics-living/${scene}-512.webp`;
      if (candidate.decode) return candidate.decode();
      return new Promise<void>((resolve, reject) => {
        candidate.addEventListener("load", () => resolve(), { once: true });
        candidate.addEventListener("error", () => reject(new Error(`Failed to decode ${scene}`)), { once: true });
      });
    };
    const applyScene = async () => {
      const scene = scenes[sceneIndex];
      const request = ++sceneRequest;
      if (sceneImage) {
        try {
          await preloadScene(scene);
        } catch {
          return;
        }
        if (request !== sceneRequest) return;
        sceneImage.src = `/images/logistics-living/${scene}-512.webp`;
        sceneImage.srcset = `/images/logistics-living/${scene}-512.webp 512w, /images/logistics-living/${scene}-768.webp 768w, /images/logistics-living/${scene}-887.webp 887w`;
        sceneImage.dataset.logisticsSceneReady = scene;
      }
      logisticsEcho.dataset.logisticsEchoScene = scene;
      syncLayerMode();
    };
    const applyWeather = () => {
      logisticsEcho.dataset.logisticsWeatherState = weatherStates[weatherIndex];
    };
    const stop = () => {
      if (sceneTimer) window.clearInterval(sceneTimer);
      if (weatherTimer) window.clearInterval(weatherTimer);
      sceneTimer = undefined;
      weatherTimer = undefined;
    };
    const update = () => {
      if (reduced.matches) {
        stop();
        sceneIndex = 0;
        weatherIndex = 0;
        applyWeather();
        sceneRequest += 1;
        if (sceneImage && sceneImage.dataset.logisticsSceneReady !== scenes[0]) {
          sceneImage.src = `/images/logistics-living/${scenes[0]}-512.webp`;
          sceneImage.srcset = `/images/logistics-living/${scenes[0]}-512.webp 512w, /images/logistics-living/${scenes[0]}-768.webp 768w, /images/logistics-living/${scenes[0]}-887.webp 887w`;
          sceneImage.dataset.logisticsSceneReady = scenes[0];
          logisticsEcho.dataset.logisticsEchoScene = scenes[0];
        }
        setMotionState("reduced");
        syncLayerMode();
        return;
      }
      if (!visible || document.hidden) {
        stop();
        setMotionState("paused");
        return;
      }
      requestEnhancementLayers();
      setMotionState("running");
      if (!sceneTimer) {
        sceneTimer = window.setInterval(() => {
          sceneIndex = (sceneIndex + 1) % scenes.length;
          applyScene();
        }, 15600);
      }
      if (!weatherTimer) {
        weatherTimer = window.setInterval(() => {
          weatherIndex = (weatherIndex + 1) % weatherStates.length;
          applyWeather();
        }, 5200);
      }
    };

    const observer = new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= .2);
      update();
    }, { threshold: .2 });
    observer.observe(logisticsEcho);
    const nudgeWeather = () => {
      if (reduced.matches) return;
      weatherIndex = (weatherIndex + 1) % weatherStates.length;
      applyWeather();
      if (weatherTimer) {
        window.clearInterval(weatherTimer);
        weatherTimer = undefined;
      }
      update();
    };
    logisticsRoute?.addEventListener("pointerenter", nudgeWeather);
    logisticsRoute?.addEventListener("focusin", nudgeWeather);
    reduced.addEventListener("change", update);
    document.addEventListener("visibilitychange", update);
    syncLayerReadiness();
    update();
  }

  // The Marketing portal is a lightweight, decorative proof replay; no customer data or generated metrics.
  // CSS/SVG runs only while visible and stops on tab hide, mobile motion preference, or when out of view.
  const marketingJourney = document.querySelector<HTMLElement>("[data-home-marketing-journey]");
  if (marketingJourney) {
    const preference = window.matchMedia("(prefers-reduced-motion: reduce)");
    let inView = false;
    const updateJourney = () => {
      marketingJourney.dataset.journeyMotion = preference.matches ? "reduced" : inView && !document.hidden ? "running" : "paused";
    };
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        inView = entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= .2);
        updateJourney();
      }, { threshold: .2 });
      observer.observe(marketingJourney);
    } else {
      inView = true;
    }
    preference.addEventListener("change", updateJourney);
    document.addEventListener("visibilitychange", updateJourney);
    updateJourney();
  }

  const livingProofScenes = document.querySelectorAll<HTMLElement>("[data-home-living-motion]");
  const livingReduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const livingVisibility = new Map<HTMLElement, boolean>();
  const syncLivingProof = (scene: HTMLElement) => {
    scene.dataset.motionState = livingReduced.matches ? "reduced" : livingVisibility.get(scene) && !document.hidden ? "running" : "paused";
  };
  if ("IntersectionObserver" in window) {
    const livingObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const scene = entry.target as HTMLElement;
        livingVisibility.set(scene, entry.isIntersecting && entry.intersectionRatio >= .2);
        syncLivingProof(scene);
      });
    }, { threshold: .2 });
    livingProofScenes.forEach((scene) => {
      livingVisibility.set(scene, false);
      livingObserver.observe(scene);
      syncLivingProof(scene);
    });
  } else {
    livingProofScenes.forEach((scene) => {
      livingVisibility.set(scene, true);
      syncLivingProof(scene);
    });
  }
  livingReduced.addEventListener("change", () => livingProofScenes.forEach(syncLivingProof));
  document.addEventListener("visibilitychange", () => livingProofScenes.forEach(syncLivingProof));

  document.querySelectorAll<HTMLAnchorElement>("[data-home-route]").forEach((link) => {
    link.addEventListener("click", () => {
      const id = link.dataset.routeId;
      if (!id) return;
      trackTrackSelected(id);
      trackCtaClicked(`home_direction_${id}`);
      if (["logistics", "marketing", "technology", "academy"].includes(id)) {
        trackEvent(`home_direction_${id}_selected`, { page_group: "home" });
      }
    });
  });
</script>
<style>
.home-master{position:relative;overflow:hidden;padding:8.5rem 0 1.5rem;background:#f7f6f3;color:#111318}
.home-master::before{content:"";display:none}
.home-master-shell{position:relative;width:min(1480px,calc(100% - 40px));margin:auto}
.home-master-intro{padding:0 24px 26px;scroll-margin-top:6rem}
.home-master-display{margin:0;font:800 clamp(3.8rem,7.6vw,7.8rem)/1.02 var(--font-display);letter-spacing:-.075em}
.home-master-display span{color:inherit}
.home-display-i{display:inline-block;transform-origin:50% 90%;animation:home-letter-hop 5.8s ease-in-out 1s infinite}
.home-master-script{position:relative;width:max-content;max-width:100%;margin:.55rem 0 1rem;color:#59606b;font:650 clamp(.98rem,1.35vw,1.15rem)/1.35 var(--font-body);letter-spacing:.08em;text-transform:uppercase;transform:none}
.home-master-script::after{content:none}
.home-master-ink-note{max-width:60ch;margin:0;color:#666c79;font-size:clamp(.96rem,1.22vw,1.16rem);line-height:1.6}
.home-legacy-anchor{display:block;scroll-margin-top:6rem}
.home-master-stage{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;border:1px solid #dfe2e7;border-radius:34px;overflow:hidden;box-shadow:0 20px 54px rgba(17,19,24,.08);scroll-margin-top:6rem;background:#dfe2e7}
.home-master-route{position:relative;isolation:isolate;aspect-ratio:267/568;min-width:0;display:flex;align-items:end;padding:clamp(18px,2.6vw,40px);text-decoration:none;color:#fff;overflow:hidden;background:#18273d}
.home-master-route-logistics{--flow-panel:#0b2139;--flow-kicker:#0b2139;--flow-border:#dff3ff99;--flow-dot:#a9e4ff;--flow-light:#9ed8ff;--flow-line:#d8f4ff;--flow-glow:#51bfff}
.home-master-route-marketing{--flow-panel:#102c25;--flow-kicker:#102c25;--flow-border:#dfffe999;--flow-dot:#9de7b7;--flow-light:#a9edbf;--flow-line:#dcffe7;--flow-glow:#45ce78}
.home-master-route-technology{--flow-panel:#3a281e;--flow-kicker:#3a281e;--flow-border:#ffe8c799;--flow-dot:#ffc274;--flow-light:#ffd096;--flow-line:#ffe4b5;--flow-glow:#ff9f4b}
.home-master-route-academy{--flow-panel:#2d2044;--flow-kicker:#2d2044;--flow-border:#eee0ff99;--flow-dot:#c7a6ff;--flow-light:#d5bdff;--flow-line:#efe3ff;--flow-glow:#a979ff}
.home-portal-art{position:absolute;z-index:-2;inset:0;overflow:hidden}
.home-portal-art picture{display:block;width:100%;height:92%}
.home-portal-art img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:filter 180ms ease}
/* Camera-locked environment: the road plate stays fixed while one isolated real vehicle layer moves over it. */
.home-logistics-layer-stack{position:absolute;inset:0;display:block;overflow:hidden}
.home-master-route-logistics .home-portal-art img{object-position:center center;transition:opacity .45s ease,filter .45s ease}
.home-logistics-layer-stack>img{position:absolute;inset:0}
.home-logistics-road-plate{z-index:1;opacity:0;transform:none}
.home-logistics-truck-layer{z-index:2;opacity:0;transform:none;transform-origin:50% 72%;will-change:transform;filter:drop-shadow(2px 6px 4px rgba(7,24,35,.2))}
.home-master-route-logistics[data-logistics-layered="true"] [data-home-logistics-scene-image]{opacity:0}
.home-master-route-logistics[data-logistics-layered="true"] .home-logistics-road-plate,
.home-master-route-logistics[data-logistics-layered="true"] .home-logistics-truck-layer{opacity:1}
.home-master-route-logistics[data-logistics-layered="true"] .home-logistics-truck-layer{animation:home-logistics-truck-drive 7.8s cubic-bezier(.32,.72,.2,1) 1 forwards;animation-play-state:paused}
.home-master-route-logistics[data-logistics-layered="true"][data-logistics-motion="running"] .home-logistics-truck-layer{animation-play-state:running}
@keyframes home-logistics-truck-drive{from{transform:translate3d(.85%,-1.15%,0)}to{transform:translate3d(-.9%,1.25%,0)}}
.home-logistics-living{position:absolute;z-index:-1;inset:0;display:block;overflow:hidden;pointer-events:none}
.home-logistics-weather{position:absolute;z-index:1;inset:0;display:block;opacity:.28;transition:background .9s ease,opacity .9s ease,filter .9s ease}
.home-logistics-living::before{content:"";position:absolute;z-index:1;inset:0;background:linear-gradient(180deg,rgba(5,22,38,.04),rgba(5,22,38,.18));opacity:.45;transition:background .9s ease,opacity .9s ease}
[data-logistics-weather-state="sun"] .home-logistics-weather{background:radial-gradient(circle at 20% 13%,rgba(255,229,165,.75),transparent 28%),linear-gradient(132deg,transparent 54%,rgba(255,255,255,.12));opacity:.46}
[data-logistics-weather-state="fog"] .home-logistics-weather{background:radial-gradient(ellipse at 22% 25%,rgba(245,250,250,.42),transparent 28%),radial-gradient(ellipse at 72% 19%,rgba(235,243,245,.46),transparent 35%),linear-gradient(180deg,rgba(232,242,245,.12),rgba(111,139,151,.16));animation:home-logistics-cloud 6.8s ease-in-out infinite alternate;opacity:.72;filter:blur(.25px)}
[data-logistics-weather-state="fog"]::before{background:linear-gradient(180deg,rgba(224,237,241,.05),rgba(75,105,119,.18));opacity:.58}
[data-logistics-weather-state="dusk"] .home-logistics-weather{background:radial-gradient(circle at 80% 19%,rgba(251,174,126,.38),transparent 26%),linear-gradient(180deg,rgba(31,43,68,.05),rgba(7,16,28,.46));opacity:.8}
[data-logistics-weather-state="dusk"]::before{background:linear-gradient(180deg,rgba(8,25,45,.10),rgba(5,12,26,.5));opacity:.82}
[data-logistics-weather-state="rain"] .home-logistics-weather{background:
linear-gradient(180deg,rgba(180,207,219,.16),rgba(33,61,74,.06)),
radial-gradient(ellipse,rgba(229,244,250,.52) 0 .7px,transparent 1px) 0 0/23px 38px,
radial-gradient(ellipse,rgba(211,235,245,.34) 0 .65px,transparent 1px) 11px 13px/31px 48px;
animation:home-logistics-rain 1.45s linear infinite;opacity:.28;filter:blur(.18px)}
[data-logistics-weather-state="rain"]::before{background:linear-gradient(180deg,rgba(13,36,52,.16),rgba(3,18,29,.35));opacity:.58}

.home-scene-detail{position:absolute;z-index:-2;display:block;pointer-events:none}
.home-road-flow{inset:23% 8% auto 26%;height:38%}
.home-road-flow i{position:absolute;display:block;width:10%;height:2px;border-radius:3px;background:#d0f4ff;box-shadow:0 0 8px 2px #63c7ffb0;opacity:0;transform:rotate(-51deg)}
.home-road-flow i:nth-child(1){left:12%;top:14%}.home-road-flow i:nth-child(2){left:44%;top:37%}.home-road-flow i:nth-child(3){left:74%;top:13%}
.home-master-route-logistics:is(:hover,:focus-visible) .home-road-flow i{animation:home-road-streak 1.9s ease-in-out 2}
.home-master-route-logistics:is(:hover,:focus-visible) .home-road-flow i:nth-child(2){animation-delay:.28s}.home-master-route-logistics:is(:hover,:focus-visible) .home-road-flow i:nth-child(3){animation-delay:.56s}
.home-live-explainer{position:absolute;z-index:1;inset:9% 5% 37%;pointer-events:none;opacity:0;transform:translateY(7px);transition:opacity .28s ease .08s,transform .38s cubic-bezier(.16,1,.3,1) .08s}
.home-live-kicker{position:absolute;left:1%;top:0;padding:5px 8px;border:1px solid var(--flow-border);border-radius:999px;background:var(--flow-kicker);box-shadow:0 7px 18px #0715272e;backdrop-filter:blur(7px);color:#fff;font:700 .5rem/1 var(--font-body);letter-spacing:.12em;text-transform:uppercase}
.home-live-path{position:absolute;inset:9% 0 0;width:100%;height:82%;overflow:visible}
.home-live-path path{fill:none;stroke:var(--flow-line);stroke-width:.75;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:180;stroke-dashoffset:180;filter:drop-shadow(0 0 4px var(--flow-glow));opacity:.88}
.home-live-step{position:absolute;display:flex;align-items:center;gap:5px;min-width:0;padding:6px 8px;border:1px solid var(--flow-border);border-radius:999px;background:var(--flow-panel);box-shadow:0 8px 20px #0715273b;backdrop-filter:blur(7px);opacity:0;transform:translateY(6px) scale(.96);transition:opacity .3s ease,transform .42s cubic-bezier(.16,1,.3,1)}
.home-live-step::before{content:"";flex:none;width:5px;height:5px;border-radius:50%;background:var(--flow-dot);box-shadow:0 0 0 3px color-mix(in srgb,var(--flow-dot) 22%,transparent),0 0 9px var(--flow-glow)}
.home-live-step b{color:#fff;font:700 .48rem/1 var(--font-mono);letter-spacing:.04em}
.home-live-step em{overflow:hidden;color:#fff;font:700 clamp(.48rem,.62vw,.64rem)/1.1 var(--font-body);font-style:normal;white-space:nowrap;text-overflow:ellipsis}
.home-live-step[data-live-step="event"]{left:2%;top:21%}
.home-live-step[data-live-step="system"]{left:29%;top:48%}
.home-live-step[data-live-step="human"]{left:55%;top:24%}
.home-live-step[data-live-step="outcome"]{right:1%;top:37%}
.home-master-route-marketing .home-live-step[data-live-step="event"]{left:2%;top:39%}
.home-master-route-marketing .home-live-step[data-live-step="system"]{left:21%;top:14%}
.home-master-route-marketing .home-live-step[data-live-step="human"]{left:49%;top:45%}
.home-master-route-marketing .home-live-step[data-live-step="outcome"]{right:1%;top:22%}
.home-master-route-technology .home-live-step[data-live-step="event"]{left:2%;top:18%}
.home-master-route-technology .home-live-step[data-live-step="system"]{left:28%;top:49%}
.home-master-route-technology .home-live-step[data-live-step="human"]{left:54%;top:26%}
.home-master-route-technology .home-live-step[data-live-step="outcome"]{right:1%;top:48%}
.home-master-route-academy .home-live-step[data-live-step="event"]{left:2%;top:60%}
.home-master-route-academy .home-live-step[data-live-step="system"]{left:27%;top:49%}
.home-master-route-academy .home-live-step[data-live-step="human"]{left:52%;top:36%}
.home-master-route-academy .home-live-step[data-live-step="outcome"]{right:1%;top:22%}
.home-master-route:is(:hover,:focus-visible) .home-live-explainer{opacity:1;transform:translateY(0)}
.home-master-route:is(:hover,:focus-visible) .home-live-path path{animation:home-live-route 1.55s cubic-bezier(.16,1,.3,1) .2s forwards}
.home-master-route:is(:hover,:focus-visible) .home-live-step{opacity:1;transform:translateY(0) scale(1)}
.home-master-route:is(:hover,:focus-visible) .home-live-step[data-live-step="event"]{transition-delay:.26s}
.home-master-route:is(:hover,:focus-visible) .home-live-step[data-live-step="system"]{transition-delay:.6s}
.home-master-route:is(:hover,:focus-visible) .home-live-step[data-live-step="human"]{transition-delay:.94s}
.home-master-route:is(:hover,:focus-visible) .home-live-step[data-live-step="outcome"]{transition-delay:1.28s}
/* Marketing: one connected demand journey, not botanical decoration or generic social-logo confetti. */
.home-master-route-marketing{background:radial-gradient(ellipse at 57% 36%,#d9f7e8 0%,#b9dccd 37%,#234638 94%);color:#fff}
.home-master-route-marketing .home-live-explainer{display:none}/* Replaced by the four readable stages of the living Marketing scene; avoid duplicate competing overlays. */
/* Marketing retires the old botanical AI background; causal demand stages remain the current proof until a rights-safe human clip is owner-approved. */
.home-master-route-marketing .home-portal-art{background:linear-gradient(180deg,#dff5ea,#89b9a4 58%,#24483a)}
.home-master-route-marketing .home-portal-art::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(239,252,246,.12) 0%,rgba(29,82,61,.06) 44%,rgba(18,48,37,.68) 91%)}
.home-marketing-journey{position:absolute;z-index:0;inset:6% 5% 31%;display:block;pointer-events:none;overflow:visible;transform:translateZ(0)}
.home-marketing-caption{position:absolute;top:0;left:5%;display:flex;align-items:center;gap:8px;color:#184734;font:800 .58rem/1.2 var(--font-mono);letter-spacing:.13em}
.home-marketing-caption i{height:1px;width:25px;background:#489876;opacity:.65}
.home-marketing-conductor{position:absolute;inset:4% 0 0;width:100%;height:95%;overflow:visible}
.home-marketing-track,.home-marketing-pulse{fill:none;stroke:#168663;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.65}
.home-marketing-track{opacity:.2}
.home-marketing-pulse{opacity:.8;stroke:#2bbf83;stroke-width:2;stroke-dasharray:2 14;stroke-dashoffset:0;filter:drop-shadow(0 0 4px #74d4a2)}
.home-marketing-card{position:absolute;display:block;box-sizing:border-box;border:1px solid #ffffffd9;border-radius:13px;background:linear-gradient(150deg,#ffffffed,#ecfaf4ea);box-shadow:0 12px 26px #0a412d2b,0 2px 6px #0a412d18;backdrop-filter:blur(8px);padding:10px;overflow:hidden;color:#204536;transform:translate3d(0,0,0)}
.home-marketing-card small{display:flex;align-items:center;gap:5px;font:800 clamp(.625rem,.68vw,.74rem)/1.2 var(--font-mono);letter-spacing:.045em;white-space:nowrap}
.home-marketing-discovery small,.home-marketing-inquiry small{font-size:clamp(.52rem,.56vw,.64rem);letter-spacing:.012em}
.home-marketing-card small i{display:block;height:5px;width:5px;flex:none;border-radius:50%;background:#16a572}
.home-marketing-content{top:12%;left:4%;width:55%;height:22%}
.home-marketing-discovery{top:31%;right:3%;width:57%;height:20%}
.home-marketing-site{top:51%;left:6%;width:61%;height:22%}
.home-marketing-inquiry{top:72%;right:4%;width:55%;height:19%}
.home-marketing-media{position:relative;display:block;height:53%;margin:7px 0 5px;border-radius:6px;background:linear-gradient(140deg,#2d725e,#8dcdb2 56%,#e2eedc);overflow:hidden}
.home-marketing-media::after{content:"";position:absolute;inset:auto -12% -42% 28%;height:90%;background:linear-gradient(30deg,#c6e5d5,#529a7f);border-radius:50% 50% 0 0;transform:rotate(-12deg)}
.home-marketing-play{position:absolute;z-index:1;top:50%;left:50%;translate:-50% -50%;width:23px;height:23px;border:1px solid #fff9;border-radius:50%;background:#ffffffab}
.home-marketing-play::after{content:"";position:absolute;top:7px;left:9px;border-top:4px solid transparent;border-bottom:4px solid transparent;border-left:6px solid #276b50}
.home-marketing-card-lines{display:flex;flex-direction:column;gap:4px}
.home-marketing-card-lines i{height:3px;width:77%;background:#b3cfbf;border-radius:4px}.home-marketing-card-lines i+ i{width:53%;background:#cdded4}
.home-marketing-channels{display:flex;flex-wrap:wrap;gap:3px;margin-top:7px}.home-marketing-channels i{padding:3px 4px;border:1px solid #bad6c7;border-radius:999px;background:#fff;color:#2a6a50;font:750 .42rem/1 var(--font-body);font-style:normal}.home-marketing-search{display:flex;align-items:center;gap:8px;margin-top:6px;padding:5px;background:#fff;border:1px solid #d4e5da;border-radius:6px}
.home-marketing-search i{width:10px;height:10px;border:2px solid #438869;border-radius:50%;position:relative}
.home-marketing-search i::after{content:"";position:absolute;width:5px;height:2px;background:#438869;right:-4px;bottom:-2px;rotate:45deg}
.home-marketing-search b{width:60%;height:4px;border-radius:4px;background:#b6d4c1}
.home-marketing-result{display:grid;grid-template-columns:22px 1fr;gap:4px;margin-top:7px}
.home-marketing-result i{grid-row:span 2;height:25px;border-radius:4px;background:linear-gradient(140deg,#6dac8b,#d2e5ce)}
.home-marketing-result b{height:4px;margin-top:2px;border-radius:4px;background:#8dac9c}.home-marketing-result b:last-child{width:70%;background:#c5d7cc}
.home-marketing-browser{display:block;margin-top:8px;border:1px solid #d6e7de;border-radius:6px;overflow:hidden;background:#fff;height:60%}
.home-marketing-browser b{display:block;height:7px;background:linear-gradient(90deg,#c1dacd 0 6%,transparent 6% 9%,#c1dacd 9% 15%,transparent 15% 18%,#c1dacd 18% 24%,transparent 24%) #f0f7f2}
.home-marketing-browser i{display:block;margin:5px;height:45%;border-radius:4px;background:linear-gradient(130deg,#cadecd,#63a38b)}
.home-marketing-browser em{display:block;width:43%;height:5px;margin-left:5px;border-radius:4px;background:#39a575}
.home-marketing-person{display:block;position:relative;margin-top:9px;height:35px;border-radius:6px;background:#fff;border:1px solid #d3e7dc}
.home-marketing-person i{position:absolute;left:8px;top:7px;width:20px;height:20px;border-radius:50%;background:linear-gradient(130deg,#83bb9d,#2d7c60)}
.home-marketing-person b,.home-marketing-person em{position:absolute;left:36px;top:10px;height:4px;width:43%;border-radius:3px;background:#91b5a0}.home-marketing-person em{top:19px;width:28%;background:#c9d9ce}
.home-marketing-beacon{display:block;position:absolute;right:10px;bottom:17px;width:15px;height:15px;border-radius:50%;border:1px solid #2da777;background:#edfff5}
.home-marketing-beacon i{position:absolute;left:4px;top:4px;display:block;width:5px;height:5px;border-radius:50%;background:#2da777}
[data-journey-motion="running"] .home-marketing-pulse{animation:home-marketing-current 8s linear infinite}
[data-journey-motion="running"] .home-marketing-card{animation:home-marketing-hover 8s ease-in-out infinite}
[data-journey-motion="running"] .home-marketing-discovery{animation-delay:-2s}
[data-journey-motion="running"] .home-marketing-site{animation-delay:-4s}
[data-journey-motion="running"] .home-marketing-inquiry{animation-delay:-6s}
.home-master-route-marketing:is(:hover,:focus-visible) .home-marketing-journey{opacity:1;transition:opacity .25s ease}
@keyframes home-marketing-current{to{stroke-dashoffset:-192}}
@keyframes home-marketing-hover{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-4px,0)}}
@media(max-width:700px){.home-marketing-journey{inset:6% 8% 38%;opacity:1}.home-marketing-card{padding:7px;border-radius:10px}.home-marketing-card small{font-size:.625rem}.home-marketing-discovery small,.home-marketing-inquiry small{font-size:.53rem;letter-spacing:.008em}.home-marketing-caption{font-size:.625rem}.home-marketing-media{margin:5px 0 3px}.home-marketing-search{margin-top:5px;padding:4px}.home-marketing-result{margin-top:3px}.home-marketing-browser{margin-top:4px}.home-marketing-person{margin-top:5px}.home-master-route-marketing .home-live-explainer{z-index:2}}
@media(prefers-reduced-motion:reduce){.home-marketing-journey,.home-marketing-card,.home-marketing-pulse,.home-marketing-beacon{animation:none!important;transform:none!important;transition:none!important}.home-logistics-truck-layer{animation:none!important;transform:none!important}}
.home-master-route-technology .home-live-explainer,.home-master-route-academy .home-live-explainer{display:none}
.home-system-display{inset:8% 7% 39%;z-index:0}
.home-system-caption,.home-academy-caption{position:absolute;left:0;top:0;display:flex;align-items:center;gap:5px;font:800 .48rem/1 var(--font-body);letter-spacing:.14em;color:#fff7e6;opacity:.82}
.home-system-caption i,.home-academy-caption i{display:inline-block;width:22px;height:1px;background:#ffc274;box-shadow:0 0 8px #ff9f4b}
.home-system-card{position:absolute;width:43%;min-height:56px;padding:7px 8px;border:1px solid #ffe8c777;border-radius:10px;background:linear-gradient(145deg,#3a281ed8,#251a14e8);box-shadow:0 8px 20px #1a0f0a55,inset 0 1px #fff2d633}
.home-system-card small{display:block;color:#ffd8a5;font:800 .44rem/1.1 var(--font-body);letter-spacing:.08em}
.home-system-card strong{display:block;margin-top:6px;color:#fff7e8;font:850 .56rem/1 var(--font-body);letter-spacing:.08em}
.home-system-card em{display:block;margin-top:4px;color:#e7c9a3;font:700 .43rem/1.2 var(--font-body);font-style:normal;letter-spacing:.025em}
.home-tech-mini{display:flex;align-items:center;gap:3px;min-width:0;margin-top:6px;overflow:hidden}
.home-tech-mini i,.home-tech-mini b{display:block;min-width:0;padding:3px 4px;border:1px solid #ffe8c744;border-radius:4px;background:#fff6e80f;color:#fff2d9;font:750 .36rem/1 var(--font-body);font-style:normal;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}
.home-tech-connect-ui{display:grid;grid-template-columns:1fr 1fr}.home-tech-connect-ui i:last-child{grid-column:1/-1}
.home-tech-factory-ui{display:grid;grid-template-columns:1fr 1fr}
