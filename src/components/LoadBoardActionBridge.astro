<script>
  const LOAD_BOARD_PATH = "/load-board/";
  const SOURCE_SETUP_PATH = "/services/hermes-connect/load-board/source/";

  if (window.location.pathname === LOAD_BOARD_PATH) {
    const root = document.querySelector<HTMLElement>("[data-hlb-live-marketplace]");
    let enhancing = false;
    let sourceEligibilityChecked = false;

    const requestDetails = async (button: HTMLButtonElement, loadId: string) => {
      if (button.disabled) return;
      const original = button.textContent || "Request details";
      button.disabled = true;
      button.textContent = "Sending…";
      try {
        const response = await fetch("/api/load-board/interest", {
          method: "POST",
          credentials: "same-origin",
          headers: { Accept: "application/json", "Content-Type": "application/json" },
          body: JSON.stringify({ load_id: loadId }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || `request_${response.status}`);

        button.textContent = "Requested for review";
        button.dataset.requestStatus = String(payload.request?.status || "requested");
        window.dispatchEvent(new CustomEvent("hermes:load-board-qualified-action", {
          detail: {
            action_type: "request_details",
            load_id: loadId,
            request_status: payload.request?.status || "requested",
          },
        }));
      } catch (error) {
        button.disabled = false;
        button.textContent = "Try request again";
        button.title = error instanceof Error ? error.message : "request_failed";
        window.setTimeout(() => {
          if (!button.disabled && button.textContent === "Try request again") button.textContent = original;
        }, 4000);
      }
    };

    const exposeSourceSetup = async () => {
      if (!root?.classList.contains("is-unlocked") || sourceEligibilityChecked) return;
      sourceEligibilityChecked = true;
      try {
        const response = await fetch("/api/load-board/source-requests", {
          credentials: "same-origin",
          headers: { Accept: "application/json" },
          cache: "no-store",
        });
        if (!response.ok) return;
        const payload = await response.json();
        if (!payload.eligible_to_propose_source) return;
        const actions = root.querySelector<HTMLElement>(".hlb-live-actions");
        if (!actions || actions.querySelector('[data-load-source-setup-link]')) return;
        const link = document.createElement("a");
        link.href = SOURCE_SETUP_PATH;
        link.dataset.loadSourceSetupLink = "";
        link.textContent = "Manage load source";
        actions.appendChild(link);
      } catch {}
    };

    const enhanceOpenRows = async () => {
      if (!root?.classList.contains("is-unlocked") || enhancing) return;
      void exposeSourceSetup();
      const rows = [...root.querySelectorAll<HTMLElement>(".hlb-live-row--open")];
      if (!rows.length || rows.every((row) => row.querySelector("[data-load-board-qualified-action]"))) return;

      enhancing = true;
      try {
        rows.forEach((row) => {
          const loadId = row.dataset.loadId;
          if (!loadId || row.querySelector("[data-load-board-qualified-action]")) return;
          const rate = row.querySelector<HTMLElement>(".hlb-live-rate");
          if (!rate) return;

          const button = document.createElement("button");
          button.type = "button";
          button.className = "hlb-request-details";
          button.dataset.loadBoardQualifiedAction = "request_details";
          button.textContent = "Request details";
          button.addEventListener("click", () => void requestDetails(button, loadId));
          rate.appendChild(button);
        });
      } finally {
        enhancing = false;
      }
    };

    void enhanceOpenRows();
    if (root && "MutationObserver" in window) {
      const observer = new MutationObserver(() => void enhanceOpenRows());
      observer.observe(root, { attributes: true, attributeFilter: ["class"], childList: true, subtree: true });
    }
  }
</script>

<style is:global>
  .hlb-request-details{margin-top:.45rem;padding:.46rem .62rem;border:1px solid rgba(11,13,18,.12);border-radius:9px;background:#0b0d12;color:#fff;font:inherit;font-size:.62rem;font-weight:850;cursor:pointer}.hlb-request-details:hover{background:#20232c}.hlb-request-details:disabled{cursor:default;opacity:.62}
</style>
