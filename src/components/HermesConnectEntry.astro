---
const currentPath = Astro.url.pathname;
const label = currentPath.startsWith('/logistics/') || currentPath === '/load-board/'
  ? 'Open logistics workspace'
  : currentPath.startsWith('/paths/marketing/') || currentPath.startsWith('/services/seo')
    ? 'Open growth workspace'
    : currentPath.startsWith('/academy/') || currentPath.startsWith('/paths/academy/')
      ? 'Open Academy workspace'
      : 'Open Hermes Connect';
---

<a class="hermes-connect-entry" href="https://connect.hermeslogisticsus.com/" data-hermes-connect-entry>
  <svg viewBox="0 0 44 44" aria-hidden="true">
    <path d="M8 12c0-3 2.4-5.4 5.4-5.4h7.2c2.6 0 4.7 2.1 4.7 4.7v3.4c0 2.6-2.1 4.7-4.7 4.7h-7.2A5.4 5.4 0 0 0 8 24.8V28" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
    <path d="M36 32c0 3-2.4 5.4-5.4 5.4h-7.2a4.7 4.7 0 0 1-4.7-4.7v-3.4c0-2.6 2.1-4.7 4.7-4.7h7.2a5.4 5.4 0 0 0 5.4-5.4V16" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
  </svg>
  <span><strong>Hermes Connect</strong><small>{label}</small></span>
</a>
