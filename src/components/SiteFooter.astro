---
import { ArrowUp, Mail } from "@lucide/astro";
import { site } from "../data/site";
import { localeConfig, type SiteLocale } from "../data/locales";
import { directionOwnerRoutes } from "../data/localized-direction-owners";
import HermesConnectLauncher from "./HermesConnectLauncher.astro";
import RussianLocaleIntegrity from "./RussianLocaleIntegrity.astro";

interface Props {
  locale?: SiteLocale;
}

const { locale: requestedPropLocale = "en" } = Astro.props;
const currentPath = Astro.url.pathname;
const connectRequestedLocale = currentPath.startsWith("/services/hermes-connect") ? Astro.url.searchParams.get("lang") : null;
const locale: SiteLocale = connectRequestedLocale === "ru" ? "ru" : requestedPropLocale;
const publicLocationBoundary = locale === "ru"
  ? "Логистика в США · международная координация по электронной почте"
  : "U.S. logistics · International email coordination";
const showTransportRequestActions = currentPath === "/logistics/request-vehicle-transport/";
const directionOrder = { logistics: 0, technology: 1, academy: 2, marketing: 3 } as const;
const directionRank = (href: string) => {
  const pathMatch = href.match(/\/paths\/(logistics|marketing|technology|academy)\/?$/);
  const hashMatch = href.match(/#(logistics|marketing|technology|academy)$/);
  const id = (pathMatch?.[1] || hashMatch?.[1]) as keyof typeof directionOrder | undefined;
  return id ? directionOrder[id] : 99;
};
const orderedSiteNavigation = [...site.navigation].sort(
  (a, b) => directionRank(`/${a.href}`) - directionRank(`/${b.href}`),
);
const localized = {
  en: {
    statement: "Logistics, growth, education, and technology working with one practical standard.",
    nav: [
      ...orderedSiteNavigation.map((item) => ({ label: item.label, href: `/${item.href}` })),
      { label: "Insights", href: "/insights/" },
      { label: "Case Studies", href: "/case/" },
      { label: "Website Development", href: "/services/website-development/" },
      { label: "SEO Services", href: "/services/seo/" },
      { label: "Business Directory", href: "/businesses/" },
      { label: "Wisconsin Vehicle Transport", href: "/logistics/wisconsin-vehicle-transport/" },
      { label: "Dealer Vehicle Transport", href: "/logistics/dealer-vehicle-transportation/" },
      { label: "Car Hauling Dispatch", href: "/logistics/car-hauling-dispatch/" },
    ],
    privacy: "Privacy",
    contact: "Contact",
    route: "Choose the right contact route",
    designed: "Designed and engineered by",
    method: "Human-led, AI-assisted",
    status: "Website inquiries are delivered securely by email",
  },
  uk: {
    statement: "Логістика, розвиток, освіта й технології за одним практичним стандартом.",
    nav: [
      { label: "Логістика", href: "/ua/logistics/" }, { label: "Маркетинг", href: "/ua/marketing/" },
      { label: "IT-розробка", href: "/ua/technology/" }, { label: "Академія", href: "/ua/academy/" },
    ],
    privacy: "Конфіденційність",
    contact: "Контакт",
    route: "Обрати напрям звернення",
    designed: "Дизайн і розробка",
    method: "Під керівництвом людей, з підтримкою AI",
    status: "Звернення надсилаються електронною поштою",
  },
  ru: {
    statement: "Логистика, развитие, образование и технологии по единому практическому стандарту.",
    nav: [
      { label: "Логистика", href: "/ru/logistics/" }, { label: "Маркетинг", href: "/ru/marketing/" },
      { label: "IT-разработка", href: "/ru/technology/" }, { label: "Академия", href: "/ru/academy/" },
    ],
    privacy: "Конфиденциальность",
    contact: "Контакт",
    route: "Выбрать направление обращения",
    designed: "Дизайн и разработка",
    method: "Под управлением людей, с поддержкой AI",
    status: "Обращения отправляются по электронной почте",
  },
  es: {
    statement: "Logística, crecimiento, formación y tecnología con un mismo estándar práctico.",
    nav: [
      { label: "Logística", href: "/es/logistica/" }, { label: "Marketing", href: "/es/marketing/" },
      { label: "Desarrollo IT", href: "/es/tecnologia/" }, { label: "Academia", href: "/es/academia/" },
    ],
    privacy: "Privacidad", contact: "Contacto", route: "Elegir el canal de contacto",
    designed: "Diseñado y desarrollado por", method: "Dirigido por personas, asistido por AI", status: "Las consultas se envían por email",
  },
  it: {
    statement: "Logistica, crescita, formazione e tecnologia con un unico standard pratico.",
    nav: [
      { label: "Logistica", href: "/it/logistica/" }, { label: "Marketing", href: "/it/marketing/" },
      { label: "Sviluppo IT", href: "/it/tecnologia/" }, { label: "Academy", href: "/it/academy/" },
    ],
    privacy: "Privacy", contact: "Contatti", route: "Scegli il canale di contatto",
    designed: "Design e sviluppo di", method: "Guidato da persone, assistito da AI", status: "Le richieste vengono inviate via email",
  },
  fr: {
    statement: "Logistique, croissance, formation et technologie selon un même standard pratique.",
    nav: [
      { label: "Logistique", href: "/fr/logistique/" }, { label: "Marketing", href: "/fr/marketing/" },
      { label: "Développement IT", href: "/fr/technologie/" }, { label: "Académie", href: "/fr/academie/" },
    ],
    privacy: "Confidentialité", contact: "Contact", route: "Choisir le canal de contact",
    designed: "Conçu et développé par", method: "Dirigé par l'humain, assisté par AI", status: "Les demandes sont envoyées par email",
  },
}[locale];
const localizedNav = [...localized.nav].sort((a, b) => directionRank(a.href) - directionRank(b.href));
const localePath = localeConfig[locale].path;
const privacyHref = locale === "ru" ? "/ru/privacy/" : "/privacy/";
const homeFooterGroups = [
  {
    title: "Directions",
    links: [
      ...orderedSiteNavigation.map((item) => ({ label: item.label === "IT" ? "Technology" : item.label, href: `/${item.href}` })),
      { label: "Insights", href: "/insights/" },
      { label: "Case Studies", href: "/case/" },
      { label: "Opportunities", href: "/opportunities/" },
    ],
  },
  {
    title: "Products & services",
    links: [
      { label: "Hermes Connect", href: "/services/hermes-connect/" },
      { label: "Business Directory", href: "/businesses/" },
      { label: "Website Development", href: "/services/website-development/" },
      { label: "SEO Services", href: "/services/seo/" },
      { label: "Wisconsin Vehicle Transport", href: "/logistics/wisconsin-vehicle-transport/" },
      { label: "Dealer Vehicle Transport", href: "/logistics/dealer-vehicle-transportation/" },
      { label: "Car Hauling Dispatch", href: "/logistics/car-hauling-dispatch/" },
      { label: "Hermes Connect Access", href: "/download/" },
    ],
  },
  {
    title: "Company & legal",
    links: [
      { label: "About Hermes", href: "/about/" },
      { label: "Company Information", href: "/company-information/" },
      { label: "Contact", href: "/contacts/" },
      { label: "Privacy", href: "/privacy/" },
      { label: "Privacy Choices", href: "/privacy-choices/" },
      { label: "Regional Privacy", href: "/regional-privacy/" },
      { label: "Legal & Compliance", href: "/legal-compliance/" },
      { label: "Terms of Use", href: "/terms/" },
      { label: "Editorial & Corrections", href: "/editorial-policy/" },
      { label: "Accessibility", href: "/accessibility/" },
    ],
  },
] as const;
---

{showTransportRequestActions && (
  <>
    <nav class="transport-request-mobile-actions" aria-label="Vehicle transportation request actions">
      <a href="#transport-intake" data-transport-mobile-request>Prepare request</a>
      <a href="mailto:officeus@hermeslogisticsus.com" data-transport-mobile-email><Mail size={17} aria-hidden="true" />Email</a>
    </nav>
    <style is:global>
      .transport-request-actions a[href*="/load-board/"] { display: none; }
      @media (max-width: 700px) {
        .transport-request-page { padding-bottom: 4.6rem; }
        .transport-request-mobile-actions {
          position: fixed;
          z-index: 80;
          right: .65rem;
          bottom: .65rem;
          left: .65rem;
          display: grid;
          grid-template-columns: 1fr auto;
          gap: .5rem;
          padding: .55rem;
          border: 1px solid rgba(255,255,255,.18);
          border-radius: 12px;
          background: rgba(7,16,56,.96);
          box-shadow: 0 18px 50px rgba(7,16,56,.3);
          backdrop-filter: blur(14px);
        }
        .transport-request-mobile-actions a {
          display: inline-flex;
          min-height: 46px;
          align-items: center;
          justify-content: center;
          gap: .35rem;
          padding: .75rem 1rem;
          border-radius: 8px;
          color: #fff;
          font-weight: 800;
          text-decoration: none;
        }
        .transport-request-mobile-actions a:first-child { background: #6a20d9; }
        .transport-request-mobile-actions a:last-child { border: 1px solid rgba(255,255,255,.34); }
      }
      @media (min-width: 701px) {
        .transport-request-mobile-actions { display: none; }
      }
    </style>
  </>
)}

<footer class="site-footer">
  <div class="shell footer-main">
    <div class="footer-intro">
      <p class={`footer-brand${currentPath === "/" ? " footer-brand-approved" : ""}`}>{currentPath === "/" && <img src="/brand/hermes-mark.svg" alt="Hermes corporate H mark" width="36" height="36" decoding="async" />}<span>{site.brand}</span></p>
      <p>{localized.statement}</p>
      <p class="footer-location">{publicLocationBoundary}</p>
      <HermesConnectLauncher variant="footer" />
    </div>
    {currentPath === "/" ? (
      <nav class="footer-primary-nav footer-primary-nav--grouped" aria-label="Footer navigation">
        {homeFooterGroups.map((group) => (
          <section class="footer-link-group" aria-labelledby={`footer-${group.title.toLowerCase().replace(/[^a-z]+/g, "-")}`}>
            <h2 id={`footer-${group.title.toLowerCase().replace(/[^a-z]+/g, "-")}`}>{group.title}</h2>
            <div>{group.links.map((item) => <a href={item.href}>{item.label}</a>)}</div>
          </section>
        ))}
      </nav>
    ) : (
      <nav class="footer-primary-nav" aria-label="Footer navigation">
        {localizedNav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={privacyHref}>{localized.privacy}</a>
        {locale === "en" && (
          <>
            <a href="/legal-compliance/">Legal & Compliance</a>
            <a href="/regional-privacy/">Regional Privacy</a>
            <a href="/privacy-choices/">Privacy Choices</a>
            <a href="/company-information/">Company Information</a>
            <a href="/about/">About Hermes</a>
            <a href="/download/">Hermes Connect Access</a>
            <a href="/terms/">Terms of Use</a>
            <a href="/editorial-policy/">Editorial & Corrections</a>
            <a href="/accessibility/">Accessibility</a>
          </>
        )}
      </nav>
    )}
    <div class="footer-contacts" aria-label="Contact options">
      <p class="footer-contacts-label">{localized.contact}</p>
      <a href={locale === "en" ? "/contacts/" : `${localePath}#contact`}>{localized.route}</a>
      <a href="mailto:officeus@hermeslogisticsus.com">officeus@hermeslogisticsus.com</a>
    </div>
    <nav class="footer-social" aria-label="Social media">
      {site.social.map((item) => (
        <a href={item.href} target="_blank" rel="noopener noreferrer" data-social={item.label.toLowerCase()}>
          <span class="footer-social-icon" aria-hidden="true">
            {item.label === "Instagram" && <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>}
            {item.label === "Threads" && <svg viewBox="0 0 24 24"><path d="M16.6 11.2c-.3-2.6-2-4-4.5-4-2.7 0-4.6 2-4.6 4.8 0 3 2 4.9 4.8 4.9 2.3 0 3.9-1.3 3.9-3.1 0-1.6-1.3-2.6-3.3-2.6-1.6 0-2.6.8-2.6 1.9 0 1 .9 1.6 2 1.6 1.9 0 2.9-1.7 2.9-4.2"/><path d="M12 21c-5 0-8.5-3.4-8.5-9S7 3 12 3s7.6 2.6 8.3 6.4"/></svg>}
            {item.label === "Telegram" && <svg viewBox="0 0 24 24"><path d="M21 4 3 11.2l6.2 2.3L18 7.3l-6.6 7.6 6.3 4.6z"/></svg>}
            {item.label === "Facebook" && <svg viewBox="0 0 24 24"><path d="M14.5 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8.8v3h2.6V21"/></svg>}
          </span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
    <a class="back-to-top" href="#top" aria-label="Back to top">
      <ArrowUp size={20} aria-hidden="true" />
    </a>
  </div>
  <div class="shell footer-meta">
    <span>
      {localized.designed} <a href={directionOwnerRoutes[locale].technology}>Hermes Technology</a> · {localized.method}
    </span>
    <span>© 2026 Hermes · {publicLocationBoundary} · {localized.status}</span>
  </div>
</footer>
<RussianLocaleIntegrity />

<style>
  .footer-primary-nav--grouped {
    grid-column: 2 / 5;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.4rem, 2.8vw, 3rem);
  }
  .footer-link-group { min-width: 0; }
  .footer-link-group h2 {
    margin: 0 0 .8rem;
    color: rgba(255,255,255,.58);
    font: 700 .68rem/1.2 var(--font-mono);
    letter-spacing: .11em;
    text-transform: uppercase;
  }
  .footer-link-group div { display: grid; gap: .58rem; }
  .footer-link-group a { color: rgba(255,255,255,.78); font-size: .87rem; line-height: 1.35; }
  .footer-link-group a:hover,.footer-link-group a:focus-visible { color:#fff; }
  @media (max-width: 1050px) {
    .footer-primary-nav--grouped { grid-column: 1 / -1; grid-template-columns: repeat(3, minmax(0,1fr)); }
  }
  @media (max-width: 700px) {
    .site-footer { padding-top: 2.6rem; }
    .footer-main { grid-template-columns: 1fr; gap: .9rem; }
    .footer-intro { max-width: 36rem; }

    .footer-primary-nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 .85rem;
      padding-top: .45rem;
      border-top: 1px solid rgba(255,255,255,.16);
    }

    .footer-primary-nav--grouped { grid-template-columns:1fr; gap:1.3rem; }
    .footer-link-group div { grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 .85rem; }
    .footer-primary-nav a {
      display: flex;
      min-height: 44px;
      align-items: center;
      padding: .35rem 0;
      color: rgba(255,255,255,.76);
      font-size: .82rem;
      line-height: 1.22;
    }

    .footer-contacts {
      gap: .08rem;
      margin-top: .15rem;
      padding-top: .55rem;
      border-top: 1px solid rgba(255,255,255,.16);
    }

    .footer-contacts a,
    .footer-social a {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
    }

    .footer-social {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1rem;
      padding-top: .15rem;
    }


    .footer-primary-nav a:focus-visible,
    .footer-contacts a:focus-visible,
    .footer-social a:focus-visible {
      color: #fff;
      outline: 2px solid currentColor;
      outline-offset: 3px;
    }
  }
  /* Approved Claude Design footer: brand icons in circles next to each social label. */
  .footer-social a { display: inline-flex; align-items: center; gap: .55rem; }
  .footer-social-icon { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid color-mix(in srgb, currentColor 28%, transparent); border-radius: 50%; transition: background-color .2s ease, transform .2s ease; }
  .footer-social-icon svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .footer-social a:is(:hover, :focus-visible) .footer-social-icon { background: color-mix(in srgb, currentColor 12%, transparent); transform: translateY(-2px); }
</style>
