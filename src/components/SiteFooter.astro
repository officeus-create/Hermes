---
import { ArrowUp } from "@lucide/astro";
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="shell footer-main">
    <div>
      <p class="footer-brand">{site.brand}</p>
      <p>Logistics, growth, education, and technology working with one practical standard.</p>
    </div>
    <nav aria-label="Footer navigation">
      {site.navigation.map((item) => <a href={`/${item.href}`}>{item.label}</a>)}
      <a href="/privacy/">Privacy</a>
    </nav>
    <nav class="footer-social" aria-label="Social media">
      {site.social.map((item) => <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>)}
    </nav>
    <a class="back-to-top" href="#top" aria-label="Back to top"><ArrowUp size={20} aria-hidden="true" /></a>
  </div>
  <div class="shell footer-meta">
    <span>Designed and engineered by <a href="/paths/technology/">Hermes IT Development</a> · Human-led, AI-assisted</span>
    <span>© 2026 Hermes · Contact submission pending connection</span>
  </div>
</footer>
