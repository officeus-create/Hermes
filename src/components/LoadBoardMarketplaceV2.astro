---
import { ArrowLeftRight, Bookmark, PackagePlus, Search, Truck, X } from "@lucide/astro";
const isLoadBoard = Astro.url.pathname === "/load-board/";
---

{isLoadBoard && (
  <div class="lbv2-control-host" data-lbv2-control-host>
    <section class="lbv2-toolbar" aria-label="Load Board workspace controls">
      <div class="lbv2-product-row">
        <div>
          <p>Hermes Logistics · software workspace</p>
          <strong>Load Board</strong>
          <span>Live records when available · preview examples are not inventory</span>
        </div>
        <div class="lbv2-product-actions">
          <button type="button" data-lbv2-post="load"><PackagePlus size={16} aria-hidden="true" /> Post load</button>
          <button type="button" data-lbv2-post="capacity"><Truck size={16} aria-hidden="true" /> Post truck</button>
        </div>
      </div>

      <div class="lbv2-tabs" role="tablist" aria-label="Marketplace views">
        <button type="button" role="tab" aria-selected="true" data-lbv2-tab="loads">Loads <span data-lbv2-tab-load-count>—</span></button>
        <button type="button" role="tab" aria-selected="false" data-lbv2-tab="trucks">Trucks <span data-lbv2-tab-truck-count>—</span></button>
        <button type="button" role="tab" aria-selected="false" data-lbv2-tab="mine">My posts <span data-lbv2-my-count>0</span></button>
      </div>

      <form class="lbv2-search" data-lbv2-search-form>
        <label><span>Origin</span><input name="origin" placeholder="City, state or ZIP" autocomplete="off" /></label>
        <button class="lbv2-swap" type="button" data-lbv2-swap aria-label="Swap origin and destination"><ArrowLeftRight size={17} aria-hidden="true" /></button>
        <label><span>Destination</span><input name="destination" placeholder="Anywhere" autocomplete="off" /></label>
        <label><span>Equipment</span><select name="equipment"><option value="">All equipment</option><option value="car hauler">Car Hauler</option><option value="dry van">Dry Van</option><option value="reefer">Reefer</option><option value="flatbed">Flatbed</option><option value="step deck">Step Deck</option><option value="hotshot">Hotshot</option><option value="power only">Power Only</option><option value="box truck">Box Truck</option><option value="sprinter van">Sprinter Van</option></select></label>
        <label data-lbv2-rate-filter><span>Min rate</span><input name="minRate" inputmode="decimal" placeholder="$0" /></label>
        <label data-lbv2-rpm-filter><span>Min RPM</span><input name="minRpm" inputmode="decimal" placeholder="$0.00" /></label>
        <label data-lbv2-deadhead-filter><span>Max DH</span><input name="maxDeadhead" inputmode="numeric" placeholder="Any mi" /></label>
        <label><span>Sort</span><select name="sort"><option value="best">Best match</option><option value="rate">Highest rate</option><option value="rpm">Highest RPM</option><option value="lane">Lane A–Z</option></select></label>
        <button class="lbv2-search-button" type="submit"><Search size={16} aria-hidden="true" /> Search</button>
      </form>

      <div class="lbv2-quick-row">
        <div class="lbv2-quick-filters" aria-label="Quick equipment filters">
          <button type="button" data-lbv2-equipment="car hauler">Car Hauler</button>
          <button type="button" data-lbv2-equipment="hotshot">Hotshot</button>
          <button type="button" data-lbv2-equipment="dry van">Dry Van</button>
          <button type="button" data-lbv2-equipment="reefer">Reefer</button>
          <button type="button" data-lbv2-clear>Clear</button>
        </div>
        <div class="lbv2-search-tools">
          <button type="button" data-lbv2-save><Bookmark size={15} aria-hidden="true" /> Save search</button>
          <a class="lbv2-alert-link" href="/services/hermes-connect/load-board/access/?source=load-board-alert">Alerts · preview</a>
          <span data-lbv2-result-copy>Showing market preview</span>
        </div>
      </div>
    </section>

    <section class="lbv2-my-posts" data-lbv2-my-posts hidden aria-live="polite">
      <div class="lbv2-my-posts-head"><div><p>Your marketplace</p><h3>My posted loads & trucks</h3></div><span data-lbv2-company-copy>Register a company to post.</span></div>
      <div class="lbv2-my-posts-list" data-lbv2-my-posts-list><p>Sign in with a registered Hermes company to manage marketplace posts.</p></div>
    </section>

    <div class="lbv2-toast" data-lbv2-toast role="status" hidden></div>

    <div class="lbv2-modal" data-lbv2-modal hidden>
      <button class="lbv2-modal-backdrop" type="button" data-lbv2-close aria-label="Close posting form"></button>
      <section class="lbv2-modal-card" role="dialog" aria-modal="true" aria-labelledby="lbv2-modal-title">
        <div class="lbv2-modal-head"><div><p data-lbv2-modal-kicker>Marketplace post</p><h3 id="lbv2-modal-title" data-lbv2-modal-title>Post a load</h3></div><button type="button" data-lbv2-close aria-label="Close"><X size={18} aria-hidden="true" /></button></div>
        <form class="lbv2-post-form" data-lbv2-post-form>
          <input type="hidden" name="type" value="load" />
          <div class="lbv2-form-grid">
            <label><span>Origin *</span><input name="origin" required placeholder="Chicago, IL" /></label>
            <label data-lbv2-destination-field><span>Destination *</span><input name="destination" required placeholder="Dallas, TX" /></label>
            <label><span>Equipment *</span><select name="equipment" required><option value="car_hauler">Car Hauler</option><option value="dry_van">Dry Van</option><option value="reefer">Reefer</option><option value="flatbed">Flatbed</option><option value="step_deck">Step Deck</option><option value="hotshot">Hotshot</option><option value="power_only">Power Only</option><option value="box_truck">Box Truck</option><option value="sprinter_van">Sprinter Van</option></select></label>
            <label><span data-lbv2-pickup-label>Pickup / ready *</span><input name="pickup_window" required placeholder="Today · 2 PM–6 PM" /></label>
            <label data-lbv2-load-only><span>Delivery window</span><input name="delivery_window" placeholder="Tomorrow · 8 AM–12 PM" /></label>
            <label data-lbv2-load-only><span>Load type</span><select name="load_type"><option value="full">Full</option><option value="partial">Partial</option><option value="both">Full or partial</option></select></label>
            <label data-lbv2-load-only><span>Rate offered</span><input name="rate_amount" type="number" min="0" step="1" placeholder="1800" /></label>
            <label><span>Distance, mi</span><input name="distance_miles" type="number" min="0" step="1" placeholder="750" /></label>
            <label><span data-lbv2-deadhead-label>Known deadhead, mi</span><input name="deadhead_miles" type="number" min="0" step="1" placeholder="35" /></label>
            <label><span data-lbv2-units-label>Units</span><input name="vehicle_count" type="number" min="1" max="100" value="1" /></label>
            <label data-lbv2-load-only><span>Weight, lb</span><input name="weight_lbs" type="number" min="0" step="100" placeholder="42000" /></label>
            <label data-lbv2-load-only><span>Length, ft</span><input name="length_feet" type="number" min="0" step="1" placeholder="53" /></label>
            <label data-lbv2-load-only><span>Payment terms</span><input name="payment_terms" placeholder="Net 30 / Quick Pay" /></label>
            <label><span>Expires</span><select name="expires_in_hours"><option value="12">12 hours</option><option value="24" selected>24 hours</option><option value="48">48 hours</option><option value="72">72 hours</option><option value="168">7 days</option></select></label>
          </div>
          <label class="lbv2-notes"><span>Notes</span><textarea name="notes" rows="3" maxlength="360" placeholder="Appointment, vehicle condition, loading requirements, preferred lane…"></textarea></label>
          <label class="lbv2-attest"><input name="rights_attested" type="checkbox" required /><span>I confirm my company is authorized to post this freight/capacity and that the information is current. Hermes keeps contact details hidden; this post does not create a booking.</span></label>
          <div class="lbv2-form-footer"><span data-lbv2-form-status></span><button type="submit">Publish to Hermes marketplace</button></div>
        </form>
      </section>
    </div>
  </div>
)}

{isLoadBoard && (
<script>
  const ACCESS_PATH = "/services/hermes-connect/load-board/access/";
  const root = document.querySelector<HTMLElement>("[data-hlb-live-marketplace]");
  const host = document.querySelector<HTMLElement>("[data-lbv2-control-host]");

  if (root && host) {
    const shell = root.querySelector<HTMLElement>(".hlb-live-shell");
    const head = root.querySelector<HTMLElement>(".hlb-live-head");
    if (shell && head) head.insertAdjacentElement("afterend", host);

    const headTitle = root.querySelector<HTMLElement>(".hlb-live-head h2");
    const headCopy = root.querySelector<HTMLElement>(".hlb-live-head h2 + p");
    if (headTitle) headTitle.textContent = "Find freight. Post loads. Post trucks.";
    if (headCopy) headCopy.textContent = "Fast filters, real marketplace counts, carrier capacity and company posting live in one Hermes workspace.";

    const searchForm = host.querySelector<HTMLFormElement>("[data-lbv2-search-form]");
    const tabs = [...host.querySelectorAll<HTMLButtonElement>("[data-lbv2-tab]")];
    const myPosts = host.querySelector<HTMLElement>("[data-lbv2-my-posts]");
    const myPostsList = host.querySelector<HTMLElement>("[data-lbv2-my-posts-list]");
    const myCount = host.querySelector<HTMLElement>("[data-lbv2-my-count]");
    const companyCopy = host.querySelector<HTMLElement>("[data-lbv2-company-copy]");
    const resultCopy = host.querySelector<HTMLElement>("[data-lbv2-result-copy]");
    const modal = host.querySelector<HTMLElement>("[data-lbv2-modal]");
    const postForm = host.querySelector<HTMLFormElement>("[data-lbv2-post-form]");
    const toast = host.querySelector<HTMLElement>("[data-lbv2-toast]");
    const loadGrid = root.querySelector<HTMLElement>(".hlb-live-grid");
    const capacityPanel = root.querySelector<HTMLElement>(".hlb-capacity-panel");
    const loadRows = root.querySelector<HTMLElement>("[data-live-load-rows]");
    const capacityRows = root.querySelector<HTMLElement>("[data-live-capacity-rows]");

    let companyState: any = null;
    let ownPosts: any[] = [];
    let activeTab = "loads";

    const showToast = (message: string, error = false) => {
      if (!toast) return;
      toast.textContent = message;
      toast.hidden = false;
      toast.dataset.error = error ? "true" : "false";
      window.setTimeout(() => { toast.hidden = true; }, 4000);
    };

    const filters = () => {
      if (!searchForm) return { origin: "", destination: "", equipment: "", minRate: 0, minRpm: 0, maxDeadhead: 0, sort: "best" };
      const data = new FormData(searchForm);
      return {
        origin: String(data.get("origin") || "").trim().toLowerCase(),
        destination: String(data.get("destination") || "").trim().toLowerCase(),
        equipment: String(data.get("equipment") || "").trim().toLowerCase(),
        minRate: Number(String(data.get("minRate") || "").replace(/[^0-9.]/g, "")) || 0,
        minRpm: Number(String(data.get("minRpm") || "").replace(/[^0-9.]/g, "")) || 0,
        maxDeadhead: Number(String(data.get("maxDeadhead") || "").replace(/[^0-9.]/g, "")) || 0,
        sort: String(data.get("sort") || "best"),
      };
    };

    const rowRate = (row: HTMLElement) => {
      const dataValue = Number(row.dataset.rate || 0);
      if (dataValue > 0) return dataValue;
      const text = row.querySelector(".hlb-live-rate strong")?.textContent || "";
      const match = text.replace(/,/g, "").match(/\$([0-9.]+)/);
      return match ? Number(match[1]) : 0;
    };
    const rowRpm = (row: HTMLElement) => {
      const dataValue = Number(row.dataset.rpm || 0);
      if (dataValue > 0) return dataValue;
      const text = row.querySelector(".hlb-live-rate small")?.textContent || "";
      const match = text.match(/([0-9.]+)\s*RPM/i);
      return match ? Number(match[1]) : 0;
    };
    const rowDeadhead = (row: HTMLElement) => Number(row.dataset.deadhead || 0);

    const applyFilters = () => {
      const state = filters();
      const container = activeTab === "trucks" ? capacityRows : loadRows;
      if (!container) return;
      const rows = [...container.querySelectorAll<HTMLElement>(".hlb-live-row")];
      let visible = 0;
      rows.forEach((row) => {
        const route = row.querySelectorAll<HTMLElement>(".hlb-live-route span");
        const origin = (route[0]?.textContent || "").toLowerCase();
        const destination = (route[1]?.textContent || "").toLowerCase();
        const text = (row.textContent || "").toLowerCase();
        const matches = (!state.origin || origin.includes(state.origin))
          && (!state.destination || destination.includes(state.destination))
          && (!state.equipment || text.includes(state.equipment))
          && (!state.minRate || rowRate(row) >= state.minRate)
          && (!state.minRpm || rowRpm(row) >= state.minRpm)
          && (!state.maxDeadhead || rowDeadhead(row) <= state.maxDeadhead);
        row.hidden = !matches;
        if (matches) visible += 1;
      });
      const ordered = rows.filter((row) => !row.hidden);
      if (state.sort === "rate") ordered.sort((a, b) => rowRate(b) - rowRate(a));
      if (state.sort === "rpm") ordered.sort((a, b) => rowRpm(b) - rowRpm(a));
      if (state.sort === "lane") ordered.sort((a, b) => (a.textContent || "").localeCompare(b.textContent || ""));
      ordered.forEach((row) => container.appendChild(row));
      if (resultCopy) {
        const isPreview = (row: HTMLElement) => row.classList.contains("hlb-structural-preview") || row.classList.contains("lbv2-truck-preview");
        const previewCount = ordered.filter(isPreview).length;
        const liveCount = visible - previewCount;
        const label = (count: number, kind: string) => `${count} ${kind} row${count === 1 ? "" : "s"}`;
        const liveKind = `live ${activeTab === "trucks" ? "truck" : "load"}`;
        resultCopy.textContent = liveCount && previewCount
          ? `${label(liveCount, liveKind)} and ${label(previewCount, "preview")} match this view`
          : previewCount || rows.every(isPreview)
            ? `${label(previewCount, "preview")} ${previewCount === 1 ? "matches" : "match"} this view`
            : `${label(liveCount, liveKind)} ${liveCount === 1 ? "matches" : "match"} this view`;
      }
    };

    searchForm?.addEventListener("submit", (event) => { event.preventDefault(); applyFilters(); });
    searchForm?.addEventListener("input", () => applyFilters());
    searchForm?.addEventListener("change", () => applyFilters());

    host.querySelector("[data-lbv2-swap]")?.addEventListener("click", () => {
      if (!searchForm) return;
      const origin = searchForm.elements.namedItem("origin");
      const destination = searchForm.elements.namedItem("destination");
      if (!(origin instanceof HTMLInputElement) || !(destination instanceof HTMLInputElement)) return;
      [origin.value, destination.value] = [destination.value, origin.value];
      applyFilters();
    });

    host.querySelectorAll<HTMLButtonElement>("[data-lbv2-equipment]").forEach((button) => button.addEventListener("click", () => {
      const select = searchForm?.elements.namedItem("equipment");
      if (select instanceof HTMLSelectElement) select.value = button.dataset.lbv2Equipment || "";
      applyFilters();
    }));
    host.querySelector("[data-lbv2-clear]")?.addEventListener("click", () => { searchForm?.reset(); applyFilters(); });
    host.querySelector("[data-lbv2-save]")?.addEventListener("click", () => {
      try { localStorage.setItem("hermes-load-board-saved-search", JSON.stringify(filters())); showToast("Search saved on this device."); }
      catch { showToast("Could not save this search.", true); }
    });

    try {
      const saved = JSON.parse(localStorage.getItem("hermes-load-board-saved-search") || "null");
      if (saved && searchForm) {
        for (const key of ["origin", "destination", "equipment", "minRate", "minRpm", "maxDeadhead", "sort"]) {
          const control = searchForm.elements.namedItem(key);
          if ((control instanceof HTMLInputElement || control instanceof HTMLSelectElement) && saved[key] != null) {
            control.value = String(saved[key]);
          }
        }
      }
    } catch {}

    const makeNode = (tag: string, className = "", text?: unknown) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = String(text);
      return node;
    };

    const createEmptyMarketplaceState = (title: string, message: string, href = "") => {
      const empty = makeNode("div", "lbv2-empty");
      empty.append(makeNode("strong", "", title), makeNode("span", "", message));
      if (href) {
        const link = document.createElement("a");
        link.href = href;
        link.textContent = "Register company";
        empty.append(link);
      }
      return empty;
    };

    const createOwnPostCard = (post: any) => {
      const article = makeNode("article", "lbv2-post-card");
      article.dataset.postId = String(post?.id || "");

      const details = makeNode("div");
      details.append(
        makeNode("span", "", post?.type === "load" ? "LOAD" : "TRUCK"),
        makeNode("strong", "", `${post?.origin || ""} → ${post?.destination || "Open destination"}`),
        makeNode("small", "", `${String(post?.equipment || "").replaceAll("_", " ")} · ${post?.pickup_window || post?.availability || "Current"}`),
      );

      const status = makeNode("div");
      const value = post?.rate_amount
        ? `$${Number(post.rate_amount).toLocaleString("en-US")}`
        : post?.type === "load"
          ? "Rate on request"
          : "Capacity";
      status.append(
        makeNode("b", "", value),
        makeNode("small", "", `${post?.status || ""} · expires ${new Date(post?.expires_at).toLocaleString()}`),
      );
      if (post?.status === "active") {
        const archive = document.createElement("button");
        archive.type = "button";
        archive.dataset.archivePost = String(post?.id || "");
        archive.textContent = "Archive";
        status.append(archive);
      }

      article.append(details, status);
      return article;
    };

    const renderOwnPosts = () => {
      if (myCount) myCount.textContent = String(ownPosts.filter((post) => post.status === "active").length);
      if (!myPostsList) return;
      myPostsList.replaceChildren();
      if (!companyState) {
        myPostsList.append(createEmptyMarketplaceState(
          "Company profile required",
          "Create or sign in to Hermes, register the company you operate with, then post freight or truck capacity.",
          `${ACCESS_PATH}?source=my-posts`,
        ));
        return;
      }
      if (!ownPosts.length) {
        myPostsList.append(createEmptyMarketplaceState(
          "No marketplace posts yet",
          "Use Post load or Post truck above. Posts appear here immediately and expire automatically.",
        ));
        return;
      }
      for (const post of ownPosts) myPostsList.append(createOwnPostCard(post));
      myPostsList.querySelectorAll<HTMLButtonElement>("[data-archive-post]").forEach((button) => button.addEventListener("click", async () => {
        button.disabled = true;
        const response = await fetch(`/api/load-board/posts/${encodeURIComponent(button.dataset.archivePost || "")}`, { method: "DELETE", headers: { Accept: "application/json" }, credentials: "same-origin" });
        if (!response.ok) { button.disabled = false; showToast("Could not archive this post.", true); return; }
        showToast("Marketplace post archived.");
        await loadCompanyState();
      }));
    };

    const loadCompanyState = async () => {
      try {
        const response = await fetch("/api/load-board/posts", { headers: { Accept: "application/json" }, credentials: "same-origin", cache: "no-store" });
        if (!response.ok) throw new Error(String(response.status));
        const payload = await response.json();
        companyState = payload.company || null;
        ownPosts = Array.isArray(payload.posts) ? payload.posts : [];
        if (companyCopy && companyState) companyCopy.textContent = `${companyState.name} · ${String(companyState.company_type || "company").replaceAll("_", " ")}`;
      } catch {
        companyState = null;
        ownPosts = [];
        if (companyCopy) companyCopy.textContent = "Register a company to post.";
      }
      renderOwnPosts();
    };

    const createTruckPreviewRows = () => [
      ["Fulton, NY", "Open destination", "53 ft Dry Van", "Appointment 10 AM", "Solo", "Historical capacity pattern · sanitized"],
      ["Des Plaines, IL", "Open destination", "53 ft Dry Van", "Ready noon", "Solo", "Historical capacity pattern · sanitized"],
      ["State College, PA", "Open destination", "53 ft Dry Van", "11 AM", "Solo", "Historical capacity pattern · sanitized"],
      ["Mokena, IL", "Open destination", "53 ft Reefer", "1 PM", "Solo", "Historical capacity pattern · sanitized"],
      ["Williamsburg, VA", "Open destination", "53 ft Dry Van", "Ready now", "TEAM", "Historical capacity pattern · sanitized"],
      ["Joplin, MO", "Open destination", "53 ft Dry Van", "Ready 2 PM", "TEAM", "Historical capacity pattern · sanitized"],
    ].map(([origin, destination, equipment, ready, team, source]) => {
      const row = makeNode("article", "hlb-live-row hlb-live-row--capacity lbv2-truck-preview");
      const route = makeNode("div", "hlb-live-route");
      route.append(makeNode("span", "", origin), makeNode("b", "", "→"), makeNode("span", "", destination));
      const meta = makeNode("div", "hlb-live-meta");
      const equipmentWrap = makeNode("span");
      equipmentWrap.append(makeNode("strong", "", equipment));
      meta.append(equipmentWrap, makeNode("span", "", `${ready} · ${team}`), makeNode("span", "", source));
      const rate = makeNode("div", "hlb-live-rate");
      rate.append(makeNode("strong", "", "Truck capacity"), makeNode("small", "", "PREVIEW · NOT LIVE"));
      row.append(route, meta, rate);
      return row;
    });

    const ensurePublicTruckPreview = () => {
      if (!capacityRows || root.classList.contains("is-unlocked")) return;
      if (capacityRows.querySelector(".hlb-live-row")) return;
      capacityRows.append(...createTruckPreviewRows());
    };

    const setTab = (tab: string) => {
      activeTab = tab;
      tabs.forEach((button) => button.setAttribute("aria-selected", String(button.dataset.lbv2Tab === tab)));
      if (loadGrid) loadGrid.hidden = tab !== "loads";
      if (capacityPanel) capacityPanel.hidden = tab === "mine";
      if (myPosts) myPosts.hidden = tab !== "mine";
      const rateFilter = host.querySelector<HTMLElement>("[data-lbv2-rate-filter]");
      const rpmFilter = host.querySelector<HTMLElement>("[data-lbv2-rpm-filter]");
      const deadheadFilter = host.querySelector<HTMLElement>("[data-lbv2-deadhead-filter]");
      const minRate = searchForm?.elements.namedItem("minRate");
      const minRpm = searchForm?.elements.namedItem("minRpm");
      const maxDeadhead = searchForm?.elements.namedItem("maxDeadhead");
      const sort = searchForm?.elements.namedItem("sort");
      for (const filter of [rateFilter, rpmFilter, deadheadFilter]) if (filter) filter.hidden = tab === "trucks";
      if (tab === "trucks") {
        for (const control of [minRate, minRpm, maxDeadhead]) if (control instanceof HTMLInputElement) control.value = "";
        if (sort instanceof HTMLSelectElement && ["rate", "rpm"].includes(sort.value)) sort.value = "best";
        ensurePublicTruckPreview();
      }
      if (tab === "mine") void loadCompanyState();
      else applyFilters();
    };
    tabs.forEach((button) => button.addEventListener("click", () => setTab(button.dataset.lbv2Tab || "loads")));

    const openPost = (type: "load" | "capacity") => {
      if (!companyState) { window.location.assign(`${ACCESS_PATH}?source=${type === "load" ? "post-load" : "post-truck"}`); return; }
      const allowed = type === "load" ? companyState.can_post_load : companyState.can_post_truck;
      if (!allowed) {
        showToast(type === "load" ? "Loads can be posted by broker, shipper or dealer companies." : "Trucks can be posted by carrier, owner-operator, fleet or dispatcher companies.", true);
        return;
      }
      if (!modal || !postForm) return;
      postForm.reset();
      const typeInput = postForm.elements.namedItem("type");
      if (typeInput instanceof HTMLInputElement) typeInput.value = type;
      const title = host.querySelector<HTMLElement>("[data-lbv2-modal-title]");
      const kicker = host.querySelector<HTMLElement>("[data-lbv2-modal-kicker]");
      const destination = postForm.elements.namedItem("destination");
      host.querySelectorAll<HTMLElement>("[data-lbv2-load-only]").forEach((node) => {
        node.hidden = type !== "load";
        node.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select").forEach((control) => { control.disabled = type !== "load"; });
      });
      if (destination instanceof HTMLInputElement) destination.required = type === "load";
      const destinationLabel = host.querySelector<HTMLElement>("[data-lbv2-destination-field] span");
      if (destinationLabel) destinationLabel.textContent = type === "load" ? "Destination *" : "Preferred destination";
      if (title) title.textContent = type === "load" ? "Post a load" : "Post an available truck";
      if (kicker) kicker.textContent = type === "load" ? "Freight listing" : "Carrier capacity";
      const pickup = host.querySelector<HTMLElement>("[data-lbv2-pickup-label]");
      const deadhead = host.querySelector<HTMLElement>("[data-lbv2-deadhead-label]");
      const units = host.querySelector<HTMLElement>("[data-lbv2-units-label]");
      if (pickup) pickup.textContent = type === "load" ? "Pickup / ready *" : "Available from *";
      if (deadhead) deadhead.textContent = type === "load" ? "Known deadhead, mi" : "Pickup radius, mi";
      if (units) units.textContent = type === "load" ? "Units" : "Truck capacity / units";
      modal.hidden = false;
      document.documentElement.classList.add("lbv2-modal-open");
      postForm.querySelector<HTMLInputElement>('input[name="origin"]')?.focus();
    };

    host.querySelectorAll<HTMLButtonElement>("[data-lbv2-post]").forEach((button) => button.addEventListener("click", () => openPost(button.dataset.lbv2Post === "capacity" ? "capacity" : "load")));
    host.querySelectorAll("[data-lbv2-close]").forEach((button) => button.addEventListener("click", () => { if (modal) modal.hidden = true; document.documentElement.classList.remove("lbv2-modal-open"); }));

    postForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(postForm instanceof HTMLFormElement)) return;
      const data = new FormData(postForm);
      const submit = postForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = host.querySelector<HTMLElement>("[data-lbv2-form-status]");
      if (submit) submit.disabled = true;
      if (status) status.textContent = "Publishing…";
      const payload: Record<string, unknown> = Object.fromEntries(data.entries());
      payload.rights_attested = data.get("rights_attested") === "on";
      for (const key of ["rate_amount", "distance_miles", "deadhead_miles", "vehicle_count", "weight_lbs", "length_feet", "expires_in_hours"]) {
        if (payload[key] === "") delete payload[key];
        else if (payload[key] != null) payload[key] = Number(payload[key]);
      }
      try {
        const response = await fetch("/api/load-board/posts", { method: "POST", credentials: "same-origin", headers: { Accept: "application/json", "Content-Type": "application/json" }, body: JSON.stringify(payload) });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.error || `request_${response.status}`);
        if (modal) modal.hidden = true;
        document.documentElement.classList.remove("lbv2-modal-open");
        showToast(payload.type === "load" ? "Load published to registered Hermes marketplace users." : "Truck capacity published to registered Hermes marketplace users.");
        await loadCompanyState();
        setTab("mine");
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message.replaceAll("_", " ") : "Could not publish";
      } finally { if (submit) submit.disabled = false; }
    });

    const syncCounts = () => {
      const loadCount = root.querySelector("[data-live-load-count]")?.textContent || "—";
      const truckCount = root.querySelector("[data-live-capacity-count]")?.textContent || "—";
      const loadTab = host.querySelector<HTMLElement>("[data-lbv2-tab-load-count]");
      const truckTab = host.querySelector<HTMLElement>("[data-lbv2-tab-truck-count]");
      if (loadTab) loadTab.textContent = loadCount;
      if (truckTab) truckTab.textContent = truckCount;
    };
    syncCounts();
    if ("MutationObserver" in window) {
      const countNodes = [root.querySelector("[data-live-load-count]"), root.querySelector("[data-live-capacity-count]"), loadRows, capacityRows].filter(Boolean) as Node[];
      let observer: MutationObserver;
      const observeMarketplace = () => countNodes.forEach((node) => observer.observe(node, { childList: true, subtree: true, characterData: true }));
      observer = new MutationObserver(() => {
        // Filtering and sorting may re-append rows. Disconnect while applying our own DOM
        // changes so the observer reacts only to upstream marketplace refreshes.
        observer.disconnect();
        syncCounts();
        if (activeTab === "trucks") ensurePublicTruckPreview();
        if (activeTab !== "mine") applyFilters();
        observeMarketplace();
      });
      observeMarketplace();
    }

    void (async () => {
      await loadCompanyState();
      setTab("loads");
      const postIntent = new URLSearchParams(window.location.search).get("post");
      if (postIntent === "load" || postIntent === "capacity") openPost(postIntent);
    })();
  }
</script>
)}
