---
import { ArrowUpRight } from "@lucide/astro";
import { publicPaths } from "../data/public-paths";

const roomMeta: Record<string, { accent: string; glow: string; label: string; displayNumber: string }> = {
  logistics: { accent: "#1E88FF", glow: "rgba(30,136,255,.24)", label: "Move freight", displayNumber: "01" },
  marketing: { accent: "#00C853", glow: "rgba(0,200,83,.20)", label: "Grow demand", displayNumber: "02" },
  technology: { accent: "#FF7A00", glow: "rgba(255,122,0,.22)", label: "Build systems", displayNumber: "03" },
  academy: { accent: "#7C5CFF", glow: "rgba(124,92,255,.22)", label: "Build capability", displayNumber: "04" },
};
---

<section class="home-rooms" id="top" aria-labelledby="home-rooms-title">
  <div class="home-rooms-atmosphere" aria-hidden="true"></div>
  <div class="home-rooms-shell">
    <header class="home-rooms-intro" id="about">
      <p class="home-rooms-kicker"><span>HERMES ECOSYSTEM</span><i aria-hidden="true"></i></p>
      <h1 id="home-rooms-title">
        <span class="home-rooms-display">Four directions.</span>
        <span class="home-rooms-script"><em>Choose yours.</em></span>
      </h1>
      <p class="home-rooms-ink-note"><strong>One Hermes ecosystem. One operating architecture.</strong> Each direction has its own business purpose, color, evidence, and path into the wider Hermes system.</p>
    </header>

    <span class="home-legacy-anchor" id="journey" aria-hidden="true"></span>
    <div class="home-rooms-grid" id="paths" aria-label="Hermes business directions">
      {publicPaths.map((path) => {
        const meta = roomMeta[path.id] ?? roomMeta.logistics;
        return (
          <a
            class={`home-room home-room-${path.id}`}
            href={`/paths/${path.id}/`}
            style={`--room-accent:${meta.accent};--room-glow:${meta.glow};--room-image:url('${path.image}')`}
            aria-label={`Open ${path.brandLabel}`}
            data-home-room
            data-room-id={path.id}
          >
            <span class="home-room-image" aria-hidden="true"></span>
            <span class="home-room-shade" aria-hidden="true"></span>
            <span class="home-room-content">
              <span class="home-room-number">{meta.displayNumber}</span>
              <span class="home-room-copy">
                <small>{meta.label}</small>
                <strong>{path.brandLabel}</strong>
                <span>{path.programLabel}</span>
              </span>
              <span class="home-room-arrow" aria-hidden="true"><ArrowUpRight size={20} /></span>
            </span>
          </a>
        );
      })}
    </div>

    <p class="home-rooms-note">Primary directions use the same color identity across homepage, navigation, and product context.</p>
  </div>
</section>

<script>
  import { trackCtaClicked, trackTrackSelected } from "../lib/analytics.ts";

  document.querySelectorAll<HTMLAnchorElement>("[data-home-room]").forEach((link) => {
    link.addEventListener("click", () => {
      const id = link.dataset.roomId;
      if (!id) return;
      trackTrackSelected(id);
      trackCtaClicked(`home_direction_${id}`);
    });
  });
</script>

<style>
  .home-rooms {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    padding: clamp(7rem, 12vh, 9rem) 0 clamp(2.75rem, 5vh, 4.5rem);
    color: #11131a;
    background:
      linear-gradient(rgba(17,19,26,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17,19,26,.035) 1px, transparent 1px),
      #f2f1ed;
    background-size: 72px 72px, 72px 72px, auto;
  }

  .home-rooms-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% -20%, rgba(124,92,255,.08), transparent 34rem);
  }

  .home-rooms-shell {
    position: relative;
    width: min(1480px, calc(100% - 40px));
    margin: 0 auto;
  }

  .home-rooms-intro {
    display: grid;
    grid-template-columns: minmax(0,1fr) minmax(300px,460px);
    column-gap: clamp(2rem,6vw,7rem);
    align-items: end;
    margin-bottom: clamp(2rem,4vw,3.2rem);
    scroll-margin-top: 6rem;
  }

  .home-legacy-anchor { display:block;width:0;height:0;scroll-margin-top:6rem; }

  .home-rooms-kicker {
    grid-column: 1 / -1;
    display: inline-flex;
    width: max-content;
    align-items: center;
    gap: .8rem;
    margin: 0 0 .9rem;
    color: #6c7280;
    font: 800 .66rem/1.2 var(--font-mono);
    letter-spacing: .18em;
  }

  .home-rooms-kicker i {
    width: 76px;
    height: 1px;
    background: #9aa0aa;
  }

  .home-rooms-intro h1 {
    margin: 0;
    max-width: 900px;
    color: #0b0d12;
    font-size: clamp(3.4rem,7.2vw,7.25rem);
    font-weight: 760;
    line-height: .9;
    letter-spacing: -.065em;
    text-wrap: balance;
  }

  .home-rooms-display,
  .home-rooms-script { display:block; }

  .home-rooms-script {
    margin-top: .08em;
    color: #69707d;
  }

  .home-rooms-script em {
    font: inherit;
    font-size: .55em;
    font-weight: 520;
    font-style: normal;
    letter-spacing: -.04em;
  }

  .home-rooms-ink-note {
    margin: 0 0 .25rem;
    max-width: 420px;
    color: #6b7280;
    font-size: clamp(.92rem,1.2vw,1.06rem);
    line-height: 1.7;
  }

  .home-rooms-ink-note strong {
    color: #20242c;
    font-weight: 780;
  }

  .home-rooms-grid {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    min-height: clamp(430px,52vh,650px);
    gap: 12px;
    border-radius: 32px;
    scroll-margin-top: 6rem;
  }

  .home-room {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb,var(--room-accent) 24%, #cfd3d8);
    border-top: 7px solid var(--room-accent);
    border-radius: 24px;
    color: #f8fafc;
    background:
      linear-gradient(180deg,
        color-mix(in srgb,var(--room-accent) 26%, #12151c) 0%,
        color-mix(in srgb,var(--room-accent) 12%, #0c0f15) 52%,
        #0b0d12 100%);
    box-shadow:
      0 22px 54px rgba(22,28,40,.10),
      inset 0 1px 0 rgba(255,255,255,.08);
    text-decoration: none;
    outline: none;
    transition: transform 220ms cubic-bezier(.16,1,.3,1), border-color 220ms ease, box-shadow 220ms ease;
  }

  .home-room-image { display:none; }

  .home-room-shade {
    position:absolute;
    inset:0;
    pointer-events:none;
    background:
      linear-gradient(180deg,rgba(255,255,255,.045),transparent 28%),
      radial-gradient(circle at 18% 12%,var(--room-glow),transparent 42%);
  }

  .home-room-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.25rem;
    padding: clamp(1.35rem,2.2vw,2.1rem);
  }

  .home-room-number {
    color: color-mix(in srgb,var(--room-accent) 84%,white);
    font: 800 .66rem/1 var(--font-mono);
    letter-spacing: .18em;
  }

  .home-room-copy {
    align-self: end;
    display: grid;
    gap: .55rem;
  }

  .home-room-copy small {
    color: color-mix(in srgb,var(--room-accent) 72%,white);
    font: 800 .65rem/1.2 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .home-room-copy strong {
    max-width: 10ch;
    color:#fff;
    font-size: clamp(1.75rem,2.6vw,2.75rem);
    line-height:.96;
    letter-spacing:-.05em;
  }

  .home-room-copy > span {
    max-width: 27ch;
    color:rgba(255,255,255,.62);
    font-size:.78rem;
    line-height:1.45;
  }

  .home-room-arrow {
    justify-self: end;
    display:grid;
    width:44px;
    height:44px;
    place-items:center;
    border:1px solid color-mix(in srgb,var(--room-accent) 46%,rgba(255,255,255,.22));
    border-radius:999px;
    color:#fff;
    background:rgba(255,255,255,.045);
    transition:transform 180ms ease,background 180ms ease,border-color 180ms ease;
  }

  .home-room:hover,
  .home-room:focus-visible {
    transform: translateY(-5px);
    border-color: color-mix(in srgb,var(--room-accent) 62%,#d5d9df);
    box-shadow:
      0 30px 68px rgba(22,28,40,.16),
      0 0 0 1px color-mix(in srgb,var(--room-accent) 18%,transparent);
  }

  .home-room:hover .home-room-arrow,
  .home-room:focus-visible .home-room-arrow {
    transform: translate(2px,-2px);
    border-color: var(--room-accent);
    background: color-mix(in srgb,var(--room-accent) 22%,rgba(255,255,255,.04));
  }

  .home-room:focus-visible {
    outline: 3px solid color-mix(in srgb,var(--room-accent) 55%,white);
    outline-offset: 3px;
  }

  .home-rooms-note {
    margin: 1rem 0 0;
    color:#777e89;
    font-size:.72rem;
    text-align:right;
  }

  @media(max-width:980px){
    .home-rooms{padding-top:6rem}
    .home-rooms-intro{grid-template-columns:1fr;gap:1.3rem}
    .home-rooms-grid{grid-template-columns:1fr 1fr;min-height:760px}
  }

  @media(max-width:620px){
    .home-rooms{padding:5.25rem 0 1.6rem}
    .home-rooms-shell{width:min(100% - 24px,1480px)}
    .home-rooms-intro h1{font-size:clamp(3rem,16vw,4.5rem)}
    .home-rooms-ink-note{font-size:.92rem}
    .home-rooms-grid{grid-template-columns:1fr;min-height:0;gap:10px;border-radius:24px}
    .home-room{
      min-height:184px;
      border-top-width:1px;
      border-left:7px solid var(--room-accent);
      border-radius:18px;
    }
    .home-room-content{
      grid-template-columns:auto 1fr auto;
      grid-template-rows:1fr;
      align-items:end;
      gap:1rem;
      padding:1.15rem;
    }
    .home-room-number{align-self:start}
    .home-room-copy{align-self:end}
    .home-room-copy strong{font-size:1.6rem;max-width:none}
    .home-room-arrow{align-self:end}
    .home-rooms-note{text-align:left}
  }

  @media(prefers-reduced-motion:reduce){
    .home-room,.home-room-arrow{transition:none}
    .home-room:hover,.home-room:focus-visible{transform:none}
  }
</style>
