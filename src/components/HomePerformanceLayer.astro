<script>
  const mobileQuery = window.matchMedia("(max-width: 900px)");
  const rooms = [...document.querySelectorAll<HTMLElement>(".home-room")];

  const imageUrlFor = (room: HTMLElement) => {
    const value = getComputedStyle(room).getPropertyValue("--room-image").trim();
    const match = value.match(/url\(["']?(.*?)["']?\)/i);
    return match?.[1] ?? "";
  };

  const activateImage = (room: HTMLElement) => {
    if (room.dataset.imageReady === "true") return;
    const url = imageUrlFor(room);
    if (!url) {
      room.dataset.imageReady = "true";
      return;
    }

    const preload = new Image();
    preload.decoding = "async";
    preload.src = url;

    const reveal = () => {
      room.dataset.imageReady = "true";
    };

    if (typeof preload.decode === "function") {
      void preload.decode().then(reveal).catch(reveal);
    } else {
      preload.addEventListener("load", reveal, { once: true });
      preload.addEventListener("error", reveal, { once: true });
    }
  };

  if (mobileQuery.matches && rooms.length > 1 && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const room = entry.target as HTMLElement;
        activateImage(room);
        observer.unobserve(room);
      }
    }, { rootMargin: "360px 0px", threshold: 0.01 });

    rooms.slice(1).forEach((room) => observer.observe(room));
  } else {
    rooms.forEach((room) => { room.dataset.imageReady = "true"; });
  }
</script>

