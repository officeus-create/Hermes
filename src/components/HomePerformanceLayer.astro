<style is:global>
  .home-contact-shell {
    content-visibility: auto;
    contain-intrinsic-size: 1100px;
  }

  @media (hover: hover) and (pointer: fine) {
    .home-room-copy small,
    .home-room-copy strong,
    .home-room-copy > span,
    .home-room-arrow,
    .home-contact-shell a {
      transition:
        color 180ms ease,
        opacity 180ms ease,
        transform 200ms cubic-bezier(.16,1,.3,1),
        border-color 180ms ease,
        background-color 180ms ease;
    }

    .home-room:hover .home-room-copy small,
    .home-room:focus-visible .home-room-copy small {
      color: color-mix(in srgb, var(--room-accent) 76%, white);
    }

    .home-room:hover .home-room-copy strong,
    .home-room:focus-visible .home-room-copy strong {
      transform: translateX(2px);
    }

    .home-room:hover .home-room-copy > span,
    .home-room:focus-visible .home-room-copy > span {
      color: rgba(255,255,255,.76);
    }

    .home-contact-shell a:hover,
    .home-contact-shell a:focus-visible {
      transform: translateX(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-room-copy small,
    .home-room-copy strong,
    .home-room-copy > span,
    .home-room-arrow,
    .home-contact-shell a {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
