---
import { site } from "../data/site";
---

<section class="section journey-section" id="journey">
  <div class="shell">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">One shared operating path</p>
        <h2>From a clear choice to measurable progress.</h2>
      </div>
      <p>Each business has its own expertise. The shared discipline is to choose carefully, plan clearly, build practically, and improve from evidence.</p>
    </div>
    <ol class="journey-grid">
      {site.journey.map((step) => (
        <li>
          <span>{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
