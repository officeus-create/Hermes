---
/**
 * Internal owner control room: architecture and integration roadmap.
 * No provider secrets, private evidence or account data live in this component.
 * Runtime details are read only after the existing owner gate authorizes loadAll().
 */
const { ru = false } = Astro.props;
const translations: Record<string, string> = {};
const l = (en: string, local: string) => { translations[en] = local; return ru ? local : en; };
const steps = [
  { id: "01", name: l("Owner request / inbound event", "Задание владельца / событие"), note: l("Typed task, CI event, CRM or approved connector", "Ввод, CI, CRM либо разрешённый коннектор") },
  { id: "02", name: "HAE · Worker + Queue + D1", note: l("One WORK_ID, owner of state, cost and permissions", "Единый WORK_ID, состояние, права и бюджет") },
  { id: "03", name: l("Policy router", "Маршрутизатор политик"), note: l("Deterministic rules first; unknown → HOLD", "Сначала правила; неопределённость → HOLD") },
  { id: "04", name: l("Local / cloud specialist", "Локальный / облачный специалист"), note: l("Mac Qwen or approved free Cloudflare model", "Qwen на Mac либо разрешённая бесплатная модель") },
  { id: "05", name: l("Independent QA / owner gate", "Независимая QA / допуск владельца"), note: l("Proof before deploy, reply, spend or publish", "Доказательство до релиза, ответа и публикации") },
  { id: "06", name: "Evidence → One Brain", note: l("Promote only independently verified lessons", "Только проверенные уроки в единый мозг") }
];
const models = [
  { id: "glm", title: "GLM-4.7-Flash", name: "@cf/zai-org/glm-4.7-flash", role: l("Reasoning · CI diagnosis · code and content drafts", "Анализ · CI · проекты исправлений и текстов"), stage: l("Provider binding confirmed; real inference not yet accepted", "Binding подтверждён; реальный inference ещё не принят"), tone: "review", action: "glm", link: "https://github.com/officeus-create/Hermes/pull/2137", linkText: l("Review runtime free-plan gate", "Проверить runtime Free-plan") },
  { id: "clef", title: "Clef-flash", name: "@cf/cloudflare/clef-flash", role: l("Choose workstream, severity, intent and agent", "Выбор направления, срочности, намерения и агента"), stage: l("Candidate · no Hermes benchmark or activation", "Кандидат · без бенчмарка и активации"), tone: "planned", action: "clef", link: "https://developers.cloudflare.com/ai/models/", linkText: l("Model catalog", "Каталог моделей") },
  { id: "clairic", title: "Clairic", name: "@cf/cloudflare/clairic", role: l("Structured field extraction from allowed inputs", "Извлечение полей из разрешённых данных"), stage: l("Candidate · preview; no Hermes benchmark", "Кандидат · preview, тесты не проведены"), tone: "planned", action: "clairic", link: "https://developers.cloudflare.com/ai/models/", linkText: l("Model catalog", "Каталог моделей") },
  { id: "whisper", title: "Whisper Large V3 Turbo", name: "@cf/openai/whisper-large-v3-turbo", role: l("Consent-based call and audio transcription", "Расшифровка звонков и аудио при наличии согласия"), stage: l("Later stage · audio/privacy gate", "Позднее · проверка прав на аудио"), tone: "planned", action: "whisper", link: "https://developers.cloudflare.com/ai/models/", linkText: l("Model catalog", "Каталог моделей") }
];
const connections = [
  { id: "owner", title: "Hermes Connect Owner OS", state: l("Source available; release pending", "Код есть; релиз ожидается"), tone: "review", text: l("Existing owner-gated admin, D1 work queue and one-active-runner control.", "Существующая админка с проверкой владельца, очередью D1 и одним активным исполнителем."), url: "https://github.com/officeus-create/Hermes/pull/2107", cta: l("Owner admin PR", "PR админки") },
  { id: "hae", title: "HAE · Cloudflare", state: l("Worker/AI binding observed", "Worker и AI binding проверены"), tone: "observed", text: l("Existing Worker, Queue and D1. Production is dry_run; publishing disabled. Source PR is not live proof.", "Единый Worker, Queue и D1. Production в dry_run, публикации выключены. PR не доказывает выпуск."), url: "https://github.com/officeus-create/Hermes/issues/2033", cta: l("Runtime evidence", "Доказательства runtime") },
  { id: "access", title: "Cloudflare Access", state: l("Owner allowlist configured", "Список владельцев настроен"), tone: "observed", text: l("Private app configured for agents.hermeslogisticsus.com; live login/denial proof pending.", "Приложение создано; проверка реального входа и отказа постороннему ещё впереди."), url: "https://dash.cloudflare.com/ec00de0c2f5ffd6fda4034ca98f992f9/one/access-controls/apps", cta: l("Access settings", "Настройки Access") },
  { id: "tunnel", title: "Mac · private Cloudflare Tunnel", state: l("Created; live connector unverified", "Создан; соединение не подтверждено"), tone: "review", text: l("Tunnel must target signed-JWT bridge 127.0.0.1:8766, never the raw app port 8765.", "Tunnel должен вести к JWT-мосту 127.0.0.1:8766, а не напрямую к порту 8765."), url: "https://dash.cloudflare.com/ec00de0c2f5ffd6fda4034ca98f992f9/tunnels", cta: l("Tunnel settings", "Настройки Tunnel") },
  { id: "models", title: "Workers AI · free-only", state: l("Source gate merged; runtime Free-plan readback in review", "Исходный допуск merged; runtime Free-plan проверяется"), tone: "review", text: l("#2123 source safety is merged. #2137 must prove the deployed source, Workers Free attestation and $0 bounded inference before activation; no paid fallback.", "#2123 уже merged. #2137 должен подтвердить deployed source, Workers Free и $0 bounded inference до активации; платного fallback нет."), url: "https://github.com/officeus-create/Hermes/pull/2137", cta: l("Runtime readback PR", "PR runtime-проверки") },
  { id: "knowledge", title: "One Brain · Google Drive", state: l("Canonical knowledge source", "Единый источник знаний"), tone: "observed", text: l("Lessons and business rules are promoted only after independent QA, not directly from model output.", "Уроки и правила попадают сюда после проверки, не напрямую из ответа модели."), url: "https://docs.google.com/document/d/1ZhhySXskA7EdC40bWNNzSeMbvVKn7J1FPQOLNE-D98Y/edit", cta: l("Open One Brain", "Открыть One Brain") },
  { id: "ci", title: "GitHub CI event sensor", state: l("Source merged; independent QA activation in review", "Источник merged; активация независимой QA проверяется"), tone: "review", text: l("The #2090 intake source is merged and autonomous intake is live-verified. #2138 activates a separate independent-QA job and must prove the D1 QA receipt before any release path advances.", "Источник #2090 merged, автономный intake уже live-verified. #2138 включает отдельную independent-QA job и должен доказать D1 QA receipt до продвижения release path."), url: "https://github.com/officeus-create/Hermes/pull/2138", cta: l("Independent QA activation", "Активация независимой QA") }
];
const roles = [
  { name: "Agent Coordinator", detail: l("Route jobs to existing owners, never guess privileges", "Назначает задания существующим исполнителям, не придумывает права") },
  { name: "Technology Developer", detail: l("Implement product/code changes under the active owner and exact-head release contract", "Реализует код в текущем owner lane и по exact-head release contract") },
  { name: "Automatic Engineer", detail: l("Own the single HAE runtime and prepare bounded repairs; never self-approve", "Владеет единым HAE runtime и готовит ограниченные исправления; не утверждает себя сам") },
  { name: "QA Auditor", detail: l("Independently compare failures to live and exact-head evidence", "Независимо проверяет ошибки по live и exact-head evidence") },
  { name: "Access Governor", detail: l("Enforce least privilege, tenant scope, grant/review/revoke and connector boundaries", "Контролирует least privilege, tenant scope, выдачу/проверку/отзыв доступов и коннекторы") },
  { name: "Knowledge Curator", detail: l("Promote accepted lessons to One Brain only after evidence and QA", "Передаёт подтверждённые уроки в One Brain только после evidence и QA") },
  { name: "COO", detail: l("Close the work cell: acceptance, KPI boundary, blocker and next action", "Замыкает work cell: acceptance, KPI, blocker и следующий шаг") },
  { name: l("Business specialists", "Бизнес-специалисты"), detail: "Logistics · Marketing · SEO/GEO · Sales · Academy · Finance · HR · Design" }
];
---

<section class="ai-map" id="hermes-ai-architecture" data-ai-architecture aria-labelledby="ai-map-heading">
  <header class="ai-map__header">
    <div>
      <p class="ai-map__kicker"><span class="ai-map__pulse" aria-hidden="true"></span> HERMES AI · OWNER CONTROL PLANE</p>
      <h2 id="ai-map-heading">{l("AI system architecture", "Архитектура ИИ-системы")}</h2>
      <p>{l("One view of what exists, how it works, why it is needed and exactly what must be verified before activation.", "Одна схема: что существует, как работает, зачем нужно и какие проверки необходимы перед включением.")}</p>
    </div>
    <span class="ai-map__mode">{l("Private owner workspace", "Приватная админка владельца")}</span>
  </header>
  <div class="ai-map__statusline">
    <div><span class="ai-map__mini-label">{l("Mac AI runner", "ИИ на Mac")}</span><strong data-ai-map-runner>{l("Waiting for owner status", "Ожидание статуса владельца")}</strong><small data-ai-map-runner-time>{l("Not checked", "Не проверено")}</small></div>
    <div><span class="ai-map__mini-label">HAE</span><strong>Worker · D1 · Queue</strong><small>{l("Existing canonical runtime", "Существующий единый runtime")}</small></div>
    <div><span class="ai-map__mini-label">{l("Cloud models", "Облачные модели")}</span><strong>{l("1 candidate for initial test", "1 кандидат на первый тест")}</strong><small>{l("No accepted inference receipt yet", "Принятой квитанции inference ещё нет")}</small></div>
    <div><span class="ai-map__mini-label">{l("External actions", "Внешние действия")}</span><strong>{l("Owner / QA gate", "Допуск владельца / QA")}</strong><small>{l("No paid AI fallback", "Платный fallback запрещён")}</small></div>
  </div>
  <div class="ai-map__tabs" role="tablist" aria-label={l("AI system sections", "Разделы ИИ-системы")}>
    <button type="button" data-ai-map-tab="flow" id="ai-tab-flow" role="tab" aria-selected="true" aria-controls="ai-panel-flow">{l("How it works", "Как работает")}</button>
    <button type="button" data-ai-map-tab="models" id="ai-tab-models" role="tab" aria-selected="false" aria-controls="ai-panel-models" tabindex="-1">{l("Models and agents", "Модели и агенты")}</button>
    <button type="button" data-ai-map-tab="connections" id="ai-tab-connections" role="tab" aria-selected="false" aria-controls="ai-panel-connections" tabindex="-1">{l("Connections", "Подключения")}</button>
    <button type="button" data-ai-map-tab="rollout" id="ai-tab-rollout" role="tab" aria-selected="false" aria-controls="ai-panel-rollout" tabindex="-1">{l("Activation plan", "План запуска")}</button>
  </div>
  <div id="ai-panel-flow" data-ai-map-panel="flow" role="tabpanel" aria-labelledby="ai-tab-flow">
    <div class="ai-map__overview">
      <div class="ai-map__flow">
        {steps.map((step) => <article class="ai-map__step"><span class="ai-map__num">{step.id}</span><div><strong>{step.name}</strong><p>{step.note}</p></div></article>)}
      </div>
      <aside class="ai-map__principles">
        <h3>{l("The division of responsibilities", "Кто за что отвечает")}</h3>
        <p><strong>HAE</strong> — {l("the only job ledger, scheduler and permission boundary.", "единственный центр задач, расписания и разрешений.")}</p>
        <p><strong>Hermes AI · Mac</strong> — {l("local context, audits and tools; offline is allowed.", "локальные знания, аудит и инструменты; может быть офлайн.")}</p>
        <p><strong>Workers AI</strong> — {l("optional narrow AI capabilities, with evidence and quota checks.", "дополнительные узкие функции ИИ при наличии лимита и доказательств.")}</p>
        <p><strong>One Brain</strong> — {l("canonical accepted knowledge, not automatic model memory.", "проверенные знания, а не бесконтрольная память моделей.")}</p>
        <div class="ai-map__guard"><strong>{l("When a gate fails", "Если проверка не пройдена")}</strong><span>HOLD · WAITING_FREE_AI · PATCH_ONLY</span></div>
        <button type="button" class="ai-map__outline" data-ai-task-preset="qa">{l("Prepare a real QA task", "Подготовить задачу QA")}</button>
      </aside>
    </div>
  </div>
  <div id="ai-panel-models" data-ai-map-panel="models" role="tabpanel" aria-labelledby="ai-tab-models" hidden>
    <p class="ai-map__section-copy">{l("A catalog listing is not proof of free availability or deployment. These are candidate roles, not claims of active production agents.", "Наличие модели в каталоге не доказывает бесплатный доступ или запуск. Здесь обозначены роли-кандидаты, а не активные production-агенты.")}</p>
    <div class="ai-map__model-grid">
      {models.map((model) => <article class="ai-map__model"><div class="ai-map__model-top"><span class="ai-map__model-monogram">{model.title.slice(0,1)}</span><span class={"ai-map__flag "+model.tone}>{model.stage}</span></div><h3>{model.title}</h3><code>{model.name}</code><p>{model.role}</p><div class="ai-map__model-actions"><a href={model.link} target="_blank" rel="noopener noreferrer">{model.linkText} ↗</a><button type="button" data-ai-task-preset={model.action}>{l("Prepare test", "Подготовить тест")}</button></div></article>)}
    </div>
    <h3 class="ai-map__minor">{l("Planned work roles", "Роли рабочих агентов")}</h3>
    <div class="ai-map__roles">{roles.map((role) => <div><strong>{role.name}</strong><small>{role.detail}</small></div>)}</div>
  </div>
  <div id="ai-panel-connections" data-ai-map-panel="connections" role="tabpanel" aria-labelledby="ai-tab-connections" hidden>
    <p class="ai-map__section-copy">{l("Each status identifies a source-level observation or a pending gate. Links open the existing provider/admin; no credential is stored here.", "Каждый статус — наблюдение по источнику или ожидаемая проверка. Ссылки открывают действующую админку провайдера; секреты здесь не хранятся.")}</p>
    <div class="ai-map__connection-grid">
      {connections.map((connection) => <article class="ai-map__connection"><div class="ai-map__connection-head"><h3>{connection.title}</h3><span class={"ai-map__flag "+connection.tone}>{connection.state}</span></div><p>{connection.text}</p><a href={connection.url} target="_blank" rel="noopener noreferrer">{connection.cta} ↗</a></article>)}
    </div>
    <p class="ai-map__footnote">{l("Source snapshot: 27 October 2026. Only Mac runner heartbeat above is refreshed from owner-authenticated API. Provider status must not silently become CONNECTED without authenticated readback.", "Снимок источников: 27 октября 2026. Только heartbeat Mac выше обновляется из API владельца. Статус провайдера не становится CONNECTED без подтверждённого readback.")}</p>
  </div>
  <div id="ai-panel-rollout" data-ai-map-panel="rollout" role="tabpanel" aria-labelledby="ai-tab-rollout" hidden>
    <div class="ai-map__rollout">
      <article><span class="ai-map__num">P0</span><div><h3>{l("One owner admin + exact access", "Одна админка + проверка доступа")}</h3><p>{l("Release Command Center through existing owner capability; verify Access policy, Tunnel 8766 and anonymous/other-user denial.", "Выпустить Command Center с проверкой прав владельца; протестировать Access, Tunnel 8766 и отказ постороннему.")}</p><button data-ai-task-preset="access" type="button">{l("Prepare work item", "Подготовить задачу")}</button></div></article>
      <article><span class="ai-map__num">P1</span><div><h3>{l("One verified free cloud model", "Одна подтверждённая бесплатная модель")}</h3><p>{l("GLM synthetic task through existing HAE Worker; exact inference receipt, 0 paid spend, dry_run and quota gate.", "Синтетический вызов GLM через существующий HAE; квитанция inference, $0 расходов, dry_run и контроль квоты.")}</p><button data-ai-task-preset="glm" type="button">{l("Prepare work item", "Подготовить задачу")}</button></div></article>
      <article><span class="ai-map__num">P2</span><div><h3>{l("Model routing and holdouts", "Маршрутизация и независимые тесты")}</h3><p>{l("Compare Clef and Clairic on held-out labels; use deterministic rules first, HOLD on uncertainty, no private corpus export.", "Проверить Clef и Clairic на контрольных примерах; правила первыми, HOLD при сомнениях, без отправки приватного корпуса.")}</p><button data-ai-task-preset="routing" type="button">{l("Prepare work item", "Подготовить задачу")}</button></div></article>
      <article><span class="ai-map__num">P3</span><div><h3>{l("Closed-loop work and learning", "Исполнение и самообучение")}</h3><p>{l("GitHub/CI sensor → existing Queue/D1 → bounded patch → independent QA → reviewed One Brain lesson.", "GitHub/CI → существующие Queue/D1 → ограниченный патч → QA → проверенный урок One Brain.")}</p><button data-ai-task-preset="qa" type="button">{l("Prepare work item", "Подготовить задачу")}</button></div></article>
    </div>
    <p class="ai-map__footnote">{l("Preparing an item fills the existing owner form below; it does NOT dispatch an agent or create a cloud task until you save it.", "Подготовка задачи заполняет существующую форму ниже; она НЕ запускает агента и НЕ создаёт запись, пока вы не нажмёте «Сохранить».")}</p>
  </div>
  <script is:inline type="application/json" data-ai-map-translations set:html={JSON.stringify(translations).replace(/</g, "\\u003c")}></script>
</section>

<script>
const root = document.querySelector<HTMLElement>("[data-ai-architecture]");
if (root) {
  // The site is statically generated: URL ?lang=ru must be applied client-side.
  // All visible translations are defined alongside source strings, not remote data.
  const locale = new URLSearchParams(location.search).get("lang");
  const localMessages = root.querySelector<HTMLScriptElement>("[data-ai-map-translations]");
  if (locale === "ru" && localMessages) {
    let translations: Record<string, string> = {};
    try { translations = JSON.parse(localMessages.textContent || "{}"); } catch { /* Keep source English; never invent localized content. */ }
    const pairs = Object.entries(translations).sort((a, b) => b[0].length - a[0].length);
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    let node: Node | null;
    while ((node = walker.nextNode())) {
      if (node.parentElement?.closest("script,style")) continue;
      let value = node.textContent || "";
      for (const [en, local] of pairs) {
        if (en && value.includes(en)) value = value.replace(en, local);
      }
      node.textContent = value;
    }
    root.querySelectorAll<HTMLElement>("[aria-label]").forEach((el) => {
      const label = el.getAttribute("aria-label") || "";
      if (translations[label]) el.setAttribute("aria-label", translations[label]);
    });
  }
  const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-ai-map-tab]"));
  const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-ai-map-panel]"));
  const activate = (name: string) => {
    buttons.forEach((button) => {
      const isSelected = button.dataset.aiMapTab === name;
      button.setAttribute("aria-selected", String(isSelected));
      button.tabIndex = isSelected ? 0 : -1;
    });
    panels.forEach((panel) => { panel.hidden = panel.dataset.aiMapPanel !== name; });
  };
  buttons.forEach((button, index) => {
    button.addEventListener("click", () => activate(button.dataset.aiMapTab || "flow"));
    button.addEventListener("keydown", (event) => {
      if (!["ArrowRight", "ArrowLeft", "Home", "End"].includes(event.key)) return;
      event.preventDefault();
      const next = event.key === "Home" ? 0 : event.key === "End" ? buttons.length - 1 : (index + (event.key === "ArrowRight" ? 1 : -1) + buttons.length) % buttons.length;
      buttons[next]?.focus();
      activate(buttons[next]?.dataset.aiMapTab || "flow");
    });
  });
  const taskPresets: Record<string, { title: string; details: string }> = {
    access: { title: "Hermes AI Access + Tunnel E2E acceptance", details: "Verify self-hosted owner-only Cloudflare Access app, named Tunnel -> signed-JWT bridge 127.0.0.1:8766, anonymous/other-user denial and authorized user acceptance. NO direct exposure of 8765, no public publishing before evidence." },
    glm: { title: "HAE Workers AI · GLM free-only synthetic inference proof", details: "Via EXISTING HAE Worker + AI binding, run one synthetic bounded GLM-4.7-Flash dry_run exercise only after confirmed Workers Free plan, exact-head review, quota and $0 paid-ledger guard. Record source SHA, provider receipt, WAITING_FREE_AI on failure. No private corpus or paid fallback." },
    clef: { title: "Clef-flash · held-out classifier evaluation", details: "SOURCE/DRAFT only. Evaluate @cf/cloudflare/clef-flash on synthetic held-out Hermes routing and intent cases, compare with deterministic rules and GLM. Check free eligibility, privacy and real consumption before any provider call; HOLD when uncertainty." },
    clairic: { title: "Clairic · structured extraction evaluation", details: "SOURCE/DRAFT only. Test @cf/cloudflare/clairic on synthetic MC/DOT, dates, amounts and report fields against ground truth. Verify preview and Workers Free limits before any model call. Do not persist model guesses as facts." },
    whisper: { title: "Whisper · audio consent and transcription pilot", details: "DRAFT only. Build consent/data-retention specification and synthetic audio benchmark. Do not ingest customer call recordings or social video audio without lawful access and privacy approval." },
    routing: { title: "HAE capability router: local Qwen + cloud free models", details: "Reuse ONE HAE task authority (Worker/D1/Queue). Document routing by classification, quota and privacy; local Mac offline -> WAITING_LOCAL; no paid fallback. Benchmark held-out cases and independent QA before publishing or agent actions." },
    qa: { title: "HAE verified learning and bounded repair pipeline", details: "Inspect current HAE #2033, active #2138 independent-QA sensor (source #2090 merged), #2068 repair and #2069 lessons. One WORK_ID from real intake -> exact Queue/D1 readback -> PATCH_ONLY -> independent QA -> reviewed One Brain lesson -> later runtime consumption. No duplicate agents, no merge/deploy/publish without gates." }
  };
  root.querySelectorAll<HTMLButtonElement>("[data-ai-task-preset]").forEach((button) => {
    button.addEventListener("click", () => {
      const draft = taskPresets[button.dataset.aiTaskPreset || ""];
      const form = document.querySelector<HTMLFormElement>("[data-work-form]");
      if (!draft || !form || form.closest("[data-private]")?.hasAttribute("hidden")) return;
      const title = form.elements.namedItem("title");
      const details = form.elements.namedItem("details");
      const workstream = form.elements.namedItem("workstream");
      const priority = form.elements.namedItem("priority");
      if (!(title instanceof HTMLInputElement) || !(details instanceof HTMLTextAreaElement) || !(workstream instanceof HTMLSelectElement) || !(priority instanceof HTMLSelectElement)) return;
      title.value = draft.title;
      details.value = draft.details;
      workstream.value = "technology";
      priority.value = "p1";
      form.dataset.source = "text";
      const status = form.querySelector<HTMLElement>("[data-capture-status]");
      if (status) status.textContent = "Черновик заполнен. Проверьте задачу и нажмите «Сохранить в очередь»; пока ничего не запущено.";
      form.scrollIntoView({ behavior: "smooth", block: "center" });
      details.focus({ preventScroll: true });
    });
  });
}
</script>

