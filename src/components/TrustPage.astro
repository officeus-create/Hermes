---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

type TrustSection = {
  title: string;
  body?: string[];
  bullets?: string[];
};

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  intro: string;
  reviewedAt: string;
  sections: TrustSection[];
}

const { title, description, eyebrow, h1, intro, reviewedAt, sections } = Astro.props;
const canonical = `https://hermeslogisticsus.com${Astro.url.pathname}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: h1,
    description,
    url: canonical,
    dateModified: reviewedAt,
    isPartOf: { "@id": "https://hermeslogisticsus.com/#website" },
    publisher: { "@id": "https://hermeslogisticsus.com/#organization" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: h1, item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <SiteHeader />
  <main id="main-content" class="trust-page">
    <section class="trust-hero" id="top">
      <div class="shell trust-hero-inner">
        <nav class="trust-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{h1}</span>
        </nav>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{h1}</h1>
        <p class="trust-intro">{intro}</p>
        <p class="trust-reviewed">Reviewed {reviewedAt}</p>
      </div>
    </section>

    <section class="section">
      <div class="shell trust-content">
        {sections.map((section) => (
          <article>
            <h2>{section.title}</h2>
            {section.body?.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul>
                {section.bullets.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </article>
        ))}
        <aside class="trust-contact" aria-label="Trust and policy contact">
          <p class="eyebrow">Questions or corrections</p>
          <h2>Contact the Hermes team.</h2>
          <p>Send legal, privacy, accessibility, correction, or publication-evidence questions to the public coordination address.</p>
          <a class="button button-primary" href="mailto:officeus@hermeslogisticsus.com?subject=Hermes%20website%20policy%20question">Email officeus@hermeslogisticsus.com</a>
        </aside>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .trust-page { background: #f7f9ff; color: #10204e; }
  .trust-hero { padding: 9rem 0 4.5rem; background: linear-gradient(145deg, #07143d, #122b72 62%, #214a9e); color: white; }
  .trust-hero-inner { max-width: 940px; }
  .trust-breadcrumb { display: flex; gap: .55rem; align-items: center; margin-bottom: 1.6rem; color: rgba(255,255,255,.72); font-size: .9rem; }
  .trust-breadcrumb a { color: inherit; }
  .trust-hero h1 { max-width: 900px; margin: .65rem 0 1.1rem; font-size: clamp(2.6rem, 6vw, 4.9rem); line-height: 1; letter-spacing: -.04em; }
  .trust-intro { max-width: 850px; color: rgba(255,255,255,.82); font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.7; }
  .trust-reviewed { margin-top: 1.1rem; color: rgba(255,255,255,.62); font-size: .84rem; }
  .trust-content { display: grid; gap: 1rem; max-width: 980px; }
  .trust-content article, .trust-contact { padding: clamp(1.35rem, 3vw, 2.2rem); border: 1px solid rgba(28,62,141,.14); border-radius: 20px; background: white; box-shadow: 0 18px 50px rgba(17,43,103,.05); }
  .trust-content h2 { margin: 0 0 .85rem; }
  .trust-content p, .trust-content li { color: #526181; line-height: 1.7; }
  .trust-content ul { display: grid; gap: .55rem; padding-left: 1.3rem; }
  .trust-contact { margin-top: 1rem; background: #08173f; color: white; }
  .trust-contact p { color: rgba(255,255,255,.74); }
</style>
