---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

type TrustSection = {
  title: string;
  body?: string[];
  bullets?: string[];
};

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  intro: string;
  reviewedAt: string;
  sections: TrustSection[];
  actionLabel?: string;
  actionHref?: string;
}

const { title, description, eyebrow, h1, intro, reviewedAt, sections, actionLabel, actionHref } = Astro.props;
const canonical = `https://hermeslogisticsus.com${Astro.url.pathname}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: h1,
    description,
    url: canonical,
    dateModified: reviewedAt,
    isPartOf: { "@id": "https://hermeslogisticsus.com/#website" },
    publisher: { "@id": "https://hermeslogisticsus.com/#organization" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: h1, item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <SiteHeader theme="light" />
  <main id="main-content" class="trust-page">
    <section class="trust-hero" id="top">
      <div class="shell trust-hero-inner">
        <nav class="trust-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{h1}</span>
        </nav>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{h1}</h1>
        <p class="trust-intro">{intro}</p>
        <div class="trust-hero-meta">
          <p class="trust-reviewed">Reviewed {reviewedAt}</p>
          {actionLabel && actionHref && <a class="button button-primary trust-action" href={actionHref}>{actionLabel}</a>}
        </div>
      </div>
    </section>

    <section class="section trust-body">
      <div class="shell trust-content">
        {sections.map((section, index) => (
          <article data-trust-section={index + 1}>
            <span class="trust-section-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{section.title}</h2>
              {section.body?.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets && (
                <ul>
                  {section.bullets.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </div>
          </article>
        ))}
        <aside class="trust-contact" aria-label="Trust and policy contact">
          <div>
            <p class="eyebrow">Questions or corrections</p>
            <h2>Contact the Hermes team.</h2>
            <p>Send legal, privacy, accessibility, correction, or publication-evidence questions to the public coordination address.</p>
          </div>
          <a class="button button-primary" href="mailto:officeus@hermeslogisticsus.com?subject=Hermes%20website%20policy%20question">Email officeus@hermeslogisticsus.com</a>
        </aside>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .trust-page {
    color: var(--hermes-ink);
    background: var(--hermes-pearl);
  }

  .trust-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(8.5rem, 13vw, 11rem) 0 clamp(4.5rem, 8vw, 7.5rem);
    border-bottom: 1px solid var(--hermes-line-light);
    background:
      radial-gradient(circle at 82% 18%, rgba(124, 92, 255, .08), transparent 25rem),
      var(--hermes-pearl);
  }

  .trust-hero::after {
    content: "";
    position: absolute;
    width: min(34vw, 430px);
    aspect-ratio: 1;
    right: max(-8vw, -110px);
    bottom: min(-13vw, -120px);
    border: 1px solid rgba(124, 92, 255, .16);
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 42px rgba(124, 92, 255, .025),
      inset 0 0 0 84px rgba(90, 200, 250, .018);
    pointer-events: none;
  }

  .trust-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 980px;
  }

  .trust-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    align-items: center;
    margin-bottom: clamp(1.8rem, 4vw, 3rem);
    color: var(--hermes-muted);
    font-size: .86rem;
  }

  .trust-breadcrumb a {
    color: var(--hermes-ink);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .trust-hero .eyebrow,
  .trust-section-index {
    color: var(--hermes-violet);
  }

  .trust-hero h1 {
    max-width: 930px;
    margin: .75rem 0 1.25rem;
    color: var(--hermes-ink);
    font-size: clamp(3rem, 7vw, 6.6rem);
    line-height: var(--hermes-display-leading);
    letter-spacing: var(--hermes-display-tracking);
    text-wrap: balance;
  }

  .trust-intro {
    max-width: 800px;
    margin: 0;
    color: var(--hermes-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: var(--hermes-copy-leading);
  }

  .trust-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 1.5rem;
  }

  .trust-reviewed {
    margin: 0;
    padding: 10px 13px;
    border: 1px solid var(--hermes-line-light);
    border-radius: var(--hermes-radius-pill);
    color: var(--hermes-muted);
    background: rgba(255,255,255,.58);
    font-size: .82rem;
  }

  .trust-action,
  .trust-contact .button-primary {
    min-height: 46px;
    border: 1px solid var(--hermes-obsidian);
    border-radius: var(--hermes-radius-control);
    color: #fff;
    background: var(--hermes-obsidian);
    box-shadow: none;
  }

  .trust-action:hover,
  .trust-action:focus-visible,
  .trust-contact .button-primary:hover,
  .trust-contact .button-primary:focus-visible {
    color: #fff;
    background: var(--hermes-graphite);
  }

  .trust-body {
    background: var(--hermes-pearl);
  }

  .trust-content {
    display: grid;
    gap: 14px;
    max-width: 1040px;
  }

  .trust-content article {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 20px;
    padding: clamp(1.5rem, 3vw, 2.35rem);
    border: 1px solid var(--hermes-line-light);
    border-radius: var(--hermes-radius-card);
    background: var(--hermes-paper);
    box-shadow: var(--hermes-shadow-card);
  }

  .trust-section-index {
    padding-top: .2rem;
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .08em;
  }

  .trust-content h2 {
    margin: 0 0 .9rem;
    color: var(--hermes-ink);
    font-size: clamp(1.35rem, 2.2vw, 1.9rem);
    letter-spacing: -.025em;
  }

  .trust-content p,
  .trust-content li {
    color: var(--hermes-muted);
    line-height: var(--hermes-copy-leading);
  }

  .trust-content ul {
    display: grid;
    gap: .65rem;
    padding-left: 1.25rem;
  }

  .trust-contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: end;
    margin-top: 10px;
    padding: clamp(1.7rem, 4vw, 2.8rem);
    border: 1px solid var(--hermes-line-dark);
    border-radius: var(--hermes-radius-panel);
    color: #fff;
    background:
      radial-gradient(circle at 84% 10%, rgba(124, 92, 255, .16), transparent 22rem),
      var(--hermes-obsidian);
    box-shadow: var(--hermes-shadow-workspace);
  }

  .trust-contact .eyebrow {
    color: #c9c1ff;
  }

  .trust-contact h2 {
    margin: .55rem 0 .8rem;
    color: #fff;
  }

  .trust-contact p {
    max-width: 680px;
    margin: 0;
    color: var(--hermes-muted-dark);
  }

  .trust-contact .button-primary {
    color: var(--hermes-ink);
    background: #fff;
  }

  .trust-contact .button-primary:hover,
  .trust-contact .button-primary:focus-visible {
    color: var(--hermes-ink);
    background: #f1f2f5;
  }

  @media (max-width: 760px) {
    .trust-hero {
      padding-top: 7.8rem;
    }

    .trust-hero::after {
      width: 280px;
      right: -150px;
      bottom: -115px;
    }

    .trust-content article {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 1.35rem;
    }

    .trust-contact {
      grid-template-columns: 1fr;
      align-items: start;
      border-radius: var(--hermes-radius-card);
    }

    .trust-contact .button-primary {
      width: 100%;
      justify-content: center;
    }
  }

  @media (forced-colors: active) {
    .trust-content article,
    .trust-contact,
    .trust-reviewed {
      border: 1px solid CanvasText;
    }
  }
</style>
