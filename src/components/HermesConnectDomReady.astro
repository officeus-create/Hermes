        "Fewer scheduling calls, easier appointments, customer history, more repeat bookings…": "Меньше звонков для согласования, проще запись, история клиентов, больше повторных обращений…"
      };

      const pluralRu = (value, one, few, many) => {
        const n = Math.abs(Number(value)) % 100;
        const last = n % 10;
        if (n > 10 && n < 20) return many;
        if (last === 1) return one;
        if (last >= 2 && last <= 4) return few;
        return many;
      };

      const translateDynamicRu = (value) => {
        if (locale !== "ru") return null;
        let match = value.match(/^(\d+) (service|services)$/i);
        if (match) return `${match[1]} ${pluralRu(match[1], "услуга", "услуги", "услуг")}`;
        match = value.match(/^(\d+) (booking|bookings)$/i);
        if (match) return `${match[1]} ${pluralRu(match[1], "запись", "записи", "записей")}`;
        match = value.match(/^(\d+) (customer|customers)$/i);
        if (match) return `${match[1]} ${pluralRu(match[1], "клиент", "клиента", "клиентов")}`;
        match = value.match(/^(\d+) (note|notes)$/i);
        if (match) return `${match[1]} ${pluralRu(match[1], "заметка", "заметки", "заметок")}`;
        match = value.match(/^(\d+) min$/i);
        if (match) return `${match[1]} мин`;
        match = value.match(/^(\d+) live (time|times) available\.$/i);
        if (match) return `Доступно ${match[1]} ${pluralRu(match[1], "время", "времени", "вариантов времени")}.`;
        return null;
      };

      const translateTree = (root = document.body) => {
        const baseTable = translations[locale] || {};
        const table = locale === "ru" && path.startsWith(repairRoot)
          ? { ...baseTable, ...ruRepairTranslations }
          : baseTable;
        if (locale === "en" || !root) return;
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        let node = walker.nextNode();
        while (node) {
          const raw = node.nodeValue || "";
          const normalized = raw.replace(/\s+/g, " ").trim();
          const translated = table[normalized] || translateDynamicRu(normalized);
          if (translated) {
            const leading = raw.match(/^\s*/)?.[0] || "";
            const trailing = raw.match(/\s*$/)?.[0] || "";
            node.nodeValue = `${leading}${translated}${trailing}`;
          }
          node = walker.nextNode();
        }
        root.querySelectorAll?.("input[placeholder], textarea[placeholder]").forEach((field) => {
          const current = field.getAttribute("placeholder");
          const translated = placeholders[locale]?.[current] || (locale === "ru" ? ruRepairPlaceholders[current] : undefined);
          if (translated) field.setAttribute("placeholder", translated);
        });
        root.querySelectorAll?.("[aria-label], [title]").forEach((node) => {
          for (const attr of ["aria-label", "title"]) {
            const current = node.getAttribute(attr);
            const translated = current ? table[current] : undefined;
            if (translated) node.setAttribute(attr, translated);
          }
        });
      };

      document.documentElement.lang = locale;

      // Preserve the current product route when navigating anywhere inside Hermes Connect.
      document.querySelectorAll('main a[href^="/services/hermes-connect/"]').forEach((link) => {
        const href = link.getAttribute("href");
        if (href) link.setAttribute("href", withLocale(href));
      });

      // Retired workspace links never become a second user-facing product path.
      document.querySelectorAll("main a[href]").forEach((link) => {
        const href = link.getAttribute("href");
        if (!href) return;
        let url;
        try { url = new URL(href, window.location.origin); } catch { return; }
        if (url.hostname !== legacyHost) return;
        const target = url.hash === "#apply"
          ? "/services/hermes-connect/repair-shops/auth/"
          : "/services/hermes-connect/repair-shops/";
        link.setAttribute("href", withLocale(target));
        link.setAttribute("data-hc-legacy-rewritten", "true");
        link.textContent = url.hash === "#apply" ? "Owner Login / Get Started" : "Open current Repair Shop product";
      });

      document.querySelectorAll(".connect-service-window-bar p, .mockup-header .window-url").forEach((node) => {
        if ((node.textContent || "").trim() === legacyHost) node.textContent = "hermeslogisticsus.com · Hermes Connect";
      });

      // Shared family navigation replaces page-specific floating/back-arrow navigation.
      document.querySelectorAll(
        ".repair-pilot-page .hero-header-nav, .auth-page > .auth-container > .back-link, .workspace-page > .shell > .back-link, .booking-page > .shell > .back-link, .availability-page > .shell > .back-link, .customers-page > .shell > .back-link",
      ).forEach((node) => node.remove());

      if (path.startsWith("/services/hermes-connect/repair-shops")) {
        const replacements = new Map([
          ["Outbound Commercial Pilot Beta", "Current Repair Shop Live Pilot"],
          ["Hermes Connect Beta", "Hermes Connect Repair Shops"],
          ["Live Booking Demo →", "Booking flow →"],
          ["Public Beta Release", "Current Repair Shop Live Pilot"],
          ["Sign in or register to manage your real shop services and upcoming booking tools.", "Sign in or register to manage your shop profile, services, availability, bookings, customers, and feedback."],
          ["Hermes Connect software is in free public beta. Repair services themselves are not advertised as free.", "Hermes Connect Repair Shops is the current live pilot. Repair service pricing is set by each participating shop."],
          ["One continuous booking window per day for this beta. Times are interpreted in your saved shop timezone.", "One continuous booking window per day. Times are interpreted in your saved shop timezone."],
          ["Customer bookable time slots will be generated from these hours and each service duration in the next production slice.", "Customer bookable time slots are generated from these hours and each service duration."],
        ]);
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        let node = walker.nextNode();
        while (node) {
          const raw = node.nodeValue || "";
          const normalized = raw.replace(/\s+/g, " ").trim();
          const replacement = replacements.get(normalized);
          if (replacement) {
            const leading = raw.match(/^\s*/)?.[0] || "";
            const trailing = raw.match(/\s*$/)?.[0] || "";
            node.nodeValue = `${leading}${replacement}${trailing}`;
          }
          node = walker.nextNode();
        }

        const registrationBio = document.querySelector("#reg-bio");
        if (registrationBio instanceof HTMLInputElement) {
          registrationBio.value = "Independent repair shop registered for the current Hermes Connect Repair Shop pilot.";
        }

        // Manager/referral links may request the correct auth tab directly without creating a second auth flow.
        if (normalizedPath === "/services/hermes-connect/repair-shops/auth") {
          const mode = new URLSearchParams(window.location.search).get("mode");
          if (mode === "register" || mode === "login") {
            const tab = document.querySelector(`[data-tab="${mode}"]`);
            if (tab instanceof HTMLButtonElement) tab.click();
          }
        }

        // Historical install-simulation controls must never survive on a Repair Shop page.
        document.querySelectorAll("[data-android-install-trigger], #btn-trigger-iphone-guide").forEach((button) => {
          const replacement = document.createElement("p");
          replacement.className = "hc-browser-install-note";
          replacement.textContent = "Use the current Hermes Connect product in your browser. No simulated native installation is reported as successful.";
          button.replaceWith(replacement);
        });

        if (locale === "ru") {
          const contentLanguage = document.querySelector(".hc-content-language");
          if (contentLanguage) contentLanguage.textContent = "Язык контента: русский";
          document.querySelectorAll("[data-hc-english-only]").forEach((notice) => notice.remove());
        }

        translateTree(document.body);

        // Owner workspace content is rendered asynchronously from real APIs. Keep language consistent
        // for newly inserted labels without creating separate localized pages or runtimes.
        if (locale !== "en") {
          const observer = new MutationObserver((mutations) => {
            for (const mutation of mutations) {
              mutation.addedNodes.forEach((added) => {
                if (added.nodeType === Node.ELEMENT_NODE) translateTree(added);
                else if (added.nodeType === Node.TEXT_NODE) {
                  const parent = added.parentElement;
                  if (parent) translateTree(parent);
                }
              });
            }
          });
          observer.observe(document.body, { childList: true, subtree: true });
        }
      }
    };

    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", run, { once: true });
    else run();
  })();
</script>

