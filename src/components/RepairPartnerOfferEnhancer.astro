---
const repairShopPath = "/services/hermes-connect/repair-shops";
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "");
const isRepairShopPage = normalizedPath === repairShopPath;
const isRepairShopSurface = isRepairShopPage || normalizedPath.startsWith(`${repairShopPath}/`);
const isRepairShopDashboard = normalizedPath === `${repairShopPath}/dashboard`;
---

{isRepairShopSurface && <script is:inline src="/repair-shop-capabilities.js"></script>}
{isRepairShopSurface && <script is:inline src="/repair-shop-form-clarity.js"></script>}
{isRepairShopDashboard && <script is:inline src="/repair-shop-operations.js"></script>}

{isRepairShopPage && (
  <>
    <template id="repair-partner-contact-template">
      <div class="repair-partner-contact-fields" data-repair-partner-contact-fields>
        <div class="repair-partner-contact-grid">
          <label class="repair-partner-contact-field">
            Contact Name
            <input type="text" id="partner-contact-name" autocomplete="name" maxlength="100" placeholder="Your name" required />
          </label>
          <label class="repair-partner-contact-field">
            Business Email
            <input type="email" id="partner-contact-email" autocomplete="email" maxlength="160" placeholder="you@shop.com" required />
          </label>
        </div>
        <label class="repair-partner-contact-field">
          Phone <span>optional</span>
          <input type="tel" id="partner-contact-phone" autocomplete="tel" maxlength="80" placeholder="+1 414 555 0100" />
        </label>
        <label class="repair-partner-consent">
          <input type="checkbox" id="partner-contact-consent" required />
          <span>I agree that Hermes may use this information to contact me about this Repair Shop Partner offer and pilot onboarding.</span>
        </label>
        <p class="repair-partner-privacy">Your offer is sent privately to Hermes Logistics for human review. Contact details and offer terms are not sent to public analytics. Sales attribution is handled separately in the protected server-side pilot layer.</p>
        <p class="repair-partner-delivery-status" data-repair-partner-delivery-status role="status" aria-live="polite" hidden></p>
      </div>
    </template>
    <script is:inline src="/repair-partner-offer.js"></script>
  </>
)}

<style is:global>
  .repair-partner-contact-fields{margin-top:20px;padding-top:18px;border-top:1px solid rgba(255,255,255,.1)}
  .repair-partner-contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .repair-partner-contact-field{display:flex;flex-direction:column;gap:8px;margin-bottom:14px;color:#dfe2ea;font-size:13px;font-weight:750}
  .repair-partner-contact-field span{color:#858b9a;font-size:11px;font-weight:600}
  .repair-partner-contact-field input{width:100%;box-sizing:border-box;border:1px solid rgba(255,255,255,.11);border-radius:12px;padding:12px 13px;background:#10121a;color:#fff;font:inherit;outline:none}
  .repair-partner-contact-field input:focus{border-color:#8f78ff;box-shadow:0 0 0 3px rgba(143,120,255,.12)}
  .repair-partner-consent{display:flex;align-items:flex-start;gap:10px;color:#d3d7e1;font-size:13px;line-height:1.5}
  .repair-partner-consent input{margin-top:3px}
  .repair-partner-privacy{margin:10px 0 0;color:#8f95a5;font-size:12px;line-height:1.5}
  .repair-partner-delivery-status{margin:12px 0 0;padding:11px 12px;border-radius:10px;background:rgba(180,42,42,.14);color:#ffc4c4;font-size:13px;line-height:1.45}
  .repair-partner-delivery-status[data-state="success"]{background:rgba(34,151,104,.14);color:#a8f1cf}
  .hc-optional-marker{display:inline-flex;width:max-content;margin-left:6px;padding:2px 6px;border-radius:999px;background:rgba(255,255,255,.055);color:#858b9a;font-size:10px;font-weight:700;line-height:1.35;text-transform:lowercase}
  .hc-form-help{display:block;margin-top:3px;color:#8f95a5;font-size:11px;font-weight:500;line-height:1.45}
  .hc-registration-next{margin:18px 0 0;padding:14px 15px;border:1px solid rgba(30,136,255,.18);border-radius:14px;background:rgba(30,136,255,.055);color:#dfe7f3}
  .hc-registration-next strong{display:block;font-size:13px}
  .hc-registration-next p{margin:6px 0 0;color:#a8b2c0;font-size:12px;line-height:1.55}
  .repair-offer-next-step{margin:14px 0 2px;padding:14px 15px;border:1px solid rgba(30,136,255,.18);border-radius:14px;background:rgba(30,136,255,.055);color:#e7edf6}
  .repair-offer-next-step strong{display:block;font-size:13px}
  .repair-offer-next-step ol{margin:8px 0 0;padding-left:20px;color:#aab4c3;font-size:12px;line-height:1.6}
  .repair-offer-field-help{display:block;margin:5px 0 0;color:#8f95a5;font-size:11px;font-weight:500;line-height:1.45}
  .repair-partner-fallback{display:inline-flex;margin-top:9px;color:#b8d8ff;font-size:12px;font-weight:800;text-decoration:underline;text-underline-offset:3px}
  @media(max-width:720px){.repair-partner-contact-grid{grid-template-columns:1fr}}
</style>