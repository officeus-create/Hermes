---
const repairShopPath = "/services/hermes-connect/repair-shops";
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "");
const isRepairShopPage = normalizedPath === repairShopPath;
const isRepairShopSurface = isRepairShopPage || normalizedPath.startsWith(`${repairShopPath}/`);
const isRepairShopDashboard = normalizedPath === `${repairShopPath}/dashboard`;

const repairGeoMarkets = [
  { name: "South Florida / Miami", tier: "P0", note: "First-wave automotive acquisition market" },
  { name: "Atlanta", tier: "P0", note: "First-wave automotive acquisition market" },
  { name: "Orlando / Central Florida", tier: "P0", note: "First-wave automotive acquisition market" },
  { name: "Chicago", tier: "P0", note: "First-wave automotive acquisition market" },
];
---

{isRepairShopSurface && <script is:inline src="/repair-shop-capabilities.js"></script>}
{isRepairShopSurface && <script is:inline src="/repair-shop-driver-discount.js"></script>}
{isRepairShopSurface && <script is:inline src="/repair-shop-form-clarity.js"></script>}
{isRepairShopDashboard && <script is:inline src="/repair-shop-operations.js"></script>}

{isRepairShopPage && (
  <>
    <template id="repair-partner-contact-template">
      <div class="repair-partner-contact-fields" data-repair-partner-contact-fields>
        <div class="repair-partner-contact-grid">
          <label class="repair-partner-contact-field">
            Contact Name
            <input type="text" id="partner-contact-name" autocomplete="name" maxlength="100" placeholder="Your name" required />
          </label>
          <label class="repair-partner-contact-field">
            Business Email
            <input type="email" id="partner-contact-email" autocomplete="email" maxlength="160" placeholder="you@shop.com" required />
          </label>
        </div>
        <label class="repair-partner-contact-field">
          Phone <span>optional</span>
          <input type="tel" id="partner-contact-phone" autocomplete="tel" maxlength="80" placeholder="+1 414 555 0100" />
        </label>
        <label class="repair-partner-consent">
          <input type="checkbox" id="partner-contact-consent" />
          <span>I agree that Hermes may use this information to contact me about this Repair Shop Partner offer and pilot onboarding.</span>
        </label>
        <p class="repair-partner-privacy">Your offer is sent privately to Hermes Logistics for human review. Contact details and offer terms are not sent to public analytics. Sales attribution is handled separately in the protected server-side pilot layer.</p>
        <p class="repair-partner-delivery-status" data-repair-partner-delivery-status role="status" aria-live="polite" hidden></p>
      </div>
    </template>
    <script is:inline src="/repair-partner-offer.js"></script>

    <section class="repair-geo-growth" aria-labelledby="repair-geo-growth-title">
      <div class="repair-geo-growth-shell">
        <p class="repair-geo-kicker">Hermes Connect · Automotive growth markets</p>
        <h2 id="repair-geo-growth-title">Set up the shop workflow where Hermes is concentrating automotive demand.</h2>
        <p class="repair-geo-intro">Hermes is using the same first-wave U.S. markets for car-hauling carrier acquisition, dealer transportation demand, and automotive-service growth. Repair businesses can register for Hermes Connect first, then separately review Local SEO, broader SEO, or website development when they need more customers to find the business online.</p>

        <div class="repair-geo-market-grid" aria-label="Current P0 automotive markets">
          {repairGeoMarkets.map((market) => (
            <article>
              <span>{market.tier}</span>
              <strong>{market.name}</strong>
              <small>{market.note}</small>
            </article>
          ))}
        </div>

        <p class="repair-geo-next"><strong>Next validation group:</strong> Phoenix, Houston, Los Angeles / Orange County, and Inland Empire.</p>
        <p class="repair-geo-fit"><strong>Current product-fit boundary:</strong> the Repair Shops workflow is represented for independent auto repair, truck / diesel repair, mobile mechanics, tire service, and body / collision businesses. Other automotive-service categories are not represented as supported until their workflow is reviewed against the product.</p>

        <div class="repair-geo-actions" aria-label="Repair shop growth actions">
          <a class="repair-geo-primary" href="/services/hermes-connect/repair-shops/auth/">Register / set up my shop</a>
          <a href="/services/local-seo/">Local SEO</a>
          <a href="/services/website-development/">Website development</a>
          <a href="/services/seo/">SEO services</a>
        </div>

        <small class="repair-geo-boundary">A priority market is an acquisition and measurement focus. It does not mean Hermes has a local office there and does not guarantee rankings, map visibility, bookings, customers, transportation volume, or revenue.</small>
      </div>
    </section>
  </>
)}

<style is:global>
  .repair-partner-contact-fields{margin-top:20px;padding-top:18px;border-top:1px solid rgba(255,255,255,.1)}
  .repair-partner-contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .repair-partner-contact-field{display:flex;flex-direction:column;gap:8px;margin-bottom:14px;color:#dfe2ea;font-size:13px;font-weight:750}
  .repair-partner-contact-field span{color:#858b9a;font-size:11px;font-weight:600}
  .repair-partner-contact-field input{width:100%;box-sizing:border-box;border:1px solid rgba(255,255,255,.11);border-radius:12px;padding:12px 13px;background:#10121a;color:#fff;font:inherit;outline:none}
  .repair-partner-contact-field input:focus{border-color:#8f78ff;box-shadow:0 0 0 3px rgba(143,120,255,.12)}
  .repair-partner-consent{display:flex;align-items:flex-start;gap:10px;color:#d3d7e1;font-size:13px;line-height:1.5}
  .repair-partner-consent input{margin-top:3px}
  .repair-partner-privacy{margin:10px 0 0;color:#8f95a5;font-size:12px;line-height:1.5}
  .repair-partner-delivery-status{margin:12px 0 0;padding:11px 12px;border-radius:10px;background:rgba(180,42,42,.14);color:#ffc4c4;font-size:13px;line-height:1.45}
  .repair-partner-delivery-status[data-state="success"]{background:rgba(34,151,104,.14);color:#a8f1cf}
  .hc-optional-marker{display:inline-flex;width:max-content;margin-left:6px;padding:2px 6px;border-radius:999px;background:rgba(255,255,255,.055);color:#858b9a;font-size:10px;font-weight:700;line-height:1.35;text-transform:lowercase}
  .hc-form-help{display:block;margin-top:3px;color:#8f95a5;font-size:11px;font-weight:500;line-height:1.45}
  .hc-registration-next{margin:18px 0 0;padding:14px 15px;border:1px solid color-mix(in srgb,var(--hermes-repair,#1e88ff) 18%,transparent);border-radius:14px;background:color-mix(in srgb,var(--hermes-repair,#1e88ff) 5.5%,transparent);color:#dfe7f3}
  .hc-registration-next strong{display:block;font-size:13px}
  .hc-registration-next p{margin:6px 0 0;color:#a8b2c0;font-size:12px;line-height:1.55}
  .repair-offer-next-step{margin:14px 0 2px;padding:14px 15px;border:1px solid color-mix(in srgb,var(--hermes-repair,#1e88ff) 18%,transparent);border-radius:14px;background:color-mix(in srgb,var(--hermes-repair,#1e88ff) 5.5%,transparent);color:#e7edf6}
  .repair-offer-next-step strong{display:block;font-size:13px}
  .repair-offer-next-step ol{margin:8px 0 0;padding-left:20px;color:#aab4c3;font-size:12px;line-height:1.6}
  .repair-offer-field-help{display:block;margin:5px 0 0;color:#8f95a5;font-size:11px;font-weight:500;line-height:1.45}
  .repair-partner-fallback{display:inline-flex;margin-top:9px;color:#b8d8ff;font-size:12px;font-weight:800;text-decoration:underline;text-underline-offset:3px}
  .repair-checkbox-grid label{display:flex;align-items:center;gap:9px;min-height:44px;box-sizing:border-box;padding:10px 12px;border:1px solid rgba(255,255,255,.10);border-radius:12px;background:rgba(255,255,255,.035);cursor:pointer;transition:border-color .16s ease,background .16s ease,box-shadow .16s ease}
  .repair-checkbox-grid label:hover{border-color:color-mix(in srgb,var(--hermes-repair,#1e88ff) 34%,transparent);background:color-mix(in srgb,var(--hermes-repair,#1e88ff) 6%,transparent)}
  .repair-checkbox-grid label:has(input:checked){border-color:color-mix(in srgb,var(--hermes-repair,#1e88ff) 55%,transparent);background:color-mix(in srgb,var(--hermes-repair,#1e88ff) 11%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--hermes-repair,#1e88ff) 14%,transparent)}
  .repair-checkbox-grid input[type="checkbox"]{width:18px;height:18px;flex:0 0 18px;accent-color:var(--hermes-repair,#1e88ff)}
  .repair-checkbox-grid label:focus-within{outline:3px solid color-mix(in srgb,var(--hermes-repair,#1e88ff) 22%,transparent);outline-offset:2px}
  .repair-geo-growth{position:relative;padding:70px 0;background:#090d16;color:#f8fafc;border-top:1px solid rgba(255,255,255,.08)}
  .repair-geo-growth-shell{width:min(1120px,calc(100% - 2rem));margin:0 auto}
  .repair-geo-kicker{margin:0 0 10px;color:color-mix(in srgb,var(--hermes-repair,#1e88ff) 72%,#fff);font-size:.76rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}
  .repair-geo-growth h2{max-width:820px;margin:0;font-size:clamp(2rem,4vw,3.4rem);line-height:1.05}
  .repair-geo-intro{max-width:850px;margin:18px 0 0;color:#aab4c3;font-size:1.03rem;line-height:1.7}
  .repair-geo-market-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:28px}
  .repair-geo-market-grid article{display:grid;gap:7px;min-height:128px;padding:18px;border:1px solid color-mix(in srgb,var(--hermes-repair,#1e88ff) 20%,transparent);border-radius:16px;background:color-mix(in srgb,var(--hermes-repair,#1e88ff) 5%,#0d111b)}
  .repair-geo-market-grid article>span{width:max-content;padding:4px 8px;border-radius:999px;background:color-mix(in srgb,var(--hermes-repair,#1e88ff) 16%,transparent);color:#d9ecff;font-size:.68rem;font-weight:900;letter-spacing:.08em}
  .repair-geo-market-grid strong{font-size:1rem;line-height:1.3}
  .repair-geo-market-grid small{align-self:end;color:#8f9aae;line-height:1.45}
  .repair-geo-next,.repair-geo-fit{max-width:900px;margin:18px 0 0;color:#aab4c3;line-height:1.65}
  .repair-geo-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
  .repair-geo-actions a{display:inline-flex;min-height:44px;align-items:center;justify-content:center;padding:10px 15px;border:1px solid rgba(255,255,255,.15);border-radius:12px;color:#eef5ff;font-size:.88rem;font-weight:800;text-decoration:none}
  .repair-geo-actions a:hover,.repair-geo-actions a:focus-visible{border-color:color-mix(in srgb,var(--hermes-repair,#1e88ff) 58%,transparent);background:color-mix(in srgb,var(--hermes-repair,#1e88ff) 10%,transparent)}
  .repair-geo-actions .repair-geo-primary{border-color:var(--hermes-repair,#1e88ff);background:var(--hermes-repair,#1e88ff);color:#fff}
  .repair-geo-boundary{display:block;max-width:920px;margin-top:18px;color:#778194;line-height:1.6}
  @media(max-width:900px){.repair-geo-market-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:720px){.repair-partner-contact-grid{grid-template-columns:1fr}.repair-geo-growth{padding:54px 0}.repair-geo-market-grid{grid-template-columns:1fr}.repair-geo-actions{display:grid}.repair-geo-actions a{width:100%;box-sizing:border-box}}
</style>