---
import { ArrowRight, ClipboardCheck, MapPin, Truck } from "@lucide/astro";

const priorityPages = [
  {
    href: "/logistics/appleton-wi-vehicle-transport/",
    eyebrow: "Appleton & Fox Valley",
    title: "Appleton vehicle transport",
    description: "Prepare a dealer, auction, business, or private vehicle move to or from Appleton, Wisconsin.",
    icon: MapPin,
    cta: "Plan Appleton vehicle transport",
  },
  {
    href: "/logistics/resources/auction-vehicle-pickup-checklist/",
    eyebrow: "Auction buyers and sellers",
    title: "Auction pickup checklist",
    description: "Confirm release, condition, facility access, storage deadlines, delivery details, and equipment needs.",
    icon: ClipboardCheck,
    cta: "Open pickup checklist",
  },
  {
    href: "/logistics/resources/car-hauler-capacity-checklist/",
    eyebrow: "Carriers and car haulers",
    title: "Capacity checklist",
    description: "Prepare equipment, available spaces, route, timing, authority, and vehicle-fit information for review.",
    icon: Truck,
    cta: "Open capacity checklist",
  },
] as const;
---

<section class="section home-logistics-discovery" aria-labelledby="home-logistics-discovery-title">
  <div class="shell">
    <div class="section-heading split-heading" data-reveal>
      <div>
        <p class="eyebrow">Current logistics guides</p>
        <h2 id="home-logistics-discovery-title">Plan a vehicle move or share carrier capacity.</h2>
      </div>
      <p>Start with a public guide before sharing private route, vehicle, authority, release, or contact information.</p>
    </div>

    <div class="home-logistics-discovery-grid" data-reveal>
      {priorityPages.map((page) => {
        const Icon = page.icon;
        return (
          <a href={page.href} class="home-logistics-discovery-card">
            <Icon size={27} aria-hidden="true" />
            <p class="eyebrow">{page.eyebrow}</p>
            <h3>{page.title}</h3>
            <p>{page.description}</p>
            <strong>{page.cta}<ArrowRight size={16} aria-hidden="true" /></strong>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .home-logistics-discovery{background:#f4f7fb}.home-logistics-discovery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.home-logistics-discovery-card{display:flex;min-height:100%;flex-direction:column;align-items:flex-start;padding:1.45rem;border:1px solid #dce3ee;border-radius:10px;background:#fff;color:inherit;text-decoration:none;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.home-logistics-discovery-card:hover,.home-logistics-discovery-card:focus-visible{transform:translateY(-3px);border-color:#96a7c7;box-shadow:0 14px 30px rgba(10,22,79,.09)}.home-logistics-discovery-card h3{margin:.35rem 0 .65rem;font-size:1.28rem}.home-logistics-discovery-card>p:not(.eyebrow){margin:0 0 1.1rem;color:#48536a}.home-logistics-discovery-card strong{display:flex;gap:.45rem;align-items:center;margin-top:auto;color:#0a164f}@media(max-width:820px){.home-logistics-discovery-grid{grid-template-columns:1fr}}
</style>
