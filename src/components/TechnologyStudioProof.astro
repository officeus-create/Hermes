---
import { ArrowRight, Bot, Braces, ChartNoAxesCombined, CircleDollarSign, Database, LayoutTemplate, Network, Palette, Search, Settings, ShieldCheck, UserRoundSearch, Users, Workflow } from "@lucide/astro";

const deliveryRoles = [
  { role: "Business direction", owner: "Client leadership", detail: "Goals, operating reality, priorities, and final decisions." },
  { role: "Product strategy", owner: "Product and content team", detail: "Business structure, service logic, customer journey, and delivery scope." },
  { role: "Engineering", owner: "Hermes IT Development", detail: "Architecture, implementation, testing, deployment, and technical handoff." },
  { role: "Independent review", owner: "Quality assurance", detail: "Accessibility, risk review, source checks, responsive behavior, and release readiness." },
];

const companySystemStages = [
  "Business and workflow map",
  "Corporate website and conversion journey",
  "CRM, roles, pipelines, and management views",
  "Automation and supported integrations",
  "AI assistants, knowledge, QA, and approval gates",
  "Launch, training, and controlled improvement cycles",
];

const digitalEmployees = [
  {
    role: "Digital Operations Director",
    timeline: "4-8 weeks",
    icon: Settings,
    description: "Coordinates priorities, task routing, SOP checks, management summaries, cross-team handoffs, and exception review.",
  },
  {
    role: "SEO & Content Intelligence Specialist",
    timeline: "2-4 weeks",
    icon: Search,
    description: "Monitors approved sources, prepares keyword maps, content briefs, optimization previews, and search-performance reviews.",
  },
  {
    role: "Finance Operations Assistant",
    timeline: "3-6 weeks",
    icon: CircleDollarSign,
    description: "Organizes invoice intake, reconciliation drafts, cash-flow summaries, document checks, and alerts without unsupervised payments.",
  },
  {
    role: "HR & Recruiting Assistant",
    timeline: "2-5 weeks",
    icon: UserRoundSearch,
    description: "Creates role drafts, structures candidate intake, prepares screening summaries, interview packs, and onboarding checklists.",
  },
  {
    role: "Sales Workflow Assistant",
    timeline: "3-6 weeks",
    icon: Users,
    description: "Supports lead qualification, CRM previews, follow-up drafts, sales scripts, pipeline summaries, and next-action reminders.",
  },
  {
    role: "Business Analyst",
    timeline: "2-5 weeks",
    icon: ChartNoAxesCombined,
    description: "Defines KPI, checks data quality, prepares dashboards, identifies operating patterns, and creates decision briefs.",
  },
  {
    role: "Design & Content Assistant",
    timeline: "2-5 weeks",
    icon: Palette,
    description: "Turns approved direction into briefs, content variants, organized assets, production checklists, and visual QA support.",
  },
  {
    role: "Department Operations Assistant",
    timeline: "3-6 weeks",
    icon: Workflow,
    description: "Adapts to a defined department role using its documents, tools, routing rules, approval gates, and performance standards.",
  },
];

const packages = [
  {
    name: "Digital Presence System",
    eyebrow: "Website and conversion path",
    price: "From $3k",
    timeline: "4-8 weeks",
    icon: LayoutTemplate,
    description: "A custom corporate website with content architecture, responsive development, deployment, analytics plan, and a clear path from attention to inquiry.",
    includes: ["Discovery and information architecture", "Custom responsive website", "Content and conversion workflow", "QA, launch, and handoff"],
  },
  {
    name: "CRM and Operations Control",
    eyebrow: "Internal operating system",
    price: "From $5k",
    timeline: "6-12 weeks",
    icon: Network,
    description: "A practical CRM or operations system shaped around real roles, statuses, approvals, documents, dashboards, and management decisions.",
    includes: ["Workflow and data model", "Roles, queues, and approvals", "Dashboards and management views", "Integrations and operating documentation"],
  },
  {
    name: "AI Assistant and Workflow",
    eyebrow: "Human-controlled intelligence",
    price: "From $3k",
    timeline: "3-8 weeks",
    icon: Bot,
    description: "An AI-assisted workflow for research, summaries, knowledge retrieval, task routing, quality checks, and draft actions with human approval gates.",
    includes: ["Structured business context", "Assistant and routing workflow", "Review and approval controls", "Logging, fallback, and team training"],
  },
  {
    name: "Connected Business Platform",
    eyebrow: "Website, CRM, automation, and AI",
    price: "From $8k",
    timeline: "8-16 weeks",
    icon: Braces,
    description: "A connected customer and operations platform combining the public experience with CRM, booking or payments, automation, AI assistance, and analytics.",
    includes: ["Customer-facing product", "CRM and internal workflows", "Automation and supported integrations", "AI assistance and decision visibility"],
  },
];
---

<section class="section technology-case" aria-labelledby="technology-case-title">
  <div class="shell technology-case-layout">
    <div class="technology-case-copy">
      <p class="eyebrow">Our first public product</p>
      <h2 id="technology-case-title">This website was built inside the system it represents.</h2>
      <p>Hermes IT Development combined human business direction with a coordinated AI-assisted delivery team. The result is not a generated template: it is a versioned product with original assets, responsive interactions, automated tests, independent review, and a live deployment workflow.</p>
      <div class="technology-case-principle">
        <ShieldCheck size={22} aria-hidden="true" />
        <div><strong>Human-led. AI-assisted. Continuously reviewable.</strong><span>AI accelerates research, implementation, and QA. People retain business judgment and final authority.</span></div>
      </div>
    </div>

    <div class="delivery-role-list" aria-label="Website delivery roles">
      {deliveryRoles.map((item, index) => (
        <article>
          <span>0{index + 1}</span>
          <div><p>{item.role}</p><h3>{item.owner}</h3><div>{item.detail}</div></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section digital-workforce" aria-labelledby="digital-workforce-title">
  <div class="shell">
    <div class="section-heading split-heading digital-workforce-heading">
      <div><p class="eyebrow">Digital workforce</p><h2 id="digital-workforce-title">A digital employee designed for each business role.</h2></div>
      <p>We configure each role around the company's SOP, source material, tools, decisions, and approval boundaries. Typical setup time begins after the required process knowledge and system access are ready.</p>
    </div>

    <div class="digital-employee-list">
      {digitalEmployees.map((employee, index) => {
        const Icon = employee.icon;
        return (
          <article>
            <span>0{index + 1}</span>
            <Icon size={23} aria-hidden="true" />
            <div><h3>{employee.role}</h3><p>{employee.description}</p></div>
            <div class="employee-training"><p>Setup & training</p><strong>{employee.timeline}</strong></div>
          </article>
        );
      })}
    </div>

    <div class="digital-workforce-cta">
      <div><Bot size={25} aria-hidden="true" /><p>Start with one role, test it in real work, then expand the digital team.</p></div>
      <a href="#contact" data-estimate-service="Digital Employee Program" aria-label="Request an estimate for Digital Employee Program">Design your digital team <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </div>
</section>

<section class="section technology-packages" aria-labelledby="technology-packages-title">
  <div class="shell">
    <div class="section-heading split-heading technology-packages-heading">
      <div><p class="eyebrow">One company. One coordinated build.</p><h2 id="technology-packages-title">Build the digital operating system a modern company needs.</h2></div>
      <p>We can begin with one useful module or take responsibility for the connected customer, operations, and AI foundation as a complete program. Delivery is planned at <strong>$25-$45 per hour</strong> or as an agreed fixed-scope package.</p>
    </div>

    <article class="flagship-package">
      <div class="flagship-package-heading">
        <span>Flagship company package</span>
        <Workflow size={30} aria-hidden="true" />
        <h3>Company Digital Operating System</h3>
        <p>For an established company that needs its public experience, sales process, operating data, automation, and AI-assisted work to function as one controlled system.</p>
      </div>
      <ol>
        {companySystemStages.map((stage, index) => <li><span>0{index + 1}</span>{stage}</li>)}
      </ol>
      <div class="flagship-package-estimate">
        <p><CircleDollarSign size={17} aria-hidden="true" />Program planning range</p>
        <strong>From $12k</strong>
        <span>12-24 weeks · staged delivery</span>
        <a href="#contact" data-estimate-service="Company Digital Operating System" aria-label="Request an estimate for Company Digital Operating System">Request company assessment <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </article>

    <div class="continuous-improvement-note">
      <Database size={24} aria-hidden="true" />
      <div><p>After launch · Continuous Improvement Partnership</p><h3>Improve the system through evidence, review, and controlled releases.</h3></div>
      <p>AI can surface opportunities, prepare recommendations, and assist QA. It does not rewrite production by itself: people approve priorities and every release is tested and documented.</p>
      <strong>From $3k / month</strong>
    </div>

    <div class="module-heading"><p class="eyebrow">Start with one module</p><h3>Build what removes the most friction first.</h3></div>

    <div class="technology-package-list">
      {packages.map((item, index) => {
        const Icon = item.icon;
        return (
          <article>
            <div class="package-identity">
              <span>0{index + 1}</span>
              <Icon size={24} aria-hidden="true" />
              <p>{item.eyebrow}</p>
              <h3>{item.name}</h3>
            </div>
            <div class="package-description">
              <p>{item.description}</p>
              <ul>{item.includes.map((included) => <li>{included}</li>)}</ul>
            </div>
            <div class="package-estimate">
              <p><CircleDollarSign size={17} aria-hidden="true" />Planning range</p>
              <strong>{item.price}</strong>
              <span>{item.timeline}</span>
              <a
                href="#contact"
                data-estimate-service={item.name}
                aria-label={`Request an estimate for ${item.name}`}
              >Request estimate <ArrowRight size={18} aria-hidden="true" /></a>
            </div>
          </article>
        );
      })}
    </div>
    <p class="pricing-note">USD starting prices, not binding quotes. Larger programs are divided into approved stages and estimated at $25-$45 per hour. Hosting, paid third-party services, data migration, compliance work, content production, and unusually complex integrations are estimated separately.</p>
  </div>
</section>

<script>
  const estimateLinks = document.querySelectorAll<HTMLAnchorElement>("[data-estimate-service]");
  const interest = document.querySelector<HTMLSelectElement>('[data-contact-form] select[name="path"]');
  const message = document.querySelector<HTMLTextAreaElement>('[data-contact-form] textarea[name="message"]');

  for (const link of estimateLinks) {
    link.addEventListener("click", () => {
      const service = link.dataset.estimateService;
      if (!service) return;
      if (interest) interest.value = "IT Development";
      if (message) {
        const request = `I would like a planning estimate for the ${service}.`;
        const current = message.value.trim();
        if (!current) message.value = request;
        else if (!current.includes(service)) message.value = `${request}\n\n${current}`;
      }
    });
  }
</script>
