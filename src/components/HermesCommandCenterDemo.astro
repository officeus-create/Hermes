---
const projects = [
  { department: "Operations", title: "Customer onboarding", purpose: "Move a qualified request through setup, review and activation.", progress: 75, state: "In progress", owner: "Operations team", next: "Review activation evidence" },
  { department: "Technology", title: "Website launch", purpose: "Coordinate content, implementation, QA and release without losing ownership.", progress: 50, state: "In progress", owner: "Technology team", next: "Complete mobile QA" },
  { department: "Sales", title: "Proposal follow-up", purpose: "Keep the responsible person, deadline and customer decision visible.", progress: 40, state: "Waiting", owner: "Sales team", next: "Record customer response" },
  { department: "Management", title: "Monthly operating review", purpose: "Connect project status, blockers and verified outcomes in one view.", progress: 25, state: "Planned", owner: "Business owner", next: "Collect source metrics" },
];
---

<section class="demo-portfolio" data-command-center-demo aria-labelledby="demo-portfolio-title">
  <div class="demo-heading"><div><p>Interactive product preview</p><h2 id="demo-portfolio-title">See projects, ownership and progress together</h2></div><span>Demo data only</span></div>
  <p class="demo-intro">This preview shows the structure a business can configure. It contains no Hermes internal projects, customer records or live operational data.</p>
  <div class="demo-stats"><article><span>Projects</span><strong>4</strong></article><article><span>Departments</span><strong>4</strong></article><article><span>Blocked</span><strong>0</strong></article><article><span>ETA</span><strong>Evidence-based</strong></article></div>
  <div class="demo-grid">
    {projects.map((project)=><article class="demo-card"><div class="demo-card-head"><div><span>{project.department}</span><h3>{project.title}</h3></div><b>{project.state}</b></div><p>{project.purpose}</p><div class="demo-progress"><div><span>Progress</span><strong>{project.progress}%</strong></div><div role="progressbar" aria-label={`${project.title} progress`} aria-valuemin="0" aria-valuemax="100" aria-valuenow={project.progress}><i style={`width:${project.progress}%`}></i></div></div><dl><div><dt>Owner</dt><dd>{project.owner}</dd></div><div><dt>Next</dt><dd>{project.next}</dd></div></dl></article>)}
  </div>
  <div class="demo-cta"><div><strong>Need this structure for your company?</strong><p>Start with a scoped project map, access roles and one measurable workflow.</p></div><a href="/contacts/?path=technology&utm_source=command_center_demo">Request a Command Center →</a></div>
</section>

<style>
.demo-portfolio{margin:0 0 clamp(3.5rem,6vw,5rem);padding:clamp(1.2rem,3vw,2rem);border:1px solid rgba(11,13,18,.09);border-radius:26px;background:rgba(255,255,255,.76);box-shadow:0 22px 65px rgba(42,32,90,.07)}.demo-heading{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.demo-heading p{margin:0 0 .45rem;color:#6956d6;font-size:.7rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.demo-heading h2{margin:0;font-size:clamp(1.7rem,3vw,2.5rem);letter-spacing:-.04em}.demo-heading>span{border:1px solid rgba(90,105,125,.18);border-radius:999px;padding:.42rem .65rem;color:#68707d;font-size:.7rem;font-weight:800}.demo-intro{max-width:760px;color:#68707d;line-height:1.6}.demo-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.7rem;margin:1.2rem 0}.demo-stats article{display:grid;gap:.2rem;border:1px solid rgba(11,13,18,.08);border-radius:16px;padding:.85rem;background:#fff}.demo-stats span{color:#7b8290;font-size:.68rem;text-transform:uppercase;letter-spacing:.07em}.demo-stats strong{font-size:1.1rem}.demo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.demo-card{border:1px solid rgba(11,13,18,.09);border-radius:18px;padding:1rem;background:#fff}.demo-card-head{display:flex;justify-content:space-between;gap:.7rem}.demo-card-head span{color:#7b8290;font-size:.67rem;text-transform:uppercase;letter-spacing:.07em}.demo-card h3{margin:.3rem 0 0}.demo-card-head b{height:max-content;border-radius:999px;background:#eef3ff;color:#325caa;padding:.3rem .5rem;font-size:.65rem}.demo-card>p{color:#68707d;line-height:1.5}.demo-progress>div:first-child{display:flex;justify-content:space-between;font-size:.75rem}.demo-progress>div:nth-child(2){height:7px;border-radius:999px;background:#edf1f6;overflow:hidden}.demo-progress i{display:block;height:100%;border-radius:inherit;background:#715de7}.demo-card dl{display:grid;gap:.35rem;margin:.85rem 0 0}.demo-card dl div{display:grid;grid-template-columns:60px 1fr;gap:.5rem}.demo-card dt{color:#7b8290;font-size:.72rem}.demo-card dd{margin:0;font-size:.76rem}.demo-cta{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:1rem;border-radius:18px;background:#0b0d12;color:#fff;padding:1rem}.demo-cta p{margin:.25rem 0 0;color:#bdc3cf;font-size:.82rem}.demo-cta a{flex:0 0 auto;border-radius:999px;background:#fff;color:#0b0d12;padding:.72rem .9rem;text-decoration:none;font-size:.8rem;font-weight:800}@media(max-width:760px){.demo-heading,.demo-cta{align-items:stretch;flex-direction:column}.demo-stats,.demo-grid{grid-template-columns:1fr 1fr}.demo-cta a{text-align:center}}@media(max-width:520px){.demo-stats,.demo-grid{grid-template-columns:1fr}.demo-heading>span{width:max-content}}
</style>

