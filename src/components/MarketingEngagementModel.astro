---
import { ArrowRight, Check } from "@lucide/astro";

const models = [
  {
    label: "01 · Diagnostic",
    title: "Find the first growth problem worth solving.",
    body: "Review the offer, audience, website, search visibility, channels, inquiry path, sales follow-up, evidence, and measurement. The result is a prioritized diagnosis and an implementation decision—not an automatic long-term engagement.",
    outputs: ["Primary bottleneck and buyer journey", "Priority pages, channels, and evidence gaps", "Recommended first working cycle"],
  },
  {
    label: "02 · Focused cycle",
    title: "Implement one connected commercial improvement.",
    body: "A limited cycle can focus on a landing page and conversion path, a search cluster, a content-distribution system, lead qualification, CRM handoff, or another defined bottleneck that can be reviewed as one piece of work.",
    outputs: ["Written deliverables and exclusions", "Approval points and accountable handoffs", "Validation and next-cycle recommendation"],
  },
  {
    label: "03 · Ongoing system",
    title: "Operate, measure, and improve the growth workflow.",
    body: "A continuing engagement may connect website, SEO, content, campaigns, qualification, sales follow-up, and reporting. The active channels and operating rhythm depend on the approved scope, access, budget, team capacity, and evidence available.",
    outputs: ["Agreed operating rhythm and responsibilities", "Privacy-safe measurement and review", "Changes based on actual results"],
  },
];
---

<section class="section marketing-engagement" aria-labelledby="marketing-engagement-title">
  <div class="shell">
    <div class="section-heading split-heading" data-reveal>
      <div><p class="eyebrow">How an engagement can begin</p><h2 id="marketing-engagement-title">Start with the level of commitment the problem actually requires.</h2></div>
      <p>Before work begins, the written scope confirms the objective, channels, deliverables, required access, evidence, exclusions, approvals, responsibilities, and fee.</p>
    </div>
    <div class="marketing-engagement-grid" data-reveal>
      {models.map((model) => <article><p class="model-label">{model.label}</p><h3>{model.title}</h3><p>{model.body}</p><ul>{model.outputs.map((output) => <li><Check size={18} aria-hidden="true" />{output}</li>)}</ul></article>)}
    </div>
    <div class="marketing-engagement-boundary" data-reveal>
      <div><strong>No automatic package or outcome promise.</strong><p>A diagnostic does not obligate the client to continue. Further work begins only after the applicable scope and commercial terms are accepted. Rankings, reach, inquiries, sales, revenue, ROI, and a fixed completion time are not guaranteed.</p></div>
      <a class="button button-primary" href="#contact">Discuss the right starting scope <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  .marketing-engagement{position:relative;overflow:hidden}.marketing-engagement::before{content:"";position:absolute;inset:5% -20% auto;height:28rem;background:radial-gradient(circle,rgba(227,82,176,.12),transparent 68%);pointer-events:none}.marketing-engagement>.shell{position:relative}.marketing-engagement-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:clamp(2rem,4vw,3.2rem)}.marketing-engagement-grid article{padding:clamp(1.3rem,3vw,1.85rem);border:1px solid rgba(227,82,176,.24);border-radius:1.35rem;background:linear-gradient(145deg,rgba(227,82,176,.09),transparent 48%),rgba(255,255,255,.035);box-shadow:0 1rem 2.8rem rgba(0,0,0,.08)}.model-label{margin:0 0 .8rem;color:rgb(227,82,176);font-size:.74rem;font-weight:760;letter-spacing:.12em;text-transform:uppercase}.marketing-engagement-grid h3{margin:0;font-size:clamp(1.3rem,2.2vw,1.75rem);line-height:1.12}.marketing-engagement-grid article>p:not(.model-label){margin:1rem 0 0;opacity:.76}.marketing-engagement-grid ul{display:grid;gap:.65rem;margin:1.3rem 0 0;padding:0;list-style:none}.marketing-engagement-grid li{display:grid;grid-template-columns:1.2rem 1fr;gap:.55rem}.marketing-engagement-grid li :global(svg){color:rgb(227,82,176)}.marketing-engagement-boundary{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.5rem;align-items:center;margin-top:1rem;padding:clamp(1.25rem,3vw,1.8rem);border:1px solid rgba(227,82,176,.22);border-radius:1.25rem;background:rgba(10,12,22,.52)}.marketing-engagement-boundary p{max-width:70rem;margin:.45rem 0 0;opacity:.74}@media(max-width:900px){.marketing-engagement-grid,.marketing-engagement-boundary{grid-template-columns:1fr}.marketing-engagement-boundary .button{width:fit-content}}
</style>
