---
const path = Astro.url.pathname.replace(/\/+$/, "/");
const projectsRoot = "/services/hermes-connect/internal/ai-connect/projects/";
const pageTitle = path === "/services/hermes-connect/internal/ai-assistant/"
  ? { en: "AI Assistant | Hermes Connect", ru: "ИИ-ассистент | Hermes Connect" }
  : path === projectsRoot
    ? { en: "Projects | AI Connect | Hermes Connect", ru: "Проекты | AI Connect | Hermes Connect" }
    : path.includes("/projects/hermes-connect-internal-ai-pilot/")
      ? { en: "Hermes Connect Internal AI Pilot | AI Connect", ru: "Внутренний ИИ-пилот Hermes Connect | AI Connect" }
      : { en: "AI Connect | Hermes Connect", ru: "AI Connect | Hermes Connect" };
const items = [
  { key: "overview", href: "/services/hermes-connect/internal/ai-connect/", en: "Overview", ru: "Обзор" },
  { key: "projects", href: projectsRoot, en: "Projects", ru: "Проекты" },
  { key: "assistant", href: "/services/hermes-connect/internal/ai-assistant/", en: "AI Assistant", ru: "ИИ-ассистент" },
];
const isCurrent = (item) => item.key === "projects" ? path.startsWith(projectsRoot) : path === item.href;
---
<section class="hc-internal-cabinet" data-hc-internal-cabinet data-title-en={pageTitle.en} data-title-ru={pageTitle.ru} data-aria-en="Hermes Connect internal cabinet" data-aria-ru="Внутренний кабинет Hermes Connect" aria-label="Hermes Connect internal cabinet" hidden>
  <div class="hc-internal-cabinet__top">
    <div class="hc-internal-cabinet__identity">
      <span class="hc-internal-cabinet__eyebrow">Hermes Connect</span>
      <strong data-en="Internal cabinet" data-ru="Внутренний кабинет">Internal cabinet</strong>
      <span class="hc-internal-cabinet__status" data-en="Owner workspace" data-ru="Рабочее пространство владельца">Owner workspace</span>
    </div>
    <div class="hc-internal-cabinet__utilities">
      <div class="hc-internal-language" data-aria-en="Cabinet language" data-aria-ru="Язык кабинета" aria-label="Cabinet language">
        <a href={path} data-locale-choice="en" lang="en">EN</a>
        <a href={`${path}?lang=ru`} data-locale-choice="ru" lang="ru">RU</a>
      </div>
      <a class="hc-internal-exit" href="/services/hermes-connect/" data-cabinet-exit data-en="Hermes Connect home" data-ru="На главную Hermes Connect">Hermes Connect home</a>
    </div>
  </div>
  <div class="hc-internal-cabinet__sections">
    <nav class="hc-internal-cabinet__nav" data-aria-en="Internal workspace sections" data-aria-ru="Разделы внутреннего кабинета" aria-label="Internal workspace sections">
      {items.map((item) => (
        <a href={item.href} aria-current={isCurrent(item) ? "page" : undefined} data-cabinet-link data-en={item.en} data-ru={item.ru}>{item.en}</a>
      ))}
    </nav>
  </div>
</section>

<script is:inline>
  (() => {
    const applyLocale = () => {
      const params = new URLSearchParams(window.location.search);
      let stored = "";
      try { stored = window.localStorage.getItem("hermes-connect-language") || ""; } catch {}
      const locale = params.get("lang") === "ru" || (!params.get("lang") && stored === "ru") ? "ru" : "en";
      document.documentElement.lang = locale;
      document.documentElement.dataset.internalCabinetLocale = locale;

      document.querySelectorAll("[data-en][data-ru]").forEach((node) => {
        const value = node.getAttribute(locale === "ru" ? "data-ru" : "data-en");
        if (value !== null) node.textContent = value;
      });
      document.querySelectorAll("[data-aria-en][data-aria-ru]").forEach((node) => {
        const value = node.getAttribute(locale === "ru" ? "data-aria-ru" : "data-aria-en");
        if (value !== null) node.setAttribute("aria-label", value);
      });
      document.querySelectorAll("[data-placeholder-en][data-placeholder-ru]").forEach((node) => {
        if (!(node instanceof HTMLInputElement || node instanceof HTMLTextAreaElement)) return;
        node.placeholder = node.getAttribute(locale === "ru" ? "data-placeholder-ru" : "data-placeholder-en") || "";
      });
      document.querySelectorAll("[data-cabinet-link]").forEach((node) => {
        if (!(node instanceof HTMLAnchorElement)) return;
        const next = new URL(node.getAttribute("href") || "", window.location.origin);
        if (locale === "ru") next.searchParams.set("lang", "ru");
        else next.searchParams.delete("lang");
        node.href = `${next.pathname}${next.search}`;
      });
      document.querySelectorAll("[data-cabinet-exit]").forEach((node) => {
        if (!(node instanceof HTMLAnchorElement)) return;
        const next = new URL(node.getAttribute("href") || "", window.location.origin);
        if (locale === "ru") next.searchParams.set("lang", "ru");
        else next.searchParams.delete("lang");
        node.href = `${next.pathname}${next.search}`;
      });
      document.querySelectorAll("[data-locale-choice]").forEach((node) => {
        if (!(node instanceof HTMLAnchorElement)) return;
        const target = node.dataset.localeChoice === "ru" ? "ru" : "en";
        const next = new URL(window.location.href);
        if (target === "ru") next.searchParams.set("lang", "ru");
        else next.searchParams.delete("lang");
        node.href = `${next.pathname}${next.search}${next.hash}`;
        if (target === locale) node.setAttribute("aria-current", "true");
        else node.removeAttribute("aria-current");
        node.addEventListener("click", () => {
          try { window.localStorage.setItem("hermes-connect-language", target); } catch {}
        }, { once: true });
      });

      const cabinet = document.querySelector("[data-hc-internal-cabinet]");
      if (cabinet instanceof HTMLElement) {
        const title = cabinet.getAttribute(locale === "ru" ? "data-title-ru" : "data-title-en");
        if (title) document.title = title;
      }
      if (locale === "ru") document.querySelector("[data-hc-english-only]")?.remove();
      window.dispatchEvent(new CustomEvent("hc-internal-locale-ready", { detail: { locale } }));
    };

    const revealForVerifiedOwner = async () => {
      try {
        const response = await fetch("/api/internal-ai/status", {
          credentials: "same-origin",
          headers: { Accept: "application/json" },
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok || !payload?.success) return;
        const cabinet = document.querySelector("[data-hc-internal-cabinet]");
        if (!(cabinet instanceof HTMLElement)) return;
        cabinet.hidden = false;
        document.body.classList.add("hc-internal-cabinet-mode");
      } catch {
        // Fail closed: direct visitors do not discover internal cabinet navigation
        // unless the server has already verified HERMES_INTERNAL_OWNER.
      }
    };

    const apply = () => {
      applyLocale();
      void revealForVerifiedOwner();
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", apply, { once: true });
    else apply();
  })();
</script>

<style is:global>
  .hc-internal-cabinet[hidden]{display:none!important}
  .hc-internal-cabinet-mode .site-header,
  .hc-internal-cabinet-mode [data-hc-product-context],
  .hc-internal-cabinet-mode [data-hc-intelligence-core],
  .hc-internal-cabinet-mode .site-footer{display:none!important}
  .hc-internal-cabinet{position:sticky;top:0;z-index:60;border-bottom:1px solid rgba(255,255,255,.1);background:rgba(13,19,32,.97);color:#eef4ff;box-shadow:0 10px 30px rgba(0,0,0,.22);backdrop-filter:blur(18px)}
  .hc-internal-cabinet__top,.hc-internal-cabinet__sections{width:min(1180px,calc(100% - 2rem));margin:0 auto}
  .hc-internal-cabinet__top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.78rem 0 .62rem}
  .hc-internal-cabinet__identity{display:grid;grid-template-columns:auto auto;column-gap:.65rem;row-gap:.1rem;align-items:center;min-width:0}
  .hc-internal-cabinet__eyebrow{grid-column:1/-1;color:#8fa0b8;font-size:.64rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}
  .hc-internal-cabinet__identity strong{font-size:1rem;color:#fff}
  .hc-internal-cabinet__status{font-size:.74rem;color:#9cabc0;padding-left:.65rem;border-left:1px solid rgba(255,255,255,.16)}
  .hc-internal-cabinet__utilities{display:flex;align-items:center;gap:.6rem}
  .hc-internal-language{display:flex;align-items:center;border:1px solid rgba(255,255,255,.12);border-radius:.6rem;padding:.14rem;background:rgba(255,255,255,.04)}
  .hc-internal-language a{min-width:2rem;text-align:center;padding:.33rem .4rem;border-radius:.45rem;text-decoration:none;color:#91a0b5;font-size:.72rem;font-weight:850}
  .hc-internal-language a[aria-current="true"]{background:#eef4ff;color:#0b1220}
  .hc-internal-exit{white-space:nowrap;color:#aeb9ca;text-decoration:none;border:1px solid rgba(255,255,255,.1);border-radius:.6rem;padding:.48rem .65rem;font-size:.76rem;font-weight:750}
  .hc-internal-exit:hover,.hc-internal-exit:focus-visible{color:#fff;border-color:rgba(255,255,255,.24)}
  .hc-internal-cabinet__sections{padding:0 0 .65rem}
  .hc-internal-cabinet__nav{display:flex;align-items:center;gap:.35rem;overflow-x:auto;scrollbar-width:none}
  .hc-internal-cabinet__nav::-webkit-scrollbar{display:none}
  .hc-internal-cabinet__nav a{white-space:nowrap;text-decoration:none;color:#aeb9ca;border:1px solid transparent;border-radius:.65rem;padding:.5rem .7rem;font-size:.8rem;font-weight:750}
  .hc-internal-cabinet__nav a:hover,.hc-internal-cabinet__nav a:focus-visible,.hc-internal-cabinet__nav a[aria-current="page"]{color:#fff;border-color:rgba(139,219,255,.28);background:rgba(139,219,255,.1)}
  @media(max-width:700px){.hc-internal-cabinet__top{align-items:flex-start}.hc-internal-cabinet__identity{display:flex;flex-wrap:wrap}.hc-internal-cabinet__eyebrow{width:100%}.hc-internal-cabinet__status{display:none}.hc-internal-cabinet__utilities{gap:.35rem}.hc-internal-exit{max-width:8.6rem;overflow:hidden;text-overflow:ellipsis}.hc-internal-cabinet__sections{padding-bottom:.55rem}}
</style>
