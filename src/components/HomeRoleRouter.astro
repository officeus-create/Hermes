---
import { ArrowRight, BriefcaseBusiness, GraduationCap, Megaphone, MonitorCog, PackageSearch, Truck } from "@lucide/astro";

const roles = [
  {
    id: "carrier",
    eyebrow: "Carrier / owner-operator",
    title: "I need car-hauling dispatch support",
    body: "Start with authority, insurance, equipment, capacity, operating area, availability, and a direct Logistics Sales handoff.",
    label: "Start dispatch review",
    href: "/logistics/start-car-hauling-dispatch/",
    icon: Truck,
  },
  {
    id: "dealer",
    eyebrow: "Dealer / auction buyer",
    title: "I need vehicles transported",
    body: "Prepare dealer inventory, auction pickup, dealer-to-dealer, open, enclosed, or multi-vehicle requirements.",
    label: "Review dealer transport",
    href: "/logistics/dealer-vehicle-transportation/",
    icon: PackageSearch,
  },
  {
    id: "shipper",
    eyebrow: "Shipper / logistics manager",
    title: "I need transportation coordination",
    body: "Choose the customer-side logistics path for vehicle moves, repeat requests, documentation, and capacity review.",
    label: "Open shipper path",
    href: "/logistics/shipper-dealer/",
    icon: BriefcaseBusiness,
  },
  {
    id: "seo",
    eyebrow: "Logistics company / dealer",
    title: "I need SEO or marketing",
    body: "Review specialist SEO for logistics, trucking, dispatch, freight-broker, and independent dealer businesses.",
    label: "Review logistics SEO",
    href: "/services/seo-for-logistics-companies/",
    icon: Megaphone,
  },
  {
    id: "technology",
    eyebrow: "Business owner / operations team",
    title: "I need a website or automation",
    body: "Prepare a website, redesign, CRM, workflow, AI automation, or systems-development project brief.",
    label: "Review technology services",
    href: "/services/website-development/",
    icon: MonitorCog,
  },
  {
    id: "academy",
    eyebrow: "Candidate / future specialist",
    title: "I want practical U.S.-market training",
    body: "Compare the U.S. Logistics Operations and Marketing programs, participation models, process, and application path.",
    label: "Explore the Academy",
    href: "/paths/academy/",
    icon: GraduationCap,
  },
];
---

<section class="home-role-router" aria-labelledby="home-role-router-title" data-home-role-router>
  <div class="shell">
    <div class="home-role-heading">
      <div>
        <p class="eyebrow">Start with your immediate goal</p>
        <h2 id="home-role-router-title">What do you need to do today?</h2>
      </div>
      <p>Choose your role first. The broader four-direction ecosystem remains below, but you do not need to understand every Hermes business before reaching the correct next step.</p>
    </div>

    <div class="home-role-grid">
      {roles.map((role) => {
        const Icon = role.icon;
        return (
          <a
            class="home-role-card"
            href={role.href}
            data-home-role-link
            data-role-id={role.id}
            data-destination-path={role.href}
          >
            <div class="home-role-card-top">
              <Icon size={25} aria-hidden="true" />
              <span>{role.eyebrow}</span>
            </div>
            <h3>{role.title}</h3>
            <p>{role.body}</p>
            <strong>{role.label}<ArrowRight size={17} aria-hidden="true" /></strong>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .home-role-router { padding: clamp(3.5rem, 7vw, 6rem) 0; background: #f5f7ff; color: #10204e; border-bottom: 1px solid #e1e6f4; }
  .home-role-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .72fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: end; margin-bottom: 2rem; }
  .home-role-heading h2 { max-width: 12ch; margin: .35rem 0 0; font-size: clamp(2.4rem, 5vw, 4.6rem); line-height: .98; letter-spacing: -.04em; }
  .home-role-heading > p { max-width: 56ch; margin: 0; color: #5f6d8e; line-height: 1.7; }
  .home-role-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .home-role-card { display: flex; min-height: 280px; flex-direction: column; padding: clamp(1.25rem, 2.5vw, 1.8rem); border: 1px solid #d8e0f3; border-radius: 12px; background: #fff; color: inherit; box-shadow: 0 16px 45px rgba(24, 43, 92, .06); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .home-role-card:hover { transform: translateY(-4px); border-color: #7864e8; box-shadow: 0 22px 55px rgba(24, 43, 92, .11); }
  .home-role-card:focus-visible { outline: 3px solid rgba(74, 92, 255, .3); outline-offset: 4px; }
  .home-role-card-top { display: flex; gap: .7rem; align-items: center; color: #5d47cf; }
  .home-role-card-top span { font-size: .78rem; font-weight: 800; letter-spacing: .055em; text-transform: uppercase; }
  .home-role-card h3 { margin: 1.3rem 0 .8rem; font-size: clamp(1.35rem, 2vw, 1.75rem); line-height: 1.15; }
  .home-role-card p { flex: 1; margin: 0 0 1.4rem; color: #64718f; line-height: 1.62; }
  .home-role-card strong { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding-top: 1rem; border-top: 1px solid #e5e9f4; font-size: .9rem; }
  @media (max-width: 960px) {
    .home-role-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .home-role-heading, .home-role-grid { grid-template-columns: 1fr; }
    .home-role-heading h2 { max-width: 10ch; }
    .home-role-card { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-role-card { transition: none; }
    .home-role-card:hover { transform: none; }
  }
</style>
