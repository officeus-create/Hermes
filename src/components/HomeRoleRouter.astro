---
import { ArrowRight, BriefcaseBusiness, GraduationCap, MonitorCog, PackageSearch, Truck } from "@lucide/astro";

const roles = [
  {
    id: "carrier",
    eyebrow: "Carrier / owner-operator",
    title: "I own a trucking company",
    body: "Review dispatch, load search, broker communication, paperwork, invoicing, and the operating support that fits the carrier's authority, equipment, and current availability.",
    label: "Review carrier support",
    href: "/logistics/start-car-hauling-dispatch/",
    icon: Truck,
    priority: "commercial",
  },
  {
    id: "transport",
    eyebrow: "Customer / dealer / shipper",
    title: "I need to move a vehicle",
    body: "Send the pickup and delivery markets, vehicle details, timing, condition, and contact information for a transportation review.",
    label: "Request vehicle transport",
    href: "/logistics/request-vehicle-transport/",
    icon: PackageSearch,
    priority: "commercial",
  },
  {
    id: "business",
    eyebrow: "Business owner / team",
    title: "I own a business",
    body: "Start with the business problem: more customers, a better website, SEO, social media, CRM, automation, or a clearer sales workflow.",
    label: "Choose a growth path",
    href: "/business-growth/",
    icon: MonitorCog,
    priority: "commercial",
  },
  {
    id: "academy",
    eyebrow: "Student / future specialist",
    title: "I want to learn",
    body: "Review practical Logistics and Marketing programs, how training works, what is expected, and how to apply.",
    label: "Explore the Academy",
    href: "/paths/academy/",
    icon: GraduationCap,
    priority: "opportunity",
  },
  {
    id: "career",
    eyebrow: "Candidate",
    title: "I want to work with Hermes",
    body: "See the current careers path, then apply with the experience, availability, languages, and measurable results that match the role.",
    label: "Review careers",
    href: "/logistics/careers/",
    icon: BriefcaseBusiness,
    priority: "opportunity",
  },
] as const;

const commercialRoles = roles.filter((role) => role.priority === "commercial");
const opportunityRoles = roles.filter((role) => role.priority === "opportunity");
---

<section class="home-role-router" id="start" aria-labelledby="home-role-router-title" data-home-role-router>
  <div class="shell">
    <div class="home-role-heading">
      <div>
        <p class="eyebrow">Start with the situation</p>
        <h2 id="home-role-router-title">What needs to happen next?</h2>
      </div>
      <p>Start with the job that needs to be done. Commercial requests are shown first; training and careers remain available without competing with the customer path.</p>
    </div>

    <div class="home-role-grid home-role-commercial-grid" aria-label="Commercial Hermes routes">
      {commercialRoles.map((role) => {
        const Icon = role.icon;
        return (
          <a
            class="home-role-card"
            href={role.href}
            data-home-role-link
            data-role-id={role.id}
            data-role-priority={role.priority}
            data-destination-path={role.href}
          >
            <div class="home-role-card-top">
              <Icon size={25} aria-hidden="true" />
              <span>{role.eyebrow}</span>
            </div>
            <h3>{role.title}</h3>
            <p>{role.body}</p>
            <strong>{role.label}<ArrowRight size={17} aria-hidden="true" /></strong>
          </a>
        );
      })}
    </div>

    <div class="home-role-secondary-block" aria-labelledby="home-opportunity-title">
      <div class="home-role-secondary-heading">
        <p class="eyebrow">Training & careers</p>
        <h3 id="home-opportunity-title">Looking for an opportunity with Hermes?</h3>
      </div>
      <div class="home-role-secondary-grid">
        {opportunityRoles.map((role) => {
          const Icon = role.icon;
          return (
            <a
              class="home-role-card home-role-secondary-card"
              href={role.href}
              data-home-role-link
              data-role-id={role.id}
              data-role-priority={role.priority}
              data-destination-path={role.href}
            >
              <div class="home-role-card-top">
                <Icon size={22} aria-hidden="true" />
                <span>{role.eyebrow}</span>
              </div>
              <div class="home-role-secondary-copy">
                <h3>{role.title}</h3>
                <p>{role.body}</p>
              </div>
              <strong>{role.label}<ArrowRight size={17} aria-hidden="true" /></strong>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .home-role-router { padding: clamp(3.5rem, 7vw, 6rem) 0; background: #f5f7ff; color: #10204e; border-bottom: 1px solid #e1e6f4; }
  .home-role-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .72fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: end; margin-bottom: 2rem; }
  .home-role-heading h2 { max-width: 12ch; margin: .35rem 0 0; font-size: clamp(2.4rem, 5vw, 4.6rem); line-height: .98; letter-spacing: -.04em; }
  .home-role-heading > p { max-width: 56ch; margin: 0; color: #5f6d8e; line-height: 1.7; }
  .home-role-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .home-role-card { display: flex; min-height: 280px; flex-direction: column; padding: clamp(1.25rem, 2.5vw, 1.8rem); border: 1px solid #d8e0f3; border-radius: 12px; background: #fff; color: inherit; box-shadow: 0 16px 45px rgba(24, 43, 92, .06); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .home-role-card:hover { transform: translateY(-4px); border-color: #7864e8; box-shadow: 0 22px 55px rgba(24, 43, 92, .11); }
  .home-role-card:focus-visible { outline: 3px solid rgba(74, 92, 255, .3); outline-offset: 4px; }
  .home-role-card-top { display: flex; gap: .7rem; align-items: center; color: #5d47cf; }
  .home-role-card-top span { font-size: .78rem; font-weight: 800; letter-spacing: .055em; text-transform: uppercase; }
  .home-role-card h3 { margin: 1.3rem 0 .8rem; font-size: clamp(1.35rem, 2vw, 1.75rem); line-height: 1.15; }
  .home-role-card p { flex: 1; margin: 0 0 1.4rem; color: #64718f; line-height: 1.62; }
  .home-role-card strong { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding-top: 1rem; border-top: 1px solid #e5e9f4; font-size: .9rem; }

  .home-role-secondary-block {
    display: grid;
    grid-template-columns: minmax(190px, .38fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 3.5rem);
    align-items: start;
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    padding-top: clamp(1.4rem, 3vw, 2rem);
    border-top: 1px solid var(--hermes-line-light);
  }

  .home-role-secondary-heading .eyebrow { margin-bottom: .45rem; color: var(--hermes-violet); }
  .home-role-secondary-heading h3 { max-width: 16ch; margin: 0; color: var(--hermes-ink); font-size: clamp(1.2rem, 2vw, 1.55rem); letter-spacing: -.025em; }
  .home-role-secondary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }

  .home-role-router .home-role-secondary-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: .75rem 1rem;
    min-height: 0;
    padding: 1.1rem 1.2rem;
    border-color: var(--hermes-line-light);
    border-radius: var(--hermes-radius-card);
    background: rgba(255,255,255,.58);
    box-shadow: none;
  }

  .home-role-router .home-role-secondary-card .home-role-card-top,
  .home-role-router .home-role-secondary-card .home-role-secondary-copy { grid-column: 1; }
  .home-role-router .home-role-secondary-card .home-role-card-top { color: var(--hermes-violet); }
  .home-role-router .home-role-secondary-card h3 { margin: .45rem 0 .35rem; font-size: 1.12rem; }
  .home-role-router .home-role-secondary-card p { margin: 0; color: var(--hermes-muted); font-size: .92rem; line-height: 1.5; }
  .home-role-router .home-role-secondary-card strong {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    min-width: 9rem;
    padding: 0 0 0 1rem;
    border-top: 0;
    border-left: 1px solid var(--hermes-line-light-soft);
    color: var(--hermes-ink);
  }
  .home-role-router .home-role-secondary-card:hover { transform: translateY(-2px); box-shadow: var(--hermes-shadow-card); }

  @media (max-width: 960px) {
    .home-role-commercial-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .home-role-secondary-block { grid-template-columns: 1fr; }
  }
  @media (max-width: 820px) {
    .home-role-commercial-grid { grid-template-columns: 1fr; }
    .home-role-secondary-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .home-role-heading { grid-template-columns: 1fr; }
    .home-role-heading h2 { max-width: 10ch; }
    .home-role-card { min-height: 0; }
    .home-role-router .home-role-secondary-card { grid-template-columns: 1fr; }
    .home-role-router .home-role-secondary-card strong {
      grid-column: 1;
      grid-row: auto;
      min-width: 0;
      padding: .85rem 0 0;
      border-top: 1px solid var(--hermes-line-light-soft);
      border-left: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-role-card { transition: none; }
    .home-role-card:hover { transform: none; }
  }
</style>
