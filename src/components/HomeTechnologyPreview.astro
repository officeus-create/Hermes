---
import { ArrowRight, Bot, CalendarDays, Network, Truck } from "@lucide/astro";
import technologyCssUrl from "../styles/features/technology.css?url";
import "../styles/features/home-connect-bridge.css";

const systems = [
  { title: "AI Assistants", body: "Company knowledge, Telegram workflows, structured tasks, and human-controlled actions.", icon: Bot },
  { title: "CRM & Automation", body: "Intake, validation, pipelines, review queues, dashboards, and approved integrations.", icon: Network },
  { title: "Logistics Technology", body: "Carrier intelligence, route risk, dispatch visibility, and Load Board workflows.", icon: Truck },
  {
    title: "Hermes Connect",
    body: "A category-aware Web App for services, availability, and a clear client request path.",
    icon: CalendarDays,
    href: "/services/hermes-connect/",
  },
];
---

<template data-home-technology-styles>
  <link rel="stylesheet" href={technologyCssUrl} />
</template>
<noscript>
  <link rel="stylesheet" href={technologyCssUrl} />
</noscript>

<section class="section home-technology-preview" aria-labelledby="home-technology-title" data-home-technology-section>
  <div class="shell">
    <div class="section-heading split-heading" data-reveal>
      <div><p class="eyebrow">Digital systems we build</p><h2 id="home-technology-title">Start with one workflow. Build the connected system around it.</h2></div>
      <p>Hermes designs custom AI, CRM, automation, logistics, recruiting, marketing, and customer-facing products in controlled stages.</p>
    </div>
    <div class="home-technology-grid" data-reveal>
      {systems.map((system) => {
        const Icon = system.icon;
        return (
          <article class={system.href ? "home-connect-product-card" : undefined}>
            <Icon size={22} aria-hidden="true" />
            <h3>{system.title}</h3>
            <p>{system.body}</p>
            {system.href && <a class="home-connect-product-link" href={system.href}>Explore Hermes Connect <ArrowRight size={16} aria-hidden="true" /></a>}
          </article>
        );
      })}
    </div>
    <a class="home-technology-link" href="/paths/technology/#capabilities">Explore IT & Development solutions <ArrowRight size={18} aria-hidden="true" /></a>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>("[data-home-technology-section]");
  const template = document.querySelector<HTMLTemplateElement>("[data-home-technology-styles]");
  let loaded = false;

  const loadHomeTechnologyStyles = () => {
    if (loaded || !template) return;
    loaded = true;
    document.head.append(template.content.cloneNode(true));
    template.remove();
  };

  if (!section || !template || !("IntersectionObserver" in window)) {
    loadHomeTechnologyStyles();
  } else {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      loadHomeTechnologyStyles();
      observer.disconnect();
    }, { rootMargin: "1600px 0px" });
    observer.observe(section);
  }
</script>
