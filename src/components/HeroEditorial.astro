---
import { ArrowDown, ArrowUpRight } from "@lucide/astro";
import { Picture } from "astro:assets";
import heroImage from "../assets/hermes-ecosystem-hero.jpg";
import { site } from "../data/site";
---

<section class="hero" id="top" data-motion-hero>
  <div class="hero-content shell">
    <div class="home-hero-copy">
      <p class="eyebrow hero-eyebrow">{site.hero.eyebrow}</p>
      <h1 class="hero-title" aria-label={site.hero.title}>
        <span class="hero-title-office" aria-hidden="true">Four directions.</span>
        <span class="hero-title-script" aria-hidden="true">One way forward.</span>
      </h1>
      <p class="hero-copy">{site.hero.body}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#start">
          Find the right next step
          <ArrowDown size={18} aria-hidden="true" />
        </a>
        <a class="button button-ghost" href={site.hero.secondaryCta.href}>
          {site.hero.secondaryCta.label}
          <ArrowUpRight size={18} aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="home-hero-stage" aria-label="Hermes ecosystem visual">
      <div class="hero-media">
        <Picture
          src={heroImage}
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="(max-width: 1040px) 100vw, 55vw"
          alt={site.hero.imageAlt}
          priority
          quality="high"
          pictureAttributes={{ style: "display:block;width:100%;height:100%;" }}
        />
      </div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="home-intelligence-knot" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
    </div>
  </div>

  <a class="hero-scroll-cue" href="#start" aria-label="Scroll to find the right Hermes next step">
    <span>Start with your situation</span>
    <ArrowDown size={18} aria-hidden="true" />
  </a>
</section>

<style>
  /* The legacy global hero used a viewport-height, bottom-aligned content wrapper and
     nowrap display lines. The Pearl editorial hero must explicitly release those
     constraints or the headline collides with the visual stage and clips on mobile. */
  .hero-content {
    min-height: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  .hero-title,
  .hero-title-office,
  .hero-title-script {
    max-width: 100%;
    min-width: 0;
  }

  .hero-title-office,
  .hero-title-script {
    width: auto !important;
    white-space: normal !important;
    overflow-wrap: normal;
  }

  @media (max-width: 720px) {
    .hero-title {
      font-size: clamp(3.15rem, 14.5vw, 4.55rem) !important;
      line-height: .9 !important;
      letter-spacing: -.06em !important;
    }
  }
</style>