---
import { ArrowDown, ArrowUpRight } from "@lucide/astro";
import { site } from "../data/site";

const humanHero = {
  eyebrow: "Logistics · Marketing · Academy · Technology",
  title: "Start with what you need. Go straight to the right team.",
  body: "Need to move a vehicle, keep a truck working, bring in more customers, build a website or automation, learn a practical skill, or work with Hermes? Choose the situation and go straight to the next step.",
  primaryCta: {
    label: "Choose what you need",
    href: "#start",
  },
  secondaryCta: {
    label: "See all four directions",
    href: "#paths",
  },
};
---

<section class="hero" id="top" data-motion-hero>
  <div class="hero-media">
    <img src={site.hero.image} alt={site.hero.imageAlt} width="1920" height="1080" loading="eager" fetchpriority="high" sizes="100vw" />
  </div>
  <div class="hero-shade"></div>
  <div class="hero-content shell">
    <p class="eyebrow hero-eyebrow">{humanHero.eyebrow}</p>
    <h1 class="hero-title" aria-label={humanHero.title}>
      <span class="hero-title-office" aria-hidden="true">Start with what you need.</span>
      <em class="hero-title-script" aria-hidden="true">Go straight to the right team.</em>
    </h1>
    <p class="hero-copy">{humanHero.body}</p>
    <div class="hero-actions">
      <a class="button button-primary" href={humanHero.primaryCta.href}>
        {humanHero.primaryCta.label}
        <ArrowDown size={18} aria-hidden="true" />
      </a>
      <a class="button button-ghost" href={humanHero.secondaryCta.href}>
        {humanHero.secondaryCta.label}
        <ArrowUpRight size={18} aria-hidden="true" />
      </a>
    </div>
  </div>
  <a class="hero-scroll-cue" href="#start" aria-label="Choose what you need from Hermes">
    <span>Choose what you need</span>
    <ArrowDown size={18} aria-hidden="true" />
  </a>
</section>
