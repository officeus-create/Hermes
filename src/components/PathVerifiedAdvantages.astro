---
import { CheckCircle2 } from "@lucide/astro";

interface Props {
  pathId: string;
}

type Advantage = {
  title: string;
  body: string;
};

type AdvantageSet = {
  label: string;
  title: string;
  intro: string;
  tone: "violet" | "magenta" | "gold" | "cyan";
  items: Advantage[];
};

const advantageSets: Record<string, AdvantageSet> = {
  logistics: {
    label: "Verified operating advantages",
    title: "Control, qualification, and follow-through stay visible.",
    intro:
      "The public Hermes Logistics model is built around carrier approval, defined operating needs, and coordinated support across dispatch and back-office work.",
    tone: "violet",
    items: [
      {
        title: "Carrier approval stays explicit.",
        body: "Load decisions and communication rules are confirmed with the carrier during onboarding rather than assumed by a generic dispatch process.",
      },
      {
        title: "Dispatch and back office connect.",
        body: "Broker communication, rate negotiation, setup packets, insurance-certificate coordination, invoicing, and follow-through can be reviewed as one operating scope.",
      },
      {
        title: "The review begins with real operating details.",
        body: "Authority, insurance, equipment, trailer configuration, lanes, availability, and the requested service scope are checked before a working plan is confirmed.",
      },
    ],
  },
  marketing: {
    label: "Verified growth advantages",
    title: "The channels connect to one business objective.",
    intro:
      "ProgressoPro treats positioning, website conversion, search, social media, qualification, follow-up, and measurement as connected parts of the same growth workflow.",
    tone: "magenta",
    items: [
      {
        title: "The business problem comes first.",
        body: "Work begins with the selected outcome, audience, current constraints, and the point where the existing customer journey loses momentum.",
      },
      {
        title: "Traffic has a defined next step.",
        body: "Website pages, SEO, social content, lead qualification, CRM handoff, and follow-up can be planned around one practical conversion path.",
      },
      {
        title: "The next cycle uses actual results.",
        body: "Reporting and review are used to refine the message, workflow, and priorities without promising a guaranteed ranking or lead volume.",
      },
    ],
  },
  academy: {
    label: "Verified learning advantages",
    title: "Learning connects to practical responsibility.",
    intro:
      "Hermes Business Academy is organized around applied learning in logistics, marketing, and operational leadership rather than a generic library of disconnected courses.",
    tone: "gold",
    items: [
      {
        title: "Three professional paths are visible.",
        body: "Learners can explore Logistics Operations, Marketing Worldwide, or the COO / Operational Director direction according to the responsibility they want to build.",
      },
      {
        title: "The model progresses toward application.",
        body: "Programs move from awareness to understanding and then to practice, correction, and performance of a defined responsibility.",
      },
      {
        title: "Training stays tied to operating work.",
        body: "Public program scope connects learning to communication, documents, decisions, KPI, processes, and the standards used inside business operations.",
      },
    ],
  },
  technology: {
    label: "Verified system advantages",
    title: "The operating problem comes before the tool.",
    intro:
      "Hermes IT Development scopes websites, CRM, automation, dashboards, and AI-assisted workflows around a defined business process and a useful first release.",
    tone: "cyan",
    items: [
      {
        title: "Existing tools are considered first.",
        body: "The goal is to connect the current workflow where practical instead of adding another isolated system without a clear owner or purpose.",
      },
      {
        title: "Important decisions keep human review.",
        body: "Automation and AI-assisted steps are designed with responsibility, permissions, and review boundaries for decisions that still require accountability.",
      },
      {
        title: "A measurable first workflow reduces risk.",
        body: "The public delivery model begins with one defined problem and a controlled first release before a broader system is considered.",
      },
    ],
  },
};

const { pathId } = Astro.props;
const set = advantageSets[pathId];
---

{set && (
  <section class={`section path-advantages path-advantages-${set.tone}`} aria-labelledby={`path-advantages-${pathId}`}>
    <div class="shell path-advantages-layout">
      <div class="path-advantages-heading" data-reveal>
        <div class="path-advantages-signal" aria-hidden="true"><span></span></div>
        <p class="eyebrow">{set.label}</p>
        <h2 id={`path-advantages-${pathId}`}>{set.title}</h2>
        <p>{set.intro}</p>
      </div>

      <div class="path-advantages-grid" data-reveal>
        {set.items.map((item, index) => (
          <article style={`--advantage-delay: ${index * 1.1}s`}>
            <CheckCircle2 size={20} stroke-width={1.8} aria-hidden="true" />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .path-advantages {
    --advantage-accent: 129, 105, 255;
    position: relative;
    overflow: hidden;
  }

  .path-advantages-violet { --advantage-accent: 129, 105, 255; }
  .path-advantages-magenta { --advantage-accent: 227, 82, 176; }
  .path-advantages-gold { --advantage-accent: 229, 179, 81; }
  .path-advantages-cyan { --advantage-accent: 65, 190, 216; }

  .path-advantages::before {
    content: "";
    position: absolute;
    inset: 10% -15% auto;
    height: 26rem;
    background: radial-gradient(circle, rgba(var(--advantage-accent), 0.1), transparent 70%);
    pointer-events: none;
  }

  .path-advantages-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .path-advantages-heading {
    position: sticky;
    top: 7rem;
    max-width: 38rem;
  }

  .path-advantages-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 4.8vw, 4rem);
    line-height: 1.02;
  }

  .path-advantages-heading > p:last-child {
    margin: 1.15rem 0 0;
    max-width: 39rem;
    opacity: 0.76;
  }

  .path-advantages-signal {
    position: relative;
    width: 0.8rem;
    height: 0.8rem;
    margin-bottom: 1.4rem;
    border-radius: 999px;
    background: rgb(var(--advantage-accent));
    box-shadow: 0 0 1.3rem rgba(var(--advantage-accent), 0.72);
  }

  .path-advantages-signal span {
    position: absolute;
    inset: -0.48rem;
    border: 1px solid rgba(var(--advantage-accent), 0.52);
    border-radius: inherit;
    animation: path-advantage-pulse 4.8s ease-out infinite;
  }

  .path-advantages-grid {
    display: grid;
    gap: 0.9rem;
  }

  .path-advantages-grid article {
    position: relative;
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    column-gap: 0.85rem;
    padding: clamp(1.25rem, 3vw, 1.8rem);
    border: 1px solid rgba(var(--advantage-accent), 0.22);
    border-radius: 1.25rem;
    background:
      linear-gradient(145deg, rgba(var(--advantage-accent), 0.085), transparent 48%),
      rgba(255, 255, 255, 0.035);
    box-shadow: 0 1rem 2.8rem rgba(0, 0, 0, 0.08);
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .path-advantages-grid article::after {
    content: "";
    position: absolute;
    top: 1.35rem;
    right: 1.35rem;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: rgba(var(--advantage-accent), 0.72);
    box-shadow: 0 0 0.9rem rgba(var(--advantage-accent), 0.5);
    animation: path-advantage-card-pulse 5.4s ease-in-out infinite;
    animation-delay: var(--advantage-delay);
  }

  .path-advantages-grid article:hover,
  .path-advantages-grid article:focus-within {
    border-color: rgba(var(--advantage-accent), 0.48);
    transform: translateY(-0.18rem);
    box-shadow: 0 1.25rem 3.2rem rgba(0, 0, 0, 0.13), 0 0 2rem rgba(var(--advantage-accent), 0.07);
  }

  .path-advantages-grid :global(svg) {
    margin-top: 0.15rem;
    color: rgb(var(--advantage-accent));
  }

  .path-advantages-grid h3 {
    margin: 0;
    padding-right: 1.5rem;
    font-size: clamp(1.16rem, 2vw, 1.45rem);
  }

  .path-advantages-grid p {
    grid-column: 2;
    margin: 0.55rem 0 0;
    opacity: 0.75;
  }

  @keyframes path-advantage-pulse {
    0%, 56% { opacity: 0; transform: scale(0.72); }
    67% { opacity: 0.72; }
    88%, 100% { opacity: 0; transform: scale(1.9); }
  }

  @keyframes path-advantage-card-pulse {
    0%, 68%, 100% { opacity: 0.38; transform: scale(0.85); }
    78% { opacity: 1; transform: scale(1.15); }
  }

  @media (max-width: 860px) {
    .path-advantages-layout {
      grid-template-columns: 1fr;
    }

    .path-advantages-heading {
      position: static;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .path-advantages-signal span,
    .path-advantages-grid article::after {
      animation: none;
      opacity: 0.45;
      transform: none;
    }

    .path-advantages-grid article {
      transition: none;
    }
  }
</style>
