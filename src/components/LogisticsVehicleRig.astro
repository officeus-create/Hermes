---
interface Props {
  className?: string;
}
const { className = "" } = Astro.props;
---

<svg class={`logistics-vehicle-rig ${className}`} viewBox="0 0 56 150" aria-hidden="true" focusable="false">
  <g class="logistics-vehicle-state logistics-vehicle-car-hauler">
    <path class="rig-deck rig-open" d="M12 7H44V112H12Z" />
    <path class="rig-rail" d="M16 9V109M40 9V109" />
    <g class="rig-cars">
      <rect x="19" y="14" width="18" height="22" rx="5" />
      <rect x="19" y="43" width="18" height="22" rx="5" />
      <rect x="19" y="72" width="18" height="22" rx="5" />
    </g>
    <path class="rig-cab" d="M16 116H40Q45 116 46 124V143Q46 148 41 148H15Q10 148 10 143V124Q11 116 16 116Z" />
    <path class="rig-glass" d="M16 122H40L37 133H19Z" />
    <path class="rig-bumper" d="M15 145H41" />
  </g>

  <g class="logistics-vehicle-state logistics-vehicle-dry-van">
    <rect class="rig-box" x="9" y="6" width="38" height="108" rx="5" />
    <path class="rig-roof" d="M13 13H43M13 105H43" />
    <path class="rig-cab" d="M16 117H40Q45 117 46 125V143Q46 148 41 148H15Q10 148 10 143V125Q11 117 16 117Z" />
    <path class="rig-glass" d="M16 123H40L37 134H19Z" />
  </g>

  <g class="logistics-vehicle-state logistics-vehicle-reefer">
    <rect class="rig-box" x="9" y="11" width="38" height="103" rx="5" />
    <rect class="rig-reefer-unit" x="13" y="4" width="30" height="13" rx="4" />
    <path class="rig-vent" d="M18 9H38M18 12H38" />
    <path class="rig-cab" d="M16 117H40Q45 117 46 125V143Q46 148 41 148H15Q10 148 10 143V125Q11 117 16 117Z" />
    <path class="rig-glass" d="M16 123H40L37 134H19Z" />
  </g>

  <g class="logistics-vehicle-state logistics-vehicle-flatbed">
    <rect class="rig-flatbed" x="10" y="22" width="36" height="91" rx="3" />
    <rect class="rig-load" x="15" y="34" width="26" height="22" rx="4" />
    <rect class="rig-load" x="15" y="64" width="26" height="28" rx="4" />
    <path class="rig-straps" d="M13 44H43M13 79H43" />
    <path class="rig-cab" d="M16 117H40Q45 117 46 125V143Q46 148 41 148H15Q10 148 10 143V125Q11 117 16 117Z" />
    <path class="rig-glass" d="M16 123H40L37 134H19Z" />
  </g>

  <g class="logistics-vehicle-state logistics-vehicle-step-deck">
    <path class="rig-stepdeck" d="M10 9H46V64H40V111H16V64H10Z" />
    <rect class="rig-machine" x="16" y="24" width="24" height="29" rx="5" />
    <circle class="rig-machine-wheel" cx="20" cy="55" r="4" />
    <circle class="rig-machine-wheel" cx="36" cy="55" r="4" />
    <path class="rig-cab" d="M16 117H40Q45 117 46 125V143Q46 148 41 148H15Q10 148 10 143V125Q11 117 16 117Z" />
    <path class="rig-glass" d="M16 123H40L37 134H19Z" />
  </g>

  <g class="logistics-vehicle-state logistics-vehicle-hotshot">
    <rect class="rig-hotshot-deck" x="13" y="20" width="30" height="82" rx="3" />
    <rect class="rig-hotshot-load" x="17" y="34" width="22" height="35" rx="6" />
    <path class="rig-pickup" d="M13 105H43V122H47V143Q47 148 42 148H14Q9 148 9 143V123H13Z" />
    <path class="rig-glass" d="M15 124H41L38 135H18Z" />
    <path class="rig-bed-line" d="M14 111H42" />
  </g>

  <g class="rig-wheels" aria-hidden="true">
    <rect x="6" y="28" width="5" height="16" rx="2" />
    <rect x="45" y="28" width="5" height="16" rx="2" />
    <rect x="6" y="82" width="5" height="16" rx="2" />
    <rect x="45" y="82" width="5" height="16" rx="2" />
    <rect x="7" y="125" width="4" height="14" rx="2" />
    <rect x="45" y="125" width="4" height="14" rx="2" />
  </g>
</svg>

<style>
  .logistics-vehicle-rig {
    display:block;
    width:100%;
    height:100%;
    overflow:visible;
    filter:drop-shadow(0 5px 7px rgba(4,19,29,.42));
  }
  .logistics-vehicle-state {
    opacity:0;
    transition:opacity .55s ease;
    pointer-events:none;
  }
  .rig-box,.rig-cab,.rig-flatbed,.rig-stepdeck,.rig-hotshot-deck,.rig-pickup {
    fill:#eef4f7;
    stroke:rgba(255,255,255,.92);
    stroke-width:1.2;
    vector-effect:non-scaling-stroke;
  }
  .rig-open { fill:rgba(34,53,64,.28); stroke:#dce9ee; stroke-width:1.4; vector-effect:non-scaling-stroke; }
  .rig-rail,.rig-roof,.rig-vent,.rig-straps,.rig-bumper,.rig-bed-line {
    fill:none;
    stroke:rgba(44,72,88,.72);
    stroke-width:1.2;
    stroke-linecap:round;
    vector-effect:non-scaling-stroke;
  }
  .rig-glass { fill:#31586f; opacity:.95; }
  .rig-cars rect { fill:#7f9aa8; stroke:#d9e4e8; stroke-width:.7; vector-effect:non-scaling-stroke; }
  .rig-load { fill:#806d56; stroke:#d3c0a5; stroke-width:.8; vector-effect:non-scaling-stroke; }
  .rig-reefer-unit { fill:#dce7eb; stroke:#f8fbfc; stroke-width:1; vector-effect:non-scaling-stroke; }
  .rig-machine { fill:#87949b; stroke:#d6e0e4; stroke-width:.8; vector-effect:non-scaling-stroke; }
  .rig-machine-wheel,.rig-wheels rect { fill:#1e2c34; opacity:.94; }
  .rig-hotshot-load { fill:#718895; stroke:#d8e3e7; stroke-width:.8; vector-effect:non-scaling-stroke; }

  :global([data-logistics-echo-scene="car-hauler"]) .logistics-vehicle-car-hauler,
  :global([data-logistics-scene="car-hauler"]) .logistics-vehicle-car-hauler,
  :global([data-logistics-echo-scene="dry-van"]) .logistics-vehicle-dry-van,
  :global([data-logistics-scene="dry-van"]) .logistics-vehicle-dry-van,
  :global([data-logistics-echo-scene="reefer"]) .logistics-vehicle-reefer,
  :global([data-logistics-scene="reefer"]) .logistics-vehicle-reefer,
  :global([data-logistics-echo-scene="flatbed"]) .logistics-vehicle-flatbed,
  :global([data-logistics-scene="flatbed"]) .logistics-vehicle-flatbed,
  :global([data-logistics-echo-scene="step-deck"]) .logistics-vehicle-step-deck,
  :global([data-logistics-scene="step-deck"]) .logistics-vehicle-step-deck,
  :global([data-logistics-echo-scene="hotshot"]) .logistics-vehicle-hotshot,
  :global([data-logistics-scene="hotshot"]) .logistics-vehicle-hotshot {
    opacity:1;
  }

  @media(prefers-reduced-motion:reduce) {
    .logistics-vehicle-state { transition:none !important; }
  }
</style>
