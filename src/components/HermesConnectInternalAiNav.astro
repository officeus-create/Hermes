---
const normalized = Astro.url.pathname.replace(/\/+$/, "/");
const isRu = Astro.url.searchParams.get("lang") === "ru";
const suffix = isRu ? "?lang=ru" : "";
const items = [
  { key: "overview", href: "/services/hermes-connect/internal/ai-connect/", en: "Overview", ru: "Обзор" },
  { key: "projects", href: "/services/hermes-connect/internal/ai-connect/projects/", en: "Projects", ru: "Проекты" },
  { key: "activity", href: "/services/hermes-connect/internal/ai-connect/activity/", en: "Activity", ru: "Активность" },
  { key: "assistant", href: "/services/hermes-connect/internal/ai-assistant/", en: "AI Assistant", ru: "AI Assistant" },
];
const currentKey = normalized.includes("/activity/") ? "activity"
  : normalized.includes("/projects/") ? "projects"
  : normalized.includes("/ai-assistant/") ? "assistant"
  : "overview";
---
<nav class="hc-ai-nav" data-hc-ai-nav aria-label={isRu ? "Разделы AI Hermes Connect" : "AI Hermes Connect sections"} hidden>
  <div class="hc-ai-nav__identity">
    <span class="hc-ai-nav__mark" aria-hidden="true">AI</span>
    <span><strong>Hermes Connect</strong><small>{isRu ? "Кабинет владельца · AI" : "Owner cabinet · AI"}</small></span>
  </div>
  <div class="hc-ai-nav__links">
    {items.map((item) => (
      <a href={`${item.href}${suffix}`} aria-current={currentKey === item.key ? "page" : undefined}>{isRu ? item.ru : item.en}</a>
    ))}
  </div>
</nav>

<section class="hc-ai-activation" data-hc-ai-activation hidden aria-labelledby="hc-ai-activation-title">
  <div>
    <strong id="hc-ai-activation-title">{isRu ? "Активировать AI в этом Hermes-аккаунте" : "Activate AI for this Hermes account"}</strong>
    <p>{isRu ? "Введите одноразовый код владельца. Код не определяет вас по email или роли: сервер привяжет capability только к текущей защищённой Hermes-сессии и только если внутренний владелец ещё не назначен." : "Enter the one-time owner activation code. The code does not infer identity from email or role: the server binds the capability only to this authenticated Hermes session and only if no internal owner has been provisioned yet."}</p>
  </div>
  <form data-hc-ai-activation-form>
    <label>{isRu ? "Код активации" : "Activation code"}<input data-hc-ai-activation-token type="password" maxlength="512" autocomplete="one-time-code" required /></label>
    <button type="submit">{isRu ? "Активировать мой AI-кабинет" : "Activate my AI cabinet"}</button>
    <p data-hc-ai-activation-status role="status"></p>
  </form>
</section>

<script>
  (() => {
    const nav = document.querySelector<HTMLElement>("[data-hc-ai-nav]");
    const activation = document.querySelector<HTMLElement>("[data-hc-ai-activation]");
    const form = document.querySelector<HTMLFormElement>("[data-hc-ai-activation-form]");
    const input = document.querySelector<HTMLInputElement>("[data-hc-ai-activation-token]");
    const status = document.querySelector<HTMLElement>("[data-hc-ai-activation-status]");
    if (!nav || !activation) return;
    const ru = new URLSearchParams(window.location.search).get("lang") === "ru";
    const t = (en: string, ruText: string) => ru ? ruText : en;

    const check = async () => {
      try {
        const response = await fetch("/api/internal-ai/status", { credentials: "same-origin", headers: { Accept: "application/json" } });
        const payload = await response.json().catch(() => null);
        if (response.ok && payload?.success) {
          nav.hidden = false;
          activation.hidden = true;
          return;
        }
        nav.hidden = true;
        activation.hidden = response.status !== 403;
      } catch {
        nav.hidden = true;
        activation.hidden = true;
      }
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const token = input?.value || "";
      if (!token) return;
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
      if (button) button.disabled = true;
      if (status) status.textContent = t("Activating…", "Активируем…");
      try {
        const response = await fetch("/api/internal-ai/bootstrap-owner", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ bootstrap_token: token }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload?.success) {
          const messages: Record<string, [string, string]> = {
            internal_owner_bootstrap_not_configured: ["Owner activation is not configured on the server yet.", "Код владельца ещё не настроен на сервере."],
            invalid_bootstrap_token: ["The activation code is not valid.", "Неверный код активации."],
            internal_owner_already_provisioned: ["An internal owner is already provisioned. This one-time activation is closed.", "Внутренний владелец уже назначен. Одноразовая активация закрыта."],
            csrf_origin_mismatch: ["Activation must be submitted from this Hermes page.", "Активацию нужно выполнять с этой страницы Hermes."],
          };
          const pair = messages[String(payload?.error || "")] || ["Unable to activate internal AI access.", "Не удалось активировать внутренний AI-доступ."];
          if (status) status.textContent = t(pair[0], pair[1]);
          return;
        }
        if (input) input.value = "";
        if (status) status.textContent = t("AI access activated. Reloading your cabinet…", "AI-доступ активирован. Перезагружаем кабинет…");
        window.location.reload();
      } catch {
        if (status) status.textContent = t("Network error during activation.", "Ошибка сети при активации.");
      } finally {
        if (button) button.disabled = false;
      }
    });

    void check();
  })();
</script>

<style>
  .hc-ai-nav[hidden],.hc-ai-activation[hidden]{display:none!important}.hc-ai-nav{width:min(1120px,calc(100% - 2rem));margin:1rem auto 0;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.68rem .78rem;border:1px solid rgba(17,22,31,.1);border-radius:1rem;background:rgba(255,255,255,.9);box-shadow:0 14px 34px rgba(24,32,48,.07);backdrop-filter:blur(18px)}.hc-ai-nav__identity{display:flex;align-items:center;gap:.62rem;min-width:0}.hc-ai-nav__mark{display:grid;place-items:center;width:34px;height:34px;flex:0 0 34px;border-radius:10px;background:#11161f;color:#fff;font-size:.7rem;font-weight:900;box-shadow:inset 0 0 0 1px rgba(255,122,0,.28)}.hc-ai-nav__identity span:last-child{display:grid;min-width:0}.hc-ai-nav__identity strong{color:#11161f;font-size:.8rem}.hc-ai-nav__identity small{color:#747f91;font-size:.65rem}.hc-ai-nav__links{display:flex;align-items:center;gap:.25rem;overflow-x:auto;scrollbar-width:none}.hc-ai-nav__links::-webkit-scrollbar{display:none}.hc-ai-nav__links a{min-height:44px;display:inline-flex;align-items:center;white-space:nowrap;padding:.5rem .68rem;border:1px solid transparent;border-radius:.7rem;color:#5f6979;text-decoration:none;font-size:.76rem;font-weight:800}.hc-ai-nav__links a:hover,.hc-ai-nav__links a:focus-visible{border-color:rgba(255,122,0,.2);color:#11161f;background:rgba(255,122,0,.05)}.hc-ai-nav__links a[aria-current="page"]{border-color:rgba(255,122,0,.28);color:#8e4300;background:rgba(255,122,0,.09)}.hc-ai-activation{width:min(1120px,calc(100% - 2rem));box-sizing:border-box;margin:1rem auto 0;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:1rem;padding:1rem;border:1px solid rgba(255,122,0,.2);border-radius:1rem;background:#fffaf5;box-shadow:0 14px 34px rgba(24,32,48,.06)}.hc-ai-activation strong{color:#11161f}.hc-ai-activation p{margin:.35rem 0 0;color:#657083;font-size:.8rem;line-height:1.5}.hc-ai-activation form{display:grid;gap:.55rem}.hc-ai-activation label{display:grid;gap:.35rem;color:#11161f;font-size:.76rem;font-weight:800}.hc-ai-activation input{box-sizing:border-box;width:100%;min-height:44px;border:1px solid rgba(17,22,31,.14);border-radius:.7rem;padding:.6rem .7rem;background:#fff;color:#11161f;font:inherit}.hc-ai-activation button{min-height:44px;border:0;border-radius:.7rem;background:#11161f;color:#fff;font-weight:850;cursor:pointer}.hc-ai-activation button:disabled{opacity:.55;cursor:not-allowed}.hc-ai-activation [role='status']{min-height:1.2em;margin:0}@media(max-width:760px){.hc-ai-nav{align-items:stretch;flex-direction:column}.hc-ai-nav__links{width:100%}.hc-ai-nav__links a{flex:0 0 auto}.hc-ai-activation{grid-template-columns:1fr}}
</style>
