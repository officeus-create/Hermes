---
import { ArrowRight, Boxes, MapPinned, Route, ScanSearch, ShieldCheck } from "@lucide/astro";

const stages = [
  {
    key: "context",
    label: "Request context",
    title: "Start with the role, need, and operating objective.",
    body: "Hermes first separates who needs help, what is moving or being evaluated, and which operating path is relevant before routing the visitor deeper.",
    icon: MapPinned,
  },
  {
    key: "fit",
    label: "Route + equipment fit",
    title: "Match the request to the right operating path.",
    body: "Route, equipment, authority, service scope, and other known constraints shape the next recommendation. The scene explains fit; it does not invent a live load or promise capacity.",
    icon: Route,
  },
  {
    key: "boundary",
    label: "Source + capacity boundary",
    title: "Show only what the approved source can truthfully support.",
    body: "The public Load Board may contain approved active source-gated records, including zero. Preview examples remain labeled and non-bookable; unknown availability never becomes a live claim.",
    icon: Boxes,
  },
  {
    key: "review",
    label: "Human review",
    title: "A person confirms the operational decision.",
    body: "Carrier, manager, or Hermes staff reviews fit, timing, terms, authority, insurance, capacity, or customer context where applicable before any real operating commitment.",
    icon: ShieldCheck,
  },
  {
    key: "handoff",
    label: "Controlled handoff",
    title: "Move into the existing workflow that owns the next action.",
    body: "The result can continue into the Path Engine recommendation, canonical Load Board, carrier intake, or a direct team review without creating a second logistics backend.",
    icon: ScanSearch,
  },
];

const stateLabels = {
  context: "REQUEST CONTEXT",
  fit: "ROUTE / EQUIPMENT FIT",
  boundary: "SOURCE BOUNDARY",
  review: "HUMAN REVIEW",
  handoff: "CONTROLLED HANDOFF",
};

const livingScenes = [
  { key: "car-hauler", equipment: "Car Hauler", weather: "Clear sunrise", environment: "Open highway" },
  { key: "dry-van", equipment: "Dry Van", weather: "Rain", environment: "Interstate corridor" },
  { key: "reefer", equipment: "Reefer", weather: "Snow / cold", environment: "Northern route" },
  { key: "flatbed", equipment: "Flatbed", weather: "Dry heat", environment: "Open-country freight" },
  { key: "step-deck", equipment: "Step Deck", weather: "Cloud / mountain", environment: "Grade change" },
  { key: "hotshot", equipment: "Hotshot", weather: "Dusk", environment: "Regional highway" },
] as const;
---

<section
  class="logistics-spatial section"
  aria-labelledby="logistics-spatial-title"
  data-logistics-spatial-operations
  data-active-logistics-stage="context"
  data-logistics-scene={livingScenes[0].key}
  data-logistics-scene-count={livingScenes.length}
  data-logistics-scenes={JSON.stringify(livingScenes)}
>
  <div class="shell">
    <div class="logistics-spatial-heading">
      <div>
        <p class="eyebrow">Spatial Operations · Sample operating path</p>
        <h2 id="logistics-spatial-title">See how a logistics request moves from context to a controlled handoff.</h2>
      </div>
      <div>
        <p>Hermes Logistics is easier to understand when the operating path is visible: identify the request, check fit and source boundaries, keep a human decision in the loop, then continue into the workflow that actually owns the next action.</p>
        <strong>Illustrative workflow — not live load, rate, capacity, demand, vehicle, telemetry, or ETA data.</strong>
      </div>
    </div>

    <div class="logistics-spatial-frame">
      <div class="logistics-spatial-map" aria-label="Illustrative logistics operating path">
        <div class="logistics-spatial-grid" aria-hidden="true"></div>
        <div class="logistics-spatial-ambient" aria-hidden="true"></div>
        <div class="logistics-living-scene" aria-hidden="true">
          <div class="logistics-weather"></div>
          <div class="logistics-aerial-road"><i></i><i></i><i></i></div>
          <div class="logistics-aerial-vehicle">
            <span class="logistics-aerial-trailer"></span>
            <span class="logistics-aerial-load"></span>
            <span class="logistics-aerial-cab"></span>
          </div>
          <div class="logistics-scene-chip">
            <span data-logistics-scene-weather>{livingScenes[0].weather} · {livingScenes[0].environment}</span>
            <strong data-logistics-scene-equipment>{livingScenes[0].equipment}</strong>
          </div>
        </div>
        <svg class="logistics-spatial-route" viewBox="0 0 760 420" role="img" aria-label="Illustrative route connecting request context, fit, source boundary, human review, and handoff">
          <path class="logistics-spatial-route-base" d="M70 330 C150 260 180 105 300 130 S425 330 515 250 S610 90 700 120" />
          <path class="logistics-spatial-route-live" d="M70 330 C150 260 180 105 300 130 S425 330 515 250 S610 90 700 120" />
        </svg>

        <div class="logistics-spatial-node logistics-spatial-node-context" data-map-stage="context"><span>01</span><strong>Context</strong></div>
        <div class="logistics-spatial-node logistics-spatial-node-fit" data-map-stage="fit"><span>02</span><strong>Fit</strong></div>
        <div class="logistics-spatial-node logistics-spatial-node-boundary" data-map-stage="boundary"><span>03</span><strong>Boundary</strong></div>
        <div class="logistics-spatial-node logistics-spatial-node-review" data-map-stage="review"><span>04</span><strong>Review</strong></div>
        <div class="logistics-spatial-node logistics-spatial-node-handoff" data-map-stage="handoff"><span>05</span><strong>Handoff</strong></div>

        <div class="logistics-spatial-status" aria-live="polite">
          <span>Current explanation</span>
          <strong data-logistics-spatial-state>{stateLabels.context}</strong>
        </div>
        <div class="logistics-spatial-human"><ShieldCheck size={18} aria-hidden="true" /><span>Human control remains explicit before a real commitment.</span></div>
      </div>

      <ol class="logistics-spatial-steps" aria-label="Logistics operating path explanation">
        {stages.map((stage, index) => {
          const Icon = stage.icon;
          return (
            <li>
              <button
                type="button"
                class="logistics-spatial-step"
                data-logistics-spatial-step={stage.key}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span class="logistics-spatial-step-number">0{index + 1}</span>
                <Icon size={19} aria-hidden="true" />
                <span>
                  <strong>{stage.label}</strong>
                  <small>{stage.title}</small>
                </span>
              </button>
              <p>{stage.body}</p>
            </li>
          );
        })}
      </ol>
    </div>

    <div class="logistics-spatial-actions">
      <div>
        <p class="eyebrow">Use the real workflow</p>
        <h3>Choose the next action instead of treating the scene as live operations data.</h3>
      </div>
      <div>
        <a class="button button-primary" href="#find-your-path">Find your logistics path <ArrowRight size={18} aria-hidden="true" /></a>
        <a class="button button-ghost" href="/load-board/">Open the canonical Load Board <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-logistics-spatial-operations]").forEach((root) => {
    const steps = Array.from(root.querySelectorAll("[data-logistics-spatial-step]"));
    const nodes = Array.from(root.querySelectorAll("[data-map-stage]"));
    const state = root.querySelector("[data-logistics-spatial-state]");
    const sceneEquipment = root.querySelector("[data-logistics-scene-equipment]");
    const sceneWeather = root.querySelector("[data-logistics-scene-weather]");
    const scenePayload = root.getAttribute("data-logistics-scenes");
    const scenes: Array<{ key: string; equipment: string; weather: string; environment: string }> = scenePayload ? JSON.parse(scenePayload) : [];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const labels: Record<string, string> = {
      context: "REQUEST CONTEXT",
      fit: "ROUTE / EQUIPMENT FIT",
      boundary: "SOURCE BOUNDARY",
      review: "HUMAN REVIEW",
      handoff: "CONTROLLED HANDOFF",
    };

    const activate = (key: string) => {
      const activeIndex = steps.findIndex((step) => step.getAttribute("data-logistics-spatial-step") === key);
      root.setAttribute("data-active-logistics-stage", key);
      steps.forEach((step) => step.setAttribute("aria-pressed", String(step.getAttribute("data-logistics-spatial-step") === key)));
      nodes.forEach((node) => {
        const nodeIndex = steps.findIndex((step) => step.getAttribute("data-logistics-spatial-step") === node.getAttribute("data-map-stage"));
        node.classList.toggle("active", nodeIndex <= activeIndex);
      });
      if (state) state.textContent = labels[key] || "OPERATING PATH";
    };

    steps.forEach((step) => {
      const key = step.getAttribute("data-logistics-spatial-step");
      if (!key) return;
      step.addEventListener("pointerenter", () => activate(key));
      step.addEventListener("focus", () => activate(key));
      step.addEventListener("click", () => activate(key));
    });

    const applyScene = (index: number) => {
      if (!scenes.length) return;
      const scene = scenes[index % scenes.length];
      root.setAttribute("data-logistics-scene", scene.key);
      if (sceneEquipment) sceneEquipment.textContent = scene.equipment;
      if (sceneWeather) sceneWeather.textContent = `${scene.weather} · ${scene.environment}`;
    };

    let sceneIndex = 0;
    let sceneTimer: number | undefined;
    const startSceneLoop = () => {
      if (reducedMotion.matches || scenes.length < 2 || sceneTimer) return;
      sceneTimer = window.setInterval(() => {
        sceneIndex = (sceneIndex + 1) % scenes.length;
        applyScene(sceneIndex);
      }, 4600);
    };
    const stopSceneLoop = () => {
      if (!sceneTimer) return;
      window.clearInterval(sceneTimer);
      sceneTimer = undefined;
    };

    reducedMotion.addEventListener("change", () => {
      if (reducedMotion.matches) {
        stopSceneLoop();
        sceneIndex = 0;
        applyScene(sceneIndex);
      } else {
        startSceneLoop();
      }
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopSceneLoop();
      else startSceneLoop();
    });

    activate("context");
    applyScene(sceneIndex);
    startSceneLoop();
  });
</script>

<style>
  .logistics-spatial { background:#f6f9fd; }
  .logistics-spatial-heading { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,.95fr); gap:clamp(2rem,6vw,6rem); align-items:end; margin-bottom:2rem; }
  .logistics-spatial-heading h2 { max-width:800px; margin-bottom:0; }
  .logistics-spatial-heading > div:last-child > p { margin:0 0 .75rem; color:#526181; line-height:1.7; }
  .logistics-spatial-heading > div:last-child > strong { display:block; color:#31526f; font-size:.8rem; line-height:1.5; }
  .logistics-spatial-frame { display:grid; grid-template-columns:minmax(0,1.45fr) minmax(300px,.72fr); gap:1rem; padding:1rem; border:1px solid rgba(21,76,126,.14); border-radius:30px; background:#fff; box-shadow:0 28px 80px rgba(17,43,103,.08); }
  .logistics-spatial-map { position:relative; min-height:520px; overflow:hidden; border-radius:23px; background:linear-gradient(145deg,#102f49,#174a6d 48%,#1c5a73); color:#fff; }
  .logistics-spatial-grid { position:absolute; inset:0; opacity:.2; background-image:linear-gradient(rgba(255,255,255,.13) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.13) 1px,transparent 1px); background-size:44px 44px; transform:perspective(700px) rotateX(58deg) scale(1.5); transform-origin:center 80%; animation:logistics-grid-drift 11s ease-in-out infinite alternate; will-change:transform,opacity; }
  .logistics-spatial-ambient { position:absolute; inset:-14% -18%; z-index:1; pointer-events:none; opacity:.72; overflow:hidden; background:radial-gradient(circle at 18% 72%,rgba(121,217,255,.16),transparent 24%),radial-gradient(circle at 76% 24%,rgba(94,153,255,.11),transparent 23%),linear-gradient(180deg,rgba(255,255,255,.025),transparent 55%); animation:logistics-ambient-drift 9s ease-in-out infinite alternate; will-change:transform,opacity; }
  .logistics-spatial-ambient::before { content:""; position:absolute; top:-34%; left:-32%; width:24%; height:170%; background:linear-gradient(90deg,transparent,rgba(180,232,255,.14),transparent); transform:skewX(-16deg); filter:blur(5px); animation:logistics-light-sweep 10s cubic-bezier(.45,0,.2,1) infinite; }
  .logistics-spatial-ambient::after { content:""; position:absolute; left:9%; right:8%; bottom:9%; height:22%; border-radius:50%; background:radial-gradient(ellipse at center,rgba(95,205,255,.11),transparent 68%); animation:logistics-horizon-breathe 7s ease-in-out infinite alternate; }
  .logistics-living-scene { position:absolute; inset:0; z-index:0; overflow:hidden; pointer-events:none; background:linear-gradient(145deg,#244f67,#55849a 48%,#b7c7cc); transition:background 1.1s ease,filter 1.1s ease; }
  .logistics-living-scene::before { content:""; position:absolute; inset:0; background:radial-gradient(circle at 18% 22%,rgba(255,255,255,.35),transparent 28%),linear-gradient(180deg,rgba(255,255,255,.06),rgba(7,27,42,.18)); opacity:.8; transition:opacity .9s ease; }
  .logistics-aerial-road { position:absolute; left:-33%; top:44%; width:166%; height:23%; transform:rotate(-27deg); border-top:1px solid rgba(255,255,255,.11); border-bottom:1px solid rgba(255,255,255,.11); background:linear-gradient(180deg,#465360,#2b333c 48%,#434f5a); box-shadow:0 0 0 16px rgba(39,71,62,.2),0 20px 50px rgba(4,20,29,.18); overflow:hidden; }
  .logistics-aerial-road::before { content:""; position:absolute; left:0; right:0; top:48%; height:2px; background:repeating-linear-gradient(90deg,rgba(255,255,255,.82) 0 25px,transparent 25px 51px); animation:logistics-road-marks 1.9s linear infinite; }
  .logistics-aerial-road::after { content:""; position:absolute; inset:0; background:linear-gradient(90deg,transparent 4%,rgba(155,211,231,.08) 35%,transparent 64%); transform:translateX(-50%); animation:logistics-road-light 6.5s ease-in-out infinite; }
  .logistics-aerial-road i { position:absolute; display:block; width:34%; height:1px; background:rgba(255,255,255,.11); }
  .logistics-aerial-road i:nth-child(1){left:4%;top:18%}.logistics-aerial-road i:nth-child(2){left:42%;top:78%}.logistics-aerial-road i:nth-child(3){right:3%;top:20%}
  .logistics-weather { position:absolute; inset:-12%; opacity:.42; transition:opacity .9s ease,background .9s ease; }
  .logistics-aerial-vehicle { position:absolute; z-index:1; left:48%; top:50%; width:34px; height:104px; transform:translate(-50%,-50%) rotate(-27deg); filter:drop-shadow(0 10px 11px rgba(4,19,28,.34)); animation:logistics-truck-cruise 4.6s ease-in-out infinite; transition:width .65s ease,height .65s ease,filter .65s ease; }
  .logistics-aerial-cab,.logistics-aerial-trailer,.logistics-aerial-load { position:absolute; display:block; left:50%; transform:translateX(-50%); transition:all .65s cubic-bezier(.16,1,.3,1); }
  .logistics-aerial-cab { bottom:0; width:27px; height:30px; border-radius:6px 6px 9px 9px; background:linear-gradient(180deg,#f8fbff,#cdd8e0); box-shadow:inset 0 -7px 0 rgba(21,52,67,.14); }
  .logistics-aerial-cab::before { content:""; position:absolute; left:5px; right:5px; top:5px; height:8px; border-radius:3px; background:#41667b; box-shadow:0 12px 0 -2px rgba(20,42,55,.15); }
  .logistics-aerial-trailer { top:1px; width:30px; height:70px; border-radius:5px; background:linear-gradient(180deg,#eef3f6,#aebfc9); box-shadow:inset 0 0 0 1px rgba(255,255,255,.4); }
  .logistics-aerial-load { top:9px; width:18px; height:10px; border-radius:3px; opacity:0; background:#5f7f91; box-shadow:0 17px 0 #7896a5,0 34px 0 #566f7e; }
  .logistics-scene-chip { position:absolute; z-index:1; right:1rem; bottom:1rem; display:grid; justify-items:end; gap:.2rem; max-width:50%; color:#fff; text-shadow:0 2px 10px rgba(5,21,32,.42); }
  .logistics-scene-chip span { font:600 .58rem/1.3 "IBM Plex Mono",monospace; letter-spacing:.08em; text-transform:uppercase; color:rgba(255,255,255,.72); }
  .logistics-scene-chip strong { font-size:.86rem; letter-spacing:.01em; }
  [data-logistics-scene="car-hauler"] .logistics-living-scene { background:linear-gradient(145deg,#456f7f,#84aab3 47%,#e6bc7c); }
  [data-logistics-scene="car-hauler"] .logistics-weather { background:radial-gradient(circle at 18% 15%,rgba(255,233,176,.8),transparent 28%),linear-gradient(130deg,transparent 55%,rgba(255,255,255,.12)); opacity:.56; }
  [data-logistics-scene="car-hauler"] .logistics-aerial-trailer { width:30px; height:70px; background:rgba(41,57,67,.28); border:2px solid #d8e1e5; box-shadow:inset 0 0 0 1px rgba(23,45,56,.25); }
  [data-logistics-scene="car-hauler"] .logistics-aerial-load { opacity:1; }
  [data-logistics-scene="dry-van"] .logistics-living-scene { background:linear-gradient(145deg,#243d4d,#536f7b 52%,#798a92); }
  [data-logistics-scene="dry-van"] .logistics-weather { background:repeating-linear-gradient(103deg,transparent 0 16px,rgba(205,235,248,.42) 17px 19px,transparent 20px 35px); animation:logistics-rain 1.1s linear infinite; opacity:.62; }
  [data-logistics-scene="reefer"] .logistics-living-scene { background:linear-gradient(145deg,#8ba8b5,#b8cbd2 50%,#e7edf0); filter:saturate(.82); }
  [data-logistics-scene="reefer"] .logistics-weather { background:radial-gradient(circle,#fff 0 1.2px,transparent 1.8px) 0 0/24px 28px,radial-gradient(circle,#eef8ff 0 1px,transparent 1.8px) 12px 8px/31px 32px; animation:logistics-snow 4.2s linear infinite; opacity:.72; }
  [data-logistics-scene="reefer"] .logistics-aerial-trailer::before { content:""; position:absolute; left:5px; right:5px; top:5px; height:6px; border-radius:2px; background:#607d8b; box-shadow:0 3px 0 rgba(255,255,255,.32); }
  [data-logistics-scene="flatbed"] .logistics-living-scene { background:linear-gradient(145deg,#8e7359,#bd9a6c 48%,#dac080); }
  [data-logistics-scene="flatbed"] .logistics-weather { background:radial-gradient(ellipse at 70% 24%,rgba(255,239,185,.48),transparent 28%),repeating-linear-gradient(92deg,transparent 0 25px,rgba(255,230,170,.07) 27px 30px); animation:logistics-heat 3.1s ease-in-out infinite alternate; opacity:.68; }
  [data-logistics-scene="flatbed"] .logistics-aerial-trailer { height:60px; width:31px; border-radius:3px; background:linear-gradient(90deg,#725a42,#a08059 48%,#725a42); box-shadow:inset 0 0 0 2px rgba(42,54,58,.5); }
  [data-logistics-scene="step-deck"] .logistics-living-scene { background:linear-gradient(145deg,#405664,#6f8790 48%,#92a59d); }
  [data-logistics-scene="step-deck"] .logistics-weather { background:radial-gradient(ellipse at 20% 26%,rgba(240,248,248,.35),transparent 23%),radial-gradient(ellipse at 72% 21%,rgba(233,242,242,.4),transparent 30%),linear-gradient(160deg,transparent 50%,rgba(34,55,64,.18) 51% 62%,transparent 63%); animation:logistics-cloud 7s ease-in-out infinite alternate; opacity:.72; }
  [data-logistics-scene="step-deck"] .logistics-aerial-trailer { height:64px; width:31px; clip-path:polygon(0 0,100% 0,100% 62%,84% 62%,84% 100%,16% 100%,16% 62%,0 62%); border-radius:2px; background:linear-gradient(90deg,#66737b,#a7b0b5,#66737b); }
  [data-logistics-scene="hotshot"] .logistics-living-scene { background:linear-gradient(145deg,#172e42,#40556a 48%,#9b6a5f); }
  [data-logistics-scene="hotshot"] .logistics-weather { background:radial-gradient(circle at 78% 20%,rgba(250,179,132,.38),transparent 24%),linear-gradient(180deg,rgba(18,35,59,.15),rgba(8,18,30,.42)); opacity:.78; }
  [data-logistics-scene="hotshot"] .logistics-aerial-vehicle { width:36px; height:89px; }
  [data-logistics-scene="hotshot"] .logistics-aerial-trailer { height:53px; width:28px; background:linear-gradient(90deg,#3c4b54,#8e9aa0,#3c4b54); }
  [data-logistics-scene="hotshot"] .logistics-aerial-cab { width:31px; height:29px; border-radius:7px 7px 10px 10px; }
  .logistics-spatial-map::before,.logistics-spatial-map::after { content:""; position:absolute; z-index:1; border:1px solid rgba(255,255,255,.13); background:rgba(255,255,255,.045); border-radius:12px; transform:rotate(-7deg); }
  .logistics-spatial-map::before { width:190px; height:90px; left:16%; top:12%; }
  .logistics-spatial-map::after { width:220px; height:120px; right:10%; bottom:18%; transform:rotate(8deg); }
  .logistics-spatial-route { position:absolute; z-index:2; inset:7% 5% 12%; width:90%; height:78%; overflow:visible; }
  .logistics-spatial-route path { fill:none; stroke-linecap:round; stroke-linejoin:round; }
  .logistics-spatial-route-base { stroke:rgba(255,255,255,.16); stroke-width:9; }
  .logistics-spatial-route-live { stroke:#79d9ff; stroke-width:4; stroke-dasharray:9 10; filter:drop-shadow(0 0 7px rgba(121,217,255,.55)); animation:logistics-route-flow 3.2s linear infinite,logistics-route-glow 7s ease-in-out infinite; }
  .logistics-spatial-node { position:absolute; z-index:3; display:grid; gap:.18rem; min-width:84px; padding:.65rem .72rem; border:1px solid rgba(255,255,255,.16); border-radius:14px; background:rgba(8,28,45,.76); box-shadow:0 12px 30px rgba(0,0,0,.12); transition:background .35s ease,border-color .35s ease,transform .35s ease; }
  .logistics-spatial-node::after { content:""; position:absolute; inset:-6px; border:1px solid rgba(121,217,255,.38); border-radius:18px; opacity:0; transform:scale(.96); pointer-events:none; animation:logistics-node-wake 10s ease-out infinite; }
  .logistics-spatial-node-fit::after { animation-delay:2s; }
  .logistics-spatial-node-boundary::after { animation-delay:4s; }
  .logistics-spatial-node-review::after { animation-delay:6s; }
  .logistics-spatial-node-handoff::after { animation-delay:8s; }
  .logistics-spatial-node span { font:600 .65rem/1 "IBM Plex Mono",monospace; letter-spacing:.08em; color:#8ccff1; }
  .logistics-spatial-node strong { font-size:.8rem; }
  .logistics-spatial-node.active { background:#fff; border-color:#fff; color:#123c5c; transform:translateY(-4px); }
  .logistics-spatial-node.active span { color:#1e88ff; }
  .logistics-spatial-node-context { left:5%; bottom:13%; }
  .logistics-spatial-node-fit { left:29%; top:22%; }
  .logistics-spatial-node-boundary { left:49%; bottom:22%; }
  .logistics-spatial-node-review { right:22%; top:23%; }
  .logistics-spatial-node-handoff { right:5%; top:12%; }
  .logistics-spatial-status { position:absolute; left:1rem; top:1rem; z-index:4; display:grid; gap:.25rem; padding:.75rem .9rem; border:1px solid rgba(255,255,255,.13); border-radius:13px; background:rgba(6,23,39,.72); backdrop-filter:blur(10px); }
  .logistics-spatial-status span { font-size:.65rem; letter-spacing:.1em; color:rgba(255,255,255,.62); text-transform:uppercase; }
  .logistics-spatial-status strong { font-size:.78rem; letter-spacing:.07em; }
  .logistics-spatial-human { position:absolute; left:1rem; bottom:1rem; z-index:4; display:inline-flex; gap:.55rem; align-items:center; max-width:390px; color:rgba(255,255,255,.76); font-size:.77rem; }
  .logistics-spatial-human svg { color:#79d9ff; flex:none; }
  .logistics-spatial-steps { display:grid; gap:.5rem; list-style:none; margin:0; padding:0; align-content:start; }
