---
import { ArrowUpRight } from "@lucide/astro";
import { site } from "../data/site";
---
<section class="home-final-contact" aria-labelledby="home-final-contact-title">
 <div class="home-final-contact-inner">
  <p class="home-final-contact-kicker">CONTACT <span aria-hidden="true"></span></p>
  <h2 id="home-final-contact-title">Let’s build your<br /><span>next step.</span></h2>
  <p>Our team is here to help. Logistics, marketing, technology and learning, all in one Hermes ecosystem.</p>
  <div class="home-final-contact-actions" role="group" aria-label="Hermes contact options">
   <a class="home-final-contact-action" href="/contacts/" data-home-primary-contact>Talk to Hermes <ArrowUpRight size={18} aria-hidden="true" /></a>
   <a class="home-final-contact-action home-connect-action" href="/services/hermes-connect/">Explore Hermes Connect</a>
  </div>
  <a class="home-contact-fallback" href={site.logisticsEmail.href} data-home-contact-fallback>{site.logisticsEmail.value}</a>
 </div>
</section>
<style>
.home-final-contact{position:relative;isolation:isolate;min-height:460px;padding:clamp(40px,6vw,80px) 0;color:#101332;background:linear-gradient(130deg,#fafbff,#e3edff88,#e9e0ff88)}
.home-final-contact::before{content:"";position:absolute;z-index:-1;right:0;bottom:0;width:100%;aspect-ratio:1111/458;background:linear-gradient(100deg,#fafbff 0%,#fafbff 55%,#fafbff00 79%),url('/images/home-approved-20260930.webp?v=q93') right bottom/100% auto no-repeat}
.home-final-contact-inner{width:min(1380px,calc(100% - 92px));margin:auto;position:relative}
.home-final-contact-kicker{display:flex;align-items:center;gap:16px;margin:0 0 25px;color:#6c659a;font-size:.65rem;letter-spacing:.2em;font-weight:800}
.home-final-contact-kicker span{height:1px;width:70px;background:#8b7fff}
.home-final-contact h2{margin:0;max-width:12ch;font:800 clamp(2.6rem,5.5vw,5.2rem)/.98 var(--font-display);letter-spacing:-.065em;color:#090b31}
.home-final-contact h2 span{background:linear-gradient(95deg,#0b164a,#5169e0);background-clip:text;-webkit-text-fill-color:transparent}
.home-final-contact-inner>p:not(.home-final-contact-kicker){max-width:48ch;margin:20px 0 24px;color:#505680;font-size:1.05rem;line-height:1.6}
.home-final-contact-actions{display:flex;gap:12px;flex-wrap:wrap}
.home-final-contact-action{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:48px;padding:12px 30px;border-radius:999px;background:linear-gradient(100deg,#17194c,#514eac);color:#fff;font-weight:700;font-size:.85rem;text-decoration:none}
.home-connect-action{border:1px solid #a7abd2;color:#161a48;background:#ffffffb0;font-weight:500}
.home-contact-fallback{display:inline-block;margin-top:18px;color:#505680;font-size:.85rem;text-underline-offset:4px}
.home-final-contact a:focus-visible{outline:3px solid #5743c2;outline-offset:4px}
@media(max-width:700px){.home-final-contact::before{display:none}.home-final-contact{min-height:440px;background:radial-gradient(ellipse at 95% 90%,#bfeaff,#e9e0ff88 45%,#fafbff 75%)}.home-final-contact-inner{width:calc(100% - 40px)}.home-final-contact h2{font-size:2.8rem}.home-final-contact-action{padding-inline:24px}}
</style>
