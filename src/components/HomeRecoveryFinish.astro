---
import { ArrowUpRight } from "@lucide/astro";
import { site } from "../data/site";
const directions = [
  { label: "Logistics", description: "Carrier, dealer or shipper inquiry", href: "/paths/logistics/", key: "logistics" },
  { label: "Technology", description: "Website, CRM or software brief", href: "/paths/technology/", key: "technology" },
  { label: "Academy", description: "Learning and team training", href: "/paths/academy/", key: "academy" },
  { label: "Marketing", description: "Marketing and SEO/GEO brief", href: "/paths/marketing/", key: "marketing" },
];
---
<section class="home-final-contact" aria-labelledby="home-final-contact-title">
  <div class="home-final-contact-inner">
    <div class="home-final-contact-row">
      <p class="home-final-contact-kicker">CONTACT</p>
      <h2 id="home-final-contact-title">Not sure which direction fits?</h2>
      <a class="home-contact-email" href={site.logisticsEmail.href} data-home-contact-fallback>{site.logisticsEmail.value}</a>
      <a class="home-final-contact-action" href="/contacts/" data-home-primary-contact>Describe your request <ArrowUpRight size={18} aria-hidden="true" /></a>
    </div>
    <nav class="home-contact-directions" aria-label="Contact Hermes by direction">
      {directions.map((item) => (
        <a class="home-contact-direction" href={item.href} data-direction={item.key}>
          <span class="home-contact-direction-label">{item.label}</span>
          <strong>{item.description} <span aria-hidden="true">→</span></strong>
        </a>
      ))}
    </nav>
    <p class="home-contact-product-link">Looking for an existing tool? <a href="/services/hermes-connect/">Explore Hermes Connect</a></p>
  </div>
</section>
<style>
.home-final-contact{position:relative;padding:clamp(42px,5.3vw,74px) 0 clamp(24px,3vw,44px);background:#f7f6f3;color:#111318}
.home-final-contact-inner{width:min(1380px,calc(100% - 48px));margin-inline:auto}
.home-final-contact-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;gap:clamp(14px,2vw,30px);align-items:center;padding-bottom:30px;border-bottom:1px solid #d9dfe5}
.home-final-contact-kicker{margin:0;font:750 .7rem/1.2 var(--font-mono);letter-spacing:.15em;color:#58657a}
.home-final-contact h2{margin:0;font:800 clamp(1.3rem,2.6vw,2.65rem)/1.12 var(--font-display);letter-spacing:-.045em;color:#111318}
.home-contact-email{white-space:nowrap;font:700 .85rem/1.3 var(--font-body);color:#0a164f;text-decoration:none}
.home-contact-email:hover{text-decoration:underline;text-underline-offset:3px}
.home-final-contact-action{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;white-space:nowrap;padding:12px 22px;border-radius:999px;background:#0a164f;color:#fff;text-decoration:none;font:750 .85rem/1.2 var(--font-body)}
.home-final-contact-action:hover{background:#173271}
.home-contact-directions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(12px,2vw,34px);padding-top:22px}
.home-contact-direction{min-width:0;display:grid;align-content:start;gap:9px;color:#111318;text-decoration:none;padding:1px 0 9px}
.home-contact-direction-label{display:flex;align-items:center;gap:9px;color:#0a164f;text-transform:uppercase;font:750 .72rem/1.4 var(--font-body);letter-spacing:.11em}
.home-contact-direction-label::before{content:"";display:block;width:4px;height:14px;flex:none;border-radius:3px;background:var(--direction-accent)}
.home-contact-direction[data-direction="logistics"]{--direction-accent:var(--dir-logistics)}
.home-contact-direction[data-direction="technology"]{--direction-accent:var(--dir-technology)}
.home-contact-direction[data-direction="academy"]{--direction-accent:var(--dir-academy)}
.home-contact-direction[data-direction="marketing"]{--direction-accent:var(--dir-marketing)}
.home-contact-direction strong{font:700 clamp(.78rem,1vw,.95rem)/1.5 var(--font-body)}
.home-contact-direction:hover strong{text-decoration:underline;text-underline-offset:3px}
.home-contact-product-link{margin:17px 0 0;font-size:.78rem;color:#607085}
.home-contact-product-link a{color:#0a164f;text-decoration:underline;text-underline-offset:3px}
.home-final-contact a:focus-visible{outline:3px solid #2f6bf6;outline-offset:4px}
@media(max-width:1180px){.home-final-contact-row{grid-template-columns:auto minmax(0,1fr) auto}.home-contact-email{grid-column:2}.home-final-contact-action{grid-column:3;grid-row:1 / span 2}}
@media(max-width:820px){.home-final-contact-inner{width:calc(100% - 32px)}.home-final-contact-row{grid-template-columns:1fr;gap:14px}.home-contact-email,.home-final-contact-action{grid-column:1;grid-row:auto;justify-self:start}.home-contact-directions{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}}
@media(max-width:450px){.home-contact-directions{grid-template-columns:1fr 1fr;column-gap:14px}.home-contact-direction strong{font-size:.79rem}.home-final-contact h2{font-size:1.7rem}}
</style>
