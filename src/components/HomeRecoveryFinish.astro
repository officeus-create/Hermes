---
import { ArrowUpRight, Mail, Phone } from "@lucide/astro";
import { site } from "../data/site";

const logisticsPhone = site.publicPhones[0];
const hermesConnectMark = "/images/hermes-connect-mark.svg";
---

<section class="home-final-contact" aria-labelledby="home-final-contact-title">
  <div class="home-final-contact-inner">
    <div class="home-final-contact-copy">
      <p class="home-final-contact-kicker">CONTACT</p>
      <h2 id="home-final-contact-title">Keep the next step simple.</h2>
      <p>Office email and the U.S. logistics line are always one tap away.</p>
    </div>

    <div class="home-final-contact-actions" aria-label="Hermes contact options">
      <a class="home-final-contact-action" href={site.logisticsEmail.href}>
        <img src={hermesConnectMark} alt="Hermes Connect mark" width="28" height="28" aria-hidden="true" />
        <span><small>Office email</small><strong>{site.logisticsEmail.value}</strong></span>
        <Mail size={18} aria-hidden="true" />
      </a>

      {logisticsPhone && (
        <a class="home-final-contact-action" href={logisticsPhone.href}>
          <img src={hermesConnectMark} alt="Hermes Connect mark" width="28" height="28" aria-hidden="true" />
          <span><small>U.S. Logistics</small><strong>{logisticsPhone.value}</strong></span>
          <Phone size={18} aria-hidden="true" />
        </a>
      )}

      <a class="home-final-contact-action home-final-contact-route" href="/contacts/">
        <img src={hermesConnectMark} alt="Hermes Connect mark" width="28" height="28" aria-hidden="true" />
        <span><small>Not sure where to start?</small><strong>Choose a contact route</strong></span>
        <ArrowUpRight size={18} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  .home-final-contact {
    position: relative;
    z-index: 2;
    padding: clamp(2rem, 5vw, 4.25rem) 0 1rem;
    color: #fff;
  }

  .home-final-contact-inner {
    width: min(1240px, calc(100% - 3rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(240px, .72fr) minmax(0, 1.28fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    padding-bottom: clamp(2rem, 4vw, 3.2rem);
    border-bottom: 1px solid rgba(255,255,255,.14);
  }

  .home-final-contact-kicker {
    margin: 0 0 .65rem;
    color: rgba(255,255,255,.52);
    font: 700 .66rem/1.2 var(--font-mono);
    letter-spacing: .22em;
  }

  .home-final-contact h2 {
    margin: 0;
    max-width: 14ch;
    color: #fff;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: .95;
    letter-spacing: -.055em;
  }

  .home-final-contact-copy > p:last-child {
    max-width: 36ch;
    margin: .9rem 0 0;
    color: rgba(255,255,255,.62);
    font-size: .92rem;
  }

  .home-final-contact-actions {
    display: grid;
    gap: .65rem;
  }

  .home-final-contact-action {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: .85rem;
    align-items: center;
    min-height: 66px;
    padding: .72rem .9rem;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 22px;
    background: rgba(8,10,18,.28);
    color: #fff;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.06);
    backdrop-filter: blur(18px) saturate(1.1);
    transition: transform 320ms cubic-bezier(.22,.75,.2,1), border-color 320ms ease, background 320ms ease;
  }

  .home-final-contact-action:hover,
  .home-final-contact-action:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(188,174,255,.48);
    background: rgba(124,92,255,.15);
    outline: none;
  }

  .home-final-contact-action img {
    border-radius: 9px;
    box-shadow: 0 0 24px rgba(124,92,255,.22);
  }

  .home-final-contact-action span {
    min-width: 0;
    display: grid;
    gap: .06rem;
  }

  .home-final-contact-action small {
    color: rgba(255,255,255,.50);
    font: 650 .62rem/1.2 var(--font-mono);
    letter-spacing: .04em;
  }

  .home-final-contact-action strong {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: clamp(.86rem, 1.25vw, 1rem);
    line-height: 1.25;
  }

  @media (max-width: 800px) {
    .home-final-contact-inner { grid-template-columns: 1fr; width: min(100% - 24px, 1240px); }
    .home-final-contact h2 { max-width: 16ch; }
  }
</style>

<style is:global>
  /* Final Home-only polish: keep the four-room architecture, add the recovered living character. */
  body:has(.hermes-home-recovery) .site-header {
    top: .7rem;
    min-height: 68px;
    padding-inline: 1rem;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 28px;
    background: rgba(7,9,16,.58);
    box-shadow: 0 18px 50px rgba(0,0,0,.20), inset 0 1px 0 rgba(255,255,255,.06);
    backdrop-filter: blur(22px) saturate(1.12);
  }

  body:has(.hermes-home-recovery) .site-header.site-header-scrolled {
    background: rgba(7,9,16,.82);
    border-color: rgba(255,255,255,.14);
  }

  .hermes-home-recovery .home-rooms-intro h1 {
    position: relative;
    color: transparent;
    -webkit-text-fill-color: transparent;
    background: linear-gradient(105deg, #fff 0%, #fff 18%, #9e86ff 36%, #ef75b3 54%, #e8c36a 70%, #71d9ff 86%, #fff 100%);
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: home-direction-spectrum 8s ease-in-out infinite;
    filter: drop-shadow(0 0 24px rgba(124,92,255,.09));
  }

  .hermes-home-recovery .home-rooms-intro h1 em {
    position: relative;
    color: rgba(255,255,255,.62);
    -webkit-text-fill-color: rgba(255,255,255,.62);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -.02em;
    clip-path: inset(0 100% 0 0);
    animation: home-ink-write 1.7s steps(24, end) .2s forwards;
  }

  .hermes-home-recovery .home-rooms-intro h1::after {
    content: "";
    position: absolute;
    z-index: 3;
    left: .04em;
    top: 78%;
    width: 24px;
    height: 5px;
    border-radius: 999px 2px 999px 2px;
    background: linear-gradient(90deg, rgba(255,255,255,.95), #9e86ff 55%, #5ac8fa);
    box-shadow: 0 0 16px rgba(158,134,255,.55);
    transform-origin: left center;
    opacity: 0;
    animation: home-quill-travel 1.72s cubic-bezier(.18,.74,.24,1) .18s both;
  }

  .hermes-home-recovery .home-rooms-intro > p:last-child {
    position: relative;
    max-width: 430px;
    padding-left: 2.4rem;
    color: rgba(255,255,255,.52);
    font-family: var(--font-serif);
    font-size: clamp(.76rem, 1vw, .88rem);
    font-style: italic;
    line-height: 1.6;
    letter-spacing: .01em;
    clip-path: inset(0 100% 0 0);
    animation: home-ink-write 1.9s steps(32, end) 1.15s forwards;
  }

  .hermes-home-recovery .home-rooms-intro > p:last-child::before {
    content: "";
    position: absolute;
    left: 0;
    top: .75em;
    width: 1.75rem;
    height: 1px;
    background: linear-gradient(90deg, #9e86ff, rgba(90,200,250,.25));
    transform-origin: left center;
    animation: home-ink-line 1s ease 1.05s both;
  }

  .hermes-home-recovery .home-room-arrow {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .hermes-home-recovery .home-room-arrow::before {
    content: "";
    position: absolute;
    inset: 8px;
    z-index: 2;
    border-radius: 9px;
    background: url('/images/hermes-connect-mark.svg') center / contain no-repeat;
    opacity: .92;
    transition: opacity 280ms ease, transform 360ms cubic-bezier(.22,.75,.2,1);
  }

  .hermes-home-recovery .home-room-arrow::after {
    content: "";
    position: absolute;
    z-index: 1;
    inset: -45%;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0 58%, var(--room-accent) 72%, transparent 88% 100%);
    opacity: .35;
    animation: home-action-orbit 7s linear infinite;
  }

  .hermes-home-recovery .home-room-arrow > svg {
    position: relative;
    z-index: 3;
    opacity: 0;
    transform: translate(-5px, 5px);
    transition: opacity 260ms ease, transform 340ms cubic-bezier(.22,.75,.2,1);
  }

  .hermes-home-recovery .home-room:hover .home-room-arrow::before,
  .hermes-home-recovery .home-room:focus-visible .home-room-arrow::before {
    opacity: 0;
    transform: scale(.7) rotate(-10deg);
  }

  .hermes-home-recovery .home-room:hover .home-room-arrow > svg,
  .hermes-home-recovery .home-room:focus-visible .home-room-arrow > svg {
    opacity: 1;
    transform: translate(0,0);
  }

  #contact.home-contact-shell {
    position: relative;
    overflow: hidden;
    margin-top: -1px;
    border-radius: 40px 40px 0 0;
    color: #fff;
    background:
      radial-gradient(circle at 12% 10%, rgba(124,92,255,.68), transparent 32rem),
      radial-gradient(circle at 82% 8%, rgba(90,200,250,.48), transparent 30rem),
      radial-gradient(circle at 72% 90%, rgba(239,79,154,.24), transparent 28rem),
      radial-gradient(circle at 22% 95%, rgba(127,209,182,.18), transparent 24rem),
      linear-gradient(135deg, #0a0d18 0%, #17112f 42%, #0a1b31 76%, #0a121b 100%);
    background-size: 135% 135%, 145% 145%, 140% 140%, 140% 140%, 100% 100%;
    animation: home-footer-mesh 18s ease-in-out infinite alternate;
    isolation: isolate;
  }

  #contact.home-contact-shell::before {
    position: absolute;
    z-index: -1;
    inset: -20% -10%;
    background: linear-gradient(115deg, transparent 18%, rgba(255,255,255,.055) 42%, transparent 65%);
    transform: translateX(-24%);
    animation: home-footer-sheen 12s ease-in-out infinite;
    pointer-events: none;
    content: "";
  }

  #contact.home-contact-shell > .site-footer {
    background: transparent !important;
    border-top: 1px solid rgba(255,255,255,.08);
  }

  #contact.home-contact-shell .hc-launcher-panel {
    border-color: rgba(255,255,255,.13);
    background: rgba(8,10,18,.28);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.05);
    backdrop-filter: blur(16px);
  }

  #contact.home-contact-shell .hc-launcher-panel a {
    position: relative;
    gap: .5rem;
  }

  #contact.home-contact-shell .hc-launcher-panel a::before {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    border-radius: 6px;
    background: url('/images/hermes-connect-mark.svg') center / contain no-repeat;
    box-shadow: 0 0 18px rgba(124,92,255,.18);
    content: "";
  }

  @keyframes home-direction-spectrum {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @keyframes home-ink-write {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  @keyframes home-ink-line {
    from { transform: scaleX(0); opacity: 0; }
    to { transform: scaleX(1); opacity: 1; }
  }

  @keyframes home-quill-travel {
    0% { opacity: 0; transform: translateX(0) translateY(3px) rotate(-18deg) scaleX(.7); }
    10% { opacity: 1; }
    82% { opacity: 1; }
    100% { opacity: 0; transform: translateX(clamp(11rem, 34vw, 26rem)) translateY(-3px) rotate(-8deg) scaleX(1); }
  }

  @keyframes home-action-orbit { to { transform: rotate(360deg); } }

  @keyframes home-footer-mesh {
    0% { background-position: 0% 0%, 100% 0%, 100% 100%, 0% 100%, 0 0; }
    100% { background-position: 18% 12%, 82% 16%, 88% 82%, 14% 84%, 0 0; }
  }

  @keyframes home-footer-sheen {
    0%, 20% { transform: translateX(-34%); opacity: .15; }
    55% { opacity: .7; }
    80%, 100% { transform: translateX(34%); opacity: .08; }
  }

  @media (max-width: 700px) {
    body:has(.hermes-home-recovery) .site-header {
      top: .45rem;
      width: calc(100% - 1rem);
      min-height: 62px;
      padding-inline: .7rem;
      border-radius: 22px;
    }

    #contact.home-contact-shell { border-radius: 28px 28px 0 0; }

    .hermes-home-recovery .home-rooms-intro > p:last-child {
      max-width: 35ch;
      padding-left: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hermes-home-recovery .home-rooms-intro h1,
    .hermes-home-recovery .home-rooms-intro h1 em,
    .hermes-home-recovery .home-rooms-intro h1::after,
    .hermes-home-recovery .home-rooms-intro > p:last-child,
    .hermes-home-recovery .home-rooms-intro > p:last-child::before,
    .hermes-home-recovery .home-room-arrow::after,
    #contact.home-contact-shell,
    #contact.home-contact-shell::before {
      animation: none !important;
    }

    .hermes-home-recovery .home-rooms-intro h1 em,
    .hermes-home-recovery .home-rooms-intro > p:last-child {
      clip-path: none;
    }
  }
</style>