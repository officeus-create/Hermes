<script>
  const setupVehicleTransportEquipmentPrefill = () => {
    if (window.location.pathname !== "/logistics/request-vehicle-transport/") return;

    const params = new URLSearchParams(window.location.search);
    const approvedEquipment = new Set([
      "open",
      "enclosed",
      "multi_car",
      "winch_required",
      "special_review",
      "not_sure",
    ]);
    const requestedEquipment = params.get("equipment") ?? "";
    if (!approvedEquipment.has(requestedEquipment)) return;

    const form = document.querySelector<HTMLFormElement>("[data-transport-form]");
    const equipmentSelect = form?.elements.namedItem("equipment_preference");
    if (!(equipmentSelect instanceof HTMLSelectElement)) return;

    equipmentSelect.value = requestedEquipment;
    equipmentSelect.dispatchEvent(new Event("change", { bubbles: true }));
  };

  setupVehicleTransportEquipmentPrefill();
</script>
