---
import { ArrowRight, Check, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "./ContactCTA.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import type { DigitalServicePageContent } from "../data/digital-service-pages";

interface Props {
  content: DigitalServicePageContent;
}

const { content } = Astro.props;
const absoluteUrl = `https://hermeslogisticsus.com${content.slug}`;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: content.h1,
  description: content.description,
  url: absoluteUrl,
  areaServed: { "@type": "Country", name: "United States" },
  provider: { "@id": "https://hermeslogisticsus.com/#organization" },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
    { "@type": "ListItem", position: 2, name: "IT Development", item: "https://hermeslogisticsus.com/paths/technology/" },
    { "@type": "ListItem", position: 3, name: content.h1, item: absoluteUrl },
  ],
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout title={content.title} description={content.description} schema={[serviceSchema, breadcrumbSchema, faqSchema]}>
  <SiteHeader activePath="/paths/technology/" />
  <main id="main-content" class="digital-service-page">
    <section class="digital-service-hero" id="top">
      <div class="shell">
        <nav class="digital-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/paths/technology/">IT Development</a><span aria-hidden="true">/</span>
          <span aria-current="page">{content.h1}</span>
        </nav>
        <p class="eyebrow">{content.eyebrow}</p>
        <h1>{content.h1}</h1>
        <p class="digital-service-intro">{content.intro}</p>
        <div class="digital-service-actions">
          <a class="button button-primary" href="#contact">Discuss this service <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="button button-ghost" href="/case/it-development/">View the website case</a>
        </div>
        <p class="digital-review-date">Scope reviewed {content.reviewedAt}</p>
      </div>
    </section>

    <section class="section" aria-labelledby="digital-audience-title">
      <div class="shell digital-two-column">
        <div>
          <p class="eyebrow">Who this is for</p>
          <h2 id="digital-audience-title">Start with the business problem, not a feature list.</h2>
        </div>
        <ul class="digital-check-list">
          {content.audience.map((item) => <li><Check size={18} aria-hidden="true" />{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section digital-muted-section" aria-labelledby="digital-deliverables-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Service scope</p><h2 id="digital-deliverables-title">What the work can include.</h2></div>
          <p>Final deliverables depend on discovery, existing systems, content, access, integrations, compliance, and the approved project scope.</p>
        </div>
        <div class="digital-card-grid">
          {content.deliverables.map((item, index) => (
            <article>
              <span>0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="digital-process-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Process</p><h2 id="digital-process-title">Small reviewed releases instead of an uncontrolled rebuild.</h2></div>
          <p>Every phase has a visible purpose, evidence boundary, approval point, and quality check.</p>
        </div>
        <ol class="digital-process-list">
          {content.process.map((item, index) => (
            <li><span>{index + 1}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section digital-boundary-section" aria-labelledby="digital-boundary-title">
      <div class="shell digital-boundary-layout">
        <div>
          <p class="eyebrow">Clear boundaries</p>
          <h2 id="digital-boundary-title">Capabilities are scoped. Results are not guaranteed.</h2>
          <p>Hermes can research, design, build, test, measure, and improve the approved system. Platforms, search engines, customers, markets, and third parties remain outside Hermes control.</p>
        </div>
        <ul>
          {content.boundaries.map((item) => <li><ShieldCheck size={19} aria-hidden="true" />{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="digital-faq-title">
      <div class="shell digital-faq-layout">
        <div><p class="eyebrow">Frequently asked questions</p><h2 id="digital-faq-title">Questions to resolve before scope is confirmed.</h2></div>
        <div class="digital-faq-list">
          {content.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="section digital-related-section" aria-labelledby="digital-related-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Related paths</p><h2 id="digital-related-title">Continue with the right service or proof.</h2></div>
          <p>These links connect national services, the public Hermes case study, and the project brief without creating duplicate location pages.</p>
        </div>
        <div class="digital-related-links">
          {content.related.map((item) => <a href={item.href}>{item.label}<ArrowRight size={17} aria-hidden="true" /></a>)}
        </div>
      </div>
    </section>

    <ContactCTA selectedPath="IT Development" />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .digital-service-page { background: #f7f9ff; color: #10204e; }
  .digital-service-hero { padding: 9.5rem 0 5.5rem; background: radial-gradient(circle at 82% 12%, rgba(70, 107, 255, .22), transparent 35%), linear-gradient(145deg, #07143d, #122b72 58%, #1c3e8d); color: white; }
  .digital-breadcrumb { display: flex; flex-wrap: wrap; gap: .55rem; align-items: center; margin-bottom: 2rem; font-size: .9rem; color: rgba(255,255,255,.72); }
  .digital-breadcrumb a { color: inherit; }
  .digital-service-hero h1 { max-width: 900px; margin: .65rem 0 1.25rem; font-size: clamp(2.6rem, 6vw, 5rem); line-height: .98; letter-spacing: -.045em; }
  .digital-service-intro { max-width: 820px; font-size: clamp(1.08rem, 2vw, 1.3rem); line-height: 1.7; color: rgba(255,255,255,.82); }
  .digital-service-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .digital-review-date { margin-top: 1.25rem; font-size: .84rem; color: rgba(255,255,255,.62); }
  .digital-two-column, .digital-boundary-layout, .digital-faq-layout { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .digital-two-column h2, .digital-boundary-layout h2, .digital-faq-layout h2 { max-width: 620px; }
  .digital-check-list, .digital-boundary-layout ul { display: grid; gap: .9rem; list-style: none; margin: 0; padding: 0; }
  .digital-check-list li, .digital-boundary-layout li { display: flex; gap: .8rem; align-items: flex-start; padding: 1rem 1.1rem; border: 1px solid rgba(28,62,141,.13); border-radius: 16px; background: white; line-height: 1.55; }
  .digital-check-list svg, .digital-boundary-layout svg { flex: none; margin-top: .15rem; color: #315fd7; }
  .digital-muted-section { background: #eef3ff; }
  .digital-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; margin-top: 2rem; }
  .digital-card-grid article { padding: 1.5rem; border: 1px solid rgba(28,62,141,.14); border-radius: 20px; background: white; box-shadow: 0 18px 50px rgba(17,43,103,.06); }
  .digital-card-grid article > span { display: inline-flex; margin-bottom: 1.5rem; font-size: .78rem; letter-spacing: .1em; color: #315fd7; }
  .digital-card-grid h3 { margin: 0 0 .7rem; }
  .digital-card-grid p, .digital-process-list p, .digital-boundary-layout p, .digital-faq-list p { color: #526181; line-height: 1.65; }
  .digital-process-list { display: grid; gap: .85rem; list-style: none; margin: 2rem 0 0; padding: 0; }
  .digital-process-list li { display: grid; grid-template-columns: 48px 1fr; gap: 1rem; padding: 1.15rem; border-bottom: 1px solid rgba(28,62,141,.13); }
  .digital-process-list li > span { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #122b72; color: white; font-weight: 700; }
  .digital-process-list h3 { margin: 0 0 .35rem; }
  .digital-process-list p { margin: 0; }
  .digital-boundary-section { background: #08173f; color: white; }
  .digital-boundary-layout p { color: rgba(255,255,255,.72); }
  .digital-boundary-layout li { border-color: rgba(255,255,255,.12); background: rgba(255,255,255,.06); color: rgba(255,255,255,.86); }
  .digital-boundary-layout svg { color: #8fb1ff; }
  .digital-faq-list { display: grid; gap: .7rem; }
  .digital-faq-list details { border: 1px solid rgba(28,62,141,.14); border-radius: 16px; background: white; padding: 0 1.1rem; }
  .digital-faq-list summary { cursor: pointer; padding: 1.05rem 0; font-weight: 700; }
  .digital-faq-list p { margin: 0; padding: 0 0 1.1rem; }
  .digital-related-section { background: #eef3ff; }
  .digital-related-links { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .8rem; margin-top: 2rem; }
  .digital-related-links a { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: 1rem 1.15rem; border: 1px solid rgba(28,62,141,.14); border-radius: 14px; background: white; color: #10204e; font-weight: 700; }
  @media (max-width: 900px) {
    .digital-card-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .digital-two-column, .digital-boundary-layout, .digital-faq-layout { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .digital-service-hero { padding: 7.5rem 0 4rem; }
    .digital-card-grid, .digital-related-links { grid-template-columns: 1fr; }
  }
</style>
