---
import { ArrowRight, Check, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/hermes-digital-services.css";
import ContactCTA from "./ContactCTA.astro";
import HermesConnectLauncher from "./HermesConnectLauncher.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import type { DigitalServicePageContent } from "../data/digital-service-pages";

interface Props {
  content: DigitalServicePageContent;
}

type WebsiteFunnelContext = {
  project: "website_development" | "website_redesign";
  serviceGroup: "website_development" | "website_redesign";
  heroLabel: string;
  supportingLabel: string;
  note: string;
  heading: string;
  body: string;
};

type SeoFunnelContext = {
  service: "seo" | "local_seo" | "logistics_seo" | "auto_dealer_seo";
  serviceGroup: "seo_services" | "local_seo" | "logistics_seo" | "auto_dealer_seo";
  heroLabel: string;
  supportingLabel: string;
  heading: string;
  body: string;
};

const { content } = Astro.props;
const absoluteUrl = `https://hermeslogisticsus.com${content.slug}`;
const websiteFunnels: Record<string, WebsiteFunnelContext> = {
  "/services/website-development/": {
    project: "website_development",
    serviceGroup: "website_development",
    heroLabel: "Start a website project brief",
    supportingLabel: "Prepare the website brief",
    note: "The project brief prepares a structured summary for review. The website does not automatically send or store the answers.",
    heading: "Turn the website scope into a brief our development team can review.",
    body: "Choose a new website, redesign, or website-plus-SEO path, then describe the target market, pages, integrations, references, timing, languages, and investment approach.",
  },
  "/services/website-redesign/": {
    project: "website_redesign",
    serviceGroup: "website_redesign",
    heroLabel: "Start a website redesign brief",
    supportingLabel: "Prepare the redesign brief",
    note: "The redesign brief prepares a structured summary for review without automatically sending or storing the answers.",
    heading: "Protect search visibility and conversion while planning the redesign.",
    body: "Document the current website, redesign objective, target U.S. market, page range, integrations, languages, timing, and whether SEO protection is required.",
  },
};
const seoFunnels: Record<string, SeoFunnelContext> = {
  "/services/seo/": {
    service: "seo",
    serviceGroup: "seo_services",
    heroLabel: "Start an SEO review request",
    supportingLabel: "Prepare the SEO request",
    heading: "Prepare the search problem for a practical SEO review.",
    body: "Describe the business, target U.S. market, current website, search goals, current problems, access status, and planning horizon.",
  },
  "/services/local-seo/": {
    service: "local_seo",
    serviceGroup: "local_seo",
    heroLabel: "Start a local SEO review",
    supportingLabel: "Prepare the local SEO request",
    heading: "Prepare the local visibility problem for review.",
    body: "Describe the real service area, location model, current profiles, website, target searches, access status, and inquiry problem without using virtual-office location tactics.",
  },
  "/services/seo-for-logistics-companies/": {
    service: "logistics_seo",
    serviceGroup: "logistics_seo",
    heroLabel: "Start a logistics SEO review",
    supportingLabel: "Prepare the logistics SEO request",
    heading: "Connect logistics search demand to a qualified inquiry path.",
    body: "Describe the logistics services, equipment, markets, customer type, current website, Search Console access, content gaps, authority needs, and conversion problem.",
  },
  "/services/seo-for-independent-auto-dealers/": {
    service: "auto_dealer_seo",
    serviceGroup: "auto_dealer_seo",
    heroLabel: "Start an auto dealer SEO review",
    supportingLabel: "Prepare the dealer SEO request",
    heading: "Prepare local and inventory-related search problems for review.",
    body: "Describe the dealership market, website, local visibility, inventory and service content, access status, authority, and search-to-inquiry problem.",
  },
};
const websiteContext = websiteFunnels[content.slug];
const seoContext = seoFunnels[content.slug];
const websiteProjectBriefHref = websiteContext
  ? `/paths/technology/?project=${websiteContext.project}#project-brief`
  : "";
const seoIntakeHref = seoContext
  ? `/paths/marketing/?service=${seoContext.service}#contact`
  : "";
const parentLabel = seoContext ? "Marketing" : "IT Development";
const parentHref = seoContext ? "/paths/marketing/" : "/paths/technology/";
const proofHref = seoContext ? "/case/appleton-vehicle-transport-seo/" : "/case/it-development/";
const proofLabel = seoContext ? "View the SEO case" : "View the website case";
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: content.h1,
  description: content.description,
  url: absoluteUrl,
  areaServed: { "@type": "Country", name: "United States" },
  provider: { "@id": "https://hermeslogisticsus.com/#organization" },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
    { "@type": "ListItem", position: 2, name: parentLabel, item: `https://hermeslogisticsus.com${parentHref}` },
    { "@type": "ListItem", position: 3, name: content.h1, item: absoluteUrl },
  ],
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout title={content.title} description={content.description} schema={[serviceSchema, breadcrumbSchema, faqSchema]}>
  <SiteHeader activePath={parentHref} />
  <main id="main-content" class="digital-service-page">
    <section class="digital-service-hero" id="top">
      <div class="shell">
        <nav class="digital-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href={parentHref}>{parentLabel}</a><span aria-hidden="true">/</span>
          <span aria-current="page">{content.h1}</span>
        </nav>
        <p class="eyebrow">{content.eyebrow}</p>
        <h1>{content.h1}</h1>
        <p class="digital-service-intro">{content.intro}</p>
        <div class="digital-service-actions">
          {websiteContext ? (
            <a
              class="button button-primary"
              href={websiteProjectBriefHref}
              data-website-project-cta
              data-service-group={websiteContext.serviceGroup}
            >
              {websiteContext.heroLabel} <ArrowRight size={18} aria-hidden="true" />
            </a>
          ) : seoContext ? (
            <a
              class="button button-primary"
              href={seoIntakeHref}
              data-seo-service-cta
              data-service-group={seoContext.serviceGroup}
            >
              {seoContext.heroLabel} <ArrowRight size={18} aria-hidden="true" />
            </a>
          ) : (
            <a class="button button-primary" href="#contact">Discuss this service <ArrowRight size={18} aria-hidden="true" /></a>
          )}
          <a class="button button-ghost" href={proofHref}>{proofLabel}</a>
        </div>
        {websiteContext && <p class="digital-project-note">{websiteContext.note}</p>}
        {seoContext && (
          <p class="digital-project-note">The SEO intake opens with the relevant service context selected. You review the prepared summary before choosing the email handoff; answers are not automatically sent or stored, and rankings, traffic, leads, revenue, or timing are not guaranteed.</p>
        )}
        <p class="digital-review-date">Scope reviewed {content.reviewedAt}</p>
      </div>
    </section>

    <section class="section" aria-labelledby="digital-audience-title">
      <div class="shell digital-two-column">
        <div>
          <p class="eyebrow">Who this is for</p>
          <h2 id="digital-audience-title">Start with the business problem, not a feature list.</h2>
        </div>
        <ul class="digital-check-list">
          {content.audience.map((item) => <li><Check size={18} aria-hidden="true" />{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section digital-muted-section" aria-labelledby="digital-deliverables-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Service scope</p><h2 id="digital-deliverables-title">What the work can include.</h2></div>
          <p>Final deliverables depend on discovery, existing systems, content, access, integrations, compliance, and the approved project scope.</p>
        </div>
        <div class="digital-card-grid">
          {content.deliverables.map((item, index) => (
            <article>
              <span>0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="digital-process-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Process</p><h2 id="digital-process-title">Small reviewed releases instead of an uncontrolled rebuild.</h2></div>
          <p>Every phase has a visible purpose, evidence boundary, approval point, and quality check.</p>
        </div>
        <ol class="digital-process-list">
          {content.process.map((item, index) => (
            <li><span>{index + 1}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section digital-boundary-section" aria-labelledby="digital-boundary-title">
      <div class="shell digital-boundary-layout">
        <div>
          <p class="eyebrow">Clear boundaries</p>
          <h2 id="digital-boundary-title">Capabilities are scoped. Results are not guaranteed.</h2>
          <p>Hermes can research, design, build, test, measure, and improve the approved system. Platforms, search engines, customers, markets, and third parties remain outside Hermes control.</p>
        </div>
        <ul>
          {content.boundaries.map((item) => <li><ShieldCheck size={19} aria-hidden="true" />{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="digital-faq-title">
      <div class="shell digital-faq-layout">
        <div><p class="eyebrow">Frequently asked questions</p><h2 id="digital-faq-title">Questions to resolve before scope is confirmed.</h2></div>
        <div class="digital-faq-list">
          {content.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="section digital-related-section" aria-labelledby="digital-related-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Related paths</p><h2 id="digital-related-title">Continue with the right service or proof.</h2></div>
          <p>These links connect national services, the public Hermes case study, and the project brief without creating duplicate location pages.</p>
        </div>
        <div class="digital-related-links">
          {content.related.map((item) => <a href={item.href}>{item.label}<ArrowRight size={17} aria-hidden="true" /></a>)}
        </div>
      </div>
    </section>

    {websiteContext && (
      <section class="section digital-project-cta" aria-labelledby="website-project-cta-title">
        <div class="shell digital-project-cta-card">
          <div>
            <p class="eyebrow">Structured project intake</p>
            <h2 id="website-project-cta-title">{websiteContext.heading}</h2>
            <p>{websiteContext.body} You review the summary before choosing the email handoff.</p>
          </div>
          <a
            class="button button-primary"
            href={websiteProjectBriefHref}
            data-website-project-cta
            data-service-group={websiteContext.serviceGroup}
          >
            {websiteContext.supportingLabel} <ArrowRight size={18} aria-hidden="true" />
          </a>
        </div>
      </section>
    )}

    {seoContext && (
      <section class="section digital-project-cta" aria-labelledby="seo-intake-cta-title">
        <div class="shell digital-project-cta-card">
          <div>
            <p class="eyebrow">Structured SEO intake</p>
            <h2 id="seo-intake-cta-title">{seoContext.heading}</h2>
            <p>{seoContext.body} Hermes reviews scope and evidence without guaranteeing search-engine or commercial outcomes.</p>
          </div>
          <a
            class="button button-primary"
            href={seoIntakeHref}
            data-seo-service-cta
            data-service-group={seoContext.serviceGroup}
          >
            {seoContext.supportingLabel} <ArrowRight size={18} aria-hidden="true" />
          </a>
        </div>
      </section>
    )}

    <HermesConnectLauncher variant="banner" context={seoContext ? "marketing" : "general"} />
    <ContactCTA selectedPath={seoContext ? "ProgressoPro" : "IT Development"} />
  </main>
  <SiteFooter />
</BaseLayout>
