---
import { ArrowRight, Gift, LogIn } from "@lucide/astro";
import {
  REPAIR_SHOP_FOUNDING_PRICE_USD,
  REPAIR_SHOP_ONLINE_BILLING_ENABLED,
  REPAIR_SHOP_SETUP_ACCESS_ENABLED,
  REPAIR_SHOP_SETUP_ACCESS_PRICE_USD,
} from "../data/hermes-connect-repair-shop-launch";

interface Props {
  compact?: boolean;
  showCta?: boolean;
}

const { compact = false, showCta = true } = Astro.props;
---

<section
  hidden
  class:list={["repair-free-launch", compact && "is-compact"]}
  data-repair-free-launch
  data-billing-enabled={String(REPAIR_SHOP_ONLINE_BILLING_ENABLED)}
  data-launch-state={REPAIR_SHOP_SETUP_ACCESS_ENABLED ? "open" : "closed"}
  data-setup-price={String(REPAIR_SHOP_SETUP_ACCESS_PRICE_USD)}
  data-founding-price={String(REPAIR_SHOP_FOUNDING_PRICE_USD)}
  aria-labelledby="repair-free-launch-title"
>
  <div class="launch-icon" aria-hidden="true"><Gift size={20} /></div>
  <div class="launch-copy">
    <p class="launch-kicker" data-launch-kicker>Free setup access</p>
    <h2 id="repair-free-launch-title" data-launch-title>Use Hermes Connect free while we configure it for your shop.</h2>
    <p data-launch-body>The standard Founding Shop price is $99/month. During your setup period, the Hermes Connect software fee is $0 while we help configure your shop profile, services, availability, booking workflow, and CRM.</p>
    <p class="launch-policy" data-launch-policy>When setup is complete, Hermes confirms paid activation and the invoice with you before billing. No card is charged during setup.</p>
    <p class="launch-catalog" data-launch-catalog>After your business profile is complete, you can approve a free public Hermes Catalog listing. Hermes develops the directory for SEO, GEO, local search, and AI discovery. Search engines control indexing and rankings; traffic and leads are not guaranteed.</p>
  </div>

  {showCta && (
    <div class="launch-actions">
      <a class="launch-owner-cta" data-owner-cta href="/services/hermes-connect/repair-shops/auth/?mode=login">
        <LogIn size={16} aria-hidden="true" /><span data-owner-cta-text>Sign in to my shop</span>
      </a>
      <a class="launch-cta" data-launch-cta href={REPAIR_SHOP_SETUP_ACCESS_ENABLED ? "/services/hermes-connect/repair-shops/auth/?mode=register" : "/services/hermes-connect/repair-shops/plan/"}>
        {REPAIR_SHOP_SETUP_ACCESS_ENABLED ? "Start free setup" : "View current plan"} <ArrowRight size={16} aria-hidden="true" />
      </a>
      <a class="launch-plan-cta" data-plan-cta href="/services/hermes-connect/repair-shops/plan/">View current plan</a>
    </div>
  )}
</section>

<script>
  const strings: Record<string, Record<string, string>> = {
    en: {
      kicker: "Free setup access",
      title: "Use Hermes Connect free while we configure it for your shop.",
      body: "The standard Founding Shop price is $99/month. During your setup period, the Hermes Connect software fee is $0 while we help configure your shop profile, services, availability, booking workflow, and CRM.",
      policy: "When setup is complete, Hermes confirms paid activation and the invoice with you before billing. No card is charged during setup.",
      catalog: "After your business profile is complete, you can approve a free public Hermes Catalog listing. Hermes develops the directory for SEO, GEO, local search, and AI discovery. Search engines control indexing and rankings; traffic and leads are not guaranteed.",
      cta: "Start free setup", plan: "View current plan", signin: "Sign in to my shop", dashboard: "Open my dashboard",
    },
    ru: {
      kicker: "Бесплатно на время настройки",
      title: "Пользуйтесь Hermes Connect бесплатно, пока мы настраиваем систему под ваше СТО.",
      body: "Стандартная цена Founding Shop — $99 в месяц. На период настройки стоимость Hermes Connect для вас — $0, пока мы помогаем настроить профиль СТО, услуги, доступность, запись клиентов и CRM.",
      policy: "После завершения настройки Hermes отдельно согласует с вами платную активацию и счет. Во время настройки банковская карта не списывается.",
      catalog: "После заполнения профиля бизнеса вы можете одобрить бесплатную публичную карточку в Hermes Catalog. Мы развиваем каталог под SEO, GEO, локальный поиск и поиск через AI. Индексацию и позиции определяют поисковые системы; трафик и лиды не гарантируются.",
      cta: "Начать бесплатную настройку", plan: "Посмотреть тариф", signin: "Войти в кабинет СТО", dashboard: "Открыть мой кабинет",
    },
    uk: {
      kicker: "Безкоштовно на час налаштування",
      title: "Користуйтеся Hermes Connect безкоштовно, поки ми налаштовуємо систему під ваше СТО.",
      body: "Стандартна ціна Founding Shop — $99 на місяць. Під час налаштування вартість Hermes Connect для вас — $0, поки ми допомагаємо налаштувати профіль, послуги, доступність, запис клієнтів і CRM.",
      policy: "Після завершення налаштування Hermes окремо погодить з вами платну активацію та рахунок. Під час налаштування картка не списується.",
      catalog: "Після заповнення профілю бізнесу ви можете схвалити безкоштовну публічну картку в Hermes Catalog. Ми розвиваємо каталог для SEO, GEO, локального та AI-пошуку. Індексацію й позиції визначають пошукові системи; трафік і ліди не гарантуються.",
      cta: "Почати безкоштовне налаштування", plan: "Переглянути тариф", signin: "Увійти до кабінету СТО", dashboard: "Відкрити мій кабінет",
    },
    es: {
      kicker: "Gratis durante la configuración",
      title: "Usa Hermes Connect gratis mientras configuramos el sistema para tu taller.",
      body: "El precio estándar de Founding Shop es de $99 al mes. Durante la configuración, la tarifa de software es de $0 mientras te ayudamos a configurar el perfil, servicios, disponibilidad, reservas y CRM.",
      policy: "Cuando termine la configuración, Hermes confirmará contigo la activación de pago y la factura antes de cobrar. No se carga ninguna tarjeta durante la configuración.",
      catalog: "Cuando completes el perfil del negocio, puedes aprobar una ficha pública gratuita en Hermes Catalog. Desarrollamos el directorio para SEO, GEO, búsqueda local y descubrimiento por IA. No se garantizan posiciones, tráfico ni clientes potenciales.",
      cta: "Empezar configuración gratis", plan: "Ver plan actual", signin: "Entrar a mi taller", dashboard: "Abrir mi panel",
    },
    it: {
      kicker: "Gratis durante la configurazione",
      title: "Usa Hermes Connect gratis mentre configuriamo il sistema per la tua officina.",
      body: "Il prezzo standard Founding Shop è $99 al mese. Durante la configurazione il costo software è $0 mentre aiutiamo a impostare profilo, servizi, disponibilità, prenotazioni e CRM.",
      policy: "Al termine della configurazione Hermes conferma con te l'attivazione a pagamento e la fattura prima di qualsiasi addebito. Nessuna carta viene addebitata durante la configurazione.",
      catalog: "Dopo aver completato il profilo aziendale puoi approvare una scheda pubblica gratuita in Hermes Catalog. Sviluppiamo la directory per SEO, GEO, ricerca locale e scoperta tramite AI. Posizionamenti, traffico e lead non sono garantiti.",
      cta: "Avvia configurazione gratuita", plan: "Vedi piano attuale", signin: "Accedi alla mia officina", dashboard: "Apri il mio pannello",
    },
    fr: {
      kicker: "Gratuit pendant la configuration",
      title: "Utilisez Hermes Connect gratuitement pendant que nous configurons le système pour votre atelier.",
      body: "Le tarif standard Founding Shop est de 99 $/mois. Pendant la configuration, le logiciel est à 0 $ tandis que nous vous aidons à configurer le profil, les services, les disponibilités, les réservations et le CRM.",
      policy: "Une fois la configuration terminée, Hermes confirme avec vous l'activation payante et la facture avant toute facturation. Aucune carte n'est débitée pendant la configuration.",
      catalog: "Après avoir complété le profil de l'entreprise, vous pouvez approuver une fiche publique gratuite dans Hermes Catalog. Nous développons l'annuaire pour le SEO, le GEO, la recherche locale et la découverte par IA. Les positions, le trafic et les prospects ne sont pas garantis.",
      cta: "Commencer gratuitement", plan: "Voir le forfait", signin: "Me connecter à mon atelier", dashboard: "Ouvrir mon tableau de bord",
    },
  };

  const supported = new Set(Object.keys(strings));
  const params = new URLSearchParams(window.location.search);
  const requested = params.get("lang") || document.documentElement.lang || "en";
  const locale = supported.has(requested) ? requested : "en";
  const copy = strings[locale] || strings.en;
  const route = window.location.pathname.replace(/\/+$/, "");
  const repairRoot = "/services/hermes-connect/repair-shops";
  const offerId = "repair_shop_free_during_setup_2026";

  const setText = (root: Element, selector: string, value: string) => {
    const node = root.querySelector(selector);
    if (node) node.textContent = value;
  };

  const localizeHref = (href: string) => {
    const url = new URL(href, window.location.origin);
    if (locale === "en") url.searchParams.delete("lang");
    else url.searchParams.set("lang", locale);
    return `${url.pathname}${url.search}${url.hash}`;
  };

  const placeOffer = (root: HTMLElement) => {
    let anchor: Element | null = null;
    if (route === repairRoot) anchor = document.querySelector(".repair-live-hero .repair-lead");
    else if (route === `${repairRoot}/auth`) {
      if (params.get("mode") !== "register") return false;
      anchor = document.querySelector("#auth-forms .auth-header");
      root.classList.add("is-compact");
    } else if (route === `${repairRoot}/plan`) anchor = document.querySelector(".plan-page .hero-copy .lead");
    if (!anchor) return false;
    anchor.insertAdjacentElement("afterend", root);
    root.hidden = false;
    return true;
  };

  document.querySelectorAll<HTMLElement>("[data-repair-free-launch]").forEach((root) => {
    if (!placeOffer(root)) {
      root.remove();
      return;
    }

    const setupOpen = root.dataset.launchState === "open";
    const cta = root.querySelector<HTMLAnchorElement>("[data-launch-cta]");
    const ownerCta = root.querySelector<HTMLAnchorElement>("[data-owner-cta]");
    const planCta = root.querySelector<HTMLAnchorElement>("[data-plan-cta]");

    setText(root, "[data-launch-kicker]", copy.kicker);
    setText(root, "[data-launch-title]", copy.title);
    setText(root, "[data-launch-body]", copy.body);
    setText(root, "[data-launch-policy]", copy.policy);
    setText(root, "[data-launch-catalog]", copy.catalog);

    if (ownerCta) {
      setText(root, "[data-owner-cta-text]", copy.signin);
      ownerCta.href = localizeHref(`${repairRoot}/auth/?mode=login`);
      ownerCta.addEventListener("click", () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "connect_owner_signin_cta", product: "repair_shops" });
      });
      fetch("/api/auth/me", { credentials: "same-origin", headers: { Accept: "application/json" } })
        .then((response) => response.ok ? response.json() : null)
        .then((data) => {
          if (!data?.success || !data?.specialist) return;
          setText(root, "[data-owner-cta-text]", copy.dashboard);
          ownerCta.href = localizeHref(`${repairRoot}/dashboard/`);
          ownerCta.dataset.sessionActive = "true";
        })
        .catch(() => {});
    }

    if (cta) {
      const textNode = Array.from(cta.childNodes).find((node) => node.nodeType === Node.TEXT_NODE);
      if (textNode) textNode.textContent = (setupOpen ? copy.cta : copy.plan) + " ";
      cta.href = localizeHref(setupOpen ? `${repairRoot}/auth/?mode=register` : `${repairRoot}/plan/`);
      cta.addEventListener("click", () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "connect_free_setup_registration_cta", product: "repair_shops", offer: offerId });
      });
    }
    if (planCta) {
      planCta.textContent = copy.plan;
      planCta.href = localizeHref(`${repairRoot}/plan/`);
      planCta.addEventListener("click", () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "connect_plan_view_cta", product: "repair_shops", offer: offerId });
      });
    }

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: "connect_free_setup_offer_view",
      product: "repair_shops",
      offer: offerId,
      state: setupOpen ? "open" : "closed",
      setup_price_usd: 0,
      founding_price_usd: 99,
    });
  });
</script>

<style>
  .repair-free-launch[hidden]{display:none!important}
  .repair-free-launch{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:1rem;align-items:center;margin:1.1rem 0 1.4rem;padding:1rem 1.05rem;border:1px solid rgba(110,231,183,.22);border-radius:18px;background:linear-gradient(135deg,rgba(16,185,129,.095),rgba(124,92,255,.075));box-shadow:0 18px 50px rgba(0,0,0,.12);color:#f8fafc}
  .launch-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:rgba(110,231,183,.12);color:#9ff0cf}
  .launch-copy{min-width:0}
  .launch-kicker{margin:0 0 .25rem;color:#75e7bd;font-size:.72rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
  .launch-copy h2{margin:0;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.25}
  .launch-copy>p:not(.launch-kicker){margin:.35rem 0 0;color:#bac5d4;font-size:.84rem;line-height:1.5}
  .launch-policy{color:#9fabbc!important;font-size:.77rem!important}
  .launch-catalog{color:#a9bfd3!important;font-size:.77rem!important}
  .launch-actions{display:flex;flex-direction:column;gap:.45rem;min-width:190px}
  .launch-cta,.launch-owner-cta,.launch-plan-cta{display:inline-flex;align-items:center;justify-content:center;gap:.35rem;min-height:44px;padding:.62rem .8rem;border-radius:11px;text-decoration:none;font-size:.78rem;font-weight:850}
  .launch-cta{background:#82e8c1;color:#07120e}
  .launch-owner-cta,.launch-plan-cta{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.035);color:#f8fafc}
  .launch-plan-cta{min-height:44px;font-size:.74rem}
  .repair-free-launch.is-compact{grid-template-columns:auto 1fr;margin:.8rem 0;padding:.85rem}
  .repair-free-launch.is-compact .launch-catalog{display:none}
  @media(max-width:820px){.repair-free-launch{grid-template-columns:auto 1fr}.launch-actions{grid-column:1/-1;flex-direction:row;min-width:0}.launch-actions>a{flex:1}}
  @media(max-width:520px){.repair-free-launch{grid-template-columns:1fr}.launch-icon{display:none}.launch-actions{flex-direction:column}.launch-actions>a{width:100%;box-sizing:border-box}}
</style>
