---
import { ArrowRight, Gift, LogIn } from "@lucide/astro";
import { REPAIR_SHOP_LAUNCH_PROMOTION, REPAIR_SHOP_ONLINE_BILLING_ENABLED } from "../data/hermes-connect-repair-shop-launch";

interface Props { compact?: boolean; showCta?: boolean; }
const { compact = false, showCta = true } = Astro.props;
---

<section class:list={["repair-free-launch", compact && "is-compact"]} data-repair-free-launch data-promotion-active={String(REPAIR_SHOP_LAUNCH_PROMOTION.active)} data-billing-enabled={String(REPAIR_SHOP_ONLINE_BILLING_ENABLED)} aria-labelledby="repair-free-launch-title">
  <div class="launch-icon" aria-hidden="true"><Gift size={20} /></div>
  <div class="launch-copy">
    <p class="launch-kicker">Launch promotion active</p>
    <h2 id="repair-free-launch-title">Repair Shop Launch Promotion: $3/month.</h2>
    <p>Create your Repair Shop owner account, configure the workflow, and request paid activation when you are ready.</p>
    <p class="launch-policy">No card is collected on this website. Hermes confirms the shop, billing details, and invoice before paid activation.</p>
  </div>
  {showCta && <div class="launch-actions">
    <a class="launch-owner-cta" href="/services/hermes-connect/repair-shops/auth/?mode=login"><LogIn size={16} aria-hidden="true" />Sign in to my shop</a>
    <a class="launch-cta" href="/services/hermes-connect/repair-shops/auth/?mode=register">Register my shop <ArrowRight size={16} aria-hidden="true" /></a>
  </div>}
</section>

<style>
  .repair-free-launch{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;margin:18px 0;padding:16px;border:1px solid #bddbcf;border-radius:16px;background:#f4fbf6;color:#173c2b}.launch-icon{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:#d8f1e2;color:#17613b}.launch-kicker{margin:0 0 4px;font-size:.74rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase;color:#17613b}.launch-copy h2,.launch-copy p{margin:0}.launch-copy h2{font-size:1.06rem}.launch-copy p{margin-top:5px;color:#426252;line-height:1.45}.launch-policy{font-size:.86rem}.launch-actions{display:flex;flex-wrap:wrap;gap:8px}.launch-actions a{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:0 12px;border-radius:10px;text-decoration:none;font-weight:800}.launch-owner-cta{border:1px solid #aacdb9;color:#174b30}.launch-cta{background:#17613b;color:#fff}.is-compact{padding:12px}.is-compact .launch-policy{display:none}@media(max-width:720px){.repair-free-launch{grid-template-columns:auto 1fr}.launch-actions{grid-column:1/-1}.launch-actions a{flex:1;justify-content:center}}
</style>
