---
import { ArrowRight, Clock3, Gift } from "@lucide/astro";
import {
  REPAIR_SHOP_FREE_REGISTRATION_END_ISO,
  REPAIR_SHOP_ONLINE_BILLING_ENABLED,
} from "../data/hermes-connect-repair-shop-launch";

interface Props {
  compact?: boolean;
  showCta?: boolean;
}

const { compact = false, showCta = true } = Astro.props;
---

<section
  hidden
  class:list={["repair-free-launch", compact && "is-compact"]}
  data-repair-free-launch
  data-deadline={REPAIR_SHOP_FREE_REGISTRATION_END_ISO}
  data-billing-enabled={String(REPAIR_SHOP_ONLINE_BILLING_ENABLED)}
  aria-labelledby="repair-free-launch-title"
>
  <div class="launch-icon" aria-hidden="true"><Gift size={20} /></div>
  <div class="launch-copy">
    <p class="launch-kicker" data-launch-kicker>Free registration</p>
    <h2 id="repair-free-launch-title" data-launch-title>Free repair shop registration through September 15.</h2>
    <p data-launch-body>Create your Repair Shop owner account and start using the current Hermes Connect workflow without a card.</p>
    <p class="launch-policy" data-launch-policy>Free registration closes at midnight Central Time after September 15, 2026. Existing accounts keep access.</p>
  </div>

  <div class="launch-timer-wrap">
    <div class="launch-timer-label"><Clock3 size={15} aria-hidden="true" /><span data-launch-timer-label>Free-registration countdown</span></div>
    <div class="launch-timer" data-launch-timer role="timer" aria-live="off">
      <div><strong data-days>00</strong><span data-days-label>days</span></div>
      <div><strong data-hours>00</strong><span data-hours-label>hours</span></div>
      <div><strong data-minutes>00</strong><span data-minutes-label>minutes</span></div>
      <div><strong data-seconds>00</strong><span data-seconds-label>seconds</span></div>
    </div>
    <p class="launch-status" data-launch-status aria-live="polite"></p>
    {showCta && <a class="launch-cta" data-launch-cta href="/services/hermes-connect/repair-shops/auth/?mode=register">Register free <ArrowRight size={16} aria-hidden="true" /></a>}
  </div>
</section>

<script>
  const strings: Record<string, Record<string, string>> = {
    en: {
      kicker: "Free registration",
      title: "Free repair shop registration through September 15.",
      body: "Create your Repair Shop owner account and start using the current Hermes Connect workflow without a card.",
      policy: "Free registration closes at midnight Central Time after September 15, 2026. Existing accounts keep access.",
      timer: "Free-registration countdown",
      days: "days", hours: "hours", minutes: "minutes", seconds: "seconds",
      cta: "Register free",
      endedTitle: "Free repair shop registration ended September 15.",
      ended: "New Repair Shop registrations now use the current Founding Shop Plan.",
      plan: "View current plan",
    },
    ru: {
      kicker: "Бесплатная регистрация",
      title: "Бесплатная регистрация СТО до 15 сентября включительно.",
      body: "Создайте аккаунт владельца СТО и начните пользоваться текущим Hermes Connect без банковской карты.",
      policy: "Бесплатная регистрация закрывается после 15 сентября 2026 года в 00:00 по Central Time. Уже созданные аккаунты сохраняют доступ.",
      timer: "До конца бесплатной регистрации",
      days: "дней", hours: "часов", minutes: "минут", seconds: "секунд",
      cta: "Зарегистрироваться бесплатно",
      endedTitle: "Бесплатная регистрация СТО завершилась 15 сентября.",
      ended: "Новые регистрации СТО теперь проходят через текущий тариф Founding Shop.",
      plan: "Посмотреть тариф",
    },
    uk: {
      kicker: "Безкоштовна реєстрація",
      title: "Безкоштовна реєстрація СТО до 15 вересня включно.",
      body: "Створіть акаунт власника СТО та почніть користуватися поточним Hermes Connect без банківської картки.",
      policy: "Безкоштовна реєстрація закривається після 15 вересня 2026 року о 00:00 за Central Time. Уже створені акаунти зберігають доступ.",
      timer: "До завершення безкоштовної реєстрації",
      days: "днів", hours: "годин", minutes: "хвилин", seconds: "секунд",
      cta: "Зареєструватися безкоштовно",
      endedTitle: "Безкоштовна реєстрація СТО завершилася 15 вересня.",
      ended: "Нові реєстрації СТО тепер проходять через поточний тариф Founding Shop.",
      plan: "Переглянути тариф",
    },
    es: {
      kicker: "Registro gratuito",
      title: "Registro gratuito de talleres hasta el 15 de septiembre inclusive.",
      body: "Crea tu cuenta de propietario y empieza a usar el flujo actual de Hermes Connect sin tarjeta.",
      policy: "El registro gratuito cierra después del 15 de septiembre de 2026 a medianoche, hora central. Las cuentas existentes conservan el acceso.",
      timer: "Cuenta regresiva del registro gratuito",
      days: "días", hours: "horas", minutes: "minutos", seconds: "segundos",
      cta: "Registrarme gratis",
      endedTitle: "El registro gratuito de talleres terminó el 15 de septiembre.",
      ended: "Las nuevas altas de talleres pasan ahora por el plan Founding Shop vigente.",
      plan: "Ver plan actual",
    },
    it: {
      kicker: "Registrazione gratuita",
      title: "Registrazione gratuita dell’officina fino al 15 settembre incluso.",
      body: "Crea l’account proprietario e inizia a usare l’attuale flusso Hermes Connect senza carta.",
      policy: "La registrazione gratuita chiude dopo il 15 settembre 2026 a mezzanotte, Central Time. Gli account esistenti mantengono l’accesso.",
      timer: "Conto alla rovescia registrazione gratuita",
      days: "giorni", hours: "ore", minutes: "minuti", seconds: "secondi",
      cta: "Registrati gratis",
      endedTitle: "La registrazione gratuita delle officine è terminata il 15 settembre.",
      ended: "Le nuove registrazioni passano ora dal piano Founding Shop corrente.",
      plan: "Vedi piano attuale",
    },
    fr: {
      kicker: "Inscription gratuite",
      title: "Inscription gratuite des ateliers jusqu’au 15 septembre inclus.",
      body: "Créez votre compte propriétaire et commencez à utiliser le flux Hermes Connect actuel sans carte.",
      policy: "L’inscription gratuite ferme après le 15 septembre 2026 à minuit, heure du Centre. Les comptes existants conservent leur accès.",
      timer: "Compte à rebours de l’inscription gratuite",
      days: "jours", hours: "heures", minutes: "minutes", seconds: "secondes",
      cta: "S’inscrire gratuitement",
      endedTitle: "L’inscription gratuite des ateliers s’est terminée le 15 septembre.",
      ended: "Les nouvelles inscriptions passent désormais par le forfait Founding Shop en vigueur.",
      plan: "Voir le forfait",
    },
  };

  const supported = new Set(Object.keys(strings));
  const params = new URLSearchParams(window.location.search);
  const requested = params.get("lang") || document.documentElement.lang || "en";
  const locale = supported.has(requested) ? requested : "en";
  const copy = strings[locale] || strings.en;
  const route = window.location.pathname.replace(/\/+$/, "");
  const repairRoot = "/services/hermes-connect/repair-shops";
  const offerId = "free_registration_through_2026_09_15";

  const setText = (root: Element, selector: string, value: string) => {
    const node = root.querySelector(selector);
    if (node) node.textContent = value;
  };

  const localizeHref = (href: string) => {
    const url = new URL(href, window.location.origin);
    if (locale === "en") url.searchParams.delete("lang");
    else url.searchParams.set("lang", locale);
    return `${url.pathname}${url.search}${url.hash}`;
  };

  const placeOffer = (root: HTMLElement) => {
    let anchor: Element | null = null;
    if (route === repairRoot) anchor = document.querySelector(".repair-live-hero .repair-lead");
    else if (route === `${repairRoot}/auth`) {
      anchor = document.querySelector("#auth-forms .auth-header");
      root.classList.add("is-compact");
    } else if (route === `${repairRoot}/plan`) anchor = document.querySelector(".plan-page .hero-copy .lead");
    if (!anchor) return false;
    anchor.insertAdjacentElement("afterend", root);
    root.hidden = false;
    return true;
  };

  const closeFreeRegistrationUi = () => {
    if (route !== `${repairRoot}/auth`) return;
    const registerTab = document.querySelector<HTMLButtonElement>('.tab-btn[data-tab="register"]');
    const registerForm = document.querySelector<HTMLElement>("#register-form");
    const loginTab = document.querySelector<HTMLButtonElement>('.tab-btn[data-tab="login"]');
    const loginForm = document.querySelector<HTMLElement>("#login-form");
    if (registerTab) {
      registerTab.disabled = true;
      registerTab.hidden = true;
      registerTab.setAttribute("aria-hidden", "true");
    }
    if (registerForm) {
      registerForm.classList.remove("active");
      registerForm.hidden = true;
    }
    if (loginTab) loginTab.classList.add("active");
    if (loginForm) loginForm.classList.add("active");
  };

  document.querySelectorAll<HTMLElement>("[data-repair-free-launch]").forEach((root) => {
    if (!placeOffer(root)) {
      root.remove();
      return;
    }

    const deadlineMs = Date.parse(root.dataset.deadline || "");
    if (!Number.isFinite(deadlineMs)) {
      root.remove();
      return;
    }
    const cta = root.querySelector<HTMLAnchorElement>("[data-launch-cta]");

    setText(root, "[data-launch-kicker]", copy.kicker);
    setText(root, "[data-launch-title]", copy.title);
    setText(root, "[data-launch-body]", copy.body);
    setText(root, "[data-launch-policy]", copy.policy);
    setText(root, "[data-launch-timer-label]", copy.timer);
    setText(root, "[data-days-label]", copy.days);
    setText(root, "[data-hours-label]", copy.hours);
    setText(root, "[data-minutes-label]", copy.minutes);
    setText(root, "[data-seconds-label]", copy.seconds);
    if (cta) {
      const textNode = Array.from(cta.childNodes).find((node) => node.nodeType === Node.TEXT_NODE);
      if (textNode) textNode.textContent = copy.cta + " ";
      cta.href = localizeHref(cta.getAttribute("href") || `${repairRoot}/auth/?mode=register`);
      cta.addEventListener("click", () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "connect_free_registration_cta", product: "repair_shops", offer: offerId });
      });
    }

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: "connect_free_registration_offer_view",
      product: "repair_shops",
      offer: offerId,
      state: Date.now() < deadlineMs ? "open" : "ended",
    });

    let timer: number | undefined;
    const tick = () => {
      const remaining = Math.max(0, deadlineMs - Date.now());
      const totalSeconds = Math.floor(remaining / 1000);
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      setText(root, "[data-days]", String(days).padStart(2, "0"));
      setText(root, "[data-hours]", String(hours).padStart(2, "0"));
      setText(root, "[data-minutes]", String(minutes).padStart(2, "0"));
      setText(root, "[data-seconds]", String(seconds).padStart(2, "0"));

      if (remaining > 0) return;
      if (timer) window.clearInterval(timer);

      setText(root, "[data-launch-title]", copy.endedTitle);
      setText(root, "[data-launch-status]", copy.ended);
      root.dataset.expired = "true";
      closeFreeRegistrationUi();
      window.setTimeout(closeFreeRegistrationUi, 0);
      if (cta) {
        const textNode = Array.from(cta.childNodes).find((node) => node.nodeType === Node.TEXT_NODE);
        if (textNode) textNode.textContent = copy.plan + " ";
        cta.href = localizeHref(`${repairRoot}/plan/`);
      }
    };

    tick();
    if (deadlineMs > Date.now()) timer = window.setInterval(tick, 1000);
  });
</script>

<style>
  .repair-free-launch[hidden]{display:none!important}.repair-free-launch{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:1rem;align-items:center;margin:1.1rem 0 1.4rem;padding:1rem 1.05rem;border:1px solid rgba(110,231,183,.22);border-radius:18px;background:linear-gradient(135deg,rgba(16,185,129,.095),rgba(124,92,255,.075));box-shadow:0 18px 50px rgba(0,0,0,.12);color:#f8fafc}.launch-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:rgba(110,231,183,.12);color:#9ff0cf}.launch-copy{min-width:0}.launch-kicker{margin:0 0 .25rem;color:#75e7bd;font-size:.72rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.launch-copy h2{margin:0;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.25}.launch-copy>p:not(.launch-kicker){margin:.35rem 0 0;color:#bac5d4;font-size:.86rem;line-height:1.5}.launch-policy{color:#8f9bad!important;font-size:.75rem!important}.launch-timer-wrap{min-width:320px}.launch-timer-label{display:flex;align-items:center;justify-content:flex-end;gap:.35rem;margin-bottom:.45rem;color:#9ca8b9;font-size:.72rem;font-weight:800}.launch-timer{display:grid;grid-template-columns:repeat(4,1fr);gap:.35rem}.launch-timer>div{min-width:62px;padding:.5rem .45rem;border:1px solid rgba(255,255,255,.09);border-radius:10px;background:rgba(5,10,18,.48);text-align:center}.launch-timer strong{display:block;font-variant-numeric:tabular-nums;font-size:1.12rem;line-height:1.1}.launch-timer span{display:block;margin-top:.18rem;color:#8f9bad;font-size:.62rem}.launch-status{margin:.45rem 0 0;color:#8ff0c7;font-size:.72rem;font-weight:800;text-align:right}.launch-cta{display:inline-flex;align-items:center;justify-content:center;gap:.35rem;float:right;min-height:42px;margin-top:.55rem;padding:.55rem .75rem;border-radius:10px;background:#f8fafc;color:#0b1220;text-decoration:none;font-size:.78rem;font-weight:900}.repair-free-launch.is-compact{grid-template-columns:auto minmax(0,1fr);padding:.85rem}.repair-free-launch.is-compact .launch-timer-wrap{grid-column:1/-1;min-width:0}.repair-free-launch.is-compact .launch-timer-label,.repair-free-launch.is-compact .launch-status{text-align:left;justify-content:flex-start}.repair-free-launch.is-compact .launch-cta{float:none;width:100%;box-sizing:border-box}.repair-free-launch[data-expired="true"] .launch-timer{opacity:.6}@media(max-width:760px){.repair-free-launch{grid-template-columns:auto minmax(0,1fr);align-items:start}.launch-timer-wrap{grid-column:1/-1;min-width:0}.launch-timer-label,.launch-status{text-align:left;justify-content:flex-start}.launch-cta{float:none;width:100%;box-sizing:border-box}.launch-timer>div{min-width:0;padding:.5rem .2rem}.launch-timer strong{font-size:1rem}.launch-timer span{font-size:.58rem}}
</style>
