<script>
  const seoVariants = {
    local_seo: {
      serviceGroup: "local_seo",
      label: "Local SEO review",
      vertical: "local_service",
      searchScope: "local",
      placeholder: "Describe the local visibility, Google Business Profile, service-area, reviews, location-page, or local inquiry problem you want reviewed.",
    },
    logistics_seo: {
      serviceGroup: "logistics_seo",
      label: "Logistics SEO review",
      vertical: "logistics",
      searchScope: "national",
      placeholder: "Describe the logistics search, equipment, lane, service-page, authority, indexing, or qualified-inquiry problem you want reviewed.",
    },
    auto_dealer_seo: {
      serviceGroup: "auto_dealer_seo",
      label: "Auto dealer SEO review",
      vertical: "auto_dealer",
      searchScope: "local_and_national",
      placeholder: "Describe the dealership visibility, inventory, service-page, local search, authority, indexing, or inquiry problem you want reviewed.",
    },
  } as const;

  type SeoVariant = keyof typeof seoVariants;
  const isSeoVariant = (value: string | null): value is SeoVariant => Boolean(value && value in seoVariants);

  const pushSeoVariantEvent = (payload: Record<string, string>) => {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(payload);
  };

  document.addEventListener("click", (event) => {
    if (!event.isTrusted) return;
    const source = event.target;
    if (!(source instanceof Element)) return;
    const link = source.closest<HTMLAnchorElement>("a[data-seo-service-cta]");
    if (!link) return;

    let target: URL;
    try {
      target = new URL(link.href, window.location.origin);
    } catch {
      return;
    }

    const variant = target.searchParams.get("service");
    if (
      target.origin !== window.location.origin ||
      target.pathname !== "/paths/marketing/" ||
      !isSeoVariant(variant)
    ) return;

    pushSeoVariantEvent({
      event: "commercial_cta_click",
      cta_type: "seo_service_intake",
      audience_type: "business",
      page_group: "digital_service",
      service_group: seoVariants[variant].serviceGroup,
      seo_service_variant: variant,
      page_path: window.location.pathname,
      destination_path: target.pathname,
    });
  });

  const currentParams = new URLSearchParams(window.location.search);
  const directVariant = currentParams.get("service");
  const persistedVariant = currentParams.get("seo_variant");
  const requestedVariant = isSeoVariant(directVariant)
    ? directVariant
    : isSeoVariant(persistedVariant)
      ? persistedVariant
      : null;

  if (window.location.pathname === "/paths/marketing/" && requestedVariant) {
    const config = seoVariants[requestedVariant];
    if (isSeoVariant(directVariant)) {
      const normalized = new URL(window.location.href);
      normalized.searchParams.set("service", "seo");
      normalized.searchParams.set("seo_variant", requestedVariant);
      window.history.replaceState(window.history.state, "", `${normalized.pathname}${normalized.search}${normalized.hash}`);
    }

    window.setTimeout(() => {
      const group = document.querySelector<HTMLElement>("[data-seo-intake]");
      const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
      if (!group || !form) return;

      group.dataset.seoVariant = requestedVariant;
      group.dataset.seoService = requestedVariant;
      const eyebrow = group.querySelector(".contact-direction-eyebrow");
      const context = document.createElement("p");
      context.className = "seo-variant-context";
      context.textContent = `${config.label} selected. The intake is prefilled with the closest business and search-scope context; review every field before preparing the email handoff.`;
      eyebrow?.insertAdjacentElement("afterend", context);

      const hiddenVariant = document.createElement("input");
      hiddenVariant.type = "hidden";
      hiddenVariant.name = "seo_service_variant";
      hiddenVariant.value = requestedVariant;
      group.appendChild(hiddenVariant);

      const vertical = form.querySelector<HTMLSelectElement>('select[name="seo_vertical"]');
      const scope = form.querySelector<HTMLSelectElement>('select[name="seo_search_scope"]');
      const problem = form.querySelector<HTMLTextAreaElement>('textarea[name="seo_current_problem"]');
      if (vertical) vertical.value = config.vertical;
      if (scope) scope.value = config.searchScope;
      if (problem) problem.placeholder = config.placeholder;
    }, 0);
  }
</script>

<style>
  .seo-variant-context {
    margin: 0;
    padding: 0.8rem 0.9rem;
    border: 1px solid rgba(49, 95, 215, 0.2);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.72);
    color: #33466f;
    font-size: 0.9rem;
    line-height: 1.55;
  }
</style>
