---
const repairShopRoot = "/services/hermes-connect/repair-shops";
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "");
const ownerPaths = new Set([
  `${repairShopRoot}/dashboard`,
  `${repairShopRoot}/appointments`,
  `${repairShopRoot}/availability`,
  `${repairShopRoot}/customers`,
  `${repairShopRoot}/vehicles`,
  `${repairShopRoot}/services`,
  `${repairShopRoot}/settings`,
]);
const isOwnerWorkspace = ownerPaths.has(normalizedPath);

const strings = {
  en: { workspace:"Repair Shop", context:"Owner workspace", today:"Today", appointments:"Appointments", customers:"Customers", vehicles:"Vehicles", services:"Services", availability:"Availability", feedback:"Feedback", settings:"Settings", products:"Product Hub", logout:"Logout", menu:"Open navigation", close:"Close navigation" },
  ru: { workspace:"СТО", context:"Кабинет владельца", today:"Сегодня", appointments:"Записи", customers:"Клиенты", vehicles:"Автомобили", services:"Услуги", availability:"График", feedback:"Отзывы", settings:"Настройки", products:"Все продукты", logout:"Выйти", menu:"Открыть меню", close:"Закрыть меню" },
  uk: { workspace:"СТО", context:"Кабінет власника", today:"Сьогодні", appointments:"Записи", customers:"Клієнти", vehicles:"Автомобілі", services:"Послуги", availability:"Графік", feedback:"Відгуки", settings:"Налаштування", products:"Усі продукти", logout:"Вийти", menu:"Відкрити меню", close:"Закрити меню" },
  es: { workspace:"Taller", context:"Espacio del propietario", today:"Hoy", appointments:"Citas", customers:"Clientes", vehicles:"Vehículos", services:"Servicios", availability:"Horario", feedback:"Comentarios", settings:"Ajustes", products:"Productos", logout:"Salir", menu:"Abrir navegación", close:"Cerrar navegación" },
  it: { workspace:"Officina", context:"Spazio proprietario", today:"Oggi", appointments:"Appuntamenti", customers:"Clienti", vehicles:"Veicoli", services:"Servizi", availability:"Orari", feedback:"Feedback", settings:"Impostazioni", products:"Prodotti", logout:"Esci", menu:"Apri navigazione", close:"Chiudi navigazione" },
  fr: { workspace:"Atelier", context:"Espace propriétaire", today:"Aujourd’hui", appointments:"Rendez-vous", customers:"Clients", vehicles:"Véhicules", services:"Services", availability:"Horaires", feedback:"Avis", settings:"Paramètres", products:"Produits", logout:"Déconnexion", menu:"Ouvrir la navigation", close:"Fermer la navigation" },
} as const;
type Locale = keyof typeof strings;
const requested = (Astro.url.searchParams.get("lang") || "en").toLowerCase();
const locale: Locale = requested in strings ? requested as Locale : "en";
const copy = strings[locale];
const locales = Object.keys(strings) as Locale[];
const icons: Record<string, string> = {
  home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M9 21v-7h6v7"/></svg>',
  calendar: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  car: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 11 1.5-4.5h11L19 11"/><path d="M5 11h14a2 2 0 0 1 2 2v5H3v-5a2 2 0 0 1 2-2Z"/><path d="M7 18v2M17 18v2M7 14h.01M17 14h.01"/></svg>',
  wrench: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0-1.4-1.4l-10 10a1 1 0 0 0 1.4 1.4l10-10Z"/><path d="M16 3a5 5 0 0 1 5 5l-3 1-2-2 1-4Z"/><path d="M6 17a3 3 0 1 0 4 4l5-5"/></svg>',
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  message: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>',
  settings: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.1 2.1-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56v.1h-3v-.1A1.7 1.7 0 0 0 10.7 18.6a1.7 1.7 0 0 0-1.88.34l-.06.06-2.1-2.1.06-.06A1.7 1.7 0 0 0 7.06 15a1.7 1.7 0 0 0-1.56-1.03H5.4v-3h.1A1.7 1.7 0 0 0 7.06 9.94a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.1-2.1.06.06a1.7 1.7 0 0 0 1.88.34A1.7 1.7 0 0 0 11.73 4.74v-.1h3v.1a1.7 1.7 0 0 0 1.03 1.56 1.7 1.7 0 0 0 1.88-.34l.06-.06 2.1 2.1-.06.06a1.7 1.7 0 0 0-.34 1.88 1.7 1.7 0 0 0 1.56 1.03h.1v3h-.1A1.7 1.7 0 0 0 19.4 15Z"/></svg>',
  grid: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>',
};

const withLocale = (path: string, hash = "") => {
  const url = new URL(path, Astro.url.origin);
  if (locale !== "en") url.searchParams.set("lang", locale);
  return `${url.pathname}${url.search}${hash}`;
};

const dashboardHref = withLocale(`${repairShopRoot}/dashboard/`);
const appointmentsHref = withLocale(`${repairShopRoot}/appointments/`);
const items = [
  { label:copy.today, href:dashboardHref, active:normalizedPath === `${repairShopRoot}/dashboard`, icon:"home" },
  { label:copy.appointments, href:appointmentsHref, active:normalizedPath === `${repairShopRoot}/appointments`, icon:"calendar" },
  { label:copy.customers, href:withLocale(`${repairShopRoot}/customers/`), active:normalizedPath === `${repairShopRoot}/customers`, icon:"users" },
  { label:copy.vehicles, href:withLocale(`${repairShopRoot}/vehicles/`), active:normalizedPath === `${repairShopRoot}/vehicles`, icon:"car" },
  { label:copy.services, href:withLocale(`${repairShopRoot}/services/`), active:normalizedPath === `${repairShopRoot}/services`, icon:"wrench" },
  { label:copy.availability, href:withLocale(`${repairShopRoot}/availability/`), active:normalizedPath === `${repairShopRoot}/availability`, icon:"clock" },
  { label:copy.feedback, href:withLocale(`${repairShopRoot}/dashboard/`, "#feedback-title"), active:false, icon:"message" },
  { label:copy.settings, href:withLocale(`${repairShopRoot}/settings/`), active:normalizedPath === `${repairShopRoot}/settings`, icon:"settings" },
];
const pageTitle = normalizedPath === `${repairShopRoot}/appointments`
  ? copy.appointments
  : normalizedPath === `${repairShopRoot}/customers`
    ? copy.customers
    : normalizedPath === `${repairShopRoot}/vehicles`
      ? copy.vehicles
      : normalizedPath === `${repairShopRoot}/services`
        ? copy.services
        : normalizedPath === `${repairShopRoot}/settings`
          ? copy.settings
          : normalizedPath === `${repairShopRoot}/availability`
            ? copy.availability
            : copy.today;
const productHubHref = withLocale("/services/hermes-connect/");
const logoutRedirect = withLocale(`${repairShopRoot}/auth/`);
---

{isOwnerWorkspace && (
  <div class="repair-crm-shell" data-repair-crm-shell data-open="false">
    <div class="repair-crm-overlay" data-repair-crm-overlay></div>
    <aside class="repair-crm-sidebar" aria-label={`${copy.workspace} CRM`}>
      <a class="repair-crm-brand" href={dashboardHref}>
        <span class="repair-crm-mark" aria-hidden="true">H</span>
        <span><strong>Hermes Connect</strong><small>{copy.workspace}</small></span>
      </a>
      <nav class="repair-crm-nav" aria-label={`${copy.workspace} navigation`}>
        {items.map((item) => (
          <a href={item.href} class:list={["repair-crm-nav-item", item.active && "is-active"]} aria-current={item.active ? "page" : undefined} data-repair-crm-link>
            <span class="repair-crm-icon" aria-hidden="true" set:html={icons[item.icon]}></span>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
      <div class="repair-crm-sidebar-footer">
        <a href={productHubHref} class="repair-crm-product-hub" data-repair-crm-link>
          <span class="repair-crm-icon" aria-hidden="true" set:html={icons.grid}></span>
          <span>{copy.products}</span>
        </a>
        <button class="repair-crm-mobile-logout" type="button" data-repair-crm-logout>{copy.logout}</button>
      </div>
    </aside>

    <header class="repair-crm-topbar">
      <div class="repair-crm-topbar-left">
        <button class="repair-crm-menu" type="button" aria-label={copy.menu} aria-expanded="false" data-repair-crm-menu>
          <span></span><span></span><span></span>
        </button>
        <div class="repair-crm-context"><small>{copy.context}</small><strong>{pageTitle}</strong></div>
      </div>
      <div class="repair-crm-topbar-actions">
        <details class="repair-crm-language">
          <summary aria-label={`Language: ${locale.toUpperCase()}`}>{locale.toUpperCase()}</summary>
          <nav aria-label="Choose language">
            {locales.map((language) => (
              <a href={language === "en" ? Astro.url.pathname : `${Astro.url.pathname}?lang=${language}`} lang={language} aria-current={language === locale ? "page" : undefined}>{language.toUpperCase()}</a>
            ))}
          </nav>
        </details>
        <div class="repair-crm-account-slot" data-repair-crm-account-slot></div>
        <button class="repair-crm-logout" type="button" data-repair-crm-logout>{copy.logout}</button>
      </div>
    </header>
  </div>
)}

{isOwnerWorkspace && (
<script is:inline define:vars={{ logoutRedirect }}>
  (() => {
    const root = document.querySelector("[data-repair-crm-shell]");
    if (!(root instanceof HTMLElement)) return;

    const ROOT = "/services/hermes-connect/repair-shops";
    const supported = new Set(["en", "ru", "uk", "es", "it", "fr"]);
    const params = new URLSearchParams(window.location.search);
    const requested = (params.get("lang") || "en").toLowerCase();
    const locale = supported.has(requested) ? requested : "en";
    const strings = {
      en: { workspace:"Repair Shop", context:"Owner workspace", today:"Today", appointments:"Appointments", customers:"Customers", vehicles:"Vehicles", services:"Services", availability:"Availability", feedback:"Feedback", settings:"Settings", products:"Product Hub", logout:"Logout", menu:"Open navigation", close:"Close navigation" },
      ru: { workspace:"СТО", context:"Кабинет владельца", today:"Сегодня", appointments:"Записи", customers:"Клиенты", vehicles:"Автомобили", services:"Услуги", availability:"График", feedback:"Отзывы", settings:"Настройки", products:"Все продукты", logout:"Выйти", menu:"Открыть меню", close:"Закрыть меню" },
      uk: { workspace:"СТО", context:"Кабінет власника", today:"Сьогодні", appointments:"Записи", customers:"Клієнти", vehicles:"Автомобілі", services:"Послуги", availability:"Графік", feedback:"Відгуки", settings:"Налаштування", products:"Усі продукти", logout:"Вийти", menu:"Відкрити меню", close:"Закрити меню" },
      es: { workspace:"Taller", context:"Espacio del propietario", today:"Hoy", appointments:"Citas", customers:"Clientes", vehicles:"Vehículos", services:"Servicios", availability:"Horario", feedback:"Comentarios", settings:"Ajustes", products:"Productos", logout:"Salir", menu:"Abrir navegación", close:"Cerrar navegación" },
      it: { workspace:"Officina", context:"Spazio proprietario", today:"Oggi", appointments:"Appuntamenti", customers:"Clienti", vehicles:"Veicoli", services:"Servizi", availability:"Orari", feedback:"Feedback", settings:"Impostazioni", products:"Prodotti", logout:"Esci", menu:"Apri navigazione", close:"Chiudi navigazione" },
      fr: { workspace:"Atelier", context:"Espace propriétaire", today:"Aujourd’hui", appointments:"Rendez-vous", customers:"Clients", vehicles:"Véhicules", services:"Services", availability:"Horaires", feedback:"Avis", settings:"Paramètres", products:"Produits", logout:"Déconnexion", menu:"Ouvrir la navigation", close:"Fermer la navigation" },
    };
    const copy = strings[locale] || strings.en;
    const currentPath = window.location.pathname.replace(/\/+$/, "");
    const pageKey = currentPath === `${ROOT}/appointments`
      ? "appointments"
      : currentPath === `${ROOT}/customers`
        ? "customers"
        : currentPath === `${ROOT}/vehicles`
          ? "vehicles"
          : currentPath === `${ROOT}/services`
            ? "services"
            : currentPath === `${ROOT}/settings`
              ? "settings"
              : currentPath === `${ROOT}/availability`
                ? "availability"
                : "today";
    const navKeys = ["today", "appointments", "customers", "vehicles", "services", "availability", "feedback", "settings"];

    const localizeHref = (href) => {
      const url = new URL(href, window.location.origin);
      if (locale === "en") url.searchParams.delete("lang");
      else url.searchParams.set("lang", locale);
      if ((window.location.hostname === "127.0.0.1" || window.location.hostname === "localhost") && params.get("demo") === "1" && url.pathname.startsWith(ROOT)) url.searchParams.set("demo", "1");
      return `${url.pathname}${url.search}${url.hash}`;
    };

    document.documentElement.lang = locale;
    document.documentElement.classList.add("hc-repair-crm");
    document.body.prepend(root);

    root.querySelector(".repair-crm-sidebar")?.setAttribute("aria-label", `${copy.workspace} CRM`);
    root.querySelector(".repair-crm-nav")?.setAttribute("aria-label", `${copy.workspace} navigation`);
    const brand = root.querySelector(".repair-crm-brand");
    if (brand instanceof HTMLAnchorElement) brand.href = localizeHref(`${ROOT}/dashboard/`);
    const brandWorkspace = root.querySelector(".repair-crm-brand small");
    if (brandWorkspace) brandWorkspace.textContent = copy.workspace;

    root.querySelectorAll(".repair-crm-nav-item").forEach((link, index) => {
      const key = navKeys[index];
      if (!key) return;
      const label = link.querySelector("span:last-child");
      if (label) label.textContent = copy[key];
      if (link instanceof HTMLAnchorElement) link.href = localizeHref(link.getAttribute("href") || "");
    });

    const productHub = root.querySelector(".repair-crm-product-hub");
    if (productHub instanceof HTMLAnchorElement) {
      productHub.href = localizeHref("/services/hermes-connect/");
      const label = productHub.querySelector("span:last-child");
      if (label) label.textContent = copy.products;
    }

    root.querySelectorAll("[data-repair-crm-logout]").forEach((button) => { button.textContent = copy.logout; });
    const contextSmall = root.querySelector(".repair-crm-context small");
    const contextTitle = root.querySelector(".repair-crm-context strong");
    if (contextSmall) contextSmall.textContent = copy.context;
    if (contextTitle) contextTitle.textContent = copy[pageKey];

    const languageSummary = root.querySelector(".repair-crm-language summary");
    if (languageSummary) {
      languageSummary.textContent = locale.toUpperCase();
      languageSummary.setAttribute("aria-label", `Language: ${locale.toUpperCase()}`);
    }
    root.querySelectorAll(".repair-crm-language a[lang]").forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const target = (link.getAttribute("lang") || "en").toLowerCase();
      const next = new URL(window.location.href);
      if (target === "en") next.searchParams.delete("lang");
      else next.searchParams.set("lang", target);
      link.href = `${next.pathname}${next.search}${next.hash}`;
      if (target === locale) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });

    const accountSlot = root.querySelector("[data-repair-crm-account-slot]");
    const accountMenu = document.querySelector(".site-header details[data-hc-account-switcher]");
    if (accountSlot && accountMenu) accountSlot.append(accountMenu);

    const menuButton = root.querySelector("[data-repair-crm-menu]");
    const overlay = root.querySelector("[data-repair-crm-overlay]");
    const setOpen = (open) => {
      root.dataset.open = open ? "true" : "false";
      menuButton?.setAttribute("aria-expanded", open ? "true" : "false");
      menuButton?.setAttribute("aria-label", open ? copy.close : copy.menu);
    };
    setOpen(false);
    menuButton?.addEventListener("click", () => setOpen(root.dataset.open !== "true"));
    overlay?.addEventListener("click", () => setOpen(false));
    root.querySelectorAll("[data-repair-crm-link]").forEach((link) => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") setOpen(false); });

    const activeLogoutRedirect = localizeHref(`${ROOT}/auth/`) || logoutRedirect;
    const logoutButtons = Array.from(root.querySelectorAll("[data-repair-crm-logout]")).filter((button) => button instanceof HTMLButtonElement);
    const setLogoutDisabled = (disabled) => logoutButtons.forEach((button) => { button.disabled = disabled; });
    logoutButtons.forEach((button) => button.addEventListener("click", async () => {
      setLogoutDisabled(true);
      try {
        const response = await fetch("/api/auth/logout", { method:"POST", credentials:"same-origin" });
        if (!response.ok) throw new Error("logout_failed");
        window.location.assign(activeLogoutRedirect);
      } catch {
        setLogoutDisabled(false);
      }
    }));
  })();
</script>
)}

<style is:global>
  html.hc-repair-crm,html.hc-repair-crm body{background:#f4f6f8!important}
  html.hc-repair-crm .site-header,html.hc-repair-crm .hc-product-context,html.hc-repair-crm .hc-language-truth,html.hc-repair-crm .hc-intelligence-core,html.hc-repair-crm .site-footer{display:none!important}
  html.hc-repair-crm .workspace-page,html.hc-repair-crm .availability-page,html.hc-repair-crm .customers-page,html.hc-repair-crm .appointments-page{box-sizing:border-box;min-height:100vh;margin-left:248px!important;padding-top:86px!important;background:#f4f6f8!important}
  html.hc-repair-crm .workspace-page>.shell>.back-link,html.hc-repair-crm .availability-page>.shell>.back-link,html.hc-repair-crm .customers-page>.shell>.back-link,html.hc-repair-crm .appointments-page>.shell>.back-link{display:none!important}
  html.hc-repair-crm .workspace-header .workspace-actions,html.hc-repair-crm .availability-page .page-header>#logout-btn{display:none!important}

  .repair-crm-shell{--crm-sidebar:248px;--crm-topbar:70px;position:fixed;inset:0;z-index:1200;pointer-events:none}
  .repair-crm-sidebar{position:fixed;inset:0 auto 0 0;z-index:1202;display:flex;flex-direction:column;width:var(--crm-sidebar);box-sizing:border-box;padding:18px 14px;border-right:1px solid #e4e8ee;background:#fff;pointer-events:auto}
  .repair-crm-brand{display:flex;align-items:center;gap:11px;min-height:48px;padding:4px 8px 18px;border-bottom:1px solid #edf0f4;color:#172033;text-decoration:none}
  .repair-crm-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:#172033;color:#fff;font-size:15px;font-weight:900}
  .repair-crm-brand>span:last-child{display:grid;gap:1px}.repair-crm-brand strong{font-size:14px}.repair-crm-brand small{color:#7b8797;font-size:11px;font-weight:700}
  .repair-crm-nav{display:grid;gap:4px;padding:16px 0;overflow-y:auto}.repair-crm-nav-item,.repair-crm-product-hub{display:flex;align-items:center;gap:11px;min-height:44px;padding:0 11px;border-radius:10px;color:#566274;text-decoration:none;font-size:13px;font-weight:780}
  .repair-crm-nav-item:hover,.repair-crm-nav-item:focus-visible,.repair-crm-product-hub:hover,.repair-crm-product-hub:focus-visible{background:#f3f6fa;color:#172033}.repair-crm-nav-item.is-active{background:#edf5ff;color:#1268c4;box-shadow:inset 3px 0 0 #1e88ff}
  .repair-crm-icon{display:grid;place-items:center;width:18px;height:18px;flex:0 0 18px;opacity:.9}.repair-crm-icon svg{width:18px;height:18px;display:block}
  .repair-crm-sidebar-footer{margin-top:auto;padding-top:12px;border-top:1px solid #edf0f4}
  .repair-crm-topbar{position:fixed;top:0;right:0;left:var(--crm-sidebar);z-index:1201;display:flex;align-items:center;justify-content:space-between;gap:20px;height:var(--crm-topbar);box-sizing:border-box;padding:0 24px;border-bottom:1px solid #e4e8ee;background:rgba(255,255,255,.96);backdrop-filter:blur(16px);pointer-events:auto}
  .repair-crm-topbar-left,.repair-crm-topbar-actions{display:flex;align-items:center;gap:10px;min-width:0}.repair-crm-context{display:grid;gap:1px}.repair-crm-context small{color:#8893a3;font-size:10px;font-weight:760}.repair-crm-context strong{color:#172033;font-size:15px;white-space:nowrap}
