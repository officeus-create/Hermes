---
const repairShopRoot = "/services/hermes-connect/repair-shops";
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "");
const ownerPaths = new Set([
  `${repairShopRoot}/dashboard`,
  `${repairShopRoot}/availability`,
  `${repairShopRoot}/customers`,
]);
const isOwnerWorkspace = ownerPaths.has(normalizedPath);

const strings = {
  en: { workspace:"Repair Shop", today:"Today", appointments:"Appointments", customers:"Customers", services:"Services", availability:"Availability", feedback:"Feedback", settings:"Settings", products:"Product Hub", logout:"Logout", menu:"Open navigation", close:"Close navigation" },
  ru: { workspace:"СТО", today:"Сегодня", appointments:"Записи", customers:"Клиенты", services:"Услуги", availability:"График", feedback:"Отзывы", settings:"Настройки", products:"Все продукты", logout:"Выйти", menu:"Открыть меню", close:"Закрыть меню" },
  uk: { workspace:"СТО", today:"Сьогодні", appointments:"Записи", customers:"Клієнти", services:"Послуги", availability:"Графік", feedback:"Відгуки", settings:"Налаштування", products:"Усі продукти", logout:"Вийти", menu:"Відкрити меню", close:"Закрити меню" },
  es: { workspace:"Taller", today:"Hoy", appointments:"Citas", customers:"Clientes", services:"Servicios", availability:"Horario", feedback:"Comentarios", settings:"Ajustes", products:"Productos", logout:"Salir", menu:"Abrir navegación", close:"Cerrar navegación" },
  it: { workspace:"Officina", today:"Oggi", appointments:"Appuntamenti", customers:"Clienti", services:"Servizi", availability:"Orari", feedback:"Feedback", settings:"Impostazioni", products:"Prodotti", logout:"Esci", menu:"Apri navigazione", close:"Chiudi navigazione" },
  fr: { workspace:"Atelier", today:"Aujourd’hui", appointments:"Rendez-vous", customers:"Clients", services:"Services", availability:"Horaires", feedback:"Avis", settings:"Paramètres", products:"Produits", logout:"Déconnexion", menu:"Ouvrir la navigation", close:"Fermer la navigation" },
} as const;
type Locale = keyof typeof strings;
const requested = (Astro.url.searchParams.get("lang") || "en").toLowerCase();
const locale: Locale = requested in strings ? requested as Locale : "en";
const copy = strings[locale];
const locales = Object.keys(strings) as Locale[];

const withLocale = (path: string, hash = "") => {
  const url = new URL(path, Astro.url.origin);
  if (locale !== "en") url.searchParams.set("lang", locale);
  return `${url.pathname}${url.search}${hash}`;
};

const dashboardHref = withLocale(`${repairShopRoot}/dashboard/`);
const items = [
  { label:copy.today, href:dashboardHref, active:normalizedPath === `${repairShopRoot}/dashboard`, icon:"home" },
  { label:copy.appointments, href:withLocale(`${repairShopRoot}/dashboard/`, "#bookings-title"), active:false, icon:"calendar" },
  { label:copy.customers, href:withLocale(`${repairShopRoot}/customers/`), active:normalizedPath === `${repairShopRoot}/customers`, icon:"users" },
  { label:copy.services, href:withLocale(`${repairShopRoot}/dashboard/`, "#services-title"), active:false, icon:"wrench" },
  { label:copy.availability, href:withLocale(`${repairShopRoot}/availability/`), active:normalizedPath === `${repairShopRoot}/availability`, icon:"clock" },
  { label:copy.feedback, href:withLocale(`${repairShopRoot}/dashboard/`, "#feedback-title"), active:false, icon:"message" },
  { label:copy.settings, href:withLocale(`${repairShopRoot}/dashboard/`, "#profile-title"), active:false, icon:"settings" },
];
const pageTitle = normalizedPath === `${repairShopRoot}/customers`
  ? copy.customers
  : normalizedPath === `${repairShopRoot}/availability`
    ? copy.availability
    : copy.today;
const productHubHref = withLocale("/services/hermes-connect/");
const logoutRedirect = withLocale(`${repairShopRoot}/auth/`);
---

{isOwnerWorkspace && (
  <div class="repair-crm-shell" data-repair-crm-shell data-open="false">
    <div class="repair-crm-overlay" data-repair-crm-overlay></div>
    <aside class="repair-crm-sidebar" aria-label={`${copy.workspace} CRM`}>
      <a class="repair-crm-brand" href={dashboardHref}>
        <span class="repair-crm-mark" aria-hidden="true">H</span>
        <span><strong>Hermes Connect</strong><small>{copy.workspace}</small></span>
      </a>
      <nav class="repair-crm-nav" aria-label={`${copy.workspace} navigation`}>
        {items.map((item) => (
          <a href={item.href} class:list={["repair-crm-nav-item", item.active && "is-active"]} aria-current={item.active ? "page" : undefined} data-repair-crm-link>
            <span class={`repair-crm-icon repair-crm-icon-${item.icon}`} aria-hidden="true"></span>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
      <div class="repair-crm-sidebar-footer">
        <a href={productHubHref} class="repair-crm-product-hub" data-repair-crm-link>
          <span class="repair-crm-icon repair-crm-icon-grid" aria-hidden="true"></span>
          <span>{copy.products}</span>
        </a>
        <button class="repair-crm-mobile-logout" type="button" data-repair-crm-logout>{copy.logout}</button>
      </div>
    </aside>

    <header class="repair-crm-topbar">
      <div class="repair-crm-topbar-left">
        <button class="repair-crm-menu" type="button" aria-label={copy.menu} aria-expanded="false" data-repair-crm-menu>
          <span></span><span></span><span></span>
        </button>
        <div class="repair-crm-context"><small>Hermes Connect · {copy.workspace}</small><strong>{pageTitle}</strong></div>
      </div>
      <div class="repair-crm-topbar-actions">
        <details class="repair-crm-language">
          <summary aria-label={`Language: ${locale.toUpperCase()}`}>{locale.toUpperCase()}</summary>
          <nav aria-label="Choose language">
            {locales.map((language) => (
              <a href={language === "en" ? Astro.url.pathname : `${Astro.url.pathname}?lang=${language}`} lang={language} aria-current={language === locale ? "page" : undefined}>{language.toUpperCase()}</a>
            ))}
          </nav>
        </details>
        <div class="repair-crm-account-slot" data-repair-crm-account-slot></div>
        <button class="repair-crm-logout" type="button" data-repair-crm-logout>{copy.logout}</button>
      </div>
    </header>
  </div>
)}

{isOwnerWorkspace && (
<script is:inline define:vars={{ logoutRedirect, menuLabel: copy.menu, closeLabel: copy.close }}>
  (() => {
    const root = document.querySelector("[data-repair-crm-shell]");
    if (!(root instanceof HTMLElement)) return;
    document.documentElement.classList.add("hc-repair-crm");
    document.body.prepend(root);

    const accountSlot = root.querySelector("[data-repair-crm-account-slot]");
    const accountMenu = document.querySelector(".site-header details[data-hc-account-switcher]");
    if (accountSlot && accountMenu) accountSlot.append(accountMenu);

    const menuButton = root.querySelector("[data-repair-crm-menu]");
    const overlay = root.querySelector("[data-repair-crm-overlay]");
    const setOpen = (open) => {
      root.dataset.open = open ? "true" : "false";
      menuButton?.setAttribute("aria-expanded", open ? "true" : "false");
      menuButton?.setAttribute("aria-label", open ? closeLabel : menuLabel);
    };
    menuButton?.addEventListener("click", () => setOpen(root.dataset.open !== "true"));
    overlay?.addEventListener("click", () => setOpen(false));
    root.querySelectorAll("[data-repair-crm-link]").forEach((link) => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") setOpen(false); });

    const logoutButtons = Array.from(root.querySelectorAll("[data-repair-crm-logout]")).filter((button) => button instanceof HTMLButtonElement);
    const setLogoutDisabled = (disabled) => logoutButtons.forEach((button) => { button.disabled = disabled; });
    logoutButtons.forEach((button) => button.addEventListener("click", async () => {
      setLogoutDisabled(true);
      try {
        const response = await fetch("/api/auth/logout", { method:"POST", credentials:"same-origin" });
        if (!response.ok) throw new Error("logout_failed");
        window.location.assign(logoutRedirect);
      } catch {
        setLogoutDisabled(false);
      }
    }));
  })();
</script>
)}

<style is:global>
  html.hc-repair-crm,html.hc-repair-crm body{background:#f4f6f8!important}
  html.hc-repair-crm .site-header,html.hc-repair-crm .hc-product-context,html.hc-repair-crm .hc-language-truth,html.hc-repair-crm .hc-intelligence-core,html.hc-repair-crm .site-footer{display:none!important}
  html.hc-repair-crm .workspace-page,html.hc-repair-crm .availability-page,html.hc-repair-crm .customers-page{box-sizing:border-box;min-height:100vh;margin-left:248px!important;padding-top:86px!important;background:#f4f6f8!important}
  html.hc-repair-crm .workspace-page>.shell>.back-link,html.hc-repair-crm .availability-page>.shell>.back-link,html.hc-repair-crm .customers-page>.shell>.back-link{display:none!important}
  html.hc-repair-crm .workspace-header .workspace-actions,html.hc-repair-crm .availability-page .page-header>#logout-btn{display:none!important}

  .repair-crm-shell{--crm-sidebar:248px;--crm-topbar:70px;position:fixed;inset:0;z-index:1200;pointer-events:none}
  .repair-crm-sidebar{position:fixed;inset:0 auto 0 0;z-index:1202;display:flex;flex-direction:column;width:var(--crm-sidebar);box-sizing:border-box;padding:18px 14px;border-right:1px solid #e4e8ee;background:#fff;pointer-events:auto}
  .repair-crm-brand{display:flex;align-items:center;gap:11px;min-height:48px;padding:4px 8px 18px;border-bottom:1px solid #edf0f4;color:#172033;text-decoration:none}
  .repair-crm-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:#172033;color:#fff;font-size:15px;font-weight:900}
  .repair-crm-brand>span:last-child{display:grid;gap:1px}.repair-crm-brand strong{font-size:14px}.repair-crm-brand small{color:#7b8797;font-size:11px;font-weight:700}
  .repair-crm-nav{display:grid;gap:4px;padding:16px 0;overflow-y:auto}.repair-crm-nav-item,.repair-crm-product-hub{display:flex;align-items:center;gap:11px;min-height:44px;padding:0 11px;border-radius:10px;color:#566274;text-decoration:none;font-size:13px;font-weight:780}
  .repair-crm-nav-item:hover,.repair-crm-nav-item:focus-visible,.repair-crm-product-hub:hover,.repair-crm-product-hub:focus-visible{background:#f3f6fa;color:#172033}.repair-crm-nav-item.is-active{background:#edf5ff;color:#1268c4;box-shadow:inset 3px 0 0 #1e88ff}
  .repair-crm-icon{position:relative;width:18px;height:18px;flex:0 0 18px;opacity:.86}.repair-crm-icon::before,.repair-crm-icon::after{content:"";position:absolute;box-sizing:border-box}
  .repair-crm-icon-home::before{inset:4px 3px 2px;border:2px solid currentColor;border-top:0;border-radius:2px}.repair-crm-icon-home::after{left:4px;top:2px;width:10px;height:10px;border-left:2px solid currentColor;border-top:2px solid currentColor;transform:rotate(45deg);border-radius:2px}
  .repair-crm-icon-calendar::before{inset:3px 2px 2px;border:2px solid currentColor;border-radius:3px}.repair-crm-icon-calendar::after{left:5px;right:5px;top:7px;border-top:2px solid currentColor;box-shadow:-2px 4px 0 -1px currentColor,3px 4px 0 -1px currentColor}
  .repair-crm-icon-users::before{width:7px;height:7px;left:1px;top:2px;border:2px solid currentColor;border-radius:50%;box-shadow:8px 1px 0 -1px #fff,8px 1px 0 1px currentColor}.repair-crm-icon-users::after{left:0;bottom:2px;width:11px;height:6px;border:2px solid currentColor;border-radius:8px;box-shadow:7px 0 0 -1px #fff,7px 0 0 1px currentColor}
  .repair-crm-icon-wrench::before{left:2px;top:8px;width:14px;height:4px;border:2px solid currentColor;border-radius:3px;transform:rotate(-42deg)}.repair-crm-icon-wrench::after{right:1px;top:1px;width:7px;height:7px;border:2px solid currentColor;border-left-color:transparent;border-bottom-color:transparent;border-radius:50%}
  .repair-crm-icon-clock::before{inset:2px;border:2px solid currentColor;border-radius:50%}.repair-crm-icon-clock::after{left:8px;top:5px;width:4px;height:5px;border-left:2px solid currentColor;border-bottom:2px solid currentColor}
  .repair-crm-icon-message::before{inset:3px 2px 4px;border:2px solid currentColor;border-radius:4px}.repair-crm-icon-message::after{left:5px;bottom:1px;width:5px;height:5px;border-left:2px solid currentColor;transform:skew(-25deg)}
  .repair-crm-icon-settings::before{inset:4px;border:2px solid currentColor;border-radius:50%;box-shadow:0 -5px 0 -3px currentColor,0 5px 0 -3px currentColor,5px 0 0 -3px currentColor,-5px 0 0 -3px currentColor}.repair-crm-icon-settings::after{inset:7px;border:1.5px solid currentColor;border-radius:50%}.repair-crm-icon-grid::before{inset:2px;width:5px;height:5px;border-radius:1px;background:currentColor;box-shadow:8px 0 currentColor,0 8px currentColor,8px 8px currentColor}
  .repair-crm-sidebar-footer{margin-top:auto;padding-top:12px;border-top:1px solid #edf0f4}
  .repair-crm-topbar{position:fixed;top:0;right:0;left:var(--crm-sidebar);z-index:1201;display:flex;align-items:center;justify-content:space-between;gap:20px;height:var(--crm-topbar);box-sizing:border-box;padding:0 24px;border-bottom:1px solid #e4e8ee;background:rgba(255,255,255,.96);backdrop-filter:blur(16px);pointer-events:auto}
  .repair-crm-topbar-left,.repair-crm-topbar-actions{display:flex;align-items:center;gap:10px;min-width:0}.repair-crm-context{display:grid;gap:1px}.repair-crm-context small{color:#8893a3;font-size:10px;font-weight:760}.repair-crm-context strong{color:#172033;font-size:15px;white-space:nowrap}
  .repair-crm-menu{display:none;width:42px;height:42px;padding:10px;border:1px solid #e3e8ef;border-radius:10px;background:#fff}.repair-crm-menu span{display:block;height:2px;margin:3px 0;border-radius:3px;background:#172033}
  .repair-crm-language{position:relative}.repair-crm-language summary{display:grid;place-items:center;min-width:42px;height:38px;padding:0 9px;box-sizing:border-box;border:1px solid #e3e8ef;border-radius:10px;background:#fff;color:#4f5d70;cursor:pointer;list-style:none;font-size:11px;font-weight:850}.repair-crm-language summary::-webkit-details-marker{display:none}.repair-crm-language nav{position:absolute;right:0;top:44px;display:grid;grid-template-columns:repeat(2,1fr);gap:4px;width:132px;padding:6px;border:1px solid #e3e8ef;border-radius:12px;background:#fff;box-shadow:0 18px 45px rgba(22,32,51,.13)}.repair-crm-language:not([open]) nav{display:none}.repair-crm-language a{display:grid;place-items:center;min-height:34px;border-radius:8px;color:#5b6778;text-decoration:none;font-size:10px;font-weight:850}.repair-crm-language a[aria-current="page"]{background:#172033;color:#fff}
  .repair-crm-account-slot{min-width:0}.repair-crm-account-slot .hc-account-menu{margin:0}.repair-crm-logout{min-height:38px;padding:0 12px;border:1px solid #e3e8ef;border-radius:10px;background:#fff;color:#4f5d70;font-size:12px;font-weight:800;cursor:pointer}.repair-crm-logout:disabled{opacity:.55;cursor:wait}.repair-crm-overlay{display:none}
  .repair-crm-mobile-logout{display:none;width:100%;min-height:44px;margin-top:6px;padding:0 11px;border:0;border-radius:10px;background:transparent;color:#7a3441;text-align:left;font:inherit;font-size:13px;font-weight:780;cursor:pointer}.repair-crm-mobile-logout:hover,.repair-crm-mobile-logout:focus-visible{background:#fff1f3;color:#9f2740}.repair-crm-mobile-logout:disabled{opacity:.55;cursor:wait}

  @media(max-width:980px){.repair-crm-shell{--crm-sidebar:220px}.repair-crm-topbar{padding:0 16px}html.hc-repair-crm .workspace-page,html.hc-repair-crm .availability-page,html.hc-repair-crm .customers-page{margin-left:220px!important}}
  @media(max-width:760px){.repair-crm-shell{--crm-sidebar:min(84vw,292px);--crm-topbar:64px}.repair-crm-sidebar{transform:translateX(-105%);transition:transform .18s ease;box-shadow:16px 0 50px rgba(22,32,51,.16)}.repair-crm-shell[data-open="true"] .repair-crm-sidebar{transform:translateX(0)}.repair-crm-overlay{position:fixed;inset:0;z-index:1201;display:block;background:rgba(17,24,39,.32);opacity:0;pointer-events:none;transition:opacity .18s ease}.repair-crm-shell[data-open="true"] .repair-crm-overlay{opacity:1;pointer-events:auto}.repair-crm-topbar{left:0;padding:0 10px 0 8px}.repair-crm-menu{display:block}.repair-crm-context small{display:none}.repair-crm-context strong{max-width:120px;overflow:hidden;text-overflow:ellipsis}.repair-crm-topbar-actions{gap:6px}.repair-crm-logout{display:none}.repair-crm-mobile-logout{display:block}.repair-crm-language summary{min-width:38px;padding:0 7px}.repair-crm-account-slot .hc-account-menu summary{max-width:130px}html.hc-repair-crm .workspace-page,html.hc-repair-crm .availability-page,html.hc-repair-crm .customers-page{margin-left:0!important;padding-top:76px!important}}
  @media(prefers-reduced-motion:reduce){.repair-crm-sidebar,.repair-crm-overlay{transition:none}}
</style>
