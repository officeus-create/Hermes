---
const measurementId = "G-RY26321PVW";
const isHermesConnectRoute = Astro.url.pathname.startsWith("/services/hermes-connect");
---

<div class:list={["tracking-consent", { "tracking-consent-connect": isHermesConnectRoute }]} data-tracking-consent data-measurement-id={measurementId}>
  <div class="tracking-consent-banner" data-consent-banner role="dialog" aria-modal="false" aria-labelledby="tracking-consent-title" hidden>
    <p class="tracking-consent-eyebrow">Privacy settings</p>
    <h2 id="tracking-consent-title">Choose whether to allow website analytics.</h2>
    <p class="tracking-consent-detail">Hermes uses Google Analytics 4 to understand visits and limited website interactions. Analytics stays off until you choose “Allow analytics.” Advertising storage, ad personalization, and advertising user data remain disabled.</p>
    {isHermesConnectRoute && <p class="tracking-consent-compact-copy">Analytics is off until you choose. Advertising storage and personalization stay disabled. <a href="/privacy/">Privacy Policy</a></p>}
    <div class="tracking-consent-actions">
      <button type="button" class="button button-primary" data-consent-accept>Allow analytics</button>
      <button type="button" class="button" data-consent-decline>Continue without analytics</button>
      <a class="tracking-consent-policy-link" href="/privacy/">Privacy Policy</a>
    </div>
  </div>
  <button type="button" class="tracking-consent-settings" data-consent-settings aria-haspopup="dialog">Privacy settings</button>
</div>

<script is:inline define:vars={{ measurementId }}>
  (() => {
    const STORAGE_KEY = "hermes-analytics-consent";
    const root = document.querySelector("[data-tracking-consent]");
    const banner = root?.querySelector("[data-consent-banner]");
    const accept = root?.querySelector("[data-consent-accept]");
    const decline = root?.querySelector("[data-consent-decline]");
    const settings = root?.querySelector("[data-consent-settings]");

    const readChoice = () => {
      try {
        const value = localStorage.getItem(STORAGE_KEY);
        return value === "granted" || value === "denied" ? value : null;
      } catch {
        return null;
      }
    };

    const saveChoice = (value) => {
      try { localStorage.setItem(STORAGE_KEY, value); } catch { /* keep the current session usable */ }
      document.documentElement.dataset.analyticsConsent = value;
    };

    const clearGaCookies = () => {
      const cookieNames = document.cookie
        .split(";")
        .map((item) => item.trim().split("=")[0])
        .filter((name) => name === "_ga" || name.startsWith("_ga_"));
      const domains = [undefined, location.hostname, `.${location.hostname}`];
      for (const name of cookieNames) {
        for (const domain of domains) {
          const domainPart = domain ? `; domain=${domain}` : "";
          document.cookie = `${name}=; Max-Age=0; path=/${domainPart}; SameSite=Lax`;
        }
      }
    };

    const denyGoogleConsent = () => {
      if (typeof window.gtag === "function") {
        window.gtag('consent', 'update', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
      }
    };

    const loadAnalytics = () => {
      if (document.querySelector('script[data-hermes-ga4]')) return;

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      window.gtag('set', 'ads_data_redaction', true);
      window.gtag('js', new Date());
      window.gtag('config', measurementId, {
        allow_google_signals: false,
        allow_ad_personalization_signals: false
      });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
      script.dataset.hermesGa4 = "true";
      document.head.appendChild(script);
    };

    const applyChoice = (choice) => {
      if (choice === "granted") loadAnalytics();
      if (banner) banner.hidden = choice !== null;
      if (choice) document.documentElement.dataset.analyticsConsent = choice;
    };

    const initialChoice = readChoice();
    applyChoice(initialChoice);

    accept?.addEventListener("click", () => {
      saveChoice("granted");
      loadAnalytics();
      if (banner) banner.hidden = true;
    });

    decline?.addEventListener("click", () => {
      const wasGranted = readChoice() === "granted";
      denyGoogleConsent();
      clearGaCookies();
      saveChoice("denied");
      if (banner) banner.hidden = true;
      if (wasGranted) window.location.reload();
    });

    settings?.addEventListener("click", () => {
      if (!banner) return;
      banner.hidden = false;
      banner.querySelector("button")?.focus();
    });
  })();
</script>

<style>
  .tracking-consent-banner {
    position: fixed;
    z-index: 120;
    right: 1rem;
    bottom: 1rem;
    width: min(720px, calc(100vw - 2rem));
    padding: .82rem .9rem .88rem;
    border: 1px solid rgba(11,13,18,.13);
    border-radius: 16px;
    background: rgba(247,246,243,.97);
    color: #0b0d12;
    box-shadow: 0 18px 52px rgba(11,13,18,.13);
    backdrop-filter: blur(18px) saturate(1.04);
  }
  .tracking-consent-banner[hidden] { display: none; }
  .tracking-consent-eyebrow {
    margin: 0 0 .18rem;
    color: #6f5cff;
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .tracking-consent-banner h2 {
    margin: 0 0 .28rem;
    color: #0b0d12;
    font-size: 1rem;
    line-height: 1.25;
  }
  .tracking-consent-banner p {
    max-width: 68ch;
    margin-bottom: 0;
    color: #5f6472;
    font-size: .82rem;
    line-height: 1.42;
  }
  .tracking-consent-compact-copy { display: none; }
  .tracking-consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    align-items: center;
    margin-top: .62rem;
  }
  .tracking-consent-actions .button {
    min-height: 44px;
    padding: .58rem .78rem;
    border: 1px solid rgba(11,13,18,.14);
    border-radius: 999px;
    background: #fff;
    color: #0b0d12;
    font-size: .78rem;
    font-weight: 750;
  }
  .tracking-consent-actions .button-primary {
    border-color: #0b0d12;
    background: #0b0d12;
    color: #fff;
  }
  .tracking-consent-actions a,
  .tracking-consent-compact-copy a {
    color: #0b0d12;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tracking-consent-policy-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: .4rem .3rem;
    font-size: .78rem;
  }
  .tracking-consent-settings {
    position: fixed;
    z-index: 70;
    left: .7rem;
    bottom: .7rem;
    min-height: 40px;
    padding: .45rem .72rem;
    border: 1px solid rgba(11,13,18,.14);
    border-radius: 999px;
    background: rgba(247,246,243,.96);
    color: #0b0d12;
    font: inherit;
    font-size: .74rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(11,13,18,.07);
  }
  .tracking-consent-actions .button:focus-visible,
  .tracking-consent-policy-link:focus-visible,
  .tracking-consent-settings:focus-visible {
    outline: 2px solid #6f5cff;
    outline-offset: 3px;
  }

  @media (max-width: 700px) {
    .tracking-consent-banner {
      right: .5rem;
      bottom: .5rem;
      width: calc(100vw - 1rem);
      padding: .74rem;
      border-radius: 14px;
      max-height: 42vh;
      overflow-y: auto;
    }
    .tracking-consent-banner h2 { font-size: .96rem; margin-bottom: .28rem; }
    .tracking-consent-eyebrow { font-size: .62rem; margin-bottom: .16rem; }
    .tracking-consent-banner p { font-size: .8rem; line-height: 1.36; }
    .tracking-consent-actions { display: grid; gap: .4rem; margin-top: .58rem; }
    .tracking-consent-actions .button,
    .tracking-consent-policy-link { min-height: 44px; }

    /* Connect is an action-first mobile product. Keep consent explicit without covering the primary pilot CTA. */
    .tracking-consent-connect .tracking-consent-banner {
      padding: .58rem .68rem .6rem;
      max-height: none;
      overflow: visible;
      border-radius: 14px;
    }
    .tracking-consent-connect .tracking-consent-eyebrow,
    .tracking-consent-connect .tracking-consent-detail {
      display: none;
    }
    .tracking-consent-connect .tracking-consent-banner h2 {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .tracking-consent-connect .tracking-consent-compact-copy {
      display: block;
      margin: 0;
      font-size: .76rem;
      line-height: 1.3;
    }
    .tracking-consent-connect .tracking-consent-actions {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: .4rem;
      margin-top: .48rem;
    }
    .tracking-consent-connect .tracking-consent-actions .button {
      min-height: 44px;
      padding: .44rem .48rem;
      font-size: .74rem;
      line-height: 1.12;
    }
    .tracking-consent-connect .tracking-consent-policy-link {
      display: none;
    }
  }
</style>
