---
import RepairShopAnalytics from "./RepairShopAnalytics.astro";
import type { SiteLocale } from "../data/locales";

interface Props {
  clarityEligible?: boolean;
  locale?: SiteLocale;
}

const { clarityEligible = false, locale: pageLocale = "en" } = Astro.props;
const supportedLocales = new Set<SiteLocale>(["en", "ru", "uk", "es", "it", "fr"]);
const pathLocaleMap: Record<string, SiteLocale> = { ua: "uk", ru: "ru", es: "es", it: "it", fr: "fr" };
const requestedLocale = Astro.url.searchParams.get("lang");
const routeLocale = pathLocaleMap[Astro.url.pathname.split("/")[1] || ""] ?? pageLocale;
const resolvedLocale = requestedLocale && supportedLocales.has(requestedLocale as SiteLocale)
  ? requestedLocale as SiteLocale
  : routeLocale;

const trackingConsentCopy: Record<SiteLocale, {
  eyebrow: string;
  title: string;
  repairDetail: string;
  clarityDetail: string;
  basicDetail: string;
  compact: string;
  allow: string;
  decline: string;
  privacyPolicy: string;
  settings: string;
}> = {
  en: {
    eyebrow: "Privacy settings",
    title: "Choose whether to allow website analytics.",
    repairDetail: "Hermes uses Google Analytics 4 and a privacy-limited PostHog product event stream to understand visits and whether core Repair Shop workflows work. Analytics stays off until you choose “Allow analytics.” No names, emails, phones, shop/customer identifiers, VINs, notes, calendar data, or payment identifiers are sent in Repair Shop product events. Advertising storage, ad personalization, and advertising user data remain disabled.",
    clarityDetail: "Hermes uses Google Analytics 4 and Microsoft Clarity on eligible public pages to understand visits, clicks, scrolling, and usability. Both stay off until you choose “Allow analytics.” Clarity is not loaded on private Hermes Connect, signing, application, or other blocked sensitive routes; form inputs stay masked. Advertising storage, ad personalization, and advertising user data remain disabled.",
    basicDetail: "Hermes uses Google Analytics 4 to understand visits and limited website interactions. Analytics stays off until you choose “Allow analytics.” Advertising storage, ad personalization, and advertising user data remain disabled.",
    compact: "Analytics is off until you choose. Advertising storage and personalization stay disabled.",
    allow: "Allow analytics",
    decline: "Continue without analytics",
    privacyPolicy: "Privacy Policy",
    settings: "Privacy settings",
  },
  ru: {
    eyebrow: "Настройки конфиденциальности",
    title: "Разрешить аналитику сайта?",
    repairDetail: "Hermes использует Google Analytics 4 и ограниченный с точки зрения конфиденциальности поток продуктовых событий PostHog, чтобы понимать посещения и работу ключевых сценариев СТО. Аналитика остаётся выключенной, пока вы не выберете «Разрешить аналитику». В события Repair Shop не передаются имена, email, телефоны, идентификаторы СТО или клиентов, VIN, заметки, данные календаря или платёжные идентификаторы. Хранилище рекламных данных, персонализация рекламы и рекламные пользовательские данные остаются отключёнными.",
    clarityDetail: "Hermes использует Google Analytics 4 и Microsoft Clarity на подходящих публичных страницах, чтобы понимать посещения, клики, прокрутку и удобство использования. Оба сервиса остаются выключенными, пока вы не выберете «Разрешить аналитику». Clarity не загружается на приватных страницах Hermes Connect, подписания, заявок и других чувствительных маршрутах; поля форм остаются замаскированными. Хранилище рекламных данных, персонализация рекламы и рекламные пользовательские данные остаются отключёнными.",
    basicDetail: "Hermes использует Google Analytics 4, чтобы понимать посещения и ограниченные взаимодействия с сайтом. Аналитика остаётся выключенной, пока вы не выберете «Разрешить аналитику». Хранилище рекламных данных, рекламные пользовательские данные и персонализация рекламы остаются отключёнными.",
    compact: "Аналитика выключена, пока вы не выберете. Рекламное хранилище и персонализация остаются отключёнными.",
    allow: "Разрешить аналитику",
    decline: "Продолжить без аналитики",
    privacyPolicy: "Политика конфиденциальности",
    settings: "Настройки конфиденциальности",
  },
  uk: {
    eyebrow: "Налаштування конфіденційності",
    title: "Дозволити аналітику сайту?",
    repairDetail: "Hermes використовує Google Analytics 4 і обмежений із погляду конфіденційності потік продуктових подій PostHog, щоб розуміти відвідування та роботу ключових сценаріїв СТО. Аналітика залишається вимкненою, доки ви не виберете «Дозволити аналітику». У події Repair Shop не передаються імена, email, телефони, ідентифікатори СТО або клієнтів, VIN, нотатки, дані календаря чи платіжні ідентифікатори. Зберігання рекламних даних, персоналізація реклами та рекламні дані користувачів залишаються вимкненими.",
    clarityDetail: "Hermes використовує Google Analytics 4 і Microsoft Clarity на придатних публічних сторінках, щоб розуміти відвідування, кліки, прокручування та зручність використання. Обидва сервіси залишаються вимкненими, доки ви не виберете «Дозволити аналітику». Clarity не завантажується на приватних сторінках Hermes Connect, підписання, заявок та інших чутливих маршрутах; поля форм залишаються замаскованими. Зберігання рекламних даних, персоналізація реклами та рекламні дані користувачів залишаються вимкненими.",
    basicDetail: "Hermes використовує Google Analytics 4, щоб розуміти відвідування та обмежені взаємодії із сайтом. Аналітика залишається вимкненою, доки ви не виберете «Дозволити аналітику». Зберігання рекламних даних, рекламні дані користувачів і персоналізація реклами залишаються вимкненими.",
    compact: "Аналітика вимкнена, доки ви не виберете. Рекламне зберігання та персоналізація залишаються вимкненими.",
    allow: "Дозволити аналітику",
    decline: "Продовжити без аналітики",
    privacyPolicy: "Політика конфіденційності",
    settings: "Налаштування конфіденційності",
  },
  es: {
    eyebrow: "Configuración de privacidad",
    title: "¿Permitir la analítica del sitio web?",
    repairDetail: "Hermes utiliza Google Analytics 4 y un flujo de eventos de producto de PostHog limitado por privacidad para comprender las visitas y si funcionan los flujos principales de Repair Shop. La analítica permanece desactivada hasta que elijas «Permitir analítica». Los eventos de Repair Shop no envían nombres, correos, teléfonos, identificadores de talleres o clientes, VIN, notas, datos de calendario ni identificadores de pago. El almacenamiento publicitario, la personalización de anuncios y los datos publicitarios de usuario permanecen desactivados.",
    clarityDetail: "Hermes utiliza Google Analytics 4 y Microsoft Clarity en páginas públicas aptas para comprender visitas, clics, desplazamiento y usabilidad. Ambos permanecen desactivados hasta que elijas «Permitir analítica». Clarity no se carga en rutas privadas de Hermes Connect, firma, solicitudes u otras rutas sensibles bloqueadas; los campos de formularios permanecen enmascarados. El almacenamiento publicitario, la personalización de anuncios y los datos publicitarios de usuario permanecen desactivados.",
    basicDetail: "Hermes utiliza Google Analytics 4 para comprender las visitas y unas interacciones limitadas con el sitio. La analítica permanece desactivada hasta que elijas «Permitir analítica». El almacenamiento publicitario, los datos publicitarios de usuario y la personalización de anuncios permanecen desactivados.",
    compact: "La analítica está desactivada hasta que elijas. El almacenamiento publicitario y la personalización siguen desactivados.",
    allow: "Permitir analítica",
    decline: "Continuar sin analítica",
    privacyPolicy: "Política de privacidad",
    settings: "Configuración de privacidad",
  },
  it: {
    eyebrow: "Impostazioni sulla privacy",
    title: "Consentire l'analisi del sito web?",
    repairDetail: "Hermes utilizza Google Analytics 4 e un flusso di eventi di prodotto PostHog limitato per la privacy per comprendere le visite e il funzionamento dei principali flussi Repair Shop. L'analisi resta disattivata finché non scegli «Consenti analisi». Gli eventi Repair Shop non inviano nomi, email, telefoni, identificatori di officine o clienti, VIN, note, dati del calendario o identificatori di pagamento. Archiviazione pubblicitaria, personalizzazione degli annunci e dati pubblicitari degli utenti restano disattivati.",
    clarityDetail: "Hermes utilizza Google Analytics 4 e Microsoft Clarity sulle pagine pubbliche idonee per comprendere visite, clic, scorrimento e usabilità. Entrambi restano disattivati finché non scegli «Consenti analisi». Clarity non viene caricato sulle route private di Hermes Connect, firma, candidature o altre route sensibili bloccate; i campi dei moduli restano mascherati. Archiviazione pubblicitaria, personalizzazione degli annunci e dati pubblicitari degli utenti restano disattivati.",
    basicDetail: "Hermes utilizza Google Analytics 4 per comprendere le visite e interazioni limitate con il sito. L'analisi resta disattivata finché non scegli «Consenti analisi». Archiviazione pubblicitaria, dati pubblicitari degli utenti e personalizzazione degli annunci restano disattivati.",
    compact: "L'analisi è disattivata finché non scegli. Archiviazione pubblicitaria e personalizzazione restano disattivate.",
    allow: "Consenti analisi",
    decline: "Continua senza analisi",
    privacyPolicy: "Informativa sulla privacy",
    settings: "Impostazioni sulla privacy",
  },
  fr: {
    eyebrow: "Paramètres de confidentialité",
    title: "Autoriser l’analyse du site web ?",
    repairDetail: "Hermes utilise Google Analytics 4 et un flux d’événements produit PostHog limité pour la confidentialité afin de comprendre les visites et le fonctionnement des principaux parcours Repair Shop. L’analyse reste désactivée jusqu’à ce que vous choisissiez «Autoriser l’analyse». Les événements Repair Shop n’envoient ni noms, ni e-mails, ni téléphones, ni identifiants d’atelier ou de client, ni VIN, ni notes, ni données de calendrier, ni identifiants de paiement. Le stockage publicitaire, la personnalisation des annonces et les données publicitaires utilisateur restent désactivés.",
    clarityDetail: "Hermes utilise Google Analytics 4 et Microsoft Clarity sur les pages publiques éligibles afin de comprendre les visites, les clics, le défilement et l’ergonomie. Les deux restent désactivés jusqu’à ce que vous choisissiez «Autoriser l’analyse». Clarity n’est pas chargé sur les routes privées Hermes Connect, de signature, de candidature ou les autres routes sensibles bloquées; les champs de formulaire restent masqués. Le stockage publicitaire, la personnalisation des annonces et les données publicitaires utilisateur restent désactivés.",
    basicDetail: "Hermes utilise Google Analytics 4 pour comprendre les visites et certaines interactions limitées avec le site. L’analyse reste désactivée jusqu’à ce que vous choisissiez «Autoriser l’analyse». Le stockage publicitaire, les données publicitaires utilisateur et la personnalisation des annonces restent désactivés.",
    compact: "L’analyse est désactivée jusqu’à votre choix. Le stockage publicitaire et la personnalisation restent désactivés.",
    allow: "Autoriser l’analyse",
    decline: "Continuer sans analyse",
    privacyPolicy: "Politique de confidentialité",
    settings: "Paramètres de confidentialité",
  },
};
const consentCopy = trackingConsentCopy[resolvedLocale];
const measurementId = "G-RY26321PVW";
const clarityProjectId = "yiumce2dne";
const isHermesConnectRoute = Astro.url.pathname.startsWith("/services/hermes-connect");
const isRepairShopRoute = Astro.url.pathname.startsWith("/services/hermes-connect/repair-shops");
---

<div class:list={["tracking-consent", { "tracking-consent-connect": isHermesConnectRoute }]} data-tracking-consent data-measurement-id={measurementId}>
  <div class="tracking-consent-banner" data-consent-banner role="dialog" aria-modal="false" aria-labelledby="tracking-consent-title" hidden>
    <div class="tracking-consent-copy">
      <p class="tracking-consent-eyebrow">{consentCopy.eyebrow}</p>
      <h2 id="tracking-consent-title">{consentCopy.title}</h2>
      <p class="tracking-consent-detail">
        {isRepairShopRoute
          ? consentCopy.repairDetail
          : clarityEligible
            ? consentCopy.clarityDetail
            : consentCopy.basicDetail}
      </p>
      <p class="tracking-consent-compact-copy">{consentCopy.compact} <a href="/privacy/">{consentCopy.privacyPolicy}</a></p>
    </div>
    <div class="tracking-consent-actions">
      <button type="button" class="button button-primary" data-consent-accept>{consentCopy.allow}</button>
      <button type="button" class="button" data-consent-decline>{consentCopy.decline}</button>
      <a class="tracking-consent-policy-link" href="/privacy/">{consentCopy.privacyPolicy}</a>
    </div>
  </div>
  <button type="button" class="tracking-consent-settings" data-consent-settings aria-haspopup="dialog" hidden>{consentCopy.settings}</button>
</div>

{isRepairShopRoute && <RepairShopAnalytics />}

<script is:inline define:vars={{ measurementId, clarityProjectId, clarityEligible }}>
  (() => {
    const STORAGE_KEY = "hermes-analytics-consent";
    const PRODUCTION_ANALYTICS_HOSTS = new Set([
      "hermeslogisticsus.com",
      "www.hermeslogisticsus.com",
      "connect.hermeslogisticsus.com",
    ]);
    const CLARITY_PRODUCTION_HOSTS = new Set([
      "hermeslogisticsus.com",
      "www.hermeslogisticsus.com",
    ]);
    const root = document.querySelector("[data-tracking-consent]");
    const banner = root?.querySelector("[data-consent-banner]");
    const accept = root?.querySelector("[data-consent-accept]");
    const decline = root?.querySelector("[data-consent-decline]");
    const settings = root?.querySelector("[data-consent-settings]");

    const SYNTHETIC_ANALYTICS_OVERRIDE = "_hermes_ga4_smoke";
    const SYNTHETIC_CLARITY_OVERRIDE = "_hermes_clarity_smoke";
    const analyticsDeliveryStatus = () => {
      if (!PRODUCTION_ANALYTICS_HOSTS.has(window.location.hostname)) return "disabled-non-production";
      const syntheticOverride = new URLSearchParams(window.location.search).get(SYNTHETIC_ANALYTICS_OVERRIDE) === "1";
      if (navigator.webdriver === true && !syntheticOverride) return "disabled-automation";
      return "ga4";
    };
    const analyticsDeliveryAllowed = () => analyticsDeliveryStatus() === "ga4";
    const clarityDeliveryStatus = () => {
      if (!clarityEligible) return "disabled-route";
      if (!CLARITY_PRODUCTION_HOSTS.has(window.location.hostname)) return "disabled-non-production";
      const syntheticOverride = new URLSearchParams(window.location.search).get(SYNTHETIC_CLARITY_OVERRIDE) === "1";
      if (navigator.webdriver === true && !syntheticOverride) return "disabled-automation";
      return "clarity";
    };

    const readChoice = () => {
      try {
        const value = localStorage.getItem(STORAGE_KEY);
        return value === "granted" || value === "denied" ? value : null;
      } catch {
        return null;
      }
    };

    const saveChoice = (value) => {
      try { localStorage.setItem(STORAGE_KEY, value); } catch { /* keep the current session usable */ }
      document.documentElement.dataset.analyticsConsent = value;
    };

    const clearGaCookies = () => {
      const cookieNames = document.cookie
        .split(";")
        .map((item) => item.trim().split("=")[0])
        .filter((name) => name === "_ga" || name.startsWith("_ga_"));
      const domains = [undefined, location.hostname, `.${location.hostname}`];
      for (const name of cookieNames) {
        for (const domain of domains) {
          const domainPart = domain ? `; domain=${domain}` : "";
          document.cookie = `${name}=; Max-Age=0; path=/${domainPart}; SameSite=Lax`;
        }
      }
    };

    const denyGoogleConsent = () => {
      if (typeof window.gtag === "function") {
        window.gtag('consent', 'update', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
      }
    };

    const denyClarityConsent = () => {
      if (typeof window.clarity === "function") {
        window.clarity("consentv2", { ad_Storage: "denied", analytics_Storage: "denied" });
      }
      for (const name of ["_clck", "_clsk"]) {
        for (const domain of [undefined, location.hostname, `.${location.hostname}`]) {
          const domainPart = domain ? `; domain=${domain}` : "";
          document.cookie = `${name}=; Max-Age=0; path=/${domainPart}; SameSite=Lax`;
        }
      }
    };

    const loadClarity = () => {
      const deliveryStatus = clarityDeliveryStatus();
      document.documentElement.dataset.clarityTransport = deliveryStatus;
      if (deliveryStatus !== "clarity") return;

      window.clarity = window.clarity || function(){ (window.clarity.q = window.clarity.q || []).push(arguments); };
      window.clarity("consentv2", { ad_Storage: "denied", analytics_Storage: "granted" });
      if (document.querySelector('script[data-hermes-clarity]')) return;

      const script = document.createElement("script");
      script.async = true;
      script.src = `https://www.clarity.ms/tag/${encodeURIComponent(clarityProjectId)}?ref=bwt`;
      script.dataset.hermesClarity = "true";
      document.head.appendChild(script);
    };

    const loadAnalytics = () => {
      loadClarity();
      if (document.querySelector('script[data-hermes-ga4]')) return;

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      window.gtag('set', 'ads_data_redaction', true);

      const deliveryStatus = analyticsDeliveryStatus();
      if (deliveryStatus !== "ga4") {
        document.documentElement.dataset.analyticsTransport = deliveryStatus;
        return;
      }

      document.documentElement.dataset.analyticsTransport = "ga4";
      window.gtag('js', new Date());
      window.gtag('config', measurementId, {
        allow_google_signals: false,
        allow_ad_personalization_signals: false
      });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
      script.dataset.hermesGa4 = "true";
      document.head.appendChild(script);
    };

    const applyChoice = (choice) => {
      if (choice === "granted") loadAnalytics();
      if (banner) banner.hidden = choice !== null;
      if (settings) settings.hidden = choice === null;
      if (choice) document.documentElement.dataset.analyticsConsent = choice;
    };

    const initialChoice = readChoice();
    applyChoice(initialChoice);

    accept?.addEventListener("click", () => {
      saveChoice("granted");
      loadAnalytics();
      if (banner) banner.hidden = true;
      if (settings) settings.hidden = false;
    });

    decline?.addEventListener("click", () => {
      const wasGranted = readChoice() === "granted";
      denyGoogleConsent();
      denyClarityConsent();
      clearGaCookies();
      saveChoice("denied");
      if (banner) banner.hidden = true;
      if (settings) settings.hidden = false;
      if (wasGranted) window.location.reload();
    });

    settings?.addEventListener("click", () => {
      if (!banner) return;
      banner.hidden = false;
      settings.hidden = true;
      banner.querySelector("button")?.focus();
    });
  })();
</script>

<style>
  .tracking-consent-banner {
    position: fixed;
    z-index: 120;
    right: 1rem;
    bottom: 1rem;
    width: min(720px, calc(100vw - 2rem));
    padding: .82rem .9rem .88rem;
    border: 1px solid rgba(11,13,18,.13);
    border-radius: 16px;
    background: rgba(247,246,243,.97);
    color: #0b0d12;
    box-shadow: 0 18px 52px rgba(11,13,18,.13);
    backdrop-filter: blur(18px) saturate(1.04);
  }
  .tracking-consent-banner[hidden] { display: none; }
  .tracking-consent-eyebrow {
    margin: 0 0 .18rem;
    color: #6f5cff;
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .tracking-consent-banner h2 {
    margin: 0 0 .28rem;
    color: #0b0d12;
    font-size: 1rem;
    line-height: 1.25;
  }
  .tracking-consent-banner p {
    max-width: 68ch;
    margin-bottom: 0;
    color: #5f6472;
    font-size: .82rem;
    line-height: 1.42;
  }
  .tracking-consent-compact-copy { display: none; }
  .tracking-consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    align-items: center;
    margin-top: .62rem;
  }
  .tracking-consent-actions .button {
    min-height: 45px;
    padding: .58rem .78rem;
    border: 1px solid rgba(11,13,18,.14);
    border-radius: 999px;
    background: #fff;
    color: #0b0d12;
    font-size: .78rem;
    font-weight: 750;
  }
  .tracking-consent-actions .button-primary {
    border-color: #0b0d12;
    background: #0b0d12;
    color: #fff;
  }
  .tracking-consent-actions a,
  .tracking-consent-compact-copy a {
    color: #0b0d12;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tracking-consent-policy-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: .4rem .3rem;
    font-size: .78rem;
  }
  .tracking-consent-settings {
    position: fixed;
    z-index: 70;
    left: .7rem;
    bottom: .7rem;
    min-height: 40px;
    padding: .45rem .72rem;
    border: 1px solid rgba(11,13,18,.14);
    border-radius: 999px;
    background: rgba(247,246,243,.96);
    color: #0b0d12;
    font: inherit;
    font-size: .74rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(11,13,18,.07);
  }
  .tracking-consent-settings[hidden] { display: none; }
  .tracking-consent-actions .button:focus-visible,
  .tracking-consent-policy-link:focus-visible,
  .tracking-consent-settings:focus-visible {
    outline: 2px solid #6f5cff;
    outline-offset: 3px;
  }

  @media (min-width: 701px) {
    .tracking-consent-banner {
      position: fixed;
      width: min(960px, calc(100vw - 2rem));
      display: grid;
      grid-template-columns: minmax(280px, 1fr) auto;
      gap: .8rem 1rem;
      align-items: center;
      margin: 0;
      padding: .62rem .72rem;
      border-radius: 14px;
      box-shadow: 0 12px 34px rgba(11,13,18,.11);
    }
    .tracking-consent-eyebrow { display: none; }
