---
import { ArrowUpRight, BriefcaseBusiness, Building2, Route, Truck, UsersRound } from "@lucide/astro";

interface Props {
  theme?: "light" | "dark";
  active?: "load-board" | "carriers" | "owner-operators" | "brokers" | "shippers-dealers" | "operations" | "path";
}

const { theme = "light", active } = Astro.props;

const items = [
  { id: "load-board", label: "Load Board", href: "/load-board/", icon: Route },
  { id: "carriers", label: "Carriers & Fleets", href: "/paths/logistics/carriers/fleet-owners/", icon: Truck },
  { id: "owner-operators", label: "Owner-Operators", href: "/paths/logistics/carriers/owner-operators/", icon: UsersRound },
  { id: "brokers", label: "Brokers", href: "/paths/logistics/brokers/carrier-capacity/", icon: BriefcaseBusiness },
  { id: "shippers-dealers", label: "Shippers & Dealers", href: "/paths/logistics/customers/vehicle-transport/", icon: Building2 },
  { id: "operations", label: "Dispatch & Back Office", href: "/logistics/carrier/", icon: Truck },
  { id: "path", label: "Find Your Path", href: "/paths/logistics/find-your-path/", icon: ArrowUpRight },
] as const;
---

<nav class={`logistics-product-nav logistics-product-nav--${theme}`} aria-label="Hermes Logistics products and audiences">
  <div class="shell logistics-product-nav__inner">
    <a class="logistics-product-nav__brand" href="/paths/logistics/">
      <span>Hermes Logistics</span>
      <small>Freight · operations · technology</small>
    </a>
    <div class="logistics-product-nav__links">
      {items.map((item) => {
        const Icon = item.icon;
        return (
          <a href={item.href} aria-current={active === item.id ? "page" : undefined} data-logistics-product-link={item.id}>
            <Icon size={15} aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        );
      })}
    </div>
  </div>
</nav>

<style>
  .logistics-product-nav{position:sticky;top:68px;z-index:35;border-bottom:1px solid rgba(17,19,36,.1);backdrop-filter:blur(18px)}
  .logistics-product-nav--light{background:rgba(255,255,255,.94);color:#111324}
  .logistics-product-nav--dark{background:rgba(7,16,56,.94);color:#fff;border-bottom-color:rgba(255,255,255,.12)}
  .logistics-product-nav__inner{display:flex;align-items:center;gap:1rem;min-height:58px}
  .logistics-product-nav__brand{display:grid;gap:.08rem;flex:0 0 auto;color:inherit;text-decoration:none;padding-right:1rem;border-right:1px solid currentColor}
  .logistics-product-nav__brand span{font-weight:800;font-size:.8rem;letter-spacing:.02em}
  .logistics-product-nav__brand small{font-size:.63rem;opacity:.58;white-space:nowrap}
  .logistics-product-nav__links{display:flex;align-items:center;gap:.25rem;overflow-x:auto;scrollbar-width:none;padding:.45rem 0}
  .logistics-product-nav__links::-webkit-scrollbar{display:none}
  .logistics-product-nav__links a{display:inline-flex;align-items:center;gap:.35rem;min-height:34px;padding:.45rem .62rem;border:1px solid transparent;border-radius:999px;color:inherit;text-decoration:none;font-size:.72rem;font-weight:650;white-space:nowrap;opacity:.72;transition:.2s ease}
  .logistics-product-nav__links a:hover,.logistics-product-nav__links a:focus-visible,.logistics-product-nav__links a[aria-current="page"]{opacity:1;border-color:rgba(86,52,200,.24);background:rgba(86,52,200,.08)}
  .logistics-product-nav--dark .logistics-product-nav__links a:hover,.logistics-product-nav--dark .logistics-product-nav__links a:focus-visible,.logistics-product-nav--dark .logistics-product-nav__links a[aria-current="page"]{border-color:rgba(176,159,255,.28);background:rgba(176,159,255,.12)}
  @media(max-width:900px){.logistics-product-nav{top:64px}.logistics-product-nav__inner{display:grid;grid-template-columns:1fr;gap:0;padding:.45rem 0}.logistics-product-nav__brand{display:none}.logistics-product-nav__links{width:100%}}
</style>
