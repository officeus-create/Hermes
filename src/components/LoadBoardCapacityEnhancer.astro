---
const isCanonicalLoadBoard = Astro.url.pathname === "/load-board/";
const isHermesCatalog = Astro.url.pathname === "/businesses/";
const accessPath = "/services/hermes-connect/load-board/access/";
const previewDemoLoads = [
  { origin: "Chicago, IL", destination: "Dallas, TX", equipment: "dry_van", pickup: "Demo day +1 · 2–6 PM", delivery: "Demo day +2 · 8 AM–12 PM", distanceMiles: 925, deadheadMiles: 24, weightLbs: 42000, lengthFeet: 53, rateAmount: 2450, commodity: "Consumer goods", loadType: "FTL" },
  { origin: "Atlanta, GA", destination: "Charlotte, NC", equipment: "reefer", pickup: "Demo day +1 · 4 PM", delivery: "Demo day +1 · 11 PM", distanceMiles: 245, deadheadMiles: 18, weightLbs: 39000, lengthFeet: 53, rateAmount: 850, commodity: "Refrigerated food", loadType: "FTL" },
  { origin: "Phoenix, AZ", destination: "Las Vegas, NV", equipment: "car_hauler", pickup: "Demo day +1 · 10 AM", delivery: "Demo day +1 · 6 PM", distanceMiles: 300, deadheadMiles: 31, weightLbs: 18500, lengthFeet: 75, rateAmount: 1650, commodity: "7 vehicles", loadType: "Full" },
  { origin: "Kansas City, MO", destination: "Denver, CO", equipment: "flatbed", pickup: "Demo day +1 · Noon", delivery: "Demo day +2 · 7 AM", distanceMiles: 605, deadheadMiles: 42, weightLbs: 47000, lengthFeet: 48, rateAmount: 1950, commodity: "Steel coils", loadType: "FTL" },
  { origin: "Newark, NJ", destination: "Boston, MA", equipment: "reefer", pickup: "Demo day +1 · 3–5 PM", delivery: "Demo day +2 · 2 AM", distanceMiles: 220, deadheadMiles: 14, weightLbs: 36000, lengthFeet: 53, rateAmount: 980, commodity: "Frozen food", loadType: "FTL" },
  { origin: "Houston, TX", destination: "Dallas, TX", equipment: "dry_van", pickup: "Demo day +1 · 1 PM", delivery: "Demo day +1 · 7 PM", distanceMiles: 240, deadheadMiles: 15, weightLbs: 41000, lengthFeet: 53, rateAmount: 750, commodity: "Retail freight", loadType: "FTL" },
  { origin: "Seattle, WA", destination: "Portland, OR", equipment: "car_hauler", pickup: "Demo day +1 · 9 AM", delivery: "Demo day +1 · 3 PM", distanceMiles: 174, deadheadMiles: 26, weightLbs: 14000, lengthFeet: 70, rateAmount: 1100, commodity: "5 vehicles", loadType: "Full" },
  { origin: "Miami, FL", destination: "Orlando, FL", equipment: "hotshot", pickup: "Demo day +1 · 8–11 AM", delivery: "Demo day +1 · 5 PM", distanceMiles: 235, deadheadMiles: 18, weightLbs: 12000, lengthFeet: 40, rateAmount: 900, commodity: "Machinery", loadType: "Partial" },
  { origin: "Columbus, OH", destination: "Detroit, MI", equipment: "dry_van", pickup: "Demo day +1 · 6 PM", delivery: "Demo day +2 · 1 AM", distanceMiles: 205, deadheadMiles: 33, weightLbs: 43500, lengthFeet: 53, rateAmount: 720, commodity: "Auto parts", loadType: "FTL" },
  { origin: "Savannah, GA", destination: "Jacksonville, FL", equipment: "step_deck", pickup: "Demo day +1 · 7 AM", delivery: "Demo day +1 · 1 PM", distanceMiles: 140, deadheadMiles: 12, weightLbs: 28000, lengthFeet: 48, rateAmount: 675, commodity: "Construction equipment", loadType: "FTL" },
  { origin: "Minneapolis, MN", destination: "Omaha, NE", equipment: "reefer", pickup: "Demo day +1 · 5 PM", delivery: "Demo day +2 · 5 AM", distanceMiles: 380, deadheadMiles: 44, weightLbs: 40500, lengthFeet: 53, rateAmount: 1325, commodity: "Temperature controlled", loadType: "FTL" },
  { origin: "Denver, CO", destination: "Salt Lake City, UT", equipment: "flatbed", pickup: "Demo day +1 · 8 AM", delivery: "Demo day +2 · 6 AM", distanceMiles: 520, deadheadMiles: 29, weightLbs: 45500, lengthFeet: 48, rateAmount: 1725, commodity: "Building materials", loadType: "FTL" },
  { origin: "Charlotte, NC", destination: "Richmond, VA", equipment: "power_only", pickup: "Demo day +1 · 2 PM", delivery: "Demo day +1 · 9 PM", distanceMiles: 295, deadheadMiles: 21, weightLbs: 0, lengthFeet: 53, rateAmount: 980, commodity: "Loaded trailer", loadType: "Power only" },
  { origin: "Indianapolis, IN", destination: "Chicago, IL", equipment: "car_hauler", pickup: "Demo day +1 · Noon", delivery: "Demo day +1 · 7 PM", distanceMiles: 185, deadheadMiles: 38, weightLbs: 16000, lengthFeet: 72, rateAmount: 1050, commodity: "6 vehicles", loadType: "Full" },
  { origin: "Los Angeles, CA", destination: "Sacramento, CA", equipment: "flatbed", pickup: "Demo day +1 · 9 AM", delivery: "Demo day +2 · 8 AM", distanceMiles: 385, deadheadMiles: 52, weightLbs: 44000, lengthFeet: 48, rateAmount: 1425, commodity: "Industrial material", loadType: "FTL" },
  { origin: "Tampa, FL", destination: "Atlanta, GA", equipment: "car_hauler", pickup: "Demo day +1 · 1 PM", delivery: "Demo day +2 · Noon", distanceMiles: 455, deadheadMiles: 36, weightLbs: 17500, lengthFeet: 75, rateAmount: 2050, commodity: "7 vehicles", loadType: "Full" },
  { origin: "Fremont, CA", destination: "Reno, NV", equipment: "car_hauler", pickup: "Demo day +1 · 10 AM", delivery: "Demo day +1 · 8 PM", distanceMiles: 215, deadheadMiles: 19, weightLbs: 12500, lengthFeet: 68, rateAmount: 1275, commodity: "4 vehicles", loadType: "Partial" },
  { origin: "Cleveland, OH", destination: "Pittsburgh, PA", equipment: "box_truck", pickup: "Demo day +1 · 11 AM", delivery: "Demo day +1 · 5 PM", distanceMiles: 135, deadheadMiles: 11, weightLbs: 9000, lengthFeet: 26, rateAmount: 575, commodity: "LTL freight", loadType: "Partial" },
  { origin: "Memphis, TN", destination: "Birmingham, AL", equipment: "power_only", pickup: "Demo day +1 · 5 PM", delivery: "Demo day +2 · 1 AM", distanceMiles: 240, deadheadMiles: 27, weightLbs: 0, lengthFeet: 53, rateAmount: 850, commodity: "Loaded trailer", loadType: "Power only" },
  { origin: "San Antonio, TX", destination: "Oklahoma City, OK", equipment: "hotshot", pickup: "Demo day +1 · 7 AM", delivery: "Demo day +1 · 7 PM", distanceMiles: 470, deadheadMiles: 34, weightLbs: 14500, lengthFeet: 40, rateAmount: 1575, commodity: "Oilfield equipment", loadType: "Partial" },
  { origin: "Green Bay, WI", destination: "Des Moines, IA", equipment: "car_hauler", pickup: "Demo day +1 · 8 AM", delivery: "Demo day +2 · 8 AM", distanceMiles: 420, deadheadMiles: 22, weightLbs: 15000, lengthFeet: 72, rateAmount: 1875, commodity: "6 vehicles", loadType: "Full" },
  { origin: "Rockford, IL", destination: "Nashville, TN", equipment: "hotshot", pickup: "Demo day +1 · 6 AM", delivery: "Demo day +1 · 8 PM", distanceMiles: 485, deadheadMiles: 28, weightLbs: 11000, lengthFeet: 40, rateAmount: 1500, commodity: "Urgent parts", loadType: "Partial" },
  { origin: "Madison, WI", destination: "Indianapolis, IN", equipment: "car_hauler", pickup: "Demo day +1 · 9 AM", delivery: "Demo day +1 · 9 PM", distanceMiles: 330, deadheadMiles: 17, weightLbs: 13500, lengthFeet: 70, rateAmount: 1525, commodity: "5 vehicles", loadType: "Full" },
  { origin: "St. Louis, MO", destination: "Louisville, KY", equipment: "dry_van", pickup: "Demo day +1 · 3 PM", delivery: "Demo day +2 · 2 AM", distanceMiles: 260, deadheadMiles: 25, weightLbs: 42500, lengthFeet: 53, rateAmount: 875, commodity: "Packaged goods", loadType: "FTL" },
];
const previewEquipmentLabel = (value: string) => value.replaceAll("_", " ").replace(/\b\w/g, (char) => char.toUpperCase());
const previewMoney = (value: number) => `$${Math.round(value).toLocaleString("en-US")}`;
const previewRpm = (item: { rateAmount: number; distanceMiles: number }) => (item.rateAmount / item.distanceMiles).toFixed(2);
---

{isCanonicalLoadBoard && (
  <section class="hlb-live-marketplace" id="live-marketplace" aria-labelledby="hlb-live-title" data-hlb-live-marketplace>
    <div class="hlb-live-shell">
      <div class="hlb-live-head">
        <div>
          <p class="hlb-live-eyebrow">Hermes Load Board · product workspace demo</p>
          <h2 id="hlb-live-title">Scan the board like a dispatcher before you sign in.</h2>
          <p>See the board before you create an account. Rates, RPM, weight, trip miles, deadhead, pickup and delivery timing are visible in the sanitized DEMO rows. LIVE counts above remain real and never include demo or historical email data.</p>
        </div>
        <div class="hlb-live-actions">
          <a class="hlb-live-primary" href={accessPath}>Create account &amp; unlock</a>
          <a href={`${accessPath}?mode=login`}>Sign in</a>
          <a href="/carrier/">Agreement &amp; onboarding</a>
          <button type="button" data-live-refresh aria-label="Refresh Load Board inventory">Refresh now</button>
        </div>
      </div>

      <div class="hlb-access-strip" data-hlb-access-strip>
        <span class="hlb-access-dot"></span>
        <strong data-hlb-access-label>Public curtain view</strong>
        <span data-hlb-access-copy>LIVE count is real. Rich rows labeled PREVIEW · NOT LIVE are sanitized product-demo examples; company registration unlocks live source records and actions.</span>
      </div>

      <div class="hlb-live-stats" aria-label="Live Load Board status">
        <div class="hlb-stat-primary"><strong data-live-load-count>—</strong><span>loads available through Load Board access</span><small data-live-load-status>Checking active inventory…</small></div>
        <div><strong data-live-capacity-count>—</strong><span>available trucks</span><small data-live-capacity-status>Checking capacity…</small></div>
        <div><strong>30s</strong><span>refresh cycle</span><small>Expired or covered records disappear automatically</small></div>
        <div><strong>60</strong><span>demo rows</span><small>Sanitized examples · never counted as LIVE</small></div>
      </div>

      <div class="hlb-live-grid">
        <section class="hlb-live-panel hlb-live-panel--loads" aria-labelledby="hlb-live-loads-title">
          <div class="hlb-live-panel-head">
            <div><p class="hlb-live-eyebrow">Freight</p><h3 id="hlb-live-loads-title">Available loads</h3></div>
            <span class="hlb-live-badge" data-hlb-mode-badge>CURTAIN VIEW</span>
          </div>
          <div class="hlb-table-head" aria-hidden="true"><span>Sample</span><span>Pickup / delivery</span><span>Lane</span><span>DH</span><span>Trip</span><span>Rate / RPM</span><span>Equipment</span><span>Weight / load</span><span>Status</span></div>
          <div class="hlb-live-rows hlb-live-rows--scroll" data-live-load-rows aria-live="polite">
            {Array.from({ length: 60 }, (_, index) => {
              const base = previewDemoLoads[index % previewDemoLoads.length];
              const cycle = Math.floor(index / previewDemoLoads.length);
              const rate = base.rateAmount + cycle * 25;
              const deadhead = base.deadheadMiles + cycle * 3;
              const rpm = (rate / base.distanceMiles).toFixed(2);
              return <a class="hlb-live-row hlb-live-row--locked hlb-structural-preview hlb-demo-row" href={`${accessPath}?source=load-board-curtain`} data-rate={rate} data-rpm={rpm} data-deadhead={deadhead} data-weight={base.weightLbs} aria-label={`Sanitized demo lane ${base.origin} to ${base.destination}. Register in Hermes Connect to unlock live Load Board access`}>
                <span class="hlb-col-sample">DEMO</span>
                <div class="hlb-col-pickup"><strong>{base.pickup}</strong><small>{base.delivery}</small></div>
                <div class="hlb-live-route hlb-col-lane"><span>{base.origin}</span><b>→</b><span>{base.destination}</span></div>
                <span class="hlb-col-dh">{deadhead} mi</span>
                <span class="hlb-col-trip">{base.distanceMiles.toLocaleString("en-US")} mi</span>
                <div class="hlb-live-rate hlb-col-rate"><strong>{previewMoney(rate)}</strong><small>{rpm} RPM</small></div>
                <div class="hlb-col-equip"><strong>{previewEquipmentLabel(base.equipment)}</strong><small>{base.loadType} · {base.lengthFeet} ft</small></div>
                <div class="hlb-col-weight"><strong>{base.weightLbs ? `${base.weightLbs.toLocaleString("en-US")} lb` : "Weight n/a"}</strong><small>{base.commodity}</small></div>
                <div class="hlb-col-status"><span class="hlb-demo-pill">PREVIEW · NOT LIVE</span><small>Sanitized example</small></div>
              </a>;
            })}
          </div>
          <div class="hlb-preview-note" data-hlb-preview-note>
            <strong>Interface preview rows are not inventory.</strong>
            <span>Only the real count above represents active, unexpired records. Rates, RPM, weight and mileage below are sanitized example values so you can evaluate the product; DEMO rows never contribute to LIVE inventory.</span>
          </div>
        </section>

        <aside class="hlb-curtain-card" data-hlb-curtain-card>
          <p class="hlb-live-eyebrow">Unlock in Hermes Connect</p>
          <h3>Click any locked load. Registration continues from the exact board you are previewing.</h3>
          <ol>
            <li><b>1</b><span><strong>Create or sign in to Hermes.</strong><small>One identity for Hermes Connect.</small></span></li>
            <li><b>2</b><span><strong>Register your company.</strong><small>Company profile becomes the Load Board access owner.</small></span></li>
            <li><b>3</b><span><strong>Join Hermes Catalog.</strong><small>Optional safe public card appears as self-submitted while verification is pending.</small></span></li>
            <li><b>4</b><span><strong>Return to this board.</strong><small>Carrier-access opportunities and dispatcher tools open.</small></span></li>
          </ol>
          <div class="hlb-unlock-features"><span>LIVE source records</span><span>Saved search on device</span><span>Alerts · demo</span><span>Post load / truck</span><span>Request details</span><span>Backhaul swap</span></div>
          <a class="hlb-curtain-cta" href={accessPath}>Register company &amp; unlock Load Board →</a>
          <a class="hlb-curtain-catalog" href="/businesses/">See Hermes Catalog</a>
        </aside>
      </div>

      <section class="hlb-live-panel hlb-capacity-panel" aria-labelledby="hlb-live-capacity-title">
        <div class="hlb-live-panel-head">
          <div><p class="hlb-live-eyebrow">Carrier capacity</p><h3 id="hlb-live-capacity-title">Available trucks</h3></div>
          <span class="hlb-live-badge hlb-live-badge--capacity">SEPARATE FROM LOADS</span>
        </div>
        <div class="hlb-live-rows" data-live-capacity-rows aria-live="polite">
          <div class="hlb-live-empty">Connecting to the approved truck-capacity feed…</div>
        </div>
      </section>

      <nav class="hlb-discovery-hub" aria-label="Load Board provider and equipment guides">
        <div><strong>Load Board providers</strong>
          <a href="/load-board/providers/ship-cars/">Ship.Cars</a><a href="/load-board/providers/central-dispatch/">Central Dispatch</a><a href="/load-board/providers/super-dispatch/">Super Dispatch</a><a href="/load-board/providers/dat/">DAT</a><a href="/load-board/providers/truckstop/">Truckstop</a><a href="/load-board/providers/123loadboard/">123Loadboard</a><a href="/load-board/providers/direct-freight/">Direct Freight</a>
        </div>
        <div><strong>Equipment load guides</strong>
          <a href="/load-board/equipment/car-hauler/">Car Hauler</a><a href="/load-board/equipment/dry-van/">Dry Van</a><a href="/load-board/equipment/reefer/">Reefer</a><a href="/load-board/equipment/flatbed/">Flatbed</a><a href="/load-board/equipment/step-deck/">Step Deck</a><a href="/load-board/equipment/hotshot/">Hotshot</a><a href="/load-board/equipment/power-only/">Power Only</a><a href="/load-board/equipment/box-truck/">Box Truck</a>
        </div>
      </nav>

      <div class="hlb-live-truth">
        <strong>Truth boundary:</strong>
        <span>A truck is capacity, not freight. A demo is not live. The load counter uses active, unexpired public or carrier-access records; internal-only records and visual preview rows are excluded.</span>
      </div>
    </div>
  </section>
)}

{(isCanonicalLoadBoard || isHermesCatalog) && (
  <script is:inline define:vars={{ isCanonicalLoadBoard, isHermesCatalog, accessPath, previewDemoLoads }}>
    (() => {
      const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char]));
      const equipmentLabel = (value) => ({ dry_van: "Dry Van", reefer: "Reefer", flatbed: "Flatbed", step_deck: "Step Deck", power_only: "Power Only", hotshot: "Hotshot", box_truck: "Box Truck", sprinter_van: "Sprinter Van", car_hauler: "Car Hauler", other: "Other" }[String(value || "")] || String(value || "Other").replaceAll("_", " "));
      const companyTypeLabel = (value) => ({ carrier: "Carrier", owner_operator: "Owner-Operator", fleet: "Fleet", dispatcher: "Dispatcher", broker: "Broker", shipper: "Shipper", dealer: "Dealer", other: "Business" }[String(value || "")] || "Business");
      const age = (value) => {
        const time = new Date(value || 0).getTime();
        if (!Number.isFinite(time) || time <= 0) return "recent";
        const minutes = Math.max(0, Math.round((Date.now() - time) / 60000));
        if (minutes < 2) return "now";
        if (minutes < 60) return `${minutes}m ago`;
        const hours = Math.round(minutes / 60);
        return hours < 48 ? `${hours}h ago` : `${Math.round(hours / 24)}d ago`;
      };
      const money = (record) => {
        const amount = Number(record?.rateAmount);
        if (!Number.isFinite(amount) || amount <= 0) return "Rate on request";
        return new Intl.NumberFormat("en-US", { style: "currency", currency: record?.rateCurrency || "USD", maximumFractionDigits: 0 }).format(amount);
      };

      if (isHermesCatalog) {
        const enhanceCatalog = async () => {
          const grid = document.querySelector('[data-catalog-grid]');
          const count = document.querySelector('[data-catalog-count]');
          if (!(grid instanceof HTMLElement)) return;
          try {
            const response = await fetch('/api/catalog/companies', { headers: { Accept: 'application/json' } });
            if (!response.ok) return;
            const payload = await response.json();
            const companies = Array.isArray(payload.companies) ? payload.companies : [];
            const existingIds = new Set([...grid.querySelectorAll('[data-company-runtime-id]')].map((node) => node.getAttribute('data-company-runtime-id')));
            for (const company of companies) {
              if (!company?.id || existingIds.has(String(company.id))) continue;
              const card = document.createElement('article');
              card.className = 'business-card business-card--runtime';
              card.setAttribute('data-catalog-card', '');
              card.setAttribute('data-company-runtime-id', String(company.id));
              card.setAttribute('data-search-text', `${company.companyName || ''} ${company.companyType || ''} ${company.city || ''} ${company.state || ''}`.toLowerCase());
              card.innerHTML = `<div class="business-card__hero"><div class="business-card__category">${escapeHtml(companyTypeLabel(company.companyType))}</div><div class="business-card__identity"><h2>${escapeHtml(company.companyName)}</h2><p>${escapeHtml(company.city)}, ${escapeHtml(company.state)}</p></div></div><div class="business-card__body"><p class="business-card__claim-state">${escapeHtml(company.verificationLabel || 'Self-submitted · verification pending')}</p><p>Company registered through Hermes Connect. Public facts remain verification-pending before any dedicated SEO/GEO profile is released.</p></div>`;
              grid.appendChild(card);
            }
            if (count) count.textContent = String(grid.querySelectorAll('[data-catalog-card]').length);

            const search = document.querySelector('[data-catalog-search]');
            if (search instanceof HTMLInputElement && search.dataset.runtimeBound !== 'true') {
              search.dataset.runtimeBound = 'true';
              search.addEventListener('input', () => {
                const term = search.value.trim().toLowerCase();
                grid.querySelectorAll('[data-catalog-card]').forEach((card) => {
                  if (!(card instanceof HTMLElement)) return;
                  card.hidden = Boolean(term) && !String(card.dataset.searchText || card.textContent || '').toLowerCase().includes(term);
                });
              });
            }
          } catch {}
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => void enhanceCatalog(), { once: true });
        else void enhanceCatalog();
        return;
      }

      if (!isCanonicalLoadBoard) return;
      const root = document.querySelector("[data-hlb-live-marketplace]");
      if (!(root instanceof HTMLElement)) return;

      const moveIntoCanonicalPosition = () => {
        const hero = document.querySelector('.load-board-hero');
        if (hero?.parentElement) { hero.insertAdjacentElement('afterend', root); return; }
        const demo = document.querySelector(".available-loads-preview");
        if (demo?.parentElement) demo.parentElement.insertBefore(root, demo);
      };
      const registrationHref = (record) => {
        const url = new URL(accessPath, window.location.origin);
        url.searchParams.set('source', 'load-board-curtain');
        if (record?.id) url.searchParams.set('load', String(record.id).slice(0, 80));
        return url.pathname + url.search;
      };
      const scanMiles = (value, label) => {
        const amount = Number(value);
        return Number.isFinite(amount) && amount >= 0 ? `${label} ${Math.round(amount).toLocaleString("en-US")} mi` : "";
      };
      const scanMeasure = (value, unit) => {
        const amount = Number(value);
        if (!Number.isFinite(amount) || amount <= 0) return "";
        const formatted = unit === "lb" ? Math.round(amount).toLocaleString("en-US") : String(Math.round(amount * 10) / 10);
        return `${formatted} ${unit}`;
      };
      const scanTiming = (record) => [
        record?.pickupWindow ? `PU ${record.pickupWindow}` : "PU pending",
        record?.deliveryWindow ? `DEL ${record.deliveryWindow}` : "DEL pending",
      ].join(" · ");
      const scanDistance = (record) => [scanMiles(record?.distanceMiles, "Loaded"), scanMiles(record?.deadheadMiles, "DH")].filter(Boolean).join(" · ") || "Mileage pending";
      const scanSize = (record) => [scanMeasure(record?.weightLbs, "lb"), scanMeasure(record?.lengthFeet, "ft")].filter(Boolean).join(" · ") || "Weight / length pending";

      const formatNumber = (value) => Number(value || 0).toLocaleString("en-US");
      const previewRows = (count) => Array.from({ length: count }, (_, index) => {
        const base = previewDemoLoads[index % previewDemoLoads.length];
        const cycle = Math.floor(index / previewDemoLoads.length);
        const rate = Number(base.rateAmount) + cycle * 25;
        const deadhead = Number(base.deadheadMiles) + cycle * 3;
        const rpm = (rate / Number(base.distanceMiles)).toFixed(2);
        return `<a class="hlb-live-row hlb-live-row--locked hlb-structural-preview hlb-demo-row" href="${escapeHtml(registrationHref(null))}" data-rate="${rate}" data-rpm="${rpm}" data-deadhead="${deadhead}" data-weight="${Number(base.weightLbs || 0)}" aria-label="Sanitized demo lane ${escapeHtml(base.origin)} to ${escapeHtml(base.destination)}. Register in Hermes Connect to unlock live Load Board access"><span class="hlb-col-sample">DEMO</span><div class="hlb-col-pickup"><strong>${escapeHtml(base.pickup)}</strong><small>${escapeHtml(base.delivery)}</small></div><div class="hlb-live-route hlb-col-lane"><span>${escapeHtml(base.origin)}</span><b>→</b><span>${escapeHtml(base.destination)}</span></div><span class="hlb-col-dh">${deadhead} mi</span><span class="hlb-col-trip">${formatNumber(base.distanceMiles)} mi</span><div class="hlb-live-rate hlb-col-rate"><strong>$${formatNumber(rate)}</strong><small>${rpm} RPM</small></div><div class="hlb-col-equip"><strong>${escapeHtml(equipmentLabel(base.equipment))}</strong><small>${escapeHtml(base.loadType)} · ${escapeHtml(base.lengthFeet)} ft</small></div><div class="hlb-col-weight"><strong>${base.weightLbs ? `${formatNumber(base.weightLbs)} lb` : 'Weight n/a'}</strong><small>${escapeHtml(base.commodity)}</small></div><div class="hlb-col-status"><span class="hlb-demo-pill">PREVIEW · NOT LIVE</span><small>Sanitized example</small></div></a>`;
      }).join('');
      const renderImmediatePreview = () => {
        const rows = root.querySelector("[data-live-load-rows]");
        if (rows instanceof HTMLElement) rows.innerHTML = previewRows(60);
      };

      const renderLoads = (records, accessGranted, aggregateCount) => {
        const rows = root.querySelector("[data-live-load-rows]");
        const count = root.querySelector("[data-live-load-count]");
        const status = root.querySelector("[data-live-load-status]");
        const badge = root.querySelector('[data-hlb-mode-badge]');
        const accessLabel = root.querySelector('[data-hlb-access-label]');
        const accessCopy = root.querySelector('[data-hlb-access-copy]');
        const previewNote = root.querySelector('[data-hlb-preview-note]');
        const curtain = root.querySelector('[data-hlb-curtain-card]');
        if (!(rows instanceof HTMLElement)) return;
        const active = Array.isArray(records) ? records : [];
        const truthfulCount = aggregateCount != null && Number.isFinite(Number(aggregateCount)) && Number(aggregateCount) >= 0 ? Number(aggregateCount) : null;
        if (count) count.textContent = truthfulCount === null ? "—" : String(truthfulCount);
        if (status) status.textContent = truthfulCount === null ? "Live count temporarily unavailable" : truthfulCount ? `${truthfulCount} active record${truthfulCount === 1 ? '' : 's'} · refreshed automatically` : "No approved active freight right now";
        if (badge) badge.textContent = accessGranted ? 'ACCESS OPEN' : 'CURTAIN VIEW';
        if (accessLabel) accessLabel.textContent = accessGranted ? 'Hermes company access active' : 'Public curtain view';
        if (accessCopy) accessCopy.textContent = accessGranted ? 'Your company profile has unlocked carrier-access Load Board records.' : 'LIVE count is real. Rich rows labeled PREVIEW · NOT LIVE are sanitized product-demo examples; company registration unlocks live source records and actions.';
        if (previewNote instanceof HTMLElement) previewNote.hidden = accessGranted;
        if (curtain instanceof HTMLElement) curtain.hidden = accessGranted;

        if (accessGranted) {
          root.classList.add('is-unlocked');
          if (!active.length) {
            rows.innerHTML = '<div class="hlb-live-empty"><strong>0 active loads right now.</strong><span>Your access is open; new approved records will appear automatically.</span></div>';
            return;
          }
          rows.innerHTML = active.map((record) => `<article class="hlb-live-row hlb-live-row--open" data-load-id="${escapeHtml(record.id)}" data-rate="${Number(record.rateAmount || 0)}" data-rpm="${Number(record.ratePerMile || 0)}" data-deadhead="${Number(record.deadheadMiles || 0)}" data-weight="${Number(record.weightLbs || 0)}"><span class="hlb-col-sample hlb-col-live">${escapeHtml(age(record.observedAt))}</span><div class="hlb-col-pickup"><strong>${escapeHtml(record.pickupWindow || 'Pickup pending')}</strong><small>${escapeHtml(record.deliveryWindow || 'Delivery pending')}</small></div><div class="hlb-live-route hlb-col-lane"><span>${escapeHtml(record.origin)}</span><b>→</b><span>${escapeHtml(record.destination || "Open destination")}</span></div><span class="hlb-col-dh">${escapeHtml(scanMiles(record.deadheadMiles, '')) || '—'}</span><span class="hlb-col-trip">${escapeHtml(scanMiles(record.distanceMiles, '')) || '—'}</span><div class="hlb-live-rate hlb-col-rate"><strong>${escapeHtml(money(record))}</strong><small>${record.ratePerMile ? `${escapeHtml(record.ratePerMile)} RPM` : 'RPM pending'}</small></div><div class="hlb-col-equip"><strong>${escapeHtml(equipmentLabel(record.equipment))}</strong><small>${record.lengthFeet ? `${escapeHtml(record.lengthFeet)} ft` : 'Size pending'}</small></div><div class="hlb-col-weight"><strong>${record.weightLbs ? `${Number(record.weightLbs).toLocaleString('en-US')} lb` : 'Weight pending'}</strong><small>${escapeHtml(record.paymentTerms || record.source || 'Approved source')}</small></div><div class="hlb-col-status"><span class="hlb-live-pill">LIVE</span><small>${escapeHtml(record.source || 'Approved source')}</small></div></article>`).join("");
          return;
        }

        root.classList.remove('is-unlocked');
        const publicPreview = active.slice(0, 6).map((record) => `<a class="hlb-live-row hlb-live-row--locked hlb-live-row--real" href="${escapeHtml(registrationHref(record))}" aria-label="Register in Hermes Connect to unlock load details"><span class="hlb-col-sample hlb-col-live">LIVE</span><div class="hlb-col-pickup"><strong class="hlb-mask">${escapeHtml(record.pickupWindow || 'Pickup window')}</strong><small>Delivery after sign-in</small></div><div class="hlb-live-route hlb-col-lane"><span>${escapeHtml(record.origin)}</span><b>→</b><span>${escapeHtml(record.destination || 'Destination locked')}</span></div><span class="hlb-col-dh">—</span><span class="hlb-col-trip">—</span><div class="hlb-live-rate hlb-col-rate"><strong>🔒 ${escapeHtml(money(record))}</strong><small>RPM after sign-in</small></div><div class="hlb-col-equip"><strong>${escapeHtml(equipmentLabel(record.equipment))}</strong><small>Approved source</small></div><div class="hlb-col-weight"><strong>Details locked</strong><small>Weight / commodity</small></div><div class="hlb-col-status"><span class="hlb-live-pill">LIVE</span><small>Company access</small></div></a>`).join('');
        const structuralCount = Math.max(54, 60 - Math.min(active.length, 6));
        rows.innerHTML = publicPreview + previewRows(structuralCount);
      };

      const renderCapacity = (records) => {
        const rows = root.querySelector("[data-live-capacity-rows]");
        const count = root.querySelector("[data-live-capacity-count]");
        const status = root.querySelector("[data-live-capacity-status]");
        if (!(rows instanceof HTMLElement)) return;
        const active = Array.isArray(records) ? records : [];
        if (count) count.textContent = String(active.length);
        if (status) status.textContent = active.length ? `Updated ${age(active[0]?.observedAt)}` : "No approved active trucks right now";
        if (!active.length) { rows.innerHTML = '<div class="hlb-live-empty"><strong>0 active capacity records.</strong><span>Truck lists are counted separately and never inflate the freight total.</span></div>'; return; }
        rows.innerHTML = active.slice(0, 8).map((record) => `<article class="hlb-live-row hlb-live-row--capacity"><div class="hlb-live-route"><span>${escapeHtml(record.origin)}</span><b>→</b><span>${escapeHtml(record.destination || "Open destination")}</span></div><div class="hlb-live-meta"><span>${escapeHtml(equipmentLabel(record.equipment))}</span><span>${escapeHtml(record.pickupWindow || record.availability || "Available")}</span><span>${escapeHtml(record.source || "Approved source")}</span></div><div class="hlb-live-rate"><strong>Truck available</strong><small>${escapeHtml(age(record.observedAt))}</small></div></article>`).join("");
      };

      const fetchJson = async (url) => {
        const response = await fetch(url, { headers: { Accept: "application/json" }, cache: "no-store", signal: AbortSignal.timeout(8000) });
        if (!response.ok) throw new Error(`load_board_${response.status}`);
        return response.json();
      };
      const refreshButton = root.querySelector('[data-live-refresh]');
      let refreshInFlight = false;
      const refresh = async () => {
        if (refreshInFlight) return;
        refreshInFlight = true;
        if (refreshButton) {
          refreshButton.disabled = true;
          refreshButton.textContent = 'Refreshing…';
        }
        try {
        const results = await Promise.allSettled([
          fetchJson('/api/load-board/active?type=load'),
          fetchJson('/api/load-board/active?type=capacity'),
          fetchJson('/api/load-board/summary'),
        ]);
        const loadPayload = results[0].status === 'fulfilled' ? results[0].value : { records: [], load_board_access: false, audience: 'public' };
        const capacityPayload = results[1].status === 'fulfilled' ? results[1].value : { records: [] };
        const summaryPayload = results[2].status === 'fulfilled' ? results[2].value : null;
        const accessGranted = Boolean(loadPayload.load_board_access || loadPayload.audience === 'carrier_candidate');
        renderLoads(loadPayload.records, accessGranted, summaryPayload?.available_loads);
        renderCapacity(capacityPayload.records);
        if (results[0].status !== 'fulfilled') {
          const status = root.querySelector('[data-live-load-status]');
          if (status) status.textContent = 'Live feed temporarily unavailable. Interface preview is still available.';
        }
        if (results[1].status !== 'fulfilled') {
          const count = root.querySelector('[data-live-capacity-count]');
          const status = root.querySelector('[data-live-capacity-status]');
          if (count) count.textContent = '—';
          if (status) status.textContent = 'Truck feed temporarily unavailable';
        }
        } finally {
          refreshInFlight = false;
          if (refreshButton) {
            refreshButton.disabled = false;
            refreshButton.textContent = 'Refresh now';
          }
        }
      };

      refreshButton?.addEventListener('click', () => { void refresh(); });

      moveIntoCanonicalPosition();
      renderImmediatePreview();
      void refresh();
      window.setInterval(() => { if (document.visibilityState === "visible") void refresh(); }, 30_000);
    })();
  </script>
)}

