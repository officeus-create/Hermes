---
import { ArrowLeft, ArrowRight, BookOpen, Check, FileCheck, ShieldCheck, Video } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

export interface InsightLink {
  title: string;
  body: string;
  href: string;
}

export interface InsightVideo {
  name: string;
  description: string;
  thumbnailUrl: string;
  uploadDate: string;
  contentUrl?: string;
  embedUrl?: string;
  duration?: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  conciseAnswer: string;
  explanation: string[];
  takeaways: string[];
  faq: Array<{ question: string; answer: string }>;
  related: InsightLink[];
  primaryAction: { label: string; href: string };
  secondaryAction: { label: string; href: string };
  canonicalPath: string;
  sourceLabel: string;
  sourceUrl?: string | null;
  sourcePublishedAt?: string | null;
  datePublished: string;
  dateModified: string;
  directionName: string;
  directionOwnerUrl: string;
  authorName: string;
  video?: InsightVideo | null;
  reviewMode?: boolean;
  robots?: string;
}

const {
  title,
  description,
  eyebrow,
  h1,
  conciseAnswer,
  explanation,
  takeaways,
  faq,
  related,
  primaryAction,
  secondaryAction,
  canonicalPath,
  sourceLabel,
  sourceUrl = null,
  sourcePublishedAt = null,
  datePublished,
  dateModified,
  directionName,
  directionOwnerUrl,
  authorName,
  video = null,
  reviewMode = false,
  robots = reviewMode ? "noindex,nofollow,noarchive" : "index,follow,max-image-preview:large",
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const directionUrl = new URL(directionOwnerUrl, Astro.site).toString();
const sourceIsSynthetic = sourceUrl?.includes("example.invalid") ?? false;
const hasVideoSchema = Boolean(
  video &&
    video.name &&
    video.description &&
    video.thumbnailUrl &&
    video.uploadDate &&
    (video.contentUrl || video.embedUrl),
);
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: h1,
  description,
  datePublished,
  dateModified,
  mainEntityOfPage: canonicalUrl,
  author: { "@type": "Organization", name: authorName },
  publisher: { "@id": "https://hermeslogisticsus.com/#organization" },
  about: { "@type": "Thing", name: directionName, url: directionUrl },
  isBasedOn: sourceUrl && !sourceIsSynthetic ? sourceUrl : undefined,
};
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `${h1} — ${directionName}`,
  description,
  url: canonicalUrl,
  provider: { "@id": "https://hermeslogisticsus.com/#organization" },
  serviceType: "Educational insight and reviewed business guidance",
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
    { "@type": "ListItem", position: 2, name: directionName, item: directionUrl },
    { "@type": "ListItem", position: 3, name: h1, item: canonicalUrl },
  ],
};
const videoSchema = hasVideoSchema && video
  ? {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      name: video.name,
      description: video.description,
      thumbnailUrl: [video.thumbnailUrl],
      uploadDate: video.uploadDate,
      contentUrl: video.contentUrl,
      embedUrl: video.embedUrl,
      duration: video.duration,
    }
  : null;
const schema = videoSchema
  ? [articleSchema, serviceSchema, videoSchema, faqSchema, breadcrumbSchema]
  : [articleSchema, serviceSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout title={title} description={description} schema={schema} robots={robots}>
  <div class="logistics-resource-page content-insight-page">
    <SiteHeader theme="dark" />
    <main id="main-content">
      <article>
        <header class="resource-hero resource-hero-carrier" id="top">
          <div class="shell">
            <nav class="appleton-breadcrumbs" aria-label="Breadcrumb">
              <a href="/">Home</a><span aria-hidden="true">/</span>
              <a href={directionOwnerUrl}>{directionName}</a><span aria-hidden="true">/</span>
              <span aria-current="page">Insight</span>
            </nav>
            {reviewMode && <a class="detail-back" href="/demos/content-pipeline/"><ArrowLeft size={18} aria-hidden="true" />Review workspace</a>}
            <div class="resource-hero-grid">
              <div>
                <p class="eyebrow">{eyebrow}</p>
                <h1>{h1}</h1>
                <p>{conciseAnswer}</p>
                <div class="logistics-audience-actions">
                  <a class="button button-primary" href={primaryAction.href}>{primaryAction.label}<ArrowRight size={18} aria-hidden="true" /></a>
                  <a class="button" href={secondaryAction.href}>{secondaryAction.label}</a>
                </div>
              </div>
              <aside class="resource-safety-card">
                <ShieldCheck size={30} aria-hidden="true" />
                <h2>{reviewMode ? "Review-only preview" : "Evidence and scope"}</h2>
                <p>{reviewMode ? "This preview is noindex and uses synthetic or owner-review data. It is not approved for public distribution." : "Use the source date, evidence boundary, related owner page, and current review status before relying on this material."}</p>
              </aside>
            </div>
          </div>
        </header>

        <section class="section resource-intro" aria-labelledby="insight-answer-title">
          <div class="shell resource-lead">
            <FileCheck size={36} aria-hidden="true" />
            <div>
              <p class="eyebrow">Concise answer</p>
              <h2 id="insight-answer-title">What should the reader understand first?</h2>
              <p>{conciseAnswer}</p>
            </div>
          </div>
        </section>

        {video && (
          <section class="section capacity-review" aria-labelledby="insight-video-title">
            <div class="shell">
              <div class="section-heading split-heading">
                <div><p class="eyebrow">Video source</p><h2 id="insight-video-title">Video requires a stable public watch source.</h2></div>
                <Video size={36} aria-hidden="true" />
              </div>
              {hasVideoSchema ? (
                <div class="resource-lead"><Check size={28} aria-hidden="true" /><div><h3>Video schema eligible</h3><p>The required name, description, thumbnail, upload date, and content or embed URL are present.</p></div></div>
              ) : (
                <div class="resource-lead"><ShieldCheck size={28} aria-hidden="true" /><div><h3>Video schema held</h3><p>Do not emit VideoObject until a stable public watch page, thumbnail, upload date, description, and content or embed URL are verified.</p></div></div>
              )}
            </div>
          </section>
        )}

        <section class="section capacity-pillars" aria-labelledby="insight-takeaways-title">
          <div class="shell">
            <div class="section-heading"><p class="eyebrow">Key takeaways</p><h2 id="insight-takeaways-title">The practical points worth reusing.</h2></div>
            <div class="capacity-pillar-grid">
              {takeaways.map((item, index) => (
                <article><span>{String(index + 1).padStart(2, "0")}</span><Check size={23} aria-hidden="true" /><h3>{item}</h3></article>
              ))}
            </div>
          </div>
        </section>

        <section class="section capacity-example" aria-labelledby="insight-explanation-title">
          <div class="shell capacity-example-grid">
            <div>
              <p class="eyebrow">Expanded explanation</p>
              <h2 id="insight-explanation-title">Connect the source to a complete decision.</h2>
              <p>A social post supplies an idea or proof point. The website version must add enough context, evidence, boundaries, links, and next steps to stand on its own.</p>
            </div>
            <dl>
              {explanation.map((item, index) => <div><dt>{index + 1}. Review point</dt><dd>{item}</dd></div>)}
            </dl>
          </div>
        </section>

        <section class="section capacity-review" aria-labelledby="insight-source-title">
          <div class="shell">
            <div class="section-heading"><p class="eyebrow">Source and freshness</p><h2 id="insight-source-title">Keep attribution and review state visible.</h2></div>
            <div class="capacity-boundary-grid">
              <article><strong>Source</strong><p>{sourceLabel}</p></article>
              <article><strong>Original date</strong><p>{sourcePublishedAt ?? "Not yet verified"}</p></article>
              <article><strong>Website review</strong><p>Published {datePublished}; last modified {dateModified}.</p></article>
              <article><strong>External source link</strong><p>{sourceUrl && !sourceIsSynthetic ? sourceUrl : "Held until a stable approved source URL is verified."}</p></article>
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="insight-faq-title">
          <div class="shell digital-faq-layout">
            <div><p class="eyebrow">Frequently asked questions</p><h2 id="insight-faq-title">Questions the short social post could not fully answer.</h2></div>
            <div class="digital-faq-list">
              {faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
            </div>
          </div>
        </section>

        <section class="section resource-related" aria-labelledby="insight-related-title">
          <div class="shell">
            <div class="section-heading"><p class="eyebrow">Internal linking</p><h2 id="insight-related-title">Continue to the canonical service, resource, or program owner.</h2></div>
            <div class="resource-related-grid">
              {related.map((item) => (
                <a href={item.href}><BookOpen size={22} aria-hidden="true" /><h3>{item.title}</h3><p>{item.body}</p><strong>Open related page <ArrowRight size={16} aria-hidden="true" /></strong></a>
              ))}
            </div>
          </div>
        </section>
      </article>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
