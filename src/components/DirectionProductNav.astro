---
import {
  ArrowUpRight,
  BookOpen,
  BriefcaseBusiness,
  Building2,
  Code2,
  GraduationCap,
  Megaphone,
  Route,
  Search,
  Sparkles,
  Truck,
  UsersRound,
  Workflow,
} from "@lucide/astro";

export type DirectionId = "logistics" | "marketing" | "technology" | "academy";

interface Props {
  direction: DirectionId;
  theme?: "light" | "dark";
}

const { direction, theme = "light" } = Astro.props;
const currentPath = Astro.url.pathname;

const configs = {
  logistics: {
    brand: "Hermes Logistics",
    subtitle: "Freight · operations · technology",
    home: "/paths/logistics/",
    accent: "#5634c8",
    items: [
      { id: "load-board", label: "Load Board", href: "/load-board/", icon: Route },
      { id: "carriers", label: "Carriers & Fleets", href: "/paths/logistics/carriers/fleet-owners/", icon: Truck },
      { id: "agreement", label: "Agreement", href: "/carrier/", icon: BriefcaseBusiness },
      { id: "owner-operators", label: "Owner-Operators", href: "/paths/logistics/carriers/owner-operators/", icon: UsersRound },
      { id: "brokers", label: "Brokers", href: "/paths/logistics/brokers/carrier-capacity/", icon: BriefcaseBusiness },
      { id: "shippers-dealers", label: "Shippers & Dealers", href: "/paths/logistics/customers/vehicle-transport/", icon: Building2 },
      { id: "operations", label: "Dispatch & Back Office", href: "/logistics/car-hauling-dispatch/", icon: Workflow },
      { id: "path", label: "Find Your Path", href: "/paths/logistics/find-your-path/", icon: ArrowUpRight },
    ],
  },
  marketing: {
    brand: "Hermes Marketing",
    subtitle: "Websites · SEO/GEO · social · demand",
    home: "/paths/marketing/",
    accent: "#c51b72",
    items: [
      { id: "growth", label: "Growth System", href: "/business-growth/", icon: Sparkles },
      { id: "websites", label: "Websites", href: "/gb/london/website-development/", icon: Code2 },
      { id: "seo", label: "SEO & GEO", href: "/gb/london/seo-services/", icon: Search },
      { id: "social", label: "Social Media", href: "/gb/london/social-media-management/", icon: Megaphone },
      { id: "ads", label: "Meta Ads", href: "/gb/london/meta-ads/", icon: Sparkles },
      { id: "london", label: "London", href: "/gb/london/", icon: Building2 },
      { id: "learn", label: "Learn Marketing", href: "/academy/marketing/", icon: GraduationCap },
    ],
  },
  technology: {
    brand: "Hermes IT",
    subtitle: "Products · systems · AI · automation",
    home: "/paths/technology/",
    accent: "#087f82",
    items: [
      { id: "connect", label: "Hermes Connect", href: "/services/hermes-connect/", icon: Sparkles },
      { id: "load-board", label: "Load Board", href: "/load-board/", icon: Route },
      { id: "websites", label: "Web Development", href: "/gb/london/website-development/", icon: Code2 },
      { id: "capabilities", label: "Capabilities", href: "/paths/technology/#service-groups-title", icon: Workflow },
      { id: "brief", label: "Project Brief", href: "/paths/technology/#project-brief", icon: BriefcaseBusiness },
      { id: "case", label: "IT Development", href: "/case/it-development/", icon: Code2 },
      { id: "academy", label: "Learn IT & AI", href: "/paths/academy/#academy-it", icon: BookOpen },
    ],
  },
  academy: {
    brand: "Hermes Academy",
    subtitle: "Logistics · marketing · IT · sales · operations",
    home: "/paths/academy/",
    accent: "#a56b00",
    items: [
      { id: "logistics", label: "Logistics", href: "/academy/us-logistics-operations/", icon: Truck },
      { id: "marketing", label: "Marketing", href: "/academy/marketing/", icon: Megaphone },
      { id: "it", label: "IT & AI", href: "/paths/academy/#academy-it", icon: Code2 },
      { id: "sales", label: "Sales", href: "/paths/academy/#academy-sales", icon: BriefcaseBusiness },
      { id: "operations", label: "COO / Operations", href: "/paths/academy/#academy-operations", icon: Workflow },
      { id: "method", label: "How Training Works", href: "/academy/how-training-works/", icon: BookOpen },
      { id: "apply", label: "Apply", href: "/academy/apply/", icon: GraduationCap },
    ],
  },
} as const;

const config = configs[direction];
const pathOnly = (href: string) => href.split("#")[0];
const isActive = (href: string) => {
  const target = pathOnly(href);
  return target !== config.home && (currentPath === target || currentPath.startsWith(target.endsWith("/") ? target : `${target}/`));
};
---

<nav
  class={`direction-product-nav direction-product-nav--${theme} direction-product-nav--${direction}`}
  aria-label={`${config.brand} products and paths`}
  data-direction-product-nav={direction}
  style={`--direction-nav-accent:${config.accent}`}
>
  <div class="shell direction-product-nav__inner">
    <a class="direction-product-nav__brand" href={config.home} aria-current={currentPath === config.home ? "page" : undefined}>
      <span>{config.brand}</span>
      <small>{config.subtitle}</small>
    </a>
    <div class="direction-product-nav__links">
      {config.items.map((item) => {
        const Icon = item.icon;
        return (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined} data-direction-product-link={item.id}>
            <Icon size={15} aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        );
      })}
    </div>
  </div>
</nav>

<style>
  .direction-product-nav{position:sticky;top:84px;z-index:35;border-bottom:1px solid rgba(17,19,36,.1);backdrop-filter:blur(18px) saturate(1.04)}
  .direction-product-nav--light{background:rgba(255,255,255,.94);color:#111324}
  .direction-product-nav--dark{background:rgba(7,16,56,.94);color:#fff;border-bottom-color:rgba(255,255,255,.12)}
  .direction-product-nav__inner{display:flex;align-items:center;gap:1rem;min-height:58px}
  .direction-product-nav__brand{display:grid;gap:.08rem;flex:0 0 auto;color:inherit;text-decoration:none;padding-right:1rem;border-right:1px solid color-mix(in srgb,currentColor 24%,transparent)}
  .direction-product-nav__brand span{font-weight:800;font-size:.8rem;letter-spacing:.02em}
  .direction-product-nav__brand small{font-size:.63rem;opacity:.58;white-space:nowrap}
  .direction-product-nav__links{display:flex;align-items:center;gap:.25rem;min-width:0;overflow-x:auto;scrollbar-width:none;padding:.45rem 0;overscroll-behavior-inline:contain}
  .direction-product-nav__links::-webkit-scrollbar{display:none}
  .direction-product-nav__links a{display:inline-flex;align-items:center;gap:.35rem;min-height:34px;padding:.45rem .62rem;border:1px solid transparent;border-radius:999px;color:inherit;text-decoration:none;font-size:.72rem;font-weight:650;white-space:nowrap;opacity:.72;transition:opacity .2s ease,border-color .2s ease,background .2s ease,transform .2s ease}
  .direction-product-nav__links a:hover,.direction-product-nav__links a:focus-visible,.direction-product-nav__links a[aria-current="page"]{opacity:1;border-color:color-mix(in srgb,var(--direction-nav-accent) 28%,transparent);background:color-mix(in srgb,var(--direction-nav-accent) 9%,transparent)}
  .direction-product-nav__links a:hover{transform:translateY(-1px)}
  .direction-product-nav--dark .direction-product-nav__links a:hover,.direction-product-nav--dark .direction-product-nav__links a:focus-visible,.direction-product-nav--dark .direction-product-nav__links a[aria-current="page"]{border-color:color-mix(in srgb,var(--direction-nav-accent) 45%,white 5%);background:color-mix(in srgb,var(--direction-nav-accent) 20%,transparent)}
  @media(max-width:980px){.direction-product-nav{top:72px}.direction-product-nav__inner{display:grid;grid-template-columns:1fr;gap:0;padding:.35rem 0}.direction-product-nav__brand{display:none}.direction-product-nav__links{width:100%;padding:.35rem 0}.direction-product-nav__links a{min-height:36px}}
  @media(prefers-reduced-motion:reduce){.direction-product-nav__links a{transition:none}}
</style>
