---
import {
  ArrowUpRight,
  BookOpen,
  BriefcaseBusiness,
  Building2,
  Code2,
  FileSignature,
  GraduationCap,
  Megaphone,
  Route,
  Search,
  Sparkles,
  Truck,
  UsersRound,
  Workflow,
} from "@lucide/astro";

export type DirectionId = "logistics" | "marketing" | "technology" | "academy" | "catalog";

interface Props {
  direction: DirectionId;
  theme?: "light" | "dark";
  locale?: "en" | "ru";
}

const { direction, theme = "light", locale = "en" } = Astro.props;
const currentPath = Astro.url.pathname;

const configs = {
  logistics: {
    brand: "Hermes Logistics",
    subtitle: "Freight · operations · technology",
    home: "/paths/logistics/",
    accent: "#1E88FF",
    items: [
      { id: "load-board", label: "Load Board", href: "/load-board/", icon: Route },
      { id: "carriers", label: "Carriers & Fleets", href: "/paths/logistics/carriers/fleet-owners/", icon: Truck },
      { id: "agreement", label: "Agreement", href: "/carrier/", icon: FileSignature },
      { id: "owner-operators", label: "Owner-Operators", href: "/paths/logistics/carriers/owner-operators/", icon: UsersRound },
      { id: "brokers", label: "Brokers", href: "/paths/logistics/brokers/carrier-capacity/", icon: BriefcaseBusiness },
      { id: "shippers-dealers", label: "Shippers & Dealers", href: "/paths/logistics/customers/vehicle-transport/", icon: Building2 },
      { id: "operations", label: "Dispatch & Back Office", href: "/logistics/car-hauling-dispatch/", icon: Workflow },
      { id: "path", label: "Find Your Path", href: "/paths/logistics/find-your-path/", icon: ArrowUpRight },
      { id: "catalog", label: "Catalog", href: "/businesses/", icon: Search },
    ],
  },
  marketing: {
    brand: "Hermes Marketing",
    subtitle: "Websites · SEO/GEO · social · demand",
    home: "/paths/marketing/",
    accent: "#00C853",
    items: [
      { id: "growth", label: "Growth System", href: "/business-growth/", icon: Sparkles },
      { id: "websites", label: "Websites", href: "/gb/london/website-development/", icon: Code2 },
      { id: "seo", label: "SEO & GEO", href: "/gb/london/seo-services/", icon: Search },
      { id: "social", label: "Social Media", href: "/gb/london/social-media-management/", icon: Megaphone },
      { id: "ads", label: "Meta Ads", href: "/gb/london/meta-ads/", icon: Sparkles },
      { id: "london", label: "London", href: "/gb/london/", icon: Building2 },
      { id: "learn", label: "Learn Marketing", href: "/academy/marketing/", icon: GraduationCap },
      { id: "catalog", label: "Catalog", href: "/businesses/", icon: Building2 },
    ],
  },
  technology: {
    brand: "Hermes Technology",
    subtitle: "Products · systems · AI · automation",
    home: "/paths/technology/",
    accent: "#FF7A00",
    items: [
      { id: "connect", label: "Hermes Connect", href: "/services/hermes-connect/", icon: Sparkles },
      { id: "load-board", label: "Load Board", href: "/load-board/", icon: Route },
      { id: "websites", label: "Web Development", href: "/gb/london/website-development/", icon: Code2 },
      { id: "capabilities", label: "Capabilities", href: "/paths/technology/#service-groups-title", icon: Workflow },
      { id: "brief", label: "Project Brief", href: "/paths/technology/#project-brief", icon: BriefcaseBusiness },
      { id: "case", label: "IT Development", href: "/case/it-development/", icon: Code2 },
      { id: "academy", label: "Learn IT & AI", href: "/paths/academy/#academy-it", icon: BookOpen },
      { id: "catalog", label: "Catalog", href: "/businesses/", icon: Building2 },
    ],
  },
  academy: {
    brand: "Hermes Academy",
    subtitle: "Logistics · marketing · IT · sales · operations",
    home: "/paths/academy/",
    accent: "#7C5CFF",
    items: [
      { id: "logistics", label: "Logistics", href: "/academy/us-logistics-operations/", icon: Truck },
      { id: "marketing", label: "Marketing", href: "/academy/marketing/", icon: Megaphone },
      { id: "it", label: "IT & AI", href: "/paths/academy/#academy-it", icon: Code2 },
      { id: "sales", label: "Sales", href: "/paths/academy/#academy-sales", icon: BriefcaseBusiness },
      { id: "operations", label: "COO / Operations", href: "/paths/academy/#academy-operations", icon: Workflow },
      { id: "method", label: "How Training Works", href: "/academy/how-training-works/", icon: BookOpen },
      { id: "apply", label: "Apply", href: "/academy/apply/", icon: GraduationCap },
      { id: "catalog", label: "Catalog", href: "/businesses/", icon: Building2 },
    ],
  },
  catalog: {
    brand: "Hermes Catalog",
    subtitle: "Businesses · services · locations · Connect",
    home: "/businesses/",
    accent: "#22A39F",
    items: [
      { id: "search", label: "Search", href: "/businesses/#catalog-search", icon: Search },
      { id: "categories", label: "Categories", href: "/businesses/#categories", icon: BriefcaseBusiness },
      { id: "locations", label: "Locations", href: "/businesses/#locations", icon: Route },
      { id: "owners", label: "Business Owners", href: "/businesses/#business-owners", icon: UsersRound },
      { id: "ecosystem", label: "Hermes Services", href: "/businesses/#hermes-ecosystem", icon: Workflow },
      { id: "connect", label: "Hermes Connect", href: "/services/hermes-connect/", icon: Sparkles },
    ],
  },
} as const;

const ruOverrides: Partial<Record<DirectionId, {
  home?: string;
  subtitle?: string;
  items?: Record<string, { label?: string; href?: string }>;
}>> = {
  logistics: {
    home: "/ru/logistics/",
    subtitle: "Грузы · операции · технологии",
    items: {
      "load-board": { label: "Load Board" },
      carriers: { label: "Перевозчики и автопарки" },
      agreement: { label: "Договор и подключение" },
      "owner-operators": { label: "Owner-operators" },
      brokers: { label: "Брокеры" },
      "shippers-dealers": { label: "Отправители и дилеры" },
      operations: { label: "Dispatch и back office" },
      path: { label: "Подобрать маршрут" },
      catalog: { label: "Каталог" },
    },
  },
  marketing: {
    home: "/ru/marketing/",
    subtitle: "Сайты · SEO/GEO · соцсети · спрос",
    items: {
      growth: { label: "Система роста", href: "/ru/business-growth/" },
      websites: { label: "Сайты", href: "/ru/business-growth/website/" },
      seo: { label: "SEO и GEO", href: "/ru/business-growth/seo/" },
      social: { label: "Социальные сети", href: "/ru/business-growth/social-media/" },
      ads: { label: "Реклама", href: "/ru/business-growth/advertising/" },
      london: { label: "Международный рынок", href: "/ru/gb/london/marketing/" },
      learn: { label: "Обучение маркетингу" },
      catalog: { label: "Каталог" },
    },
  },
  technology: {
    home: "/ru/technology/",
    subtitle: "Продукты · системы · AI · автоматизация",
    items: {
      connect: { label: "Hermes Connect", href: "/services/hermes-connect/?lang=ru" },
      "load-board": { label: "Load Board", href: "/load-board/" },
      websites: { label: "Разработка сайтов", href: "/ru/business-growth/website/" },
      capabilities: { label: "Возможности", href: "/ru/technology/#scope" },
      brief: { label: "Бриф проекта" },
      case: { label: "IT-разработка" },
      academy: { label: "Обучение IT и AI", href: "/ru/academy/" },
      catalog: { label: "Каталог" },
    },
  },
  academy: {
    home: "/ru/academy/",
    subtitle: "Логистика · маркетинг · IT · продажи · операции",
    items: {
      logistics: { label: "Логистика", href: "/ru/academy/us-logistics-operations/" },
      marketing: { label: "Маркетинг" },
      it: { label: "IT и AI", href: "/ru/academy/" },
      sales: { label: "Продажи", href: "/ru/academy/" },
      operations: { label: "COO / Операции", href: "/ru/academy/" },
      method: { label: "Как проходит обучение" },
      apply: { label: "Подать заявку" },
      catalog: { label: "Каталог" },
    },
  },
};

const config = configs[direction];
const localeOverride = locale === "ru" ? ruOverrides[direction] : undefined;
const home = localeOverride?.home ?? config.home;
const subtitle = localeOverride?.subtitle ?? config.subtitle;
const items = config.items.map((item) => {
  const override = localeOverride?.items?.[item.id];
  return {
    ...item,
    label: override?.label ?? item.label,
    href: override?.href ?? item.href,
  };
});
const pathOnly = (href: string) => href.split("#")[0];
const isActive = (href: string) => {
  const target = pathOnly(href);
  return target !== home && (currentPath === target || currentPath.startsWith(target.endsWith("/") ? target : `${target}/`));
};
---

<nav
  class={`direction-product-nav direction-product-nav--${theme} direction-product-nav--${direction}`}
  aria-label={`${config.brand} products and paths`}
  data-direction-product-nav={direction}
  data-direction-product-locale={locale}
  style={`--direction-nav-accent:${config.accent}`}
>
  <div class="shell direction-product-nav__inner">
    <a class="direction-product-nav__brand" href={home} aria-current={currentPath === home ? "page" : undefined}>
      <span>{config.brand}</span>
      <small>{subtitle}</small>
    </a>
    <div class="direction-product-nav__links">
      {items.map((item) => {
        const Icon = item.icon;
        return (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined} data-direction-product-link={item.id}>
            <Icon size={15} aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        );
      })}
    </div>
  </div>
</nav>

<style>
  .direction-product-nav{position:sticky;top:96px;z-index:35;border-bottom:1px solid rgba(17,19,36,.1);backdrop-filter:blur(18px) saturate(1.04)}
  .direction-product-nav--light{background:rgba(255,255,255,.95);color:#111324}
  .direction-product-nav--dark{background:rgba(7,16,56,.95);color:#fff;border-bottom-color:rgba(255,255,255,.12)}
  .direction-product-nav__inner{display:flex;align-items:center;gap:1rem;min-height:58px}
  .direction-product-nav__brand{position:relative;display:grid;gap:.08rem;flex:0 0 auto;color:inherit;text-decoration:none;padding:.35rem 1rem .35rem .8rem;border-right:1px solid color-mix(in srgb,currentColor 20%,transparent)}
  .direction-product-nav__brand::before{position:absolute;left:0;top:50%;width:4px;height:30px;border-radius:999px;background:var(--direction-nav-accent);content:"";transform:translateY(-50%)}
  .direction-product-nav__brand span{font-weight:820;font-size:.8rem;letter-spacing:.02em}
  .direction-product-nav__brand small{font-size:.63rem;opacity:.58;white-space:nowrap}
  .direction-product-nav__links{display:flex;align-items:center;gap:.18rem;min-width:0;overflow-x:auto;scrollbar-width:none;padding:.45rem 0;overscroll-behavior-inline:contain}
  .direction-product-nav__links::-webkit-scrollbar{display:none}
  .direction-product-nav__links a{position:relative;display:inline-flex;align-items:center;gap:.35rem;min-height:34px;padding:.45rem .58rem .45rem .72rem;border:0;border-radius:8px;color:inherit;text-decoration:none;font-size:.72rem;font-weight:660;white-space:nowrap;opacity:.67;transition:opacity .18s ease,background .18s ease,color .18s ease}
  .direction-product-nav__links a::before{position:absolute;left:.28rem;top:50%;width:2px;height:13px;border-radius:999px;background:var(--direction-nav-accent);content:"";opacity:.46;transform:translateY(-50%);transition:height .18s ease,width .18s ease,opacity .18s ease}
  .direction-product-nav__links a:hover,.direction-product-nav__links a:focus-visible,.direction-product-nav__links a[aria-current="page"]{opacity:1;background:color-mix(in srgb,var(--direction-nav-accent) 7%,transparent)}
  .direction-product-nav__links a:hover::before,.direction-product-nav__links a:focus-visible::before,.direction-product-nav__links a[aria-current="page"]::before{width:3px;height:22px;opacity:1}
  .direction-product-nav--dark .direction-product-nav__links a:hover,.direction-product-nav--dark .direction-product-nav__links a:focus-visible,.direction-product-nav--dark .direction-product-nav__links a[aria-current="page"]{background:color-mix(in srgb,var(--direction-nav-accent) 16%,transparent)}
  @media(max-width:980px){.direction-product-nav{top:72px}.direction-product-nav__inner{display:grid;grid-template-columns:1fr;gap:0;padding:.35rem 0}.direction-product-nav__brand{display:none}.direction-product-nav__links{width:100%;padding:.35rem 0}.direction-product-nav__links a{min-height:36px}}
  @media(prefers-reduced-motion:reduce){.direction-product-nav__links a,.direction-product-nav__links a::before{transition:none}}
</style>