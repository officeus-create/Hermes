---
import { BookOpen, Bot, Check, ChevronRight, GraduationCap, ShieldCheck } from "@lucide/astro";
import { academyEnrollmentModels, academyPublicPathOverrides, academyPublicTracks } from "../data/academy-public";

const progression = [
  { level: "Student", focus: "Language and context", responsibility: "Understand the role, terminology, public boundaries, and how work moves through the selected U.S.-market workflow." },
  { level: "Trainee", focus: "Guided execution", responsibility: "Complete defined exercises for the selected learning track with examples, review, and correction." },
  { level: "Specialist", focus: "Reliable ownership", responsibility: "Perform a repeatable area of work, document decisions, and communicate status clearly." },
  { level: "Manager", focus: "Team coordination", responsibility: "Control priorities, quality, handoffs, and performance inside a defined professional workflow." },
  { level: "Director", focus: "Operating system", responsibility: "Connect process, KPI, resources, quality controls, and execution rhythm for the selected professional path." },
  { level: "Executive", focus: "Business decisions", responsibility: "Use systems thinking and reviewed evidence to guide the wider operating or growth direction." },
];

const method = [
  { title: "Explain", body: "Read or watch the approved source, define unfamiliar terms, then explain the decision in your own words without copying a script." },
  { title: "Practice", body: "Make a bounded attempt in a realistic scenario before live responsibility. The first attempt is evidence, not a pass/fail verdict." },
  { title: "Self-review", body: "Name what worked, where the reasoning broke, and what you would change before seeing the reviewer answer." },
  { title: "Human feedback", body: "An authorized reviewer gives one precise correction and names the next skill target instead of generic praise." },
  { title: "Retry", body: "Apply the correction in a second attempt and show the change clearly enough for a reviewer to inspect." },
  { title: "Transfer", body: "Repeat the skill in a changed scenario, ideally without notes, before progression is treated as reliable." },
];

const methodExample = {
  label: "SAMPLE PRACTICE · SANITIZED",
  attempt: "Attempt 1 · The learner starts explaining the offer before understanding the other person's situation.",
  selfReview: "Self-review · “I answered too early. I did not diagnose the actual need first.”",
  feedback: "Human feedback · Ask one useful diagnostic question before presenting or defending the solution.",
  retry: "Retry · “What is the main problem you are trying to solve today?”",
  transfer: "Transfer · Use the same principle in a different scenario without repeating the exact sentence.",
};

const academyFaq = academyPublicPathOverrides.faq ?? [];
import "../styles/features/academy.css";
---

<section class="academy-flow" data-academy-flow data-active-screen="0" aria-labelledby="academy-flow-title">
  <div class="shell academy-flow-shell">
    <div class="academy-flow-progress" aria-label="Academy pathway progress">
      {["Practice", "Tracks", "Track", "Growth", "Evidence"].map((label, index) => (
        <div class="academy-progress-step" data-academy-progress={index} data-active={index === 0 ? "true" : "false"}>
          <span>0{index + 1}</span><p>{label}</p>
        </div>
      ))}
    </div>

    <div class="academy-screen" data-academy-screen="0" data-active="true">
      <div class="academy-opening academy-opening-method">
        <div class="academy-opening-copy">
          <p class="eyebrow">Hermes Academy · Human Progress</p>
          <h2 id="academy-flow-title">Learn work by doing reviewed work.</h2>
          <p>Hermes Academy is built around a visible correction loop: understand the context, make an attempt, diagnose your own gap, get precise human feedback, retry, then prove the skill in a changed scenario.</p>
          <div class="academy-opening-actions">
            <button class="button button-primary" type="button" data-academy-next="1">Choose a track <ChevronRight size={18} aria-hidden="true" /></button>
            <a class="button button-ghost" href="/academy/how-training-works/">See how training works</a>
          </div>
        </div>

        <div
          class="academy-living-study"
          data-academy-living-scene
          data-motion-state="idle"
          aria-hidden="true"
        >
          <span class="academy-study-light"></span>
          <span class="academy-study-shadow academy-study-shadow-a"></span>
          <span class="academy-study-shadow academy-study-shadow-b"></span>
          <div class="academy-study-book">
            <div class="academy-study-page academy-study-page-left">
              <small>01 · SOURCE</small>
              <strong>Understand the context.</strong>
              <span></span><span></span><span></span>
            </div>
            <div class="academy-study-page academy-study-page-turn">
              <small>02 · ATTEMPT</small>
              <strong>Try the work.</strong>
              <span></span><span></span>
            </div>
            <div class="academy-study-page academy-study-page-right">
              <small>03 · CORRECTION</small>
              <strong>Review → retry → transfer.</strong>
              <span></span><span></span><span></span>
            </div>
            <i class="academy-study-spine"></i>
          </div>
          <p>Task → Attempt → Human correction → Retry → Transfer</p>
        </div>

        <article class="academy-attempt-proof" aria-labelledby="academy-attempt-proof-title">
          <div class="academy-attempt-proof-head">
            <span>{methodExample.label}</span>
            <strong id="academy-attempt-proof-title">One correction should change the next attempt.</strong>
          </div>
          <ol class="academy-attempt-proof-flow">
            <li data-proof-state="attempt"><small>01 · ATTEMPT</small><p>{methodExample.attempt}</p></li>
            <li data-proof-state="self-review"><small>02 · SELF-REVIEW</small><p>{methodExample.selfReview}</p></li>
            <li data-proof-state="feedback"><small>03 · HUMAN FEEDBACK</small><p>{methodExample.feedback}</p></li>
            <li data-proof-state="retry"><small>04 · RETRY</small><p>{methodExample.retry}</p></li>
            <li data-proof-state="transfer"><small>05 · TRANSFER</small><p>{methodExample.transfer}</p></li>
          </ol>
          <p class="academy-attempt-boundary">This is an illustrative practice example, not a real learner record, job result, certification, income promise, or permission for live work.</p>
        </article>

        <div class="academy-method-signals" aria-label="Academy learning method">
          <span>Explain in your own words</span>
          <span>Practice before consequence</span>
          <span>Self-review before correction</span>
          <span>Human progression gate</span>
        </div>
      </div>
    </div>

    <div class="academy-screen" data-academy-screen="1" data-active="false" hidden>
      <div class="academy-screen-heading">
        <p class="eyebrow">Five public learning tracks</p>
        <h2>Choose the work you want to understand and practice.</h2>
        <p>Each track uses its own terminology, exercises, review criteria, and public boundaries.</p>
      </div>
      <div class="academy-track-selector" role="tablist" aria-label="Academy learning tracks">
        {academyPublicTracks.map((track, index) => (
          <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} data-academy-track={track.id} data-active={index === 0 ? "true" : "false"}>
            <span>0{index + 1}</span>
            <div><strong>{track.label}</strong><p>{track.problem}</p></div>
            <ChevronRight size={19} aria-hidden="true" />
          </button>
        ))}
      </div>
      <div class="academy-screen-actions">
        <button class="academy-text-button" type="button" data-academy-back="0">Back</button>
        <button class="button button-primary" type="button" data-academy-next="2">Next: <span data-academy-selected-label>U.S. Logistics Operations</span><ChevronRight size={18} aria-hidden="true" /></button>
      </div>
    </div>

    <div class="academy-screen" data-academy-screen="2" data-active="false" hidden>
      <div class="academy-track-result">
        <div>
          <p class="eyebrow" data-academy-result-eyebrow>U.S. Logistics Operations</p>
          <h2 data-academy-result-title>{academyPublicTracks[0].title}</h2>
          <p data-academy-result-body>{academyPublicTracks[0].body}</p>
        </div>
        <div class="academy-practice-card">
          <BookOpen size={24} aria-hidden="true" />
          <p>Practice can include</p>
          <ul data-academy-practice-list>
            {academyPublicTracks[0].practice.map((item) => <li><Check size={16} aria-hidden="true" />{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="academy-screen-actions">
        <button class="academy-text-button" type="button" data-academy-back="1">Change track</button>
        <button class="button button-primary" type="button" data-academy-next="3">See the 6 layers <ChevronRight size={18} aria-hidden="true" /></button>
      </div>
    </div>

    <div class="academy-screen" data-academy-screen="3" data-active="false" hidden>
      <div class="academy-screen-heading">
        <p class="eyebrow">Growth framework</p>
        <h2>Progress from context to reviewed responsibility.</h2>
        <p>These layers describe capability development. They do not guarantee a job title, promotion, client, income, certification, or access to a company role.</p>
      </div>
      <div class="academy-progression-list">
        {progression.map((item, index) => (
          <article>
            <span>0{index + 1}</span>
            <div><p>{item.level}</p><h3>{item.focus}</h3><div>{item.responsibility}</div></div>
          </article>
        ))}
      </div>
      <div class="academy-screen-actions">
        <button class="academy-text-button" type="button" data-academy-back="2">Back to track</button>
        <button class="button button-primary" type="button" data-academy-next="4">Method & FAQ <ChevronRight size={18} aria-hidden="true" /></button>
      </div>
    </div>

    <div class="academy-screen" data-academy-screen="4" data-active="false" hidden>
      <div class="academy-method-heading">
        <div>
          <p class="eyebrow">How learning works</p>
          <h2>Explain. Practice. Review. Retry. Transfer.</h2>
        </div>
        <p>Every track uses the same evidence-first engine. Learners explain the context, attempt the work, review their own gap, receive a precise correction, retry, and then use the skill in a different situation. The exact cohort or supervised-practice scope is confirmed before participation.</p>
      </div>
      <div class="academy-method-grid">
        {method.map((item, index) => (
          <article><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>
        ))}
      </div>

      <div class="academy-ai-lab" aria-labelledby="academy-ai-lab-title">
        <div class="academy-ai-lab-copy">
          <p class="eyebrow">Optional marketing workflow lab · Concept preview</p>
          <h2 id="academy-ai-lab-title">Learn AI automation by building one useful assistant.</h2>
          <p>This is an optional exercise inside the Marketing learning track, not a separate learning track or enrollment offer. The example shows how a learner could define a simple intake and draft-response workflow with explicit review boundaries.</p>
          <ul>
            <li><Bot size={17} aria-hidden="true" />Map the user question and approved response scope</li>
            <li><ShieldCheck size={17} aria-hidden="true" />Keep every action in preview until a person confirms it</li>
            <li><GraduationCap size={17} aria-hidden="true" />Explain the workflow, fallback, and measurement plan</li>
          </ul>
        </div>
        <div class="academy-ai-mockup" role="img" aria-label="Concept preview of a fitness AI Telegram assistant learning project">
          <div class="academy-ai-topbar"><strong><i>H</i>Academy Lab</strong><span>Learning preview</span></div>
          <div class="academy-ai-body">
            <aside><span class="is-active">Brief</span><span>Knowledge</span><span>Workflow</span><span>Test</span><span>Review</span></aside>
            <div class="academy-ai-workspace">
              <header><small>PRACTICAL BUILD · CONCEPT ONLY</small><h3>Fitness AI Telegram Assistant</h3></header>
              <div class="academy-ai-brief">
                <p><span>01</span><b>Goal</b><em>Answer approved membership questions and prepare a consultation request.</em></p>
                <p><span>02</span><b>Knowledge</b><em>Services, schedule rules, location, policies, and handoff contacts.</em></p>
                <p><span>03</span><b>Guardrail</b><em>No booking, payment, medical advice, or message is sent automatically.</em></p>
              </div>
              <div class="academy-ai-preview"><Bot size={18} aria-hidden="true" /><div><small>DRAFT RESPONSE</small><p>“I can explain the approved membership options and prepare a consultation request for team review.”</p></div><button type="button">Review draft</button></div>
            </div>
          </div>
          <p>No live bot, member data, messages, enrollment, or payment is connected.</p>
        </div>
      </div>

      <div class="academy-practice-card academy-preapply-check" aria-labelledby="academy-preapply-title">
        <BookOpen size={24} aria-hidden="true" />
        <div>
          <p class="eyebrow">Before you apply</p>
          <h3 id="academy-preapply-title">Try one public exercise first.</h3>
          <p>Open the Academy resource hub, choose one practical guide or checklist, and write down one observation plus one question you would want reviewed. No account, enrollment, payment, or private data is required.</p>
          <a class="button button-ghost" href="/academy/resources/">Try a public exercise <ChevronRight size={18} aria-hidden="true" /></a>
        </div>
      </div>

      <div class="academy-enrollment-grid" aria-label="Academy participation models">
        {academyEnrollmentModels.map((model) => (
          <article>
            <p>{model.label}</p>
            <h3>{model.status === "owner_approval_required" ? "Published offer required" : "Application and eligibility required"}</h3>
            <div>{model.description}</div>
            <small>{model.boundary}</small>
          </article>
        ))}
      </div>

      <div class="academy-faq-grid">
        {academyFaq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
      </div>
      <div class="academy-screen-actions">
        <button class="academy-text-button" type="button" data-academy-back="3">Back to growth</button>
        <a class="button button-primary" href="/academy/apply/">Apply for human review <ChevronRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
    <section class="academy-public-entries" aria-labelledby="academy-public-entries-title">
      <p class="eyebrow">Explore a learning direction</p>
      <h2 id="academy-public-entries-title">IT, sales and operations start with practical work.</h2>
      <p>These are learning directions, not an open paid cohort or a guarantee of employment. Participation is confirmed through human review.</p>
      <div class="academy-public-entry-grid">
        {academyPublicTracks.filter((track) => ["it", "sales", "operations"].includes(track.id)).map((track) => (
          <article id={`academy-${track.id}`}>
            <h3>{track.label}</h3>
            <p>{track.body}</p>
            <button type="button" class="button button-primary" data-academy-entry-track={track.id}>Explore this track <ChevronRight size={18} aria-hidden="true" /></button>
            <a href={`mailto:officeus@hermeslogisticsus.com?subject=${encodeURIComponent(`Hermes Academy ${track.label} inquiry`)}`}>Ask about this learning direction <ChevronRight size={18} aria-hidden="true" /></a>
          </article>
        ))}
      </div>
    </section>
  </div>
</section>

<style>
  .academy-public-entries { margin-top: 2rem; }
  .academy-public-entry-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .academy-public-entry-grid article { padding: 1.25rem; border: 1px solid #dce4ed; border-radius: 16px; background: #fff; scroll-margin-top: 11rem; }
  .academy-public-entry-grid a { display: flex; align-items: center; gap: .5rem; min-height: 44px; margin-top: .75rem; }
  @media (max-width: 760px) { .academy-public-entry-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const academyLivingScenes = document.querySelectorAll<HTMLElement>("[data-academy-living-scene]");

  academyLivingScenes.forEach((scene) => {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let visible = false;

    const sync = () => {
      if (reducedMotion.matches) {
        scene.dataset.motionState = "reduced";
        return;
      }
      scene.dataset.motionState = visible && !document.hidden ? "running" : "paused";
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
        sync();
      },
      { threshold: 0.22 },
    );

    observer.observe(scene);
    reducedMotion.addEventListener("change", sync);
    document.addEventListener("visibilitychange", sync);
  });
</script>

<script is:inline define:vars={{ tracks: academyPublicTracks }}>
  document.querySelectorAll("[data-academy-flow]").forEach((flow) => {
    if (!(flow instanceof HTMLElement)) return;
    const screens = [...flow.querySelectorAll("[data-academy-screen]")];
    const progress = [...flow.querySelectorAll("[data-academy-progress]")];
    const trackButtons = [...flow.querySelectorAll("[data-academy-track]")];
    let selectedTrack = tracks[0];

    const showScreen = (screenNumber) => {
      screens.forEach((screen) => {
        const isActive = Number(screen.getAttribute("data-academy-screen")) === screenNumber;
        screen.toggleAttribute("hidden", !isActive);
        screen.setAttribute("data-active", isActive ? "true" : "false");
      });
      progress.forEach((step) => {
        const stepNumber = Number(step.getAttribute("data-academy-progress"));
        step.setAttribute("data-active", stepNumber <= screenNumber ? "true" : "false");
      });
      flow.dataset.activeScreen = String(screenNumber);
      flow.scrollIntoView({ behavior: "smooth", block: "start" });
      window.gtag?.("event", "academy_screen_view", { screen_number: screenNumber + 1, track: selectedTrack.id });
    };

    const renderTrack = () => {
      flow.querySelectorAll("[data-academy-selected-label]").forEach((node) => { node.textContent = selectedTrack.label; });
      const eyebrow = flow.querySelector("[data-academy-result-eyebrow]");
      const title = flow.querySelector("[data-academy-result-title]");
      const body = flow.querySelector("[data-academy-result-body]");
      const list = flow.querySelector("[data-academy-practice-list]");
      if (eyebrow) eyebrow.textContent = selectedTrack.label;
      if (title) title.textContent = selectedTrack.title;
      if (body) body.textContent = selectedTrack.body;
      if (list) {
        const items = selectedTrack.practice.map((item) => {
          const entry = document.createElement("li");
          const check = document.createElement("span");
          check.setAttribute("aria-hidden", "true");
          check.textContent = "✓";
          entry.append(check, document.createTextNode(item));
          return entry;
        });
        list.replaceChildren(...items);
      }
    };

    trackButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const trackId = button.getAttribute("data-academy-track");
        selectedTrack = tracks.find((track) => track.id === trackId) || tracks[0];
        trackButtons.forEach((item) => {
          const isActive = item === button;
          item.setAttribute("data-active", isActive ? "true" : "false");
          item.setAttribute("aria-selected", isActive ? "true" : "false");
        });
        renderTrack();
        window.gtag?.("event", "academy_track_select", { track: selectedTrack.id });
      });
    });

    flow.querySelectorAll("[data-academy-entry-track]").forEach((entry) => entry.addEventListener("click", () => {
      const trackId = entry.getAttribute("data-academy-entry-track");
      const tab = trackButtons.find((button) => button.getAttribute("data-academy-track") === trackId);
      tab?.click();
      renderTrack();
      showScreen(2);
      flow.querySelector('[data-academy-screen="2"] h2')?.setAttribute("tabindex", "-1");
      flow.querySelector('[data-academy-screen="2"] h2')?.focus({ preventScroll: true });
    }));

    flow.querySelectorAll("[data-academy-next]").forEach((button) => button.addEventListener("click", () => {
      renderTrack();
      showScreen(Number(button.getAttribute("data-academy-next")));
    }));
    flow.querySelectorAll("[data-academy-back]").forEach((button) => button.addEventListener("click", () => showScreen(Number(button.getAttribute("data-academy-back")))));
  });
</script>
