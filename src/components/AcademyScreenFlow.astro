---
import { BookOpen, Bot, Check, ChevronRight, GraduationCap, ShieldCheck } from "@lucide/astro";
import { academyEnrollmentModels, academyPublicTracks } from "../data/academy-public";

const progression = [
  { level: "Student", focus: "Language and context", responsibility: "Understand the role, terminology, public boundaries, and how work moves through the selected U.S.-market workflow." },
  { level: "Trainee", focus: "Guided execution", responsibility: "Complete defined logistics or marketing exercises with examples, review, and correction." },
  { level: "Specialist", focus: "Reliable ownership", responsibility: "Perform a repeatable area of work, document decisions, and communicate status clearly." },
  { level: "Manager", focus: "Team coordination", responsibility: "Control priorities, quality, handoffs, and performance inside a defined logistics or marketing workflow." },
  { level: "Director", focus: "Operating system", responsibility: "Connect process, KPI, resources, quality controls, and execution rhythm for the selected professional path." },
  { level: "Executive", focus: "Business decisions", responsibility: "Use systems thinking and reviewed evidence to guide the wider operating or growth direction." },
];

const method = [
  { title: "Awareness", body: "Understand the role, U.S. market context, terminology, responsibilities, public boundaries, and standard of professional work." },
  { title: "Understanding", body: "Work through systems, examples, decisions, reviews, and the connections between communication, execution, measurement, and quality." },
  { title: "Application", body: "Practice defined tasks, receive correction, and build evidence of readiness without assuming employment, income, clients, certification, or promotion." },
];

const academyFaq = [
  { question: "Which programs are publicly presented?", answer: "Two programs: U.S. Logistics Operations and Marketing. Leadership and technology topics may support exercises, but they are not separate public Academy programs on this page." },
  { question: "Are paid cohorts and free practice the same offer?", answer: "No. A paid cohort requires an approved public offer with scope, dates, price, payment, refund, capacity, and enrollment terms. Free practice is a separate application and eligibility process with its own participation rules." },
  { question: "Are current prices published?", answer: "No fixed price is published until a specific program and cohort are approved. The current website does not accept Academy enrollment or payment." },
  { question: "Is employment or income guaranteed?", answer: "No. Training and practice can build capability and evidence of readiness, but employment, income, clients, certification, promotion, access duration, and future paid work are not guaranteed." },
];
---

<section class="academy-flow" data-academy-flow data-active-screen="0" aria-labelledby="academy-flow-title">
  <div class="shell academy-flow-shell">
    <div class="academy-flow-progress" aria-label="Academy pathway progress">
      {["Start", "Programs", "Program", "Growth", "Method"].map((label, index) => (
        <div class="academy-progress-step" data-academy-progress={index} data-active={index === 0 ? "true" : "false"}>
          <span>0{index + 1}</span><p>{label}</p>
        </div>
      ))}
    </div>

    <div class="academy-screen" data-academy-screen="0" data-active="true">
      <div class="academy-opening">
        <p class="eyebrow">Hermes Academy · U.S.-market programs</p>
        <h2 id="academy-flow-title">Choose one practical professional path.</h2>
        <p>Start with U.S. Logistics Operations or Marketing. Paid cohorts and free practice opportunities are separate models, and neither implies employment or income.</p>
        <div class="academy-opening-actions">
          <button class="button button-primary" type="button" data-academy-next="1">Choose a track <ChevronRight size={18} aria-hidden="true" /></button>
          <a class="button button-ghost" href="#contact">Ask a question</a>
        </div>
        <div class="academy-trust-facts" aria-label="Academy facts">
          <div><strong>2</strong><span>public programs</span></div>
          <div><strong>3</strong><span>learning stages</span></div>
          <div><strong>6</strong><span>capability layers</span></div>
        </div>
      </div>
    </div>

    <div class="academy-screen" data-academy-screen="1" data-active="false" hidden>
      <div class="academy-screen-heading">
        <p class="eyebrow">Two public programs</p>
        <h2>Choose the work you want to understand and practice.</h2>
        <p>Each path uses its own terminology, exercises, review criteria, and public boundaries.</p>
      </div>
      <div class="academy-track-selector" role="tablist" aria-label="Academy programs">
        {academyPublicTracks.map((track, index) => (
          <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} data-academy-track={track.id} data-active={index === 0 ? "true" : "false"}>
            <span>0{index + 1}</span>
            <div><strong>{track.label}</strong><p>{track.problem}</p></div>
            <ChevronRight size={19} aria-hidden="true" />
          </button>
        ))}
      </div>
      <div class="academy-screen-actions">
        <button class="academy-text-button" type="button" data-academy-back="0">Back</button>
        <button class="button button-primary" type="button" data-academy-next="2">Next: <span data-academy-selected-label>U.S. Logistics Operations</span><ChevronRight size={18} aria-hidden="true" /></button>
      </div>
    </div>

    <div class="academy-screen" data-academy-screen="2" data-active="false" hidden>
      <div class="academy-track-result">
        <div>
          <p class="eyebrow" data-academy-result-eyebrow>U.S. Logistics Operations</p>
          <h2 data-academy-result-title>{academyPublicTracks[0].title}</h2>
          <p data-academy-result-body>{academyPublicTracks[0].body}</p>
        </div>
        <div class="academy-practice-card">
          <BookOpen size={24} aria-hidden="true" />
          <p>Practice can include</p>
          <ul data-academy-practice-list>
            {academyPublicTracks[0].practice.map((item) => <li><Check size={16} aria-hidden="true" />{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="academy-screen-actions">
        <button class="academy-text-button" type="button" data-academy-back="1">Change program</button>
        <button class="button button-primary" type="button" data-academy-next="3">See the 6 layers <ChevronRight size={18} aria-hidden="true" /></button>
      </div>
    </div>

    <div class="academy-screen" data-academy-screen="3" data-active="false" hidden>
      <div class="academy-screen-heading">
        <p class="eyebrow">Growth framework</p>
        <h2>Progress from context to reviewed responsibility.</h2>
        <p>These layers describe capability development. They do not guarantee a job title, promotion, client, income, certification, or access to a company role.</p>
      </div>
      <div class="academy-progression-list">
        {progression.map((item, index) => (
          <article>
            <span>0{index + 1}</span>
            <div><p>{item.level}</p><h3>{item.focus}</h3><div>{item.responsibility}</div></div>
          </article>
        ))}
      </div>
      <div class="academy-screen-actions">
        <button class="academy-text-button" type="button" data-academy-back="2">Back to program</button>
        <button class="button button-primary" type="button" data-academy-next="4">Method & FAQ <ChevronRight size={18} aria-hidden="true" /></button>
      </div>
    </div>

    <div class="academy-screen" data-academy-screen="4" data-active="false" hidden>
      <div class="academy-method-heading">
        <div>
          <p class="eyebrow">How learning works</p>
          <h2>Awareness. Understanding. Application.</h2>
        </div>
        <p>Each program moves from language and context into reviewed exercises. The exact cohort or practice scope is confirmed before participation.</p>
      </div>
      <div class="academy-method-grid">
        {method.map((item, index) => (
          <article><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>
        ))}
      </div>

      <div class="academy-ai-lab" aria-labelledby="academy-ai-lab-title">
        <div class="academy-ai-lab-copy">
          <p class="eyebrow">Optional marketing workflow lab · Concept preview</p>
          <h2 id="academy-ai-lab-title">Learn AI automation by building one useful assistant.</h2>
          <p>This is an optional exercise inside the Marketing program, not a third Academy program or separate enrollment offer. The example shows how a learner could define a simple intake and draft-response workflow with explicit review boundaries.</p>
          <ul>
            <li><Bot size={17} aria-hidden="true" />Map the user question and approved response scope</li>
            <li><ShieldCheck size={17} aria-hidden="true" />Keep every action in preview until a person confirms it</li>
            <li><GraduationCap size={17} aria-hidden="true" />Explain the workflow, fallback, and measurement plan</li>
          </ul>
        </div>
        <div class="academy-ai-mockup" role="img" aria-label="Concept preview of a fitness AI Telegram assistant learning project">
          <div class="academy-ai-topbar"><strong><i>H</i>Academy Lab</strong><span>Learning preview</span></div>
          <div class="academy-ai-body">
            <aside><span class="is-active">Brief</span><span>Knowledge</span><span>Workflow</span><span>Test</span><span>Review</span></aside>
            <div class="academy-ai-workspace">
              <header><small>PRACTICAL BUILD · CONCEPT ONLY</small><h3>Fitness AI Telegram Assistant</h3></header>
              <div class="academy-ai-brief">
                <p><span>01</span><b>Goal</b><em>Answer approved membership questions and prepare a consultation request.</em></p>
                <p><span>02</span><b>Knowledge</b><em>Services, schedule rules, location, policies, and handoff contacts.</em></p>
                <p><span>03</span><b>Guardrail</b><em>No booking, payment, medical advice, or message is sent automatically.</em></p>
              </div>
              <div class="academy-ai-preview"><Bot size={18} aria-hidden="true" /><div><small>DRAFT RESPONSE</small><p>“I can explain the approved membership options and prepare a consultation request for team review.”</p></div><button type="button">Review draft</button></div>
            </div>
          </div>
          <p>No live bot, member data, messages, enrollment, or payment is connected.</p>
        </div>
      </div>

      <div class="academy-enrollment-grid" aria-label="Academy participation models">
        {academyEnrollmentModels.map((model) => (
          <article>
            <p>{model.label}</p>
            <h3>{model.status === "owner_approval_required" ? "Published offer required" : "Application and eligibility required"}</h3>
            <div>{model.description}</div>
            <small>{model.boundary}</small>
          </article>
        ))}
      </div>

      <div class="academy-faq-grid">
        {academyFaq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
      </div>
      <div class="academy-screen-actions">
        <button class="academy-text-button" type="button" data-academy-back="3">Back to growth</button>
        <a class="button button-primary" href="#contact">Ask about the Academy <ChevronRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ tracks: academyPublicTracks }}>
  document.querySelectorAll("[data-academy-flow]").forEach((flow) => {
    if (!(flow instanceof HTMLElement)) return;
    const screens = [...flow.querySelectorAll("[data-academy-screen]")];
    const progress = [...flow.querySelectorAll("[data-academy-progress]")];
    const trackButtons = [...flow.querySelectorAll("[data-academy-track]")];
    let selectedTrack = tracks[0];

    const showScreen = (screenNumber) => {
      screens.forEach((screen) => {
        const isActive = Number(screen.getAttribute("data-academy-screen")) === screenNumber;
        screen.toggleAttribute("hidden", !isActive);
        screen.setAttribute("data-active", isActive ? "true" : "false");
      });
      progress.forEach((step) => {
        const stepNumber = Number(step.getAttribute("data-academy-progress"));
        step.setAttribute("data-active", stepNumber <= screenNumber ? "true" : "false");
      });
      flow.dataset.activeScreen = String(screenNumber);
      flow.scrollIntoView({ behavior: "smooth", block: "start" });
      window.gtag?.("event", "academy_screen_view", { screen_number: screenNumber + 1, track: selectedTrack.id });
    };

    const renderTrack = () => {
      flow.querySelectorAll("[data-academy-selected-label]").forEach((node) => { node.textContent = selectedTrack.label; });
      const eyebrow = flow.querySelector("[data-academy-result-eyebrow]");
      const title = flow.querySelector("[data-academy-result-title]");
      const body = flow.querySelector("[data-academy-result-body]");
      const list = flow.querySelector("[data-academy-practice-list]");
      if (eyebrow) eyebrow.textContent = selectedTrack.label;
      if (title) title.textContent = selectedTrack.title;
      if (body) body.textContent = selectedTrack.body;
      if (list) list.innerHTML = selectedTrack.practice.map((item) => `<li><span aria-hidden="true">✓</span>${item}</li>`).join("");
    };

    trackButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const trackId = button.getAttribute("data-academy-track");
        selectedTrack = tracks.find((track) => track.id === trackId) || tracks[0];
        trackButtons.forEach((item) => {
          const isActive = item === button;
          item.setAttribute("data-active", isActive ? "true" : "false");
          item.setAttribute("aria-selected", isActive ? "true" : "false");
        });
        renderTrack();
        window.gtag?.("event", "academy_track_select", { track: selectedTrack.id });
      });
    });

    flow.querySelectorAll("[data-academy-next]").forEach((button) => button.addEventListener("click", () => {
      renderTrack();
      showScreen(Number(button.getAttribute("data-academy-next")));
    }));
    flow.querySelectorAll("[data-academy-back]").forEach((button) => button.addEventListener("click", () => showScreen(Number(button.getAttribute("data-academy-back")))));
  });
</script>
