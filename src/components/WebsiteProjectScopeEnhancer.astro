<script>
  type WebsiteProjectConfig = {
    projectType: "new_website" | "redesign";
    serviceGroup: "website_development" | "website_redesign";
    projectPrefill: string;
  };

  const websiteProjects: Record<string, WebsiteProjectConfig> = {
    website_development: {
      projectType: "new_website",
      serviceGroup: "website_development",
      projectPrefill: "Custom Website Development with SEO Foundation",
    },
    website_redesign: {
      projectType: "redesign",
      serviceGroup: "website_redesign",
      projectPrefill: "Website Redesign with SEO and Conversion Protection",
    },
  };

  const pushWebsiteAnalyticsEvent = (payload: Record<string, string>) => {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(payload);
  };

  const trackWebsiteRedesignClick = (event: MouseEvent) => {
    if (!event.isTrusted) return;
    const source = event.target;
    if (!(source instanceof Element)) return;
    const link = source.closest<HTMLAnchorElement>("a[data-website-project-cta]");
    if (!link) return;

    let target: URL;
    try {
      target = new URL(link.href, window.location.origin);
    } catch {
      return;
    }
    if (
      target.origin !== window.location.origin ||
      target.pathname !== "/paths/technology/" ||
      target.searchParams.get("project") !== "website_redesign"
    ) return;

    pushWebsiteAnalyticsEvent({
      event: "commercial_cta_click",
      cta_type: "website_project_intake",
      audience_type: "business",
      page_group: "digital_service",
      service_group: "website_redesign",
      page_path: window.location.pathname,
      destination_path: target.pathname,
    });
  };

  document.addEventListener("click", trackWebsiteRedesignClick);

  const setupWebsiteProjectScope = () => {
    const requestedProject = new URLSearchParams(window.location.search).get("project") || "";
    const config = websiteProjects[requestedProject];
    if (window.location.pathname !== "/paths/technology/" || !config) return;

    const root = document.querySelector<HTMLElement>("[data-it-project-brief]");
    const form = root?.querySelector<HTMLFormElement>("[data-brief-form]");
    const firstPanel = root?.querySelector<HTMLElement>('[data-brief-step="0"]');
    const projects = firstPanel?.querySelector<HTMLElement>(".it-brief-projects");
    const projectOne = form?.querySelector<HTMLTextAreaElement>('textarea[name="project_1"]');
    const reviewPanel = root?.querySelector<HTMLElement>('[data-brief-step="4"]');
    const summary = root?.querySelector<HTMLElement>("[data-brief-summary]");
    const email = root?.querySelector<HTMLAnchorElement>("[data-brief-email]");
    if (!root || !form || !firstPanel || !projects || !projectOne || !reviewPanel || !summary || !email) return;

    projectOne.value = config.projectPrefill;
    projectOne.dispatchEvent(new Event("input", { bubbles: true }));

    const createLabel = (labelText: string, control: HTMLElement) => {
      const label = document.createElement("label");
      const text = document.createElement("span");
      text.textContent = labelText;
      label.append(text, control);
      return label;
    };

    const createSelect = (
      name: string,
      prompt: string,
      options: Array<{ value: string; label: string }>,
    ) => {
      const select = document.createElement("select");
      select.name = name;
      select.required = true;
      const promptOption = document.createElement("option");
      promptOption.value = "";
      promptOption.textContent = prompt;
      select.appendChild(promptOption);
      for (const item of options) {
        const option = document.createElement("option");
        option.value = item.value;
        option.textContent = item.label;
        select.appendChild(option);
      }
      return select;
    };

    const createInput = (name: string, placeholder = "") => {
      const input = document.createElement("input");
      input.name = name;
      input.maxLength = 240;
      input.placeholder = placeholder;
      return input;
    };

    const createTextarea = (name: string, placeholder = "") => {
      const textarea = document.createElement("textarea");
      textarea.name = name;
      textarea.rows = 3;
      textarea.maxLength = 800;
      textarea.placeholder = placeholder;
      return textarea;
    };

    const section = document.createElement("section");
    section.className = "website-scope-fields";
    section.dataset.websiteProjectScope = "true";
    section.setAttribute("aria-labelledby", "website-project-scope-title");

    const heading = document.createElement("div");
    heading.className = "website-scope-heading";
    const eyebrow = document.createElement("p");
    eyebrow.className = "eyebrow";
    eyebrow.textContent = "Website project scope";
    const title = document.createElement("h3");
    title.id = "website-project-scope-title";
    title.textContent = "Define the commercial website path before the broader technology brief.";
    const boundary = document.createElement("p");
    boundary.textContent = "These answers are added to the local project summary and explicit email handoff. They are not sent to GA4.";
    heading.append(eyebrow, title, boundary);

    const grid = document.createElement("div");
    grid.className = "website-scope-grid";
    const projectType = createSelect("website_project_type", "Choose a project type", [
      { value: "new_website", label: "New website" },
      { value: "redesign", label: "Website redesign" },
      { value: "website_and_seo", label: "Website + SEO" },
    ]);
    projectType.value = config.projectType;

    const currentWebsite = createInput("website_current_url", "https://example.com or leave blank for a new website");
    currentWebsite.type = "url";
    const targetMarket = createInput("website_target_market", "United States, state, metro area, or national market");
    targetMarket.required = true;
    const pageRange = createSelect("website_page_range", "Choose an approximate page range", [
      { value: "1-5", label: "1–5 pages" },
      { value: "6-10", label: "6–10 pages" },
      { value: "11-25", label: "11–25 pages" },
      { value: "26+", label: "26+ pages or programmatic sections" },
      { value: "not_sure", label: "Needs information architecture first" },
    ]);
    const integrations = createTextarea("website_integrations", "CRM, scheduling, payments, forms, portals, analytics, APIs, or other systems");
    const languages = createInput("website_languages", "English, Spanish, Ukrainian, or another language set");

    grid.append(
      createLabel("Project type *", projectType),
      createLabel("Current website", currentWebsite),
      createLabel("Target U.S. market *", targetMarket),
      createLabel("Required page range *", pageRange),
      createLabel("Integrations needed", integrations),
      createLabel("Languages", languages),
    );
    section.append(heading, grid);
    projects.before(section);

    const selectedLabel = (select: HTMLSelectElement) => select.selectedOptions[0]?.textContent?.trim() || "Not provided";
    const clean = (value: string, max = 1000) => value.replace(/[<>\u0000-\u001f\u007f]/g, "").trim().slice(0, max);

    const enhanceSummary = () => {
      const original = summary.textContent?.trim() || "";
      if (!original || reviewPanel.hidden) return;

      const marker = "Website project scope\n---------------------";
      const baseSummary = original.includes(marker)
        ? original.replace(/\n\nWebsite project scope\n---------------------[\s\S]*?(?=\n\nPrepared on hermeslogisticsus\.com\.)/, "")
        : original;
      const scopeBlock = [
        marker,
        `Project type: ${selectedLabel(projectType)}`,
        `Current website: ${clean(currentWebsite.value, 240) || "Not provided"}`,
        `Target U.S. market: ${clean(targetMarket.value, 240)}`,
        `Required page range: ${selectedLabel(pageRange)}`,
        `Integrations: ${clean(integrations.value, 800) || "Not provided"}`,
        `Languages: ${clean(languages.value, 240) || "Not provided"}`,
      ].join("\n");
      const boundaryText = "\n\nPrepared on hermeslogisticsus.com.";
      const enhanced = baseSummary.includes(boundaryText)
        ? baseSummary.replace(boundaryText, `\n\n${scopeBlock}${boundaryText}`)
        : `${baseSummary}\n\n${scopeBlock}`;
      summary.textContent = enhanced;

      try {
        const mailto = new URL(email.href);
        const recipient = mailto.pathname || "officeus@hermeslogisticsus.com";
        const subject = mailto.searchParams.get("subject") || "Hermes Website Project Brief";
        email.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(enhanced.slice(0, 6000))}`;
      } catch {
        email.href = `mailto:officeus@hermeslogisticsus.com?subject=${encodeURIComponent("Hermes Website Project Brief")}&body=${encodeURIComponent(enhanced.slice(0, 6000))}`;
      }
    };

    root.addEventListener("click", (event) => {
      const source = event.target;
      if (!(source instanceof Element) || !source.closest("[data-brief-next]")) return;
      window.requestAnimationFrame(enhanceSummary);
    });

    if (requestedProject === "website_redesign") {
      let intakeStarted = false;
      let previewRecorded = false;
      let handoffRecorded = false;
      const eventBase = {
        intake_type: "website_project",
        page_group: "technology_project_brief",
        service_group: config.serviceGroup,
        page_path: window.location.pathname,
      };
      const recordStart = (event: Event) => {
        if (!event.isTrusted || intakeStarted) return;
        intakeStarted = true;
        pushWebsiteAnalyticsEvent({ event: "website_project_intake_start", ...eventBase });
      };
      const resetPrepared = (event: Event) => {
        if (!event.isTrusted) return;
        previewRecorded = false;
        handoffRecorded = false;
        recordStart(event);
      };
      form.addEventListener("focusin", recordStart);
      form.addEventListener("input", resetPrepared);
      form.addEventListener("change", resetPrepared);
      root.addEventListener("click", (event) => {
        const source = event.target;
        if (!(source instanceof Element) || !source.closest("[data-brief-next]")) return;
        window.requestAnimationFrame(() => {
          if (previewRecorded || reviewPanel.hidden) return;
          previewRecorded = true;
          handoffRecorded = false;
          pushWebsiteAnalyticsEvent({
            event: "website_project_preview_ready",
            ...eventBase,
            preview_status: "prepared",
          });
        });
      });
      email.addEventListener("click", (event) => {
        if (!event.isTrusted || !previewRecorded || handoffRecorded || reviewPanel.hidden) return;
        if (!email.getAttribute("href")?.startsWith("mailto:")) return;
        handoffRecorded = true;
        pushWebsiteAnalyticsEvent({
          event: "website_handoff_ready",
          ...eventBase,
          handoff_method: "email",
          preview_status: "prepared",
        });
      });
    }
  };

  setupWebsiteProjectScope();
</script>

<style>
  .website-scope-fields {
    display: grid;
    gap: 1rem;
    margin: 1rem 0 1.35rem;
    padding: 1rem;
    border: 1px solid rgba(49, 95, 215, 0.18);
    border-radius: 18px;
    background: rgba(238, 243, 255, 0.62);
  }
  .website-scope-heading h3 { margin: .25rem 0 .4rem; color: #10204e; }
  .website-scope-heading p:last-child { margin: 0; color: #526181; line-height: 1.55; }
  .website-scope-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
  .website-scope-grid label { display: grid; gap: .42rem; }
  .website-scope-grid label > span { font-weight: 700; }
  @media (max-width: 720px) { .website-scope-grid { grid-template-columns: 1fr; } }
</style>
