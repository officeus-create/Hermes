---
import { ArrowRight, CheckCircle2, FileText, LayoutTemplate, MonitorSmartphone, SearchCheck, ShieldCheck } from "@lucide/astro";

const stages = [
  { key: "context", label: "Business context", title: "Start with what the company actually needs.", body: "Clarify audiences, services, evidence, languages, customer actions, privacy boundaries, integrations, and the business result the website should support.", icon: FileText, signals: ["Audiences", "Services", "Primary action"], proof: "Public website project brief", proofDetail: "/resources/website-project-brief-template/" },
  { key: "brief", label: "Brief + architecture", title: "Turn discovery into a controlled build plan.", body: "Map page ownership, navigation, conversion paths, internal links, content responsibilities, technical requirements, and the approved project scope before implementation.", icon: LayoutTemplate, signals: ["Page owners", "Navigation", "Internal links"], proof: "Canonical owner + route map", proofDetail: "/services/website-development/" },
  { key: "build", label: "Design + build", title: "Build the responsive product around the approved plan.", body: "Create the interface, reusable components, responsive behavior, crawlable content, contact paths, and only the integrations included in scope.", icon: MonitorSmartphone, signals: ["Components", "Semantic HTML", "Responsive"], proof: "Reusable Astro component system", proofDetail: "Semantic DOM · responsive states · owned assets" },
  { key: "qa", label: "QA + human review", title: "Check the system before it becomes a release.", body: "Run build, browser, mobile, keyboard, accessibility, privacy, content, form, link, and regression checks while a human reviews claims and release readiness.", icon: ShieldCheck, signals: ["Mobile", "Keyboard", "Regression"], proof: "Exact-head browser QA", proofDetail: "Desktop · 390px · keyboard · reduced motion" },
  { key: "search", label: "Search + release", title: "Protect discoverability while moving toward production.", body: "Validate metadata, canonical ownership, structured data where supported, internal links, sitemap/indexability rules, analytics boundaries, and controlled deployment evidence.", icon: SearchCheck, signals: ["Canonical", "Schema", "Sitemap"], proof: "Search release gate", proofDetail: "Canonical · schema · sitemap · internal discovery" },
  { key: "evidence", label: "Evidence + next step", title: "Use real readback to decide what changes next.", body: "After release, use production readback, Search Console, privacy-safe analytics, inquiries, user feedback, errors, and operating capacity to prioritize the next bounded improvement.", icon: CheckCircle2, signals: ["Production readback", "Search evidence", "Inquiries"], proof: "Release → readback → measured outcome", proofDetail: "Cloudflare · live route · GSC / inquiries when observed" },
];
---

<section class="website-showroom section" aria-labelledby="website-showroom-title">
  <div class="shell">
    <div class="website-showroom-heading">
      <div>
        <p class="eyebrow">Web Design + Development · Capability showroom</p>
        <h2 id="website-showroom-title">See how a website moves from business context to verified release.</h2>
      </div>
      <p>This is a visual explanation of the Hermes delivery method, not a live customer project. Every stage remains human-reviewed, and the detailed scope changes with the real business, evidence, access, privacy, and integration requirements.</p>
    </div>

    <div class="website-showroom-frame" data-website-showroom>
      <ol class="website-showroom-steps" aria-label="Website development workflow">
        {stages.map((stage, index) => {
          const Icon = stage.icon;
          return (
            <li>
              <button type="button" class="website-showroom-step" data-showroom-step={stage.key} aria-pressed={index === 0 ? "true" : "false"} aria-controls={"website-showroom-panel-" + stage.key}>
                <span class="website-showroom-step-number">0{index + 1}</span>
                <Icon size={19} aria-hidden="true" />
                <span><strong>{stage.label}</strong><small>{stage.title}</small></span>
              </button>
            </li>
          );
        })}
      </ol>

      <div class="website-showroom-stage" aria-label="Sample website delivery visualization">
        <div class="website-showroom-browser" aria-hidden="true">
          <div class="website-showroom-browser-bar"><i></i><i></i><i></i><span>HERMES / WEBSITE DELIVERY</span><strong>DEMO · SANITIZED</strong></div>
          <div class="website-showroom-canvas">
            <div class="website-showroom-route" aria-hidden="true">
              {stages.map((stage, index) => <span data-route-node={stage.key} class:list={{ active: index === 0 }}>{index + 1}</span>)}
            </div>
            {stages.map((stage, index) => (
              <article id={"website-showroom-panel-" + stage.key} class:list={["website-showroom-panel", { active: index === 0 }]} data-showroom-panel={stage.key}>
                <span class="website-showroom-panel-label">STEP 0{index + 1}</span>
                <h3>{stage.label}</h3>
                <p>{stage.title}</p>
                <div class="website-showroom-mini-ui" aria-label={"Demo signals for " + stage.label}>
                  {stage.signals.map((signal) => <span>{signal}</span>)}
                  <strong>{index < 3 ? "Build state" : index === 3 ? "Review gate" : index === 4 ? "Release gate" : "Evidence loop"}</strong>
                </div>
                <div class="website-showroom-proof-feed">
                  <span>PROOF TYPE</span>
                  <strong>{stage.proof}</strong>
                  <code>{stage.proofDetail}</code>
                </div>
              </article>
            ))}
            <div class="website-showroom-human"><ShieldCheck size={18} aria-hidden="true" /><span>Human review remains in control</span></div>
          </div>
        </div>

        <div class="website-showroom-tour-controls" aria-label="Website showroom controls">
          <button type="button" data-showroom-prev disabled>Previous</button>
          <span><b data-showroom-current>01</b> / 06 · self-guided proof</span>
          <button type="button" data-showroom-next>Next</button>
        </div>

        <div class="website-showroom-semantic" aria-live="polite">
          {stages.map((stage, index) => (
            <article class:list={["website-showroom-explanation", { active: index === 0 }]} data-showroom-explanation={stage.key}>
              <p class="eyebrow">0{index + 1} · {stage.label}</p>
              <h3>{stage.title}</h3>
              <p>{stage.body}</p>
              <p class="website-showroom-proof-copy"><strong>Proof type:</strong> {stage.proof} · <code>{stage.proofDetail}</code></p>
            </article>
          ))}
        </div>
      </div>
    </div>

    <div class="website-showroom-proof">
      <div>
        <p class="eyebrow">Verified Hermes proof</p>
        <h3>The current Hermes website is the public case study behind this workflow.</h3>
        <p>The case study separates verified release evidence from customer-performance claims and shows the actual strategy-to-production cycle used on Hermes.</p>
      </div>
      <div class="website-showroom-proof-actions">
        <a href="/paths/technology/?project=website_development#project-brief" class="button button-primary">Start the project brief <ArrowRight size={18} aria-hidden="true" /></a>
        <a href="/case/it-development/" class="button button-ghost">Review the website case <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-website-showroom]").forEach((showroom) => {
    const steps = Array.from(showroom.querySelectorAll("[data-showroom-step]"));
    const panels = Array.from(showroom.querySelectorAll("[data-showroom-panel]"));
    const explanations = Array.from(showroom.querySelectorAll("[data-showroom-explanation]"));
    const nodes = Array.from(showroom.querySelectorAll("[data-route-node]"));
    const previous = showroom.querySelector<HTMLButtonElement>("[data-showroom-prev]");
    const next = showroom.querySelector<HTMLButtonElement>("[data-showroom-next]");
    const current = showroom.querySelector<HTMLElement>("[data-showroom-current]");
    let activeIndex = 0;

    const activate = (key: string) => {
      const targetIndex = steps.findIndex((step) => step.getAttribute("data-showroom-step") === key);
      steps.forEach((step) => step.setAttribute("aria-pressed", String(step.getAttribute("data-showroom-step") === key)));
      panels.forEach((panel) => panel.classList.toggle("active", panel.getAttribute("data-showroom-panel") === key));
      explanations.forEach((panel) => panel.classList.toggle("active", panel.getAttribute("data-showroom-explanation") === key));
      nodes.forEach((node) => {
        const nodeIndex = steps.findIndex((step) => step.getAttribute("data-showroom-step") === node.getAttribute("data-route-node"));
        node.classList.toggle("active", nodeIndex <= targetIndex);
      });
      activeIndex = targetIndex;
      if (current) current.textContent = String(targetIndex + 1).padStart(2, "0");
      if (previous) previous.disabled = targetIndex === 0;
      if (next) next.disabled = targetIndex === steps.length - 1;
    };
    steps.forEach((step) => {
      const key = step.getAttribute("data-showroom-step");
      if (!key) return;
      step.addEventListener("focus", () => activate(key));
      step.addEventListener("pointerenter", () => activate(key));
      step.addEventListener("click", () => activate(key));
    });
    previous?.addEventListener("click", () => {
      const target = Math.max(0, activeIndex - 1);
      const key = steps[target]?.getAttribute("data-showroom-step");
      if (key) activate(key);
    });
    next?.addEventListener("click", () => {
      const target = Math.min(steps.length - 1, activeIndex + 1);
      const key = steps[target]?.getAttribute("data-showroom-step");
      if (key) activate(key);
    });
  });
</script>

<style>
  .website-showroom { background: #f7f6f3; color:#0b0d12; }
  .website-showroom-heading { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: end; margin-bottom: 2rem; }
  .website-showroom-heading h2 { max-width: 720px; margin-bottom: 0; }
  .website-showroom-heading > p { max-width: 720px; margin: 0; color: #626977; line-height: 1.7; }
  .website-showroom-frame { display: grid; grid-template-columns: minmax(240px, .72fr) minmax(0, 1.55fr); gap: 1rem; padding: 1rem; border: 1px solid rgba(11,13,18,.10); border-radius: 30px; background: rgba(255,255,255,.9); box-shadow: 0 28px 80px rgba(11,13,18,.07); }
  .website-showroom-steps { display: grid; gap: .55rem; list-style: none; margin: 0; padding: 0; align-content: start; }
  .website-showroom-step { width: 100%; display: grid; grid-template-columns: 34px 22px 1fr; gap: .7rem; align-items: center; padding: .9rem; border: 1px solid transparent; border-radius: 17px; background: transparent; color: #0b0d12; text-align: left; cursor: pointer; transition: background .35s ease, border-color .35s ease, transform .35s ease; }
  .website-showroom-step:hover, .website-showroom-step:focus-visible, .website-showroom-step[aria-pressed="true"] { border-color: rgba(26,115,232,.18); background: #eef3f7; transform: translateX(4px); outline: none; }
  .website-showroom-step-number { font-size: .72rem; letter-spacing: .12em; color: #155fbb; }
  .website-showroom-step svg { color: #155fbb; }
  .website-showroom-step strong, .website-showroom-step small { display: block; }
  .website-showroom-step strong { font-size: .92rem; }
  .website-showroom-step small { margin-top: .2rem; color: #59616f; font-size: .72rem; line-height: 1.35; }
  .website-showroom-stage { min-width: 0; }
  .website-showroom-browser { overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: 24px; background: #0b0d12; box-shadow: inset 0 0 0 1px rgba(255,255,255,.03), 0 24px 60px rgba(11,13,18,.18); }
  .website-showroom-browser-bar { display: flex; gap: .38rem; align-items: center; min-height: 46px; padding: 0 1rem; border-bottom: 1px solid rgba(255,255,255,.09); color: rgba(255,255,255,.62); font-size: .67rem; letter-spacing: .12em; }
  .website-showroom-browser-bar i { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.22); }
  .website-showroom-browser-bar span { margin-left: .45rem; }
  .website-showroom-browser-bar strong { margin-left:auto; padding:.34rem .55rem; border:1px solid rgba(255,255,255,.12); border-radius:999px; background:rgba(255,255,255,.07); color:rgba(255,255,255,.78); font-size:.58rem; letter-spacing:.12em; white-space:nowrap; }
  .website-showroom-canvas { position: relative; min-height: 360px; padding: clamp(1.2rem, 4vw, 2.5rem); background: radial-gradient(circle at 80% 18%, rgba(26,115,232,.24), transparent 29%), linear-gradient(145deg,#0b0d12,#172033 72%,#102a4f); color: white; }
  .website-showroom-route { display: grid; grid-template-columns: repeat(6, 1fr); gap: .45rem; position: relative; z-index: 2; }
  .website-showroom-route::before { content: ""; position: absolute; left: 3%; right: 3%; top: 50%; height: 2px; background: rgba(255,255,255,.13); transform: translateY(-50%); }
  .website-showroom-route span { position: relative; z-index: 1; display: grid; place-items: center; width: 30px; height: 30px; margin: auto; border: 1px solid rgba(255,255,255,.2); border-radius: 50%; background: #172033; color: rgba(255,255,255,.6); font-size: .72rem; transition: background .45s ease, color .45s ease, box-shadow .45s ease; }
  .website-showroom-route span.active { background: #fff; color: #0b0d12; box-shadow: 0 0 0 7px rgba(255,255,255,.08); }
  .website-showroom-panel { position: absolute; inset: 6.5rem clamp(1.2rem,4vw,2.5rem) 4.8rem; display: grid; align-content: center; opacity: 0; transform: translateY(16px) scale(.985); pointer-events: none; transition: opacity .55s ease, transform .55s ease; }
  .website-showroom-panel.active { opacity: 1; transform: translateY(0) scale(1); }
  .website-showroom-panel-label { font-size: .72rem; letter-spacing: .14em; color: #9cc5ff; }
  .website-showroom-panel h3 { margin: .5rem 0 .7rem; font-size: clamp(2rem, 5vw, 4.2rem); letter-spacing: -.045em; }
  .website-showroom-panel > p { max-width: 650px; margin: 0; color: rgba(255,255,255,.74); font-size: 1.02rem; }
  .website-showroom-mini-ui { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-top: 1.3rem; max-width: 680px; padding: .8rem; border: 1px solid rgba(255,255,255,.11); border-radius: 14px; background: rgba(255,255,255,.07); }
  .website-showroom-mini-ui span { display:inline-flex; align-items:center; min-height:30px; padding:.42rem .62rem; border:1px solid rgba(255,255,255,.10); border-radius:999px; background:rgba(255,255,255,.06); color:rgba(255,255,255,.76); font-size:.67rem; white-space:nowrap; }
  .website-showroom-mini-ui strong { margin-left:auto; padding: .42rem .65rem; border-radius: 999px; background: rgba(26,115,232,.18); color: #e3efff; font-size: .7rem; white-space: nowrap; }
  .website-showroom-proof-feed { display:grid; grid-template-columns:auto 1fr; gap:.28rem .65rem; align-items:center; margin-top:.75rem; max-width:680px; padding:.7rem .8rem; border:1px solid rgba(156,197,255,.18); border-radius:12px; background:rgba(5,10,18,.28); }
  .website-showroom-proof-feed > span { grid-row:1 / span 2; align-self:start; color:#9cc5ff; font:800 .55rem/1.35 var(--font-mono); letter-spacing:.08em; }
  .website-showroom-proof-feed strong { color:#fff; font-size:.78rem; line-height:1.3; }
  .website-showroom-proof-feed code { min-width:0; overflow:hidden; color:rgba(255,255,255,.58); font:600 .62rem/1.35 var(--font-mono); text-overflow:ellipsis; white-space:nowrap; }
  .website-showroom-tour-controls { display:grid; grid-template-columns:auto 1fr auto; gap:.7rem; align-items:center; margin:.75rem 0 0; padding:.65rem .75rem; border:1px solid rgba(11,13,18,.09); border-radius:14px; background:#f8fafc; }
  .website-showroom-tour-controls button { min-height:40px; padding:0 .8rem; border:1px solid rgba(11,13,18,.12); border-radius:10px; background:#fff; color:#0b0d12; font-weight:720; cursor:pointer; }
  .website-showroom-tour-controls button:disabled { cursor:default; opacity:.38; }
  .website-showroom-tour-controls button:focus-visible { outline:2px solid #155fbb; outline-offset:2px; }
  .website-showroom-tour-controls span { color:#626977; font:650 .68rem/1.3 var(--font-mono); text-align:center; }
  .website-showroom-tour-controls b { color:#155fbb; }
  .website-showroom-proof-copy { margin:.65rem 0 0; color:#626977; font-size:.78rem; line-height:1.5; }
  .website-showroom-proof-copy code { color:#155fbb; font-family:var(--font-mono); overflow-wrap:anywhere; }
  .website-showroom-human { position: absolute; left: clamp(1.2rem,4vw,2.5rem); bottom: 1.4rem; display: inline-flex; gap: .55rem; align-items: center; color: rgba(255,255,255,.7); font-size: .78rem; }
  .website-showroom-semantic { position: relative; min-height: 180px; padding: 1.25rem 1.1rem .35rem; }
  .website-showroom-explanation { display: none; }
  .website-showroom-explanation.active { display: block; }
  .website-showroom-explanation h3 { margin: .4rem 0 .6rem; font-size: clamp(1.35rem, 2.5vw, 2rem); }
  .website-showroom-explanation > p:last-child { max-width: 780px; color: #626977; line-height: 1.65; }
  .website-showroom-proof { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 2rem; align-items: center; margin-top: 1rem; padding: 1.35rem 1.5rem; border: 1px solid rgba(11,13,18,.10); border-radius: 22px; background: #fff; }
  .website-showroom-proof h3 { margin: .3rem 0 .45rem; }
  .website-showroom-proof p { margin: 0; color: #626977; line-height: 1.6; }
  .website-showroom-proof-actions { display:flex; flex-wrap:wrap; gap:.65rem; justify-content:flex-end; }
  .website-showroom-proof-actions .button { white-space:nowrap; }
  .website-showroom-proof-actions .button-primary { color:#fff; background:#0b0d12; border-color:#0b0d12; }
  .website-showroom-proof-actions .button-ghost { color:#0b0d12; border-color:rgba(11,13,18,.18); }
  @media (max-width: 900px) {
    .website-showroom-heading, .website-showroom-proof { grid-template-columns: 1fr; }
    .website-showroom-frame { grid-template-columns: 1fr; }
    .website-showroom-steps { grid-template-columns: repeat(3, minmax(0,1fr)); }
    .website-showroom-step { grid-template-columns: 28px 20px 1fr; padding: .72rem; }
    .website-showroom-step small { display: none; }
  }
  @media (max-width: 640px) {
    .website-showroom-frame { padding: .7rem; border-radius: 22px; }
    .website-showroom-steps { grid-template-columns: 1fr; gap: .45rem; }
    .website-showroom-step { min-height: 48px; grid-template-columns: 32px 22px 1fr; transform: none !important; }
    .website-showroom-step small { display: block; font-size: .68rem; }
    .website-showroom-browser-bar { overflow: hidden; padding-inline: .75rem; }
    .website-showroom-browser-bar i { flex: 0 0 auto; }
    .website-showroom-browser-bar span { flex: 1 1 auto; min-width: 0; overflow: hidden; font-size: .55rem; text-overflow: ellipsis; white-space: nowrap; }
    .website-showroom-browser-bar strong { flex: 0 0 auto; }
    .website-showroom-canvas { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto auto; gap: 1rem; min-height: 0; padding: 1rem; }
    .website-showroom-route { grid-row: 1; }
    .website-showroom-panel { position: static; grid-row: 2; grid-column: 1; display: none; min-width: 0; opacity: 1; transform: none; }
    .website-showroom-panel.active { display: grid; }
    .website-showroom-panel h3 { font-size: clamp(1.8rem, 10vw, 3rem); }
    .website-showroom-panel > p { font-size: .9rem; }
    .website-showroom-mini-ui strong { width:100%; margin-left:0; justify-content:center; }
    .website-showroom-mini-ui span { flex:1 1 auto; justify-content:center; }
    .website-showroom-proof-feed { grid-template-columns:1fr; }
    .website-showroom-proof-feed > span { grid-row:auto; }
    .website-showroom-proof-feed code { white-space:normal; overflow-wrap:anywhere; }
    .website-showroom-tour-controls { grid-template-columns:1fr 1fr; }
    .website-showroom-tour-controls span { grid-column:1 / -1; grid-row:1; }
    .website-showroom-proof-actions { justify-content:flex-start; }
    .website-showroom-route span { width: 26px; height: 26px; font-size: .65rem; }
    .website-showroom-human { position: static; grid-row: 3; min-width: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .website-showroom-step, .website-showroom-route span, .website-showroom-panel { transition: none !important; }
  }
</style>
