---
import { ArrowRight, CheckCircle2, FileText, LayoutTemplate, MonitorSmartphone, SearchCheck, ShieldCheck } from "@lucide/astro";

const designStages = [
  { key: "dna", label: "Business DNA / sources", detail: "Audience · offer · evidence", state: "SOURCE" },
  { key: "direction", label: "Visual direction", detail: "Composition · type · motion tone", state: "DIRECTION" },
  { key: "system", label: "Tokens + components", detail: "Color · spacing · UI grammar", state: "SYSTEM" },
  { key: "responsive", label: "Responsive behavior", detail: "1440 · 768 · 390", state: "RESPONSIVE" },
  { key: "quality", label: "Accessibility + visual QA", detail: "Keyboard · contrast · evidence", state: "VERIFY" },
  { key: "approved", label: "Approved design system", detail: "Reusable · documented · bounded", state: "APPROVED" },
];

const stages = [
  { key: "context", label: "Sources + business context", title: "Start with the real business signals, not an empty template.", body: "Collect approved public and owner-provided sources, audiences, services, evidence, languages, customer actions, competitors, privacy boundaries, integrations, and the business result the website should support.", icon: FileText, signals: ["Public sources", "Owned evidence", "Competitors"], proofKicker: "Business source intake", proofTitle: "Sources → Website Factory brief", proofCta: "Truth boundary", proofState: "SOURCE INTAKE" },
  { key: "brief", label: "Factory brief + architecture", title: "Turn source evidence into a controlled Website Factory build plan.", body: "Translate the approved evidence into page ownership, navigation, conversion paths, internal links, content responsibilities, technical requirements, design direction, and a scoped implementation contract.", icon: LayoutTemplate, signals: ["Page owners", "Design direction", "Internal links"], proofKicker: "Website Factory brief", proofTitle: "Evidence → IA → component plan", proofCta: "Approved scope", proofState: "FACTORY BRIEF" },
  { key: "build", label: "Semantic responsive build", title: "Build the approved design as a real responsive product.", body: "Create reusable components, semantic HTML, responsive layouts, crawlable content, contact paths, structured data hooks, and only the integrations included in scope.", icon: MonitorSmartphone, signals: ["Semantic HTML", "Components", "Responsive"], proofKicker: "Production-shaped build", proofTitle: "Design → semantic components", proofCta: "Responsive state", proofState: "BUILD" },
  { key: "qa", label: "QA + accessibility + security", title: "Prove the build before it becomes a release.", body: "Run build, browser, 1440/390, keyboard, accessibility, security, privacy, content, form, link, and regression checks while a human reviews claims and release readiness.", icon: ShieldCheck, signals: ["1440 + 390", "Accessibility", "Security"], proofKicker: "Quality gate", proofTitle: "Responsive · a11y · security", proofCta: "Human review", proofState: "VERIFY" },
  { key: "search", label: "SEO/GEO + deploy gate", title: "Protect discovery before deployment becomes production.", body: "Validate metadata, canonical ownership, schema, hreflang where applicable, internal links, sitemap/indexability, GEO/AEO surfaces, analytics boundaries, deployment evidence, and the exact release SHA.", icon: SearchCheck, signals: ["Canonical", "Schema", "SEO/GEO"], proofKicker: "Discoverability contract", proofTitle: "SEO/GEO · schema · deploy SHA", proofCta: "Release evidence", proofState: "DEPLOY GATE" },
  { key: "evidence", label: "Readback + distribution + CRM", title: "Turn a verified release into measurable business evidence.", body: "Read back production, distribute approved evidence through website/social channels, preserve attribution, and connect privacy-safe analytics, Search Console, inquiries, CRM qualification, user feedback, and errors to the next bounded improvement.", icon: CheckCircle2, signals: ["Production readback", "Distribution", "CRM evidence"], proofKicker: "Evidence loop", proofTitle: "Deploy → live → distribute → qualify", proofCta: "Next bounded change", proofState: "EVIDENCE LOOP" },
];
---

<section class="website-showroom section" aria-labelledby="website-showroom-title">
  <div class="shell">
    <div class="website-showroom-heading">
      <div>
        <p class="eyebrow">Web Design + Development · Capability showroom</p>
        <h2 id="website-showroom-title">See how a website moves from business context to verified release.</h2>
      </div>
      <p>This is a visual explanation of the Hermes delivery method, not a live customer project. Every stage remains human-reviewed, and the detailed scope changes with the real business, evidence, access, privacy, and integration requirements.</p>
    </div>

    <section class="website-design-lab" aria-labelledby="website-design-lab-title" data-website-design-lab>
      <div class="website-design-lab-heading">
        <div>
          <p class="eyebrow">Web Design · System proof</p>
          <h3 id="website-design-lab-title">Business DNA becomes a reusable design system before development begins.</h3>
        </div>
        <p>Design direction is not a moodboard handoff. It turns approved business evidence into reusable visual rules that survive desktop, tablet, mobile, accessibility review, and later production work.</p>
      </div>
      <div class="website-design-lab-flow" aria-label="Web design capability workflow">
        {designStages.map((stage, index) => (
          <article data-design-stage={stage.key}>
            <span class="website-design-lab-index">0{index + 1}</span>
            <small>{stage.state}</small>
            <strong>{stage.label}</strong>
            <em>{stage.detail}</em>
            <div class="website-design-lab-proof" aria-hidden="true">
              <i></i><i></i><i></i>
            </div>
          </article>
        ))}
      </div>
      <p class="website-design-lab-boundary"><ShieldCheck size={17} aria-hidden="true" /> DEMO · SANITIZED — no customer brand, private brief, unapproved asset, or invented performance claim is shown.</p>
    </section>

    <div class="website-showroom-frame" data-website-showroom>
      <ol class="website-showroom-steps" aria-label="Website development workflow">
        {stages.map((stage, index) => {
          const Icon = stage.icon;
          return (
            <li>
              <button type="button" class="website-showroom-step" data-showroom-step={stage.key} aria-pressed={index === 0 ? "true" : "false"} aria-controls={"website-showroom-explanation-" + stage.key}>
                <span class="website-showroom-step-number">0{index + 1}</span>
                <Icon size={19} aria-hidden="true" />
                <span><strong>{stage.label}</strong><small>{stage.title}</small></span>
              </button>
            </li>
          );
        })}
      </ol>

      <div class="website-showroom-stage" aria-label="Sample website delivery visualization">
        <div class="website-showroom-browser" aria-hidden="true">
          <div class="website-showroom-browser-bar"><i></i><i></i><i></i><span>HERMES / WEBSITE DELIVERY</span><strong>DEMO · SANITIZED</strong></div>
          <div class="website-showroom-canvas">
            <div class="website-showroom-factory-flow" aria-hidden="true" data-website-factory-flow>
              <span>SOURCES</span><i>→</i><span>BRIEF</span><i>→</i><span>BUILD</span><i>→</i><span>QA</span><i>→</i><span>SEARCH</span><i>→</i><span>DISTRIBUTE</span>
            </div>
            <div class="website-showroom-route" aria-hidden="true">
              {stages.map((stage, index) => <span data-route-node={stage.key} class:list={{ active: index === 0 }}>{index + 1}</span>)}
            </div>
            {stages.map((stage, index) => (
              <article id={"website-showroom-panel-" + stage.key} class:list={["website-showroom-panel", { active: index === 0 }]} data-showroom-panel={stage.key}>
                <span class="website-showroom-panel-label">STEP 0{index + 1}</span>
                <h3>{stage.label}</h3>
                <p>{stage.title}</p>
                <div class="website-showroom-mini-ui" aria-label={"Demo signals for " + stage.label}>
                  {stage.signals.map((signal) => <span>{signal}</span>)}
                  <strong>{index < 3 ? "Build state" : index === 3 ? "Review gate" : index === 4 ? "Release gate" : "Evidence loop"}</strong>
                </div>
                <div class="website-showroom-live-proof" data-showroom-live-proof={stage.key} data-proof-state={stage.key}>
                  <div class="website-showroom-proof-page">
                    <div class="website-showroom-proof-nav"><i></i><i></i><i></i><span></span></div>
                    <div class="website-showroom-proof-hero">
                      <small>{stage.proofKicker}</small>
                      <strong>{stage.proofTitle}</strong>
                      <span class="website-showroom-proof-copy"></span>
                      <span class="website-showroom-proof-copy short"></span>
                      <b>{stage.proofCta}</b>
                    </div>
                    <div class="website-showroom-proof-grid"><i></i><i></i><i></i></div>
                  </div>
                  <div class="website-showroom-proof-inspector">
                    <small>VISIBLE PROOF</small>
                    <strong>{stage.proofState}</strong>
                    <span>{stage.signals.join(" · ")}</span>
                  </div>
                </div>
              </article>
            ))}
            <div class="website-showroom-human"><ShieldCheck size={18} aria-hidden="true" /><span>Human review remains in control</span></div>
          </div>
        </div>

        <div class="website-showroom-semantic" aria-live="polite">
          {stages.map((stage, index) => (
            <article id={"website-showroom-explanation-" + stage.key} class:list={["website-showroom-explanation", { active: index === 0 }]} data-showroom-explanation={stage.key}>
              <p class="eyebrow">0{index + 1} · {stage.label}</p>
              <h3>{stage.title}</h3>
              <p>{stage.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>

    <div class="website-showroom-proof">
      <div>
        <p class="eyebrow">Verified Hermes proof</p>
        <h3>The current Hermes website is the public case study behind this workflow.</h3>
        <p>The case study separates verified release evidence from customer-performance claims and shows the actual strategy-to-production cycle used on Hermes.</p>
      </div>
      <a href="/case/it-development/" class="button button-ghost">Review the website case <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-website-showroom]").forEach((showroom) => {
    const steps = Array.from(showroom.querySelectorAll("[data-showroom-step]"));
    const panels = Array.from(showroom.querySelectorAll("[data-showroom-panel]"));
    const explanations = Array.from(showroom.querySelectorAll("[data-showroom-explanation]"));
    const nodes = Array.from(showroom.querySelectorAll("[data-route-node]"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const commit = (key: string) => {
      const targetIndex = steps.findIndex((step) => step.getAttribute("data-showroom-step") === key);
      steps.forEach((step) => step.setAttribute("aria-pressed", String(step.getAttribute("data-showroom-step") === key)));
      panels.forEach((panel) => panel.classList.toggle("active", panel.getAttribute("data-showroom-panel") === key));
      explanations.forEach((panel) => panel.classList.toggle("active", panel.getAttribute("data-showroom-explanation") === key));
      showroom.setAttribute("data-active-showroom-stage", key);
      nodes.forEach((node) => {
        const nodeIndex = steps.findIndex((step) => step.getAttribute("data-showroom-step") === node.getAttribute("data-route-node"));
        node.classList.toggle("active", nodeIndex <= targetIndex);
      });
    };
    const activate = (key: string) => {
      if (showroom.querySelector('[data-showroom-step][aria-pressed="true"]')?.getAttribute("data-showroom-step") === key) return;
      const nativeTransition = (document as Document & {
        startViewTransition?: (update: () => void) => { finished?: Promise<unknown> };
      }).startViewTransition;
      if (!nativeTransition || reducedMotion.matches) {
        commit(key);
        return;
      }
      showroom.setAttribute("data-native-transition", "running");
      const transition = nativeTransition.call(document, () => commit(key));
      transition?.finished?.finally(() => showroom.setAttribute("data-native-transition", "ready"));
    };
    steps.forEach((step) => {
      const key = step.getAttribute("data-showroom-step");
      if (!key) return;
      step.addEventListener("focus", () => activate(key));
      step.addEventListener("pointerenter", () => activate(key));
      step.addEventListener("click", () => activate(key));
    });
  });
</script>

<style>
  .website-showroom { background: #f7f6f3; color:#0b0d12; }
  .website-showroom-heading { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: end; margin-bottom: 2rem; }
  .website-showroom-heading h2 { max-width: 720px; margin-bottom: 0; }
  .website-showroom-heading > p { max-width: 720px; margin: 0; color: #626977; line-height: 1.7; }
  .website-design-lab { margin:0 0 1rem; padding:1rem; border:1px solid rgba(11,13,18,.10); border-radius:26px; background:rgba(255,255,255,.82); box-shadow:0 18px 55px rgba(11,13,18,.045); }
  .website-design-lab-heading { display:grid; grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr); gap:clamp(1.4rem,4vw,4rem); align-items:end; padding:.35rem .35rem 1rem; }
  .website-design-lab-heading h3 { max-width:680px; margin:.3rem 0 0; font-size:clamp(1.45rem,3vw,2.4rem); letter-spacing:-.035em; }
  .website-design-lab-heading > p { max-width:700px; margin:0; color:#626977; line-height:1.65; }
  .website-design-lab-flow { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:.55rem; }
  .website-design-lab-flow article { position:relative; min-width:0; padding:.9rem .8rem .8rem; border:1px solid rgba(11,13,18,.08); border-radius:15px; background:#f8fafc; transition:transform .24s ease,border-color .24s ease,box-shadow .24s ease; }
  .website-design-lab-flow article::after { content:""; position:absolute; top:50%; right:-.41rem; width:.28rem; height:1px; background:rgba(21,95,187,.28); }
  .website-design-lab-flow article:last-child::after { display:none; }
  .website-design-lab-flow article:is(:hover,:focus-within) { transform:translateY(-2px); border-color:rgba(21,95,187,.2); box-shadow:0 10px 24px rgba(21,95,187,.08); }
  .website-design-lab-index { display:block; color:#155fbb; font:750 .58rem/1 var(--font-mono); letter-spacing:.1em; }
  .website-design-lab-flow small { display:block; margin:.55rem 0 .35rem; color:#7a8390; font:750 .48rem/1.2 var(--font-mono); letter-spacing:.08em; }
  .website-design-lab-flow strong { display:block; min-height:2.5em; color:#141923; font-size:.72rem; line-height:1.25; }
  .website-design-lab-flow em { display:block; margin-top:.38rem; color:#68717e; font-size:.58rem; font-style:normal; line-height:1.35; }
  .website-design-lab-proof { display:grid; grid-template-columns:1fr .7fr .45fr; gap:4px; height:22px; margin-top:.7rem; }
  .website-design-lab-proof i { display:block; border-radius:5px; background:#e0e6ee; }
  [data-design-stage="direction"] .website-design-lab-proof i:first-child { background:#d9ecff; }
  [data-design-stage="system"] .website-design-lab-proof i:nth-child(2) { background:#c8d9ef; }
  [data-design-stage="responsive"] .website-design-lab-proof { grid-template-columns:1fr .62fr .34fr; }
  [data-design-stage="quality"] .website-design-lab-proof i { outline:1px solid rgba(55,130,87,.2); background:#e7f4ec; }
  [data-design-stage="approved"] .website-design-lab-proof i { background:#dbe8ff; }
  .website-design-lab-boundary { display:flex; gap:.5rem; align-items:center; margin:.8rem .35rem 0; color:#6a7280; font-size:.66rem; line-height:1.45; }
  .website-design-lab-boundary svg { flex:none; color:#2f7754; }
  .website-showroom-frame { display: grid; grid-template-columns: minmax(240px, .72fr) minmax(0, 1.55fr); gap: 1rem; padding: 1rem; border: 1px solid rgba(11,13,18,.10); border-radius: 30px; background: rgba(255,255,255,.9); box-shadow: 0 28px 80px rgba(11,13,18,.07); }
  .website-showroom-steps { display: grid; gap: .55rem; list-style: none; margin: 0; padding: 0; align-content: start; }
  .website-showroom-step { width: 100%; display: grid; grid-template-columns: 34px 22px 1fr; gap: .7rem; align-items: center; padding: .9rem; border: 1px solid transparent; border-radius: 17px; background: transparent; color: #0b0d12; text-align: left; cursor: pointer; transition: background .35s ease, border-color .35s ease, transform .35s ease; }
  .website-showroom-step:hover, .website-showroom-step:focus-visible, .website-showroom-step[aria-pressed="true"] { border-color: rgba(26,115,232,.18); background: #eef3f7; transform: translateX(4px); outline: none; }
  .website-showroom-step-number { font-size: .72rem; letter-spacing: .12em; color: #155fbb; }
  .website-showroom-step svg { color: #155fbb; }
  .website-showroom-step strong, .website-showroom-step small { display: block; }
  .website-showroom-step strong { font-size: .92rem; }
  .website-showroom-step small { margin-top: .2rem; color: #59616f; font-size: .72rem; line-height: 1.35; }
  .website-showroom-stage { min-width: 0; }
  .website-showroom-browser { overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: 24px; background: #0b0d12; box-shadow: inset 0 0 0 1px rgba(255,255,255,.03), 0 24px 60px rgba(11,13,18,.18); }
  @supports (view-transition-name: website-development-stage) {
    :global(:root) { view-transition-name: none; }
    .website-showroom-browser { view-transition-name: website-development-stage; }
    :global(::view-transition-group(website-development-stage)) { animation-duration: 260ms; animation-timing-function: ease; }
  }
  .website-showroom-browser-bar { display: flex; gap: .38rem; align-items: center; min-height: 46px; padding: 0 1rem; border-bottom: 1px solid rgba(255,255,255,.09); color: rgba(255,255,255,.62); font-size: .67rem; letter-spacing: .12em; }
  .website-showroom-browser-bar i { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.22); }
  .website-showroom-browser-bar span { margin-left: .45rem; }
  .website-showroom-browser-bar strong { margin-left:auto; padding:.34rem .55rem; border:1px solid rgba(255,255,255,.12); border-radius:999px; background:rgba(255,255,255,.07); color:rgba(255,255,255,.78); font-size:.58rem; letter-spacing:.12em; white-space:nowrap; }
  .website-showroom-canvas { position: relative; min-height: 380px; padding: clamp(1.2rem, 4vw, 2.5rem); background: radial-gradient(circle at 80% 18%, rgba(26,115,232,.24), transparent 29%), linear-gradient(145deg,#0b0d12,#172033 72%,#102a4f); color: white; }
  .website-showroom-factory-flow { display:flex; align-items:center; gap:.42rem; position:relative; z-index:3; margin:0 0 .9rem; overflow:hidden; color:rgba(255,255,255,.55); font:750 .5rem/1 var(--font-mono); letter-spacing:.08em; white-space:nowrap; }
  .website-showroom-factory-flow span { padding:.36rem .48rem; border:1px solid rgba(156,197,255,.16); border-radius:999px; background:rgba(255,255,255,.055); }
  .website-showroom-factory-flow span:first-child,.website-showroom-factory-flow span:last-child { color:#dcebff; border-color:rgba(156,197,255,.28); }
  .website-showroom-factory-flow i { color:#6ea9f4; font-style:normal; opacity:.72; }
  .website-showroom-route { display: grid; grid-template-columns: repeat(6, 1fr); gap: .45rem; position: relative; z-index: 2; }
  .website-showroom-route::before { content: ""; position: absolute; left: 3%; right: 3%; top: 50%; height: 2px; background: rgba(255,255,255,.13); transform: translateY(-50%); }
  .website-showroom-route span { position: relative; z-index: 1; display: grid; place-items: center; width: 30px; height: 30px; margin: auto; border: 1px solid rgba(255,255,255,.2); border-radius: 50%; background: #172033; color: rgba(255,255,255,.6); font-size: .72rem; transition: background .45s ease, color .45s ease, box-shadow .45s ease; }
  .website-showroom-route span.active { background: #fff; color: #0b0d12; box-shadow: 0 0 0 7px rgba(255,255,255,.08); }
  .website-showroom-panel { position: absolute; inset: 8.2rem clamp(1.2rem,4vw,2.5rem) 4.8rem; display: grid; align-content: center; opacity: 0; transform: translateY(16px) scale(.985); pointer-events: none; transition: opacity .55s ease, transform .55s ease; }
  .website-showroom-panel.active { opacity: 1; transform: translateY(0) scale(1); }
  .website-showroom-panel-label { font-size: .72rem; letter-spacing: .14em; color: #9cc5ff; }
  .website-showroom-panel h3 { margin: .5rem 0 .7rem; font-size: clamp(2rem, 5vw, 4.2rem); letter-spacing: -.045em; }
  .website-showroom-panel > p { max-width: 650px; margin: 0; color: rgba(255,255,255,.74); font-size: 1.02rem; }
  .website-showroom-mini-ui { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-top: 1.3rem; max-width: 680px; padding: .8rem; border: 1px solid rgba(255,255,255,.11); border-radius: 14px; background: rgba(255,255,255,.07); }
  .website-showroom-mini-ui span { display:inline-flex; align-items:center; min-height:30px; padding:.42rem .62rem; border:1px solid rgba(255,255,255,.10); border-radius:999px; background:rgba(255,255,255,.06); color:rgba(255,255,255,.76); font-size:.67rem; white-space:nowrap; }
  .website-showroom-mini-ui strong { margin-left:auto; padding: .42rem .65rem; border-radius: 999px; background: rgba(26,115,232,.18); color: #e3efff; font-size: .7rem; white-space: nowrap; }
  .website-showroom-panel { container-type: inline-size; }
  .website-showroom-live-proof { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(150px,.55fr); gap:.7rem; margin-top:.85rem; max-width:720px; }
  .website-showroom-proof-page { overflow:hidden; min-height:124px; border:1px solid rgba(255,255,255,.14); border-radius:14px; background:#f8fafc; color:#0b0d12; box-shadow:0 12px 28px rgba(0,0,0,.12); }
  .website-showroom-proof-nav { display:flex; gap:5px; align-items:center; min-height:25px; padding:0 9px; border-bottom:1px solid rgba(11,13,18,.08); background:#fff; }
  .website-showroom-proof-nav i { width:5px; height:5px; border-radius:50%; background:#d4d9e1; }
  .website-showroom-proof-nav span { width:42%; height:5px; margin-left:auto; border-radius:999px; background:#e4e8ef; }
  .website-showroom-proof-hero { position:relative; display:grid; align-content:start; gap:5px; padding:11px 12px 9px; min-height:73px; }
  .website-showroom-proof-hero small { color:#155fbb; font:750 .49rem/1.2 var(--font-mono); letter-spacing:.06em; text-transform:uppercase; }
  .website-showroom-proof-hero strong { max-width:20ch; font-size:.78rem; line-height:1.08; }
  .website-showroom-proof-copy { width:62%; height:5px; border-radius:999px; background:#dde3eb; }
  .website-showroom-proof-copy.short { width:42%; }
  .website-showroom-proof-hero b { position:absolute; right:11px; bottom:10px; padding:5px 7px; border-radius:7px; background:#0b0d12; color:#fff; font-size:.48rem; line-height:1; }
  .website-showroom-proof-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:6px; padding:0 12px 11px; }
  .website-showroom-proof-grid i { height:25px; border:1px solid #e0e5ec; border-radius:7px; background:#fff; }
  .website-showroom-proof-inspector { display:grid; align-content:start; gap:5px; padding:11px; border:1px solid rgba(255,255,255,.12); border-radius:14px; background:rgba(255,255,255,.055); }
  .website-showroom-proof-inspector small { color:#9cc5ff; font:750 .5rem/1.2 var(--font-mono); letter-spacing:.08em; }
  .website-showroom-proof-inspector strong { color:#fff; font-size:.72rem; }
  .website-showroom-proof-inspector span { color:rgba(255,255,255,.58); font-size:.58rem; line-height:1.4; }
  [data-proof-state="context"] .website-showroom-proof-hero,
  [data-proof-state="build"] .website-showroom-proof-hero { box-shadow:inset 3px 0 0 #4d8fe8; }
  [data-proof-state="brief"] .website-showroom-proof-nav { box-shadow:inset 0 -2px 0 #4d8fe8; }
  [data-proof-state="qa"] .website-showroom-proof-grid i { border-color:#76b58f; box-shadow:inset 0 0 0 1px rgba(55,130,87,.12); }
