---
import type { CatalogBusinessConcept } from "../data/catalog-business-concepts";
import { buildCatalogRequestHref } from "../lib/catalog-request";

type Props = { business: CatalogBusinessConcept; profileUrl: string; };
const { business, profileUrl } = Astro.props;
const primaryChannels = business.channels.filter((x)=>x.direction==="primary");
const secondaryChannels = business.channels.filter((x)=>x.direction==="secondary");
const mapChannel = business.channels.find((x)=>x.direction==="maps");
const requestContext = {
  businessId: business.id,
  businessName: business.name,
  profileUrl,
  city: business.locality,
  country: business.countryCode,
  sourceRef: business.sourceRef,
};
const businessRequestHref = buildCatalogRequestHref("catalog-business-request", requestContext);
const claimHref = business.status === "unclaimed"
  ? buildCatalogRequestHref("claim", requestContext)
  : "";
const growthLinks = ["Website / redesign","Google Maps","SEO / GEO","Hermes CRM","SMM","Automation"]
  .map((label)=>({ label, href: buildCatalogRequestHref("catalog-growth", requestContext, label) }));
---
<section class="catalog-concept" data-business-id={business.id}>
  <div class="concept-disclosure"><strong>Hermes Catalog · Website Concept</strong><span>Verified/public business data + Hermes presentation concept</span></div>
  <section class="concept-hero">
    <div><p class="kicker">{business.primaryIntent} · {business.locality}</p><h1>{business.name}</h1><p>This is a Hermes presentation of how the business could be structured online. Owner-confirmed facts remain separate from proposed website and growth features.</p><div class="actions"><a class="primary" href={`tel:${business.phone.replace(/\s/g,"")}`}>{business.phone}</a>{mapChannel && <a href={mapChannel.url} target="_blank" rel="noreferrer noopener">Google Maps ↗</a>}<a href={businessRequestHref}>Request contact via Hermes</a>{claimHref && <a href={claimHref}>Claim / verify</a>}</div>{business.trust && <div class="proof"><span><b>{business.trust.rating.toFixed(1)}</b> {business.trust.source}</span><span><b>{business.trust.reviewCount}</b> reviews</span></div>}</div>
    <aside><small>HERMES CONCEPT</small><strong>Discover.<br/>Trust.<br/>Act.</strong><span>{business.status.toUpperCase()} · claim/customer status changes only after verification</span></aside>
  </section>
  <section class="concept-grid"><article><p class="kicker">PRIMARY INTENT</p><h2>{business.primaryIntent}</h2><div class="channel-list">{primaryChannels.map((channel)=><a href={channel.url} target="_blank" rel="noreferrer noopener">{channel.label} ↗</a>)}</div></article>{business.secondaryIntent && <article class="secondary"><p class="kicker">SECONDARY DIRECTION</p><h2>{business.secondaryIntent}</h2><div class="channel-list">{secondaryChannels.map((channel)=><a href={channel.url} target="_blank" rel="noreferrer noopener">{channel.label} ↗</a>)}</div></article>}</section>
  <section class="truth"><div><p class="kicker">BUSINESS TRUTH</p><h2>Structured once. Reused across Hermes.</h2></div><dl><div><dt>Address</dt><dd>{business.address}, {business.locality}, {business.region}, {business.postalCode}</dd></div><div><dt>Hours</dt><dd>{business.hours.join(" · ")}</dd></div><div><dt>Needs owner confirmation</dt><dd>{business.factsRequiringOwnerConfirmation.join(" · ")}</dd></div></dl></section>
  <section class="opportunity"><div><p class="kicker">HERMES OPPORTUNITY</p><h2>Turn the concept into an owned growth system.</h2><p>Website, Google Maps, SEO/GEO, Hermes Connect CRM, SMM and automation can be activated after owner verification.</p></div><div class="offer-grid">{growthLinks.map((item)=><a href={item.href}>{item.label}</a>)}</div></section>
  <section id="catalog-request" class="request"><div><p class="kicker">REAL CUSTOMER REQUEST</p><h2>Request a handoff to this business.</h2><p>Hermes receives the request with Catalog attribution. A request is not marked delivered to the business until a verified contact path is used.</p></div><a class="request-link" href={businessRequestHref}>Start request →</a></section>
</section>
<style>
.catalog-concept{display:grid;gap:16px}.concept-disclosure,.concept-hero,.concept-grid article,.truth,.opportunity,.request{border:1px solid #dde3df;border-radius:22px;background:#fff}.concept-disclosure{display:flex;gap:12px;justify-content:space-between;padding:14px 18px;background:#17211e;color:#fff}.concept-disclosure span{opacity:.62;font-size:12px}.concept-hero{display:grid;grid-template-columns:1.15fr .85fr;gap:36px;padding:44px}.concept-hero h1{font-size:clamp(48px,7vw,84px);line-height:.95;letter-spacing:-.055em;margin:8px 0 20px}.concept-hero p{color:#64706b;line-height:1.65}.concept-hero aside{min-height:330px;padding:32px;border-radius:28px;background:linear-gradient(155deg,#18231f,#2d5448);color:#fff;display:flex;flex-direction:column;justify-content:center}.concept-hero aside strong{font-size:46px;line-height:.96;margin:18px 0}.concept-hero aside span{opacity:.55}.kicker{font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:#477568}.actions,.channel-list,.proof,.offer-grid{display:flex;gap:9px;flex-wrap:wrap}.actions a,.channel-list a,.offer-grid a,.request-link{padding:11px 13px;border:1px solid #ccd5d1;border-radius:11px;text-decoration:none;color:#20302b;background:#fff;font-weight:800}.actions .primary,.request-link{background:#17211e;color:#fff}.proof{margin-top:18px}.proof span{padding:8px 10px;background:#f6f8f7;border-radius:999px}.concept-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.concept-grid article,.truth,.opportunity,.request{padding:28px}.concept-grid h2,.truth h2,.opportunity h2,.request h2{font-size:clamp(28px,4vw,42px);margin:8px 0 14px}.secondary{background:#f2eee4!important}.truth,.opportunity,.request{display:grid;grid-template-columns:.85fr 1.15fr;gap:28px}.truth dl{margin:0}.truth dl div{display:grid;grid-template-columns:150px 1fr;gap:12px;padding:9px 0;border-top:1px solid #edf0ee}.truth dd{margin:0}.request-link{display:inline-flex;align-items:center;justify-self:end;align-self:center;min-height:46px}@media(max-width:760px){.concept-disclosure{align-items:flex-start;flex-direction:column}.concept-hero,.concept-grid,.truth,.opportunity,.request{grid-template-columns:1fr}.concept-hero{padding:26px}.concept-hero aside{min-height:230px}.truth dl div{grid-template-columns:1fr}.request-link{justify-self:start}}
</style>