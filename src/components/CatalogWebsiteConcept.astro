---
import type { CatalogBusinessConcept } from "../data/catalog-business-concepts";
import { buildCatalogLeadContext, catalogClaimHref, catalogSemanticSignals } from "../lib/catalog-concept-factory.mjs";
type ConceptLocale = "uk" | "en";
type Props = { business: CatalogBusinessConcept; profileUrl: string; defaultLocale?: ConceptLocale; };
const { business, profileUrl, defaultLocale = "uk" } = Astro.props;
const claimHref = catalogClaimHref(business, profileUrl);
const leadContext = buildCatalogLeadContext({ business, profileUrl });
const semanticSignals = catalogSemanticSignals(business);
const copy = business.copy[defaultLocale];
const primaryChannels = business.channels.filter((x)=>x.direction==="primary");
const secondaryChannels = business.channels.filter((x)=>x.direction==="secondary");
const mapChannel = business.channels.find((x)=>x.direction==="maps");
const opportunityOffers = [
  { id:"website", labelUk:"Сайт / редизайн", labelEn:"Website / redesign", copyUk:"Hermes може спроєктувати або оновити сайт на основі перевірених фактів бізнесу, погодженої структури та цілей конверсії.", copyEn:"Hermes can design or update the website from verified business facts, an approved structure, and clear conversion goals." },
  { id:"maps", labelUk:"Google Maps", labelEn:"Google Maps", copyUk:"Hermes може перевірити локальні дані, структуру профілю та план покращення видимості без обіцянок позицій.", copyEn:"Hermes can review local business data, profile structure, and a visibility improvement plan without promising rankings." },
  { id:"seo", labelUk:"SEO / GEO", labelEn:"SEO / GEO", copyUk:"Hermes може підготувати SEO/GEO план із семантикою, локальним наміром, технічною перевіркою та вимірюваними точками контролю.", copyEn:"Hermes can prepare an SEO/GEO plan covering semantics, local intent, technical checks, and measurable checkpoints." },
  { id:"crm", labelUk:"Hermes CRM", labelEn:"Hermes CRM", copyUk:"Hermes може підключити підтверджений бізнес до Hermes Connect після перевірки власника та окремого погодження операційних даних.", copyEn:"Hermes can connect a verified business to Hermes Connect after owner verification and separate approval of operating data." },
  { id:"smm", labelUk:"SMM", labelEn:"SMM", copyUk:"Hermes може підготувати контент і SMM-план для погоджених каналів та цілей, не видаючи концепцію за вже активну послугу.", copyEn:"Hermes can prepare content and an SMM plan for approved channels and goals without presenting the concept as an active service." },
  { id:"automation", labelUk:"Автоматизація", labelEn:"Automation", copyUk:"Hermes може спроєктувати автоматизацію заявок, CRM та комунікацій лише після погодження джерел даних, доступів і правил обробки.", copyEn:"Hermes can design lead, CRM, and communication automation only after data sources, access, and handling rules are approved." },
] as const;
---
<section class="catalog-concept" data-business-id={business.id} data-business-name={business.name} data-default-locale={defaultLocale}>
  <div class="concept-disclosure"><strong>Hermes Catalog · Website Concept</strong><span data-uk={business.copy.uk.disclosure} data-en={business.copy.en.disclosure}>{copy.disclosure}</span><nav class="locale-switch" aria-label="Concept language"><a href="?lang=uk" lang="uk">UA</a><a href="?lang=en" lang="en">EN</a></nav></div>
  <section class="concept-hero">
    <div><p class="kicker" data-uk={business.copy.uk.heroKicker} data-en={business.copy.en.heroKicker}>{copy.heroKicker}</p><h1 data-uk={business.copy.uk.heroTitle} data-en={business.copy.en.heroTitle}>{copy.heroTitle}</h1><p data-uk={business.copy.uk.heroLead} data-en={business.copy.en.heroLead}>{copy.heroLead}</p><div class="actions"><a class="primary" href={`tel:${business.phone.replace(/\s/g,"")}`}>{business.phone}</a>{mapChannel && <a href={mapChannel.url} target="_blank" rel="noreferrer noopener">Google Maps ↗</a>}<a href="#catalog-request" data-uk={business.copy.uk.requestLabel} data-en={business.copy.en.requestLabel}>{copy.requestLabel}</a>{business.status==="unclaimed" && <a href={claimHref} data-uk={business.copy.uk.claimLabel} data-en={business.copy.en.claimLabel}>{copy.claimLabel}</a>}</div>{business.trust && <div class="proof"><span><b>{business.trust.rating.toFixed(1)}</b> {business.trust.source}</span><span><b>{business.trust.reviewCount}</b> reviews</span></div>}</div>
    <aside><small>HERMES CONCEPT</small><strong>Discover.<br/>Trust.<br/>Act.</strong><span>{business.status.toUpperCase()} · claim/customer status changes only after verification</span></aside>
  </section>
  <section class="concept-grid"><article><p class="kicker">PRIMARY INTENT</p><h2>{business.primaryIntent}</h2><div class="channel-list">{primaryChannels.map((channel)=><a href={channel.url} target="_blank" rel="noreferrer noopener">{channel.label} ↗</a>)}</div></article>{business.secondaryIntent && <article class="secondary"><p class="kicker">SECONDARY DIRECTION</p><h2>{business.secondaryIntent}</h2><div class="channel-list">{secondaryChannels.map((channel)=><a href={channel.url} target="_blank" rel="noreferrer noopener">{channel.label} ↗</a>)}</div></article>}</section>
  <section class="truth"><div><p class="kicker">BUSINESS TRUTH</p><h2 data-uk={business.copy.uk.truthTitle} data-en={business.copy.en.truthTitle}>{copy.truthTitle}</h2></div><div class="truth-groups"><article><strong data-fact-state="verified" data-uk={business.copy.uk.verifiedLabel} data-en={business.copy.en.verifiedLabel}>{copy.verifiedLabel}</strong><ul>{business.verifiedFacts.map((item)=><li>{item}</li>)}</ul></article><article><strong data-fact-state="proposed" data-uk={business.copy.uk.proposedLabel} data-en={business.copy.en.proposedLabel}>{copy.proposedLabel}</strong><ul>{business.proposedConcepts.map((item)=><li>{item}</li>)}</ul></article><article><strong data-fact-state="owner_confirmation" data-uk={business.copy.uk.ownerConfirmationLabel} data-en={business.copy.en.ownerConfirmationLabel}>{copy.ownerConfirmationLabel}</strong><ul>{business.factsRequiringOwnerConfirmation.map((item)=><li>{item}</li>)}</ul></article></div><dl><div><dt>Address</dt><dd>{business.address}, {business.locality}, {business.region}, {business.postalCode}</dd></div><div><dt>Hours</dt><dd>{business.hours.join(" · ")}</dd></div><div><dt>Lifecycle</dt><dd>{business.lifecycleState.replaceAll("_"," ")}</dd></div></dl></section>
  <section class="opportunity"><div><p class="kicker">HERMES OPPORTUNITY</p><h2 data-uk={business.copy.uk.opportunityTitle} data-en={business.copy.en.opportunityTitle}>{copy.opportunityTitle}</h2><p data-uk={business.copy.uk.opportunityBody} data-en={business.copy.en.opportunityBody}>{copy.opportunityBody}</p></div><div class="offer-grid">{opportunityOffers.map((offer)=><button type="button" data-catalog-offer data-offer-id={offer.id} data-offer-title-uk={offer.labelUk} data-offer-title-en={offer.labelEn} data-offer-copy-uk={offer.copyUk} data-offer-copy-en={offer.copyEn} data-uk={offer.labelUk} data-en={offer.labelEn}>{defaultLocale==="en"?offer.labelEn:offer.labelUk}</button>)}</div></section>
  <section id="catalog-request" class="request"><div><p class="kicker">REAL CUSTOMER REQUEST</p><h2 data-uk={business.copy.uk.requestTitle} data-en={business.copy.en.requestTitle}>{copy.requestTitle}</h2><p data-uk={business.copy.uk.requestBody} data-en={business.copy.en.requestBody}>{copy.requestBody}</p></div><form action="/businesses/request/" method="get"><input type="hidden" name="type" value="catalog-business-request"/>{Object.entries(leadContext).map(([name,value])=>value?<input type="hidden" name={name} value={String(value)}/>:null)}<input type="hidden" name="city" value={business.locality}/><input type="hidden" name="country" value={business.countryCode}/><button type="submit" data-uk={business.copy.uk.requestLabel} data-en={business.copy.en.requestLabel}>{copy.requestLabel} →</button></form></section><section class="seo-foundation"><p class="kicker" data-uk={business.copy.uk.seoTitle} data-en={business.copy.en.seoTitle}>{copy.seoTitle}</p><h2>Semantic core + local intent</h2><div class="signal-list">{semanticSignals.map((signal)=><span>{signal}</span>)}</div></section>
  <dialog class="catalog-opportunity-dialog" data-catalog-opportunity-dialog aria-labelledby="catalog-opportunity-title">
    <button class="dialog-close" type="button" data-catalog-opportunity-close aria-label="Close">×</button>
    <p class="kicker">HERMES OPPORTUNITY</p>
    <h2 id="catalog-opportunity-title" data-catalog-opportunity-title>Hermes service</h2>
    <p data-catalog-opportunity-copy></p>
    <a class="dialog-primary" data-catalog-opportunity-request href="/businesses/request/?type=catalog-growth" data-uk="Запросити цей огляд →" data-en="Request this review →">Request this review →</a>
    <p class="dialog-boundary" data-uk="Це пояснення можливості Hermes, а не підтвердження активної послуги або відносин із цим бізнесом." data-en="This explains a Hermes capability; it does not confirm an active service or customer relationship with this business.">This explains a Hermes capability; it does not confirm an active service or customer relationship with this business.</p>
  </dialog>
</section>
<style>
.catalog-concept{display:grid;gap:16px}.concept-disclosure,.concept-hero,.concept-grid article,.truth,.opportunity,.request{border:1px solid #dde3df;border-radius:22px;background:#fff}.concept-disclosure{display:flex;gap:12px;justify-content:space-between;padding:14px 18px;background:#17211e;color:#fff}.concept-disclosure span{opacity:.72;font-size:12px}.locale-switch{display:flex;gap:6px}.locale-switch a{padding:5px 8px;border:1px solid rgba(255,255,255,.3);border-radius:999px;color:#fff;text-decoration:none;font-size:11px;font-weight:900}.concept-hero{display:grid;grid-template-columns:1.15fr .85fr;gap:36px;padding:44px}.concept-hero h1{font-size:clamp(48px,7vw,84px);line-height:.95;letter-spacing:-.055em;margin:8px 0 20px}.concept-hero p{color:#64706b;line-height:1.65}.concept-hero aside{min-height:330px;padding:32px;border-radius:28px;background:linear-gradient(155deg,#18231f,#2d5448);color:#fff;display:flex;flex-direction:column;justify-content:center}.concept-hero aside strong{font-size:46px;line-height:.96;margin:18px 0}.concept-hero aside span{opacity:.55}.kicker{font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:#477568}.actions,.channel-list,.proof,.offer-grid,.signal-list{display:flex;gap:9px;flex-wrap:wrap}.actions a,.channel-list a,.offer-grid button,.request button{padding:11px 13px;border:1px solid #ccd5d1;border-radius:11px;text-decoration:none;color:#20302b;background:#fff;font:inherit;font-weight:800;cursor:pointer}.actions .primary,.request button{background:#17211e;color:#fff}.proof{margin-top:18px}.proof span,.signal-list span{padding:8px 10px;background:#f6f8f7;border-radius:999px}.concept-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.concept-grid article,.truth,.opportunity,.request,.seo-foundation{padding:28px}.concept-grid h2,.truth h2,.opportunity h2,.request h2,.seo-foundation h2{font-size:clamp(28px,4vw,42px);margin:8px 0 14px}.secondary{background:#f2eee4!important}.truth,.opportunity,.request,.seo-foundation{display:grid;grid-template-columns:.85fr 1.15fr;gap:28px}.truth-groups{display:grid;gap:8px}.truth-groups article{padding:12px;border:1px solid #edf0ee;border-radius:12px}.truth-groups strong{display:inline-flex;padding:5px 8px;border-radius:999px;background:#f2f5f3;font-size:10px;text-transform:uppercase;letter-spacing:.04em}.truth-groups strong[data-fact-state="verified"]{background:#eaf7ef;color:#236b42}.truth-groups strong[data-fact-state="proposed"]{background:#eef2fb;color:#315b9c}.truth-groups strong[data-fact-state="owner_confirmation"]{background:#fff4d7;color:#79590a}.truth-groups ul{margin:8px 0 0;padding-left:18px;color:#64706b;line-height:1.5}.truth dl{margin:0}.truth dl div{display:grid;grid-template-columns:150px 1fr;gap:12px;padding:9px 0;border-top:1px solid #edf0ee}.truth dd{margin:0}.request form{display:flex;align-items:center;justify-content:flex-end}.request button{border:0;min-height:46px}.catalog-opportunity-dialog{width:min(520px,calc(100% - 2rem));box-sizing:border-box;border:1px solid #dce3df;border-radius:20px;padding:28px;background:#fff;color:#17211e;box-shadow:0 30px 80px #0004}.catalog-opportunity-dialog::backdrop{background:#17211e99}.catalog-opportunity-dialog h2{margin:8px 0 12px;font-size:clamp(28px,5vw,40px)}.catalog-opportunity-dialog>p:not(.kicker){color:#64706b;line-height:1.6}.dialog-close{float:right;border:0;background:transparent;color:#17211e;font-size:28px;line-height:1;cursor:pointer}.dialog-primary{display:inline-flex;align-items:center;min-height:44px;padding:0 15px;border-radius:11px;background:#17211e;color:#fff;text-decoration:none;font-weight:850}.dialog-boundary{margin:16px 0 0;padding-top:14px;border-top:1px solid #edf0ee;font-size:12px}@media(max-width:760px){.concept-disclosure{align-items:flex-start;flex-direction:column}.concept-hero,.concept-grid,.truth,.opportunity,.request,.seo-foundation{grid-template-columns:1fr}.concept-hero{padding:26px}.concept-hero aside{min-height:230px}.truth dl div{grid-template-columns:1fr}.request form{justify-content:flex-start}}
</style>
<script>
  const conceptRoot = document.querySelector("[data-business-id]");
  if (conceptRoot) {
    const requested = new URLSearchParams(window.location.search).get("lang");
    const fallback = conceptRoot.getAttribute("data-default-locale") === "en" ? "en" : "uk";
    const locale = requested === "en" || requested === "uk" ? requested : fallback;
    document.documentElement.lang = locale;
    conceptRoot.querySelectorAll("[data-uk][data-en]").forEach((node) => {
      const next = locale === "en" ? node.getAttribute("data-en") : node.getAttribute("data-uk");
      if (next) node.textContent = next;
    });

    const dialog = conceptRoot.querySelector("[data-catalog-opportunity-dialog]");
    const dialogTitle = dialog?.querySelector("[data-catalog-opportunity-title]");
    const dialogCopy = dialog?.querySelector("[data-catalog-opportunity-copy]");
    const dialogRequest = dialog?.querySelector("[data-catalog-opportunity-request]");
    conceptRoot.querySelectorAll("[data-catalog-offer]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!(dialog instanceof HTMLDialogElement)) return;
        const title = button.getAttribute("data-offer-title-" + locale) || "Hermes service";
        const offerCopy = button.getAttribute("data-offer-copy-" + locale) || "";
        if (dialogTitle) dialogTitle.textContent = title;
        if (dialogCopy) dialogCopy.textContent = offerCopy;
        if (dialogRequest instanceof HTMLAnchorElement) {
          const next = new URL("/businesses/request/", window.location.origin);
          next.searchParams.set("type", "catalog-growth");
          next.searchParams.set("business", conceptRoot.getAttribute("data-business-name") || "");
          next.searchParams.set("profile", window.location.href.split("#")[0]);
          next.searchParams.set("interest", title);
          dialogRequest.href = next.pathname + next.search;
        }
        dialog.showModal();
      });
    });
    dialog?.querySelector("[data-catalog-opportunity-close]")?.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
    });
  }
</script>
