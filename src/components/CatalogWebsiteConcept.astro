---
import type { CatalogBusinessConcept } from "../data/catalog-business-concepts";
import { buildCatalogLeadContext, catalogClaimHref, catalogSemanticSignals } from "../lib/catalog-concept-factory.mjs";
type Props = { business: CatalogBusinessConcept; profileUrl: string; };
const { business, profileUrl } = Astro.props;
const claimHref = catalogClaimHref(business, profileUrl);
const leadContext = buildCatalogLeadContext({ business, profileUrl });
const semanticSignals = catalogSemanticSignals(business);
const copy = business.copy.uk;
const primaryChannels = business.channels.filter((x)=>x.direction==="primary");
const secondaryChannels = business.channels.filter((x)=>x.direction==="secondary");
const mapChannel = business.channels.find((x)=>x.direction==="maps");
---
<section class="catalog-concept" data-business-id={business.id}>
  <div class="concept-disclosure"><strong>Hermes Catalog · Website Concept</strong><span data-uk={business.copy.uk.disclosure} data-en={business.copy.en.disclosure}>{copy.disclosure}</span><nav class="locale-switch" aria-label="Concept language"><a href="?lang=uk" lang="uk">UA</a><a href="?lang=en" lang="en">EN</a></nav></div>
  <section class="concept-hero">
    <div><p class="kicker" data-uk={business.copy.uk.heroKicker} data-en={business.copy.en.heroKicker}>{copy.heroKicker}</p><h1 data-uk={business.copy.uk.heroTitle} data-en={business.copy.en.heroTitle}>{copy.heroTitle}</h1><p data-uk={business.copy.uk.heroLead} data-en={business.copy.en.heroLead}>{copy.heroLead}</p><div class="actions"><a class="primary" href={`tel:${business.phone.replace(/\s/g,"")}`}>{business.phone}</a>{mapChannel && <a href={mapChannel.url} target="_blank" rel="noreferrer noopener">Google Maps ↗</a>}<a href="#catalog-request" data-uk={business.copy.uk.requestLabel} data-en={business.copy.en.requestLabel}>{copy.requestLabel}</a>{business.status==="unclaimed" && <a href={claimHref} data-uk={business.copy.uk.claimLabel} data-en={business.copy.en.claimLabel}>{copy.claimLabel}</a>}</div>{business.trust && <div class="proof"><span><b>{business.trust.rating.toFixed(1)}</b> {business.trust.source}</span><span><b>{business.trust.reviewCount}</b> reviews</span></div>}</div>
    <aside><small>HERMES CONCEPT</small><strong>Discover.<br/>Trust.<br/>Act.</strong><span>{business.status.toUpperCase()} → CLAIMED → CLIENT</span></aside>
  </section>
  <section class="concept-grid"><article><p class="kicker">PRIMARY INTENT</p><h2>{business.primaryIntent}</h2><div class="channel-list">{primaryChannels.map((channel)=><a href={channel.url} target="_blank" rel="noreferrer noopener">{channel.label} ↗</a>)}</div></article>{business.secondaryIntent && <article class="secondary"><p class="kicker">SECONDARY DIRECTION</p><h2>{business.secondaryIntent}</h2><div class="channel-list">{secondaryChannels.map((channel)=><a href={channel.url} target="_blank" rel="noreferrer noopener">{channel.label} ↗</a>)}</div></article>}</section>
  <section class="truth"><div><p class="kicker">BUSINESS TRUTH</p><h2>Structured once. Reused across Hermes.</h2></div><dl><div><dt>Address</dt><dd>{business.address}, {business.locality}, {business.region}, {business.postalCode}</dd></div><div><dt>Hours</dt><dd>{business.hours.join(" · ")}</dd></div><div><dt>Needs owner confirmation</dt><dd>{business.factsRequiringOwnerConfirmation.join(" · ")}</dd></div></dl></section>
  <section class="opportunity"><div><p class="kicker">HERMES OPPORTUNITY</p><h2>Turn the concept into an owned growth system.</h2><p>Website, Google Maps, SEO/GEO, Hermes Connect CRM, SMM and automation can be activated after owner verification.</p></div><div class="offer-grid">{["Website / redesign","Google Maps","SEO / GEO","Hermes CRM","SMM","Automation"].map((label)=><a href={`/businesses/request/?type=catalog-growth&business=${encodeURIComponent(business.name)}&profile=${encodeURIComponent(profileUrl)}&interest=${encodeURIComponent(label)}`}>{label}</a>)}</div></section>
  <section id="catalog-request" class="request"><div><p class="kicker">REAL CUSTOMER REQUEST</p><h2>Contact this business.</h2><p>Hermes preserves the Catalog source so the business can see where the request came from.</p></div><form action="/businesses/request/" method="get"><input type="hidden" name="type" value="catalog-business-request"/><input type="hidden" name="business" value={business.name}/><input type="hidden" name="profile" value={profileUrl}/><input type="hidden" name="city" value={business.locality}/><input type="hidden" name="country" value={business.countryCode}/><button type="submit">Start request →</button></form></section>
</section>
<style>
.catalog-concept{display:grid;gap:16px}.concept-disclosure,.concept-hero,.concept-grid article,.truth,.opportunity,.request{border:1px solid #dde3df;border-radius:22px;background:#fff}.concept-disclosure{display:flex;gap:12px;justify-content:space-between;padding:14px 18px;background:#17211e;color:#fff}.concept-disclosure span{opacity:.62;font-size:12px}.concept-hero{display:grid;grid-template-columns:1.15fr .85fr;gap:36px;padding:44px}.concept-hero h1{font-size:clamp(48px,7vw,84px);line-height:.95;letter-spacing:-.055em;margin:8px 0 20px}.concept-hero p{color:#64706b;line-height:1.65}.concept-hero aside{min-height:330px;padding:32px;border-radius:28px;background:linear-gradient(155deg,#18231f,#2d5448);color:#fff;display:flex;flex-direction:column;justify-content:center}.concept-hero aside strong{font-size:46px;line-height:.96;margin:18px 0}.concept-hero aside span{opacity:.55}.kicker{font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:#477568}.actions,.channel-list,.proof,.offer-grid{display:flex;gap:9px;flex-wrap:wrap}.actions a,.channel-list a,.offer-grid a,.request button{padding:11px 13px;border:1px solid #ccd5d1;border-radius:11px;text-decoration:none;color:#20302b;background:#fff;font-weight:800}.actions .primary,.request button{background:#17211e;color:#fff}.proof{margin-top:18px}.proof span{padding:8px 10px;background:#f6f8f7;border-radius:999px}.concept-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.concept-grid article,.truth,.opportunity,.request{padding:28px}.concept-grid h2,.truth h2,.opportunity h2,.request h2{font-size:clamp(28px,4vw,42px);margin:8px 0 14px}.secondary{background:#f2eee4!important}.truth,.opportunity,.request{display:grid;grid-template-columns:.85fr 1.15fr;gap:28px}.truth dl{margin:0}.truth dl div{display:grid;grid-template-columns:150px 1fr;gap:12px;padding:9px 0;border-top:1px solid #edf0ee}.truth dd{margin:0}.request form{display:flex;align-items:center;justify-content:flex-end}.request button{border:0;min-height:46px}@media(max-width:760px){.concept-disclosure{align-items:flex-start;flex-direction:column}.concept-hero,.concept-grid,.truth,.opportunity,.request{grid-template-columns:1fr}.concept-hero{padding:26px}.concept-hero aside{min-height:230px}.truth dl div{grid-template-columns:1fr}.request form{justify-content:flex-start}}
</style>