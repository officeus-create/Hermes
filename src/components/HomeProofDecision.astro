---
import type { SiteLocale } from "../data/locales";
import { directionOwnerRoutes } from "../data/localized-direction-owners";

type Direction = "logistics" | "marketing" | "technology" | "academy";
type ProofItem = { title: string; reason: string };
type ProofCopy = {
  eyebrow: string; title: string; lead: string; source: string; explore: string;
  contact: string; boundary: string; items: Record<Direction, ProofItem>;
};

interface Props { locale?: SiteLocale }
const { locale = "en" } = Astro.props;
const directionOrder: Direction[] = ["logistics", "marketing", "technology", "academy"];
const sources: Record<Direction, string> = {
  logistics: "/company-information/",
  marketing: "/case/appleton-vehicle-transport-seo/",
  technology: "/case/it-development/",
  academy: "/academy/resources/",
};
const copy: Record<SiteLocale, ProofCopy> = {
  en: {
    eyebrow: "Evidence before promises",
    title: "Before you choose, inspect what we can actually show.",
    lead: "A referral should make the next decision easier. Open the evidence, understand the service, then choose a clear contact route.",
    source: "Review source", explore: "Explore this direction", contact: "Describe your request",
    boundary: "These links show public company records, delivered work or learning resources—not guaranteed loads, rankings, customers, income or employment.",
    items: {
      logistics: { title: "Carrier-led U.S. operations", reason: "Transport, equipment fit, documentation and human review start with a verifiable Wisconsin company identity." },
      marketing: { title: "Search work you can inspect", reason: "The published Appleton SEO case separates a delivered resource cluster from search visibility and commercial outcomes." },
      technology: { title: "Software with clear maturity labels", reason: "Inspect the released corporate website case. Hermes Connect Repair Shops is a live pilot; other modules are not presented as released." },
