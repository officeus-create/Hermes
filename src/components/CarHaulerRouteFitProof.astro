---
import { CheckCircle2, Layers3, MapPin, Route, Search, ShieldCheck, Truck } from "@lucide/astro";

const stages = [
  {
    key: "origin",
    label: "Origin area",
    title: "Western / Upstate New York",
    detail: "Rochester · Buffalo · Le Roy · Akron · surrounding operating area",
    icon: MapPin,
  },
  {
    key: "fit",
    label: "Carrier fit",
    title: "Match the real truck first",
    detail: "Equipment · open spaces · deadhead · timing · destination",
    icon: Truck,
  },
  {
    key: "corridor",
    label: "Destination corridor",
    title: "Southeast operating context",
    detail: "Georgia · Atlanta / North Georgia · North Carolina · South Carolina",
    icon: Route,
  },
  {
    key: "sources",
    label: "Source set",
    title: "Research more than one source",
    detail: "Eligible load boards · brokers · dealers · auctions · direct demand research",
    icon: Layers3,
  },
  {
    key: "approval",
    label: "Carrier approval",
    title: "Candidate ≠ booked load",
    detail: "The motor carrier reviews and approves the operating commitment before booking",
    icon: ShieldCheck,
  },
];
---

<section class="route-fit-proof section" aria-labelledby="route-fit-proof-title" data-car-hauler-route-fit-proof>
  <div class="shell">
    <div class="route-fit-heading">
      <div>
        <p class="eyebrow">Spatial Operations · Route-fit research replay</p>
        <h2 id="route-fit-proof-title">See how a carrier search narrows before anyone talks about booking.</h2>
      </div>
      <p>
        This is a sanitized operating-research model built from the public carrier criteria on this page. It is not a
        live load board, truck location, rate feed, capacity feed, demand forecast, or promise that freight exists on a
        lane.
      </p>
    </div>

    <div class="route-fit-theatre" data-route-fit-motion>
      <div class="route-fit-status">
        <Search size={15} aria-hidden="true" />
        <span>RESEARCH REPLAY</span>
        <strong>NOT LIVE FREIGHT</strong>
      </div>

      <div class="route-fit-spatial" aria-hidden="true">
        <div class="route-fit-region route-fit-origin">
          <small>ORIGIN CONTEXT</small>
          <strong>Western / Upstate NY</strong>
          <span>Rochester · Buffalo · Le Roy · Akron</span>
          <i class="route-fit-radius"></i>
        </div>

        <div class="route-fit-line">
          <span class="route-fit-line-base"></span>
          <span class="route-fit-line-current"></span>
          <i class="route-fit-packet"></i>
        </div>

        <div class="route-fit-filter-stack">
          <span><Truck size={14} />Equipment</span>
          <span>Open spaces</span>
          <span>Deadhead</span>
          <span>Timing</span>
          <span>Destination</span>
        </div>

        <div class="route-fit-region route-fit-destination">
          <small>DESTINATION CONTEXT</small>
          <strong>Southeast</strong>
          <span>GA / North GA · NC · SC</span>
          <i class="route-fit-radius"></i>
        </div>
      </div>

      <div class="route-fit-source-row" aria-hidden="true">
        <span>Eligible marketplaces</span>
        <span>Broker research</span>
        <span>Dealer / auction</span>
        <span>Direct demand</span>
        <b><CheckCircle2 size={14} />Carrier review</b>
      </div>

      <p class="route-fit-visual-boundary">
        Third-party source examples describe research categories only. No partnership, automatic access, live inventory,
        rate, or booking result is implied.
      </p>
    </div>

    <ol class="route-fit-stages" aria-label="Car-hauler route-fit research sequence">
      {stages.map((stage, index) => {
        const Icon = stage.icon;
        return (
          <li data-route-fit-stage={stage.key}>
            <span class="route-fit-stage-index">0{index + 1}</span>
            <Icon size={20} aria-hidden="true" />
            <div>
              <small>{stage.label}</small>
              <strong>{stage.title}</strong>
              <p>{stage.detail}</p>
            </div>
          </li>
        );
      })}
    </ol>

    <div class="route-fit-boundary">
      <ShieldCheck size={19} aria-hidden="true" />
      <div>
        <strong>The carrier remains the operating decision-maker.</strong>
        <p>
          Hermes can research, communicate, organize candidate information, and discuss rates within approved
          instructions. The carrier decides whether a candidate fits the truck, driver, route, safety, compliance, and
          operating commitment.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .route-fit-proof{background:#f7f6f3;color:#172033}
  .route-fit-heading{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:clamp(2rem,6vw,6rem);align-items:end;margin-bottom:1.4rem}
  .route-fit-heading h2{max-width:760px;margin:.45rem 0 0}
  .route-fit-heading>p{max-width:720px;margin:0;color:#666c79;line-height:1.7}
  .route-fit-theatre{position:relative;overflow:hidden;min-height:390px;padding:3.9rem 1.15rem 1.15rem;border:1px solid rgba(23,32,51,.1);border-radius:28px;background:radial-gradient(circle at 13% 28%,rgba(30,136,255,.12),transparent 27%),radial-gradient(circle at 86% 30%,rgba(30,136,255,.08),transparent 25%),linear-gradient(145deg,#fff,#eef3f7 64%,#e4edf5);box-shadow:0 26px 70px rgba(23,32,51,.07)}
  .route-fit-status{position:absolute;top:1rem;left:1.15rem;right:1.15rem;display:flex;gap:.5rem;align-items:center;color:#52606f;font:750 .56rem/1 var(--font-mono);letter-spacing:.08em}
  .route-fit-status svg{color:#1e88ff}
  .route-fit-status strong{margin-left:auto;padding:.4rem .55rem;border:1px solid rgba(23,32,51,.12);border-radius:999px;background:#fff;color:#172033;font-size:.53rem;white-space:nowrap}
  .route-fit-spatial{position:relative;display:grid;grid-template-columns:minmax(190px,.8fr) minmax(250px,1.3fr) minmax(190px,.8fr);gap:1rem;align-items:center;min-height:235px}
  .route-fit-region{position:relative;z-index:2;display:grid;gap:.35rem;padding:1rem;border:1px solid rgba(30,136,255,.16);border-radius:18px;background:rgba(255,255,255,.82);box-shadow:0 12px 30px rgba(23,32,51,.055)}
  .route-fit-region small{color:#1e6fce;font:750 .5rem/1.2 var(--font-mono);letter-spacing:.08em}
  .route-fit-region strong{font-size:1rem}
  .route-fit-region span{color:#666c79;font-size:.67rem;line-height:1.45}
  .route-fit-radius{position:absolute;right:-18px;bottom:-18px;width:58px;height:58px;border:1px solid rgba(30,136,255,.18);border-radius:50%;box-shadow:0 0 0 10px rgba(30,136,255,.035),0 0 0 20px rgba(30,136,255,.018)}
  .route-fit-destination .route-fit-radius{right:auto;left:-18px}
  .route-fit-line{position:absolute;z-index:0;left:12%;right:12%;top:49%;height:2px;transform:translateY(-50%)}
  .route-fit-line-base,.route-fit-line-current{position:absolute;inset:0;border-radius:999px}
  .route-fit-line-base{background:rgba(23,32,51,.12)}
  .route-fit-line-current{background:linear-gradient(90deg,rgba(30,136,255,.18),rgba(30,136,255,.68),rgba(30,136,255,.18));opacity:.75}
  .route-fit-packet{position:absolute;top:50%;left:0;width:9px;height:9px;border-radius:50%;background:#1e88ff;box-shadow:0 0 0 7px rgba(30,136,255,.09);transform:translate(-50%,-50%);animation:route-fit-packet 5.8s ease-in-out infinite}
  .route-fit-filter-stack{position:relative;z-index:2;display:flex;flex-wrap:wrap;justify-content:center;gap:.42rem;padding:1rem}
  .route-fit-filter-stack span{display:inline-flex;gap:.3rem;align-items:center;padding:.47rem .58rem;border:1px solid rgba(23,32,51,.1);border-radius:999px;background:#fff;color:#485465;font-size:.61rem;font-weight:750}
  .route-fit-filter-stack svg{color:#1e88ff}
  .route-fit-source-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr)) minmax(120px,.7fr);gap:.48rem;margin-top:.45rem}
  .route-fit-source-row span,.route-fit-source-row b{display:flex;align-items:center;justify-content:center;min-height:48px;padding:.55rem;border:1px solid rgba(23,32,51,.09);border-radius:12px;background:#fff;color:#596576;font-size:.6rem;text-align:center}
  .route-fit-source-row b{gap:.36rem;border-color:rgba(47,119,84,.2);background:#eef8f2;color:#2f7754}
  .route-fit-visual-boundary{margin:.7rem .2rem 0;color:#6c7582;font-size:.6rem;line-height:1.5}
  .route-fit-stages{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.6rem;list-style:none;margin:1rem 0 0;padding:0}
  .route-fit-stages li{display:grid;grid-template-columns:28px 22px 1fr;gap:.55rem;align-items:start;padding:.82rem;border:1px solid rgba(23,32,51,.09);border-radius:15px;background:#fff}
  .route-fit-stage-index{color:#1e6fce;font:750 .55rem/1.2 var(--font-mono)}
  .route-fit-stages svg{color:#1e88ff}
  .route-fit-stages small{display:block;color:#7a8390;font:750 .48rem/1.2 var(--font-mono);letter-spacing:.06em}
  .route-fit-stages strong{display:block;margin-top:.24rem;font-size:.7rem;line-height:1.3}
  .route-fit-stages p{margin:.28rem 0 0;color:#666c79;font-size:.58rem;line-height:1.4}
  .route-fit-boundary{display:grid;grid-template-columns:auto 1fr;gap:.7rem;align-items:start;margin-top:1rem;padding:1rem 1.1rem;border:1px solid rgba(23,32,51,.09);border-radius:16px;background:#fff}
  .route-fit-boundary>svg{color:#2f7754}
  .route-fit-boundary strong{font-size:.78rem}
  .route-fit-boundary p{max-width:980px;margin:.28rem 0 0;color:#666c79;font-size:.68rem;line-height:1.55}
  @keyframes route-fit-packet{0%,10%{left:0}45%{left:48%}90%,100%{left:100%}}
  @media(max-width:900px){.route-fit-heading{grid-template-columns:1fr}.route-fit-stages{grid-template-columns:repeat(2,minmax(0,1fr))}.route-fit-stages li:last-child{grid-column:1/-1}}
  @media(max-width:700px){
    .route-fit-theatre{min-height:0;padding:3.7rem .75rem .8rem;border-radius:22px}
    .route-fit-spatial{grid-template-columns:1fr;gap:.65rem;min-height:0}
    .route-fit-line{display:none}
    .route-fit-filter-stack{padding:.2rem;justify-content:flex-start}
    .route-fit-radius{display:none}
    .route-fit-source-row{grid-template-columns:repeat(2,minmax(0,1fr))}
    .route-fit-source-row b{grid-column:1/-1}
    .route-fit-stages{grid-template-columns:1fr}
    .route-fit-stages li:last-child{grid-column:auto}
  }
  @media(prefers-reduced-motion:reduce){.route-fit-packet{animation:none!important;left:50%}}
</style>
