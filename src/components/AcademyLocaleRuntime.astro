      ["Reviewer access is not authorized.", "Доступ проверяющего не разрешён."],
      ["Your Hermes identity may be valid, but reviewer power requires a separate active `academy_reviewer_access` record provisioned by an authorized operator. Changing an account role label cannot unlock this queue.", "Ваша учётная запись Hermes может быть действующей, но полномочия проверяющего требуют отдельной активной записи `academy_reviewer_access`, созданной уполномоченным оператором. Изменение названия роли аккаунта не открывает эту очередь."],
      ["Return to learner dashboard", "Вернуться в панель ученика"],
      ["Authorized reviewer", "Уполномоченный проверяющий"],
      ["Program filter", "Фильтр программы"],
      ["All authorized programs", "Все разрешённые программы"],
      ["No submissions in this authorized queue.", "В этой разрешённой очереди нет работ."],
      ["Private reviewer feedback", "Приватный комментарий проверяющего"],
      ["Request changes", "Запросить исправления"],
      ["Accept evidence", "Принять работу"],
      ["Add specific reviewer feedback before recording a decision.", "Добавьте конкретный комментарий проверяющего перед фиксацией решения."],
      ["Private human review saved. Enrollment and lesson progress were not changed.", "Приватная проверка человеком сохранена. Зачисление и прогресс урока не изменены."],
      ["U.S. Logistics Operations", "Операции логистики США"],
      ["Marketing", "Маркетинг"],
      ["Applied · human review pending", "Подано · ожидает проверки человеком"],
      ["Approved", "Одобрено"],
      ["Enrolled", "Зачислен"],
      ["Paused", "Приостановлено"],
      ["Completed", "Завершено"],
      ["Cancelled", "Отменено"],
      ["Submitted", "Отправлено"],
      ["Changes requested", "Нужны изменения"],
      ["Accepted", "Принято"],
      ["Could not load learner state", "Не удалось загрузить состояние ученика"],
      ["Could not save learner preferences", "Не удалось сохранить настройки ученика"],
      ["Could not create program request", "Не удалось создать запрос на программу"],
      ["Could not refresh learner state", "Не удалось обновить состояние ученика"],
      ["Could not load curriculum progress", "Не удалось загрузить прогресс программы"],
      ["Could not save lesson progress", "Не удалось сохранить прогресс урока"],
      ["Could not load lesson", "Не удалось загрузить урок"],
      ["Could not load submissions", "Не удалось загрузить отправленные работы"],
      ["Could not load progression evidence", "Не удалось загрузить данные прогресса"],
      ["Could not load learner programs", "Не удалось загрузить программы ученика"],
      ["Could not load support history", "Не удалось загрузить историю поддержки"],
      ["Could not create support question", "Не удалось создать вопрос в поддержку"],
      ["Could not send follow-up", "Не удалось отправить дополнительный вопрос"],
      ["Could not load reviewer queue", "Не удалось загрузить очередь проверяющего"],
      ["Could not save review", "Не удалось сохранить проверку"],
      ["Login failed", "Не удалось войти"],
      ["Registration failed", "Не удалось зарегистрироваться"],
    ]);

    const placeholders = new Map([
      ["Kyiv, Ukraine", "Киев, Украина"],
      ["Explain what you learned, how you would apply it, and what still needs clarification.", "Опишите, что вы изучили, как применили бы это и что всё ещё требует уточнения."],
      ["Explain what the reviewer should look for in the linked evidence.", "Объясните, на что проверяющему обратить внимание в работе по ссылке."],
      ["What do you need help understanding?", "Что вам нужно помочь понять?"],
      ["Give the context, what you already tried, and the exact point that is unclear.", "Опишите контекст, что вы уже пробовали и какой именно момент остаётся непонятным."],
      ["Explain what is strong, what must change, and the learner's next concrete action.", "Укажите, что сделано хорошо, что нужно изменить и какое конкретное действие ученику выполнить дальше."],
    ]);

    const statusRu = (value) => {
      const normalized = String(value || "").replaceAll("_", " ").trim().toLowerCase();
      const map = {
        applied: "подано", approved: "одобрено", enrolled: "зачислен", paused: "приостановлено", completed: "завершено", cancelled: "отменено",
        submitted: "отправлено", "changes requested": "нужны изменения", accepted: "принято", "not started": "не начато", "in progress": "в процессе", closed: "закрыто", open: "открыто",
        "written reflection": "письменный ответ", "evidence link": "ссылка на работу", "free practice": "бесплатная практика", "paid cohort": "платный поток", unspecified: "не определено",
      };
      return map[normalized] || String(value || "");
    };

    const dynamic = (value) => {
      let match = value.match(/^Shared Hermes identity · (.+)$/);
      if (match) return `Общая учётная запись Hermes · ${match[1]}`;
      match = value.match(/^Location · (.+)$/);
      if (match) return match[1] === "not set" ? "Местоположение · не указано" : `Местоположение · ${match[1]}`;
      match = value.match(/^Enrollment · (.+)$/);
      if (match) return `Зачисление · ${statusRu(match[1])}`;
      match = value.match(/^Participation model: (.+?)( · Cohort: (.+))?$/);
      if (match) {
        const model = match[1] === "decided during human review" ? "определяется при проверке человеком" : statusRu(match[1]);
        return `Формат участия: ${model}${match[3] ? ` · Поток: ${match[3]}` : ""}`;
      }
      match = value.match(/^(\d+) of (\d+) modules self-tracked complete$/);
      if (match) return `${match[1]} из ${match[2]} модулей отмечено завершёнными`;
      match = value.match(/^Module (\d+)$/);
      if (match) return `Модуль ${match[1]}`;
      match = value.match(/^Lesson version · (.+)$/);
      if (match) return `Версия урока · ${match[1]}`;
      match = value.match(/^Maximum length: (\d+) words\.$/);
      if (match) return `Максимальный объём: ${match[1]} слов.`;
      match = value.match(/^(\d+) \/ (\d+) lessons self-tracked complete$/);
      if (match) return `${match[1]} / ${match[2]} уроков отмечено завершёнными`;
      match = value.match(/^(\d+) accepted · (\d+) unresolved$/);
      if (match) return `${match[1]} принято · ${match[2]} не решено`;
      match = value.match(/^Recorded (.+)$/);
      if (match) return `Зафиксировано ${match[1]}`;
      match = value.match(/^Lesson: (.+?) · evidence accepted (\d+) · pending (\d+)$/);
      if (match) return `Урок: ${statusRu(match[1])} · принято работ ${match[2]} · ожидают ${match[3]}`;
      match = value.match(/^Human review · (.+)$/);
      if (match) return `Проверка человеком · ${statusRu(match[1])}`;
      match = value.match(/^Prior review · (.+)$/);
      if (match) return `Предыдущая проверка · ${statusRu(match[1])}`;
      match = value.match(/^Academy support · (.+)$/);
      if (match) return `Поддержка Академии · ${match[1]}`;
      match = value.match(/^You · (.+)$/);
      if (match) return `Вы · ${match[1]}`;
      match = value.match(/^Assignment selected: (.+)\. Complete the evidence below and submit it for human review\.$/);
      if (match) return `Выбрано задание: ${match[1]}. Выполните работу ниже и отправьте её на проверку человеком.`;
      match = value.match(/^Follow-up question for (.+)$/);
      if (match) return `Дополнительный вопрос по теме «${match[1]}»`;
      return null;
    };

    const protectedContentSelectors = [
      "[data-lesson-title]", "[data-lesson-purpose]", "[data-objectives]", "[data-section-grid]", "[data-source-list]",
      "[data-assignment-scenario]", "[data-assignment-prompt]", "[data-assignment-parts]", "[data-rubric-list]", "[data-boundaries]",
      ".academy-review-evidence", ".academy-review-feedback span",
    ].join(",");

    const translateTree = (root) => {
      if (!root) return;
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      let node = walker.nextNode();
      while (node) {
        const parent = node.parentElement;
        if (!parent?.closest(protectedContentSelectors)) {
          const raw = node.nodeValue || "";
          const normalized = raw.replace(/\s+/g, " ").trim();
          const replacement = translations.get(normalized) || dynamic(normalized);
          if (replacement) {
            const leading = raw.match(/^\s*/)?.[0] || "";
            const trailing = raw.match(/\s*$/)?.[0] || "";
            node.nodeValue = `${leading}${replacement}${trailing}`;
          }
        }
        node = walker.nextNode();
      }

      root.querySelectorAll?.("input[placeholder], textarea[placeholder]").forEach((field) => {
        const current = field.getAttribute("placeholder") || "";
        const replacement = placeholders.get(current);
        if (replacement) field.setAttribute("placeholder", replacement);
      });
      root.querySelectorAll?.("[aria-label]").forEach((element) => {
        const current = element.getAttribute("aria-label") || "";
        const replacement = translations.get(current) || dynamic(current);
        if (replacement) element.setAttribute("aria-label", replacement);
      });
    };

    const titles = [
      [/\/auth\/?$/, "Вход ученика Академии | Hermes Connect"],
      [/\/dashboard\/?$/, "Панель ученика Академии | Hermes Connect"],
      [/\/lesson\/?$/, "Урок Академии | Hermes Connect"],
      [/\/program\//, "Программа Академии | Hermes Connect"],
      [/\/progression\/?$/, "Прогресс Академии | Hermes Connect"],
      [/\/submissions\/?$/, "Работы Академии | Hermes Connect"],
      [/\/reviewer\/?$/, "Проверка работ Академии | Hermes Connect"],
      [/\/support\/?$/, "Поддержка Академии | Hermes Connect"],
      [/\/academy\/?$/, "Академия | Hermes Connect"],
    ];
    const titleMatch = titles.find(([pattern]) => pattern.test(path));
    if (titleMatch) document.title = titleMatch[1];

    translateTree(document.body);

    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        mutation.addedNodes.forEach((added) => {
          if (added.nodeType === Node.ELEMENT_NODE) translateTree(added);
          else if (added.nodeType === Node.TEXT_NODE && added.parentElement) translateTree(added.parentElement);
        });
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>
