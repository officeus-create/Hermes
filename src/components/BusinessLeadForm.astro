  { value: "AI bots / AI sales assistant", en: "AI bots / AI sales assistant", ru: "AI-боты / AI-ассистент продаж", uk: "AI-боти / AI-асистент продажів" },
  { value: "SEO", en: "SEO", ru: "SEO", uk: "SEO" },
  { value: "Google Ads", en: "Google Ads", ru: "Google Ads", uk: "Google Ads" },
  { value: "Meta Ads (Facebook / Instagram)", en: "Meta Ads (Facebook / Instagram)", ru: "Meta Ads (Facebook / Instagram)", uk: "Meta Ads (Facebook / Instagram)" },
  { value: "Social media marketing & organic growth", en: "Social media marketing & organic growth", ru: "SMM и органический рост", uk: "SMM та органічне зростання" },
