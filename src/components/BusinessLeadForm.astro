    messengerError: "Вкажіть номер WhatsApp або контакт у Telegram.",
    servicesError: "Оберіть хоча б одну послугу.",
    previewReady: "Попередній перегляд готовий. Із цього середовища заявку не надіслано.",
    received: "Заявку отримано. Ми зв'яжемося через вказаний канал у вибраний вами час.",
    deliveryError: "Зараз надсилання заявки тимчасово недоступне. Спробуйте ще раз пізніше.",
  },
} as const;

const t = copy[locale];
---

<section class="section contact-section" id="business-lead">
  <div class="shell contact-layout">
    <div class="contact-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p>{t.body}</p>
      <p>{t.connect}</p>
    </div>

    <form
      class="contact-form"
      data-business-lead-form
      data-contact-mode={contactMode}
      data-send-label={t.send}
      data-preview-label={t.preview}
      data-sending-label={t.sending}
      data-messenger-error={t.messengerError}
      data-services-error={t.servicesError}
      data-preview-ready={t.previewReady}
      data-received={t.received}
      data-delivery-error={t.deliveryError}
      novalidate
    >
      <input type="hidden" name="interest" value={interest} />
      <div class="form-alert" role="alert" data-form-alert hidden></div>

      <div class="field-row">
        <label>
          {t.name}
          <input type="text" name="name" autocomplete="name" minlength="2" maxlength="100" required />
        </label>
        <label>
          Email
          <input type="email" name="email" autocomplete="email" maxlength="160" required />
        </label>
      </div>

      <div class="field-row">
        <label>
          {t.company}
          <input type="text" name="company" maxlength="140" required />
        </label>
        <label>
          {t.cityCountry}
          <input type="text" name="city_country" maxlength="120" placeholder={t.cityCountryPlaceholder} required />
        </label>
      </div>

      <div class="field-row">
        <label>
          {t.whatsapp}
          <input type="text" name="whatsapp" maxlength="120" placeholder="+380..." autocomplete="tel" />
        </label>
        <label>
          {t.telegram}
          <input type="text" name="telegram" maxlength="120" placeholder="@username or t.me/..." />
        </label>
      </div>
      <p class="form-status">{t.messengerHint}</p>

      <label>
        {t.websiteSocial}
        <input
          type="text"
          name="website_or_social"
          maxlength="240"
          placeholder={t.websitePlaceholder}
          required
        />
      </label>

      <fieldset class="contact-direction-platforms" data-service-group>
        <legend>{t.servicesLegend}</legend>
        {services.map((service) => (
          <label class="contact-direction-checkbox">
            <input type="checkbox" name="services" value={service.value} />
            <span>{service[locale]}</span>
          </label>
        ))}
      </fieldset>

      <div class="field-row">
        <label>
          {t.preferredLanguage}
          <select name="preferred_language" required>
            <option value="">{t.chooseLanguage}</option>
            <option value="Russian" selected={locale === "ru"}>{t.russian}</option>
            <option value="Ukrainian" selected={locale === "uk"}>{t.ukrainian}</option>
            <option value="English" selected={locale === "en" ? undefined : false}>{t.english}</option>
          </select>
        </label>
        <label>
          {t.bestTime}
          <input
            type="text"
            name="preferred_contact_time"
            maxlength="120"
            placeholder={t.bestTimePlaceholder}
            required
          />
        </label>
      </div>

      <label>
        {t.result}
        <textarea
          name="message"
          rows="4"
          minlength="10"
          maxlength="2000"
          placeholder={t.resultPlaceholder}
          required
        ></textarea>
      </label>

      <label class="honeypot" aria-hidden="true">
        {t.honeypot}
        <input type="text" name="middle_name" tabindex="-1" autocomplete="off" />
      </label>

      <label class="consent-field">
        <input type="checkbox" name="consent" required />
        <span>{t.consentPrefix} <a href="/privacy/">{t.privacy}</a>.</span>
      </label>

      <button class="button button-primary" type="submit">
        <span data-submit-label>{contactMode === "live" ? t.send : t.preview}</span>
        <ArrowRight size={18} aria-hidden="true" />
      </button>
      <p class="form-status" role="status" data-form-status></p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-business-lead-form]");
  const status = form?.querySelector<HTMLElement>("[data-form-status]");
  const alert = form?.querySelector<HTMLElement>("[data-form-alert]");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = form?.querySelector<HTMLElement>("[data-submit-label]");

  const setAlert = (message = "") => {
    if (!alert) return;
    alert.textContent = message;
    alert.hidden = !message;
  };

  const setSubmitting = (submitting: boolean) => {
    if (!submitButton || !submitLabel || !form) return;
    submitButton.disabled = submitting;
    submitButton.setAttribute("aria-busy", String(submitting));
    submitLabel.textContent = submitting
      ? form.dataset.sendingLabel || "Sending..."
      : form.dataset.contactMode === "live"
        ? form.dataset.sendLabel || "Send request"
        : form.dataset.previewLabel || "Preview request";
  };

  const getAttribution = () => {
    const params = new URLSearchParams(window.location.search);
    const pick = (name: string) => (params.get(name) ?? "").trim().slice(0, 240);
    return {
      utm_source: pick("utm_source"),
      utm_medium: pick("utm_medium"),
      utm_campaign: pick("utm_campaign"),
      utm_term: pick("utm_term"),
      utm_content: pick("utm_content"),
      gclid: pick("gclid"),
      gbraid: pick("gbraid"),
      wbraid: pick("wbraid"),
      referrer: document.referrer.slice(0, 500),
    };
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    setAlert();
    if (status) status.textContent = "";

    if (!form.reportValidity()) return;

    const data = new FormData(form);
    if (String(data.get("middle_name") ?? "")) return;

    const whatsapp = String(data.get("whatsapp") ?? "").trim();
    const telegram = String(data.get("telegram") ?? "").trim();
    if (!whatsapp && !telegram) {
      setAlert(form.dataset.messengerError || "Please provide a WhatsApp number or Telegram contact.");
      return;
    }

    const selectedServices = data.getAll("services").map((value) => String(value));
    if (!selectedServices.length) {
      setAlert(form.dataset.servicesError || "Please select at least one service.");
      return;
    }

    const payload = {
      request_id: crypto.randomUUID(),
      submitted_at: new Date().toISOString(),
      source_path: window.location.pathname,
      interest: String(data.get("interest") ?? ""),
      name: String(data.get("name") ?? ""),
      email: String(data.get("email") ?? ""),
      company: String(data.get("company") ?? ""),
      city_country: String(data.get("city_country") ?? ""),
      whatsapp,
      telegram,
      website_or_social: String(data.get("website_or_social") ?? ""),
      preferred_language: String(data.get("preferred_language") ?? ""),
      preferred_contact_time: String(data.get("preferred_contact_time") ?? ""),
      services: selectedServices,
      message: String(data.get("message") ?? ""),
      consent: data.get("consent") === "on",
      attribution: getAttribution(),
    };

    if (form.dataset.contactMode !== "live") {
      if (status) status.textContent = form.dataset.previewReady || "Preview ready. No request was sent from this environment.";
      return;
    }

    setSubmitting(true);
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 10000);

    try {
      const response = await fetch("/api/business-lead", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Idempotency-Key": payload.request_id,
        },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      if (!response.ok) throw new Error("delivery_failed");

      form.reset();
      if (status) status.textContent = form.dataset.received || "Request received. We will use the contact channel and time window you provided.";
    } catch {
      setAlert(form.dataset.deliveryError || "Contact delivery is temporarily unavailable. Please try again later.");
    } finally {
      window.clearTimeout(timeout);
      setSubmitting(false);
    }
  });
</script>