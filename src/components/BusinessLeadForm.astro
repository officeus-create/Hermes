    resultPlaceholder: "Наприклад: запустити новий сайт і отримувати цільові заявки з Google та Instagram.",
    honeypot: "Залиште це поле порожнім",
    consentPrefix: "Я погоджуюся, щоб Hermes використав ці дані для відповіді на мій запит.",
    privacy: "Політика конфіденційності",
