---
import { ArrowRight } from "@lucide/astro";

type BusinessLeadLocale = "en" | "ru" | "uk";

interface Props {
  selectedPath?: string;
  locale?: BusinessLeadLocale;
}

const { selectedPath = "ProgressoPro", locale = "en" } = Astro.props;
const interest = selectedPath === "IT Development" ? "IT Development" : "ProgressoPro";
const contactMode = import.meta.env.PUBLIC_CONTACT_MODE === "live" ? "live" : "preview";

const services = [
