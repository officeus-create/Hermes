<script is:inline>
  (() => {
    const CONSENT_KEY = "hermes-analytics-consent";
    const SESSION_KEY = "hermes-site-traffic-session-counted";
    let sent = false;

    const hasConsent = () => {
      if (navigator.webdriver === true) return false;
      try {
        return localStorage.getItem(CONSENT_KEY) === "granted";
      } catch {
        return false;
      }
    };

    const sessionNeedsCounting = () => {
      try {
        return sessionStorage.getItem(SESSION_KEY) !== "1";
      } catch {
        return false;
      }
    };

    const markSessionCounted = () => {
      try {
        sessionStorage.setItem(SESSION_KEY, "1");
      } catch {}
    };

    const send = () => {
      if (sent || !hasConsent()) return;
      sent = true;
      const sessionStart = sessionNeedsCounting();

      fetch("/api/site-traffic", {
        method: "POST",
        credentials: "same-origin",
        keepalive: true,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          path: window.location.pathname,
          analytics_consent: true,
          session_start: sessionStart
        })
      }).then((response) => {
        if (!response.ok && response.status !== 204) throw new Error("traffic_delivery_failed");
        if (sessionStart) markSessionCounted();
      }).catch(() => {
        sent = false;
      });
    };

    const start = () => {
      send();
      const observer = new MutationObserver(() => {
        if (document.documentElement.dataset.analyticsConsent === "granted") send();
      });
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-analytics-consent"]
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start, { once: true });
    } else {
      start();
    }
  })();
</script>
