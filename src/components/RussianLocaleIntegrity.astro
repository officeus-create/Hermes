<script is:inline>
  (() => {
    if (document.documentElement.lang !== "ru") return;

    const run = () => {
      const wordmark = document.querySelector(".site-header .wordmark");
      if (wordmark) wordmark.setAttribute("href", "/ru/#top");

      document.querySelectorAll('a[href="/privacy/"]').forEach((link) => {
        link.setAttribute("href", "/ru/privacy/");
      });

      const footerLocation = document.querySelector(".footer-location");
      if (footerLocation) footerLocation.textContent = "Логистика в США · международная координация по электронной почте";

      const budgetLabels = new Map([
        ["Not sure yet", "Пока не определён"],
        ["Under $1,000", "До $1 000"],
        ["$1,000–$3,000", "$1 000–$3 000"],
        ["$3,000–$10,000", "$3 000–$10 000"],
        ["$10,000–$25,000", "$10 000–$25 000"],
        ["$25,000+", "$25 000+"],
      ]);
      document.querySelectorAll('select[name="planning_budget"] option').forEach((option) => {
        const translated = budgetLabels.get(option.getAttribute("value") || option.textContent?.trim() || "");
        if (translated) option.textContent = translated;
      });

      const horizonLabels = new Map([
        ["Not sure yet", "Пока не определён"],
        ["3 months", "3 месяца"],
        ["6 months", "6 месяцев"],
        ["9 months", "9 месяцев"],
        ["12 months", "12 месяцев"],
      ]);
      document.querySelectorAll('select[name="planning_horizon"] option').forEach((option) => {
        const translated = horizonLabels.get(option.getAttribute("value") || option.textContent?.trim() || "");
        if (translated) option.textContent = translated;
      });

      const telegram = document.querySelector('input[name="telegram"]');
      if (telegram instanceof HTMLInputElement && telegram.placeholder === "@username or t.me/...") {
        telegram.placeholder = "@username или t.me/...";
      }

      document.querySelectorAll('[aria-label="Primary navigation"]').forEach((node) => node.setAttribute("aria-label", "Основная навигация"));
      document.querySelectorAll('[aria-label="Mobile navigation"]').forEach((node) => node.setAttribute("aria-label", "Мобильная навигация"));
      document.querySelectorAll('[aria-label="Choose language"]').forEach((node) => node.setAttribute("aria-label", "Выбор языка"));
      document.querySelectorAll('[aria-label="Footer navigation"]').forEach((node) => node.setAttribute("aria-label", "Навигация в футере"));
      document.querySelectorAll('[aria-label="Contact options"]').forEach((node) => node.setAttribute("aria-label", "Варианты связи"));
      document.querySelectorAll('[aria-label="Social media"]').forEach((node) => node.setAttribute("aria-label", "Социальные сети"));

      const backToTop = document.querySelector(".back-to-top");
      if (backToTop) backToTop.setAttribute("aria-label", "Наверх");

      const menuButton = document.querySelector("[data-menu-button]");
      if (menuButton?.getAttribute("aria-label") === "Open navigation") menuButton.setAttribute("aria-label", "Открыть навигацию");
    };

    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", run, { once: true });
    else run();
  })();
</script>