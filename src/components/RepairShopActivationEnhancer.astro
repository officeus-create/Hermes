---
const repairShopRoot = "/services/hermes-connect/repair-shops";
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "");
const isRepairShopSurface = normalizedPath === repairShopRoot || normalizedPath.startsWith(`${repairShopRoot}/`);
---

{isRepairShopSurface && (
  <>
    <script is:inline>
      (() => {
        const root = "/services/hermes-connect/repair-shops";
        const path = window.location.pathname.replace(/\/+$/, "");
        if (path !== `${root}/dashboard` || window.__hcRepairCoreFetchInstalled) return;
        window.__hcRepairCoreFetchInstalled = true;
        const originalFetch = window.fetch.bind(window);
        const corePaths = new Set([
          "/api/repair-shop/profile",
          "/api/services",
          "/api/repair-shop/availability",
          "/api/repair-shop/bookings",
        ]);
        const pending = new Map();
        const clear = () => pending.clear();
        window.fetch = async (input, init = {}) => {
          const request = input instanceof Request ? input : null;
          const method = String(init.method || request?.method || "GET").toUpperCase();
          const url = new URL(request?.url || String(input), window.location.origin);
          const sameOrigin = url.origin === window.location.origin;
          const key = `${method}:${url.pathname}${url.search}`;
          if (method === "GET" && sameOrigin && corePaths.has(url.pathname)) {
            if (!pending.has(key)) {
              pending.set(key, originalFetch(input, init).then((response) => {
                if (!response.ok) pending.delete(key);
                return response;
              }).catch((error) => { pending.delete(key); throw error; }));
            }
            const response = await pending.get(key);
            return response.clone();
          }
          if (method !== "GET" && sameOrigin) clear();
          const response = await originalFetch(input, init);
          if (method !== "GET" && sameOrigin) clear();
          return response;
        };
      })();
    </script>
    <script is:inline src="/repair-shop-activation.js"></script>
    <script is:inline src="/repair-shop-web-v1.js"></script>
    <script is:inline src="/repair-shop-qr.js"></script>
    <script is:inline>
      (() => {
        const root = "/services/hermes-connect/repair-shops";
        const path = window.location.pathname.replace(/\/+$/, "");
        if (path !== `${root}/auth`) return;

        const params = new URLSearchParams(window.location.search);
        const requested = params.get("lang") || document.documentElement.lang || "en";
        const copy = {
          en: { title:"Repair Shop access", subtitle:"Sign in or create your repair shop account to manage services, booking hours, appointments, and customers.", login:"Login", register:"Register New Shop", create:"Create Shop Account", dashboard:"Go to Shop Dashboard", forgot:"Forgot password?" },
          ru: { title:"Доступ владельца СТО", subtitle:"Войдите или создайте аккаунт СТО, чтобы управлять услугами, часами записи, заявками и клиентами.", login:"Войти", register:"Зарегистрировать СТО", create:"Создать аккаунт СТО", dashboard:"Перейти в кабинет СТО", forgot:"Забыли пароль?" },
          uk: { title:"Доступ власника СТО", subtitle:"Увійдіть або створіть акаунт СТО, щоб керувати послугами, годинами запису, заявками та клієнтами.", login:"Увійти", register:"Зареєструвати СТО", create:"Створити акаунт СТО", dashboard:"Перейти до кабінету СТО", forgot:"Забули пароль?" },
          es: { title:"Acceso del propietario del taller", subtitle:"Inicia sesión o crea la cuenta del taller para gestionar servicios, horarios, citas y clientes.", login:"Iniciar sesión", register:"Registrar taller", create:"Crear cuenta del taller", dashboard:"Ir al panel del taller", forgot:"¿Olvidaste tu contraseña?" },
          it: { title:"Accesso proprietario officina", subtitle:"Accedi o crea l’account dell’officina per gestire servizi, orari, appuntamenti e clienti.", login:"Accedi", register:"Registra officina", create:"Crea account officina", dashboard:"Vai al pannello officina", forgot:"Password dimenticata?" },
          fr: { title:"Accès propriétaire d’atelier", subtitle:"Connectez-vous ou créez le compte de l’atelier pour gérer services, horaires, rendez-vous et clients.", login:"Connexion", register:"Inscrire un atelier", create:"Créer le compte de l’atelier", dashboard:"Accéder au tableau de bord", forgot:"Mot de passe oublié ?" },
        };
        const locale = Object.prototype.hasOwnProperty.call(copy, requested) ? requested : "en";
        const t = copy[locale];

        const apply = () => {
          const title = document.querySelector("#auth-forms .auth-header h1");
          const subtitle = document.querySelector("#auth-forms .auth-header .auth-subtitle");
          const loginTab = document.querySelector('[data-tab="login"]');
          const registerTab = document.querySelector('[data-tab="register"]');
          const createButton = document.querySelector("#register-form button[type='submit']");
          const dashboardLink = document.querySelector("#auth-authenticated .auth-actions a[href*='/dashboard/']");
          const loginForm = document.querySelector("#login-form");

          if (title) title.textContent = t.title;
          if (subtitle) subtitle.textContent = t.subtitle;
          if (loginTab) loginTab.textContent = t.login;
          if (registerTab) registerTab.textContent = t.register;
          if (createButton) createButton.textContent = t.create;
          if (dashboardLink) {
            dashboardLink.textContent = t.dashboard;
            const url = new URL(dashboardLink.getAttribute("href") || `${root}/dashboard/`, window.location.origin);
            if (locale === "en") url.searchParams.delete("lang");
            else url.searchParams.set("lang", locale);
            dashboardLink.setAttribute("href", `${url.pathname}${url.search}${url.hash}`);
          }

          if (loginForm) {
            let forgotLink = loginForm.querySelector("[data-repair-forgot-password]");
            if (!(forgotLink instanceof HTMLAnchorElement)) {
              forgotLink = document.createElement("a");
              forgotLink.dataset.repairForgotPassword = "true";
              forgotLink.className = "repair-auth-forgot";
              const submitButton = loginForm.querySelector("button[type='submit']");
              if (submitButton) loginForm.insertBefore(forgotLink, submitButton);
              else loginForm.appendChild(forgotLink);
            }
            forgotLink.textContent = t.forgot;
            const forgotUrl = new URL(`${root}/forgot-password/`, window.location.origin);
            if (locale !== "en") forgotUrl.searchParams.set("lang", locale);
            forgotLink.href = `${forgotUrl.pathname}${forgotUrl.search}`;
          }

          if (params.get("mode") === "register" && registerTab instanceof HTMLElement && !registerTab.classList.contains("active")) {
            registerTab.click();
          }
        };

        apply();
        window.setTimeout(apply, 80);
      })();
    </script>
  </>
)}

<style is:global>
  .repair-auth-forgot{display:block;margin:-4px 0 16px;text-align:right;color:#a694ff;text-decoration:none;font-size:13px;font-weight:750}
  .repair-auth-forgot:hover{text-decoration:underline}
  .repair-activation-panel{margin:0 0 24px;padding:20px;border:1px solid rgba(110,231,183,.24);border-radius:18px;background:linear-gradient(135deg,rgba(52,211,153,.07),rgba(90,200,250,.045),rgba(157,136,255,.05));box-shadow:0 18px 55px rgba(0,0,0,.16)}
  .repair-activation-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:16px}
  .repair-activation-eyebrow{margin:0 0 6px;color:#6ee7b7;text-transform:uppercase;letter-spacing:.1em;font-size:11px;font-weight:850}
  .repair-activation-panel h2{margin:0;color:#f7f9fc;font-size:22px;letter-spacing:-.02em}
  .repair-activation-copy{margin:7px 0 0;color:#9faabd;font-size:13px;line-height:1.55}
  .repair-activation-progress{min-width:72px;text-align:right;color:#dce5f2;font-size:13px;font-weight:800}
  .repair-activation-track{height:7px;margin:0 0 16px;overflow:hidden;border-radius:999px;background:rgba(255,255,255,.07)}
  .repair-activation-fill{height:100%;width:0;border-radius:inherit;background:linear-gradient(90deg,#34d399,#5ac8fa);transition:width .25s ease}
  .repair-activation-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:0 0 16px;padding:0;list-style:none}
  .repair-activation-step{display:flex;gap:8px;align-items:flex-start;padding:10px;border:1px solid rgba(255,255,255,.07);border-radius:11px;background:rgba(255,255,255,.025);color:#929eb0;font-size:12px;line-height:1.35}
  .repair-activation-step strong{display:grid;place-items:center;flex:0 0 auto;width:22px;height:22px;border-radius:7px;background:rgba(255,255,255,.06);color:#cbd5e1;font-size:11px}
  .repair-activation-step[data-complete="true"]{border-color:rgba(52,211,153,.2);background:rgba(52,211,153,.045);color:#c6ead9}
  .repair-activation-step[data-complete="true"] strong{background:rgba(52,211,153,.15);color:#6ee7b7}
  .repair-activation-actions{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
  .repair-activation-primary,.repair-activation-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 13px;border-radius:10px;text-decoration:none;font-size:13px;font-weight:800}
  .repair-activation-primary{background:linear-gradient(135deg,#8b5cf6,#5ac8fa);color:#07101c}
  .repair-activation-secondary{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.03);color:#eef2f7}
  .repair-activation-next{margin:0;color:#8e99ab;font-size:12px;line-height:1.5}
  #public-link-wrap,#public-link-wrap>div,#public-link-text,#public-link-wrap .link-actions{min-width:0;max-width:100%}
  #public-link-text{display:block;overflow-wrap:anywhere;word-break:break-word}
  #public-link-wrap .link-actions{flex-wrap:wrap}
  #public-link-wrap .link-actions>*{min-width:0;max-width:100%;white-space:normal}
  @media(max-width:760px){.repair-activation-head{display:block}.repair-activation-progress{margin-top:8px;text-align:left}.repair-activation-steps{grid-template-columns:1fr 1fr}.repair-activation-actions{align-items:stretch;flex-direction:column}.repair-activation-primary,.repair-activation-secondary{width:100%;box-sizing:border-box}#public-link-wrap .link-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%}#public-link-wrap .link-actions>*{width:100%;box-sizing:border-box}}
  @media(max-width:440px){.repair-activation-steps{grid-template-columns:1fr}#public-link-wrap .link-actions{grid-template-columns:1fr}}
</style>