---
import { Compass, Layers3, UsersRound } from "lucide-astro";
import { site } from "../data/site";

const icons = [UsersRound, Compass, Layers3];
---

<section class="trust-band" id="about">
  <div class="shell trust-inner">
    <div class="trust-intro">
      <p class="eyebrow">How Hermes thinks</p>
      <h2>Different businesses. One practical standard.</h2>
    </div>
    <div class="principle-grid">
      {site.principles.map((principle, index) => {
        const Icon = icons[index];
        return (
          <article>
            <Icon size={23} aria-hidden="true" />
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>
