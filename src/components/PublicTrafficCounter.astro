---
---
<aside class="public-traffic-counter" data-public-traffic-counter aria-label="Hermes site traffic">
  <div class="public-traffic-counter__head">
    <span class="public-traffic-counter__pulse" aria-hidden="true"></span>
    <strong>Site traffic</strong>
  </div>
  <div class="public-traffic-counter__metrics">
    <span><b data-traffic-sessions-today>—</b><small>sessions today</small></span>
    <span><b data-traffic-views-today>—</b><small>views today</small></span>
    <span><b data-traffic-sessions-month>—</b><small>sessions month</small></span>
    <span><b data-traffic-views-month>—</b><small>views month</small></span>
  </div>
  <p data-traffic-note>Consent-based aggregate · UTC</p>
</aside>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-public-traffic-counter]");
    if (!(root instanceof HTMLElement)) return;

    const localStaticHost = ["localhost", "127.0.0.1", "::1"].includes(window.location.hostname);
    if (localStaticHost) {
      root.hidden = true;
      return;
    }

    const fmt = new Intl.NumberFormat("en-US");
    const put = (selector, value) => {
      const node = root.querySelector(selector);
      if (node) node.textContent = fmt.format(Number(value || 0));
    };

    fetch("/api/site-traffic-public", {
      credentials: "same-origin",
      cache: "no-store"
    })
      .then(async (response) => {
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.success !== true) throw new Error("traffic_unavailable");
        put("[data-traffic-sessions-today]", data.summary?.sessions_today);
        put("[data-traffic-views-today]", data.summary?.page_views_today);
        put("[data-traffic-sessions-month]", data.summary?.sessions_month);
        put("[data-traffic-views-month]", data.summary?.page_views_month);
        const note = root.querySelector("[data-traffic-note]");
        if (note) {
          const observedAt = data.updated_at ? new Date(data.updated_at) : null;
          const observedLabel = observedAt && !Number.isNaN(observedAt.getTime())
            ? "Updated " + observedAt.toISOString().slice(0, 16).replace("T", " ") + " UTC"
            : "Updated recently";
          note.textContent = observedLabel + " · consent-based aggregate · browser sessions are not unique people";
        }
      })
      .catch(() => {
        const note = root.querySelector("[data-traffic-note]");
        if (note) note.textContent = "Traffic temporarily unavailable";
      });
  })();
</script>

<style>
  .public-traffic-counter{
    position:fixed;
    right:16px;
    bottom:16px;
    z-index:32;
    width:min(680px,calc(100vw - 32px));
    min-height:48px;
    padding:7px 10px;
    display:grid;
    grid-template-columns:auto minmax(0,1fr);
    align-items:center;
    gap:8px 12px;
    border:1px solid rgba(125,151,181,.26);
    border-radius:999px;
    background:
      linear-gradient(110deg,rgba(255,255,255,.97),rgba(248,251,255,.94) 58%,rgba(242,248,255,.96));
    box-shadow:0 12px 30px rgba(20,45,78,.10),inset 0 1px 0 rgba(255,255,255,.9);
    color:#142033;
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
    overflow:hidden;
  }
  .public-traffic-counter::after{
    content:"";
    position:absolute;
    inset:0;
    pointer-events:none;
    background:linear-gradient(100deg,transparent 0 38%,rgba(110,177,255,.10) 46%,rgba(152,112,255,.08) 51%,transparent 60%);
    translate:-55% 0;
  }
  .public-traffic-counter__head{
    position:relative;
    z-index:1;
    display:flex;
    align-items:center;
    gap:7px;
    white-space:nowrap;
    font-size:10px;
    letter-spacing:.055em;
    text-transform:uppercase;
  }
  .public-traffic-counter__pulse{
    width:6px;height:6px;border-radius:999px;background:#2a8b66;
    box-shadow:0 0 0 3px rgba(42,139,102,.10);
  }
  .public-traffic-counter__metrics{
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:0;
    margin:0;
    min-width:0;
  }
  .public-traffic-counter__metrics span{
    min-width:0;
    padding:0 11px;
    border-left:1px solid rgba(125,151,181,.20);
    display:flex;
    align-items:baseline;
    gap:6px;
    white-space:nowrap;
  }
  .public-traffic-counter__metrics b{
    display:inline;
    font-size:15px;
    line-height:1;
    font-variant-numeric:tabular-nums;
    letter-spacing:-.03em;
  }
  .public-traffic-counter__metrics small{
    display:inline;
    color:#667a91;
    font-size:8px;
    line-height:1.1;
  }
  .public-traffic-counter p{
    grid-column:1/-1;
    margin:-2px 6px 0;
    color:#7b8a9b;
    font-size:7px;
    line-height:1.15;
    text-align:right;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  @media(max-width:760px){
    .public-traffic-counter{
      right:10px;bottom:10px;width:min(420px,calc(100vw - 20px));
      min-height:auto;padding:8px 10px;border-radius:18px;
      grid-template-columns:1fr;gap:6px;
    }
    .public-traffic-counter__head{font-size:9px}
    .public-traffic-counter__metrics{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:6px}
    .public-traffic-counter__metrics span{padding:0 8px}
    .public-traffic-counter__metrics span:nth-child(odd){border-left:0}
    .public-traffic-counter__metrics b{font-size:14px}
    .public-traffic-counter p{text-align:left;margin:0 2px;font-size:7px}
  }
  @media(prefers-reduced-motion:no-preference){
    .public-traffic-counter__pulse{animation:traffic-pulse 2.8s ease-out infinite}
    .public-traffic-counter::after{animation:traffic-sheen 8.5s cubic-bezier(.2,.7,.2,1) infinite}
    @keyframes traffic-pulse{0%,100%{box-shadow:0 0 0 3px rgba(42,139,102,.10)}50%{box-shadow:0 0 0 6px rgba(42,139,102,.015)}}
    @keyframes traffic-sheen{0%,62%{translate:-55% 0;opacity:0}67%{opacity:1}82%{translate:80% 0;opacity:.8}88%,100%{translate:80% 0;opacity:0}}
  }
</style>
