---
---
<aside class="public-traffic-counter" data-public-traffic-counter aria-label="Hermes live site traffic">
  <div class="public-traffic-counter__head">
    <span class="public-traffic-counter__pulse" aria-hidden="true"></span>
    <strong>Live site traffic</strong>
  </div>
  <div class="public-traffic-counter__metrics">
    <span><b data-traffic-sessions-today>—</b><small>visitor sessions today</small></span>
    <span><b data-traffic-views-today>—</b><small>views today</small></span>
    <span><b data-traffic-views-month>—</b><small>views this month</small></span>
  </div>
  <p data-traffic-note>Consent-based aggregate · UTC</p>
</aside>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-public-traffic-counter]");
    if (!(root instanceof HTMLElement)) return;

    const fmt = new Intl.NumberFormat("en-US");
    const put = (selector, value) => {
      const node = root.querySelector(selector);
      if (node) node.textContent = fmt.format(Number(value || 0));
    };

    fetch("/api/site-traffic-public", {
      credentials: "same-origin",
      cache: "no-store"
    })
      .then(async (response) => {
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.success !== true) throw new Error("traffic_unavailable");
        put("[data-traffic-sessions-today]", data.summary?.sessions_today);
        put("[data-traffic-views-today]", data.summary?.page_views_today);
        put("[data-traffic-views-month]", data.summary?.page_views_month);
        const note = root.querySelector("[data-traffic-note]");
        if (note) note.textContent = "Consent-based aggregate · browser sessions are not unique people · UTC";
      })
      .catch(() => {
        const note = root.querySelector("[data-traffic-note]");
        if (note) note.textContent = "Live traffic temporarily unavailable";
      });
  })();
</script>

<style>
  .public-traffic-counter{
    position:fixed;
    right:16px;
    bottom:16px;
    z-index:32;
    width:min(410px,calc(100vw - 32px));
    padding:12px 14px;
    border:1px solid rgba(125,151,181,.34);
    border-radius:16px;
    background:rgba(248,251,255,.94);
    box-shadow:0 14px 38px rgba(20,45,78,.14);
    color:#142033;
    backdrop-filter:blur(16px);
    -webkit-backdrop-filter:blur(16px);
  }
  .public-traffic-counter__head{display:flex;align-items:center;gap:7px;font-size:12px;letter-spacing:.01em}
  .public-traffic-counter__pulse{width:7px;height:7px;border-radius:999px;background:#2a8b66;box-shadow:0 0 0 4px rgba(42,139,102,.12)}
  .public-traffic-counter__metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:9px}
  .public-traffic-counter__metrics span{min-width:0}
  .public-traffic-counter__metrics b{display:block;font-size:19px;line-height:1.1;font-variant-numeric:tabular-nums;letter-spacing:-.025em}
  .public-traffic-counter__metrics small{display:block;margin-top:2px;color:#667a91;font-size:9px;line-height:1.2}
  .public-traffic-counter p{margin:8px 0 0;color:#728399;font-size:9px;line-height:1.25}
  @media(max-width:680px){
    .public-traffic-counter{right:10px;bottom:10px;width:min(360px,calc(100vw - 20px));padding:10px 12px;border-radius:14px}
    .public-traffic-counter__metrics{gap:7px}
    .public-traffic-counter__metrics b{font-size:17px}
  }
  @media(prefers-reduced-motion:no-preference){
    .public-traffic-counter__pulse{animation:traffic-pulse 2.4s ease-out infinite}
    @keyframes traffic-pulse{0%,100%{box-shadow:0 0 0 4px rgba(42,139,102,.12)}50%{box-shadow:0 0 0 7px rgba(42,139,102,.02)}}
  }
</style>
