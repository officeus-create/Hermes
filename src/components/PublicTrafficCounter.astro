---
---
<aside class="public-traffic-counter" data-public-traffic-counter aria-label="Hermes site traffic">
  <div class="public-traffic-counter__head">
    <span class="public-traffic-counter__pulse" aria-hidden="true"></span>
    <strong data-traffic-title>Site traffic</strong>
  </div>
  <div class="public-traffic-counter__metrics">
    <span><b data-traffic-sessions-today>—</b><small data-traffic-sessions-today-label>visitor sessions today</small></span>
    <span><b data-traffic-views-today>—</b><small data-traffic-views-today-label>views today</small></span>
    <span><b data-traffic-sessions-month>—</b><small data-traffic-sessions-month-label>visitor sessions this month</small></span>
    <span><b data-traffic-views-month>—</b><small data-traffic-views-month-label>views this month</small></span>
  </div>
  <p data-traffic-note>Consent-based aggregate · UTC</p>
</aside>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-public-traffic-counter]");
    if (!(root instanceof HTMLElement)) return;

    const localStaticHost = ["localhost", "127.0.0.1", "::1"].includes(window.location.hostname);
    if (localStaticHost) {
      root.hidden = true;
      return;
    }

    const supported = new Set(["en","ru","uk","es","it","fr"]);
    const requested = String(new URLSearchParams(window.location.search).get("lang") || "").toLowerCase();
    const documentLocale = String(document.documentElement.lang || "en").toLowerCase();
    const locale = supported.has(requested) ? requested : supported.has(documentLocale) ? documentLocale : "en";
    const copy = {
      en:{title:"Site traffic",sessionsToday:"visitor sessions today",viewsToday:"views today",sessionsMonth:"visitor sessions this month",viewsMonth:"views this month",base:"Consent-based aggregate · UTC",updated:"Updated",recent:"Updated recently",suffix:"consent-based aggregate · browser sessions are not unique people",unavailable:"Traffic temporarily unavailable",aria:"Hermes site traffic"},
      ru:{title:"Посещаемость сайта",sessionsToday:"сессии посетителей сегодня",viewsToday:"просмотры сегодня",sessionsMonth:"сессии посетителей за месяц",viewsMonth:"просмотры за месяц",base:"Агрегат по согласию · UTC",updated:"Обновлено",recent:"Недавно обновлено",suffix:"агрегат по согласию · браузерные сессии не равны уникальным людям",unavailable:"Данные о трафике временно недоступны",aria:"Посещаемость сайта Hermes"},
      uk:{title:"Відвідуваність сайту",sessionsToday:"сесії відвідувачів сьогодні",viewsToday:"перегляди сьогодні",sessionsMonth:"сесії відвідувачів за місяць",viewsMonth:"перегляди за місяць",base:"Агреговані дані за згодою · UTC",updated:"Оновлено",recent:"Нещодавно оновлено",suffix:"агреговані дані за згодою · браузерні сесії не дорівнюють унікальним людям",unavailable:"Дані про трафік тимчасово недоступні",aria:"Відвідуваність сайту Hermes"},
      es:{title:"Tráfico del sitio",sessionsToday:"sesiones de visitantes hoy",viewsToday:"vistas hoy",sessionsMonth:"sesiones de visitantes este mes",viewsMonth:"vistas este mes",base:"Agregado con consentimiento · UTC",updated:"Actualizado",recent:"Actualizado recientemente",suffix:"agregado con consentimiento · las sesiones del navegador no son personas únicas",unavailable:"Tráfico temporalmente no disponible",aria:"Tráfico del sitio Hermes"},
      it:{title:"Traffico del sito",sessionsToday:"sessioni visitatori oggi",viewsToday:"visualizzazioni oggi",sessionsMonth:"sessioni visitatori questo mese",viewsMonth:"visualizzazioni questo mese",base:"Aggregato con consenso · UTC",updated:"Aggiornato",recent:"Aggiornato di recente",suffix:"aggregato con consenso · le sessioni browser non sono persone uniche",unavailable:"Traffico temporaneamente non disponibile",aria:"Traffico del sito Hermes"},
      fr:{title:"Trafic du site",sessionsToday:"sessions visiteurs aujourd’hui",viewsToday:"vues aujourd’hui",sessionsMonth:"sessions visiteurs ce mois-ci",viewsMonth:"vues ce mois-ci",base:"Agrégat avec consentement · UTC",updated:"Mis à jour",recent:"Mis à jour récemment",suffix:"agrégat avec consentement · les sessions navigateur ne sont pas des personnes uniques",unavailable:"Trafic temporairement indisponible",aria:"Trafic du site Hermes"}
    }[locale];
    root.setAttribute("aria-label",copy.aria);
    const setText=(selector,value)=>{const node=root.querySelector(selector);if(node)node.textContent=value;};
    setText("[data-traffic-title]",copy.title);
    setText("[data-traffic-sessions-today-label]",copy.sessionsToday);
    setText("[data-traffic-views-today-label]",copy.viewsToday);
    setText("[data-traffic-sessions-month-label]",copy.sessionsMonth);
    setText("[data-traffic-views-month-label]",copy.viewsMonth);
    setText("[data-traffic-note]",copy.base);

    const fmt = new Intl.NumberFormat(locale === "en" ? "en-US" : locale);
    const put = (selector, value) => {
      const node = root.querySelector(selector);
      if (node) node.textContent = fmt.format(Number(value || 0));
    };

    fetch("/api/site-traffic-public", {
      credentials: "same-origin",
      cache: "no-store"
    })
      .then(async (response) => {
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.success !== true) throw new Error("traffic_unavailable");
        put("[data-traffic-sessions-today]", data.summary?.sessions_today);
        put("[data-traffic-views-today]", data.summary?.page_views_today);
        put("[data-traffic-sessions-month]", data.summary?.sessions_month);
        put("[data-traffic-views-month]", data.summary?.page_views_month);
        const note = root.querySelector("[data-traffic-note]");
        if (note) {
          const observedAt = data.updated_at ? new Date(data.updated_at) : null;
          const observedLabel = observedAt && !Number.isNaN(observedAt.getTime())
            ? copy.updated + " " + observedAt.toISOString().slice(0, 16).replace("T", " ") + " UTC"
            : copy.recent;
          note.textContent = observedLabel + " · " + copy.suffix;
        }
      })
      .catch(() => {
        const note = root.querySelector("[data-traffic-note]");
        if (note) note.textContent = copy.unavailable;
      });
  })();
</script>

<style>
  .public-traffic-counter{
    position:fixed;
    right:16px;
    bottom:16px;
    z-index:32;
    width:min(410px,calc(100vw - 32px));
    padding:12px 14px;
    border:1px solid rgba(125,151,181,.34);
    border-radius:16px;
    background:rgba(248,251,255,.94);
    box-shadow:0 14px 38px rgba(20,45,78,.14);
    color:#142033;
    backdrop-filter:blur(16px);
    -webkit-backdrop-filter:blur(16px);
  }
  .public-traffic-counter__head{display:flex;align-items:center;gap:7px;font-size:12px;letter-spacing:.01em}
  .public-traffic-counter__pulse{width:7px;height:7px;border-radius:999px;background:#2a8b66;box-shadow:0 0 0 4px rgba(42,139,102,.12)}
  .public-traffic-counter__metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 14px;margin-top:9px}
  .public-traffic-counter__metrics span{min-width:0}
  .public-traffic-counter__metrics b{display:block;font-size:19px;line-height:1.1;font-variant-numeric:tabular-nums;letter-spacing:-.025em}
  .public-traffic-counter__metrics small{display:block;margin-top:2px;color:#667a91;font-size:9px;line-height:1.2}
  .public-traffic-counter p{margin:8px 0 0;color:#728399;font-size:9px;line-height:1.25}
  @media(max-width:680px){
    .public-traffic-counter{right:10px;bottom:10px;width:min(360px,calc(100vw - 20px));padding:10px 12px;border-radius:14px}
    .public-traffic-counter__metrics{gap:7px}
    .public-traffic-counter__metrics b{font-size:17px}
  }
  @media(prefers-reduced-motion:no-preference){
    .public-traffic-counter__pulse{animation:traffic-pulse 2.4s ease-out infinite}
    @keyframes traffic-pulse{0%,100%{box-shadow:0 0 0 4px rgba(42,139,102,.12)}50%{box-shadow:0 0 0 7px rgba(42,139,102,.02)}}
  }
</style>
