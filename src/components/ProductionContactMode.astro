<script>
  const productionHosts = new Set(["hermeslogisticsus.com", "www.hermeslogisticsus.com"]);
  const attributionKeys = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "service", "track", "program", "language"] as const;

  const safeAttribution = () => {
    const params = new URLSearchParams(window.location.search);
    const values: Record<string, string> = {};

    for (const key of attributionKeys) {
      const value = String(params.get(key) || "")
        .replace(/[\u0000-\u001f\u007f<>]/g, "")
        .trim()
        .slice(0, 80);
      if (value) values[key] = value;
    }

    return Object.keys(values).length ? values : null;
  };

  const installAttributionBridge = (form: HTMLFormElement) => {
    const attribution = safeAttribution();
    if (!attribution) return;

    for (const [key, value] of Object.entries(attribution)) {
      const name = `hermes_attribution_${key}`;
      const existing = form.elements.namedItem(name);
      const input = existing instanceof HTMLInputElement ? existing : document.createElement("input");
      if (!(existing instanceof HTMLInputElement)) {
        input.type = "hidden";
        input.name = name;
        form.append(input);
      }
      input.value = value;
    }

    // The private receiver retains approved UTM values. A provider-accepted
    // 2xx is not a human lead or final mail-server delivery; do not emit a
    // London conversion from status copy or user-controlled campaign values.

  };

  const activateProductionContact = () => {
    if (window.location.protocol !== "https:" || !productionHosts.has(window.location.hostname)) return;

    document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
      form.dataset.contactMode = "live";
      form.dataset.contactEndpoint = "/api/logistics-lead";

      const label = form.querySelector<HTMLElement>("[data-submit-label]");
      if (label) label.textContent = "Send request";

      installAttributionBridge(form);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", activateProductionContact, { once: true });
  } else {
    activateProductionContact();
  }
</script>