<script>
  const academyInterest = "Hermes Business Academy";
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const pathSelect = form?.querySelector<HTMLSelectElement>('select[name="path"]');
  const fieldsRoot = form?.querySelector<HTMLElement>("[data-direction-fields]");
  const params = new URLSearchParams(window.location.search);
  const requestedProgram = params.get("program");
  const requestedLanguage = params.get("language");
  const isUkrainian = requestedLanguage === "uk";
  const allowedPrograms = new Set(["us-logistics-operations", "marketing"]);

  const copy = isUkrainian
    ? {
        program: "Програма",
        chooseProgram: "Оберіть публічну програму",
        countryCity: "Країна та місто",
        languagesLevels: "Мови та рівні",
        englishLevel: "Рівень розмовної англійської",
        chooseEnglishLevel: "Оберіть рівень англійської",
        notSure: "Не впевнений / не впевнена",
        recentExperience: "Релевантний досвід за останні 3–6 місяців",
        objective: "Основна мета",
        chooseObjective: "Оберіть мету",
        careerDevelopment: "Кар’єрний розвиток",
        businessCapability: "Розвиток бізнес-компетенцій",
        careerAndBusiness: "Кар’єра та бізнес",
        exploration: "Я ще визначаюся",
        usAvailability: "Доступність для роботи або практики за часовими поясами США",
        contactRoute: "Бажаний канал зв’язку",
        chooseContactRoute: "Оберіть канал зв’язку",
        privacyNote: "Не додавайте паролі, коди підтвердження, документи, платіжні дані, приватні записи клієнтів або конфіденційну інформацію про перевезення.",
        qualificationTitle: "Кваліфікація Academy:",
      }
    : {
        program: "Program",
        chooseProgram: "Choose a public program",
        countryCity: "Country and city",
        languagesLevels: "Languages and levels",
        englishLevel: "Spoken English level",
        chooseEnglishLevel: "Choose an English level",
        notSure: "Not sure",
        recentExperience: "Relevant experience during the last 3-6 months",
        objective: "Primary objective",
        chooseObjective: "Choose an objective",
        careerDevelopment: "Career development",
        businessCapability: "Business capability",
        careerAndBusiness: "Career and business",
        exploration: "I am still exploring",
        usAvailability: "Availability for U.S. time-zone work or practice",
        contactRoute: "Preferred contact route",
        chooseContactRoute: "Choose a contact route",
        privacyNote: "Do not include passwords, verification codes, identity documents, payment data, private customer records, or confidential shipment information.",
        qualificationTitle: "Academy qualification:",
      };

  const setFieldLabel = (name: string, labelText: string) => {
    if (!form) return;
    const field = form.elements.namedItem(name);
    if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)) return;
    const label = field.closest("label");
    if (!label) return;
    const textNode = [...label.childNodes].find((node) => node.nodeType === Node.TEXT_NODE && node.textContent?.trim());
    if (textNode) textNode.textContent = `\n          ${labelText}\n          `;
  };

  const localizeBaseApplicationShell = () => {
    if (!isUkrainian || !form) return;
    form.dataset.academyApplicationLanguage = "uk";

    setFieldLabel("name", "Ваше ім’я");
    setFieldLabel("email", "Email");
    setFieldLabel("path", "Напрям");
    setFieldLabel("message", "Коротко опишіть вашу мету");

    const consent = form.querySelector<HTMLElement>(".consent-field span");
    if (consent) {
      const privacy = consent.querySelector<HTMLAnchorElement>('a[href="/privacy/"]');
      consent.replaceChildren(
        document.createTextNode("Я погоджуюся, що Hermes може використати ці дані, щоб відповісти на заявку. "),
        privacy ?? Object.assign(document.createElement("a"), { href: "/privacy/", textContent: "Політика конфіденційності" }),
        document.createTextNode("."),
      );
      if (privacy) privacy.textContent = "Політика конфіденційності";
    }

    const directRoutes = document.querySelector<HTMLElement>(".contact-direct-routes");
    if (directRoutes) {
      directRoutes.setAttribute("aria-label", "Доступні канали зв’язку");
      const heading = directRoutes.querySelector<HTMLElement>(":scope > p");
      if (heading) heading.textContent = "Доступні канали зв’язку";
    }

    const summary = form.querySelector<HTMLElement>("[data-handoff-summary]");
    if (summary) summary.setAttribute("aria-label", "Підсумок заявки");
    const routeHeading = form.querySelector<HTMLElement>(".contact-handoff-route > p");
    if (routeHeading) routeHeading.textContent = "Погоджений канал зв’язку";

    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const translateSubmitLabel = () => {
      if (!submitLabel) return;
      const current = submitLabel.textContent?.trim() ?? "";
      if (current === "Sending...") submitLabel.textContent = "Надсилання…";
      else if (current === "Send request") submitLabel.textContent = "Надіслати заявку";
      else if (current === "Preview request") submitLabel.textContent = "Переглянути заявку";
    };
    translateSubmitLabel();
    if (submitLabel) {
      const submitObserver = new MutationObserver(translateSubmitLabel);
      submitObserver.observe(submitLabel, { childList: true, characterData: true, subtree: true });
    }
  };

  const addField = (
    group: HTMLElement,
    type: "input" | "textarea" | "select",
    name: string,
    labelText: string,
    options: Array<{ value: string; label: string }> = [],
  ) => {
    const label = document.createElement("label");
    const span = document.createElement("span");
    span.textContent = labelText;
    label.appendChild(span);

    let field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    if (type === "textarea") {
      const textarea = document.createElement("textarea");
      textarea.rows = 3;
      textarea.maxLength = 1000;
      field = textarea;
    } else if (type === "select") {
      const select = document.createElement("select");
      for (const item of options) {
        const option = document.createElement("option");
        option.value = item.value;
        option.textContent = item.label;
        select.appendChild(option);
      }
      field = select;
    } else {
      const input = document.createElement("input");
      input.type = "text";
      input.maxLength = 300;
      field = input;
    }

    field.name = name;
    field.required = true;
    field.setAttribute("data-academy-qualification", "true");
    label.appendChild(field);
    group.appendChild(label);
    return field;
  };

  const enhanceAcademyFields = () => {
    if (!form || !pathSelect || !fieldsRoot || pathSelect.value !== academyInterest) return;
    const group = fieldsRoot.querySelector<HTMLElement>(".contact-direction-group");
    if (!group || group.dataset.academyApplicationExtended === "true") return;
    group.dataset.academyApplicationExtended = "true";
    group.dataset.academyApplicationLanguage = isUkrainian ? "uk" : "en";

    const groupEyebrow = group.querySelector<HTMLElement>(".contact-direction-eyebrow");
    if (isUkrainian && groupEyebrow) groupEyebrow.textContent = "Дані Academy";

    const program = addField(group, "select", "academy_program", copy.program, [
      { value: "", label: copy.chooseProgram },
      { value: "us-logistics-operations", label: "U.S. Logistics Operations" },
      { value: "marketing", label: "Marketing" },
    ]) as HTMLSelectElement;
    if (requestedProgram && allowedPrograms.has(requestedProgram)) program.value = requestedProgram;

    addField(group, "input", "academy_country_city", copy.countryCity);
    addField(group, "textarea", "academy_languages_levels", copy.languagesLevels);
    addField(group, "select", "academy_english_level", copy.englishLevel, [
      { value: "", label: copy.chooseEnglishLevel },
      { value: "A1-A2", label: "A1-A2" },
      { value: "B1", label: "B1" },
      { value: "B2", label: "B2" },
      { value: "C1-C2", label: "C1-C2" },
      { value: "Not sure", label: copy.notSure },
    ]);
    addField(group, "textarea", "academy_recent_experience", copy.recentExperience);
    addField(group, "select", "academy_objective", copy.objective, [
      { value: "", label: copy.chooseObjective },
      { value: "Career development", label: copy.careerDevelopment },
      { value: "Business capability", label: copy.businessCapability },
      { value: "Career and business", label: copy.careerAndBusiness },
      { value: "Exploration", label: copy.exploration },
    ]);
    addField(group, "input", "academy_us_timezone_availability", copy.usAvailability);
    addField(group, "select", "academy_preferred_contact_route", copy.contactRoute, [
      { value: "", label: copy.chooseContactRoute },
      { value: "Email", label: "Email" },
      { value: "Telegram", label: "Telegram" },
      { value: "WhatsApp", label: "WhatsApp" },
    ]);

    const note = document.createElement("p");
    note.className = "form-status";
    note.textContent = copy.privacyNote;
    group.appendChild(note);
  };

  const academySummaryFields = [
    [copy.program, "academy_program"],
    [copy.countryCity, "academy_country_city"],
    [copy.languagesLevels, "academy_languages_levels"],
    [copy.englishLevel, "academy_english_level"],
    [copy.recentExperience, "academy_recent_experience"],
    [copy.objective, "academy_objective"],
    [copy.usAvailability, "academy_us_timezone_availability"],
    [copy.contactRoute, "academy_preferred_contact_route"],
  ] as const;

  const appendAcademyPreviewSummary = () => {
    if (!form || !pathSelect || pathSelect.value !== academyInterest) return;
    const summary = form.querySelector<HTMLElement>("[data-handoff-summary]");
    if (!summary || !summary.textContent || summary.textContent.includes(copy.qualificationTitle)) return;

    const lines = academySummaryFields.flatMap(([label, name]) => {
      const field = form.elements.namedItem(name);
      if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)) return [];
      const value = field.value.trim();
      return value ? [`${label}: ${value}`] : [];
    });

    if (lines.length > 0) {
      summary.textContent = `${summary.textContent}\n\n${copy.qualificationTitle}\n${lines.join("\n")}`;
    }
  };

  if (fieldsRoot) {
    const observer = new MutationObserver(enhanceAcademyFields);
    observer.observe(fieldsRoot, { childList: true, subtree: true });
  }

  if (pathSelect && pathSelect.value !== academyInterest) {
    pathSelect.value = academyInterest;
    pathSelect.dispatchEvent(new Event("change", { bubbles: true }));
  }

  localizeBaseApplicationShell();

  form?.addEventListener("submit", () => {
    window.setTimeout(appendAcademyPreviewSummary, 0);
  });

  queueMicrotask(enhanceAcademyFields);
  window.setTimeout(enhanceAcademyFields, 0);
</script>
