---
interface Props {
  vertical: "repair_shop" | "dealer" | "beauty_salon";
  backHref: string;
  backLabel: string;
}
const { vertical, backHref, backLabel } = Astro.props;
---

<main class:list={["business-social-page", vertical === "repair_shop" && "company-page"]} data-business-social data-vertical={vertical}>
  <div class="social-shell">
    <a class="back-link" href={backHref}>← {backLabel}</a>

    <header class="social-hero">
      <div>
        <p class="eyebrow">Hermes Connect · Social Studio</p>
        <h1>Social Media</h1>
        <p class="lead">Connect Facebook, Instagram and Threads once, see the channels together, and prepare one owner-approved content package for the selected destinations.</p>
      </div>
      <div class="truth-card">
        <span>Current business</span>
        <strong data-business-name>Loading…</strong>
        <small data-business-type>Owner workspace</small>
      </div>
    </header>

    <p class="notice" data-social-status role="status">Checking connection state…</p>

    <section class="connection-strip" aria-label="Social network connections">
      <article class="connection-card" data-provider-card="instagram">
        <div class="network-mark" aria-hidden="true">IG</div>
        <div class="connection-copy"><strong>Instagram</strong><span data-provider-account>Not connected</span></div>
        <span class="state" data-provider-state>Loading…</span>
        <div class="candidate-wrap hidden" data-candidate-wrap><select aria-label="Choose Instagram account" data-candidate-select></select><button type="button" class="secondary" data-select-account>Use account</button></div>
        <div class="connection-actions"><button type="button" data-connect-provider>Connect</button><button type="button" class="secondary hidden" data-disconnect-provider>Disconnect</button></div>
      </article>

      <article class="connection-card" data-provider-card="facebook">
        <div class="network-mark" aria-hidden="true">f</div>
        <div class="connection-copy"><strong>Facebook</strong><span data-provider-account>Not connected</span></div>
        <span class="state" data-provider-state>Loading…</span>
        <div class="candidate-wrap hidden" data-candidate-wrap><select aria-label="Choose Facebook Page" data-candidate-select></select><button type="button" class="secondary" data-select-account>Use Page</button></div>
        <div class="connection-actions"><button type="button" data-connect-provider>Connect</button><button type="button" class="secondary hidden" data-disconnect-provider>Disconnect</button></div>
      </article>

      <article class="connection-card" data-provider-card="threads">
        <div class="network-mark threads-mark" aria-hidden="true">@</div>
        <div class="connection-copy"><strong>Threads</strong><span data-provider-account>Not connected</span></div>
        <span class="state" data-provider-state>Loading…</span>
        <div class="connection-actions"><button type="button" data-connect-provider>Connect</button><button type="button" class="secondary hidden" data-disconnect-provider>Disconnect</button></div>
      </article>
    </section>

    <section class="studio-section">
      <div class="section-heading">
        <div><p class="eyebrow">One screen · all channels</p><h2>Live channel overview</h2></div>
        <button type="button" class="secondary compact" data-refresh-feed>Refresh</button>
      </div>
      <div class="channel-overview">
        <article class="channel-panel" data-feed-panel="instagram"><div class="panel-title"><strong>Instagram</strong><span data-feed-state>Waiting</span></div><div class="feed-list" data-feed-list></div></article>
        <article class="channel-panel" data-feed-panel="facebook"><div class="panel-title"><strong>Facebook</strong><span data-feed-state>Waiting</span></div><div class="feed-list" data-feed-list></div></article>
        <article class="channel-panel" data-feed-panel="threads"><div class="panel-title"><strong>Threads</strong><span data-feed-state>Waiting</span></div><div class="feed-list" data-feed-list></div></article>
      </div>
    </section>

    <section class="studio-section composer-section">
      <div class="section-heading">
        <div><p class="eyebrow">Unified composer</p><h2>Create once, adapt by channel</h2></div>
        <p>One approval can fan out to the selected connected channels. Each provider write keeps its own idempotency receipt, so a partial failure is visible and never blindly retried.</p>
      </div>

      <form class="unified-composer" data-unified-composer>
        <div class="composer-main">
          <label>Master caption / idea
            <textarea name="caption" rows="5" maxlength="2200" placeholder="Write the core message once. Threads and Facebook copies can be adjusted below."></textarea>
          </label>
          <label>Media URLs <span>1–10 public HTTPS images, one per line. One image = post; 2+ = carousel where supported.</span>
            <textarea name="image_urls" rows="5" placeholder="https://…/image-1.jpg&#10;https://…/image-2.jpg"></textarea>
          </label>
          <div class="copy-grid">
            <label>Threads copy <span>≤500 UTF-8 bytes</span><textarea name="threads_text" rows="4" maxlength="500" placeholder="Native Threads copy"></textarea></label>
            <label>Facebook copy <span>Optional override</span><textarea name="facebook_text" rows="4" maxlength="5000" placeholder="Facebook Page copy"></textarea></label>
          </div>
        </div>

        <aside class="distribution-card">
          <p class="eyebrow">Destinations</p>
          <label class="mirror-preset">
            <input type="checkbox" data-mirror-instagram checked />
            <span><strong>Smart mirror</strong><small>Instagram Feed → Instagram Story + Threads Feed + Facebook Page when those channels are connected.</small></span>
          </label>
          <label class="target-row"><input type="checkbox" value="instagram_feed" data-target data-target-provider="instagram" checked /><span><strong>Instagram Feed</strong><small>Single image or carousel</small></span></label>
          <label class="target-row"><input type="checkbox" value="instagram_story" data-target data-target-provider="instagram" checked /><span><strong>Instagram Story</strong><small>Uses the first image · eligible Business accounts</small></span></label>
          <label class="target-row"><input type="checkbox" value="threads_feed" data-target data-target-provider="threads" checked /><span><strong>Threads Feed</strong><small>Text, image or carousel</small></span></label>
          <label class="target-row"><input type="checkbox" value="facebook_feed" data-target data-target-provider="facebook" checked /><span><strong>Facebook Page</strong><small>Text, image or multi-image post</small></span></label>
          <div class="platform-boundary"><strong>Stories boundary</strong><span>Instagram Story is supported. Threads has no Instagram-style Story surface, so the same creative mirrors to the native Threads feed/carousel instead. Facebook remains a Page-feed destination until a separately verified Story publishing path exists.</span></div>
          <button type="submit" class="publish-button">Publish selected</button>
          <div class="publish-results" data-bundle-results aria-live="polite"></div>
        </aside>
      </form>
    </section>

    <section class="studio-section ai-section">
      <div class="section-heading">
        <div><p class="eyebrow">AI Creative Intake</p><h2>Google Drive → content brief → review → publish</h2></div>
        <span class="ai-state" data-ai-state>Drive authorization required</span>
      </div>
      <div class="ai-grid">
        <form class="ai-intake-card" data-ai-intake>
          <label>Google Drive folder or file URL<input name="source_url" type="url" placeholder="https://drive.google.com/…" required /></label>
          <div class="copy-grid">
            <label>Language<input name="language" value="en" /></label>
            <label>Market<input name="market" placeholder="USA, Dubai, local city…" /></label>
          </div>
          <label>What should AI understand or achieve?<textarea name="brief" rows="4" placeholder="Offer, audience, CTA, restrictions, products to prioritize…"></textarea></label>
          <label class="ai-auto-row"><input type="checkbox" data-ai-auto checked /><span><strong>Auto-build after intake</strong><small>When Drive and AI are ready, analyze the source immediately and prepare post, carousel, Story direction and platform copy for review.</small></span></label>
          <div class="ai-actions">
            <button type="submit">Register source</button>
            <button type="button" class="secondary" data-drive-connect>Connect Google Drive</button>
            <button type="button" class="secondary" data-ai-generate disabled>Generate AI draft</button>
          </div>
          <p data-ai-result></p>
        </form>
        <div class="ai-flow-card">
          <div><span>01</span><strong>Source</strong><small>Owner-approved Drive material</small></div>
          <div><span>02</span><strong>AI analysis</strong><small>Extract facts, offer, visual assets and content angles</small></div>
          <div><span>03</span><strong>Draft package</strong><small>Post, carousel, Story and platform-specific copy</small></div>
          <div><span>04</span><strong>Review & publish</strong><small>Human approval before external writes</small></div>
          <p>Source registration is live now. Automated Drive reading and AI generation stay fail-closed until business-scoped Google Drive OAuth and an approved model runtime are configured.</p>
        </div>
      </div>

      <div class="creative-review hidden" data-ai-preview>
        <div class="creative-review-head">
          <div><p class="eyebrow">Creative Review</p><h3>AI package before publishing</h3></div>
          <span data-ai-preview-state>Draft ready</span>
        </div>
        <div class="creative-review-grid">
          <article><strong>Source summary</strong><p data-ai-source-summary></p></article>
          <article><strong>Instagram Story direction</strong><p data-ai-story-copy></p><small>Used as the copy direction for a rendered Story asset; it is not silently published as a fake Threads Story.</small></article>
          <article><strong>Claims to verify</strong><ul data-ai-claims></ul></article>
        </div>
        <div class="carousel-review">
          <div class="carousel-review-title"><strong>Carousel storyboard</strong><span>2–10 slides · headline · body · visual direction</span></div>
          <div class="carousel-preview" data-ai-carousel-preview></div>
        </div>
      </div>
    </section>

    <section class="safety-note">
      <strong>Connection and publishing boundary</strong>
      <p>A public profile link is not OAuth. A channel becomes writable only after provider authorization and provider readback. Tokens stay encrypted server-side. Recurring scheduling remains owned by the canonical Hermes Social Publisher rather than this CRM creating a second scheduler.</p>
    </section>
  </div>
</main>

<script is:inline define:vars={{ vertical }}>
(() => {
  const root=document.querySelector("[data-business-social]");
  if(!(root instanceof HTMLElement))return;
  const status=root.querySelector("[data-social-status]");
  const cards=new Map([...root.querySelectorAll("[data-provider-card]")].map((node)=>[node.getAttribute("data-provider-card"),node]));
  const connectionState={instagram:false,facebook:false,threads:false};

  const showStatus=(message,error=false)=>{if(!status)return;status.textContent=message;status.toggleAttribute("data-error",error);};
  const request=async(url,options={})=>{
    const response=await fetch(url,{credentials:"same-origin",cache:"no-store",...options,headers:{Accept:"application/json","Content-Type":"application/json",...(options.headers||{})}});
    const payload=await response.json().catch(()=>({}));
    if(!response.ok){const error=new Error(payload.error||`request_${response.status}`);error.payload=payload;error.status=response.status;throw error;}
    return payload;
  };

  const updateTargets=()=>{
    for(const input of root.querySelectorAll("[data-target]")){
      if(!(input instanceof HTMLInputElement))continue;
      const provider=input.dataset.targetProvider;
      input.disabled=!connectionState[provider];
      input.closest(".target-row")?.toggleAttribute("data-disabled",input.disabled);
    }
    syncMirrorTargets();
  };
  const mirrorToggle=root.querySelector("[data-mirror-instagram]");
  const targetByValue=(value)=>root.querySelector(`[data-target][value="${value}"]`);
  const syncMirrorTargets=()=>{
    if(!(mirrorToggle instanceof HTMLInputElement)||!mirrorToggle.checked)return;
    const instagram=targetByValue("instagram_feed");
    if(!(instagram instanceof HTMLInputElement)||!instagram.checked||instagram.disabled)return;
    for(const value of ["instagram_story","threads_feed","facebook_feed"]){
      const target=targetByValue(value);
      if(target instanceof HTMLInputElement&&!target.disabled)target.checked=true;
    }
  };

  const renderConnection=(connection)=>{
    const provider=connection?.provider;
    const card=cards.get(provider);
    if(!(card instanceof HTMLElement))return;
    const stateValue=String(connection?.state||"ready_for_owner_auth");
    connectionState[provider]=stateValue==="connected_write";
    const state=card.querySelector("[data-provider-state]");
    const account=card.querySelector("[data-provider-account]");
    if(state)state.textContent=stateValue.replaceAll("_"," ");
    if(account)account.textContent=connection?.username?`@${connection.username}`:connection?.account_name||(connectionState[provider]?"Connected":"Not connected");
    const connect=card.querySelector("[data-connect-provider]");
    const disconnect=card.querySelector("[data-disconnect-provider]");
    if(connect instanceof HTMLButtonElement){connect.disabled=!connection?.configured;connect.textContent=connectionState[provider]?"Reconnect":connection?.configured?"Connect":"Needs app config";}
    if(disconnect instanceof HTMLElement)disconnect.classList.toggle("hidden",!connectionState[provider]);
    const candidates=Array.isArray(connection?.candidates)?connection.candidates:[];
    const wrap=card.querySelector("[data-candidate-wrap]");
    const select=card.querySelector("[data-candidate-select]");
    if(wrap instanceof HTMLElement)wrap.classList.toggle("hidden",stateValue!=="selection_required"||!candidates.length);
    if(select instanceof HTMLSelectElement){select.replaceChildren();for(const candidate of candidates){const option=document.createElement("option");option.value=String(candidate.index);option.textContent=String(candidate.label||"Account");select.append(option);}}
    updateTargets();
  };

  const loadConnections=async()=>{
    try{
      const payload=await request(`/api/hermes-connect/social/connections?vertical=${encodeURIComponent(vertical)}`);
      const businessName=root.querySelector("[data-business-name]");
      const businessType=root.querySelector("[data-business-type]");
      if(businessName)businessName.textContent=payload.business?.name||"Business";
      if(businessType)businessType.textContent=String(payload.business?.vertical||vertical).replaceAll("_"," ");
      for(const connection of payload.connections||[])renderConnection(connection);
      showStatus("Social Studio is ready. Connected channels can be reviewed and published from one screen.");
    }catch(error){showStatus(error?.message==="authentication_required"?"Sign in to the owner CRM first.":"Unable to load social connections.",true);}
  };

  for(const [provider,card] of cards){
    if(!(card instanceof HTMLElement))continue;
    card.querySelector("[data-connect-provider]")?.addEventListener("click",async()=>{
      try{showStatus(`Preparing ${provider} authorization…`);const payload=await request("/api/hermes-connect/social/oauth/start",{method:"POST",body:JSON.stringify({provider,vertical})});window.location.assign(payload.authorization_url);}
      catch(error){showStatus(`${provider}: ${error.message}`,true);}
    });
    card.querySelector("[data-select-account]")?.addEventListener("click",async()=>{
      const select=card.querySelector("[data-candidate-select]");if(!(select instanceof HTMLSelectElement))return;
      try{const payload=await request("/api/hermes-connect/social/select",{method:"POST",body:JSON.stringify({provider,vertical,candidate_index:Number(select.value)})});for(const connection of payload.connections||[])renderConnection(connection);showStatus(`${provider} account connected.`);void loadFeed();}
      catch(error){showStatus(`${provider}: ${error.message}`,true);}
    });
    card.querySelector("[data-disconnect-provider]")?.addEventListener("click",async()=>{
      if(!window.confirm(`Disconnect the Hermes-side ${provider} authorization for this business?`))return;
      try{const payload=await request("/api/hermes-connect/social/disconnect",{method:"POST",body:JSON.stringify({provider,vertical,confirm:true})});for(const connection of payload.connections||[])renderConnection(connection);showStatus(`${provider} disconnected locally.`);void loadFeed();}
      catch(error){showStatus(`${provider}: ${error.message}`,true);}
    });
  }

  const renderFeed=(provider,data)=>{
    const panel=root.querySelector(`[data-feed-panel="${provider}"]`);if(!(panel instanceof HTMLElement))return;
    const state=panel.querySelector("[data-feed-state]");const list=panel.querySelector("[data-feed-list]");
    if(!(list instanceof HTMLElement))return;list.replaceChildren();
    if(!data?.connected){if(state)state.textContent="Not connected";list.innerHTML='<p class="empty-feed">Connect this channel to load its recent content.</p>';return;}
    if(data.error){if(state)state.textContent="Readback issue";list.innerHTML='<p class="empty-feed">Connected, but recent-content readback is unavailable.</p>';return;}
    if(state)state.textContent="Live";
    const items=(data.items||[]).filter((item)=>provider!=="threads"||(!item.is_reply&&!item.is_repost)).slice(0,4);
    if(!items.length){list.innerHTML='<p class="empty-feed">No recent authored items returned.</p>';return;}
    for(const item of items){
      const article=document.createElement("article");article.className="feed-item";
      if(item.media_url){const img=document.createElement("img");img.src=item.media_url;img.alt="";img.loading="lazy";article.append(img);}
      const copy=document.createElement("div");const text=document.createElement("p");text.textContent=(item.text||item.media_type||"Post").slice(0,180);copy.append(text);
      const meta=document.createElement("small");meta.textContent=item.timestamp?new Date(item.timestamp).toLocaleString():"";copy.append(meta);
      if(item.permalink){const link=document.createElement("a");link.href=item.permalink;link.target="_blank";link.rel="noopener noreferrer";link.textContent="Open";copy.append(link);}
      article.append(copy);list.append(article);
    }
  };

  const loadFeed=async()=>{
    try{const payload=await request(`/api/hermes-connect/social/feed?vertical=${encodeURIComponent(vertical)}`);for(const provider of ["instagram","facebook","threads"])renderFeed(provider,payload.feeds?.[provider]);}
    catch{for(const provider of ["instagram","facebook","threads"])renderFeed(provider,{connected:false});}
  };
  root.querySelector("[data-refresh-feed]")?.addEventListener("click",()=>void loadFeed());

  const composer=root.querySelector("[data-unified-composer]");
  mirrorToggle?.addEventListener("change",()=>syncMirrorTargets());
  for(const target of root.querySelectorAll("[data-target]"))target.addEventListener("change",()=>syncMirrorTargets());
  const master=composer?.elements?.namedItem?.("caption");
  const threadsCopy=composer?.elements?.namedItem?.("threads_text");
  const facebookCopy=composer?.elements?.namedItem?.("facebook_text");
  let threadsTouched=false,facebookTouched=false;
  threadsCopy?.addEventListener("input",()=>threadsTouched=true);facebookCopy?.addEventListener("input",()=>facebookTouched=true);
  master?.addEventListener("input",()=>{
    if(!threadsTouched&&threadsCopy)threadsCopy.value=String(master.value||"").slice(0,500);
    if(!facebookTouched&&facebookCopy)facebookCopy.value=String(master.value||"");
  });

  composer?.addEventListener("submit",async(event)=>{
    event.preventDefault();
    const resultBox=root.querySelector("[data-bundle-results]");if(resultBox)resultBox.replaceChildren();
    syncMirrorTargets();
    const selected=[...new Set([...root.querySelectorAll("[data-target]:checked")].filter((node)=>node instanceof HTMLInputElement&&!node.disabled).map((node)=>node.value))];
    if(!selected.length){if(resultBox)resultBox.textContent="Select at least one connected destination.";return;}
    const imageUrls=String(composer.elements.namedItem("image_urls")?.value||"").split(/\r?\n/).map((item)=>item.trim()).filter(Boolean);
    if(selected.some((item)=>item.startsWith("instagram_"))&&!imageUrls.length){if(resultBox)resultBox.textContent="Instagram Feed/Story requires at least one public HTTPS image.";return;}
    if(!window.confirm(`Publish this approved package to ${selected.length} selected destination(s)?`))return;
    const base=`hc-studio-${Date.now()}-${Math.random().toString(36).slice(2,8)}`;
    const targetMap={
      instagram_feed:{provider:"instagram",surface:"feed"},
      instagram_story:{provider:"instagram",surface:"story"},
      threads_feed:{provider:"threads",surface:"feed"},
      facebook_feed:{provider:"facebook",surface:"feed"},
    };
    for(const target of selected){
      const row=document.createElement("div");row.className="result-row";row.textContent=`${target.replaceAll("_"," ")} · publishing…`;resultBox?.append(row);
      const cfg=targetMap[target];
      const payload={provider:cfg.provider,surface:cfg.surface,vertical,idempotency_key:`${base}-${target}`,image_urls:imageUrls};
      if(cfg.provider==="instagram")payload.caption=String(composer.elements.namedItem("caption")?.value||"");
      else if(cfg.provider==="threads")payload.text=String(composer.elements.namedItem("threads_text")?.value||composer.elements.namedItem("caption")?.value||"");
      else payload.text=String(composer.elements.namedItem("facebook_text")?.value||composer.elements.namedItem("caption")?.value||"");
      try{
        const response=await request("/api/hermes-connect/social/publish",{method:"POST",body:JSON.stringify(payload)});
        row.textContent=`${target.replaceAll("_"," ")} · ${response.publication?.status||"accepted"}`;
        if(response.publication?.permalink){const link=document.createElement("a");link.href=response.publication.permalink;link.target="_blank";link.rel="noopener noreferrer";link.textContent=" Open";row.append(link);}
      }catch(error){row.textContent=`${target.replaceAll("_"," ")} · ${error?.payload?.publication?.status||error.message||"failed"}`;row.setAttribute("data-error","true");}
    }
    void loadFeed();
  });

  const aiForm=root.querySelector("[data-ai-intake]");
  const creativePreview=root.querySelector("[data-ai-preview]");
  let currentIntakeId="";
  const renderCreativeReview=(draft)=>{
    if(!(creativePreview instanceof HTMLElement))return;
    const carousel=Array.isArray(draft?.carousel_plan)?draft.carousel_plan:[];
    const claims=Array.isArray(draft?.claims_to_verify)?draft.claims_to_verify:[];
    const hasDraft=Boolean(draft&&(draft.master_caption||draft.threads_text||draft.facebook_text||draft.instagram_story_text||draft.source_summary||carousel.length||claims.length));
    creativePreview.classList.toggle("hidden",!hasDraft);
    if(!hasDraft)return;
    const state=creativePreview.querySelector("[data-ai-preview-state]");if(state)state.textContent="Review required";
    const summary=creativePreview.querySelector("[data-ai-source-summary]");if(summary)summary.textContent=draft.source_summary||"No separate source summary returned.";
    const story=creativePreview.querySelector("[data-ai-story-copy]");if(story)story.textContent=draft.instagram_story_text||"No Story-specific copy returned.";
    const claimsList=creativePreview.querySelector("[data-ai-claims]");
    if(claimsList instanceof HTMLElement){
      claimsList.replaceChildren();
      if(!claims.length){const li=document.createElement("li");li.textContent="No unverified claims flagged by the draft.";claimsList.append(li);}
      for(const claim of claims){const li=document.createElement("li");li.textContent=String(claim);claimsList.append(li);}
    }
    const carouselRoot=creativePreview.querySelector("[data-ai-carousel-preview]");
    if(carouselRoot instanceof HTMLElement){
      carouselRoot.replaceChildren();
      if(!carousel.length){const empty=document.createElement("p");empty.className="creative-empty";empty.textContent="No carousel storyboard returned.";carouselRoot.append(empty);}
      carousel.slice(0,10).forEach((slide,index)=>{
        const card=document.createElement("article");card.className="carousel-slide";
        const number=document.createElement("span");number.textContent=String(index+1).padStart(2,"0");
        const headline=document.createElement("strong");headline.textContent=slide?.headline||"Slide";
        const body=document.createElement("p");body.textContent=slide?.body||"";
        const visual=document.createElement("small");visual.textContent=slide?.visual_direction?"Visual: "+slide.visual_direction:"Visual direction not specified.";
        card.append(number,headline,body,visual);carouselRoot.append(card);
      });
    }
  };
  const applyDraftToComposer=(draft)=>{
    if(!composer)return;
    const caption=composer.elements.namedItem("caption");const threads=composer.elements.namedItem("threads_text");const facebook=composer.elements.namedItem("facebook_text");
    if(caption)caption.value=draft?.master_caption||"";
    if(threads){threads.value=draft?.threads_text||"";threadsTouched=true;}
    if(facebook){facebook.value=draft?.facebook_text||"";facebookTouched=true;}
  };
  const generateCurrentIntake=async()=>{
    const result=root.querySelector("[data-ai-result]");
    if(!currentIntakeId){if(result)result.textContent="Register a Google Drive source first.";return false;}
    try{
      if(result)result.textContent="Reading Drive source and generating draft…";
      const payload=await request("/api/hermes-connect/social/creative-generate",{method:"POST",body:JSON.stringify({vertical,intake_id:currentIntakeId})});
      const draft=payload.draft||{};
      applyDraftToComposer(draft);
      renderCreativeReview(draft);
      if(result)result.textContent=`AI draft applied · ${payload.source?.asset_count||0} source asset(s) analyzed. Review before publishing.`;
      return true;
    }catch(error){if(result)result.textContent=error.message||"AI draft generation failed.";return false;}
  };

  aiForm?.addEventListener("submit",async(event)=>{
    event.preventDefault();const result=root.querySelector("[data-ai-result]");if(result)result.textContent="Registering source…";
    try{
      const payload=await request("/api/hermes-connect/social/creative-intake",{method:"POST",body:JSON.stringify({
        vertical,source_url:aiForm.elements.namedItem("source_url")?.value||"",brief:aiForm.elements.namedItem("brief")?.value||"",
        language:aiForm.elements.namedItem("language")?.value||"en",market:aiForm.elements.namedItem("market")?.value||"",
      })});
      currentIntakeId=String(payload.intake?.id||"");
      renderCreativeReview(null);
      if(result)result.textContent=`Source registered · ${payload.intake?.status||"ready"} · next: ${String(payload.next_gate||"review").replaceAll("_"," ")}`;
      const aiState=root.querySelector("[data-ai-state]");if(aiState)aiState.textContent=String(payload.next_gate||"source registered").replaceAll("_"," ");
      const generate=root.querySelector("[data-ai-generate]");if(generate instanceof HTMLButtonElement)generate.disabled=payload.next_gate!=="ready_to_generate";
      const auto=root.querySelector("[data-ai-auto]");
      if(payload.next_gate==="ready_to_generate"&&auto instanceof HTMLInputElement&&auto.checked)await generateCurrentIntake();
    }catch(error){if(result)result.textContent=error.message||"Unable to register source.";}
  });

  const loadCreativeState=async()=>{
    try{
      const payload=await request(`/api/hermes-connect/social/creative-intake?vertical=${encodeURIComponent(vertical)}`);
      const latest=payload.intakes?.[0];if(latest?.id&&!currentIntakeId)currentIntakeId=String(latest.id);
      if(latest?.draft)renderCreativeReview(latest.draft);
      const aiState=root.querySelector("[data-ai-state]");if(aiState)aiState.textContent=String(payload.ai?.state||"unknown").replaceAll("_"," ");
      const generate=root.querySelector("[data-ai-generate]");if(generate instanceof HTMLButtonElement)generate.disabled=payload.ai?.state!=="ready"||!currentIntakeId;
    }catch{}
  };

  root.querySelector("[data-drive-connect]")?.addEventListener("click",async()=>{
    const result=root.querySelector("[data-ai-result]");
    try{
      if(result)result.textContent="Preparing Google Drive authorization…";
      const payload=await request("/api/hermes-connect/social/drive/start",{method:"POST",body:JSON.stringify({vertical})});
      window.location.assign(payload.authorization_url);
    }catch(error){if(result)result.textContent=error.message||"Unable to start Google Drive authorization.";}
  });

  root.querySelector("[data-ai-generate]")?.addEventListener("click",()=>void generateCurrentIntake());

  const params=new URLSearchParams(window.location.search);const oauthResult=params.get("result");const driveResult=params.get("drive");
  if(oauthResult)showStatus(oauthResult==="connected"?"Provider authorization completed.":`Provider authorization: ${oauthResult.replaceAll("_"," ")}`,oauthResult!=="connected"&&oauthResult!=="selection_required");
  if(driveResult)showStatus(driveResult==="connected"?"Google Drive connected for Social Studio.":`Google Drive: ${driveResult.replaceAll("_"," ")}`,driveResult!=="connected");
  void loadConnections();void loadFeed();void loadCreativeState();
})();
</script>

