---
import { ArrowRight, Braces, Check } from "@lucide/astro";

const stages = [
  { number: "01", label: "Product architecture", status: "Defined", state: "done" },
  { number: "02", label: "Public product family", status: "Published", state: "done" },
  { number: "03", label: "Repair Shops", status: "Most mature current vertical", state: "active" },
  { number: "04", label: "Other configurations", status: "Preview", state: "planned" },
];

const firstFlow = ["Product hub", "Repair Shops", "Owner access", "Verified availability"];
import "../styles/features/technology.css";
import "../styles/hermes-technology-public.css";
import "../styles/hermes-technology-surface-ownership.css";
---

<section class="technology-build-pulse" id="build-progress" aria-labelledby="technology-build-title">
  <div class="shell technology-build-pulse-layout">
    <div class="technology-build-pulse-copy" data-reveal>
      <p class="eyebrow">Inside Hermes Technology · Product maturity</p>
      <div class="technology-build-status">
        <span aria-hidden="true"></span>
        Hermes Connect · Repair Shops is the most mature current vertical
      </div>
      <h2 id="technology-build-title">A public product family with clear maturity labels for each surface.</h2>
      <p>
        Hermes Connect now has public product surfaces, with Repair Shops as the most mature current vertical.
        Availability and production readiness are verified per feature; other business configurations remain previews
        unless a canonical page explicitly states otherwise.
      </p>
      <div class="technology-build-first-flow" aria-label="Current Hermes Connect public path">
        <p>Current public path · Web-first</p>
        <div>
          {firstFlow.map((step, index) => (
            <span>{step}{index < firstFlow.length - 1 && <i aria-hidden="true">→</i>}</span>
          ))}
        </div>
        <small>Availability, integrations, and live external actions are verified separately.</small>
      </div>
      <a href="/services/hermes-connect/">Explore the Hermes Connect product family <ArrowRight size={17} aria-hidden="true" /></a>
      <small>Repair Shops being the most mature current vertical does not imply every module, integration, booking, payment, calendar, or AI action is universally live.</small>
    </div>

    <div class="technology-build-track" data-reveal style="--reveal-delay: 100ms">
      <div class="technology-build-track-head">
        <span><Braces size={17} aria-hidden="true" />Current product track</span>
        <strong>Updated as work becomes verifiable</strong>
      </div>
      <ol>
        {stages.map((stage) => (
          <li data-state={stage.state}>
            <span>{stage.number}</span>
            <div>
              <strong>{stage.label}</strong>
              <small>{stage.status}</small>
            </div>
            {stage.state === "done" ? <Check size={17} aria-hidden="true" /> : <i aria-hidden="true"></i>}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
