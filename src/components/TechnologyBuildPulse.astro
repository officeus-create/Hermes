---
import { ArrowRight, Braces, Check } from "@lucide/astro";

const stages = [
  { number: "01", label: "Product architecture", status: "Defined", state: "done" },
  { number: "02", label: "Repair Shops owner workflow", status: "Implemented", state: "done" },
  { number: "03", label: "Repair Shops live pilot", status: "Current", state: "active" },
  { number: "04", label: "Next vertical validation", status: "Next", state: "next" },
];

const firstFlow = ["Owner account", "Shop profile & services", "Availability & public booking", "Bookings & customer CRM"];

const productFlow = [
  {
    number: "01",
    eyebrow: "Public entry",
    title: "Website / project brief",
    status: "PUBLIC",
    state: "public",
    body: "Semantic pages and a reviewed project brief collect the operating context before any system build begins.",
    href: "#project-brief",
  },
  {
    number: "02",
    eyebrow: "Current product",
    title: "Hermes Connect · Repair Shops",
    status: "LIVE PILOT",
    state: "live",
    body: "The owner workspace connects profile, services, availability, booking, customers, and controlled feedback.",
    href: "/services/hermes-connect/repair-shops/",
  },
  {
    number: "03",
    eyebrow: "Private build workflow",
    title: "Website Factory",
    status: "PRIVATE",
    state: "private",
    body: "Owner-scoped sources and a structured brief become a reviewable website build workflow while private data stays noindex.",
    href: "/services/hermes-connect/website-factory/",
  },
  {
    number: "04",
    eyebrow: "Release control",
    title: "QA → deploy → readback",
    status: "VERIFIED PROCESS",
    state: "verified",
    body: "Tests, owner approval, deployment, and production readback stay separate so code is never presented as live by assumption.",
    href: "/case/it-development/",
  },
];
import "../styles/features/technology.css";
import "../styles/hermes-technology-public.css";
import "../styles/hermes-technology-surface-ownership.css";
---

<section class="technology-build-pulse" id="build-progress" aria-labelledby="technology-build-title">
  <div class="shell technology-build-pulse-layout">
    <div class="technology-build-pulse-copy" data-reveal>
      <p class="eyebrow">Digital Systems · Verified build progress</p>
      <div class="technology-build-status">
        <span aria-hidden="true"></span>
        Hermes Connect · Repair Shops live pilot
      </div>
      <h2 id="technology-build-title">The first Hermes Connect vertical is live and expanding through verified work.</h2>
      <p>
        Repair Shops is the current live Hermes Connect pilot. Its authenticated owner workspace now connects the shared
        Hermes identity with shop profile, services, availability, public booking, bookings, customers, and controlled
        product feedback. Other Hermes Connect modules remain reference or validation capabilities until they are
        separately verified for production use.
      </p>
      <div class="technology-build-first-flow" role="group" aria-label="Current Hermes Connect Repair Shops flow">
        <p>Current live flow · Mobile-first PWA</p>
        <div>
          {firstFlow.map((step, index) => (
            <span>{step}{index < firstFlow.length - 1 && <i aria-hidden="true">→</i>}</span>
          ))}
        </div>
        <small>Current live scope · Repair Shops Web V1 · authenticated owner workspace and persisted operating data</small>
      </div>
      <a href="/services/hermes-connect/">Open the Hermes Connect product hub <ArrowRight size={17} aria-hidden="true" /></a>
      <small>Repair Shops is the current live pilot. Other verticals and modules are not presented as live until separately verified.</small>
    </div>

    <div class="technology-build-track" data-reveal style="--reveal-delay: 100ms">
      <div class="technology-build-track-head">
        <span><Braces size={17} aria-hidden="true" />Current build track</span>
        <strong>Updated as work becomes verifiable</strong>
      </div>
      <ol>
        {stages.map((stage) => (
          <li data-state={stage.state}>
            <span>{stage.number}</span>
            <div>
              <strong>{stage.label}</strong>
              <small>{stage.status}</small>
            </div>
            {stage.state === "done" ? <Check size={17} aria-hidden="true" /> : <i aria-hidden="true"></i>}
          </li>
        ))}
      </ol>

      <div
        class="technology-system-choreography"
        data-technology-system-choreography
        data-motion-state="idle"
        role="group" aria-label="Hermes Technology product proof flow"
      >
        <div class="technology-system-choreography-head">
          <span>REAL PRODUCT FLOW</span>
          <strong>Public → product → private build → verified release</strong>
        </div>
        <ol class="technology-system-flow">
          {productFlow.map((item, index) => (
            <li data-system-node data-system-state={item.state} data-active={String(index === 0)}>
              <span class="technology-system-index">{item.number}</span>
              <div>
                <small>{item.eyebrow}</small>
                <strong>{item.title}</strong>
                <p>{item.body}</p>
                <a href={item.href}>{item.status}<ArrowRight size={14} aria-hidden="true" /></a>
              </div>
            </li>
          ))}
        </ol>
        <p class="technology-system-boundary">
          Product truth only: live, private, preview, and release states remain explicitly separated.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const choreographyRoots = document.querySelectorAll<HTMLElement>("[data-technology-system-choreography]");

  choreographyRoots.forEach((root) => {
    const nodes = [...root.querySelectorAll<HTMLElement>("[data-system-node]")];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let visible = false;
    let activeIndex = 0;
    let timer: number | undefined;

    const clearTimer = () => {
      if (timer !== undefined) window.clearTimeout(timer);
      timer = undefined;
    };

    const setActive = (index: number) => {
      nodes.forEach((node, nodeIndex) => {
        node.dataset.active = String(nodeIndex === index);
      });
    };

    const pause = (state = "paused") => {
      clearTimer();
      root.dataset.motionState = state;
    };

    const schedule = () => {
      clearTimer();
      if (!visible || reducedMotion.matches || document.hidden || nodes.length === 0) return;
      root.dataset.motionState = "running";
      setActive(activeIndex);

      const reachedEnd = activeIndex === nodes.length - 1;
      activeIndex = reachedEnd ? 0 : activeIndex + 1;
      timer = window.setTimeout(schedule, reachedEnd ? 6500 : 1700);
    };

    const syncMotionPreference = () => {
      if (reducedMotion.matches) {
        setActive(0);
        pause("reduced");
        return;
      }
      if (visible && !document.hidden) schedule();
      else pause();
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
        if (visible) syncMotionPreference();
        else pause();
      },
      { threshold: 0.25 },
    );

    observer.observe(root);
    reducedMotion.addEventListener("change", syncMotionPreference);
    document.addEventListener("visibilitychange", syncMotionPreference);
  });
</script>
