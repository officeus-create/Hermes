---
import { ArrowRight, Braces, Check } from "@lucide/astro";

const stages = [
  { number: "01", label: "Product architecture", status: "Defined", state: "done" },
  { number: "02", label: "Prototype brief", status: "Activated", state: "active" },
  { number: "03", label: "Specialist booking flow", status: "Next", state: "next" },
  { number: "04", label: "Pilot preview", status: "Planned", state: "planned" },
];

const firstFlow = ["Specialist profile", "Service & availability", "Personal booking link", "Test booking"];
---

<section class="technology-build-pulse" id="build-progress" aria-labelledby="technology-build-title">
  <div class="shell technology-build-pulse-layout">
    <div class="technology-build-pulse-copy" data-reveal>
      <p class="eyebrow">Inside Hermes IT · Build progress</p>
      <div class="technology-build-status">
        <span aria-hidden="true"></span>
        Hermes Connect · Prototype work started
      </div>
      <h2 id="technology-build-title">A new product is moving from concept into its first working foundation.</h2>
      <p>
        Hermes Connect is being shaped as an operating workspace for appointments, clients, services, teams, and
        controlled AI assistance. The product architecture is defined and a separate prototype workspace is now open.
      </p>
      <div class="technology-build-first-flow" aria-label="First Hermes Connect prototype flow">
        <p>First prototype target · Mobile-first PWA</p>
        <div>
          {firstFlow.map((step, index) => (
            <span>{step}{index < firstFlow.length - 1 && <i aria-hidden="true">→</i>}</span>
          ))}
        </div>
        <small>Defined prototype scope · Simulated data and test booking only</small>
      </div>
      <a href="/#product-portfolio">See the Hermes product portfolio <ArrowRight size={17} aria-hidden="true" /></a>
      <small>No public Hermes Connect app, account, booking, payment, calendar, or integration is live yet.</small>
    </div>

    <div class="technology-build-track" data-reveal style="--reveal-delay: 100ms">
      <div class="technology-build-track-head">
        <span><Braces size={17} aria-hidden="true" />Current build track</span>
        <strong>Updated as work becomes verifiable</strong>
      </div>
      <ol>
        {stages.map((stage) => (
          <li data-state={stage.state}>
            <span>{stage.number}</span>
            <div>
              <strong>{stage.label}</strong>
              <small>{stage.status}</small>
            </div>
            {stage.state === "done" ? <Check size={17} aria-hidden="true" /> : <i aria-hidden="true"></i>}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
