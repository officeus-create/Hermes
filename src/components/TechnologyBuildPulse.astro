---
import { ArrowRight, Braces, Check } from "@lucide/astro";

const stages = [
  { number: "01", label: "Product architecture", status: "Defined", state: "done" },
  { number: "02", label: "Repair Shops owner workflow", status: "Implemented", state: "done" },
  { number: "03", label: "Repair Shops live pilot", status: "Current", state: "active" },
  { number: "04", label: "Next vertical validation", status: "Next", state: "next" },
];

const firstFlow = ["Owner account", "Shop profile & services", "Availability & public booking", "Bookings & customer CRM"];
import "../styles/features/technology.css";
import "../styles/hermes-technology-public.css";
import "../styles/hermes-technology-surface-ownership.css";
---

<section class="technology-build-pulse" id="build-progress" aria-labelledby="technology-build-title">
  <div class="shell technology-build-pulse-layout">
    <div class="technology-build-pulse-copy" data-reveal>
      <p class="eyebrow">Inside Hermes IT · Build progress</p>
      <div class="technology-build-status">
        <span aria-hidden="true"></span>
        Hermes Connect · Repair Shops live pilot
      </div>
      <h2 id="technology-build-title">The first Hermes Connect vertical is live and expanding through verified work.</h2>
      <p>
        Repair Shops is the current live Hermes Connect pilot. Its authenticated owner workspace now connects the shared
        Hermes identity with shop profile, services, availability, public booking, bookings, customers, and controlled
        product feedback. Other Hermes Connect modules remain reference or validation capabilities until they are
        separately verified for production use.
      </p>
      <div class="technology-build-first-flow" aria-label="Current Hermes Connect Repair Shops flow">
        <p>Current live flow · Mobile-first PWA</p>
        <div>
          {firstFlow.map((step, index) => (
            <span>{step}{index < firstFlow.length - 1 && <i aria-hidden="true">→</i>}</span>
          ))}
        </div>
        <small>Current live scope · Repair Shops Web V1 · authenticated owner workspace and persisted operating data</small>
      </div>
      <a href="/services/hermes-connect/">Open the Hermes Connect product hub <ArrowRight size={17} aria-hidden="true" /></a>
      <small>Repair Shops is the current live pilot. Other verticals and modules are not presented as live until separately verified.</small>
    </div>

    <div class="technology-build-track" data-reveal style="--reveal-delay: 100ms">
      <div class="technology-build-track-head">
        <span><Braces size={17} aria-hidden="true" />Current build track</span>
        <strong>Updated as work becomes verifiable</strong>
      </div>
      <ol>
        {stages.map((stage) => (
          <li data-state={stage.state}>
            <span>{stage.number}</span>
            <div>
              <strong>{stage.label}</strong>
              <small>{stage.status}</small>
            </div>
            {stage.state === "done" ? <Check size={17} aria-hidden="true" /> : <i aria-hidden="true"></i>}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
