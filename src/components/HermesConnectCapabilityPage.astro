---
import { ArrowRight, CheckCircle2, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Capability {
  title: string;
  body: string;
}

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  name: string;
  pageTitle: string;
  description: string;
  canonicalUrl: string;
  lead: string;
  capabilities: Capability[];
  boundary: string;
  faqs: Faq[];
}

const {
  name,
  pageTitle,
  description,
  canonicalUrl,
  lead,
  capabilities,
  boundary,
  faqs,
} = Astro.props;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: `Hermes Connect ${name}`,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: canonicalUrl,
    description: `${description} This page documents a Hermes Connect reference capability and does not assert current availability.`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
      { "@type": "ListItem", position: 3, name, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout title={pageTitle} description={description} schema={schema}>
  <SiteHeader theme="light" />

  <main id="main-content" class="hc-capability-page" data-hc-capability-page data-hc-live-status="reference">
    <div class="hc-capability-shell">
      <nav class="hc-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/services/hermes-connect/">Hermes Connect</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{name}</span>
      </nav>

      <header class="hc-capability-hero">
        <div class="hc-reference-badge">Reference capability · availability not asserted</div>
        <h1>{name}</h1>
        <p>{lead}</p>
        <div class="hc-capability-actions">
          <a class="hc-primary-action" href="/services/hermes-connect/repair-shops/">
            Open Repair Shops <ArrowRight size={17} aria-hidden="true" />
          </a>
          <a class="hc-secondary-action" href="/services/hermes-connect/">Back to Product Hub</a>
        </div>
      </header>

      <section class="hc-capability-section" aria-labelledby="capability-title">
        <div class="hc-section-heading">
          <p>Product family reference</p>
          <h2 id="capability-title">What this capability is designed to cover</h2>
        </div>
        <div class="hc-capability-grid">
          {capabilities.map((capability) => (
            <article>
              <CheckCircle2 size={22} aria-hidden="true" />
              <h3>{capability.title}</h3>
              <p>{capability.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="hc-boundary" aria-label="Current availability boundary">
        <ShieldCheck size={22} aria-hidden="true" />
        <div>
          <strong>Current product boundary</strong>
          <p>{boundary}</p>
        </div>
      </section>

      <section class="hc-capability-section hc-faq" aria-labelledby="faq-title">
        <div class="hc-section-heading">
          <p>Clarity before access</p>
          <h2 id="faq-title">Frequently asked questions</h2>
        </div>
        <div class="hc-faq-grid">
          {faqs.map((faq) => (
            <article>
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </article>
          ))}
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hc-capability-page{
    min-height:70vh;
    padding:clamp(7.5rem,10vw,9rem) 1rem 5.5rem;
    color:#0b0d12;
    background:
      radial-gradient(circle at 82% 5%,rgba(124,92,255,.08),transparent 27rem),
      radial-gradient(circle at 18% 15%,rgba(90,200,250,.06),transparent 24rem),
      #f7f6f3;
  }
  .hc-capability-shell{width:min(1120px,100%);margin:0 auto}
  .hc-breadcrumb{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap;margin-bottom:clamp(2rem,4vw,3.25rem);font-size:.78rem;color:#8a8f99}
  .hc-breadcrumb a{color:#5c6270;text-decoration:none}.hc-breadcrumb a:hover{color:#0b0d12}
  .hc-capability-hero{text-align:center;max-width:900px;margin:0 auto clamp(4rem,7vw,6rem)}
  .hc-reference-badge{display:inline-flex;align-items:center;padding:.42rem .72rem;border:1px solid rgba(171,122,0,.18);border-radius:999px;background:rgba(251,191,36,.09);color:#8c6500;font-size:.69rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase}
  .hc-capability-hero h1{margin:1.25rem 0 1rem;font-size:clamp(2.8rem,6.5vw,5.6rem);line-height:.95;letter-spacing:-.06em;text-wrap:balance}
  .hc-capability-hero>p{max-width:760px;margin:0 auto;color:#646b78;font-size:clamp(1.02rem,1.8vw,1.2rem);line-height:1.68}
  .hc-capability-actions{display:flex;justify-content:center;gap:.7rem;flex-wrap:wrap;margin-top:1.8rem}
  .hc-primary-action,.hc-secondary-action{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:48px;padding:.75rem 1.05rem;border-radius:999px;text-decoration:none;font-size:.86rem;font-weight:760;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease,background-color .18s ease}
  .hc-primary-action{background:#0b0d12;color:#fff;box-shadow:0 12px 28px rgba(11,13,18,.12)}
  .hc-secondary-action{border:1px solid rgba(11,13,18,.12);background:rgba(255,255,255,.66);color:#0b0d12}
  .hc-primary-action:hover,.hc-secondary-action:hover{transform:translateY(-1px)}
  .hc-capability-section{margin:0 0 clamp(3.5rem,6vw,5rem)}
  .hc-section-heading{max-width:740px;margin-bottom:1.55rem}.hc-section-heading>p{margin:0 0 .5rem;color:#6956d6;font-size:.7rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.hc-section-heading h2{margin:0;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.02;letter-spacing:-.045em;text-wrap:balance}
  .hc-capability-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .hc-capability-grid article,.hc-faq-grid article{border:1px solid rgba(11,13,18,.09);border-radius:22px;background:rgba(255,255,255,.76);box-shadow:0 18px 50px rgba(42,32,90,.055);backdrop-filter:blur(14px)}
  .hc-capability-grid article{min-height:205px;padding:1.45rem;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}
  .hc-capability-grid article:hover{transform:translateY(-2px);border-color:rgba(124,92,255,.2);box-shadow:0 24px 60px rgba(42,32,90,.08)}
  .hc-capability-grid svg{width:40px;height:40px;padding:9px;border:1px solid rgba(124,92,255,.13);border-radius:12px;background:rgba(124,92,255,.07);color:#715de7;box-sizing:border-box}
  .hc-capability-grid h3{margin:.95rem 0 .5rem;font-size:1.06rem;letter-spacing:-.015em}.hc-capability-grid p,.hc-faq-grid p{margin:0;color:#68707d;line-height:1.62;font-size:.9rem}
  .hc-boundary{display:flex;gap:.9rem;align-items:flex-start;margin:clamp(3rem,5vw,4.5rem) 0;padding:1.15rem 1.2rem;border:1px solid rgba(171,122,0,.16);border-radius:18px;background:rgba(251,191,36,.075);color:#0b0d12}.hc-boundary svg{flex:0 0 auto;color:#a97800}.hc-boundary strong{display:block;margin-bottom:.28rem}.hc-boundary p{margin:0;color:#75662e;line-height:1.55;font-size:.88rem}
  .hc-faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.hc-faq-grid article{padding:1.3rem 1.35rem}.hc-faq-grid h3{margin:0 0 .5rem;font-size:1rem;line-height:1.3}
  @media(max-width:760px){.hc-capability-page{padding:6.25rem .75rem 4rem}.hc-capability-grid,.hc-faq-grid{grid-template-columns:1fr}.hc-capability-grid article{min-height:0}.hc-capability-actions{flex-direction:column}.hc-primary-action,.hc-secondary-action{width:100%}.hc-boundary{padding:1rem}.hc-capability-hero{text-align:left;margin-bottom:4rem}.hc-capability-actions{align-items:stretch}.hc-reference-badge{line-height:1.35}.hc-capability-hero>p{margin-left:0}}
  @media(prefers-reduced-motion:reduce){.hc-primary-action,.hc-secondary-action,.hc-capability-grid article{transition:none}}
</style>