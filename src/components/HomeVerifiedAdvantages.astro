---
import { ArrowUpRight, Check } from "@lucide/astro";

type Advantage = {
  id: string;
  eyebrow: string;
  title: string;
  summary: string;
  points: string[];
  href: string;
  cta: string;
};

const advantages: Advantage[] = [
  {
    id: "logistics",
    eyebrow: "Hermes Logistics",
    title: "Carrier control stays at the center.",
    summary:
      "Dispatch and back-office support are organized around the carrier’s equipment, lanes, documents, and approval rules—not a one-size-fits-all load list.",
    points: [
      "Carrier approval and clear communication",
      "Dispatch, documents, invoicing, and follow-through",
      "Support for multiple equipment types and operating needs",
    ],
    href: "/paths/logistics/",
    cta: "Review logistics support",
  },
  {
    id: "marketing",
    eyebrow: "ProgressoPro",
    title: "Marketing connects to the sales workflow.",
    summary:
      "Positioning, website conversion, SEO, social media, lead qualification, CRM handoff, and follow-up are treated as one growth system.",
    points: [
      "Start with the business objective and bottleneck",
      "Connect content and traffic to a measurable next step",
      "Improve the system using actual results",
    ],
    href: "/paths/marketing/",
    cta: "Find the growth bottleneck",
  },
  {
    id: "academy",
    eyebrow: "Hermes Business Academy",
    title: "Learning is tied to practical responsibility.",
    summary:
      "Academy structure · 2 programs. The paid cohort and free practice are separate models, so visitors can understand the participation model before they apply.",
    points: [
      "U.S. Logistics Operations",
      "Marketing for U.S. and international service businesses",
      "Separate paid cohort and free practice models",
    ],
    href: "/paths/academy/",
    cta: "Explore practical training",
  },
  {
    id: "technology",
    eyebrow: "Hermes IT Development",
    title: "Technology begins with the operating problem.",
    summary:
      "Websites, CRM, automation, dashboards, and AI-assisted workflows are scoped around a defined business process and a useful first release.",
    points: [
      "Connect existing tools instead of adding more fragmentation",
      "Keep human review for important decisions",
      "Start with one measurable workflow and expand carefully",
    ],
    href: "/paths/technology/",
    cta: "Discuss a digital system",
  },
];
---

<section class="section advantage-section" aria-labelledby="verified-advantages-title">
  <div class="shell">
    <div class="section-heading advantage-heading" data-reveal>
      <p class="eyebrow">How Hermes works across four specialist teams</p>
      <h2 id="verified-advantages-title">Different expertise. The same operating discipline.</h2>
      <p>
        Each team solves a different business problem. What stays consistent is ownership, a defined next step, and work
        connected to the operating result instead of activity for its own sake.
      </p>
    </div>

    <div class="advantage-grid" data-reveal>
      {advantages.map((advantage) => (
        <article class="advantage-card" data-advantage={advantage.id}>
          <p class="advantage-eyebrow">{advantage.eyebrow}</p>
          <h3>{advantage.title}</h3>
          <p class="advantage-summary">{advantage.summary}</p>
          <ul>
            {advantage.points.map((point) => (
              <li>
                <Check size={17} stroke-width={1.9} aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
          <a href={advantage.href} aria-label={`${advantage.cta}: ${advantage.eyebrow}`}>
            {advantage.cta}
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .advantage-section {
    color: var(--hermes-ink);
    background: var(--hermes-paper);
  }

  .advantage-heading {
    max-width: 58rem;
  }

  .advantage-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(2.2rem, 4vw, 3.8rem);
    border-top: 1px solid var(--hermes-line-light);
  }

  .advantage-card {
    position: relative;
    min-width: 0;
    padding: clamp(1.7rem, 3.2vw, 2.7rem) clamp(1rem, 3vw, 2.6rem) clamp(1.9rem, 3.5vw, 3rem) 0;
    border-bottom: 1px solid var(--hermes-line-light);
    background: transparent;
  }

  .advantage-card:nth-child(even) {
    padding-right: 0;
    padding-left: clamp(1rem, 3vw, 2.6rem);
    border-left: 1px solid var(--hermes-line-light);
  }

  .advantage-eyebrow {
    margin: 0 0 0.8rem;
    color: var(--hermes-violet);
    font: 750 0.72rem/1.25 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .advantage-card h3 {
    max-width: 28rem;
    margin: 0;
    color: var(--hermes-ink);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .advantage-summary {
    max-width: 38rem;
    margin: 1rem 0 0;
    color: var(--hermes-muted);
    line-height: var(--hermes-copy-leading);
  }

  .advantage-card ul {
    display: grid;
    gap: 0.7rem;
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .advantage-card li {
    display: grid;
    grid-template-columns: 1.2rem 1fr;
    gap: 0.6rem;
    align-items: start;
    color: var(--hermes-graphite);
  }

  .advantage-card li :global(svg) {
    margin-top: 0.16rem;
    color: var(--hermes-violet);
  }

  .advantage-card a {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    margin-top: 1.45rem;
    color: var(--hermes-ink);
    font-weight: 720;
    text-decoration: none;
  }

  .advantage-card a :global(svg) {
    color: var(--hermes-violet);
    transition: transform var(--hermes-motion-fast) var(--hermes-ease);
  }

  .advantage-card a:hover,
  .advantage-card a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .advantage-card a:hover :global(svg),
  .advantage-card a:focus-visible :global(svg) {
    transform: translate(0.15rem, -0.15rem);
  }

  @media (max-width: 760px) {
    .advantage-grid {
      grid-template-columns: 1fr;
    }

    .advantage-card,
    .advantage-card:nth-child(even) {
      padding-right: 0;
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .advantage-card a :global(svg) {
      transition: none;
    }
  }
</style>
