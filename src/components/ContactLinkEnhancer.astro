<div
  class="contact-link-status"
  role="status"
  aria-live="polite"
  aria-atomic="true"
  data-contact-link-status
  hidden
></div>

<script>
  const status = document.querySelector<HTMLElement>("[data-contact-link-status]");
  let statusTimer = 0;

  const showStatus = (message: string) => {
    if (!status) return;
    window.clearTimeout(statusTimer);
    status.textContent = message;
    status.hidden = false;
    statusTimer = window.setTimeout(() => {
      status.hidden = true;
      status.textContent = "";
    }, 4200);
  };

  const copyPhoneNumber = async (text: string) => {
    if (!navigator.clipboard?.writeText || !window.isSecureContext) return false;
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  };

  const isLikelyMobileDevice = () => {
    const navigatorWithUAData = navigator as Navigator & { userAgentData?: { mobile?: boolean } };
    return (
      navigatorWithUAData.userAgentData?.mobile === true ||
      /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent) ||
      (navigator.maxTouchPoints > 1 && window.matchMedia("(max-width: 1024px)").matches)
    );
  };

  const pushAnalyticsEvent = (payload: Record<string, string>) => {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(payload);
  };

  const classifyPageCluster = (path: string) => {
    if (path.includes("-wi-vehicle-transport") || path.includes("/logistics/wisconsin-")) return "wisconsin_local_seo";
    if (path.startsWith("/logistics/")) return "logistics_service";
    if (path.startsWith("/paths/logistics/")) return "logistics_path";
    if (path.startsWith("/services/")) return "digital_service";
    return "other";
  };

  const classifyServiceGroup = (path: string) => {
    if (path === "/logistics/car-hauling-dispatch/") return "car_hauling_dispatch";
    if (path === "/services/website-development/") return "website_development";
    if (path === "/services/website-redesign/") return "website_redesign";
    if (path === "/services/seo/") return "seo_services";
    if (path === "/services/seo-for-logistics-companies/") return "logistics_seo";
    if (path === "/services/seo-for-independent-auto-dealers/") return "auto_dealer_seo";
    return "other";
  };

  const applyApprovedLoadBoardPrefill = () => {
    if (window.location.pathname !== "/load-board/") return;
    const requestedEquipment = new URLSearchParams(window.location.search).get("equipment");
    const approvedEquipmentPrefills = new Set(["car_hauler"]);
    if (!requestedEquipment || !approvedEquipmentPrefills.has(requestedEquipment)) return;

    const equipmentSelect = document.querySelector<HTMLSelectElement>('select[name="equipment_class"]');
    if (!equipmentSelect || ![...equipmentSelect.options].some((option) => option.value === requestedEquipment)) return;
    equipmentSelect.value = requestedEquipment;
    equipmentSelect.dispatchEvent(new Event("input", { bubbles: true }));
  };

  const applyApprovedTechnologyProjectPrefill = () => {
    if (window.location.pathname !== "/paths/technology/") return;
    const requestedProject = new URLSearchParams(window.location.search).get("project");
    const approvedProjectPrefills = new Map([
      ["website_development", "Custom Website Development with SEO Foundation"],
    ]);
    const projectValue = requestedProject ? approvedProjectPrefills.get(requestedProject) : undefined;
    if (!projectValue) return;

    const projectField = document.querySelector<HTMLTextAreaElement>('textarea[name="project_1"]');
    if (!projectField || projectField.value.trim()) return;
    projectField.value = projectValue;
    projectField.dispatchEvent(new Event("input", { bubbles: true }));
  };

  const setupCarrierFunnelAnalytics = () => {
    const carrierForm = document.querySelector<HTMLFormElement>("[data-vehicle-form]");
    const carrierResult = document.querySelector<HTMLElement>("[data-vehicle-result]");
    const carrierDecision = document.querySelector<HTMLElement>("[data-vehicle-decision]");
    if (!carrierForm || !carrierResult || !carrierDecision) return;

    let intakeStarted = false;
    let previewReady = false;
    let handoffReady = false;
    const eventBase = {
      intake_type: "carrier",
      page_group: "load_board",
      page_path: window.location.pathname,
    };
    const readPreviewStatus = () => {
      const normalized = carrierDecision.textContent
        ?.trim()
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "_")
        .replace(/^_+|_+$/g, "");
      return normalized || "prepared";
    };

    const trackIntakeStart = () => {
      if (intakeStarted) return;
      intakeStarted = true;
      pushAnalyticsEvent({ event: "carrier_intake_start", ...eventBase });
    };

    carrierForm.addEventListener("input", trackIntakeStart);
    carrierForm.addEventListener("change", trackIntakeStart);
    carrierForm.addEventListener("submit", () => {
      window.requestAnimationFrame(() => {
        if (previewReady || carrierResult.hidden) return;
        previewReady = true;
        pushAnalyticsEvent({
          event: "carrier_intake_preview_ready",
          ...eventBase,
          preview_status: readPreviewStatus(),
        });
      });
    });

    document.addEventListener("click", (event) => {
      if (handoffReady || !previewReady) return;
      const source = event.target;
      if (!(source instanceof Element)) return;
      const handoff = source.closest("[data-vehicle-email], [data-send-vehicle-lead]");
      if (!(handoff instanceof HTMLElement)) return;

      handoffReady = true;
      pushAnalyticsEvent({
        event: "carrier_handoff_ready",
        ...eventBase,
        handoff_method: handoff.hasAttribute("data-send-vehicle-lead") ? "secure_delivery" : "email",
        preview_status: readPreviewStatus(),
      });
    });
  };

  const setupWebsiteProjectFunnelAnalytics = () => {
    const requestedProject = new URLSearchParams(window.location.search).get("project");
    if (window.location.pathname !== "/paths/technology/" || requestedProject !== "website_development") return;

    const briefRoot = document.querySelector<HTMLElement>("[data-it-project-brief]");
    const briefForm = briefRoot?.querySelector<HTMLFormElement>("[data-brief-form]");
    const reviewPanel = briefRoot?.querySelector<HTMLElement>('[data-brief-step="4"]');
    if (!briefRoot || !briefForm || !reviewPanel) return;

    let intakeStarted = false;
    let previewReady = false;
    let handoffReady = false;
    const eventBase = {
      intake_type: "website_project",
      page_group: "technology_project_brief",
      page_path: window.location.pathname,
    };

    const trackIntakeStart = () => {
      if (intakeStarted) return;
      intakeStarted = true;
      pushAnalyticsEvent({ event: "website_project_intake_start", ...eventBase });
    };

    briefForm.addEventListener("input", trackIntakeStart);
    briefForm.addEventListener("change", trackIntakeStart);
    briefRoot.addEventListener("click", (event) => {
      const source = event.target;
      if (!(source instanceof Element)) return;

      if (source.closest("[data-brief-next]")) {
        window.requestAnimationFrame(() => {
          if (previewReady || reviewPanel.hidden) return;
          previewReady = true;
          pushAnalyticsEvent({
            event: "website_project_preview_ready",
            ...eventBase,
            preview_status: "prepared",
          });
        });
      }

      if (handoffReady || !previewReady || !source.closest("[data-brief-email]")) return;
      handoffReady = true;
      pushAnalyticsEvent({
        event: "marketing_handoff_ready",
        ...eventBase,
        handoff_method: "email",
        preview_status: "prepared",
      });
    });
  };

  applyApprovedLoadBoardPrefill();
  applyApprovedTechnologyProjectPrefill();
  setupCarrierFunnelAnalytics();
  setupWebsiteProjectFunnelAnalytics();

  const trackLoadBoardClick = (link: HTMLAnchorElement) => {
    const href = link.getAttribute("href") || "";
    let target: URL;
    try {
      target = new URL(href, window.location.origin);
    } catch {
      return;
    }
    if (target.origin !== window.location.origin || target.pathname !== "/load-board/") return;

    const role = target.searchParams.get("role") || "unspecified";
    const legacyCtaType = role === "carrier"
      ? "carrier_capacity"
      : role === "dealer"
        ? "dealer_transport_request"
        : role === "shipper"
          ? "shipper_transport_request"
          : role === "private_party"
            ? "private_transport_request"
            : "load_board_entry";

    pushAnalyticsEvent({
      event: "logistics_cta_click",
      cta_type: legacyCtaType,
      audience_role: role,
      page_cluster: classifyPageCluster(window.location.pathname),
      page_path: window.location.pathname,
      destination_path: target.pathname,
    });

    if (!link.hasAttribute("data-commercial-primary-cta")) return;
    pushAnalyticsEvent({
      event: "commercial_cta_click",
      cta_type: role === "carrier" ? "carrier_intake" : legacyCtaType,
      audience_type: role,
      page_group: classifyPageCluster(window.location.pathname),
      service_group: classifyServiceGroup(window.location.pathname),
      page_path: window.location.pathname,
      destination_path: target.pathname,
    });
  };

  const trackWebsiteProjectClick = (link: HTMLAnchorElement) => {
    if (!link.hasAttribute("data-website-project-cta")) return;
    const href = link.getAttribute("href") || "";
    let target: URL;
    try {
      target = new URL(href, window.location.origin);
    } catch {
      return;
    }
    if (
      target.origin !== window.location.origin ||
      target.pathname !== "/paths/technology/" ||
      target.searchParams.get("project") !== "website_development"
    ) return;

    pushAnalyticsEvent({
      event: "commercial_cta_click",
      cta_type: "website_project_intake",
      audience_type: "business",
      page_group: "digital_service",
      service_group: "website_development",
      page_path: window.location.pathname,
      destination_path: target.pathname,
    });
  };

  document.addEventListener("click", async (event) => {
    const source = event.target;
    if (!(source instanceof Element)) return;

    const anyLink = source.closest("a[href]");
    if (anyLink instanceof HTMLAnchorElement) {
      trackLoadBoardClick(anyLink);
      trackWebsiteProjectClick(anyLink);
    }

    const link = source.closest("a[href^='tel:'], a[href^='mailto:']");
    if (!(link instanceof HTMLAnchorElement)) return;

    const href = link.getAttribute("href") || "";
    const isPhone = href.startsWith("tel:");

    pushAnalyticsEvent({
      event: "contact_click",
      contact_method: isPhone ? "phone" : "email",
      page_cluster: classifyPageCluster(window.location.pathname),
      service_group: classifyServiceGroup(window.location.pathname),
      page_path: window.location.pathname,
    });

    if (!isPhone) return;

    const internationalNumber = href.slice(4).trim();
    const displayNumber = link.textContent?.trim() || internationalNumber;

    if (isLikelyMobileDevice()) {
      showStatus(`Opening your phone app for ${displayNumber}.`);
      return;
    }

    event.preventDefault();
    const copied = await copyPhoneNumber(internationalNumber);
    showStatus(
      copied
        ? `Phone number copied: ${displayNumber}. Open FaceTime, Skype, or your calling app to place the call.`
        : `Call Hermes Logistics at ${displayNumber}. Copy the number or configure a calling app in your browser.`,
    );
  });
</script>

<style>
  .contact-link-status {
    position: fixed;
    z-index: 1200;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    max-width: min(420px, calc(100vw - 2rem));
    padding: 0.9rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 6px;
    background: #071038;
    color: #fff;
    box-shadow: 0 18px 50px rgba(7, 16, 56, 0.28);
    font: 600 0.88rem/1.45 var(--font-body);
  }

  .contact-link-status[hidden] {
    display: none;
  }
</style>
