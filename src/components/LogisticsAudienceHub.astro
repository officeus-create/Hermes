---
import { ArrowUpRight } from "@lucide/astro";
import { logisticsAudiences } from "../data/logistics-audiences";

const training = {
  label: "Training",
  eyebrow: "Hermes Business Academy",
  summary: "Build practical logistics, sales, dispatch, and operations capability before or alongside a role.",
  href: "/paths/academy/",
};

const serviceGuides = [
  { label: "Car Hauling Dispatch", href: "/logistics/car-hauling-dispatch/" },
  { label: "Dealer Vehicle Transportation", href: "/logistics/dealer-vehicle-transportation/" },
  { label: "Auction Vehicle Pickup", href: "/logistics/auction-vehicle-pickup/" },
  { label: "Enclosed Vehicle Transport", href: "/logistics/enclosed-vehicle-transport/" },
  { label: "Open Vehicle Transport", href: "/logistics/open-vehicle-transport/" },
  { label: "Inoperable Vehicle Transport", href: "/logistics/inoperable-vehicle-transport/" },
  { label: "Multi-Car Transport", href: "/logistics/multi-car-transport/" },
  { label: "New Authority Car Hauler Support", href: "/logistics/new-authority-car-hauler-support/" },
  { label: "Owner-Operator Dispatch Support", href: "/logistics/owner-operator-dispatch-support/" },
  { label: "Fleet Owner Dispatch Support", href: "/logistics/fleet-owner-dispatch-support/" },
];
import "../styles/features/load.css";
import "../styles/features/resource.css";
---

<section class="section logistics-audience-hub" id="choose-your-path" aria-labelledby="logistics-audience-title">
  <div class="shell">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Choose your logistics path</p>
        <h2 id="logistics-audience-title">Start with who you are and what you need.</h2>
      </div>
      <p>Each path gives you relevant information and one clear next action.</p>
    </div>
    <div class="logistics-audience-grid">
      {logisticsAudiences.map((audience) => (
        <a href={`/logistics/${audience.slug}/`}>
          <span>{audience.eyebrow}</span>
          <h3>{audience.label}</h3>
          <p>{audience.summary}</p>
          <strong>Open this path <ArrowUpRight size={18} aria-hidden="true" /></strong>
        </a>
      ))}
      <a href={training.href}>
        <span>{training.eyebrow}</span>
        <h3>{training.label}</h3>
        <p>{training.summary}</p>
        <strong>Explore training <ArrowUpRight size={18} aria-hidden="true" /></strong>
      </a>
      <a class="logistics-audience-load-board" href="/load-board/?role=shipper#post-load">
        <span>Car Hauling Load Board</span>
        <h3>Post a load</h3>
        <p>Preview a vehicle transport request and see how it would be reviewed and routed.</p>
        <strong>Open Load Board <ArrowUpRight size={18} aria-hidden="true" /></strong>
      </a>
    </div>
    <aside class="logistics-local-pilot">
      <div>
        <span>USA organic service guide · Wisconsin pilot</span>
        <h3>Vehicle transport to and from Appleton.</h3>
        <p>A practical route guide for dealers, auction customers, businesses, private customers, carriers, and car haulers.</p>
      </div>
      <a class="button button-primary" href="/logistics/appleton-wi-vehicle-transport/">
        Open Appleton guide <ArrowUpRight size={18} aria-hidden="true" />
      </a>
    </aside>
    <div class="logistics-resource-library" id="logistics-resources">
      <div>
        <span>National planning resources</span>
        <h3>Prepare better information before the next transport or carrier review.</h3>
      </div>
      <nav aria-label="Hermes Logistics resources">
        <a href="/logistics/resources/">
          Carrier Knowledge Hub <ArrowUpRight size={17} aria-hidden="true" />
        </a>
        <a href="/logistics/resources/auction-vehicle-pickup-checklist/">
          Auction Vehicle Pickup Checklist <ArrowUpRight size={17} aria-hidden="true" />
        </a>
        <a href="/logistics/resources/car-hauler-capacity-checklist/">
          Car Hauler Capacity Checklist <ArrowUpRight size={17} aria-hidden="true" />
        </a>
      </nav>
    </div>
    <div class="logistics-resource-library" id="logistics-service-guides">
      <div>
        <span>Service and carrier guides</span>
        <h3>Open the guide that matches the vehicle, equipment, or operating stage.</h3>
      </div>
      <nav aria-label="Hermes Logistics service guides">
        {serviceGuides.map((guide) => (
          <a href={guide.href}>{guide.label} <ArrowUpRight size={17} aria-hidden="true" /></a>
        ))}
      </nav>
    </div>
  </div>
</section>
