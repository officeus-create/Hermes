---
import { GraduationCap, Megaphone, Mic, PackageCheck, ShieldCheck, Truck, Users, Wrench, CircleDollarSign } from "@lucide/astro";
import HermesLocalAgentsLink from "./HermesLocalAgentsLink.astro";
import HermesOwnerProjectPortfolio from "./HermesOwnerProjectPortfolio.astro";
import HermesAiArchitecture from "./HermesAiArchitecture.astro";
import HermesExecutionMap from "./HermesExecutionMap.astro";
import { HAE_OWNER_PROCESS_TEMPLATES } from "../lib/hae-process-control.mjs";
interface Props{ru?:boolean}
const {ru=false}=Astro.props;
const pillars=[
  {key:"logistics",icon:Truck,title:"Logistics",copy:ru?"Перевозчики, грузы, dispatch, документы и операционная видимость.":"Carriers, loads, dispatch, documents and operating visibility.",links:[["Logistics","/paths/logistics/"],["Load Board","/load-board/"]]},
  {key:"marketing",icon:Megaphone,title:"Marketing",copy:ru?"Сайт, SEO/GEO, social distribution и путь до квалифицированного действия.":"Website, SEO/GEO, social distribution and the path to a qualified action.",links:[["Marketing","/paths/marketing/"],["Website Development","/services/website-development/"]]},
  {key:"technology",icon:Wrench,title:"Technology",copy:ru?"Hermes Connect, сайты, CRM, интеграции, automation и AI systems.":"Hermes Connect, websites, CRM, integrations, automation and AI systems.",links:[["Hermes Connect","/services/hermes-connect/"],["AI Connect","/services/hermes-connect/internal/ai-connect/"]]},
  {key:"academy",icon:GraduationCap,title:"Academy",copy:ru?"Обучение, практика, review, прогресс и бизнес-операции академии.":"Learning, practice, review, progression and academy business operations.",links:[["Academy","/services/hermes-connect/academy/"],["Business Workspace","/services/hermes-connect/academy/business/workspace/"]]},
];
const functions=[
  {key:"sales",icon:Users,title:ru?"Продажи":"Sales",copy:ru?"Лиды, предложения, follow-up и revenue path.":"Leads, proposals, follow-up and the revenue path."},
  {key:"finance",icon:CircleDollarSign,title:ru?"Финансы":"Finance",copy:ru?"Экономика проектов и ROI.":"Project economics and ROI."},
  {key:"operations",icon:PackageCheck,title:ru?"Операции":"Operations",copy:ru?"Межкомандная очередь, процессы и координация.":"Cross-team queue, process and coordination."},
];
---
<div class="owner-workspace" data-private hidden>
  <div class="owner-toast" data-owner-toast role="status" hidden></div>
  <section class="owner-view is-active" data-cc-view="today">
    <section class="hcc-panel owner-today-focus">
      <div class="owner-section-head">
        <div><p class="hcc-sample">Live Operations</p><h2>{ru?"Что реально работает сейчас":"What is actually running now"}</h2><p>{ru?"Четыре ключевых контура. UNKNOWN и блокеры показываются явно — без декоративных зелёных статусов.":"Four critical operating loops. UNKNOWN and blockers stay explicit — no decorative green states."}</p></div>
        <button type="button" class="hcc-primary" data-new-task>+ {ru?"Новая задача":"New task"}</button>
      </div>
      <div class="owner-live-grid">
        <article class="owner-live-card">
          <div><span class="owner-live-kicker">Threads</span><strong data-live-threads-title>UNKNOWN</strong><small data-live-threads-detail>{ru?"Проверяем provider и HAE social readback…":"Checking provider and HAE social readback…"}</small></div>
          <span class="owner-live-state" data-live-threads-state>UNKNOWN</span>
          <button type="button" data-open-view="social">{ru?"Открыть Threads":"Open Threads"}</button>
        </article>
        <article class="owner-live-card">
          <div><span class="owner-live-kicker">HAE</span><strong data-live-hae-title>UNKNOWN</strong><small data-live-hae-detail>{ru?"Проверяем канонический runtime и процессы…":"Checking canonical runtime and processes…"}</small></div>
          <span class="owner-live-state" data-live-hae-state>UNKNOWN</span>
          <button type="button" data-open-view="hae">{ru?"Открыть HAE":"Open HAE"}</button>
        </article>
        <article class="owner-live-card">
          <div><span class="owner-live-kicker">{ru?"Автоматизации":"Automations"}</span><strong data-live-automation-title>UNKNOWN</strong><small data-live-automation-detail>{ru?"Проверяем активные процессы и следующий запуск…":"Checking active processes and next run…"}</small></div>
          <span class="owner-live-state" data-live-automation-state>UNKNOWN</span>
          <button type="button" data-open-view="automations">{ru?"Открыть автоматизации":"Open automations"}</button>
        </article>
        <article class="owner-live-card">
          <div><span class="owner-live-kicker">Hermes AI</span><strong data-live-ai-title>UNKNOWN</strong><small data-live-ai-detail>{ru?"Проверяем executor heartbeat и активную задачу…":"Checking executor heartbeat and active task…"}</small></div>
          <span class="owner-live-state" data-live-ai-state>UNKNOWN</span>
          <button type="button" data-open-view="agents">{ru?"Открыть Hermes AI":"Open Hermes AI"}</button>
        </article>
      </div>
    </section>

    <div class="owner-decision-grid" aria-label={ru?"Сводка владельца":"Owner summary"}>
      <article><span>{ru?"Нужно моё решение":"Needs my decision"}</span><strong data-today-decision>0</strong><small>{ru?"Результаты ждут приёмки":"Results awaiting acceptance"}</small></article>
      <article><span>{ru?"Выполняется":"Running now"}</span><strong data-today-running>0</strong><small>{ru?"AI-задачи и активные процессы":"AI tasks and active processes"}</small></article>
      <article><span>{ru?"Заблокировано":"Blocked"}</span><strong data-today-blocked>0</strong><small>{ru?"Есть причина и следующий шаг":"Reason and next step are recorded"}</small></article>
      <article><span>{ru?"Следующее":"Next"}</span><strong class="owner-next" data-today-next>—</strong><small>{ru?"Приоритетное действие владельца":"Highest-priority owner action"}</small></article>
    </div>

    <section class="hcc-panel owner-today-focus">
      <div class="owner-section-head"><div><p class="hcc-sample">{ru?"Требует внимания":"Needs attention"}</p><h2>{ru?"Что требует решения сейчас":"What needs a decision now"}</h2></div></div>
      <div class="owner-today-list" data-today-list><p class="muted">{ru?"Загружаем текущую работу…":"Loading current work…"}</p></div>
    </section>

    <section class="owner-status-row">
      <article class="hcc-card"><span>{ru?"Облако":"Cloud"}</span><strong>Cloudflare + D1</strong><small>{ru?"Очередь и CRM не зависят от Mac":"Queue and CRM do not depend on the Mac"}</small></article>
      <article class="hcc-card"><span>{ru?"Исполнитель":"Runner"}</span><strong data-runner-state>—</strong><small data-runner-copy>—</small></article>
      <article class="hcc-card"><span>{ru?"Открытые задачи":"Open tasks"}</span><strong data-backlog-count>0</strong><small>{ru?"В облачной очереди":"In the cloud queue"}</small></article>
      <article class="hcc-card"><span>{ru?"На приёмке":"Acceptance"}</span><strong data-approval-count>0</strong><small>{ru?"AI-задачи ждут решения":"AI tasks awaiting decision"}</small></article>
    </section>
  </section>

  <section class="owner-view" data-cc-view="projects" hidden>
    <HermesOwnerProjectPortfolio ru={ru}/>
    <section class="hcc-panel owner-business-map">
      <div class="owner-section-head"><div><p class="hcc-sample">{ru?"One Hermes · Four business pillars":"One Hermes · Four business pillars"}</p><h2>{ru?"Направления бизнеса":"Business pillars"}</h2><p>{ru?"Цвет обозначает направление, а не отдельный суббренд.":"Color is an orientation cue, not a separate sub-brand."}</p></div></div>
      <div class="owner-pillar-grid">
        {pillars.map((module)=>{const Icon=module.icon;return <article class="owner-pillar hcc-card" data-module={module.key} data-pillar={module.key}><div class="owner-pillar-top"><span class="owner-pillar-icon"><Icon size={20}/></span><span class="module-state">{ru?"Открыто":"Open"}</span></div><h3>{module.title}</h3><p>{module.copy}</p><div class="owner-links">{module.links.map(([label,href])=><a href={href}>{label}</a>)}</div><button type="button" class="owner-filter-button" data-focus-workstream={module.key}>{ru?"Показать задачи":"Show tasks"}</button></article>})}
      </div>
      <div class="owner-functions">
        <div><p class="hcc-sample">{ru?"Operating functions":"Operating functions"}</p><h3>{ru?"Продажи, финансы и операции":"Sales, Finance and Operations"}</h3><p>{ru?"Это функции внутри одной системы, а не дополнительные направления бренда Hermes.":"These are operating functions inside one system, not additional Hermes brand pillars."}</p></div>
        <div class="owner-function-grid">{functions.map((item)=>{const Icon=item.icon;return <button type="button" data-module={item.key} data-focus-workstream={item.key}><Icon size={18}/><span><strong>{item.title}</strong><small>{item.copy}</small></span><em class="module-state">{ru?"Открыто":"Open"}</em></button>})}</div>
      </div>
    </section>
  </section>

  <section class="owner-view" data-cc-view="tasks" hidden>
    <section class="hcc-panel owner-work-panel">
      <div class="owner-section-head"><div><p class="hcc-sample">{ru?"Облачная очередь":"Cloud work queue"}</p><h2 data-backlog-title>{ru?"Задачи владельца":"Owner work queue"}</h2><p>{ru?"Фильтруй по проекту, приоритету и состоянию. AI запускается отдельно от сохранения задачи.":"Filter by project and state. AI dispatch remains separate from task capture."}</p></div><div class="owner-head-actions"><button type="button" class="hcc-secondary" data-refresh>{ru?"Обновить":"Refresh"}</button><button type="button" class="hcc-primary" data-new-task>+ {ru?"Новая задача":"New task"}</button></div></div>
      <div class="owner-task-tools">
        <label>{ru?"Проект":"Project"}<select data-project-filter><option value="all">{ru?"Все проекты":"All projects"}</option><option value="unassigned">{ru?"Без проекта":"Unassigned"}</option></select></label>
        <label>{ru?"Поиск":"Search"}<input type="search" data-work-search placeholder={ru?"Название, описание или ID…":"Title, description or task ID…"} autocomplete="off"/></label>
      </div>
      <div class="filters" data-filters><button class="active" data-filter="open">{ru?"Открытые":"Open"}</button><button data-filter="awaiting_acceptance">{ru?"На приёмке":"Needs acceptance"}</button><button data-filter="marketing">Marketing</button><button data-filter="logistics">Logistics</button><button data-filter="sales">Sales</button><button data-filter="technology">Technology</button><button data-filter="academy">Academy</button><button data-filter="finance">Finance</button><button data-filter="operations">Operations</button><button data-filter="done">{ru?"Принято":"Accepted"}</button></div>
      <div class="work-list" data-work-list><p>{ru?"Загружаем очередь…":"Loading backlog…"}</p></div>
    </section>
  </section>

  <section class="owner-view" data-cc-view="crm" hidden>
    <section class="hcc-panel owner-account-panel">
      <div class="owner-section-head"><div><p class="hcc-sample">Hermes Connect · CRM</p><h2>{ru?"Клиентские и операционные пространства":"Customer and operating workspaces"}</h2><p>{ru?"Command Center не создаёт второй CRM. Здесь маршрутизируются только уже существующие Hermes Connect workspaces, доступные текущему аккаунту.":"Command Center does not create a second CRM. This view routes only to existing Hermes Connect workspaces already available to the current account."}</p></div><span class="owner-cloud-note">{ru?"Один аккаунт · существующие CRM":"One account · existing CRMs"}</span></div>
      <div class="workspace-grid" data-crm-workspaces><p class="muted">{ru?"Загружаем CRM-пространства…":"Loading CRM workspaces…"}</p></div>
    </section>
  </section>

  <section class="owner-view" data-cc-view="social" hidden>
    <section class="hcc-panel">
      <div class="owner-section-head"><div><p class="hcc-sample">Social Acquisition</p><h2>{ru?"Соцсети → диалоги → лиды → доказательства":"Social → conversations → leads → evidence"}</h2><p>{ru?"Read-only обзор существующего HAE/social runtime. Публикация и ответы не включаются отсюда автоматически.":"Read-only view over the existing HAE/social runtime. Publishing and replies are never activated automatically from this view."}</p></div><span class="owner-cloud-note" data-social-state>UNKNOWN</span></div>
      <div class="owner-decision-grid">
        <article><span>{ru?"Контент в очереди":"Content queue"}</span><strong data-social-content-count>UNKNOWN</strong><small>{ru?"HAE D1 · без второго publisher":"HAE D1 · no second publisher"}</small></article>
        <article><span>{ru?"Publication receipts":"Publication receipts"}</span><strong data-social-receipt-count>UNKNOWN</strong><small>{ru?"Provider ID / permalink при наличии":"Provider ID / permalink when verified"}</small></article>
        <article><span>{ru?"Threads connections":"Threads connections"}</span><strong data-social-connection-count>UNKNOWN</strong><small>{ru?"OAuth/identity state без секретов":"OAuth/identity state without secrets"}</small></article>
        <article><span>{ru?"Carrier Leads":"Carrier Leads"}</span><strong>UNKNOWN</strong><small>{ru?"Нет канонического агрегата — ноль не придумываем":"No canonical aggregate — never infer zero"}</small></article>
      </div>
      <div class="workspace-grid" data-social-connections><p class="muted">{ru?"Загружаем provider health…":"Loading provider health…"}</p></div>
      <div class="owner-evidence-list" data-social-queue><p class="muted">{ru?"Загружаем Content Queue…":"Loading Content Queue…"}</p></div>
      <div class="owner-evidence-list" data-social-receipts><p class="muted">{ru?"Загружаем publication receipts…":"Loading publication receipts…"}</p></div>
      <div class="owner-head-actions">
        <a class="hcc-secondary" href="/services/hermes-connect/internal/social-connections/">{ru?"Provider / OAuth":"Provider / OAuth"}</a>
        <a class="hcc-secondary" href="/services/hermes-connect/unified-inbox/">{ru?"Unified Inbox":"Unified Inbox"}</a>
        <a class="hcc-secondary" href="/paths/marketing/">{ru?"Marketing":"Marketing"}</a>
        <a class="hcc-secondary" href="/load-board/">{ru?"Carrier / Load Board":"Carrier / Load Board"}</a>
      </div>
      <p class="muted">{ru?"Ответы остаются DRAFT_ONLY через social.reply.prepare. Внешняя публикация требует отдельного owner/provider gate.":"Replies remain DRAFT_ONLY through social.reply.prepare. External publication requires its separate owner/provider gate."}</p>
    </section>
  </section>

  <section class="owner-view" data-cc-view="hae" hidden>
    <section class="hcc-panel process-control">
      <div class="owner-section-head">
        <div><p class="hcc-sample">Hermes Automation Engine</p><h2>{ru?"Канонический runtime HAE":"Canonical HAE runtime"}</h2><p>{ru?"Один scheduler, одна D1/Queue/Worker цепочка. Локальный AI — только исполнитель поверх HAE, не второй runtime.":"One scheduler and one D1/Queue/Worker chain. Local AI is execution capacity on top of HAE, never a second runtime."}</p></div>
        <span class="owner-cloud-note" data-hae-runtime-state>UNKNOWN</span>
      </div>
      <div class="owner-hae-runtime">
        <article><span>{ru?"Runtime owner":"Runtime owner"}</span><strong data-hae-owner>UNKNOWN</strong></article>
        <article><span>{ru?"Цикл":"Loop"}</span><strong data-hae-loop>UNKNOWN</strong></article>
        <article><span>{ru?"Активные процессы":"Active processes"}</span><strong data-hae-active>UNKNOWN</strong></article>
        <article><span>{ru?"Автоматический AI cost":"Automatic AI cost"}</span><strong data-hae-cost>UNKNOWN</strong></article>
      </div>
      <div class="owner-evidence-list" data-hae-recent><p class="muted">{ru?"Загружаем последние HAE процессы…":"Loading recent HAE processes…"}</p></div>
      <div class="owner-head-actions"><button type="button" class="hcc-secondary" data-open-view="automations">{ru?"Открыть управление процессами":"Open process controls"}</button><button type="button" class="hcc-secondary" data-open-view="executions">{ru?"Открыть executions / receipts":"Open executions / receipts"}</button></div>
    </section>
  </section>

  <section class="owner-view" data-cc-view="automations" hidden>
    <section class="hcc-panel process-control" data-process-control>
      <div class="owner-section-head"><div><p class="hcc-sample">{ru?"Автоматизация":"Automation"}</p><h2>{ru?"Процессы HAE 24/7":"HAE 24/7 processes"}</h2><p>{ru?"Проверенные процессы создаются на паузе и включаются отдельно. Внешние отправки и платный AI в этом слое отключены.":"Verified processes start paused and are activated separately. External sends and paid AI are disabled in this layer."}</p></div><span class="owner-cloud-note">D1 · Queue · $0 default</span></div>
      <form data-process-form class="process-form">
        <label>{ru?"Название":"Process name"}<input name="name" maxlength="160" placeholder={ru?"Можно оставить пустым":"Optional"}/></label>
        <label>{ru?"Что проверять":"Capability"}<select name="job_type">{HAE_OWNER_PROCESS_TEMPLATES.map((template)=><option value={template.job_type} data-cadences={template.allowed_cadence_hours.join(",")}>{ru?template.label_ru:template.label}</option>)}</select></label>
        <label>{ru?"Частота":"Cadence"}<select name="cadence_hours"><option value="1">{ru?"Каждый час":"Every hour"}</option><option value="6">{ru?"Каждые 6 часов":"Every 6 hours"}</option><option value="12">{ru?"Каждые 12 часов":"Every 12 hours"}</option><option value="24">{ru?"Каждые 24 часа":"Every 24 hours"}</option><option value="168">{ru?"Каждую неделю":"Every week"}</option></select></label>
        <button type="submit" class="primary">{ru?"Создать на паузе":"Create paused"}</button>
        <p data-process-status role="status"></p>
      </form>
      <div class="process-list" data-process-list><p class="muted">{ru?"Загружаем процессы…":"Loading processes…"}</p></div>
    </section>
  </section>

  <section class="owner-view" data-cc-view="agents" hidden>
    <div class="owner-agent-grid">
      <article class="hcc-panel owner-agent-panel">
        <div class="owner-section-head"><div><p class="hcc-sample">Hermes Intelligence</p><h2>{ru?"Среда исполнения":"Execution environment"}</h2></div><span class="module-state" data-agent-badge>—</span></div>
        <dl><div><dt>{ru?"Состояние":"Status"}</dt><dd data-agent-status>—</dd></div><div><dt>{ru?"Последняя связь":"Last heartbeat"}</dt><dd data-agent-seen>—</dd></div><div><dt>{ru?"Активная AI-задача":"Active AI task"}</dt><dd data-active-task>—</dd></div><div><dt>{ru?"Версия кода":"Repo SHA"}</dt><dd data-agent-sha>—</dd></div></dl>
        <p class="muted">{ru?"Если локальный исполнитель выключится, облачная очередь остаётся в D1. Запуск Hermes AI передаёт только одну задачу в существующую очередь.":"If the local runner goes offline, the cloud queue remains in D1. Hermes AI dispatch sends only one task into the existing queue."}</p>
        <a class="owner-text-link" href="/services/hermes-connect/internal/ai-connect/">{ru?"Открыть AI workspace →":"Open AI workspace →"}</a>
      </article>
      <article class="hcc-panel owner-agent-panel">
        <div class="owner-section-head"><div><p class="hcc-sample">{ru?"Локальные и облачные агенты":"Local & cloud agents"}</p><h2>{ru?"Исполнители и fallback":"Runners and fallback"}</h2></div></div>
        <HermesLocalAgentsLink ru={ru}/>
      </article>
    </div>
    <section class="hcc-panel" data-ai-owner-map><HermesAiArchitecture ru={ru}/></section>
  </section>

  <section class="owner-view" data-cc-view="plugins" hidden>
    <section class="hcc-panel">
      <div class="owner-section-head"><div><p class="hcc-sample">Hermes Plugin Workforce</p><h2>{ru?"Плагины и текущие версии":"Plugins and current versions"}</h2><p>{ru?"Это реестр доступных возможностей. Выбор плагина не означает, что он был выполнен: execution подтверждается только отдельным HAE receipt.":"This is the capability registry. Selecting a plugin is not execution: execution is proven only by a separate HAE receipt."}</p></div><span class="owner-cloud-note" data-plugin-registry-state>UNKNOWN</span></div>
      <div class="workspace-grid" data-plugin-registry><p class="muted">{ru?"Загружаем реестр плагинов…":"Loading plugin registry…"}</p></div>
    </section>
  </section>

  <section class="owner-view" data-cc-view="executions" hidden>
    <HermesExecutionMap ru={ru}/>
  </section>

  <section class="owner-view" data-cc-view="evidence" hidden>
    <section class="hcc-panel owner-evidence-panel">
      <div class="owner-section-head"><div><p class="hcc-sample">Evidence</p><h2>{ru?"Что реально было сделано":"What actually happened"}</h2><p>{ru?"Здесь показываются только task-linked результаты, PR и owner acceptance.":"Only task-linked results, PRs and owner acceptance appear here."}</p></div></div>
      <div class="owner-evidence-list" data-evidence-list><p class="muted">{ru?"Загружаем evidence…":"Loading evidence…"}</p></div>
    </section>
  </section>

  <section class="owner-view" data-cc-view="reports" hidden>
    <section class="hcc-panel">
      <div class="owner-section-head"><div><p class="hcc-sample">{ru?"Отчёты HAE · $0":"HAE reports · $0"}</p><h2>{ru?"Регулярные owner-отчёты":"Recurring owner reports"}</h2><p>{ru?"Результат появляется только здесь, в Command Center. Email/публикация и платный AI отключены.":"Results appear only here in Command Center. Email/publication and paid AI are disabled."}</p></div><span class="owner-cloud-note">Europe/Kyiv · D1 receipt</span></div>
      <div class="workspace-grid" data-report-schedules><p class="muted">{ru?"Загружаем расписания…":"Loading schedules…"}</p></div>
      <div class="owner-evidence-list" data-report-list><p class="muted">{ru?"Пока нет подтверждённых report receipts.":"No verified report receipts yet."}</p></div>
    </section>
  </section>

  <section class="owner-view" data-cc-view="knowledge" hidden>
    <section class="hcc-panel">
      <div class="owner-section-head"><div><p class="hcc-sample">One Brain</p><h2>{ru?"Знания, уроки и источник истины":"Knowledge, lessons and source authority"}</h2><p>{ru?"Здесь нет копии One Brain. Показывается только реестр канонических источников и состояние governance.":"This is not a copy of One Brain. It shows only the canonical source registry and governance state."}</p></div><span class="owner-cloud-note" data-knowledge-state>UNKNOWN</span></div>
      <div class="workspace-grid" data-knowledge-sources><p class="muted">{ru?"Загружаем реестр источников…":"Loading source registry…"}</p></div>
      <div class="owner-today-list" data-learning-state></div>
    </section>
  </section>

  <section class="owner-view" data-cc-view="investor" hidden>
    <section class="hcc-panel">
      <div class="owner-section-head"><div><p class="hcc-sample">{ru?"Финансы · Investor Intelligence":"Finance · Investor Intelligence"}</p><h2>{ru?"Инвесторская готовность по событию":"Event-triggered investor readiness"}</h2><p>{ru?"Нет постоянного polling и нет выдуманных финансов. Работа активируется только при новом проверенном finance/legal/owner evidence.":"No continuous polling and no invented financials. Work activates only on fresh verified finance/legal/owner evidence."}</p></div><span class="owner-cloud-note" data-investor-state>UNKNOWN</span></div>
      <div class="owner-today-list" data-investor-details><p class="muted">{ru?"Загружаем investor state…":"Loading investor state…"}</p></div>
    </section>
  </section>

  <section class="owner-view" data-cc-view="access" hidden>
    <section class="hcc-panel owner-account-panel">
      <div class="owner-section-head"><div><p class="hcc-sample">{ru?"Мой Hermes":"My Hermes"}</p><h2>{ru?"Подключённые рабочие пространства":"Connected workspaces"}</h2></div><span data-account-identity class="owner-cloud-note">—</span></div>
      <div class="workspace-grid" data-account-workspaces><p class="muted">{ru?"Загружаем доступы…":"Loading access…"}</p></div>
    </section>
    <section class="hcc-panel access-admin">
      <div class="owner-section-head"><div><p class="hcc-sample">{ru?"Доступ":"Access"}</p><h2>{ru?"Владельцы и командный просмотр":"Owners and Team View"}</h2><p>{ru?"Доступ выдаётся только существующему Hermes-аккаунту и фиксируется в audit trail.":"Access can be granted only to an existing Hermes account and is written to the audit trail."}</p></div><ShieldCheck size={22}/></div>
      <div class="owner-list" data-owner-list></div>
      <form data-access-form><label>{ru?"Email существующего Hermes-аккаунта":"Existing Hermes account email"}<input name="email" type="email" autocomplete="off" required placeholder="team@example.com"/></label><label>{ru?"Уровень доступа":"Permission"}<select name="capability"><option value="team_view">{ru?"Командный просмотр · только чтение":"Team View · read only"}</option><option value="owner">{ru?"Владелец · полный доступ":"Owner · full access"}</option></select></label><p class="muted">{ru?"Доступ сотрудника включает только безопасный статус AI. Полные права владельца выдаются отдельно.":"Team View can read only sanitized AI status. Full owner permissions require a separate selection."} <a href={"/services/hermes-connect/internal/team-view/"+(ru?"?lang=ru":"")}>{ru?"Открыть Team View":"Open Team View"}</a></p><div class="access-actions"><button type="submit" name="action" value="grant" class="primary">{ru?"Выдать доступ":"Grant access"}</button><button type="submit" name="action" value="revoke" class="danger">{ru?"Отозвать":"Revoke"}</button></div><p data-access-status role="status"></p></form>
    </section>
  </section>

  <dialog class="owner-dialog" data-capture-dialog aria-labelledby="capture-heading">
    <form data-work-form>
      <div class="owner-dialog-head"><div><p class="hcc-sample">{ru?"Новая задача":"New task"}</p><h2 id="capture-heading">{ru?"Добавить в облачную очередь":"Add to cloud backlog"}</h2></div><button type="button" class="icon-close" data-capture-cancel aria-label={ru?"Закрыть":"Close"}>×</button></div>
      <p class="muted">{ru?"Сохранение задачи не запускает AI автоматически.":"Saving a task does not dispatch AI automatically."}</p>
      <div class="row"><label>{ru?"Функция / направление":"Business area"}<select name="workstream"><option value="marketing">Marketing</option><option value="logistics">Logistics</option><option value="sales">Sales</option><option value="technology">Technology</option><option value="academy">Academy</option><option value="finance">Finance</option><option value="operations">Operations</option></select></label><label>{ru?"Приоритет":"Priority"}<select name="priority"><option value="p0">P0 · Critical</option><option value="p1">P1 · High</option><option value="p2" selected>P2 · Normal</option><option value="p3">P3 · Later</option></select></label></div>
      <label>{ru?"Проект":"Project"}<select name="project_id" data-work-project><option value="">{ru?"Без проекта":"Unassigned"}</option></select></label>
      <label>{ru?"Название (необязательно)":"Title (optional)"}<input name="title" maxlength="160" placeholder={ru?"Если пусто — первая строка станет названием":"If blank, the first instruction line becomes the title"}/></label>
      <label>{ru?"Что нужно сделать":"Instructions"}<textarea name="details" rows="6" maxlength="10000" required placeholder={ru?"Опишите ожидаемый результат обычным языком.":"Describe the expected outcome in normal language."}></textarea></label>
      <div class="dialog-actions"><button type="button" class="secondary" data-dictate><Mic size={15}/>{ru?"Диктовать":"Dictate"}</button><button type="submit" class="primary"><PackageCheck size={15}/>{ru?"Сохранить в очередь":"Save to backlog"}</button></div>
      <p data-capture-status role="status"></p>
    </form>
  </dialog>

  <dialog class="owner-dialog" data-edit-dialog aria-labelledby="work-edit-heading">
    <form data-edit-form>
      <div class="owner-dialog-head"><div><p class="hcc-sample">{ru?"Задача":"Task"}</p><h2 id="work-edit-heading">{ru?"Редактировать задачу":"Edit cloud task"}</h2></div><button type="button" class="icon-close" data-edit-cancel aria-label={ru?"Закрыть":"Close"}>×</button></div>
      <p class="muted">{ru?"Запущенные AI-задачи редактировать нельзя.":"Tasks already dispatched to AI cannot be edited."}</p>
      <input name="edit_id" type="hidden"/><input name="edit_updated_at" type="hidden"/>
      <label>{ru?"Проект":"Project"}<select name="edit_project_id" data-edit-project><option value="">{ru?"Без проекта":"Unassigned"}</option></select></label>
      <label>{ru?"Название":"Title"}<input name="edit_title" maxlength="160" required/></label>
      <div class="row"><label>{ru?"Функция / направление":"Business area"}<select name="edit_workstream"><option value="marketing">Marketing</option><option value="logistics">Logistics</option><option value="sales">Sales</option><option value="technology">Technology</option><option value="academy">Academy</option><option value="finance">Finance</option><option value="operations">Operations</option></select></label><label>{ru?"Приоритет":"Priority"}<select name="edit_priority"><option value="p0">P0</option><option value="p1">P1</option><option value="p2">P2</option><option value="p3">P3</option></select></label></div>
      <label>{ru?"Описание и ожидаемый результат":"Instructions and expected outcome"}<textarea name="edit_details" rows="7" maxlength="10000" required></textarea></label>
      <p data-edit-status role="status"></p>
      <div class="dialog-actions"><button type="button" class="secondary" data-edit-cancel>{ru?"Отмена":"Cancel"}</button><button type="submit" class="primary">{ru?"Сохранить в облаке":"Save to cloud"}</button></div>
    </form>
  </dialog>
</div>
