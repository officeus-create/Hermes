---
const repairBookingPath = "/services/hermes-connect/repair-shops/booking";
const isRepairBooking = Astro.url.pathname.replace(/\/+$/, "") === repairBookingPath;
---

{isRepairBooking && (
  <>
    <template id="repair-growth-template">
      <section class="repair-growth-card" data-repair-growth-card aria-labelledby="repair-growth-title">
        <p class="repair-growth-eyebrow">For Business Owners</p>
        <h3 id="repair-growth-title">Want more customers for your business?</h3>
        <p class="repair-growth-copy">
          Hermes can help with websites, Google visibility and SEO, social media, paid ads, and CRM or workflow automation.
          This is optional and separate from your repair appointment.
        </p>
        <button class="repair-growth-open" type="button" data-growth-open>Grow My Business / Talk to Hermes</button>

        <form class="repair-growth-form" data-growth-form hidden novalidate>
          <label class="repair-growth-field">
            What would help most?
            <select data-growth-service required>
              <option value="">Choose one</option>
              <option value="Website / conversion">Website / conversion</option>
              <option value="SEO / Google visibility">SEO / Google visibility</option>
              <option value="Social media marketing">Social media marketing</option>
              <option value="Paid advertising">Paid advertising</option>
              <option value="CRM / workflow automation">CRM / workflow automation</option>
              <option value="Not sure — recommend the best next step">Not sure — recommend the best next step</option>
            </select>
          </label>

          <label class="repair-growth-field">
            What result are you trying to get? <span>optional</span>
            <textarea data-growth-message maxlength="1000" placeholder="Example: more local calls from Google, a better website, or a follow-up system for leads."></textarea>
          </label>

          <label class="repair-growth-consent">
            <input type="checkbox" data-growth-consent required />
            <span>I agree that Hermes may use the name and email from this booking to contact me about these business-growth services.</span>
          </label>

          <p class="repair-growth-privacy">Your repair booking remains unchanged. This request is sent only after you explicitly opt in. Personal details are not added to public analytics.</p>
          <button class="repair-growth-submit" type="submit" data-growth-submit>Send business-growth request</button>
          <p class="repair-growth-status" data-growth-status role="status" aria-live="polite" hidden></p>
        </form>
      </section>
    </template>
    <script is:inline src="/repair-booking-growth.js"></script>
  </>
)}

<style>
  .repair-growth-card{margin-top:24px;padding:22px;text-align:left;border:1px solid rgba(157,136,255,.28);border-radius:18px;background:linear-gradient(135deg,rgba(128,104,255,.12),rgba(91,174,247,.07))}.repair-growth-eyebrow{margin:0 0 8px;color:#a996ff;text-transform:uppercase;letter-spacing:.12em;font-size:11px;font-weight:850}.repair-growth-card h3{margin:0 0 8px;font-size:22px;color:#f7f8fb}.repair-growth-copy{margin:0;color:#aeb4c2;line-height:1.6}.repair-growth-open,.repair-growth-submit{display:inline-flex;justify-content:center;align-items:center;margin-top:16px;border:0;border-radius:12px;padding:12px 16px;background:linear-gradient(135deg,#8068ff,#5baef7);color:#fff;font:inherit;font-weight:850;cursor:pointer}.repair-growth-form{margin-top:18px;padding-top:18px;border-top:1px solid rgba(255,255,255,.08)}.repair-growth-field{display:flex;flex-direction:column;gap:8px;margin-bottom:14px;color:#dfe2ea;font-size:13px;font-weight:750}.repair-growth-field span{color:#858b9a;font-size:11px;font-weight:600}.repair-growth-field select,.repair-growth-field textarea{width:100%;box-sizing:border-box;border:1px solid rgba(255,255,255,.11);border-radius:12px;padding:12px 13px;background:#10121a;color:#fff;font:inherit;outline:none}.repair-growth-field textarea{min-height:92px;resize:vertical}.repair-growth-field select:focus,.repair-growth-field textarea:focus{border-color:#8f78ff;box-shadow:0 0 0 3px rgba(143,120,255,.12)}.repair-growth-consent{display:flex;align-items:flex-start;gap:10px;color:#d3d7e1;font-size:13px;line-height:1.5}.repair-growth-consent input{margin-top:3px}.repair-growth-privacy{margin:12px 0 0;color:#8f95a5;font-size:12px;line-height:1.5}.repair-growth-submit:disabled{opacity:.6;cursor:not-allowed}.repair-growth-status{margin:12px 0 0;padding:11px 12px;border-radius:10px;background:rgba(180,42,42,.14);color:#ffc4c4;font-size:13px;line-height:1.45}.repair-growth-status[data-state="success"]{background:rgba(34,151,104,.14);color:#a8f1cf}@media(max-width:720px){.repair-growth-card{padding:18px}.repair-growth-open,.repair-growth-submit{width:100%}}
</style>
