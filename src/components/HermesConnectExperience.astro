    const withLocale = (href) => {
      const url = new URL(href, window.location.origin);
      if (locale === "en") url.searchParams.delete("lang");
      else url.searchParams.set("lang", locale);
      return `${url.pathname}${url.search}${url.hash}`;
    };

    document.querySelectorAll('[data-language-menu] a[lang], .mobile-language-switcher a[lang]').forEach((link) => {
      const targetLocale = link.getAttribute("lang") || "en";
      const url = new URL(window.location.href);
      if (targetLocale === "en") url.searchParams.delete("lang");
      else url.searchParams.set("lang", targetLocale);
      link.setAttribute("href", `${url.pathname}${url.search}${url.hash}`);
    });

    const table = translations[locale] || {};
    if (locale !== "en") {
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      let node = walker.nextNode();
      while (node) {
        const raw = node.nodeValue || "";
        const normalized = raw.replace(/\s+/g, " ").trim();
        const translated = table[normalized];
        if (translated) {
          const leading = raw.match(/^\s*/)?.[0] || "";
          const trailing = raw.match(/\s*$/)?.[0] || "";
          node.nodeValue = `${leading}${translated}${trailing}`;
        }
        node = walker.nextNode();
      }
    }

    const legacyLinks = document.querySelectorAll('main a[href^="https://connect.hermeslogisticsus.com"]');
    legacyLinks.forEach((link) => {
      const original = link.getAttribute("href") || "";
      const target = original.includes("#apply")
        ? "/services/hermes-connect/repair-shops/auth/"
        : "/services/hermes-connect/repair-shops/";
      link.setAttribute("href", withLocale(target));
      link.setAttribute("data-hc-legacy-rewritten", "true");
      link.setAttribute("title", ui[locale].currentProduct);

      const label = (link.textContent || "").replace(/\s+/g, " ").trim();
      if (/workspace|web app access|command center/i.test(label)) {
        link.textContent = ui[locale].openCurrent;
      }
    });

    document.querySelectorAll('a[href^="/services/hermes-connect/"]').forEach((link) => {
      const href = link.getAttribute("href");
      if (!href || href.includes("?lang=")) return;
      link.setAttribute("href", withLocale(href));
    });

    const oldBack = document.querySelector(".repair-pilot-page .hero-header-nav .back-link");
    if (oldBack) {
      oldBack.textContent = ui[locale].contextBack;
      oldBack.classList.add("hc-context-back");
      oldBack.setAttribute("aria-label", ui[locale].contextBack);
    }

    const header = document.querySelector(".site-header");
    if (header && !document.querySelector("[data-hc-product-context]")) {
      const isHub = path === "/services/hermes-connect/" || path === "/services/hermes-connect";
      const isRepair = path.startsWith("/services/hermes-connect/repair-shops");
      const status = isHub ? ui[locale].hub : isRepair ? ui[locale].currentBeta : ui[locale].demo;

      const context = document.createElement("div");
      context.className = `hc-product-context ${isRepair ? "is-live" : isHub ? "is-hub" : "is-demo"}`;
      context.setAttribute("data-hc-product-context", "true");
      context.innerHTML = `
        <div class="hc-product-context__inner">
          <div class="hc-product-context__status">
            <span class="hc-product-context__dot" aria-hidden="true"></span>
            <strong>${status}</strong>
            <span>${ui[locale].currentProduct}</span>
          </div>
          <nav aria-label="Hermes Connect product navigation">
            <a href="${withLocale("/services/hermes-connect/")}">${ui[locale].hubLink}</a>
            <a href="${withLocale("/services/hermes-connect/repair-shops/")}">${ui[locale].repairLink}</a>
            <a href="${withLocale("/services/hermes-connect/repair-shops/auth/")}">${ui[locale].ownerLink}</a>
          </nav>
        </div>`;
      header.insertAdjacentElement("afterend", context);
    }
  })();
