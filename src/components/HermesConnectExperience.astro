      #090d16;
  }

  .hc-product-context {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(8, 12, 21, 0.9);
    backdrop-filter: blur(18px);
  }

  .hc-product-context__inner {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hc-product-context__status,
  .hc-product-context nav {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .hc-product-context__status {
    min-width: 0;
    color: rgba(248, 250, 252, 0.72);
    font-size: 0.78rem;
  }

  .hc-product-context__status strong {
    color: #f8fafc;
    letter-spacing: 0.045em;
    font-size: 0.73rem;
  }

  .hc-product-context__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #60a5fa;
    box-shadow: 0 0 0 5px rgba(96, 165, 250, 0.12);
    flex: 0 0 auto;
  }

  .hc-product-context.is-live .hc-product-context__dot {
    background: #34d399;
    box-shadow: 0 0 0 5px rgba(52, 211, 153, 0.12);
  }

  .hc-product-context.is-demo .hc-product-context__dot {
    background: #fbbf24;
    box-shadow: 0 0 0 5px rgba(251, 191, 36, 0.12);
  }

  .hc-product-context nav a {
    color: rgba(248, 250, 252, 0.76);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 650;
    padding: 0.42rem 0.65rem;
    border-radius: 999px;
    border: 1px solid transparent;
  }

  .hc-product-context nav a:hover,
  .hc-product-context nav a:focus-visible {
    color: #fff;
    border-color: rgba(157, 136, 255, 0.36);
    background: rgba(157, 136, 255, 0.1);
  }

  .hc-experience .hc-feature-page,
  .hc-experience .connect-service-page,
  .hc-experience .repair-pilot-page {
    isolation: isolate;
  }

  .hc-experience .hc-feature-page .card,
  .hc-experience .connect-service-capability-grid article,
  .hc-experience .pipeline-card,
  .hc-experience .form-container,
  .hc-experience .workspace-mockup {
    box-shadow: 0 18px 55px rgba(0, 0, 0, 0.18);
  }

  .hc-experience .breadcrumb-nav,
  .hc-experience .hero-header-nav {
    position: relative;
    z-index: 2;
  }

  .hc-experience .repair-pilot-page .hero-header-nav {
    padding-top: 1.15rem;
    margin-bottom: 1.5rem;
  }

  .hc-experience .repair-pilot-page .hero-header-nav .back-link.hc-context-back {
    position: static !important;
    inset: auto !important;
    transform: none !important;
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0.5rem 0.8rem;
    border: 1px solid rgba(157, 136, 255, 0.28);
    border-radius: 999px;
    background: rgba(10, 15, 27, 0.72);
    color: #dbeafe;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
  }

  .hc-experience .repair-pilot-page .hero-header-nav .back-link.hc-context-back:hover {
    border-color: rgba(90, 200, 250, 0.5);
    color: #fff;
    background: rgba(18, 28, 48, 0.9);
  }

  .hc-experience main a[data-hc-legacy-rewritten="true"] {
    border-color: rgba(52, 211, 153, 0.34) !important;
  }

  @media (max-width: 760px) {
    .hc-product-context__inner {
      width: min(100% - 1rem, 1180px);
      padding: 0.55rem 0;
      align-items: flex-start;
      flex-direction: column;
      gap: 0.45rem;
    }

    .hc-product-context__status {
      width: 100%;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .hc-product-context nav {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 0.1rem;
    }

    .hc-product-context nav::-webkit-scrollbar {
      display: none;
    }

    .hc-product-context nav a {
      white-space: nowrap;
      background: rgba(255, 255, 255, 0.035);
      border-color: rgba(255, 255, 255, 0.06);
    }

    .hc-experience .repair-pilot-page .hero-header-nav {
      padding-top: 0.8rem;
      margin-bottom: 1rem;
    }
