---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import CatalogWebsiteConcept from "./CatalogWebsiteConcept.astro";
import InternationalBusinessProfile from "./InternationalBusinessProfile.astro";
import type { CatalogBusinessConcept } from "../data/catalog-business-concepts";

interface Props { business: CatalogBusinessConcept; }
const { business } = Astro.props;
const profileUrl = `https://hermeslogisticsus.com/businesses/${business.countrySlug}/${business.localitySlug}/${business.slug}/`;
const isLocalizedConcept = Boolean(business.localeCopy);
const title = business.id === "catalog-ua-chayka-store"
  ? "Ремонт телефонів у Чайках | Чайка Store — Hermes Catalog"
  : `${business.name} | Hermes Catalog`;
const description = business.id === "catalog-ua-chayka-store"
  ? "Hermes Catalog website concept for Чайка Store in Чайки: phone repair discovery, contacts and More Chay tea direction."
  : `Public Hermes Catalog discovery profile for ${business.name} in ${business.locality}, ${business.region}.`;
const schema = isLocalizedConcept ? [
  {"@context":"https://schema.org","@type":business.schemaType,"@id":profileUrl+"#business",name:business.name,url:profileUrl,telephone:business.phone,address:{"@type":"PostalAddress",streetAddress:business.address,addressLocality:business.locality,addressRegion:business.region,...(business.postalCode?{postalCode:business.postalCode}:{}),addressCountry:business.countryCode},sameAs:business.channels.map((channel)=>channel.url)},
  {"@context":"https://schema.org","@type":"Service",name:`${business.primaryIntent} discovery in ${business.locality}`,provider:{"@id":profileUrl+"#business"},areaServed:{"@type":"Place",name:`${business.locality}, ${business.region}`},description:"Public business discovery profile. Operating details marked for owner confirmation remain unverified."},
  {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[
    {"@type":"ListItem",position:1,name:"Hermes Catalog",item:"https://hermeslogisticsus.com/businesses/"},
    {"@type":"ListItem",position:2,name:business.countrySlug,item:`https://hermeslogisticsus.com/businesses/${business.countrySlug}/`},
    {"@type":"ListItem",position:3,name:business.locality,item:`https://hermeslogisticsus.com/businesses/${business.countrySlug}/${business.localitySlug}/`},
    {"@type":"ListItem",position:4,name:business.name,item:profileUrl}
  ]},
  ...((business.faq?.length ?? 0) > 0 ? [{"@context":"https://schema.org","@type":"FAQPage",mainEntity:business.faq!.map((item)=>({"@type":"Question",name:item.question,acceptedAnswer:{"@type":"Answer",text:item.answer}}))}] : [])
] : [];
---
{isLocalizedConcept ? (
  <BaseLayout title={title} description={description} schema={schema}>
    <SiteHeader theme="light" activePath="/businesses/" />
    <main class="concept-page"><CatalogWebsiteConcept business={business} profileUrl={profileUrl} defaultLocale="uk" /></main>
    <SiteFooter />
  </BaseLayout>
) : <InternationalBusinessProfile business={business} />}
<style>.concept-page{min-height:80vh;background:#f6f6f1;color:#18201e;padding:34px max(16px,calc((100% - 1160px)/2)) 70px}</style>
