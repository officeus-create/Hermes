---
interface Props {
  context: "marketing" | "technology";
}

const { context } = Astro.props;
const copy = context === "marketing"
  ? {
      eyebrow: "Website and search",
      title: "Need the website, SEO, and conversion path coordinated as one system?",
      body: "Review the focused U.S.-market service page for website builds, redesigns, technical SEO, Local SEO, multilingual content, analytics, and CRM handoff.",
      cta: "Explore website development and SEO",
    }
  : {
      eyebrow: "Commercial implementation",
      title: "Turn a technical build into a searchable customer journey.",
      body: "See how Hermes combines website development, technical search foundations, conversion structure, analytics, and practical post-launch improvement for U.S.-market businesses.",
      cta: "Open the website and SEO service",
    };
---

<section class="website-seo-link" aria-labelledby={`website-seo-link-${context}`}>
  <div class="website-seo-link__inner">
    <div>
      <p>{copy.eyebrow}</p>
      <h2 id={`website-seo-link-${context}`}>{copy.title}</h2>
      <span>{copy.body}</span>
    </div>
    <a href="/marketing/websites-seo/">{copy.cta} <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .website-seo-link {
    padding: clamp(42px, 7vw, 82px) 20px;
    background: #f4f6fb;
    color: #11182c;
  }

  .website-seo-link__inner {
    width: min(1160px, 100%);
    margin: 0 auto;
    padding: clamp(28px, 5vw, 52px);
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 42px;
    border: 1px solid #dfe4ef;
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(25, 40, 86, .08);
  }

  p {
    margin: 0 0 12px;
    color: #b16a1e;
    font-size: .78rem;
    font-weight: 850;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -.04em;
  }

  span {
    display: block;
    max-width: 760px;
    margin-top: 18px;
    color: #5d6578;
    line-height: 1.7;
  }

  a {
    flex: 0 0 auto;
    padding: 15px 20px;
    border-radius: 999px;
    background: #101a43;
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    transition: transform .2s ease, background .2s ease;
  }

  a span {
    display: inline;
    margin: 0 0 0 6px;
    color: inherit;
  }

  a:hover,
  a:focus-visible {
    transform: translateY(-2px);
    background: #263f8d;
  }

  @media (max-width: 800px) {
    .website-seo-link__inner {
      display: block;
    }

    a {
      display: inline-block;
      margin-top: 26px;
    }
  }
</style>
