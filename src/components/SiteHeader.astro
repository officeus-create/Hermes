---
import { ArrowUpRight, Check, ChevronDown, Languages, Menu } from "@lucide/astro";
import { site } from "../data/site";
import { localeConfig, siteLocales, type SiteLocale } from "../data/locales";
import { academyLogisticsOwnerRoutes, directionForOwnerPath, directionOwnerRoutes, isAcademyLogisticsOwnerPath, type DirectionId } from "../data/localized-direction-owners";
import hermesConnectSafePolishUrl from "../styles/hermes-connect-safe-polish.css?url";
import hermesRepairPublicShellUrl from "../styles/hermes-repair-public-shell.css?url";
import BeautyOwnerWorkspaceControls from "./BeautyOwnerWorkspaceControls.astro";
import HermesConnectAccountSwitcher from "./HermesConnectAccountSwitcher.astro";
import HermesConnectDomReady from "./HermesConnectDomReady.astro";
import HermesConnectExperience from "./HermesConnectExperience.astro";
import HermesConnectLauncher from "./HermesConnectLauncher.astro";

interface Props {
  theme?: "dark" | "light";
  activePath?: string;
  locale?: SiteLocale;
}

const { theme = "dark", activePath, locale = "en" } = Astro.props;
const currentPath = Astro.url.pathname;
const isHermesConnectRoute = currentPath.startsWith("/services/hermes-connect");
const isLoadBoardRoute = currentPath === "/load-board/" || currentPath.startsWith("/load-board/");
const isHermesConnectExperienceRoute = isHermesConnectRoute || isLoadBoardRoute;
const isRepairPrivateRoute = [
  "/services/hermes-connect/repair-shops/dashboard",
  "/services/hermes-connect/repair-shops/appointments",
  "/services/hermes-connect/repair-shops/customers",
  "/services/hermes-connect/repair-shops/vehicles",
  "/services/hermes-connect/repair-shops/services",
  "/services/hermes-connect/repair-shops/availability",
].some((prefix) => currentPath === prefix || currentPath.startsWith(`${prefix}/`));
const isAcademyPrivateRoute = [
  "/services/hermes-connect/academy/dashboard",
  "/services/hermes-connect/academy/lesson",
  "/services/hermes-connect/academy/program",
  "/services/hermes-connect/academy/progression",
  "/services/hermes-connect/academy/reviewer",
  "/services/hermes-connect/academy/submissions",
  "/services/hermes-connect/academy/support",
].some((prefix) => currentPath === prefix || currentPath.startsWith(`${prefix}/`));
const isBeautyPrivateRoute = currentPath === "/services/hermes-connect/beauty/workspace" || currentPath.startsWith("/services/hermes-connect/beauty/workspace/");
const privateWorkspace: "repair" | "academy" | "beauty" | null = isRepairPrivateRoute
  ? "repair"
  : isAcademyPrivateRoute
    ? "academy"
    : isBeautyPrivateRoute
      ? "beauty"
      : null;
const publicWorkspace: "repair" | "academy" | "beauty" | "neutral" = currentPath.startsWith("/services/hermes-connect/repair-shops")
  ? "repair"
  : currentPath.startsWith("/services/hermes-connect/academy")
    ? "academy"
    : currentPath.startsWith("/services/hermes-connect/beauty")
      ? "beauty"
      : "neutral";
const requestedLocale = Astro.url.searchParams.get("lang");
const activeLocale = isHermesConnectExperienceRoute && requestedLocale && siteLocales.includes(requestedLocale as SiteLocale)
  ? requestedLocale as SiteLocale
  : locale;
const localizedLabels = {
  uk: { logistics: "Логістика", marketing: "Маркетинг", academy: "Академія", technology: "IT-розробка", contact: "Почати розмову", home: "Головна" },
  ru: { logistics: "Логистика", marketing: "Маркетинг", academy: "Академия", technology: "IT-разработка", contact: "Начать разговор", home: "Главная" },
  es: { logistics: "Logística", marketing: "Marketing", academy: "Academia", technology: "Desarrollo IT", contact: "Iniciar una conversación", home: "Inicio" },
  it: { logistics: "Logistica", marketing: "Marketing", academy: "Academy", technology: "Sviluppo IT", contact: "Inizia una conversazione", home: "Home" },
  fr: { logistics: "Logistique", marketing: "Marketing", academy: "Académie", technology: "Développement IT", contact: "Démarrer une conversation", home: "Accueil" },
};
const directionOrder: Record<string, number> = { logistics: 0, marketing: 1, technology: 2, academy: 3 };
const navDirectionId = (href: string) => href.match(/^paths\/([^/]+)\//)?.[1] ?? "";
const orderedNavigation = [...site.navigation].sort(
  (a, b) => (directionOrder[navDirectionId(a.href)] ?? 99) - (directionOrder[navDirectionId(b.href)] ?? 99),
);
const orderedPaths = [...site.paths].sort(
  (a, b) => (directionOrder[a.id] ?? 99) - (directionOrder[b.id] ?? 99),
);
const navigation = activeLocale === "en"
  ? orderedNavigation.map((item) => {
      const url = `/${item.href}`;
      const label = item.href === "paths/technology/" ? "IT" : item.label;
      return { ...item, label, url, active: (activePath ?? currentPath) === url };
    })
  : orderedPaths.map((path) => ({
      label: localizedLabels[activeLocale][path.id as keyof typeof localizedLabels.uk],
      url: directionOwnerRoutes[activeLocale][path.id as keyof typeof directionOwnerRoutes.en],
      active: currentPath === directionOwnerRoutes[activeLocale][path.id as keyof typeof directionOwnerRoutes.en],
    }));
const isCatalogRoute = currentPath === "/businesses/" || currentPath.startsWith("/businesses/");
const isInsightsRoute = currentPath === "/insights/" || currentPath.startsWith("/insights/");
const contactLabel = activeLocale === "en" ? "Start a conversation" : localizedLabels[activeLocale].contact;
const section = (["logistics", "marketing", "technology", "academy"] as DirectionId[]).find((slug) => currentPath.includes(`/paths/${slug}`));
const localizedOwnerDirection = directionForOwnerPath(currentPath);
const languageDirection = section ?? localizedOwnerDirection;
const academyLogisticsOwner = isAcademyLogisticsOwnerPath(currentPath);
const languageLinks = siteLocales.map((language) => {
  if (isHermesConnectExperienceRoute) {
    const params = new URLSearchParams(Astro.url.searchParams);
    if (language === "en") params.delete("lang");
    else params.set("lang", language);
    const query = params.toString();
    return {
      locale: language,
      name: localeConfig[language].name,
      href: `${currentPath}${query ? `?${query}` : ""}`,
    };
  }

  if (academyLogisticsOwner) {
    return {
      locale: language,
      name: localeConfig[language].name,
      href: academyLogisticsOwnerRoutes[language],
    };
  }

  if (languageDirection) {
    return {
      locale: language,
      name: localeConfig[language].name,
      href: directionOwnerRoutes[language][languageDirection],
    };
  }

  return {
    locale: language,
    name: localeConfig[language].name,
    href: localeConfig[language].path,
  };
});
---

{isHermesConnectExperienceRoute && <link rel="stylesheet" href={hermesConnectSafePolishUrl} />}
{isHermesConnectRoute && <link rel="stylesheet" href={hermesRepairPublicShellUrl} />}

<header class={`site-header site-header-${theme}`} data-header>
  <a class="wordmark" href={activeLocale === "en" ? "/#top" : `${localeConfig[activeLocale].path}#top`} aria-label="Hermes home">
    <span class="wordmark-mark">H</span>
    <span>{site.brand}</span>
  </a>

  <nav class="desktop-nav desktop-nav--ecosystem" aria-label="Primary navigation">
    {navigation.map((item) => <a href={item.url} aria-current={item.active ? "page" : undefined}>{item.label}</a>)}
    <a href="/insights/" aria-current={isInsightsRoute ? "page" : undefined}>Insights</a>
    <a class="catalog-nav-link" href="/businesses/" aria-current={isCatalogRoute ? "page" : undefined}><span>Catalog</span></a>
  </nav>

  <div class="header-actions">
    <HermesConnectLauncher
      variant="header"
      href="/services/hermes-connect/repair-shops/"
      label="Hermes Connect"
      sublabel="Repair Shops · current live pilot"
    />
    {privateWorkspace && <HermesConnectAccountSwitcher current={privateWorkspace} mode="menu" />}
    {!privateWorkspace && <HermesConnectAccountSwitcher current={publicWorkspace} mode="menu" publicSafe />}
    <details class="language-menu" data-language-menu>
      <summary aria-label={`Language: ${localeConfig[activeLocale].name}`}>
        <Languages size={16} aria-hidden="true" />
        <span>{localeConfig[activeLocale].name}</span>
        <ChevronDown size={15} aria-hidden="true" />
      </summary>
      <nav aria-label="Choose language">
        {languageLinks.map((item) => (
          <a href={item.href} lang={item.locale} aria-current={item.locale === activeLocale ? "page" : undefined}>
            <span>{item.name}</span>{item.locale === activeLocale && <Check size={15} aria-hidden="true" />}
          </a>
        ))}
      </nav>
    </details>
    <a class="header-cta" href="#contact">
      {contactLabel}
      <ArrowUpRight size={17} aria-hidden="true" />
    </a>
  </div>

  <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
    <Menu size={23} aria-hidden="true" />
  </button>

  <nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation" data-mobile-menu hidden>
    {navigation.map((item) => <a href={item.url} aria-current={item.active ? "page" : undefined}>{item.label}</a>)}
    <a href="/insights/" aria-current={isInsightsRoute ? "page" : undefined}>Insights</a>
    <a class="mobile-catalog-link" href="/businesses/" aria-current={isCatalogRoute ? "page" : undefined}><span>Catalog</span></a>
    <HermesConnectLauncher
      variant="mobile"
      href="/services/hermes-connect/repair-shops/"
      label="Hermes Connect"
      sublabel="Repair Shops · current live pilot"
    />
    {privateWorkspace && <div class="hc-mobile-account-panel"><HermesConnectAccountSwitcher current={privateWorkspace} /></div>}
    {!privateWorkspace && <div class="hc-mobile-account-panel"><HermesConnectAccountSwitcher current={publicWorkspace} publicSafe /></div>}
    <a href="#contact">{contactLabel}</a>
    <div class="mobile-language-switcher" aria-label="Choose language">
      <strong>{localeConfig[activeLocale].name}</strong>
      {languageLinks.map((item) => (
        <a href={item.href} lang={item.locale} aria-current={item.locale === activeLocale ? "page" : undefined}>
          <span>{item.name}</span>{item.locale === activeLocale && <Check size={15} aria-hidden="true" />}
        </a>
      ))}
    </div>
  </nav>
</header>

{isHermesConnectExperienceRoute && <HermesConnectExperience />}
{isHermesConnectRoute && <HermesConnectDomReady />}
{isBeautyPrivateRoute && <BeautyOwnerWorkspaceControls />}

<script>
  const button = document.querySelector<HTMLElement>("[data-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const header = document.querySelector<HTMLElement>("[data-header]");

  const updateHeader = () => header?.classList.toggle("site-header-scrolled", window.scrollY > 28);
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  const closeMenu = (restoreFocus = false) => {
    button?.setAttribute("aria-expanded", "false");
    button?.setAttribute("aria-label", "Open navigation");
    if (menu) menu.hidden = true;
    if (restoreFocus) button?.focus();
  };

  button?.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMenu();
      return;
    }
    button.setAttribute("aria-expanded", "true");
    button.setAttribute("aria-label", "Close navigation");
    if (menu) {
      menu.hidden = false;
      menu.querySelector<HTMLElement>("a")?.focus();
    }
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => closeMenu());
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") closeMenu(true);
  });

  document.addEventListener("click", (event) => {
    if (button?.getAttribute("aria-expanded") !== "true") return;
    const target = event.target;
    if (target instanceof Node && !menu?.contains(target) && !button.contains(target)) closeMenu();
  });

  const languageMenus = document.querySelectorAll<HTMLDetailsElement>("[data-language-menu]");
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    languageMenus.forEach((languageMenu) => {
      if (!languageMenu.contains(target)) languageMenu.open = false;
    });
  });
</script>

<style is:global>
  .desktop-nav--ecosystem {
    gap: clamp(.72rem, 1.2vw, 1.25rem);
    margin-left: clamp(1rem, 2vw, 2.5rem);
    font-size: clamp(.78rem, .9vw, .86rem);
  }
  .desktop-nav .catalog-nav-link {
    margin-left: clamp(.45rem, 1vw, 1rem);
    padding-left: clamp(.9rem, 1.4vw, 1.35rem);
  }
  .desktop-nav .catalog-nav-link::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1px;
    height: 22px;
    background: currentColor;
    content: "";
    opacity: .22;
    transform: translateY(-50%);
  }
  .desktop-nav .catalog-nav-link span,
  .mobile-nav .mobile-catalog-link span {
    background: linear-gradient(100deg, currentColor 0%, #8ed8ff 28%, #b6a4ff 50%, #73d7c7 70%, currentColor 100%);
    background-size: 240% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: hermes-catalog-shimmer 5.5s ease-in-out infinite;
  }
  .site-header-light .desktop-nav .catalog-nav-link span,
  .site-header-light .mobile-nav .mobile-catalog-link span {
    background-image: linear-gradient(100deg, #111324 0%, #1970b8 30%, #6d51c8 52%, #168b7b 72%, #111324 100%);
  }
  .mobile-nav .mobile-catalog-link {
    margin-top: .25rem;
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    padding-top: .8rem;
  }
  @keyframes hermes-catalog-shimmer {
    0%, 18% { background-position: 100% 50%; }
    50%, 68% { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
  }
  @media (max-width: 1180px) and (min-width: 901px) {
    .desktop-nav--ecosystem { gap: .68rem; margin-left: 1rem; font-size: .76rem; }
    .desktop-nav .catalog-nav-link { margin-left: .25rem; padding-left: .72rem; }
    .site-header .header-actions { gap: .55rem; }
    .site-header .header-cta { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .desktop-nav .catalog-nav-link span,
    .mobile-nav .mobile-catalog-link span { animation: none; background-position: 50% 50%; }
  }

  /* Hermes Connect safe-polish layer. Scoped so the rest of the site is untouched. */
  .hc-experience .site-header {
    min-height: 76px;
    width: min(calc(100% - 2rem), 1180px);
    border-bottom-color: rgba(255,255,255,.12);
  }
  .hc-experience .site-header-scrolled {
    min-height: 64px;
    background: rgba(8,12,21,.88);
    border-bottom-color: rgba(255,255,255,.09);
    box-shadow: 0 12px 36px rgba(0,0,0,.16);
    backdrop-filter: blur(22px) saturate(1.08);
  }
  .hc-experience .wordmark {
    gap: .55rem;
    font-size: .98rem;
  }
  .hc-experience .wordmark-mark {
    width: 30px;
    height: 30px;
    border-color: rgba(255,255,255,.28);
    border-radius: 7px;
  }
  .hc-experience .desktop-nav {
    gap: clamp(.85rem,1.35vw,1.35rem);
    margin-left: clamp(1rem,2vw,2rem);
    font-size: .82rem;
  }
  .hc-experience .header-actions {
    gap: .62rem;
  }
  .hc-experience .language-menu summary {
    min-height: 38px;
    padding: .48rem .72rem;
    border-color: rgba(255,255,255,.2);
    border-radius: 999px;
    background: rgba(255,255,255,.035);
  }
  .hc-experience .language-menu nav {
    border-radius: 14px;
    overflow: hidden;
    background: rgba(8,12,21,.98);
  }
  .hc-experience .header-cta {
    min-height: 38px;
    padding: .46rem .72rem;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 999px;
    background: rgba(255,255,255,.035);
    font-size: .8rem;
  }
  .hc-experience .site-header + .hc-product-context {
    margin-top: 76px;
  }
  .hc-experience .hc-product-context {
    border-bottom-color: rgba(255,255,255,.06);
    background: rgba(8,12,21,.82);
    backdrop-filter: blur(22px) saturate(1.06);
  }
  .hc-experience .hc-product-context__inner {
    width: min(calc(100% - 2rem),1180px);
    padding: .52rem 0 .48rem;
    gap: .45rem;
  }
  .hc-experience .hc-product-context__summary {
    gap: .5rem;
    font-size: .7rem;
  }
  .hc-experience .hc-product-context__summary strong {
    padding: .28rem .52rem;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 999px;
    background: rgba(255,255,255,.035);
    font-size: .66rem;
    letter-spacing: .035em;
  }
  .hc-experience .hc-product-context__dot {
    width: 7px;
    height: 7px;
  }
  .hc-experience .hc-family-nav {
    gap: .18rem;
  }
  .hc-experience .hc-family-nav a {
    padding: .36rem .52rem;
    border-color: transparent;
    background: transparent;
    color: #9eaabd;
    font-size: .7rem;
  }
  .hc-experience .hc-family-nav a:hover,
  .hc-experience .hc-family-nav a:focus-visible,
  .hc-experience .hc-family-nav a[aria-current="page"] {
    border-color: rgba(157,136,255,.22);
    background: rgba(157,136,255,.085);
    color: #fff;
  }
  .hc-experience .hc-language-truth {
    width: min(calc(100% - 2rem),1180px);
    padding-bottom: .52rem;
    color: #9eaabd;
    font-size: .72rem;
  }
  .hc-experience .hc-mobile-account-panel {
    width: 100%;
  }
  .hc-experience .hc-mobile-account-panel .hc-account-switcher {
    margin: 0;
  }
  @media (max-width: 980px) {
    .hc-experience .site-header { min-height: 70px; }
    .hc-experience .site-header + .hc-product-context { margin-top: 70px; }
    .hc-experience .desktop-nav { gap: .75rem; margin-left: 1rem; font-size: .76rem; }
    .hc-experience .header-cta { display: none; }
  }
  @media (max-width: 760px) {
    .hc-experience .site-header { width: min(calc(100% - 1rem),1180px); min-height: 64px; }
    .hc-experience .site-header + .hc-product-context { margin-top: 64px; }
    .hc-experience .hc-product-context__inner,
    .hc-experience .hc-language-truth { width: min(calc(100% - 1rem),1180px); }
    .hc-experience .hc-product-context__summary strong { padding: .26rem .46rem; }
    .hc-experience .site-header .mobile-nav {
      position: fixed;
      top: 64px;
      right: .5rem;
      left: .5rem;
      max-height: calc(100dvh - 72px - env(safe-area-inset-bottom));
      box-sizing: border-box;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      padding-bottom: calc(1rem + env(safe-area-inset-bottom));
    }
    .hc-experience .site-header .mobile-language-switcher {
      min-height: max-content;
      padding-bottom: max(.35rem, env(safe-area-inset-bottom));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hc-experience .site-header,
    .hc-experience .site-header-scrolled { transition: none; }
  }


  /* Kept critical across non-Connect pages while Connect-only polish is route-scoped. */
/* HC account chip — global signed-in header contrast.
   Visual-only: keep auth, workspace ownership, locale and navigation behavior in the canonical switcher. */
.site-header .header-actions .hc-account-menu > summary {
  border-color: rgba(124, 92, 255, .28) !important;
  background:
    radial-gradient(circle at 16% 8%, rgba(124, 92, 255, .24), transparent 56%),
    linear-gradient(135deg, rgba(28, 34, 48, .98), rgba(11, 13, 18, .98)) !important;
  color: #fff !important;
  box-shadow:
    0 12px 30px rgba(11, 13, 18, .18),
    inset 0 1px 0 rgba(255, 255, 255, .08);
  backdrop-filter: blur(18px) saturate(125%);
  -webkit-backdrop-filter: blur(18px) saturate(125%);
  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease, background 160ms ease;
}

.site-header .header-actions .hc-account-menu > summary:hover,
.site-header .header-actions .hc-account-menu > summary:focus-visible,
.site-header .header-actions .hc-account-menu[open] > summary {
  border-color: rgba(143, 220, 255, .46) !important;
  background:
    radial-gradient(circle at 16% 8%, rgba(124, 92, 255, .30), transparent 58%),
    linear-gradient(135deg, #20283a, #0b0d12) !important;
  box-shadow:
    0 14px 34px rgba(11, 13, 18, .24),
    0 0 0 3px rgba(124, 92, 255, .08),
    inset 0 1px 0 rgba(255, 255, 255, .10);
}

.site-header .header-actions .hc-account-menu > summary:hover {
  transform: translateY(-1px);
}

.site-header .header-actions .hc-account-menu > summary:focus-visible {
  outline: 2px solid rgba(143, 220, 255, .72);
  outline-offset: 2px;
}

.site-header .header-actions .hc-account-menu > summary .hc-account-avatar-compact {
  background: linear-gradient(135deg, #7c5cff, #5ac8fa) !important;
  color: #fff !important;
  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, .18),
    0 5px 14px rgba(90, 120, 255, .24) !important;
}

.site-header .header-actions .hc-account-menu > summary .hc-account-menu-copy strong {
  color: #fff !important;
}

.site-header .header-actions .hc-account-menu > summary .hc-account-menu-copy small,
.site-header .header-actions .hc-account-menu > summary svg {
  color: rgba(236, 241, 250, .70) !important;
}

@media (prefers-reduced-motion: reduce) {
  .site-header .header-actions .hc-account-menu > summary {
    transition: none;
  }
  .site-header .header-actions .hc-account-menu > summary:hover {
    transform: none;
  }
}
</style>