---
import { ArrowUpRight, Check, ChevronDown, Languages, Menu } from "@lucide/astro";
import { site } from "../data/site";
import { latestHomeUpdate } from "../data/home-update-events";
import { localeConfig, siteLocales, type SiteLocale } from "../data/locales";
import { academyLogisticsOwnerRoutes, directionForOwnerPath, directionOwnerRoutes, isAcademyLogisticsOwnerPath, type DirectionId } from "../data/localized-direction-owners";
import hermesConnectSafePolishUrl from "../styles/hermes-connect-safe-polish.css?url";
import hermesRepairPublicShellUrl from "../styles/hermes-repair-public-shell.css?url";
import BeautyOwnerWorkspaceControls from "./BeautyOwnerWorkspaceControls.astro";
import HermesConnectAccountSwitcher from "./HermesConnectAccountSwitcher.astro";
import HermesConnectDomReady from "./HermesConnectDomReady.astro";
import HermesConnectExperience from "./HermesConnectExperience.astro";
import HermesConnectLauncher from "./HermesConnectLauncher.astro";
import DirectionProductNav from "./DirectionProductNav.astro";
import HermesConnectMark from "./HermesConnectMark.astro";

interface Props {
  theme?: "dark" | "light";
  activePath?: string;
  locale?: SiteLocale;
  contactHref?: string;
}

const { theme = "dark", activePath, locale: requestedPropLocale = "en", contactHref = "/contacts/" } = Astro.props;
const locale = requestedPropLocale;
// Localized routes (/ru/, /ua/, /es/, /it/, /fr/) whose template does not pass `locale` keep every
// href exactly as before (English link graph) but show visible labels in the page language.
const pathLocaleMatch = Astro.url.pathname.match(/^\/(ru|ua|es|it|fr)\//)?.[1];
const pathLocale = (pathLocaleMatch === "ua" ? "uk" : pathLocaleMatch) as typeof requestedPropLocale | undefined;
const currentPath = Astro.url.pathname;
const isApprovedHome = currentPath === "/";
const isApprovedProductsShell = currentPath === "/products/";
const isApprovedDirectionShell = isApprovedProductsShell || /^\/paths\/(logistics|technology|academy|marketing)\/$/.test(currentPath);
// One approved header across the public site (brand mark, Technology label, light glass pill);
// Hermes Connect product surfaces and demos keep their product header with the Connect launcher.
// Sign-in, registration and password pages are the public front door, so they share the approved header too.
const isConnectAuthEntry = /^\/(?:[a-z]{2}\/)?services\/hermes-connect\/(?:[a-z-]+\/)*(?:access|auth|forgot-password|reset-password)\/$/.test(currentPath);
// Indexable public Connect pages (product hub, Repair Shops landing/plan, support, load analyzer) are
// marketing surfaces, so they share the approved header; private workspaces keep the product header.
const isConnectPublicEntry = /^\/(?:[a-z]{2}\/)?services\/hermes-connect\/(?:load-analyzer\/|repair-shops\/|repair-shops\/plan\/|support\/)$/.test(currentPath);
const isConnectProductSurface = (/^\/(?:[a-z]{2}\/)?services\/hermes-connect\//.test(currentPath) && !isConnectAuthEntry && !isConnectPublicEntry) || currentPath.startsWith("/demos/");
const isApprovedVisualShell = isApprovedHome || isApprovedDirectionShell || !isConnectProductSurface;
const homeUpdates = isApprovedHome ? {
  academy: latestHomeUpdate("academy"),
  insights: latestHomeUpdate("insights"),
  connect: latestHomeUpdate("connect"),
  catalog: latestHomeUpdate("catalog"),
} : null;
const isHermesConnectRoute = currentPath.startsWith("/services/hermes-connect");
const isLoadBoardRoute = currentPath === "/load-board/" || currentPath.startsWith("/load-board/");
const isHermesConnectExperienceRoute = isHermesConnectRoute || isLoadBoardRoute;
const isRepairPrivateRoute = [
  "/services/hermes-connect/repair-shops/dashboard",
  "/services/hermes-connect/repair-shops/appointments",
  "/services/hermes-connect/repair-shops/customers",
  "/services/hermes-connect/repair-shops/vehicles",
  "/services/hermes-connect/repair-shops/services",
  "/services/hermes-connect/repair-shops/availability",
].some((prefix) => currentPath === prefix || currentPath.startsWith(`${prefix}/`));
const isAcademyPrivateRoute = [
  "/services/hermes-connect/academy/dashboard",
  "/services/hermes-connect/academy/lesson",
  "/services/hermes-connect/academy/program",
  "/services/hermes-connect/academy/progression",
  "/services/hermes-connect/academy/reviewer",
  "/services/hermes-connect/academy/submissions",
  "/services/hermes-connect/academy/support",
].some((prefix) => currentPath === prefix || currentPath.startsWith(`${prefix}/`));
const isBeautyPrivateRoute = currentPath === "/services/hermes-connect/beauty/workspace" || currentPath.startsWith("/services/hermes-connect/beauty/workspace/");
const privateWorkspace: "repair" | "academy" | "beauty" | null = isRepairPrivateRoute
  ? "repair"
  : isAcademyPrivateRoute
    ? "academy"
    : isBeautyPrivateRoute
      ? "beauty"
      : null;
const publicWorkspace: "repair" | "academy" | "beauty" | "neutral" = currentPath.startsWith("/services/hermes-connect/repair-shops")
  ? "repair"
  : currentPath.startsWith("/services/hermes-connect/academy")
    ? "academy"
    : currentPath.startsWith("/services/hermes-connect/beauty")
      ? "beauty"
      : "neutral";
const requestedLocale = Astro.url.searchParams.get("lang");
const isCatalogLocaleRoute = currentPath === "/businesses/" || currentPath.startsWith("/businesses/ukraine/");
const activeLocale = requestedLocale && ((isHermesConnectExperienceRoute && siteLocales.includes(requestedLocale as SiteLocale)) || (isCatalogLocaleRoute && (requestedLocale === "en" || requestedLocale === "uk")))
  ? requestedLocale as SiteLocale
  : locale;
const labelLocale = activeLocale !== "en" ? activeLocale : (pathLocale ?? "en");
const localizedLabels = {
  uk: { logistics: "Логістика", marketing: "Маркетинг", academy: "Академія", technology: "IT-розробка", contact: "Почати розмову", home: "Головна", signIn: "Увійти" },
  ru: { logistics: "Логистика", marketing: "Маркетинг", academy: "Академия", technology: "IT-разработка", contact: "Начать разговор", home: "Главная", signIn: "Войти" },
  es: { logistics: "Logística", marketing: "Marketing", academy: "Academia", technology: "Desarrollo IT", contact: "Iniciar una conversación", home: "Inicio", signIn: "Entrar" },
  it: { logistics: "Logistica", marketing: "Marketing", academy: "Academy", technology: "Sviluppo IT", contact: "Inizia una conversazione", home: "Home", signIn: "Accedi" },
  fr: { logistics: "Logistique", marketing: "Marketing", academy: "Académie", technology: "Développement IT", contact: "Démarrer une conversation", home: "Accueil", signIn: "Connexion" },
};
const productsCopy = {
  en: { menu: "Products", all: "All products", allNote: "Built and run by Hermes", connectNote: "AI operating system · live pilot", catalog: "Catalog", catalogNote: "Business directory", insights: "Insights", insightsNote: "News and case studies", opportunities: "Opportunities", opportunitiesNote: "Careers and partnerships" },
  uk: { menu: "Продукти", all: "Усі продукти", allNote: "Створені й працюють у Hermes", connectNote: "AI-система для бізнесу · живий пілот", catalog: "Каталог", catalogNote: "Каталог бізнесів", insights: "Новини", insightsNote: "Новини та кейси", opportunities: "Можливості", opportunitiesNote: "Кар'єра та партнерство" },
  ru: { menu: "Продукты", all: "Все продукты", allNote: "Созданы и работают в Hermes", connectNote: "AI-система для бизнеса · живой пилот", catalog: "Каталог", catalogNote: "Каталог бизнесов", insights: "Новости", insightsNote: "Новости и кейсы", opportunities: "Возможности", opportunitiesNote: "Карьера и партнёрство" },
  es: { menu: "Productos", all: "Todos los productos", allNote: "Creados y operados por Hermes", connectNote: "Sistema operativo con IA · piloto activo", catalog: "Catálogo", catalogNote: "Directorio de empresas", insights: "Insights", insightsNote: "Noticias y casos", opportunities: "Oportunidades", opportunitiesNote: "Empleo y alianzas" },
  it: { menu: "Prodotti", all: "Tutti i prodotti", allNote: "Creati e gestiti da Hermes", connectNote: "Sistema operativo con AI · pilota attivo", catalog: "Catalogo", catalogNote: "Elenco aziende", insights: "Insights", insightsNote: "Notizie e casi", opportunities: "Opportunità", opportunitiesNote: "Carriere e partnership" },
  fr: { menu: "Produits", all: "Tous les produits", allNote: "Conçus et exploités par Hermes", connectNote: "Système d'exploitation IA · pilote actif", catalog: "Catalogue", catalogNote: "Annuaire d'entreprises", insights: "Insights", insightsNote: "Actualités et études de cas", opportunities: "Opportunités", opportunitiesNote: "Carrières et partenariats" },
}[labelLocale];
const directionOrder: Record<string, number> = { logistics: 0, technology: 1, academy: 2, marketing: 3 };
const navDirectionId = (href: string) => href.match(/^paths\/([^/]+)\//)?.[1] ?? "";
const orderedNavigation = [...site.navigation].sort(
  (a, b) => (directionOrder[navDirectionId(a.href)] ?? 99) - (directionOrder[navDirectionId(b.href)] ?? 99),
);
const orderedPaths = [...site.paths].sort(
  (a, b) => (directionOrder[a.id] ?? 99) - (directionOrder[b.id] ?? 99),
);
const navigation = activeLocale === "en"
  ? orderedNavigation.map((item) => {
      const url = `/${item.href}`;
      const directionId = navDirectionId(item.href);
      const label = labelLocale !== "en" && directionId in localizedLabels[labelLocale as keyof typeof localizedLabels]
        ? localizedLabels[labelLocale as keyof typeof localizedLabels][directionId as keyof typeof localizedLabels.uk]
        : item.href === "paths/technology/" ? "Technology" : item.label;
      return { ...item, key: navDirectionId(item.href), label, url, active: (activePath ?? currentPath) === url };
    })
  : orderedPaths.map((path) => ({
      key: path.id,
      label: localizedLabels[activeLocale][path.id as keyof typeof localizedLabels.uk],
      url: directionOwnerRoutes[activeLocale][path.id as keyof typeof directionOwnerRoutes.en],
      active: currentPath === directionOwnerRoutes[activeLocale][path.id as keyof typeof directionOwnerRoutes.en],
    }));
const isCatalogRoute = currentPath === "/businesses/" || currentPath.startsWith("/businesses/");
const isInsightsRoute = currentPath === "/insights/" || currentPath.startsWith("/insights/");
const isOpportunitiesRoute = currentPath === "/opportunities/" || currentPath.startsWith("/opportunities/");
const contactLabel = labelLocale === "en" ? "Start a conversation" : localizedLabels[labelLocale as keyof typeof localizedLabels].contact;
const signInLabel = labelLocale === "en" ? "Sign in" : localizedLabels[labelLocale as keyof typeof localizedLabels].signIn;
// The Home and localized overview Products navigation must preserve Hermes Connect's
// supported ?lang= locale when crossing from a localized corporate page.
const connectProductHref = activeLocale === "en" ? "/services/hermes-connect/" : `/services/hermes-connect/?lang=${activeLocale}`;
const section = (["logistics", "marketing", "technology", "academy"] as DirectionId[]).find((slug) => currentPath.includes(`/paths/${slug}`));
const localizedOwnerDirection = directionForOwnerPath(currentPath);
const languageDirection = section ?? localizedOwnerDirection;
const academyLogisticsOwner = isAcademyLogisticsOwnerPath(currentPath);
const languageLinks = siteLocales.filter((language) => !isCatalogLocaleRoute || language === "en" || language === "uk").map((language) => {
  if (isCatalogLocaleRoute) {
    const params = new URLSearchParams(Astro.url.searchParams);
    if (language === "en") params.delete("lang");
    else params.set("lang","uk");
    const query = params.toString();
    return { locale:language, name:localeConfig[language].name, href:`${currentPath}${query ? `?${query}` : ""}` };
  }
  if (isHermesConnectExperienceRoute) {
    const params = new URLSearchParams(Astro.url.searchParams);
    if (language === "en") params.delete("lang");
    else params.set("lang", language);
    const query = params.toString();
    return {
      locale: language,
      name: localeConfig[language].name,
      href: `${currentPath}${query ? `?${query}` : ""}`,
    };
  }

  if (academyLogisticsOwner) {
    return {
      locale: language,
      name: localeConfig[language].name,
      href: academyLogisticsOwnerRoutes[language],
    };
  }

  if (languageDirection) {
    return {
      locale: language,
      name: localeConfig[language].name,
      href: directionOwnerRoutes[language][languageDirection],
    };
  }

  return {
    locale: language,
    name: localeConfig[language].name,
    href: localeConfig[language].path,
  };
});
---

{isHermesConnectExperienceRoute && <link rel="stylesheet" href={hermesConnectSafePolishUrl} />}
{isHermesConnectRoute && <link rel="stylesheet" href={hermesRepairPublicShellUrl} />}

<header class={`site-header site-header-${isApprovedVisualShell ? "light" : theme}`} data-header data-home-portal={isApprovedHome ? "true" : undefined} data-approved-visual-shell={isApprovedVisualShell ? "true" : undefined}>
  <a class="wordmark" href={activeLocale === "en" ? "/#top" : `${localeConfig[activeLocale].path}#top`} aria-label="Hermes home">
    {/* One brand mark on every public surface, Hermes Connect product pages included (owner directive 2026-10-27). */}
    <span class="wordmark-mark wordmark-mark-corporate"><img src="/brand/hermes-mark.svg" alt="Hermes logo" width="36" height="36" loading="eager" decoding="async" /></span>
    <span>{site.brand}</span>
  </a>

  <nav class="desktop-nav desktop-nav--ecosystem" aria-label="Primary navigation">
    {navigation.map((item) => <a class="nav-primary-link" data-nav-tone={item.key} href={item.url} aria-current={item.active ? "page" : undefined}>{item.label}{item.key === "academy" && homeUpdates?.academy && <span class="home-update-sheen" data-home-update={homeUpdates.academy.publishedAt} data-update-description="home-academy-update" hidden aria-hidden="true"></span>}</a>)}
    <details class="desktop-products-menu" data-hermes-products>
      <summary aria-controls="hermes-products-grid">{productsCopy.menu} <ChevronDown size={14} aria-hidden="true" /></summary>
      <div class="desktop-products-grid" id="hermes-products-grid" role="group" aria-label="Hermes products and opportunities">
        <a href="/products/" data-product="all-products" aria-current={isApprovedProductsShell ? "page" : undefined}>
          <strong>{productsCopy.all}</strong><span>{productsCopy.allNote}</span>
        </a>
        <a href={connectProductHref} data-product="connect" aria-current={isHermesConnectRoute ? "page" : undefined}>
          <strong><HermesConnectMark size={13} class="header-connect-mark" />Hermes Connect</strong><span>{productsCopy.connectNote}</span>
          {homeUpdates?.connect && <span class="home-update-sheen" data-home-update={homeUpdates.connect.publishedAt} data-update-description="home-connect-update" hidden aria-hidden="true"></span>}
        </a>
        <a href="/businesses/" data-product="catalog" aria-current={isCatalogRoute ? "page" : undefined}>
          <strong>{productsCopy.catalog}</strong><span>{productsCopy.catalogNote}</span>
          {homeUpdates?.catalog && <span class="home-update-sheen" data-home-update={homeUpdates.catalog.publishedAt} data-update-description="home-catalog-update" hidden aria-hidden="true"></span>}
        </a>
        <a href="/insights/" data-product="insights" aria-current={isInsightsRoute ? "page" : undefined}>
          <strong>{productsCopy.insights}</strong><span>{productsCopy.insightsNote}</span>
          {homeUpdates?.insights && <span class="home-update-sheen" data-home-update={homeUpdates.insights.publishedAt} data-update-description="home-insights-update" hidden aria-hidden="true"></span>}
        </a>
        <a href="/opportunities/" data-product="opportunities" aria-current={isOpportunitiesRoute ? "page" : undefined}>
          <strong>{productsCopy.opportunities}</strong><span>{productsCopy.opportunitiesNote}</span>
        </a>
      </div>
    </details>
  </nav>

  <div class="header-actions">
    {!isApprovedVisualShell && <HermesConnectLauncher
      variant="header"
      href="/services/hermes-connect/repair-shops/"
      label="Hermes Connect"
      sublabel="Repair Shops · current live pilot"
      locale={activeLocale}
      class="nav-tone-connect"
    />}
    <a class="header-login-link" data-hermes-sign-in href="/services/hermes-connect/access/">{signInLabel}</a>
    {privateWorkspace && <HermesConnectAccountSwitcher current={privateWorkspace} mode="menu" locale={activeLocale} />}
    {!privateWorkspace && <HermesConnectAccountSwitcher current={publicWorkspace} mode="menu" publicSafe locale={activeLocale} />}
    <details class="language-menu" data-language-menu>
      <summary aria-label={`Language: ${localeConfig[activeLocale].name}`}>
        <Languages size={16} aria-hidden="true" />
        <span>{localeConfig[activeLocale].name}</span>
        <ChevronDown size={15} aria-hidden="true" />
      </summary>
      <nav aria-label="Choose language">
        {languageLinks.map((item) => (
          <a href={item.href} lang={item.locale} aria-current={item.locale === activeLocale ? "page" : undefined}>
            <span>{item.name}</span>{item.locale === activeLocale && <Check size={15} aria-hidden="true" />}
          </a>
        ))}
      </nav>
    </details>
    <a class="header-cta" href={contactHref}>
      {contactLabel}
      <ArrowUpRight size={17} aria-hidden="true" />
    </a>
  </div>

  <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
    <Menu size={23} aria-hidden="true" />
  </button>

  <nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation" data-mobile-menu hidden>
    {navigation.map((item) => <a class="mobile-nav-pillar" data-nav-tone={item.key} href={item.url} aria-current={item.active ? "page" : undefined}>{item.label}{item.key === "academy" && homeUpdates?.academy && <span class="home-update-sheen" data-home-update={homeUpdates.academy.publishedAt} data-update-description="home-academy-update" hidden aria-hidden="true"></span>}</a>)}
    <details class="mobile-products-menu" data-hermes-products>
      <summary class="mobile-nav-pillar mobile-secondary-start">{productsCopy.menu} <ChevronDown size={17} aria-hidden="true" /></summary>
      <div class="mobile-products-grid" role="group" aria-label="Products">
        <a href="/products/" data-product="all-products" aria-current={isApprovedProductsShell ? "page" : undefined}>{productsCopy.all}</a>
        <a href={connectProductHref} data-product="connect" aria-current={isHermesConnectRoute ? "page" : undefined}><HermesConnectMark size={14} class="header-connect-mark" />Hermes Connect</a>
        <a href="/businesses/" data-product="catalog" aria-current={isCatalogRoute ? "page" : undefined}>{productsCopy.catalog}</a>
        <a href="/insights/" data-product="insights" aria-current={isInsightsRoute ? "page" : undefined}>{productsCopy.insights}</a>
        <a href="/opportunities/" data-product="opportunities" aria-current={isOpportunitiesRoute ? "page" : undefined}>{productsCopy.opportunities}</a>
      </div>
    </details>
    <a class="mobile-nav-pillar mobile-login-link" data-nav-tone="account" data-hermes-sign-in href="/services/hermes-connect/access/">{signInLabel}</a>
    {privateWorkspace && <div class="hc-mobile-account-panel"><HermesConnectAccountSwitcher current={privateWorkspace} locale={activeLocale} /></div>}
    {!privateWorkspace && <div class="hc-mobile-account-panel"><HermesConnectAccountSwitcher current={publicWorkspace} publicSafe locale={activeLocale} /></div>}
    <a href={contactHref}>{contactLabel}</a>
    <div class="mobile-language-switcher" aria-label="Choose language">
      <strong>{localeConfig[activeLocale].name}</strong>
      {languageLinks.map((item) => (
        <a href={item.href} lang={item.locale} aria-current={item.locale === activeLocale ? "page" : undefined}>
          <span>{item.name}</span>{item.locale === activeLocale && <Check size={15} aria-hidden="true" />}
        </a>
      ))}
    </div>
  </nav>
  {isApprovedDirectionShell && (section || isApprovedProductsShell) && <DirectionProductNav direction={section ?? "products"} theme="light" locale={activeLocale === "ru" ? "ru" : "en"} />}
  {isApprovedVisualShell && currentPath.startsWith("/businesses/") && !/^\/businesses\/(?:concepts|italy|ukraine|marketing-growth-audit-example)\//.test(currentPath) && <DirectionProductNav direction="catalog" theme="light" locale={activeLocale === "ru" || activeLocale === "uk" ? activeLocale : "en"} />}
  {isApprovedHome && <span class="home-update-descriptions"><span id="home-academy-update" hidden>New Academy update within the last seven days.</span><span id="home-insights-update" hidden>New Insight within the last seven days.</span><span id="home-connect-update" hidden>New Connect update within the last seven days.</span><span id="home-catalog-update" hidden>New Catalog update within the last seven days.</span></span>}
</header>
{isCatalogLocaleRoute && (
  <script is:inline define:vars={{ ukHeaderLabels: { Logistics: "Логістика", Technology: "IT-розробка", Academy: "Академія", Marketing: "Маркетинг", Products: "Продукти", "Sign in": "Увійти", "Start a conversation": "Почати розмову", "All products": "Усі продукти", "Built and run by Hermes": "Створені й працюють у Hermes", "AI operating system · live pilot": "AI-система для бізнесу · живий пілот", Catalog: "Каталог", "Business directory": "Каталог бізнесів", Insights: "Новини", "News and case studies": "Новини та кейси", Opportunities: "Можливості", "Careers and partnerships": "Кар'єра та партнерство" } }}>
    // Catalog pages switch to Ukrainian in the browser (?lang=uk). Translate the header's visible
    // labels to match; every href and canonical owner stays exactly as rendered.
    (() => {
      if (new URLSearchParams(location.search).get("lang") !== "uk") return;
      const header = document.querySelector(".site-header[data-header]");
      if (!header) return;
      const walker = document.createTreeWalker(header, NodeFilter.SHOW_TEXT);
      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
        const text = node.nodeValue.trim();
        if (text && Object.prototype.hasOwnProperty.call(ukHeaderLabels, text)) node.nodeValue = node.nodeValue.replace(text, ukHeaderLabels[text]);
      }
    })();
  </script>
)}

{isHermesConnectExperienceRoute && <HermesConnectExperience loadBoardContext={isLoadBoardRoute} />}
{isHermesConnectRoute && <HermesConnectDomReady />}
{isBeautyPrivateRoute && <BeautyOwnerWorkspaceControls />}

<script>
  const button = document.querySelector<HTMLElement>("[data-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const header = document.querySelector<HTMLElement>("[data-header]");
  // Keep an existing Home Services managed reviewer on the same Company when switching language.
  // The header is statically rendered; its locale hrefs cannot see runtime query parameters.
  if (["/services/hermes-connect/home-services/access/", "/services/hermes-connect/home-services/workspace/"].includes(location.pathname)) {
    const managed = new URLSearchParams(location.search).get("managed")?.trim().toLowerCase().replace(/[^a-z0-9-]/g, "") || "";
    if (managed) {
      document.querySelectorAll<HTMLAnchorElement>(".language-menu a[lang], .mobile-language-switcher a[lang]").forEach((anchor) => {
        const target = new URL(anchor.href, location.origin);
        if (target.origin !== location.origin || target.pathname !== location.pathname) return;
        target.searchParams.set("managed", managed);
        if (location.pathname.endsWith("/access/")) target.searchParams.set("mode", "login");
        anchor.href = `${target.pathname}${target.search}${target.hash}`;
      });
    }
  }


  const updateHeader = () => header?.classList.toggle("site-header-scrolled", window.scrollY > 28);
  if (location.pathname === "/") {
    document.querySelectorAll<HTMLElement>("[data-home-update]").forEach((sheen) => {
      const date = Date.parse(`${sheen.dataset.homeUpdate}T00:00:00Z`);
      const age = Date.now() - date;
      if (!Number.isFinite(date) || age < 0 || age > 7 * 86400_000) return;
      sheen.hidden = false;
      sheen.parentElement?.classList.add("has-home-update");
      const description = sheen.dataset.updateDescription;
      if (description) {
        document.getElementById(description)?.removeAttribute("hidden");
        sheen.parentElement?.setAttribute("aria-describedby", description);
      }
    });
  }
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  const closeMenu = (restoreFocus = false) => {
    button?.setAttribute("aria-expanded", "false");
    button?.setAttribute("aria-label", "Open navigation");
    if (menu) menu.hidden = true;
    if (restoreFocus) button?.focus();
  };

  button?.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMenu();
      return;
    }
    button.setAttribute("aria-expanded", "true");
    button.setAttribute("aria-label", "Close navigation");
    if (menu) {
      menu.hidden = false;
      menu.querySelector<HTMLElement>("a")?.focus();
    }
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => closeMenu());
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") closeMenu(true);
  });

  document.addEventListener("click", (event) => {
    if (button?.getAttribute("aria-expanded") !== "true") return;
    const target = event.target;
    if (target instanceof Node && !menu?.contains(target) && !button.contains(target)) closeMenu();
  });

  const productsMenus = document.querySelectorAll<HTMLDetailsElement>("[data-hermes-products]");
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    productsMenus.forEach((productsMenu) => {
      if (!productsMenu.open) return;
      productsMenu.open = false;
      productsMenu.querySelector<HTMLElement>("summary")?.focus();
    });
  });
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    productsMenus.forEach((productsMenu) => {
      if (productsMenu.open && !productsMenu.contains(event.target as Node)) productsMenu.open = false;
    });
  });

  const languageMenus = document.querySelectorAll<HTMLDetailsElement>("[data-language-menu]");
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    languageMenus.forEach((languageMenu) => {
      if (!languageMenu.contains(target)) languageMenu.open = false;
    });
  });
</script>

