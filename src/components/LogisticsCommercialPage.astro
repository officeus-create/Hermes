---
import { ArrowRight, Check, Mail, Phone } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

export type CommercialPageContent = {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  intro: string;
  image: string;
  imageAlt: string;
  audience: string[];
  benefits: { title: string; body: string }[];
  process: { title: string; body: string }[];
  faq: { question: string; answer: string }[];
  related: { label: string; href: string }[];
  primaryAction?: { label: string; href: string };
  handoffNote?: string;
};

interface Props { content: CommercialPageContent; }
const { content } = Astro.props;
const canonicalPath = Astro.url.pathname;
const absoluteUrl = `https://hermeslogisticsus.com${canonicalPath}`;
const email = "mailto:officeus@hermeslogisticsus.com";
const phone = "tel:+12623023626";
const organizationId = "https://hermeslogisticsus.com/#organization";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${absoluteUrl}#service`,
    name: content.h1,
    description: content.description,
    image: new URL(content.image, "https://hermeslogisticsus.com").toString(),
    provider: { "@id": organizationId },
    areaServed: { "@type": "Country", name: "United States" },
    url: absoluteUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Logistics", item: "https://hermeslogisticsus.com/paths/logistics/" },
      { "@type": "ListItem", position: 3, name: content.h1, item: absoluteUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: content.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout title={content.title} description={content.description} image={content.image} preloadImage={content.image} schema={schema}>
  <SiteHeader />
  <main id="main-content" class="commercial-page">
    <section class="commercial-hero">
      <div class="shell">
        <nav class="commercial-breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/paths/logistics/">Logistics</a><span aria-hidden="true">/</span>
          <span aria-current="page">{content.h1}</span>
        </nav>
        <div class="commercial-hero-grid">
          <div>
            <p class="eyebrow">{content.eyebrow}</p>
            <h1>{content.h1}</h1>
            <p class="commercial-lead">{content.intro}</p>
            <div class="commercial-actions">
              {content.primaryAction ? (
                <>
                  <a class="button button-primary" href={content.primaryAction.href} data-commercial-primary-cta>
                    {content.primaryAction.label}<ArrowRight size={18} aria-hidden="true" />
                  </a>
                  <a class="button button-ghost commercial-phone" href={email}><Mail size={18} aria-hidden="true" />Email Logistics Sales</a>
                  <a class="button button-ghost commercial-phone" href={phone}><Phone size={18} aria-hidden="true" />+1 (262) 302-3626</a>
                </>
              ) : (
                <>
                  <a class="button button-primary" href={email}><Mail size={18} aria-hidden="true" />Request logistics support</a>
                  <a class="button button-ghost commercial-phone" href={phone}><Phone size={18} aria-hidden="true" />+1 (262) 302-3626</a>
                </>
              )}
            </div>
            {content.handoffNote && <p class="commercial-handoff-note">{content.handoffNote}</p>}
          </div>
          <img src={content.image} alt={content.imageAlt} width="1400" height="1050" loading="eager" fetchpriority="high" decoding="async" sizes="(max-width: 800px) 100vw, 48vw" />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell commercial-narrow">
        <p class="eyebrow">Who this is for</p>
        <ul class="commercial-checks">{content.audience.map((item) => <li><Check size={18} aria-hidden="true" />{item}</li>)}</ul>
      </div>
    </section>

    <section class="section commercial-soft commercial-value-section">
      <div class="shell">
        <div class="section-heading"><p class="eyebrow">Operational value</p><h2>Clear coordination around real vehicle movement.</h2></div>
        <div class="commercial-grid" data-reveal>
          {content.benefits.map((item, index) => (
            <article style={`--commercial-pulse-delay:${index * 0.7}s`}>
              <span class="commercial-value-signal" aria-hidden="true"></span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <div class="section-heading"><p class="eyebrow">How it works</p><h2>A practical process with carrier control at every step.</h2></div>
        <ol class="commercial-process">{content.process.map((item, index) => <li><span>0{index + 1}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>)}</ol>
      </div>
    </section>

    <section class="section commercial-soft">
      <div class="shell commercial-narrow">
        <div class="section-heading"><p class="eyebrow">Frequently asked questions</p><h2>Important details before starting.</h2></div>
        <div class="commercial-faq">{content.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
      </div>
    </section>

    <section class="section">
      <div class="shell commercial-narrow">
        <p class="eyebrow">Related logistics pages</p>
        <nav class="commercial-related" aria-label="Related logistics services">{content.related.map((item) => <a href={item.href}>{item.label}<ArrowRight size={17} aria-hidden="true" /></a>)}</nav>
      </div>
    </section>

    <section class="section commercial-final-section" data-commercial-final-cta aria-labelledby="commercial-final-title">
      <div class="shell commercial-final-card">
        <div>
          <p class="eyebrow">Ready for the next step?</p>
          <h2 id="commercial-final-title">Move from research to a reviewed request.</h2>
          <p>{content.handoffNote ?? "Share the minimum business and transportation information so Logistics Sales can review the request and explain the next step without promising capacity, timing, rates, loads, or acceptance."}</p>
        </div>
        <div class="commercial-final-actions">
          {content.primaryAction ? (
            <a class="button button-primary" href={content.primaryAction.href} data-commercial-primary-cta>
              {content.primaryAction.label}<ArrowRight size={18} aria-hidden="true" />
            </a>
          ) : (
            <a class="button button-primary" href={email}><Mail size={18} aria-hidden="true" />Request logistics support</a>
          )}
          <a class="button" href={email}><Mail size={18} aria-hidden="true" />Email Logistics Sales</a>
          <a class="button" href={phone}><Phone size={18} aria-hidden="true" />+1 (262) 302-3626</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .commercial-page{background:#fff}.commercial-hero{padding:8.5rem 0 5rem;background:#071038;color:#fff}.commercial-breadcrumbs{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center;margin-bottom:2.2rem;color:rgba(255,255,255,.68);font-size:.82rem}.commercial-breadcrumbs a{color:inherit}.commercial-breadcrumbs a:hover{color:#fff}.commercial-breadcrumbs span[aria-current="page"]{max-width:46ch;color:#fff}.commercial-hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,5vw,5rem);align-items:center}.commercial-hero h1{max-width:13ch;font-size:clamp(2.7rem,6vw,5.4rem)}.commercial-lead{max-width:62ch;color:rgba(255,255,255,.78);font-size:1.18rem}.commercial-hero img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:8px}.commercial-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}.commercial-phone{border-color:rgba(255,255,255,.45);color:#fff}.commercial-handoff-note{max-width:68ch;margin-top:1rem;color:rgba(255,255,255,.68);font-size:.9rem;line-height:1.55}.commercial-narrow{max-width:900px}.commercial-soft{background:#f7f4ff}.commercial-value-section{position:relative;overflow:hidden}.commercial-value-section::before{content:"";position:absolute;inset:8% -20% auto;height:28rem;background:radial-gradient(circle,rgba(106,32,217,.1),transparent 68%);pointer-events:none}.commercial-value-section>.shell{position:relative}.commercial-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.commercial-grid article{position:relative;overflow:hidden;padding:1.5rem;background:#fff;border:1px solid #e8e2f6;border-radius:8px;box-shadow:0 .7rem 2rem rgba(7,16,56,.04);transition:transform 180ms ease,border-color 180ms ease,box-shadow 180ms ease}.commercial-grid article:hover,.commercial-grid article:focus-within{transform:translateY(-3px);border-color:rgba(106,32,217,.34);box-shadow:0 1rem 2.4rem rgba(7,16,56,.09)}.commercial-grid h3{padding-right:1.2rem;font-size:1.25rem}.commercial-value-signal{position:absolute;top:1rem;right:1rem;width:.42rem;height:.42rem;border-radius:999px;background:#6a20d9;box-shadow:0 0 .9rem rgba(106,32,217,.6);animation:commercial-value-pulse 5.8s ease-in-out infinite;animation-delay:var(--commercial-pulse-delay)}.commercial-checks{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;padding:0;list-style:none}.commercial-checks li{display:flex;gap:.65rem;align-items:flex-start}.commercial-process{display:grid;gap:1rem;padding:0;list-style:none}.commercial-process li{display:grid;grid-template-columns:54px 1fr;gap:1rem;padding:1.35rem;border-top:1px solid #ddd}.commercial-process span{font-family:var(--font-mono);color:#6a20d9}.commercial-faq details{padding:1rem 0;border-bottom:1px solid #ddd}.commercial-faq summary{cursor:pointer;font-weight:700}.commercial-related{display:grid;gap:.6rem}.commercial-related a{display:flex;justify-content:space-between;align-items:center;padding:1rem;border:1px solid #ddd;border-radius:6px}.commercial-final-section{padding-top:1rem;background:#fff}.commercial-final-card{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:center;padding:clamp(1.5rem,4vw,3rem);border:1px solid #dce3f8;border-radius:14px;background:#071038;color:#fff}.commercial-final-card h2{max-width:15ch}.commercial-final-card p:not(.eyebrow){max-width:70ch;color:rgba(255,255,255,.72);line-height:1.65}.commercial-final-actions{display:grid;gap:.65rem;min-width:min(100%,290px)}.commercial-final-actions .button:not(.button-primary){border-color:rgba(255,255,255,.42);color:#fff}@keyframes commercial-value-pulse{0%,66%,100%{opacity:.28;transform:scale(.82)}76%{opacity:1;transform:scale(1.18)}}@media(max-width:800px){.commercial-hero-grid,.commercial-grid,.commercial-checks,.commercial-final-card{grid-template-columns:1fr}.commercial-hero{padding-top:7.5rem}.commercial-hero h1{font-size:clamp(2.5rem,13vw,4rem)}.commercial-final-actions{width:100%}.commercial-final-actions .button{width:100%;justify-content:center}}@media(prefers-reduced-motion:reduce){.commercial-value-signal{animation:none;opacity:.45;transform:none}.commercial-grid article{transition:none}}
</style>
