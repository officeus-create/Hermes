---
import type { CatalogBusinessConcept } from "../data/catalog-business-concepts";
import { buildCatalogRequestHref } from "../lib/catalog-request";
import { site } from "../data/site";
type Props = { business: CatalogBusinessConcept; profileUrl: string };
const { business, profileUrl } = Astro.props;
const sales = site.paths.find((path) => path.id === "technology")?.directContacts?.[0];
const brief = buildCatalogRequestHref("catalog-growth", {
  businessId: business.id, businessName: business.name, profileUrl,
  city: business.locality, country: business.countryCode, sourceRef: business.sourceRef,
}, "Website concept") + "&concept=website";
---
<section class="demo" data-website-demo data-brief={brief}>
  <div class="disclosure"><strong>Website concept by Hermes / not the official business website</strong><span>Existing free pilot · proposed design</span></div>
  <nav class="demo-nav" aria-label="Concept navigation"><a href="#demo-home">{business.name}<span>North Little Rock · Arkansas</span></a><a href="#demo-services">Services</a><a class="demo-cta" href={brief}>Order a website like this ↗</a></nav>
  <section class="demo-hero" id="demo-home"><div><p class="eyebrow">American & Asian passenger / light vehicles</p><h1>A clearer road<br/><em>to car care.</em></h1><p class="intro">Explore {business.name} in {business.locality}: diagnostics, routine care and repairs, with the next step always easy to find.</p><div class="actions"><a class="demo-cta" href={brief}>Order a website like this <span>↗</span></a><a href="#demo-services">Explore services ↓</a></div><p class="demo-note">Try the buttons to discuss a website with Hermes. No appointment or payment is created.</p></div><aside class="art" aria-label="Original wheel illustration">
    <div class="scene-top"><span>THE CARE / CONNECTION</span><span>01—04</span></div>
    <svg class="care-wheel" viewBox="0 0 600 500" role="img" aria-label="An original wheel drawing connecting local details, services, mobile access and a clear inquiry">
      <defs><linearGradient id="rim" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#faf8f0"/><stop offset=".5" stop-color="#aab8bb"/><stop offset="1" stop-color="#e3e7e3"/></linearGradient><radialGradient id="tire"><stop offset=".7" stop-color="#243743"/><stop offset="1" stop-color="#0d1d28"/></radialGradient></defs>
      <g class="wheel-drawing" transform="translate(300 250)">
        <circle r="177" fill="none" stroke="#d1d3c9" stroke-dasharray="2 9"/>
        <circle r="150" fill="url(#tire)"/><circle r="139" fill="none" stroke="#677982" stroke-width="2" stroke-dasharray="1 7"/>
        <circle r="108" fill="url(#rim)"/><circle r="94" fill="#334b58"/>
        <g fill="url(#rim)"><path transform="rotate(0)" d="M-13-24 L-30-94 Q0-109 30-94 L13-24 Z"/><path transform="rotate(72)" d="M-13-24 L-30-94 Q0-109 30-94 L13-24 Z"/><path transform="rotate(144)" d="M-13-24 L-30-94 Q0-109 30-94 L13-24 Z"/><path transform="rotate(216)" d="M-13-24 L-30-94 Q0-109 30-94 L13-24 Z"/><path transform="rotate(288)" d="M-13-24 L-30-94 Q0-109 30-94 L13-24 Z"/></g>
        <circle r="33" fill="#ecede5" stroke="#152935" stroke-width="5"/><circle r="14" fill="#c84928"/>
        <g fill="#152935"><circle transform="rotate(0)" cx="0" cy="-23" r="3"/><circle transform="rotate(72)" cx="0" cy="-23" r="3"/><circle transform="rotate(144)" cx="0" cy="-23" r="3"/><circle transform="rotate(216)" cx="0" cy="-23" r="3"/><circle transform="rotate(288)" cx="0" cy="-23" r="3"/></g>
      </g>
      <g fill="none" stroke="#8d9c9b"><path d="M180 120H90V85"/><path d="M425 155H525V110"/><path d="M160 335H65V395"/><path d="M415 360H525V415"/></g>
      <g fill="#c84928"><circle cx="180" cy="120" r="5"/><circle cx="425" cy="155" r="5"/><circle cx="160" cy="335" r="5"/><circle cx="415" cy="360" r="5"/></g>
      <g class="wheel-label" fill="#152935"><text x="42" y="69">01 / LOCAL FACTS</text><text x="422" y="93">02 / SERVICES</text><text x="32" y="422">03 / MOBILE FIRST</text><text x="393" y="442">04 / CLEAR INQUIRY</text></g>
    </svg>
    <div class="scene-caption"><strong>Good care.<br/>Clear connections.</strong><span>Original website direction<br/>by Hermes</span></div>
  </aside></section>
  <div class="strip"><span>Diagnostics</span><span>Maintenance</span><span>Repair</span><span>North Little Rock, AR</span></div>
  <section class="services" id="demo-services"><header><p class="eyebrow">Find your starting point</p><h2>Care for the car<br/>you count on.</h2><p>Service categories based on public information. Scope, pricing and availability require confirmation with the business.</p></header><div class="service-grid">{business.services.slice(0, 4).map((service, i) => <button data-demo-action={service}><small>{String(i + 1).padStart(2, "0")}</small><strong>{service}</strong><span>Explore this service ↗</span></button>)}</div><details class="more-services"><summary>Explore all service categories <span>+</span></summary><div class="service-grid">{business.services.slice(4).map((service, i) => <button data-demo-action={service}><small>{String(i + 5).padStart(2, "0")}</small><strong>{service}</strong><span>Explore this service ↗</span></button>)}</div></details></section>
  <section class="visit"><div><p class="eyebrow">Local details</p><h2>Plan around<br/>your day.</h2><p>{business.address}<br/>{business.locality}, {business.region} {business.postalCode}</p><p>{business.phone} · business contact, shown for reference</p>{business.website && <a href={business.website} target="_blank" rel="noopener noreferrer">Visit the official business website ↗</a>}</div><div class="hours"><h3>Published hours</h3>{business.hours.map((line) => <p>{line}</p>)}<small>Owner fact review remains pending. This concept does not confirm appointment availability.</small><div class="actions">{sales && <a class="sales" href={sales.href}>Contact Hermes · {sales.value}</a>}</div></div></section>
  <footer class="demo-footer"><strong>A website built around your customers.</strong><a class="demo-cta" href={brief}>Order a website like this ↗</a><p>Kittle’s Garage is an existing Hermes free pilot client. This proposed website design is pending owner approval. The buttons demonstrate development inquiries to Hermes; appointments and payments are not enabled in this concept.</p></footer>
  <dialog data-demo-dialog aria-labelledby="demo-dialog-title"><button class="close" data-demo-close aria-label="Close development discussion">×</button><p class="eyebrow">Hermes website development</p><h2 id="demo-dialog-title" data-demo-title>Explore this feature</h2><p>This is a website concept. Hermes can scope this feature for your business; this button does not book a service or take a payment.</p>{sales && <a class="sales" href={sales.href}>Contact Hermes · {sales.value}</a>}<a class="brief" data-demo-brief href={brief}>Open a short development brief →</a><small>The brief is a request to Hermes about website development, not a request to {business.name}.</small></dialog>
</section>
<script>
  const root = document.querySelector<HTMLElement>("[data-website-demo]");
  const dialog = root?.querySelector<HTMLDialogElement>("[data-demo-dialog]");
  root?.querySelectorAll<HTMLButtonElement>("[data-demo-action]").forEach((button) => button.addEventListener("click", () => {
    if (!dialog) return;
    const feature = button.dataset.demoAction || "Website development";
    const title = dialog.querySelector<HTMLElement>("[data-demo-title]");
    if (title) title.textContent = `Discuss ${feature.toLowerCase()} with Hermes`;
    const link = dialog.querySelector<HTMLAnchorElement>("[data-demo-brief]");
    if (link && root.dataset.brief) {
      const url = new URL(root.dataset.brief, location.origin);
      url.searchParams.set("interest", feature);
      link.href = url.pathname + url.search;
    }
    if (!dialog.open) dialog.showModal();
  }));
  dialog?.querySelector("[data-demo-close]")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    const box = dialog.getBoundingClientRect();
    if (event.target === dialog && (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom)) dialog.close();
  });
</script>
<style>
.demo{color:#17252f;background:#f8f5ed;font-family:Arial,sans-serif}.disclosure{display:flex;justify-content:space-between;gap:12px;padding:14px 24px;background:#17252f;color:#fff;font-size:12px;line-height:1.5}.disclosure span{color:#c8d0d4}.demo-nav{display:flex;align-items:center;gap:24px;padding:26px clamp(20px,5vw,70px);border-bottom:1px solid #d8d6cd}.demo-nav>a:first-child{margin-right:auto;font-size:21px;font-weight:800}.demo-nav a{text-decoration:none;color:inherit}.demo-nav span{display:block;font-size:10px;letter-spacing:.08em;text-transform:uppercase;margin-top:5px;font-weight:400}.demo button,.demo .actions a{font:inherit;cursor:pointer}.demo-nav button,.actions button,.brief,.demo-footer button{border:0;background:#c84928;color:#fff;padding:14px 20px;font-weight:700;min-height:46px}.demo-hero{display:grid;grid-template-columns:1.2fr 1fr;gap:56px;align-items:center;padding:72px clamp(20px,5vw,70px)}.eyebrow{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#a93d22}.demo-hero h1{font-size:clamp(48px,6.7vw,88px);line-height:1.02;letter-spacing:-.055em;margin:18px 0 22px}.intro{font-size:17px;line-height:1.65;max-width:540px;color:#54616b}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px;align-items:center}.actions a{color:inherit;font-size:13px;font-weight:700;padding:12px 4px}.actions button span{margin-left:22px}.demo-note{font-size:11px;line-height:1.6;color:#65717b;max-width:400px}.art{background:#223946;color:#fff;min-height:430px;padding:32px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden}.art p{font-size:28px;font-weight:800;line-height:1.1;margin:24px 0 10px}.art small{font-size:10px;color:#c4d4dc}.wheel{width:245px;height:245px;border-radius:50%;border:30px solid #17252f;box-shadow:0 0 0 2px #71909f,0 0 0 17px #2e4958,inset 0 0 0 5px #71909f;background:repeating-conic-gradient(#b5c5ca 0deg 13deg,#2e4958 13deg 60deg);position:absolute;right:-12px;top:23px;transform:rotate(-12deg)}.wheel span{position:absolute;inset:65px;background:#c84928;border-radius:50%;border:7px solid #17252f}.strip{display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;border-top:1px solid #d8d6cd;border-bottom:1px solid #d8d6cd;padding:20px clamp(20px,5vw,70px);text-transform:uppercase;letter-spacing:.07em;font-size:11px;font-weight:700}.services,.visit{padding:65px clamp(20px,5vw,70px)}.services header{display:grid;grid-template-columns:1fr 1fr;column-gap:32px}.services header>.eyebrow{grid-column:1/-1}.services h2,.visit h2{font-size:clamp(34px,4vw,52px);letter-spacing:-.045em;line-height:1.08;margin:12px 0 28px}.services header>p:last-child{color:#54616b;line-height:1.7;align-self:center}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #d8d6cd;border-left:1px solid #d8d6cd}.service-grid button{display:grid;gap:22px;text-align:left;padding:26px;border:0;border-bottom:1px solid #d8d6cd;border-right:1px solid #d8d6cd;background:#fffdf7;color:#17252f}.service-grid button:hover{background:#f0e9dc}.service-grid small,.service-grid span{font-size:10px;color:#65717b}.service-grid strong{font-size:18px}.visit{display:grid;grid-template-columns:1fr 1fr;gap:40px;background:#ebe7dc}.visit p{line-height:1.7;color:#54616b}.visit a{font-size:12px;color:#a93d22}.hours{border-top:2px solid #17252f;padding-top:20px}.hours h3{margin-top:0}.hours small,dialog small{display:block;font-size:11px;line-height:1.6;color:#65717b}.actions .outline{border:1px solid #17252f;background:transparent;color:#17252f}.demo-footer{padding:40px clamp(20px,5vw,70px);background:#17252f;color:#fff;display:flex;gap:24px;align-items:center;flex-wrap:wrap}.demo-footer strong{font-size:24px;flex:1}.demo-footer p{width:100%;font-size:11px;color:#c4d4dc;line-height:1.7}dialog{margin:auto;width:min(540px,calc(100% - 32px));box-sizing:border-box;padding:32px;border:0;background:#fffdf7;color:#17252f;max-height:85vh;overflow:auto}dialog::backdrop{background:#17252fb3}.close{float:right;background:transparent;border:0;font-size:28px!important;padding:0 8px;min-height:44px}dialog h2{font-size:30px;line-height:1.15;clear:both}dialog>p:not(.eyebrow){font-size:14px;line-height:1.65;color:#54616b}.sales{display:block;color:#a93d22;overflow-wrap:anywhere;padding:14px 0;font-size:13px}.brief{display:block;text-decoration:none;font-size:13px;margin:8px 0 18px}.demo :focus-visible{outline:3px solid #df7a28;outline-offset:4px}@media(max-width:760px){.disclosure{flex-direction:column;padding:14px 20px}.demo-nav{gap:12px;flex-wrap:wrap}.demo-nav>a:first-child{width:100%;font-size:20px}.demo-hero{grid-template-columns:1fr;padding-top:38px;gap:26px}.demo-hero h1{font-size:54px}.art{min-height:300px}.wheel{width:205px;height:205px;top:22px;right:20px}.wheel span{inset:48px}.art p{font-size:24px;position:relative}.strip{gap:16px;justify-content:flex-start}.services,.visit{padding-top:42px;padding-bottom:42px}.services header,.visit{grid-template-columns:1fr}.service-grid{grid-template-columns:1fr 1fr}.service-grid button{padding:18px;gap:16px}.service-grid strong{font-size:15px}.demo-footer{align-items:flex-start}.demo-footer strong{flex-basis:100%}dialog{padding:24px}}

/* Bounded V4 concept skin: shared contracts and global tokens stay intact. */
.demo{font-family:var(--font-body);font-size:17px}.demo h1,.demo h2,.demo h3,.demo-nav>a:first-child,.scene-caption strong{font-family:var(--font-display)}
.disclosure{background:#ebe7dc;color:#17252f;font-size:13px;border-bottom:1px solid #d8d6cd}.disclosure span{color:#54616b}
.demo-hero{grid-template-columns:1.05fr 1fr;gap:20px;padding-top:64px;padding-bottom:64px}.demo-hero h1{font-size:clamp(54px,6.5vw,100px);line-height:1.04;letter-spacing:-.065em}.demo-hero h1 em{font-family:Georgia,serif;font-weight:400;letter-spacing:-.06em;color:#a93d22}
.eyebrow{font-size:13px}.intro{font-size:18px}.demo-note{font-size:14px}.demo-nav span{font-size:12px}.actions a{font-size:16px}
.art{background:radial-gradient(ellipse at 50% 45%,#fffdf7,#ebe7dc);color:#17252f;padding:24px;min-height:480px;justify-content:space-between;border:1px solid #d8d6cd;border-radius:50% 50% 0 0 / 10% 10% 0 0}
.scene-top,.scene-caption{display:flex;justify-content:space-between;gap:15px}.scene-top{font-size:12px;letter-spacing:.08em}.care-wheel{width:100%;height:auto;display:block;overflow:visible}.wheel-label{font-size:12px;font-family:var(--font-body);font-weight:700;letter-spacing:.04em}.scene-caption strong{font-size:25px;line-height:1.15}.scene-caption span{font-size:13px;align-self:end;color:#54616b;line-height:1.5;text-align:right}
.strip{font-size:13px}.service-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.service-grid button{padding:26px 20px;transition:background .2s,transform .2s}.service-grid button:hover{transform:translateY(-3px);background:#eee5d6}.service-grid small,.service-grid span{font-size:14px}.service-grid strong{font-size:20px}.more-services{margin-top:22px}.more-services summary{cursor:pointer;padding:18px 0;border-bottom:1px solid #b9beb6;font-size:17px;font-weight:600}.more-services summary span{float:right}.more-services .service-grid{margin-top:20px;grid-template-columns:repeat(3,minmax(0,1fr))}
.visit a,.hours small,dialog small,.sales,.brief,.demo-footer p{font-size:16px}.demo-footer{background:#e4e6dd;color:#17252f}.demo-footer p{color:#54616b}.demo-footer strong{font-size:30px}.demo button{transition:background .2s,box-shadow .2s}.demo button:hover{box-shadow:0 4px 0 #17252f22}dialog>p:not(.eyebrow){font-size:17px}
@media(prefers-reduced-motion:no-preference) and (min-width:761px){.wheel-drawing{animation:care-settle .9s ease-out both}@keyframes care-settle{from{opacity:.3;translate:0 16px}to{opacity:1;translate:0 0}}}
@media(max-width:1024px){.demo-hero{gap:24px}.art{min-height:390px;padding:18px}.service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.demo{font-size:16px}.demo-hero{grid-template-columns:1fr;padding-top:32px;padding-bottom:36px}.demo-hero h1{font-size:clamp(50px,12vw,78px)}.intro{font-size:17px}.art{min-height:0;padding:18px}.scene-caption strong{font-size:24px}.service-grid strong{font-size:18px}.service-grid button{padding:20px 16px;gap:16px}.more-services .service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.demo-footer strong{font-size:27px}.disclosure{font-size:13px}}
@media(prefers-reduced-motion:reduce){.demo *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
.demo .demo-cta{display:inline-flex;align-items:center;gap:12px;min-height:46px;background:#c84928;color:#fff;padding:14px 20px;font-size:16px;font-weight:700;text-decoration:none;transition:box-shadow .2s}.demo .demo-cta:hover{box-shadow:0 4px 0 #17252f22}.demo .demo-cta:focus-visible{outline:3px solid #df7a28;outline-offset:4px}</style>
