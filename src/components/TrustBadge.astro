---
import { site } from "../data/site";

const logistics = site.paths.find((p) => p.id === "logistics")!;
const phones = logistics.directContacts?.filter((c) => c.href.startsWith("tel:")) ?? [];
const badges = [
  { label: "Specialist teams", value: "4", note: "Logistics · Marketing · Academy · IT, each with a defined public path" },
  { label: "Coverage", value: "USA + International", note: "U.S. Logistics has a public U.S. phone; other directions are coordinated internationally by email" },
  { label: "Academy programs", value: "2 programs", note: "U.S. Logistics Operations and Marketing publish separate training paths and participation models" },
  { label: "Product maturity", value: "Clearly labeled", note: "Live products, prototypes, discovery work, and previews are identified instead of presented as the same thing" },
  { label: "Inquiry delivery", value: "Protected", note: "Website inquiries use the controlled Hermes email delivery workflow" },
];
---

<section class="trust-badge section" id="about" data-analytics-scope="home-trust">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Public operating facts</p>
      <h2>What Hermes makes clear before you contact us.</h2>
      <p>Scope, maturity, public contact channels, and participation models should be understandable without a sales call.</p>
    </div>
    <ul class="trust-badge-grid" data-reveal>
      {
        badges.map((b) => (
          <li>
            <p class="trust-label">{b.label}</p>
            <strong class="trust-value">{b.value}</strong>
            <p class="trust-note">{b.note}</p>
          </li>
        ))
      }
    </ul>
    <details class="trust-optional" data-case-id="home-trust-channels">
      <summary>Public Logistics contact channels</summary>
      <ul>
        {
          phones.map((c) => (
            <li>
              <a href={c.href}>
                {c.label}: {c.value}
              </a>
              — {c.note}
            </li>
          ))
        }
        {
          site.social.map((s) => (
            <li>
              <a href={s.href} rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</section>

<script>
  import { trackCaseOpened } from "../lib/analytics.ts";

  document.querySelectorAll<HTMLDetailsElement>("[data-analytics-scope='home-trust'] [data-case-id]").forEach((el) => {
    el.addEventListener("toggle", () => {
      if (el.open && el.dataset.caseId) trackCaseOpened(el.dataset.caseId);
    });
  });
</script>