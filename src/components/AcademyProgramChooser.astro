---
import { ArrowUpRight, BriefcaseBusiness, ChartNoAxesCombined, Route } from "@lucide/astro";

const programs = [
  {
    id: "logistics",
    label: "Logistics",
    eyebrow: "Operations pathway",
    title: "Learn how freight work moves from conversation to completed load.",
    body: "Build working knowledge of dispatch, carrier and broker communication, documents, equipment logic, and daily operating decisions.",
    practice: ["Call and message review", "Load lifecycle exercises", "Document and exception scenarios"],
    next: "Logistics operations and dispatch readiness",
    icon: Route,
  },
  {
    id: "marketing",
    label: "Marketing",
    eyebrow: "Growth pathway",
    title: "Connect positioning, content, campaigns, and sales follow-up.",
    body: "Learn to turn a business objective into a focused marketing workflow with clearer messages, useful content, lead handling, and review.",
    practice: ["Offer and audience diagnosis", "Content and campaign briefs", "Lead journey and reporting exercises"],
    next: "Marketing execution and growth operations",
    icon: ChartNoAxesCombined,
  },
  {
    id: "coo",
    label: "COO / Director",
    eyebrow: "Leadership pathway",
    title: "See the company as one operating system, not isolated departments.",
    body: "Develop practical understanding of departments, KPI, processes, execution control, analytics, decisions, and responsible scaling.",
    practice: ["Department and responsibility maps", "KPI and process diagnosis", "Case decisions and operating reviews"],
    next: "Operational leadership capability",
    icon: BriefcaseBusiness,
  },
];
---

<section class="section academy-programs" aria-labelledby="academy-programs-title" data-program-chooser>
  <div class="shell">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Choose a professional path</p>
        <h2 id="academy-programs-title">Three programs. Different responsibilities.</h2>
      </div>
      <p>Choose the operating environment you want to understand. Every path moves through awareness, understanding, and application.</p>
    </div>

    <div class="program-tabs" role="tablist" aria-label="Academy programs">
      {programs.map((program, index) => (
        <button
          type="button"
          role="tab"
          id={`program-tab-${program.id}`}
          aria-controls={`program-panel-${program.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? "0" : "-1"}
          data-program-tab={program.id}
        >
          <span>0{index + 1}</span>{program.label}
        </button>
      ))}
    </div>

    <div class="program-panels">
      {programs.map((program, index) => {
        const Icon = program.icon;
        return (
          <article
            role="tabpanel"
            id={`program-panel-${program.id}`}
            aria-labelledby={`program-tab-${program.id}`}
            data-program-panel={program.id}
            hidden={index !== 0}
          >
            <div class="program-main">
              <Icon size={30} aria-hidden="true" />
              <p>{program.eyebrow}</p>
              <h3>{program.title}</h3>
              <div>{program.body}</div>
            </div>
            <div class="program-practice">
              <p>Practice environment</p>
              <ul>{program.practice.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div class="program-next">
              <p>Capability direction</p>
              <strong>{program.next}</strong>
              <a href="#contact">Discuss this program <ArrowUpRight size={17} aria-hidden="true" /></a>
            </div>
          </article>
        );
      })}
    </div>

    <p class="program-disclaimer">Programs develop capability through structured learning and practice. They do not guarantee employment, promotion, or income.</p>
  </div>
</section>

<script>
  const chooser = document.querySelector("[data-program-chooser]");
  const tabs = [...(chooser?.querySelectorAll<HTMLButtonElement>("[data-program-tab]") ?? [])];
  const panels = [...(chooser?.querySelectorAll<HTMLElement>("[data-program-panel]") ?? [])];

  const activate = (tab: HTMLButtonElement) => {
    const id = tab.getAttribute("data-program-tab");
    tabs.forEach((item) => {
      const selected = item === tab;
      item.setAttribute("aria-selected", String(selected));
      item.setAttribute("tabindex", selected ? "0" : "-1");
    });
    panels.forEach((panel) => {
      panel.hidden = panel.getAttribute("data-program-panel") !== id;
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => activate(tab));
    tab.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
      event.preventDefault();
      const direction = event.key === "ArrowRight" ? 1 : -1;
      const next = tabs[(index + direction + tabs.length) % tabs.length];
      activate(next);
      next.focus();
    });
  });
</script>
