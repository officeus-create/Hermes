---
import { academyRecruitment, priorityGrowthCities } from "../data/hermes-catalog-offers";
interface Props { locale?: "en" | "uk"; }
const { locale = "en" } = Astro.props;
const uk = locale === "uk";
const c = uk ? {
 eyebrow: "Міжнародний набір · Hermes Business Academy", title: "Розвивайте навички. Допомагайте бізнесам зростати.",
 intro: "Приймаємо заявки на онлайн-навчання та розглядаємо кандидатів для майбутньої міжнародної мережі Hermes. Наша мета — залучати людей зі 110 країн, а не заявляти про вже відкриті офіси в кожній країні.",
 countries: "країн у плані міжнародного набору", months: "місяці онлайн-навчання маркетологів", directors: "операційних директорів — мета підготовки для всієї мережі",
 logistics: "Логістика США", logisticsBody: "Практичний шлях з операцій логістики США, диспетчеризації, комунікації та контрольованої практики на схвалених матеріалах.",
 marketing: "Маркетологи та майбутні представники", marketingBody: "Тримісячне онлайн-навчання: дослідження бізнесу й аудиторії, пропозиція, сайт і пошукова видимість, соціальні мережі, медіаплани, переговори та звітність. Після практики та оцінювання випускники можуть бути розглянуті для представництва Hermes у своєму ринку.",
 leadership: "Майбутні операційні директори", leadershipBody: "Мета — відібрати й підготувати 50 операційних директорів для майбутнього управління відділами та регіональними командами. Це загальна ціль для мережі, не 50 посад у кожній країні. Управління людьми й процесами починається з практики, оцінювання та окремого рішення про призначення.",
 sales: "Віддалені команди продажів", salesBody: "Пошук і дослідження компаній, розмова про потреби, підготовка медіаплану, презентація пропозиції, переговори та передача клієнта у виконання. Практика — на навчальних або дозволених кейсах; робота з реальними клієнтами потребує окремого допуску.",
 apply: "Подати заявку на маркетинг", leadershipCta: "Обговорити операційний напрям", salesCta: "Обговорити напрям продажів",
 citiesTitle: "Люди для роботи з конкретними ринками", citiesBody: "Лондон, Мілан, Нью-Йорк і Маямі — початкові орієнтири. Команди формуємо за мовою, часовим поясом, потребами клієнтів і готовністю до роботи, а не просто за кількістю країн.",
 cityCta: "Переглянути пріоритетні міста", flow: "Заявка → співбесіда → навчання → практика → оцінювання → можливе представництво",
 boundary: "110 країн і 50 директорів — цілі розвитку, не поточний штат і не гарантовані вакансії. Заявка не є зарахуванням; навчання не гарантує роботу, дохід, клієнтів або представництво. Дати, розклад, мова, вартість і правила участі погоджуються для конкретного набору. Допуск залежить від перевірки та застосовних вимог.",
} : {
 eyebrow: "International recruitment · Hermes Business Academy", title: "Grow your skills. Help businesses grow.",
 intro: "We are accepting applications for online training and reviewing candidates for the future Hermes international network. Our recruitment roadmap targets 110 countries; it is not a claim of established offices in each country.",
 countries: "countries in the recruitment roadmap", months: "months of online marketing training", directors: "operations directors — network-wide development goal",
 logistics: "U.S. Logistics", logisticsBody: "Practical learning in U.S. logistics operations, dispatch workflows, commercial communication and supervised practice using approved material.",
 marketing: "Marketers and future representatives", marketingBody: "Three-month online training in business and audience research, offers, websites and search visibility, social media, media planning, negotiations and reporting. After supervised practice and assessment, graduates may be considered for Hermes representative roles in their market.",
 leadership: "Future operations directors", leadershipBody: "Our goal is to select and train 50 operations directors to lead future departments and regional teams. This is one network-wide goal, not 50 positions in every country. Leadership responsibility follows practical assessment and a separate appointment decision.",
 sales: "Remote sales teams", salesBody: "Learn to research companies, understand business needs, build media plans, present proposals, negotiate and hand clients over to delivery teams. Practice uses training or approved cases; real client access requires separate authorization.",
 apply: "Apply for marketing training", leadershipCta: "Discuss the operations pathway", salesCta: "Discuss the sales pathway",
 citiesTitle: "Build teams around real markets", citiesBody: "London, Milan, New York and Miami are starting priorities. We group work by language, time zone, client demand and delivery readiness rather than assigning one team to every city.",
 cityCta: "Explore priority cities", flow: "Application → Interview → Training → Practice → Assessment → Possible representation",
 boundary: "110 countries and 50 directors are expansion goals, not current headcount or guaranteed vacancies. Application is not enrollment; training does not guarantee employment, income, clients or representation. Dates, schedule, language, price and participation terms are confirmed for each cohort. Eligibility remains subject to review and applicable requirements.",
};
const interestHref = (role: string) => `mailto:officeus@hermeslogisticsus.com?${new URLSearchParams({subject: `Hermes Academy — ${role} pathway`, body: "I would like to discuss this pathway.\nCountry and city:\nWorking languages:\nExperience:\nAvailability:\n"})}`;
---
<section class="academy-network" id="academy-global-network" data-academy-network aria-labelledby="academy-network-title">
 <div class="academy-network__shell">
  <header><p class="academy-network__eyebrow">{c.eyebrow}</p><h2 id="academy-network-title">{c.title}</h2><p>{c.intro}</p></header>
  <div class="academy-network__metrics"><div><strong>{academyRecruitment.countryTarget}</strong><span>{c.countries}</span></div><div><strong>{academyRecruitment.marketingMonths}</strong><span>{c.months}</span></div><div><strong>{academyRecruitment.operationsDirectorsTarget}</strong><span>{c.directors}</span></div></div>
  <div class="academy-network__tracks">
   <article data-network-track="logistics"><h3>{c.logistics}</h3><p>{c.logisticsBody}</p><a href={`/academy/apply/?program=us-logistics-operations${uk ? "&language=uk" : ""}`}>{uk ? "Подати заявку на логістику" : "Apply for logistics training"} →</a></article>
   <article data-network-track="marketing"><h3>{c.marketing}</h3><p>{c.marketingBody}</p><a href={`/academy/apply/?program=marketing${uk ? "&language=uk" : ""}`}>{c.apply} →</a></article>
   <article data-network-track="operations"><h3>{c.leadership}</h3><p>{c.leadershipBody}</p><a href={interestHref("operations director")}>{c.leadershipCta} →</a></article>
   <article data-network-track="sales"><h3>{c.sales}</h3><p>{c.salesBody}</p><a href={interestHref("remote sales")}>{c.salesCta} →</a></article>
  </div>
  <div class="academy-network__markets"><h3>{c.citiesTitle}</h3><p>{c.citiesBody}</p><a href="/businesses/#global-markets">{c.cityCta} ({priorityGrowthCities.length}) →</a></div>
  <p class="academy-network__flow">{c.flow}</p><p class="academy-network__boundary">{c.boundary}</p>
 </div>
</section>
<style>
.academy-network{padding:2rem 1rem;background:#f5f7fa;color:#172033;scroll-margin-top:150px}.academy-network__shell{width:min(1160px,100%);margin:auto}.academy-network header{max-width:860px}.academy-network__eyebrow{color:#275d8d!important;font-size:11px!important;text-transform:uppercase;letter-spacing:.09em;font-weight:850}.academy-network h2{margin:.5rem 0 1rem;font-size:clamp(29px,4vw,46px);line-height:1.08;letter-spacing:-.03em}.academy-network p{color:#4b5b70;line-height:1.65;font-size:15px}.academy-network__metrics,.academy-network__tracks{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:22px}.academy-network__metrics>div{display:grid;gap:5px;padding:20px;background:#eaf1fb;border:1px solid #d8e3f0;border-radius:15px}.academy-network__metrics strong{font-size:36px;color:#224d82}.academy-network__metrics span{font-size:13px;line-height:1.4;color:#4b5b70}.academy-network__tracks article{display:flex;flex-direction:column;min-width:0;padding:22px;border:1px solid #dce4ed;border-radius:17px;background:#fff}.academy-network h3{font-size:22px;line-height:1.2;margin:0 0 9px}.academy-network a{display:inline-flex;align-items:center;min-height:44px;font-weight:750;color:#165c9b;text-decoration:underline;text-underline-offset:4px}.academy-network__tracks a{margin-top:auto}.academy-network__markets{margin-top:20px;padding:24px;border-left:3px solid #5986bf;background:#edf4fc}.academy-network__flow{padding-top:18px;font-weight:750}.academy-network .academy-network__boundary{font-size:12px;max-width:1040px}.academy-network a:focus-visible{outline:2px solid #165c9b;outline-offset:4px}@media(max-width:760px){.academy-network__tracks{grid-template-columns:1fr}.academy-network__metrics{grid-template-columns:1fr}.academy-network h2,.academy-network h3,.academy-network p{overflow-wrap:anywhere}}
</style>
