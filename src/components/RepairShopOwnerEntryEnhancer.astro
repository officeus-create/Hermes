<script is:inline>
  (() => {
    const repairRoot = "/services/hermes-connect/repair-shops";
    const path = window.location.pathname.replace(/\/+$/, "");
    if (path !== repairRoot) return;

    const supported = new Set(["en", "ru", "uk", "es", "it", "fr"]);
    const requested = new URLSearchParams(window.location.search).get("lang") || "en";
    const locale = supported.has(requested) ? requested : "en";
    const copy = {
      en: { prompt: "Already registered? Use your existing owner account.", action: "Sign in to my shop" },
      ru: { prompt: "Уже зарегистрированы? Войдите в существующий аккаунт владельца.", action: "Войти в кабинет СТО" },
      uk: { prompt: "Вже зареєстровані? Увійдіть до наявного акаунта власника.", action: "Увійти до кабінету СТО" },
      es: { prompt: "¿Ya estás registrado? Entra con tu cuenta de propietario.", action: "Iniciar sesión en mi taller" },
      it: { prompt: "Sei già registrato? Accedi con il tuo account proprietario.", action: "Accedi alla mia officina" },
      fr: { prompt: "Déjà inscrit ? Connectez-vous avec votre compte propriétaire.", action: "Se connecter à mon atelier" },
    };
    const t = copy[locale] || copy.en;

    const withLocale = (href) => {
      const url = new URL(href, window.location.origin);
      if (locale === "en") url.searchParams.delete("lang");
      else url.searchParams.set("lang", locale);
      return `${url.pathname}${url.search}`;
    };

    const replaceVisibleText = (link, value) => {
      const textNode = Array.from(link.childNodes).find((node) => node.nodeType === Node.TEXT_NODE);
      if (textNode) textNode.textContent = `${value} `;
      else link.insertBefore(document.createTextNode(`${value} `), link.firstChild);
    };

    const install = () => {
      const heroActions = document.querySelector(".repair-live-hero .repair-actions");
      const heroPrimary = heroActions?.querySelector(".repair-primary");
      if (!(heroActions instanceof HTMLElement) || !(heroPrimary instanceof HTMLAnchorElement)) return false;

      heroPrimary.dataset.repairOwnerSignin = "true";
      heroPrimary.href = withLocale(`${repairRoot}/auth/?mode=login`);
      heroPrimary.setAttribute("aria-label", t.action);
      replaceVisibleText(heroPrimary, t.action);

      let prompt = document.querySelector("[data-repair-owner-prompt]");
      if (!(prompt instanceof HTMLElement)) {
        prompt = document.createElement("p");
        prompt.dataset.repairOwnerPrompt = "true";
        prompt.className = "repair-owner-prompt";
        heroActions.insertAdjacentElement("beforebegin", prompt);
      }
      prompt.textContent = t.prompt;

      // The launch card keeps the registration CTA. Its second owner-login CTA is
      // removed on the landing route so there is one clear, accessible sign-in path.
      document.querySelector("[data-repair-free-launch] [data-owner-cta]")?.remove();
      return true;
    };

    if (!install()) requestAnimationFrame(() => install());
    window.setTimeout(() => install(), 100);
  })();
</script>

<style is:global>
  .repair-owner-prompt {
    margin: 18px 0 9px;
    color: #111827;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.45;
  }
  .repair-live-hero [data-repair-owner-signin] {
    min-height: 48px;
    box-shadow: 0 12px 30px rgba(17,24,39,.14);
  }
  .repair-live-hero [data-repair-owner-signin]:focus-visible {
    outline: 3px solid rgba(124,92,255,.4);
    outline-offset: 3px;
  }
  @media (max-width: 560px) {
    .repair-owner-prompt { margin-top: 16px; font-size: 14px; }
    .repair-live-hero [data-repair-owner-signin] {
      width: 100%;
      box-sizing: border-box;
      justify-content: center;
    }
  }
</style>
