<script is:inline>
  (() => {
    const repairRoot = "/services/hermes-connect/repair-shops";
    const path = window.location.pathname.replace(/\/+$/, "");
    if (path !== repairRoot) return;

    const supported = new Set(["en", "ru", "uk", "es", "it", "fr"]);
    const requested = new URLSearchParams(window.location.search).get("lang") || "en";
    const locale = supported.has(requested) ? requested : "en";
    const copy = {
      en: { prompt: "Already registered?", action: "Sign in to my shop", aria: "Repair Shop owner sign in" },
      ru: { prompt: "Уже зарегистрированы?", action: "Войти в кабинет СТО", aria: "Вход владельца СТО" },
      uk: { prompt: "Вже зареєстровані?", action: "Увійти до кабінету СТО", aria: "Вхід власника СТО" },
      es: { prompt: "¿Ya estás registrado?", action: "Iniciar sesión en mi taller", aria: "Acceso del propietario del taller" },
      it: { prompt: "Sei già registrato?", action: "Accedi alla mia officina", aria: "Accesso proprietario officina" },
      fr: { prompt: "Déjà inscrit ?", action: "Se connecter à mon atelier", aria: "Connexion propriétaire d’atelier" },
    };
    const t = copy[locale] || copy.en;

    const withLocale = (href) => {
      const url = new URL(href, window.location.origin);
      if (locale === "en") url.searchParams.delete("lang");
      else url.searchParams.set("lang", locale);
      return `${url.pathname}${url.search}`;
    };

    const install = () => {
      if (document.querySelector("[data-repair-owner-entry]")) return true;
      const hero = document.querySelector(".repair-live-hero");
      const lead = hero?.querySelector(".repair-lead");
      if (!(lead instanceof HTMLElement)) return false;

      const entry = document.createElement("aside");
      entry.className = "repair-owner-entry";
      entry.dataset.repairOwnerEntry = "true";
      entry.setAttribute("aria-label", t.aria);

      const prompt = document.createElement("span");
      prompt.className = "repair-owner-entry__prompt";
      prompt.textContent = t.prompt;

      const link = document.createElement("a");
      link.className = "repair-owner-entry__action";
      link.dataset.repairOwnerSignin = "true";
      link.href = withLocale(`${repairRoot}/auth/`);
      link.textContent = t.action;

      entry.append(prompt, link);
      lead.insertAdjacentElement("beforebegin", entry);
      return true;
    };

    if (!install()) {
      requestAnimationFrame(() => install());
      window.setTimeout(() => install(), 100);
    }
  })();
</script>

<style is:global>
  .repair-owner-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin: 22px 0 18px;
    padding: 12px 14px 12px 16px;
    border: 1px solid rgba(124,92,255,.24);
    border-radius: 18px;
    background: rgba(255,255,255,.82);
    box-shadow: 0 12px 34px rgba(31,41,55,.08);
    color: #111827;
  }
  .repair-owner-entry__prompt {
    font-size: 15px;
    font-weight: 800;
    line-height: 1.35;
  }
  .repair-owner-entry__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 11px 16px;
    border-radius: 13px;
    background: #111827;
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 850;
    line-height: 1.2;
    white-space: nowrap;
  }
  .repair-owner-entry__action:hover { background: #24194f; }
  .repair-owner-entry__action:focus-visible {
    outline: 3px solid rgba(124,92,255,.38);
    outline-offset: 3px;
  }
  @media (max-width: 560px) {
    .repair-owner-entry {
      align-items: stretch;
      flex-direction: column;
      margin: 18px 0 16px;
      padding: 14px;
    }
    .repair-owner-entry__action {
      width: 100%;
      min-height: 48px;
      box-sizing: border-box;
      white-space: normal;
    }
  }
</style>
