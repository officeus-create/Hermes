---
import { ArrowRight, Check, Clipboard, FileSignature, MessageSquareText, Phone, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const pageUrl = "https://hermeslogisticsus.com/carrier/";
const shareUrl = "https://hermeslogisticsus.com/sign/";
const salesPhone = "+12623023626";
const smsCopy = `Hermes Logistics: here is the private carrier link we discussed. Review the working model, see what stays under your control, and continue from your phone: ${shareUrl}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Hermes Carrier Agreement",
  description: "A private Hermes Logistics page for understanding carrier support, reviewing the agreement, and continuing to a carrier-specific review packet.",
  url: pageUrl,
  isPartOf: { "@id": "https://hermeslogisticsus.com/#website" },
};
---

<BaseLayout
  title="Carrier Agreement | Hermes Logistics"
  description="Review the carrier-support model, understand what stays under your control, and continue to a carrier-specific Appendix A review packet."
  robots="noindex,nofollow"
  schema={schema}
>
  <SiteHeader activePath="/paths/logistics/" />
  <main id="main-content" class="carrier-signing-entry" data-carrier-entry data-carrier-short-url={pageUrl}>
    <section class="carrier-entry-hero">
      <div class="carrier-rails" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      <div class="shell carrier-entry-grid">
        <div>
          <p class="eyebrow">Hermes Logistics · Carrier support</p>
          <h1>Keep control. Add a dispatch team.</h1>
          <p class="carrier-entry-lead">
            Review the working model in plain English, choose the support level, confirm the company and exact Appendix A percentage, and sign the review packet from your phone. The carrier keeps every final operating decision.
          </p>
          <div class="carrier-trust-strip" aria-label="Carrier agreement commitments">
            <span><Check size={17} aria-hidden="true" />You approve every load</span>
            <span><Check size={17} aria-hidden="true" />Non-exclusive · no minimum volume</span>
            <span><Check size={17} aria-hidden="true" />Freight funds go to your company or factor</span>
            <span><ShieldCheck size={17} aria-hidden="true" />No passwords, W-9, bank data, or CDL image here</span>
          </div>
          <div class="carrier-entry-actions">
            <a class="button carrier-primary" href="/logistics/carrier-onboarding/" data-commercial-primary-cta data-service-group="carrier_contract">
              Review and sign <FileSignature size={18} aria-hidden="true" />
            </a>
            <a class="button carrier-secondary" href="/logistics/carrier-offer/">See what Hermes handles</a>
            <a class="button carrier-call" href={`tel:${salesPhone}`}><Phone size={18} aria-hidden="true" />Call Logistics Sales</a>
          </div>
          <p class="carrier-guidance">Review calmly. Continue only after the control, percentage, and Appendix A terms are clear.</p>
          <p class="carrier-boundary">The current v3 document is an attorney-review draft. The system cannot label a packet as a final executed agreement until an approved master version, matching file hash, allowed percentage, and production execution controls are activated.</p>
        </div>

        <aside class="carrier-next-card" aria-label="Three carrier agreement steps">
          <p class="eyebrow">Three clear steps</p>
          <strong>Understand first. Sign second.</strong>
          <ol>
            <li><span>1</span><div><b>Review the working model</b><small>Control, scope, payment flow, termination, and the no-guarantee boundary.</small></div></li>
            <li><span>2</span><div><b>Confirm company and percentage</b><small>Legal company, MC or USDOT, authorized signer, website, and the exact Appendix A percentage.</small></div></li>
            <li><span>3</span><div><b>Sign and keep the PDF</b><small>Electronic consent, drawn signature, document identifiers, and a downloadable review copy.</small></div></li>
          </ol>
          <a href="/logistics/carrier-agreement/">Read the full v3 attorney-review draft <ArrowRight size={16} aria-hidden="true" /></a>
        </aside>
      </div>
    </section>

    <section class="section carrier-confidence" aria-labelledby="carrier-confidence-title">
      <div class="shell">
        <div class="section-heading carrier-heading">
          <p class="eyebrow">What the signature does</p>
          <h2 id="carrier-confidence-title">It authorizes support. It does not hand over your company.</h2>
          <p>Hermes may research, communicate, negotiate within your instructions, and coordinate ordinary documents. The carrier remains responsible for transportation, safety, drivers, equipment, insurance, routes, compliance, and final approval.</p>
        </div>
        <div class="confidence-grid">
          <article><Check size={22} aria-hidden="true" /><h3>Limited authority</h3><p>Hermes acts only within the selected administrative and dispatch scope. No brokerage or re-brokering authority is created.</p></article>
          <article><Check size={22} aria-hidden="true" /><h3>Clear percentage</h3><p>The master agreement has no fixed rate. The exact percentage must appear in the carrier-specific Appendix A before signing.</p></article>
          <article><Check size={22} aria-hidden="true" /><h3>Simple exit</h3><p>The proposed v3 structure is non-exclusive and allows either party to terminate with written notice while completed work is reconciled.</p></article>
          <article><Check size={22} aria-hidden="true" /><h3>No personal collateral package</h3><p>The v3 draft does not add a personal guaranty, UCC lien, automatic card debit, confession of judgment, or hidden freight-fund transfer.</p></article>
        </div>
      </div>
    </section>

    <section class="section carrier-share" aria-labelledby="carrier-share-title">
      <div class="shell carrier-share-card">
        <div>
          <p class="eyebrow">One clean link for SMS, WhatsApp, Telegram, or email</p>
          <h2 id="carrier-share-title">Send hermeslogisticsus.com/sign</h2>
          <p>The shared URL never contains the carrier name, email, phone, MC/USDOT, percentage, plan, representative code, offer code, or tracking identifier. Personalized execution will use an opaque, signed, expiring server-side token after that system is approved.</p>
          <p class="share-status" data-carrier-share-status aria-live="polite"></p>
        </div>
        <div class="carrier-share-actions">
          <button class="button carrier-primary" type="button" data-carrier-share><MessageSquareText size={18} aria-hidden="true" />Share link</button>
          <button class="button" type="button" data-carrier-copy><Clipboard size={18} aria-hidden="true" />Copy SMS text</button>
          <a class="button" href="#" data-carrier-sms><MessageSquareText size={18} aria-hidden="true" />Open SMS</a>
        </div>
      </div>
    </section>

    <section class="section carrier-final">
      <div class="shell carrier-final-card">
        <div>
          <p class="eyebrow">Ready to continue</p>
          <h2>Confirm the exact terms and complete the review packet from your phone.</h2>
          <p>Questions can be resolved with Logistics Sales before signature. No false deadline, promise of loads, or hidden condition is used to pressure the carrier.</p>
        </div>
        <div class="carrier-final-actions">
          <a class="button carrier-primary" href="/logistics/carrier-onboarding/">Review and sign <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="button carrier-call" href={`tel:${salesPhone}`}><Phone size={18} aria-hidden="true" />Call +1 (262) 302-3626</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script define:vars={{ shareUrl, smsCopy }}>
  const status = document.querySelector("[data-carrier-share-status]");
  const setStatus = (message) => { if (status instanceof HTMLElement) status.textContent = message; };
  const copyText = async (value) => {
    try {
      await navigator.clipboard.writeText(value);
      return true;
    } catch {
      const field = document.createElement("textarea");
      field.value = value;
      field.setAttribute("readonly", "");
      field.style.position = "fixed";
      field.style.opacity = "0";
      document.body.append(field);
      field.select();
      const copied = document.execCommand("copy");
      field.remove();
      return copied;
    }
  };

  document.querySelector("[data-carrier-copy]")?.addEventListener("click", async () => {
    setStatus(await copyText(smsCopy) ? "SMS text copied." : shareUrl);
  });

  document.querySelector("[data-carrier-share]")?.addEventListener("click", async () => {
    if (navigator.share) {
      try {
        await navigator.share({ title: "Hermes carrier agreement", text: smsCopy, url: shareUrl });
        setStatus("Share menu opened.");
        return;
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") return;
      }
    }
    setStatus(await copyText(smsCopy) ? "Share text copied." : shareUrl);
  });

  const smsLink = document.querySelector("[data-carrier-sms]");
  if (smsLink instanceof HTMLAnchorElement) {
    const separator = /iPad|iPhone|iPod/.test(navigator.userAgent) ? "&" : "?";
    smsLink.href = `sms:${separator}body=${encodeURIComponent(smsCopy)}`;
  }
</script>

<style>
  .carrier-signing-entry{background:#fff;color:#10204e}.carrier-entry-hero{position:relative;overflow:hidden;padding:8.5rem 0 5rem;background:radial-gradient(circle at 84% 10%,rgba(103,91,255,.35),transparent 34%),radial-gradient(circle at 8% 90%,rgba(36,166,154,.14),transparent 30%),#071038;color:#fff}.carrier-rails{position:absolute;top:5.35rem;right:0;left:0;display:grid;grid-template-columns:repeat(4,1fr);height:8px}.carrier-rails span:nth-child(1){background:#071038}.carrier-rails span:nth-child(2){background:#675bff}.carrier-rails span:nth-child(3){background:#d7529b}.carrier-rails span:nth-child(4){background:#24a69a}.carrier-entry-grid{display:grid;grid-template-columns:minmax(0,1.16fr) minmax(320px,.72fr);gap:clamp(2rem,5vw,5rem);align-items:center}.carrier-entry-hero h1{max-width:11ch;font-size:clamp(3.4rem,7.4vw,6.6rem);line-height:.94;letter-spacing:-.045em}.carrier-entry-lead{max-width:71ch;color:rgba(255,255,255,.84);font-size:clamp(1rem,2vw,1.22rem);line-height:1.72}.carrier-trust-strip{display:flex;flex-wrap:wrap;gap:.62rem;margin-top:1.35rem}.carrier-trust-strip span{display:flex;gap:.42rem;align-items:center;padding:.6rem .74rem;border:1px solid rgba(104,231,164,.26);border-radius:999px;background:rgba(47,158,98,.12);color:#eafff2;font-size:.82rem;font-weight:750}.carrier-trust-strip svg{flex:none;color:#68e7a4}.carrier-entry-actions{display:flex;flex-wrap:wrap;gap:.72rem;margin-top:1.65rem}.carrier-entry-actions .button{min-height:3.2rem}.carrier-primary{border:0!important;background:linear-gradient(135deg,#7564ff,#a94ee8 56%,#e25291)!important;color:#fff!important;box-shadow:0 15px 38px rgba(117,82,255,.32)}.carrier-secondary{border-color:rgba(255,255,255,.42)!important;color:#fff!important}.carrier-call{border-color:rgba(104,231,164,.42)!important;background:rgba(47,158,98,.15)!important;color:#effff5!important}.carrier-guidance{margin-top:1rem;color:#c9c4ff;font-size:.86rem;font-weight:750}.carrier-boundary{max-width:72ch;color:rgba(255,255,255,.58);font-size:.78rem;line-height:1.55}.carrier-next-card{padding:1.55rem;border:1px solid rgba(255,255,255,.23);border-radius:18px;background:rgba(255,255,255,.08);box-shadow:0 28px 80px rgba(0,0,0,.22);backdrop-filter:blur(14px)}.carrier-next-card>strong{display:block;font-size:1.6rem}.carrier-next-card ol{display:grid;gap:1rem;margin:1.25rem 0;padding:0;list-style:none}.carrier-next-card li{display:grid;grid-template-columns:auto 1fr;gap:.75rem}.carrier-next-card li>span{display:grid;width:2.15rem;height:2.15rem;place-items:center;border-radius:50%;background:#7564ff;color:#fff;font-weight:900}.carrier-next-card b,.carrier-next-card small{display:block}.carrier-next-card small{margin-top:.17rem;color:rgba(255,255,255,.65);line-height:1.48}.carrier-next-card>a{display:inline-flex;gap:.4rem;align-items:center;color:#fff;font-weight:800}.carrier-confidence{background:#f5f7ff}.carrier-heading{max-width:850px}.carrier-heading>p:not(.eyebrow){color:#5b6885;line-height:1.7}.confidence-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.confidence-grid article{padding:1.35rem;border:1px solid #dce3f8;border-radius:14px;background:#fff}.confidence-grid svg{color:#2f9e62}.confidence-grid h3{font-size:1.25rem}.confidence-grid p{color:#5b6885;line-height:1.6}.carrier-share-card,.carrier-final-card{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:center;padding:clamp(1.5rem,4vw,3rem);border:1px solid #dce3f8;border-radius:16px;background:#fff}.carrier-share-actions,.carrier-final-actions{display:flex;flex-wrap:wrap;gap:.65rem;justify-content:flex-end}.carrier-share-actions button{font:inherit;cursor:pointer}.share-status{min-height:1.2rem;color:#2f7f54;font-weight:800}.carrier-final{padding-top:1rem}.carrier-final-card{border-color:#071038;background:#071038;color:#fff}.carrier-final-card p:not(.eyebrow){max-width:70ch;color:rgba(255,255,255,.7);line-height:1.65}@media(max-width:980px){.confidence-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:900px){.carrier-entry-grid,.carrier-share-card,.carrier-final-card{grid-template-columns:1fr}.carrier-share-actions,.carrier-final-actions{justify-content:flex-start}}@media(max-width:620px){.carrier-entry-hero{padding-top:7.5rem}.carrier-entry-actions .button,.carrier-share-actions .button,.carrier-final-actions .button{width:100%;justify-content:center}.confidence-grid{grid-template-columns:1fr}.carrier-next-card{padding:1.15rem}}
</style>