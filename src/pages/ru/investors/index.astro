---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
const areas = [
  {title:"Логистика США и собственный автопарк",stage:"Действующее операционное направление",detail:"Работа с перевозчиками, автовозами и партнерами. Расширение парка рассматривается отдельно от технологических инвестиций; историческая экономика и условия финансирования проходят проверку.",href:"/paths/logistics/"},
  {title:"Load Board и аналитика логистики",stage:"Разработка продукта",detail:"Поиск грузов из разрешенных источников, анализ маршрутов, проверка актуальности предложений и инструменты для перевозчиков. Полный коммерческий запуск пока не подтвержден.",href:"/load-board/"},
  {title:"Hermes Connect и CRM",stage:"Пилоты и разработка",detail:"Инструменты для автосервисов и других компаний: клиентские процессы, сервисные операции и управление взаимодействиями. Готовность отдельных модулей различается.",href:"/services/hermes-connect/"},
  {title:"ProgressoPro",stage:"Услуги и технологии",detail:"Создание сайтов, SEO/GEO, цифровой маркетинг и повторяемые процессы привлечения клиентов.",href:"/paths/marketing/"},
  {title:"Hermes Business Academy",stage:"Образовательная инфраструктура",detail:"Подготовка специалистов и будущих руководителей. В долгосрочной перспективе — кадровая основа для запуска подразделений на новых рынках.",href:"/paths/academy/"},
  {title:"Hermes Automation Engineer",stage:"Архитектура и разработка",detail:"Развитие системы координации специализированных инструментов, проверок и рабочих процессов. Круглосуточная автономность и цифровые сотрудники — направление разработки, а не подтвержденный масштаб."}
];
---
<BaseLayout title="Инвесторам | Hermes" description="Инвестиционная концепция Hermes: логистика США, технологии, маркетинг, обучение и развитие экосистемы." robots="noindex,nofollow" alternates={[{ lang: "en", href: "/investors/" }, { lang: "ru", href: "/ru/investors/" }, { lang: "x-default", href: "/investors/" }]} locale="ru" htmlLang="ru">
  <SiteHeader />
  <main id="main-content" class="investor-page">
    <section class="investor-hero"><div class="investor-shell">
      <p class="investor-eyebrow">HERMES / ИНВЕСТОРАМ</p>
      <nav class="investor-languages" aria-label="Язык"><a href="/investors/">English</a><a href="/ru/investors/" aria-current="page">Русский</a></nav>
      <h1>Реальный бизнес. Связанные технологии. Масштабируемая стратегия.</h1>
      <p class="investor-lead">Hermes развивает взаимосвязанную бизнес-экосистему на базе логистики в США. Технологии, маркетинг и обучение должны усиливать друг друга и создавать дополнительные источники дохода.</p>
      <div class="investor-actions"><a class="investor-primary" href="mailto:officeus@hermeslogisticsus.com?subject=Hermes%20Investor%20Relations%20Inquiry">Обсудить сотрудничество</a><a class="investor-secondary" href="/opportunities/">Другие возможности партнерства →</a></div>
      <p class="investor-note">Персональные кабинеты инвесторов и подтвержденная финансовая отчетность находятся в подготовке. На этой странице нет регистрации и доступа к закрытым документам.</p>
    </div></section>
    <section class="investor-shell investor-section" aria-labelledby="strategy-title">
      <p class="investor-eyebrow">МОДЕЛЬ РАЗВИТИЯ</p><h2 id="strategy-title">Каждое направление усиливает остальные</h2>
      <div class="investor-steps">
        <div><span>01</span><strong>Операции</strong><p>Реальная логистика и коммерческие отношения формируют практические задачи и данные.</p></div>
        <div><span>02</span><strong>Продукты</strong><p>Повторяемые процессы становятся программным обеспечением, автоматизацией и услугами.</p></div>
        <div><span>03</span><strong>Обучение</strong><p>Академия готовит специалистов, руководителей и стандарты работы.</p></div>
        <div><span>04</span><strong>Масштабирование</strong><p>Развитие автопарка, продуктов и региональных команд при подтвержденной экономике.</p></div>
      </div>
    </section>
    <section class="investor-shell investor-section" aria-labelledby="portfolio-title">
      <p class="investor-eyebrow">ПРОДУКТЫ И НАПРАВЛЕНИЯ</p><h2 id="portfolio-title">Карта развития Hermes</h2>
      <p>Статусы отражают направления работы, а не означают, что каждый продукт уже продается. Подтвержденные показатели и документы будут доступны одобренным инвесторам после проверки.</p>
      <div class="investor-grid">{areas.map(area => <article class="investor-card"><span>{area.stage}</span><h3>{area.title}</h3><p>{area.detail}</p><a class="investor-explore" href={area.href}>Подробнее о направлении →</a></article>)}</div>
    </section>

    <section class="investor-shell investor-section" aria-labelledby="capital-title">
      <p class="investor-eyebrow">ТРИ НАПРАВЛЕНИЯ ИНВЕСТИЦИЙ</p>
      <h2 id="capital-title">Для каждой задачи — своя модель финансирования</h2>
      <div class="investor-steps">
        <article><span>Финансирование активов</span><strong>Автовозы и оборудование</strong><p>Потенциальное финансирование автовозов, водителей и оборотного капитала. Gross, топливо, страхование, ремонт, кредитные платежи и полномочия перевозчика требуют документальной проверки.</p></article>
        <article><span>Венчурные инвестиции</span><strong>Технологические продукты</strong><p>Финансирование разработок по измеримым этапам. Код, опубликованная версия, реальные пользователи и платящие клиенты — разные категории доказательств.</p></article>
        <article><span>Стратегическое партнерство</span><strong>Региональные подразделения</strong><p>Расширение через обученные местные команды, когда спрос, законодательство и подтвержденная экономика позволяют выйти на новый рынок.</p></article>
      </div>
    </section>
    <section class="investor-shell investor-section" aria-labelledby="reporting-title">
      <p class="investor-eyebrow">ДОКАЗАТЕЛЬСТВА И ОТЧЕТНОСТЬ</p>
      <h2 id="reporting-title">Прогресс — это не только написанный код</h2>
      <p>В будущих отчетах будут отдельно показаны этапы разработки, подтвержденный запуск на действующем сайте, реальные действия клиентов, сверенные финансовые результаты, риски и следующие цели. У каждой согласованной цифры будут источник, период и определение.</p>
      <p class="investor-note">Еженедельная финансовая панель и закрытые аккаунты находятся в разработке. Международное расширение — долгосрочная стратегия, а не утверждение о действующих офисах во многих странах.</p>
    </section>
    <section class="investor-shell investor-section investor-bottom" aria-labelledby="investment-title">
      <p class="investor-eyebrow">НАПРАВЛЕНИЯ ФИНАНСИРОВАНИЯ</p><h2 id="investment-title">Подбираем инвестиционную структуру под задачу</h2>
      <p>Мы рассматриваем финансирование автовозов и оборудования, инвестиции в технологические продукты и стратегические партнерства для регионального развития. Для каждого направления необходимы отдельная финансовая модель, юридическая проверка и соответствующие документы.</p>
      <a class="investor-primary" href="mailto:officeus@hermeslogisticsus.com?subject=Private%20Hermes%20Investor%20Introduction">Связаться с Hermes</a>
      <p class="investor-note">Материалы носят информационный характер, не являются предложением ценных бумаг, приглашением к их покупке или гарантией доходности. Финансовые условия на странице не публикуются.</p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .investor-page{background:#f8fafc;color:#172b45}.investor-shell{width:min(1120px,calc(100% - 40px));margin-inline:auto}.investor-hero{padding:clamp(85px,11vw,150px) 0 80px;background:linear-gradient(125deg,#f7faff,#eaf1fa 68%,#f9fbfe)}.investor-eyebrow{font-size:.76rem;font-weight:750;letter-spacing:.16em;color:#416da4}.investor-languages{display:flex;gap:18px;margin:16px 0 26px}.investor-languages a{color:#174d8c;font-weight:700}.investor-hero h1{max-width:900px;font-size:clamp(2.6rem,6vw,5.4rem);line-height:1.07;letter-spacing:-.045em;margin:20px 0 24px}.investor-lead{font-size:clamp(1.1rem,2vw,1.4rem);max-width:780px;line-height:1.6;color:#43546c}.investor-actions{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin:32px 0}.investor-primary{display:inline-flex;padding:15px 24px;background:#174d8c;color:#fff;border-radius:10px;text-decoration:none;font-weight:700}.investor-primary:hover{background:#0e3767}.investor-secondary{color:#174d8c;font-weight:700;text-decoration:none}.investor-note{font-size:.85rem;color:#607086;line-height:1.65;max-width:760px}.investor-section{padding-block:76px}.investor-section h2{font-size:clamp(1.9rem,3.5vw,3rem);letter-spacing:-.03em;margin:12px 0 24px}.investor-section>p:not(.investor-eyebrow){max-width:820px;line-height:1.7;color:#50627a}.investor-steps,.investor-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:28px}.investor-steps>div,.investor-card{border:1px solid #dce5ef;background:white;border-radius:18px;padding:27px}.investor-steps span,.investor-card span{display:block;color:#4775ab;font-size:.78rem;font-weight:700;margin-bottom:14px}.investor-explore{display:inline-block;margin-top:8px;color:#174d8c;font-size:.92rem;font-weight:700;text-decoration:underline;text-underline-offset:3px}.investor-steps strong{font-size:1.3rem}.investor-steps p,.investor-card p{line-height:1.65;color:#56677d}.investor-card h3{font-size:1.2rem;margin:0 0 10px}.investor-bottom{border-top:1px solid #dce5ef;padding-bottom:100px}.investor-bottom .investor-primary{margin:15px 0 20px}@media(max-width:650px){.investor-shell{width:min(100% - 30px,1120px)}.investor-steps,.investor-grid{grid-template-columns:1fr}.investor-section{padding-block:50px}}
</style>