---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BusinessLeadForm from "../../../components/BusinessLeadForm.astro";
import CampaignLeadPrefill from "../../../components/CampaignLeadPrefill.astro";
import RussianLocaleIntegrity from "../../../components/RussianLocaleIntegrity.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";

const alternates = [
  { lang: "en", href: "/business-growth/" },
  { lang: "ru", href: "/ru/business-growth/" },
  { lang: "uk", href: "/ua/business-growth/" },
  { lang: "x-default", href: "/business-growth/" },
];
---

<BaseLayout
  title="Сайт, SEO, реклама и AI для бизнеса | Hermes"
  description="Оставьте заявку на разработку сайта, веб-приложения, CRM, AI-автоматизацию, SEO, Google Ads, Meta Ads, SMM, контент или маркетинговый консалтинг."
  robots="noindex,follow"
  locale="ru"
  alternates={alternates}
>
  <SiteHeader theme="dark" locale="ru" />
  <main id="main-content">
    <section class="section detail-overview" aria-labelledby="business-growth-title">
      <div class="shell detail-intro" data-reveal>
        <p class="eyebrow">Рост бизнеса · прямой запрос</p>
        <h1 id="business-growth-title">Сайт, реклама и автоматизация, которые должны приводить клиентов.</h1>
        <p>
          Можно начать с одной задачи — сайта, SEO, Google Ads, Instagram, CRM или AI-автоматизации — либо собрать их в одну систему привлечения и обработки клиентов.
        </p>
        <p>
          Работаем с русскоязычными владельцами бизнеса в США, Европе и других странах. Укажите город, компанию, удобный мессенджер и результат, который хотите получить.
        </p>
        <p class="form-status" data-campaign-context hidden></p>
        <a class="button button-primary" href="#business-lead">Оставить заявку</a>
      </div>
    </section>

    <BusinessLeadForm selectedPath="ProgressoPro" locale="ru" />
    <CampaignLeadPrefill locale="ru" />
  </main>
  <SiteFooter locale="ru" />
  <RussianLocaleIntegrity />
</BaseLayout>