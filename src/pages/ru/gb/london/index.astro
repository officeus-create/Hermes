---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import LondonAnalytics from "../../../../components/LondonAnalytics.astro";
const alternates=[{lang:"en",href:"/gb/london/"},{lang:"ru",href:"/ru/gb/london/"},{lang:"uk",href:"/ua/gb/london/"},{lang:"x-default",href:"/gb/london/"}];
const url="https://hermeslogisticsus.com/ru/gb/london/";
const schema=[
 {"@context":"https://schema.org","@type":"CollectionPage",name:"Hermes London — русский",description:"Русскоязычный вход к London-направлению Hermes: маркетинг, IT и обучение логистике США.",url,inLanguage:"ru",isPartOf:{"@id":"https://hermeslogisticsus.com/#website"},about:{"@id":"https://hermeslogisticsus.com/#organization"}},
 {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Hermes",item:"https://hermeslogisticsus.com/ru/"},{"@type":"ListItem",position:2,name:"Лондон",item:url}]}
];
const directions=[
 ["Маркетинг в Лондоне","/ru/gb/london/marketing/","SMM, Meta Ads, SEO, контент и аналитика как один измеримый путь до заявки."],
 ["IT и сайты","/ru/gb/london/it-web-development/","Сайты, landing pages, technical SEO, CRM и автоматизация вокруг конкретного бизнес-процесса."],
 ["Обучение логистике США","/ru/gb/london/us-logistics-training/","Операции, диспетчеризация, планирование, продажи и коммуникация с readiness-гейтами."],
];
const nextPages=[
 ["SEO Services London","/gb/london/seo-services/"],["Website Development London","/gb/london/website-development/"],["Local SEO London","/gb/london/local-seo/"],["Marketing Audit London","/gb/london/marketing-audit/"],["London Academy","/gb/london/academy/"],["B2 English for US Logistics","/gb/london/academy/english-readiness/"]
];
---
<BaseLayout title="Лондон: маркетинг, IT и обучение логистике США | Hermes" description="Услуги Hermes в Лондоне: SMM, Meta Ads, сайты, SEO, IT и практическое обучение логистике США для жителей Великобритании." locale="ru" alternates={alternates} schema={schema}>
  <SiteHeader theme="dark" locale="ru"/>
  <main id="main-content">
    <section class="section detail-overview"><div class="shell detail-intro">
      <p class="eyebrow">Лондон · Великобритания</p><h1>Маркетинг, IT и обучение логистике США в одном London-направлении.</h1>
      <p>Для местного бизнеса — сайты, SEO, SMM, Meta Ads и автоматизация. Для русскоязычных и украиноязычных жителей Великобритании — практическое обучение операциям и продажам в американской логистике.</p>
      <p>Бизнес начинает с конкретной задачи: улучшить сайт, локальную видимость, рекламную готовность, контент или передачу заявок в CRM. Сначала определяется узкое место и минимальный полезный этап; результаты поиска, рекламы, лидов и выручки не гарантируются.</p>
      <p>В обучении сначала выбирается роль и оцениваются расписание, опыт, английский и готовность к регулярной практике. Живые звонки и переговоры с рынком США требуют достаточного разговорного английского. Обучение не является обещанием работы, зарплаты или дохода.</p>
      <p><a class="button button-primary" href="/ru/business-growth/?utm_source=london&utm_medium=organic&utm_campaign=london-hub&utm_content=ru-hub">Обсудить развитие бизнеса</a> <a class="button" href="/gb/london/academy/">Hermes Academy London</a></p>
    </div></section>
    <section class="section direction-section" aria-labelledby="directions-title"><div class="shell"><p class="eyebrow">Выберите направление</p><h2 id="directions-title">Три разных задачи — три отдельных маршрута.</h2><div class="direction-grid">{directions.map(([title,href,body])=><a href={href}><strong>{title}</strong><span>{body}</span></a>)}</div></div></section>
    <section class="section link-section" aria-labelledby="next-title"><div class="shell"><p class="eyebrow">Дальше по теме</p><h2 id="next-title">Откройте конкретную услугу или учебный трек.</h2><div class="link-grid">{nextPages.map(([title,href])=><a href={href}>{title}</a>)}</div><p class="language-links">English: <a href="/gb/london/">London hub</a> · Українська: <a href="/ua/gb/london/">London українською</a></p></div></section>
  </main>
  <LondonAnalytics/>
  <SiteFooter/>
</BaseLayout>
<style>.direction-section,.link-section{border-top:1px solid #e6eaf3}.direction-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.direction-grid a{display:flex;flex-direction:column;gap:.45rem;padding:1.2rem;border:1px solid #dce3f3;border-radius:12px;text-decoration:none}.direction-grid span{color:#64718f;line-height:1.55}.link-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}.link-grid a{padding:.8rem 1rem;border:1px solid #dce3f3;border-radius:10px;text-decoration:none;font-weight:700}.language-links{margin-top:1.2rem}@media(max-width:800px){.direction-grid,.link-grid{grid-template-columns:1fr}}</style>
