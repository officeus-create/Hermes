---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import LondonAnalytics from "../../../../components/LondonAnalytics.astro";
export function getStaticPaths(){
 const pages=[
  {section:"marketing",title:"Маркетинг в Лондоне: SMM, Meta Ads и SEO | Hermes",h1:"Маркетинг для бизнеса в Лондоне: от контента до измеримых заявок.",description:"SMM, Instagram, Facebook, Threads, Meta Ads, сайты, SEO и аналитика для бизнеса в Лондоне.",en:"/gb/london/marketing/",body:"Связываем контент, рекламу, сайт, SEO и аналитику в единый путь привлечения клиентов без обещаний гарантированных лидов или продаж.",detail:"Начинаем не с количества публикаций, а с бизнес-задачи: кого нужно привлечь, какая услуга приоритетна, куда должен перейти человек после контента или рекламы и кто отвечает за заявку. После этого можно определить, нужны ли новые посадочные страницы, локальное SEO, Meta Ads, сценарии коротких видео или улучшение процесса ответов.",next:"Для небольшого бизнеса первый этап может быть ограничен аудитом и несколькими конкретными исправлениями. Более широкий ежемесячный план имеет смысл только тогда, когда есть повторяемая работа, понятная ответственность и показатели, которые действительно можно отслеживать.",related:[["SEO для Лондона","/gb/london/seo-services/","Техническое SEO, структура страниц и измерение поиска."],["Meta Ads","/gb/london/meta-ads/","Реклама, tracking и связка с посадочной страницей."],["Маркетинговый аудит","/gb/london/marketing-audit/","Поиск первого измеримого узкого места."]]},
  {section:"it-web-development",title:"Сайты, SEO и IT в Лондоне | Hermes",h1:"Сайты и IT-системы как часть продаж и операций бизнеса.",description:"Разработка сайтов, landing pages, technical SEO, аналитика, CRM и автоматизация для бизнеса в Лондоне.",en:"/gb/london/it-web-development/",body:"Начинаем с конкретного узкого места бизнеса и добавляем сайт, SEO, CRM и автоматизацию только там, где они решают измеримую задачу.",detail:"Новый сайт не всегда нужен целиком. Иногда достаточно исправить мобильный путь до заявки, структуру услуг, техническое SEO, аналитику или передачу лида в CRM. Если существующая система действительно ограничивает рост, проект можно расширить до нового сайта, нескольких посадочных страниц, интеграций и автоматизированного follow-up.",next:"Каждый этап должен иметь понятную цель и границу. Сторонние сервисы, рекламный бюджет и сложные интеграции оцениваются отдельно. Мы не обещаем позиции в Google или определённое число заявок: решение принимается по качеству реализации и фактическим данным после запуска.",related:[["Разработка сайта","/gb/london/website-development/","Структура услуг, mobile UX, SEO и конверсионный путь."],["Landing pages","/gb/london/landing-page-development/","Отдельные страницы для конкретных кампаний и офферов."],["CRM и автоматизация","/gb/london/crm-automation/","Передача, дедупликация и follow-up заявок без второй CRM."]]},
  {section:"us-logistics-training",title:"Обучение логистике США в Лондоне | Hermes Academy",h1:"Практическое обучение операциям и продажам в логистике США.",description:"Обучение логистике США для русскоязычных жителей Лондона и Великобритании: операции, планирование, продажи и переговоры.",en:"/gb/london/us-logistics-training/",body:"Треки с живыми звонками и переговорами на рынке США требуют разговорного английского B2+. Обучение не гарантирует трудоустройство или доход.",detail:"Программа объясняет, как связаны шипперы и дилеры, брокеры, load boards, перевозчики и водители, а затем разделяет обучение по ролям: основы операций, диспетчерская работа, планирование загрузок, carrier sales, продажи шипперам и дилерам, переговоры и профессиональная коммуникация.",next:"Сначала оцениваются выбранное направление, расписание, английский, опыт и готовность регулярно практиковаться. Дальше участник проходит материал, упражнения, записанную практику и обратную связь. Переход к более сложным задачам зависит от готовности и требований программы, а не от факта регистрации на курс.",related:[["Freight Dispatcher Training","/gb/london/academy/freight-dispatcher-training/","Отбор и исполнение грузов, коммуникация и исключения."],["Carrier Sales Training","/gb/london/academy/carrier-sales-training/","Квалификация, ценность, возражения и follow-up."],["B2 English","/gb/london/academy/english-readiness/","Готовность к живой коммуникации на рынке США."]]}
 ];
 return pages.map(page=>({params:{section:page.section},props:{page}}));
}
const {page}=Astro.props;
const localPath=`/ru/gb/london/${page.section}/`;
const url=`https://hermeslogisticsus.com${localPath}`;
const alternates=[{lang:"en",href:page.en},{lang:"ru",href:localPath},{lang:"uk",href:`/ua/gb/london/${page.section}/`},{lang:"x-default",href:page.en}];
const schema=[
 {"@context":"https://schema.org","@type":"WebPage",name:page.h1,description:page.description,url,inLanguage:"ru",isPartOf:{"@id":"https://hermeslogisticsus.com/#website"},about:{"@id":"https://hermeslogisticsus.com/#organization"}},
 {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Лондон",item:"https://hermeslogisticsus.com/ru/gb/london/"},{"@type":"ListItem",position:2,name:page.h1,item:url}]}
];
---
<BaseLayout title={page.title} description={page.description} locale="ru" alternates={alternates} schema={schema}>
  <SiteHeader theme="dark" locale="ru"/>
  <main id="main-content">
    <section class="section detail-overview"><div class="shell detail-intro">
      <p class="eyebrow">Лондон · Hermes</p><h1>{page.h1}</h1><p>{page.body}</p><p>{page.detail}</p><p>{page.next}</p>
      <p><a class="button button-primary" href="/ru/gb/london/">Вернуться в London hub</a> <a class="button" href={page.en}>English page</a></p>
    </div></section>
    <section class="section related-section" aria-labelledby="related-title"><div class="shell"><p class="eyebrow">Связанные страницы</p><h2 id="related-title">Продолжите с конкретным решением или учебным треком.</h2><div class="related-grid">{page.related.map(([title,href,body])=><a href={href}><strong>{title}</strong><span>{body}</span></a>)}</div></div></section>
  </main>
  <LondonAnalytics/>
  <SiteFooter/>
</BaseLayout>
<style>.related-section{border-top:1px solid #e6eaf3}.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.related-grid a{display:flex;flex-direction:column;gap:.45rem;padding:1.1rem;border:1px solid #dce3f3;border-radius:12px;text-decoration:none}.related-grid span{color:#64718f;line-height:1.55}@media(max-width:800px){.related-grid{grid-template-columns:1fr}}</style>
