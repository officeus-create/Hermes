---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import LondonAnalytics from "../../../../components/LondonAnalytics.astro";

export function getStaticPaths(){
 const pages=[
  {section:"marketing",title:"Маркетинг в Лондоне: SMM, Meta Ads и SEO | Hermes",h1:"Маркетинг для бизнеса в Лондоне: от контента до измеримых заявок.",description:"SMM, Instagram, Facebook, Threads, Meta Ads, сайты, SEO и аналитика для бизнеса в Лондоне.",en:"/gb/london/marketing/",body:"Связываем контент, рекламу, сайт, SEO и аналитику в единый путь привлечения клиентов без обещаний гарантированных лидов или продаж.",detail:"Начинаем не с количества публикаций, а с бизнес-задачи: кого нужно привлечь, какая услуга приоритетна, куда должен перейти человек после контента или рекламы и кто отвечает за заявку. После этого можно определить, нужны ли новые посадочные страницы, локальное SEO, Meta Ads, сценарии коротких видео или улучшение процесса ответов.",next:"Для небольшого бизнеса первый этап может быть ограничен аудитом и несколькими конкретными исправлениями. Более широкий ежемесячный план имеет смысл только тогда, когда есть повторяемая работа, понятная ответственность и показатели, которые действительно можно отслеживать.",decision:"До изменений фиксируем исходную точку: откуда приходит трафик, какие страницы и предложения получают внимание, где человек может оставить заявку и что происходит после неё. Просмотры и охват сами по себе не считаются результатом продаж. Для следующего решения полезнее смотреть на релевантные переходы, квалифицированные обращения, начатые разговоры и узкие места между рекламой, сайтом и ответом команды.",related:[["SEO Services London","/gb/london/seo-services/"],["Marketing Audit London","/gb/london/marketing-audit/"],["London marketing hub","/gb/london/marketing/"]]},
  {section:"it-web-development",title:"Сайты, SEO и IT в Лондоне | Hermes",h1:"Сайты и IT-системы как часть продаж и операций бизнеса.",description:"Разработка сайтов, landing pages, technical SEO, аналитика, CRM и автоматизация для бизнеса в Лондоне.",en:"/gb/london/it-web-development/",body:"Начинаем с конкретного узкого места бизнеса и добавляем сайт, SEO, CRM и автоматизацию только там, где они решают измеримую задачу.",detail:"Новый сайт не всегда нужен целиком. Иногда достаточно исправить мобильный путь до заявки, структуру услуг, техническое SEO, аналитику или передачу лида в CRM. Если существующая система действительно ограничивает рост, проект можно расширить до нового сайта, нескольких посадочных страниц, интеграций и автоматизированного follow-up.",next:"Каждый этап должен иметь понятную цель и границу. Сторонние сервисы, рекламный бюджет и сложные интеграции оцениваются отдельно. Мы не обещаем позиции в Google или определённое число заявок: решение принимается по качеству реализации и фактическим данным после запуска.",decision:"Перед разработкой полезно составить карту текущей системы: домен и хостинг, ключевые страницы, формы, аналитика, CRM, доступы, ответственный за лид и критичные интеграции. Это показывает, что действительно нужно заменить, а что лучше сохранить. Релиз стоит разбивать на проверяемые этапы: работоспособность, мобильный путь, индексируемость, события аналитики и передача заявки должны подтверждаться отдельно, чтобы дизайн или новая функция не скрывали поломку основного бизнес-процесса.",related:[["Website Development London","/gb/london/website-development/"],["Local SEO London","/gb/london/local-seo/"],["London IT & web hub","/gb/london/it-web-development/"]]},
  {section:"us-logistics-training",title:"Обучение логистике США в Лондоне | Hermes Academy",h1:"Практическое обучение операциям и продажам в логистике США.",description:"Обучение логистике США для русскоязычных жителей Лондона и Великобритании: операции, планирование, продажи и переговоры.",en:"/gb/london/us-logistics-training/",body:"Треки с живыми звонками и переговорами на рынке США требуют разговорного английского B2+. Обучение не гарантирует трудоустройство или доход.",detail:"Программа объясняет, как связаны шипперы и дилеры, брокеры, load boards, перевозчики и водители, а затем разделяет обучение по ролям: основы операций, диспетчерская работа, планирование загрузок, carrier sales, продажи шипперам и дилерам, переговоры и профессиональная коммуникация.",next:"Сначала оцениваются выбранное направление, расписание, английский, опыт и готовность регулярно практиковаться. Дальше участник проходит материал, упражнения, записанную практику и обратную связь. Переход к более сложным задачам зависит от готовности и требований программы, а не от факта регистрации на курс.",decision:"Готовность означает не только знать термины. Участник должен уметь объяснить роли сторон, увидеть недостающую информацию, сравнить варианты и сформулировать следующий безопасный шаг. Для коммуникационных треков отдельно проверяется способность услышать ограничения, уточнить цифры и условия, кратко зафиксировать договорённость и не додумывать то, чего собеседник не говорил. Практика расширяется постепенно и не даёт права действовать от имени перевозчика или клиента без явного разрешения.",related:[["London Academy","/gb/london/academy/"],["Carrier Sales Training","/gb/london/academy/carrier-sales-training/"],["B2 English readiness","/gb/london/academy/english-readiness/"]]}
 ];
 return pages.map(page=>({params:{section:page.section},props:{page}}));
}
const {page}=Astro.props;
const localPath=`/ru/gb/london/${page.section}/`;
const url=`https://hermeslogisticsus.com${localPath}`;
const alternates=[{lang:"en",href:page.en},{lang:"ru",href:localPath},{lang:"uk",href:`/ua/gb/london/${page.section}/`},{lang:"x-default",href:page.en}];
const schema=[
 {"@context":"https://schema.org","@type":"WebPage",name:page.h1,description:page.description,url,inLanguage:"ru",isPartOf:{"@id":"https://hermeslogisticsus.com/#website"},about:{"@id":"https://hermeslogisticsus.com/#organization"}},
 {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Лондон",item:"https://hermeslogisticsus.com/ru/gb/london/"},{"@type":"ListItem",position:2,name:page.h1,item:url}]}
];
---
<BaseLayout title={page.title} description={page.description} locale="ru" alternates={alternates} schema={schema}>
<SiteHeader theme="dark" locale="ru"/>
<main id="main-content">
<section class="section detail-overview"><div class="shell detail-intro"><p class="eyebrow">Лондон · Hermes</p><h1>{page.h1}</h1><p>{page.body}</p><p>{page.detail}</p><p>{page.next}</p><p>{page.decision}</p><p><a class="button button-primary" href="/ru/gb/london/">Вернуться в London hub</a></p></div></section>
<section class="section related-section"><div class="shell"><p class="eyebrow">Связанные маршруты</p><h2>Продолжите с конкретной услугой или учебным треком.</h2><div class="related-grid">{page.related.map(([title,href])=><a href={href}>{title}</a>)}</div></div></section>
</main><LondonAnalytics/><SiteFooter/>
</BaseLayout>
<style>.related-section{border-top:1px solid #e6eaf3}.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}.related-grid a{padding:.85rem 1rem;border:1px solid #dce3f3;border-radius:10px;text-decoration:none;font-weight:700}@media(max-width:800px){.related-grid{grid-template-columns:1fr}}</style>
