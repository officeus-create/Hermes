---
import BaseLayout from "../../layouts/BaseLayout.astro";

/** Public gateway only. Never proxy private audit, chat, prompt or provider data here. */
const accessUrl = "https://agents.hermeslogisticsus.com/ai-agents/";
// Fail closed until owner-approved Cloudflare Access + Tunnel have independent
// anonymous-deny and authorized-login readback. This is not an environment toggle.
const accessVerified = false;
---

<BaseLayout
  title="AI Agents · Private Access | Hermes"
  description="Private entry point for authorized Hermes AI agent operators. Agent conversations and evidence remain behind the organization access gateway."
  robots="noindex,nofollow,noarchive,nosnippet"
>
  <main class="hermes-ai-entry" id="main-content">
    <section class="hermes-ai-entry__body" aria-labelledby="agents-heading">
      <div class="hermes-ai-entry__topline"><span class="hermes-ai-entry__dot" aria-hidden="true"></span> Hermes Technology · Internal systems</div>
      <h1 id="agents-heading">Hermes AI</h1>
      <p class="hermes-ai-entry__lead">An operator workspace for Hermes AI and approved AI-agent monitoring.</p>
      <div class="hermes-ai-entry__notice">
        <strong>Private workspace — authorized users only</strong>
        <p>The actual AI console is hosted separately from this public website, behind Cloudflare Access. A valid company login is required. Availability also depends on the Mac host being online.</p>
      </div>
      <div class="hermes-ai-entry__actions">
        {accessVerified ? (
          <a class="hermes-ai-entry__primary" href={accessUrl} rel="noopener noreferrer nofollow">Open private Hermes AI console <span aria-hidden="true">↗</span></a>
        ) : (
          <button class="hermes-ai-entry__primary hermes-ai-entry__primary--disabled" type="button" disabled aria-describedby="hermes-ai-access-pending">Private console — access setup pending</button>
        )}
        <a class="hermes-ai-entry__secondary" href="/paths/technology/">Explore Hermes Technology</a>
      </div>
      <p id="hermes-ai-access-pending" class="hermes-ai-entry__fineprint">Remote access is not yet verified. This page never connects directly to the Mac, Cloudflare Workers, model APIs or private HAE records. No login button is enabled until the independent Cloudflare Access and Tunnel checks pass.</p>
      <section class="hermes-ai-entry__workspace" aria-labelledby="hermes-ai-workspace-heading">
        <h2 id="hermes-ai-workspace-heading">One control room, separate runtimes</h2>
        <p>Hermes AI is being prepared as a private operations workspace. The cloud orchestrator and local model have different responsibilities and evidence requirements.</p>
        <div class="hermes-ai-entry__workspace-grid">
          <article><span class="hermes-ai-entry__label">Cloud control plane</span><h3>HAE · Cloudflare</h3><p>Existing Worker, D1 and Queue own verified jobs, evidence and approved routing. A code PR is not proof of a deployed runtime.</p><span class="hermes-ai-entry__state">Read-only status required</span></article>
          <article><span class="hermes-ai-entry__label">Local specialist</span><h3>Hermes AI · Mac</h3><p>Runs bounded website and GitHub QA and proposes fixes. Mac availability is not cloud availability; no autonomous production writes.</p><span class="hermes-ai-entry__state">Private tunnel pending</span></article>
          <article><span class="hermes-ai-entry__label">Optional cloud inference</span><h3>Free AI specialist</h3><p>Provider access, free quota and data-handling rules must be authenticated before activation. No paid fallback or confidential data export.</p><span class="hermes-ai-entry__state">Not connected / unverified</span></article>
        </div>
      </section>
    </section>
    <aside class="hermes-ai-entry__aside" aria-label="Access boundaries">
      <div><span class="hermes-ai-entry__label">01 · Identity</span><strong>Company account</strong><p>Explicit allowlist and Cloudflare Access login. No public or anonymous API.</p></div>
      <div><span class="hermes-ai-entry__label">02 · Connection</span><strong>Private tunnel</strong><p>The MacBook retains its local-only server. The public website does not connect to localhost.</p></div>
      <div><span class="hermes-ai-entry__label">03 · Evidence</span><strong>Read-only learning</strong><p>Audit exercises do not grant mail send, deployment, spending or production-change privileges.</p></div>
    </aside>
  </main>
  <style>
    .hermes-ai-entry{max-width:1180px;margin:0 auto;padding:clamp(4rem,8vw,7rem) clamp(1.2rem,4vw,3rem);display:grid;gap:clamp(2rem,5vw,5rem);grid-template-columns:minmax(0,1.45fr) minmax(260px,.75fr);color:#152238}
    .hermes-ai-entry__topline{text-transform:uppercase;letter-spacing:.13em;font-size:.78rem;color:#526d82;font-weight:700;display:flex;gap:.65rem;align-items:center}
    .hermes-ai-entry__dot{display:inline-block;background:#2467b3;border-radius:50%;width:9px;height:9px}
    .hermes-ai-entry h1{font-size:clamp(3rem,7vw,5.6rem);letter-spacing:-.065em;line-height:1.05;margin:.8rem 0 1rem;color:#172840}
    .hermes-ai-entry__lead{font-size:clamp(1.15rem,2vw,1.42rem);color:#53677e;max-width:630px;line-height:1.58;margin:0 0 2rem}
    .hermes-ai-entry__notice{padding:1.3rem 1.45rem;background:#f2f7fc;border:1px solid #dbe8f6;border-radius:20px;max-width:700px}
    .hermes-ai-entry__notice strong{font-size:1.02rem}.hermes-ai-entry__notice p,.hermes-ai-entry__aside p{color:#586e82;line-height:1.6;margin:.45rem 0 0}
    .hermes-ai-entry__actions{display:flex;gap:.8rem;flex-wrap:wrap;margin:2rem 0 1.2rem;align-items:center}
    .hermes-ai-entry__actions a{border-radius:12px;padding:.92rem 1.35rem;text-decoration:none;font-weight:650;min-height:48px;display:inline-flex;align-items:center;gap:.65rem}
    .hermes-ai-entry__primary{color:white;background:#205b96;border:0;font:inherit}.hermes-ai-entry__primary:not(:disabled):hover{background:#154570}
    .hermes-ai-entry__primary--disabled{background:#e4eaf1;color:#506781;cursor:not-allowed;opacity:1}
    .hermes-ai-entry__secondary{border:1px solid #d9e1eb;color:#25496c;background:#fff}.hermes-ai-entry__secondary:hover{background:#f8fafc}
    .hermes-ai-entry__fineprint{font-size:.84rem;color:#738397;line-height:1.6;max-width:650px}
    .hermes-ai-entry__workspace{margin-top:3rem;border-top:1px solid #e0e8f0;padding-top:1.65rem}
    .hermes-ai-entry__workspace h2{font-size:1.3rem;letter-spacing:-.035em;margin:0 0 .45rem}
    .hermes-ai-entry__workspace>p{margin:0;color:#586e82;line-height:1.55}
    .hermes-ai-entry__workspace-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin-top:1.2rem}
    .hermes-ai-entry__workspace-grid article{min-width:0;background:#fff;border:1px solid #e2e9f2;border-radius:16px;padding:1rem}
    .hermes-ai-entry__workspace-grid h3{font-size:1rem;line-height:1.25;margin:.35rem 0;color:#172840}
    .hermes-ai-entry__workspace-grid p{font-size:.82rem;line-height:1.55;color:#5b6d82;margin:.4rem 0 1rem}
    .hermes-ai-entry__state{display:inline-block;padding:.3rem .55rem;border-radius:8px;color:#71561b;background:#fff5dd;font-size:.72rem;font-weight:680}
    @media(max-width:1040px){.hermes-ai-entry__workspace-grid{grid-template-columns:1fr}}
    .hermes-ai-entry__aside{border:1px solid #e0e8f0;background:#fbfdff;border-radius:24px;padding:1.7rem 1.7rem 1rem;display:flex;flex-direction:column;gap:1.35rem;align-self:start}
    .hermes-ai-entry__aside>div{padding-bottom:1.3rem;border-bottom:1px solid #e3e9f1}.hermes-ai-entry__aside>div:last-child{border:0}
    .hermes-ai-entry__label{display:block;color:#66819d;letter-spacing:.09em;text-transform:uppercase;font-size:.7rem;font-weight:700;margin-bottom:.5rem}
    .hermes-ai-entry__aside strong{display:block;font-size:1.1rem}
    @media(max-width:760px){.hermes-ai-entry{grid-template-columns:1fr;padding-top:3rem}.hermes-ai-entry__actions{align-items:stretch}.hermes-ai-entry__actions a{justify-content:center}}
  </style>
</BaseLayout>
