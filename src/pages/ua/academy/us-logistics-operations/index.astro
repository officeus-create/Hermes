---
import AcademyPublicPage from "../../../../components/AcademyPublicPage.astro";
import { academyUkraineLogistics, academyUkraineUi } from "../../../../data/academy-ukraine";

const alternates = [
  { lang: "en", href: "/academy/us-logistics-operations/" },
  { lang: "uk", href: "/ua/academy/us-logistics-operations/" },
  { lang: "x-default", href: "/academy/us-logistics-operations/" },
];

const content = {
  ...academyUkraineLogistics,
  title: "Логістика США — практичне навчання | Hermes Business Academy",
  h1: "Логістика США: практична програма для україномовних учасників.",
  audienceIntro:
    "Відповідність програмі залежить від рівня англійської, графіка, дисципліни, актуального досвіду та конкретного формату участі. Для напрямів, де є живі дзвінки на ринку США, переговори або комунікація з перевізниками чи брокерами, потрібна робоча англійська на рівні B2 або вище.",
  faq: academyUkraineLogistics.faq.map((item) => item.question === "Який рівень англійської потрібен?"
    ? {
        ...item,
        answer: "Для напрямів із живими дзвінками на ринку США, переговорами або комунікацією з перевізниками чи брокерами потрібна робоча розмовна англійська на рівні B2 або вище. Окремі навчальні завдання можуть розглядатися індивідуально, але перехід до комунікаційно насиченої логістичної роботи потребує готовності B2+.",
      }
    : item).concat({
      question: "Чи є юридичні або санкційні обмеження для участі?",
      answer: "Так. Участь залежить від застосовних санкцій, експортного контролю, платіжних правил та інших вимог комплаєнсу. Саме громадянство не є автоматичною причиною відмови; заявку можуть обмежити або відхилити, якщо застосовне право чи санкції забороняють або суттєво обмежують участь, платежі, доступ чи надання послуг.",
    }),
  boundary:
    `${academyUkraineLogistics.boundary} Участь також залежить від застосовних санкцій, експортного контролю, платіжних правил та інших вимог комплаєнсу; саме громадянство не є автоматичною причиною відмови.`,
  primaryAction: {
    label: "Подати заявку",
    href: "/ua/academy/apply/?program=us-logistics-operations&language=uk#contact",
  },
  secondaryAction: {
    label: "Переглянути програму",
    href: "#academy-modules-title",
  },
  related: academyUkraineLogistics.related.map((item) => {
    if (item.href === "/logistics/resources/dispatch-service-vs-self-dispatch/") {
      return { ...item, title: "Dispatch чи самостійний dispatch — матеріал англійською" };
    }
    if (item.href === "/logistics/resources/broker-setup-packet-checklist/") {
      return { ...item, title: "Broker setup packet — матеріал англійською" };
    }
    if (item.href === "/academy/how-training-works/") {
      return { ...item, title: "Як працює модель навчання — сторінка англійською" };
    }
    if (item.href === "/academy/resources/") {
      return { ...item, title: "Матеріали Academy — бібліотека англійською" };
    }
    return item;
  }),
};
---

<AcademyPublicPage
  content={content}
  locale="uk"
  alternates={alternates}
  ui={academyUkraineUi}
  academyHubHref="/ua/#academy"
/>
