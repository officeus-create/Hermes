---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import LondonAnalytics from "../../../../components/LondonAnalytics.astro";
const alternates=[{lang:"en",href:"/gb/london/"},{lang:"ru",href:"/ru/gb/london/"},{lang:"uk",href:"/ua/gb/london/"},{lang:"x-default",href:"/gb/london/"}];
const url="https://hermeslogisticsus.com/ua/gb/london/";
const schema=[
 {"@context":"https://schema.org","@type":"CollectionPage",name:"Hermes London — українською",description:"Україномовний вхід до London-напряму Hermes: маркетинг, IT та навчання логістиці США.",url,inLanguage:"uk",isPartOf:{"@id":"https://hermeslogisticsus.com/#website"},about:{"@id":"https://hermeslogisticsus.com/#organization"}},
 {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Hermes",item:"https://hermeslogisticsus.com/ua/"},{"@type":"ListItem",position:2,name:"Лондон",item:url}]}
];
const directions=[
 ["Маркетинг у Лондоні","/ua/gb/london/marketing/","SMM, Meta Ads, SEO, контент і аналітика як один вимірюваний шлях до заявки."],
 ["IT і сайти","/ua/gb/london/it-web-development/","Сайти, landing pages, technical SEO, CRM та автоматизація навколо конкретного бізнес-процесу."],
 ["Навчання логістиці США","/ua/gb/london/us-logistics-training/","Операції, диспетчеризація, планування, продажі та комунікація з readiness-гейтами."],
];
const nextPages=[
 ["SEO Services London","/gb/london/seo-services/"],["Website Development London","/gb/london/website-development/"],["Local SEO London","/gb/london/local-seo/"],["Marketing Audit London","/gb/london/marketing-audit/"],["London Academy","/gb/london/academy/"],["B2 English for US Logistics","/gb/london/academy/english-readiness/"]
];
---
<BaseLayout title="Лондон: маркетинг, IT та навчання логістиці США | Hermes" description="Послуги Hermes у Лондоні: SMM, Meta Ads, сайти, SEO, IT і практичне навчання логістиці США для мешканців Великої Британії." locale="uk" alternates={alternates} schema={schema}>
  <SiteHeader theme="dark" locale="uk"/>
  <main id="main-content">
    <section class="section detail-overview"><div class="shell detail-intro">
      <p class="eyebrow">Лондон · Велика Британія</p><h1>Маркетинг, IT та навчання логістиці США в одному London-напрямі.</h1>
      <p>Для місцевого бізнесу — сайти, SEO, SMM, Meta Ads та автоматизація. Для україномовних і російськомовних мешканців Великої Британії — практичне навчання операціям і продажам в американській логістиці.</p>
      <p>Бізнес починає з конкретного завдання: покращити сайт, локальну видимість, готовність до реклами, контент або передачу заявок у CRM. Спочатку визначається вузьке місце та мінімальний корисний етап; результати пошуку, реклами, лідів і виручки не гарантуються.</p>
      <p>У навчанні спочатку обирається роль і оцінюються розклад, досвід, англійська та готовність до регулярної практики. Живі дзвінки й переговори з ринком США потребують достатньої розмовної англійської. Навчання не є обіцянкою роботи, зарплати чи доходу.</p>
      <p><a class="button button-primary" href="/ua/business-growth/?utm_source=london&utm_medium=organic&utm_campaign=london-hub&utm_content=ua-hub">Обговорити розвиток бізнесу</a> <a class="button" href="/gb/london/academy/">Hermes Academy London</a></p>
    </div></section>
    <section class="section direction-section" aria-labelledby="directions-title"><div class="shell"><p class="eyebrow">Оберіть напрям</p><h2 id="directions-title">Три різні завдання — три окремі маршрути.</h2><div class="direction-grid">{directions.map(([title,href,body])=><a href={href}><strong>{title}</strong><span>{body}</span></a>)}</div></div></section>
    <section class="section link-section" aria-labelledby="next-title"><div class="shell"><p class="eyebrow">Далі за темою</p><h2 id="next-title">Відкрийте конкретну послугу або навчальний трек.</h2><div class="link-grid">{nextPages.map(([title,href])=><a href={href}>{title}</a>)}</div><p class="language-links">English: <a href="/gb/london/">London hub</a> · Русский: <a href="/ru/gb/london/">London по-русски</a></p></div></section>
  </main>
  <LondonAnalytics/>
  <SiteFooter/>
</BaseLayout>
<style>.direction-section,.link-section{border-top:1px solid #e6eaf3}.direction-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.direction-grid a{display:flex;flex-direction:column;gap:.45rem;padding:1.2rem;border:1px solid #dce3f3;border-radius:12px;text-decoration:none}.direction-grid span{color:#64718f;line-height:1.55}.link-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}.link-grid a{padding:.8rem 1rem;border:1px solid #dce3f3;border-radius:10px;text-decoration:none;font-weight:700}.language-links{margin-top:1.2rem}@media(max-width:800px){.direction-grid,.link-grid{grid-template-columns:1fr}}</style>
