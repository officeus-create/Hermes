---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import LondonAnalytics from "../../../../components/LondonAnalytics.astro";
export function getStaticPaths(){
 const pages=[
  {section:"marketing",title:"Маркетинг у Лондоні: SMM, Meta Ads і SEO | Hermes",h1:"Маркетинг для бізнесу в Лондоні: від контенту до вимірюваних заявок.",description:"SMM, Instagram, Facebook, Threads, Meta Ads, сайти, SEO та аналітика для бізнесу в Лондоні.",en:"/gb/london/marketing/",body:"Поєднуємо контент, рекламу, сайт, SEO та аналітику в єдиний шлях залучення клієнтів без обіцянок гарантованих лідів або продажів.",detail:"Починаємо не з кількості публікацій, а з бізнес-завдання: кого потрібно залучити, яка послуга пріоритетна, куди має перейти людина після контенту чи реклами і хто відповідає за заявку. Після цього можна визначити, чи потрібні нові посадкові сторінки, локальне SEO, Meta Ads, сценарії коротких відео або покращення процесу відповідей.",next:"Для невеликого бізнесу перший етап може обмежитися аудитом і кількома конкретними виправленнями. Ширший щомісячний план має сенс лише тоді, коли є повторювана робота, зрозуміла відповідальність і показники, які справді можна відстежувати.",related:[["SEO для Лондона","/gb/london/seo-services/","Технічне SEO, структура сторінок і вимірювання пошуку."],["Meta Ads","/gb/london/meta-ads/","Реклама, tracking і зв’язок із посадковою сторінкою."],["Маркетинговий аудит","/gb/london/marketing-audit/","Пошук першого вимірюваного вузького місця."]]},
  {section:"it-web-development",title:"Сайти, SEO та IT у Лондоні | Hermes",h1:"Сайти й IT-системи як частина продажів та операцій бізнесу.",description:"Розробка сайтів, landing pages, technical SEO, аналітика, CRM та автоматизація для бізнесу в Лондоні.",en:"/gb/london/it-web-development/",body:"Починаємо з конкретного вузького місця бізнесу та додаємо сайт, SEO, CRM і автоматизацію лише там, де вони вирішують вимірюване завдання.",detail:"Новий сайт не завжди потрібен повністю. Іноді достатньо виправити мобільний шлях до заявки, структуру послуг, технічне SEO, аналітику або передачу ліда до CRM. Якщо наявна система справді обмежує зростання, проєкт можна розширити до нового сайту, кількох посадкових сторінок, інтеграцій і автоматизованого follow-up.",next:"Кожен етап повинен мати зрозумілу мету й межу. Сторонні сервіси, рекламний бюджет і складні інтеграції оцінюються окремо. Ми не обіцяємо позиції в Google або певну кількість заявок: рішення ухвалюється за якістю реалізації та фактичними даними після запуску.",related:[["Розробка сайту","/gb/london/website-development/","Структура послуг, mobile UX, SEO та конверсійний шлях."],["Landing pages","/gb/london/landing-page-development/","Окремі сторінки для конкретних кампаній і пропозицій."],["CRM та автоматизація","/gb/london/crm-automation/","Передача, дедуплікація та follow-up заявок без другої CRM."]]},
  {section:"us-logistics-training",title:"Навчання логістиці США в Лондоні | Hermes Academy",h1:"Практичне навчання операціям і продажам у логістиці США.",description:"Навчання логістиці США для україномовних мешканців Лондона та Великої Британії: операції, планування, продажі й переговори.",en:"/gb/london/us-logistics-training/",body:"Треки з живими дзвінками та переговорами на ринку США потребують розмовної англійської B2+. Навчання не гарантує працевлаштування чи дохід.",detail:"Програма пояснює, як пов’язані шипери та дилери, брокери, load boards, перевізники й водії, а потім розділяє навчання за ролями: основи операцій, диспетчерська робота, планування завантажень, carrier sales, продажі шиперам і дилерам, переговори та професійна комунікація.",next:"Спочатку оцінюються обраний напрям, розклад, англійська, досвід і готовність регулярно практикуватися. Далі учасник проходить матеріал, вправи, записану практику та зворотний зв’язок. Перехід до складніших завдань залежить від готовності й вимог програми, а не від факту реєстрації на курс.",related:[["Freight Dispatcher Training","/gb/london/academy/freight-dispatcher-training/","Відбір і виконання вантажів, комунікація та винятки."],["Carrier Sales Training","/gb/london/academy/carrier-sales-training/","Кваліфікація, цінність, заперечення та follow-up."],["B2 English","/gb/london/academy/english-readiness/","Готовність до живої комунікації на ринку США."]]}
 ];
 return pages.map(page=>({params:{section:page.section},props:{page}}));
}
const {page}=Astro.props;
const localPath=`/ua/gb/london/${page.section}/`;
const url=`https://hermeslogisticsus.com${localPath}`;
const alternates=[{lang:"en",href:page.en},{lang:"ru",href:`/ru/gb/london/${page.section}/`},{lang:"uk",href:localPath},{lang:"x-default",href:page.en}];
const schema=[
 {"@context":"https://schema.org","@type":"WebPage",name:page.h1,description:page.description,url,inLanguage:"uk",isPartOf:{"@id":"https://hermeslogisticsus.com/#website"},about:{"@id":"https://hermeslogisticsus.com/#organization"}},
 {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Лондон",item:"https://hermeslogisticsus.com/ua/gb/london/"},{"@type":"ListItem",position:2,name:page.h1,item:url}]}
];
---
<BaseLayout title={page.title} description={page.description} locale="uk" alternates={alternates} schema={schema}>
  <SiteHeader theme="dark" locale="uk"/>
  <main id="main-content">
    <section class="section detail-overview"><div class="shell detail-intro">
      <p class="eyebrow">Лондон · Hermes</p><h1>{page.h1}</h1><p>{page.body}</p><p>{page.detail}</p><p>{page.next}</p>
      <p><a class="button button-primary" href="/ua/gb/london/">Повернутися до London hub</a> <a class="button" href={page.en}>English page</a></p>
    </div></section>
    <section class="section related-section" aria-labelledby="related-title"><div class="shell"><p class="eyebrow">Пов’язані сторінки</p><h2 id="related-title">Продовжіть із конкретним рішенням або навчальним треком.</h2><div class="related-grid">{page.related.map(([title,href,body])=><a href={href}><strong>{title}</strong><span>{body}</span></a>)}</div></div></section>
  </main>
  <LondonAnalytics/>
  <SiteFooter/>
</BaseLayout>
<style>.related-section{border-top:1px solid #e6eaf3}.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.related-grid a{display:flex;flex-direction:column;gap:.45rem;padding:1.1rem;border:1px solid #dce3f3;border-radius:12px;text-decoration:none}.related-grid span{color:#64718f;line-height:1.55}@media(max-width:800px){.related-grid{grid-template-columns:1fr}}</style>
