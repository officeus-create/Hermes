---
import { ArrowLeft, ArrowRight, Check, ClipboardCheck, Link2, MapPin, SearchCheck, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";

const publishedResources = [
  {
    title: "Appleton vehicle transport",
    href: "/logistics/appleton-wi-vehicle-transport/",
    purpose: "Commercial local-intent page for dealers, auction participants, businesses, private customers, and carriers.",
  },
  {
    title: "Auction Vehicle Pickup Checklist",
    href: "/logistics/resources/auction-vehicle-pickup-checklist/",
    purpose: "National preparation guidance covering release, condition, access, timing, and pickup information.",
  },
  {
    title: "Car Hauler Capacity Checklist",
    href: "/logistics/resources/car-hauler-capacity-checklist/",
    purpose: "Carrier-facing guidance for equipment, authority, geography, capacity, schedule, and operating constraints.",
  },
];

const delivery = [
  "One focused local commercial page with a self-referencing canonical URL",
  "Two supporting resources addressing customer and carrier preparation questions",
  "Visible breadcrumbs plus Service, BreadcrumbList, and FAQPage structured data where applicable",
  "Internal links connecting local intent, auction preparation, carrier capacity, logistics overview, and the load-board request path",
  "No invented rates, active-capacity claims, guaranteed pickup dates, customer identities, or private shipment records",
  "A Search Console review plan that separates indexation, query discovery, CTR, and conversion evidence",
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: "Appleton Vehicle Transport SEO Case Study",
    url: "https://hermeslogisticsus.com/case/appleton-vehicle-transport-seo/",
    description:
      "A verified first-party implementation case covering an Appleton vehicle transport landing page, two supporting logistics checklists, structured data, internal linking, privacy boundaries, and dated Search Console measurement checkpoints.",
    dateModified: "2026-09-26",
    creator: { "@type": "Organization", "@id": "https://hermeslogisticsus.com/#organization", name: "Hermes" },
    about: publishedResources.map((resource) => ({
      "@type": "WebPage",
      name: resource.title,
      url: new URL(resource.href, "https://hermeslogisticsus.com").toString(),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Case Studies", item: "https://hermeslogisticsus.com/case/" },
      { "@type": "ListItem", position: 3, name: "Appleton Vehicle Transport SEO", item: "https://hermeslogisticsus.com/case/appleton-vehicle-transport-seo/" },
    ],
  },
];
import "../../styles/features/resource.css";
import "../../styles/features/case.css";
---

<BaseLayout
  title="Appleton Vehicle Transport SEO Case Study | Hermes"
  description="See how Hermes published an Appleton vehicle transport page with two logistics checklists, structured data, internal links, privacy controls, and measurement planning."
  schema={schema}
>
  <SiteHeader activePath="/paths/logistics/" />
  <main id="main-content" class="seo-case-page">
    <section class="seo-case-hero" id="top">
      <div class="shell">
        <nav class="case-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/case/">Case Studies</a><span>/</span><span aria-current="page">Appleton Vehicle Transport SEO</span></nav>
        <a class="detail-back" href="/case/"><ArrowLeft size={18} aria-hidden="true" />All case studies</a>
        <p class="eyebrow">Case 02 · Logistics SEO release</p>
        <h1>From one local service query to a useful logistics resource cluster.</h1>
        <p class="seo-case-lead">
          Hermes published an Appleton vehicle transport page supported by separate auction-pickup and carrier-capacity
          checklists. This first-party case documents what is live and testable today and keeps dated Search Console checkpoints
          separate from ranking, lead, customer, and revenue evidence.
        </p>
        <div class="seo-case-actions">
          <a class="button button-primary" href="/logistics/appleton-wi-vehicle-transport/">Open the Appleton page <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="button button-ghost" href="#measurement">Review measurement status</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="case-brief-title">
      <div class="shell case-brief-grid">
        <div><p class="eyebrow">The assignment</p><h2 id="case-brief-title">Create indexable value without publishing private operational data.</h2></div>
        <div>
          <p>A useful local logistics page needs more than a city name. It must answer who the page serves, what information is required, what can affect equipment and timing, and where the visitor should go next.</p>
          <p>Supporting checklists were separated from the city page so the same preparation guidance can serve national searches without duplicating the Appleton commercial intent.</p>
        </div>
        <dl class="case-facts">
          <div><dt>Market</dt><dd>Appleton and Fox Valley, Wisconsin</dd></div>
          <div><dt>Cluster</dt><dd>1 local page + 2 national resources</dd></div>
          <div><dt>Published</dt><dd>July 2026</dd></div>
          <div><dt>Performance status</dt><dd>Current GSC checkpoint recorded</dd></div>
        </dl>
      </div>
    </section>

    <section class="section case-soft" aria-labelledby="resources-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Published resources</p><h2 id="resources-title">Three pages with separate jobs.</h2></div>
          <p>Each URL has its own intent and links to the next useful action rather than repeating one generic article.</p>
        </div>
        <div class="resource-grid">
          {publishedResources.map((resource, index) => (
            <article>
              <span>0{index + 1}</span>
              {index === 0 ? <MapPin size={25} aria-hidden="true" /> : <ClipboardCheck size={25} aria-hidden="true" />}
              <h3>{resource.title}</h3>
              <p>{resource.purpose}</p>
              <a href={resource.href}>Open published resource <ArrowRight size={17} aria-hidden="true" /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="delivery-title">
      <div class="shell delivery-grid">
        <div><p class="eyebrow">What was delivered</p><h2 id="delivery-title">A crawlable, claims-controlled content system.</h2></div>
        <ul>{delivery.map((item) => <li><Check size={18} aria-hidden="true" />{item}</li>)}</ul>
      </div>
    </section>

    <section class="section case-boundaries" aria-labelledby="boundaries-title">
      <div class="shell boundary-grid">
        <ShieldCheck size={36} aria-hidden="true" />
        <div>
          <p class="eyebrow">Publication boundary</p>
          <h2 id="boundaries-title">Operational history can suggest research. It does not automatically become content.</h2>
          <p>This release does not use customer names, carrier identities, MC/DOT numbers, exact addresses, shipment IDs, documents, rates, commissions, live locations, or current load-board observations as public proof. No route, capacity, pickup, ranking, or lead result is guaranteed.</p>
        </div>
      </div>
    </section>

    <section class="section" id="measurement" aria-labelledby="measurement-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Search Console stage</p><h2 id="measurement-title">Measured visibility is recorded before success is claimed.</h2></div>
          <p>The current checkpoint uses finalized Search Console data for August 26–September 22, 2026 with Country = United States and Device = Desktop. A prior broader exact-URL baseline is retained separately so unlike filters are not presented as a causal before/after experiment.</p>
        </div>
        <div class="measurement-grid">
          <article><SearchCheck size={24} aria-hidden="true" /><span>Current U.S. desktop checkpoint</span><h3>Exact Appleton URL remains visible, but weak.</h3><p>For August 26–September 22, 2026, the U.S. + Desktop slice reports 6 impressions, 0 clicks, and an average position of 49.5 for the Appleton vehicle transport page.</p><strong>Visibility observed; qualified outcome still unproven</strong></article>
          <article><Link2 size={24} aria-hidden="true" /><span>Comparable query evidence</span><h3>Relevant intent ranks better while exposure shrank.</h3><p>“appleton logistics services” moved from 18 impressions at average position 54.56 in the prior comparable window to 4 impressions at 47.25. “appleton warehousing services” moved from 23 impressions at 56 to 2 impressions at 54. Warehousing remains an intent mismatch and does not justify a warehouse landing page without real service truth and distinct demand.</p><strong>Decision: keep the vehicle-transport owner; do not expand by keyword alone</strong></article>
          <article><SearchCheck size={24} aria-hidden="true" /><span>Historical context</span><h3>The first broader baseline is preserved, not blended.</h3><p>The earlier exact-URL checkpoint for August 16–September 12 recorded 33 impressions, 0 clicks, and average position 45.33. Its scope differs from the current U.S. desktop filter, so it is not a like-for-like experiment and must not be used to claim a causal decline or improvement.</p><strong>Evidence stage: search discovery, not conversion or revenue</strong></article>
        </div>
        <figure class="evidence-figure" id="query-comparison" itemscope itemtype="https://schema.org/Dataset">
          <meta itemprop="creator" content="Hermes" />
          <div class="evidence-figure-header">
            <div>
              <p class="eyebrow">Comparable query exposure</p>
              <h3 itemprop="name">Relevant Appleton query families lost impressions while average position improved modestly.</h3>
            </div>
            <p itemprop="description">The bars compare impressions for the same U.S. desktop query families. Average position is reported in the table because lower values are better and should not share the impression scale.</p>
          </div>
          <svg class="evidence-chart" viewBox="0 0 1200 560" role="img" aria-labelledby="appleton-query-chart-title appleton-query-chart-desc">
            <title id="appleton-query-chart-title">Comparable Appleton query impressions</title>
            <desc id="appleton-query-chart-desc">Appleton logistics services fell from 18 prior impressions to 4 current impressions. Appleton warehousing services fell from 23 prior impressions to 2 current impressions. The warehousing query remains an intent mismatch.</desc>
            <g class="evidence-chart-grid" aria-hidden="true">
              <line x1="360" y1="108" x2="360" y2="468" />
              <line x1="565" y1="108" x2="565" y2="468" />
              <line x1="770" y1="108" x2="770" y2="468" />
              <line x1="975" y1="108" x2="975" y2="468" />
            </g>
            <g class="evidence-chart-axis" aria-hidden="true">
              <text x="360" y="88">0</text>
              <text x="565" y="88">8</text>
              <text x="770" y="88">16</text>
              <text x="975" y="88">24 impressions</text>
            </g>
            <g class="evidence-chart-legend" aria-hidden="true">
              <rect class="evidence-bar-prior" x="360" y="28" width="22" height="22" rx="5" />
              <text x="392" y="46">Prior comparable window</text>
              <rect class="evidence-bar-current" x="650" y="28" width="22" height="22" rx="5" />
              <text x="682" y="46">Aug 26–Sep 22, 2026</text>
            </g>
            <g class="evidence-chart-row">
              <text class="evidence-chart-label" x="0" y="190">appleton logistics services</text>
              <rect class="evidence-bar-prior" x="360" y="140" width="615" height="48" rx="8" />
              <text class="evidence-bar-value evidence-bar-value-light" x="948" y="172">18</text>
              <rect class="evidence-bar-current" x="360" y="204" width="137" height="48" rx="8" />
              <text class="evidence-bar-value" x="511" y="236">4</text>
            </g>
            <g class="evidence-chart-row">
              <text class="evidence-chart-label" x="0" y="374">appleton warehousing services</text>
              <rect class="evidence-bar-prior" x="360" y="324" width="786" height="48" rx="8" />
              <text class="evidence-bar-value evidence-bar-value-light" x="1119" y="356">23</text>
              <rect class="evidence-bar-current" x="360" y="388" width="68" height="48" rx="8" />
              <text class="evidence-bar-value" x="442" y="420">2</text>
              <text class="evidence-chart-annotation" x="360" y="482">Intent mismatch — no warehouse page justified</text>
            </g>
          </svg>
          <div class="evidence-table-wrap">
            <table class="evidence-table">
              <caption>Search Console query comparison with impressions and average position.</caption>
              <thead><tr><th scope="col">Query family</th><th scope="col">Prior impressions</th><th scope="col">Current impressions</th><th scope="col">Prior avg. position</th><th scope="col">Current avg. position</th><th scope="col">Decision</th></tr></thead>
              <tbody>
                <tr><th scope="row">appleton logistics services</th><td>18</td><td>4</td><td>54.56</td><td>47.25</td><td>Keep vehicle-transport owner</td></tr>
                <tr><th scope="row">appleton warehousing services</th><td>23</td><td>2</td><td>56</td><td>54</td><td>Intent mismatch; no warehouse page</td></tr>
              </tbody>
            </table>
          </div>
          <figcaption>Source: authenticated Google Search Console, Country = United States, Device = Desktop. Query-level rows are descriptive visibility evidence, not proof of a lead, opportunity, customer, or revenue outcome.</figcaption>
        </figure>
        <p class="measurement-note">Source: authenticated Google Search Console finalized performance data. Current checkpoint: August 26–September 22, 2026, Country = United States, Device = Desktop. Search Console is delayed by approximately three days. No GA4, qualified-lead, opportunity, customer, or revenue result is inferred from these search rows.</p>
      </div>
    </section>

    <section class="section case-cta">
      <div class="shell case-cta-layout">
        <div><p class="eyebrow">Next step</p><h2>Build the next release around verified intent and a measurable action.</h2></div>
        <a
          class="button button-primary"
          href="/services/seo-for-logistics-companies/"
          data-seo-service-cta
          data-seo-owner-link
          data-service-group="logistics_seo"
        >
          Review logistics SEO services <ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
