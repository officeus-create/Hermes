---
import { ArrowRight, Braces, SearchCheck, Truck } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";

const cases = [
  {
    number: "01",
    eyebrow: "IT Development · Live product",
    title: "Hermes corporate website: one digital front door for four businesses",
    description:
      "Strategy, information architecture, original design, Astro engineering, automated QA, and controlled production delivery for the Hermes corporate website.",
    href: "/case/it-development/",
    icon: Braces,
    status: "Live and evolving",
  },
  {
    number: "02",
    eyebrow: "Logistics SEO · Published resource cluster",
    title: "Appleton vehicle transport SEO: service page plus two operational checklists",
    description:
      "An evidence-first logistics content release combining a commercial local page, auction pickup guidance, carrier-capacity guidance, structured data, and internal links.",
    href: "/case/appleton-vehicle-transport-seo/",
    icon: Truck,
    status: "Published · Measurement verification pending",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Hermes Case Studies",
    description:
      "Verified Hermes case studies covering live website development and evidence-first logistics SEO releases.",
    url: "https://hermeslogisticsus.com/case/",
    hasPart: cases.map((item) => ({
      "@type": "CreativeWork",
      name: item.title,
      url: new URL(item.href, "https://hermeslogisticsus.com").toString(),
      description: item.description,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Case Studies", item: "https://hermeslogisticsus.com/case/" },
    ],
  },
];
import "../../styles/features/case.css";
---

<BaseLayout
  title="Hermes Case Studies | Websites, SEO and Logistics"
  description="Review verified Hermes case studies for website development and evidence-first logistics SEO. Results are added only after dated measurement evidence."
  schema={schema}
>
  <SiteHeader />
  <main id="main-content" class="case-hub">
    <section class="case-hub-hero" id="top">
      <div class="shell">
        <nav class="case-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Case Studies</span></nav>
        <p class="eyebrow">Hermes · Verified work</p>
        <h1>Case studies built from released work, not promises.</h1>
        <p class="case-hub-lead">
          Each case separates what was implemented, what was verified, and what still requires Search Console, analytics,
          customer, or operational evidence. We do not convert unfinished work or synthetic data into public results claims.
        </p>
        <a class="button button-primary" href="#published-cases">Review published cases <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </section>

    <section class="section" id="published-cases" aria-labelledby="published-cases-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Published cases</p><h2 id="published-cases-title">Delivery evidence first. Performance evidence second.</h2></div>
          <p>Search rankings, impressions, clicks, inquiries, and commercial outcomes are added only after a dated, reviewable source is available.</p>
        </div>
        <div class="case-grid">
          {cases.map((item) => {
            const Icon = item.icon;
            return (
              <article>
                <div class="case-card-top"><span>{item.number}</span><Icon size={27} aria-hidden="true" /></div>
                <p class="eyebrow">{item.eyebrow}</p>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <div class="case-card-status"><i aria-hidden="true"></i>{item.status}</div>
                <a href={item.href}>Open case study <ArrowRight size={17} aria-hidden="true" /></a>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section case-method" aria-labelledby="case-method-title">
      <div class="shell case-method-layout">
        <SearchCheck size={38} aria-hidden="true" />
        <div>
          <p class="eyebrow">Evidence standard</p>
          <h2 id="case-method-title">What qualifies as a result.</h2>
          <p>
            A public performance statement needs a source date, defined comparison period, correct page or query scope,
            and a privacy review. Until then, the case reports implementation, release quality, and measurement status only.
            For the logistics-specific method and commercial scope, review our <a href="/services/seo-for-logistics-companies/">Logistics SEO services for trucking and transportation companies</a>.
          </p>
        </div>
        <a class="button" href="/contacts/">Discuss a measurable project <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
