---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import PathDetailPage from "../../components/PathDetailPage.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { site } from "../../data/site";

export function getStaticPaths() {
  return site.paths.map((path) => ({ params: { slug: path.id }, props: { path } }));
}

const { path } = Astro.props;
const canonicalUrl = new URL(`/paths/${path.id}/`, Astro.site).toString();
const areaServed = path.id === "logistics"
  ? [{ "@type": "Country", name: "United States" }]
  : [
      { "@type": "Country", name: "United States" },
      { "@type": "Country", name: "Italy" },
      { "@type": "Country", name: "Germany" },
      { "@type": "Country", name: "France" },
      { "@type": "Country", name: "United Kingdom" },
    ];
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: path.seoServiceName,
  description: path.seoDescription,
  url: canonicalUrl,
  areaServed,
  provider: {
    "@type": "Organization",
    name: "Hermes",
    url: "https://hermeslogisticsus.com/",
  },
  serviceType: path.offerings.map((item) => item.title),
};
---

<BaseLayout title={path.seoTitle} description={path.seoDescription} image={path.image} schema={serviceSchema}>
  <SiteHeader theme={path.id === "technology" ? "light" : "dark"} />
  <PathDetailPage path={path} />
  <ContactCTA selectedPath={path.category} />
  <SiteFooter />
</BaseLayout>
