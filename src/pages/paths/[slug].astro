---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import LogisticsCommercialLinks from "../../components/LogisticsCommercialLinks.astro";
import PathDetailPage from "../../components/PathDetailPage.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { site } from "../../data/site";

export function getStaticPaths() {
  return site.paths.map((path) => ({ params: { slug: path.id }, props: { path } }));
}

const { path } = Astro.props;
const canonicalUrl = new URL(`/paths/${path.id}/`, Astro.site).toString();
const areaServed = path.id === "logistics"
  ? [{ "@type": "Country", name: "United States" }]
  : [
      { "@type": "Country", name: "United States" },
      { "@type": "Country", name: "Italy" },
      { "@type": "Country", name: "Germany" },
      { "@type": "Country", name: "France" },
      { "@type": "Country", name: "United Kingdom" },
    ];
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: path.seoServiceName,
  description: path.seoDescription,
  url: canonicalUrl,
  areaServed,
  provider: { "@id": "https://hermeslogisticsus.com/#organization" },
  serviceType: path.offerings.map((item) => item.title),
};
const breadcrumbName = site.navigation.find((item) => item.href === `paths/${path.id}/`)?.label ?? path.category;
const breadcrumbSchema = {
"@context": "https://schema.org",
"@type": "BreadcrumbList",
itemListElement: [
{ "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
{ "@type": "ListItem", position: 2, name: breadcrumbName, item: canonicalUrl },
],
};
const faqSchema = path.faq ? { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: path.faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) } : null; const schema = faqSchema ? [serviceSchema, breadcrumbSchema, faqSchema] : [serviceSchema, breadcrumbSchema];
---

<BaseLayout title={path.seoTitle} description={path.seoDescription} image={path.image} schema={schema}>
  <SiteHeader theme={path.id === "technology" ? "light" : "dark"} />
  <PathDetailPage path={path} />
  {path.id === "logistics" && <LogisticsCommercialLinks />}
  <ContactCTA selectedPath={path.category} />
  <SiteFooter />
</BaseLayout>
