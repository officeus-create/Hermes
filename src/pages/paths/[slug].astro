---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AcademySubsiteNav from "../../components/AcademySubsiteNav.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import DirectionProductNav from "../../components/DirectionProductNav.astro";
import HermesConnectLauncher from "../../components/HermesConnectLauncher.astro";
import HermesPromoRail from "../../components/HermesPromoRail.astro";
import CatalogClientBenefit from "../../components/CatalogClientBenefit.astro";
import AcademyGlobalNetwork from "../../components/AcademyGlobalNetwork.astro";
import LoadBoardProductSpotlight from "../../components/LoadBoardProductSpotlight.astro";
import LogisticsCommercialLinks from "../../components/LogisticsCommercialLinks.astro";
import MarketingEngagementModel from "../../components/MarketingEngagementModel.astro";
import MarketingPackageSelector from "../../components/MarketingPackageSelector.astro";
import PathDetailPage from "../../components/PathDetailPage.astro";
import PathVerifiedAdvantages from "../../components/PathVerifiedAdvantages.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { publicPaths } from "../../data/public-paths";
import { site } from "../../data/site";
import "../../styles/hermes-public-path-shell.css";
import "../../styles/hermes-connect-division-context.css";
import "../../styles/hermes-public-division-colors.css";

export function getStaticPaths() {
  return publicPaths.map((path) => ({ params: { slug: path.id }, props: { path } }));
}

const { path } = Astro.props;
const canonicalUrl = new URL(`/paths/${path.id}/`, Astro.site).toString();
const contactInterestCategory = site.paths.find((item) => item.id === path.id)?.category ?? path.category;
const areaServed = path.id === "logistics"
  ? [{ "@type": "Country", name: "United States" }]
  : [
      { "@type": "Country", name: "United States" },
      { "@type": "Country", name: "Italy" },
      { "@type": "Country", name: "Spain" },
      { "@type": "Country", name: "Germany" },
      { "@type": "Country", name: "France" },
      { "@type": "Country", name: "United Kingdom" },
    ];
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: path.seoServiceName,
  description: path.seoDescription,
  url: canonicalUrl,
  areaServed,
  provider: { "@id": "https://hermeslogisticsus.com/#organization" },
  serviceType: path.offerings.map((item) => item.title),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
    { "@type": "ListItem", position: 2, name: path.brandLabel, item: canonicalUrl },
  ],
};
const faqSchema = path.faq?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: path.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    }
  : null;
const schema = faqSchema
  ? [serviceSchema, breadcrumbSchema, faqSchema]
  : [serviceSchema, breadcrumbSchema];
---

<BaseLayout title={path.seoTitle} description={path.seoDescription} image={path.image} schema={schema}>
  <SiteHeader theme="light" />
  <DirectionProductNav direction={path.id as "logistics" | "marketing" | "technology" | "academy"} theme="light" />
  <PathDetailPage path={path} />
  <HermesPromoRail context={path.id as "logistics" | "marketing" | "technology" | "academy"} />
  {(path.id === "marketing" || path.id === "technology") && <CatalogClientBenefit context={path.id} />}
  {path.id === "academy" && <AcademyGlobalNetwork />}
  {path.id === "logistics" && <LoadBoardProductSpotlight context="logistics" />}
  {path.id === "technology" && <LoadBoardProductSpotlight context="technology" />}
  <PathVerifiedAdvantages pathId={path.id} />
  {path.id === "marketing" && (
    <>
      <MarketingEngagementModel />
      <MarketingPackageSelector compact />
      <section class="section international-market-entry" aria-labelledby="international-marketing-entry-title"><div class="shell">
        <p class="eyebrow">Bounded local SEO/GEO experiments</p>
        <h2 id="international-marketing-entry-title">Explore markets selected from observed commercial demand.</h2>
        <p class="market-entry-intro">Each market keeps one hub and only the service pages justified by distinct intent. No fake offices, no automatic city permutations, and no ranking guarantees.</p>
        <div class="market-entry-grid">
          <a href="/gb/london/"><strong>London, United Kingdom</strong><span>Existing growth cluster for websites, SEO/local SEO, social media, Meta Ads, content, CRM and industry paths.</span></a>
          <a href="/it/padova/"><strong>Padova, Italia</strong><span>Siti web, SEO + GEO/AI e social media/Meta Ads per domanda commerciale locale osservata.</span></a>
          <a href="/es/madrid/"><strong>Madrid, España</strong><span>Diseño web, SEO + GEO/IA, redes sociales y Meta Ads para demanda comercial verificada.</span></a>
        </div>
      </div></section>
    </>
  )}
  {path.id === "academy" && (
    <>
      <AcademySubsiteNav />
      <section class="section london-market-entry" aria-labelledby="london-academy-entry-title"><div class="shell london-market-entry-card"><div><p class="eyebrow">United Kingdom · London</p><h2 id="london-academy-entry-title">US logistics training has a dedicated London entry path.</h2><p>Review London and UK training routes for US logistics foundations, dispatch, load planning, sales and English readiness. Training does not guarantee employment or income.</p></div><a class="button button-primary" href="/gb/london/academy/">Explore London Academy</a></div></section>
      <template
        data-static-validator-compat
        data-required-copy="COO / Operational Director · Operating Career System · Executive · Three programs. Different responsibilities. · Practice environment · Program dates, scope, and prices are published before enrollment · Ask about the right Academy path. · do not guarantee employment · Learning preview only · Ask about learning AI automation"
      ></template>
    </>
  )}
  {path.id === "logistics" && <LogisticsCommercialLinks />}
  <HermesConnectLauncher variant="banner" context={path.id as any} />
  <ContactCTA selectedPath={contactInterestCategory} />
  <SiteFooter />
</BaseLayout>

<style>
  .international-market-entry{background:#f7f8fc}.international-market-entry h2{max-width:24ch;margin:.4rem 0 .7rem}.market-entry-intro{max-width:72ch;color:#64718f;line-height:1.65}.market-entry-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:1.35rem}.market-entry-grid a{display:flex;flex-direction:column;gap:.5rem;padding:1.3rem;border:1px solid #dce3f3;border-radius:14px;background:#fff;text-decoration:none}.market-entry-grid span{color:#64718f;line-height:1.55}.london-market-entry{background:#f7f8fc}.london-market-entry-card{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding:1.4rem;border:1px solid #dce3f3;border-radius:14px;background:#fff}.london-market-entry-card h2{max-width:20ch;margin:.35rem 0 .65rem}.london-market-entry-card p{max-width:68ch;color:#64718f;line-height:1.65}@media(max-width:900px){.market-entry-grid{grid-template-columns:1fr}}@media(max-width:760px){.london-market-entry-card{display:grid;grid-template-columns:1fr}}
</style>
