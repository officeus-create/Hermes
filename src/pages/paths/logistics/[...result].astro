---
import { ArrowLeft, ArrowRight, Check, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PartnerReviewMatrix from "../../../components/PartnerReviewMatrix.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { logisticsRecommendations } from "../../../data/logistics-path-engine";

export function getStaticPaths() {
  return logisticsRecommendations.map((recommendation) => ({
    params: { result: recommendation.route.replace("/paths/logistics/", "").replace(/\/$/, "") },
    props: { recommendation },
  }));
}

const { recommendation } = Astro.props;
const canonicalUrl = new URL(recommendation.route, Astro.site).toString();
const carHaulingCommercialAudienceIds = new Set([
  "carrier-car-hauling",
  "carrier-owner-operators",
  "carrier-fleet-owners",
]);
const showCarHaulingCommercialPath = carHaulingCommercialAudienceIds.has(recommendation.id);
const showPartnerReviewMatrix = recommendation.id === "agency-development";
const isBrokerCapacityPath = recommendation.id === "broker-carrier-capacity";
const isCarHaulingPath = recommendation.id === "carrier-car-hauling";
const customerIntakeById: Record<string, {
  primary: { label: string; href: string };
  demo: { label: string; href: string };
  context: string;
}> = {
  "customer-vehicle-transport": {
    primary: { label: "Prepare vehicle transport request", href: "/logistics/request-vehicle-transport/?request=customer_delivery#transport-intake" },
    demo: { label: "Preview customer Load Board demo", href: "/load-board/?role=private_party#post-load" },
    context: "vehicle, route, timing, condition, equipment preference, access, and contact",
  },
  "customer-port-pickup": {
    primary: { label: "Prepare port pickup request", href: "/logistics/request-vehicle-transport/?request=other#transport-intake" },
    demo: { label: "Preview customer Load Board demo", href: "/load-board/?role=private_party#post-load" },
    context: "vehicle, route, release status, facility access, timing, storage risk, handling, and contact",
  },
  "customer-luxury-classic": {
    primary: { label: "Prepare specialty vehicle request", href: "/logistics/request-vehicle-transport/?request=customer_delivery#transport-intake" },
    demo: { label: "Preview customer Load Board demo", href: "/load-board/?role=private_party#post-load" },
    context: "vehicle, route, timing, operability, handling, open or enclosed preference, access, and contact",
  },
  "shipper-dealer": {
    primary: { label: "Prepare dealer or shipper request", href: "/logistics/request-vehicle-transport/?request=dealer_inventory#transport-intake" },
    demo: { label: "Preview dealer Load Board demo", href: "/load-board/?role=dealer#post-load" },
    context: "route, timing, vehicle count, condition, auction or dealer context, equipment preference, access, and contact",
  },
};
const customerIntake = customerIntakeById[recommendation.id];
const primaryCta = isBrokerCapacityPath
  ? { label: "Prepare broker opportunity", href: "/logistics/request-vehicle-transport/?role=broker#transport-intake" }
  : isCarHaulingPath
    ? { label: "Start car-hauling dispatch review", href: "/logistics/start-car-hauling-dispatch/" }
    : customerIntake?.primary ?? recommendation.primaryCta;
const demoCta = isBrokerCapacityPath
  ? { label: "Preview broker Load Board demo", href: "/load-board/?role=broker#post-load" }
  : isCarHaulingPath
    ? { label: "Preview carrier Load Board demo", href: "/load-board/?role=carrier&equipment=car_hauler#available-loads" }
    : customerIntake?.demo ?? null;
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: recommendation.title,
  description: recommendation.summary,
  url: canonicalUrl,
  provider: {
    "@type": "Organization",
    name: "Hermes Logistics",
    url: "https://hermeslogisticsus.com/paths/logistics/",
  },
  areaServed: { "@type": "Country", name: "United States" },
};
import "../../../styles/features/case.css";
---

<BaseLayout
  title={`${recommendation.seoTitle ?? recommendation.title} | Hermes Logistics`}
  description={recommendation.seoDescription ?? recommendation.summary}
  schema={schema}
>
  <div class="logistics-recommendation-page">
    <SiteHeader theme="dark" activePath="/paths/logistics/" />
    <main id="main-content">
      <section class="logistics-audience-hero logistics-recommendation-hero">
        <div class="shell">
          <a class="detail-back" href="/paths/logistics/find-your-path/"><ArrowLeft size={18} aria-hidden="true" />Restart the Logistics Path</a>
          <p class="eyebrow">{recommendation.eyebrow}</p>
          <h1>{recommendation.title}</h1>
          <p>{recommendation.summary}</p>
          <div class="logistics-audience-actions">
            <a class="button button-primary" href={primaryCta.href} data-recommendation-primary>
              {primaryCta.label}<ArrowRight size={18} aria-hidden="true" />
            </a>
            {recommendation.secondaryCta && <a class="button" href={recommendation.secondaryCta.href}>{recommendation.secondaryCta.label}</a>}
            {demoCta && <a class="button" href={demoCta.href} data-recommendation-demo>{demoCta.label}</a>}
          </div>
        </div>
      </section>

      <section class="section recommendation-explanation" aria-labelledby="recommendation-reasons-title">
        <div class="shell recommendation-explanation-grid">
          <div>
            <p class="eyebrow">Why this path</p>
            <h2 id="recommendation-reasons-title">A recommendation you can evaluate.</h2>
          </div>
          <ul>{recommendation.reasons.map((reason) => <li><Check size={20} aria-hidden="true" />{reason}</li>)}</ul>
        </div>
      </section>

      <section class="section recommendation-scope" aria-labelledby="recommendation-scope-title">
        <div class="shell">
          <div class="section-heading split-heading">
            <div><p class="eyebrow">Recommended scope</p><h2 id="recommendation-scope-title">What this path can include.</h2></div>
            <p>The final scope is confirmed only after authority, insurance, equipment, request details, operating fit, and current company capacity are reviewed where applicable.</p>
          </div>
          <div class="recommendation-included-grid">
            {recommendation.included.map((item, index) => <article><span>0{index + 1}</span><p>{item}</p></article>)}
          </div>
        </div>
      </section>

      {showPartnerReviewMatrix && <PartnerReviewMatrix />}

      {isBrokerCapacityPath && (
        <section class="section recommendation-next" aria-labelledby="broker-intake-boundary-title">
          <div class="shell recommendation-next-grid">
            <div>
              <p class="eyebrow">Commercial intake versus product demo</p>
              <h2 id="broker-intake-boundary-title">Use the direct intake for a real opportunity.</h2>
              <p>The broker intake collects route, timing, equipment, vehicle condition, quantity, contact, and review context for Logistics Sales. The Load Board remains a fictional product demonstration and does not publish a load, notify a carrier, confirm capacity, or create a booking.</p>
            </div>
            <div>
              <a class="button button-primary" href={primaryCta.href}>Prepare broker opportunity <ArrowRight size={18} aria-hidden="true" /></a>
            </div>
          </div>
        </section>
      )}

      {isCarHaulingPath && (
        <section class="section recommendation-next" aria-labelledby="car-hauling-intake-boundary-title" data-car-hauling-direct-intake>
          <div class="shell recommendation-next-grid">
            <div>
              <p class="eyebrow">Commercial intake versus product demo</p>
              <h2 id="car-hauling-intake-boundary-title">Use direct intake for a real car-hauling dispatch review.</h2>
              <p>The direct carrier workspace collects authority, insurance, equipment, practical capacity, operating area, availability, current dispatch status, business contact, and consent for Logistics Sales review. The Load Board remains a fictional product demonstration and does not create an account, assign a dispatcher, publish a load, guarantee acceptance, or book freight.</p>
            </div>
            <div>
              <a class="button button-primary" href={primaryCta.href}>Start car-hauling dispatch review <ArrowRight size={18} aria-hidden="true" /></a>
            </div>
          </div>
        </section>
      )}

      {customerIntake && (
        <section class="section recommendation-next" aria-labelledby="customer-intake-boundary-title" data-customer-direct-intake>
          <div class="shell recommendation-next-grid">
            <div>
              <p class="eyebrow">Commercial intake versus product demo</p>
              <h2 id="customer-intake-boundary-title">Use direct intake for a real transportation request.</h2>
              <p>The direct workspace collects {customerIntake.context} for Logistics Sales review. The Load Board remains a fictional product demonstration and does not publish a request, notify a carrier, confirm capacity, create a booking, or guarantee acceptance.</p>
            </div>
            <div>
              <a class="button button-primary" href={primaryCta.href}>{primaryCta.label} <ArrowRight size={18} aria-hidden="true" /></a>
            </div>
          </div>
        </section>
      )}

      {showCarHaulingCommercialPath && (
        <section class="section recommendation-next" aria-labelledby="car-hauling-commercial-title">
          <div class="shell recommendation-next-grid">
            <div>
              <p class="eyebrow">Car-hauling service details</p>
              <h2 id="car-hauling-commercial-title">Review the national dispatch and back-office service before sharing private carrier details.</h2>
              <p>See how Hermes reviews equipment, capacity, authority, operating area, broker communication, paperwork, and carrier-controlled load approval for vehicle-transport owner-operators and small fleets.</p>
            </div>
            <div>
              <a class="button button-primary" href="/logistics/car-hauling-dispatch/" data-car-hauling-commercial-link>
                Review car-hauling dispatch support <ArrowRight size={18} aria-hidden="true" />
              </a>
            </div>
          </div>
        </section>
      )}

      {recommendation.caseStudy && (
        <section class="section recommendation-case" aria-labelledby="recommendation-case-title">
          <div class="shell recommendation-case-grid">
            <div>
              <p class="eyebrow">{recommendation.caseStudy.label}</p>
              <h2 id="recommendation-case-title">{recommendation.caseStudy.title}</h2>
              <p>{recommendation.caseStudy.body}</p>
            </div>
            <ul>{recommendation.caseStudy.checks.map((item) => <li><ShieldCheck size={19} aria-hidden="true" />{item}</li>)}</ul>
          </div>
        </section>
      )}

      <section class="section recommendation-next" aria-labelledby="recommendation-next-title">
        <div class="shell recommendation-next-grid">
          <div>
            <p class="eyebrow">Next action</p>
            <h2 id="recommendation-next-title">Move from recommendation to qualification.</h2>
            {recommendation.eligibilityNote && <p class="recommendation-note"><ShieldCheck size={20} aria-hidden="true" />{recommendation.eligibilityNote}</p>}
          </div>
          <ol>{recommendation.nextSteps.map((step, index) => <li><span>0{index + 1}</span><p>{step}</p></li>)}</ol>
        </div>
      </section>

      <section class="recommendation-cta">
        <div class="shell">
          <div>
            <p class="eyebrow">Hermes Logistics</p>
            <h2>Ready for the correct operating conversation?</h2>
            <p>Contact and private operational details are collected only now—after the recommendation is clear.</p>
          </div>
          <div>
            <a class="button button-primary" href={primaryCta.href} data-recommendation-primary-bottom>{primaryCta.label}<ArrowRight size={18} aria-hidden="true" /></a>
            {recommendation.secondaryCta && <a class="button" href={recommendation.secondaryCta.href}>{recommendation.secondaryCta.label}</a>}
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script>
  import { trackEvent } from "../../../lib/analytics";

  trackEvent("path_recommendation_viewed", { direction: "logistics", resultRoute: window.location.pathname });
  document.querySelectorAll<HTMLAnchorElement>("[data-recommendation-primary], [data-recommendation-primary-bottom]").forEach((link) => {
    link.addEventListener("click", () => trackEvent("contact_route_clicked", {
      direction: "logistics",
      resultRoute: window.location.pathname,
      contactRoute: link.getAttribute("href")?.startsWith("tel:") ? "phone" : "form",
    }));
  });
</script>
