---
import { ArrowRight, Check, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import LogisticsProductNav from "../../../../components/LogisticsProductNav.astro";
import CarrierMarketEconomics from "../../../../components/CarrierMarketEconomics.astro";
import {
  carrierEquipmentEconomics,
  type CarrierEquipmentSlug,
} from "../../../../data/carrier-market-economics";

export function getStaticPaths() {
  return (Object.keys(carrierEquipmentEconomics) as CarrierEquipmentSlug[]).map((equipment) => ({
    params: { equipment },
    props: { equipment },
  }));
}

interface Props { equipment: CarrierEquipmentSlug; }
const { equipment } = Astro.props;
const config = carrierEquipmentEconomics[equipment];
const path = `/paths/logistics/carriers/${equipment}/`;
const canonicalUrl = new URL(path, Astro.site).toString();
const title = `${config.label} Load Search & Dispatch Support | Hermes Logistics`;
const description = `${config.label} carrier support built around load-board comparison, total-mile economics, negotiation, dispatch, paperwork, and carrier-controlled load approval.`;
const loadBoardHref = "/load-board/#available-loads";
const intakeHref = equipment === "car-hauling" ? "/logistics/start-car-hauling-dispatch/" : "/carrier/";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${canonicalUrl}#service`,
    name: `${config.label} load-search and dispatch support`,
    description,
    provider: { "@id": "https://hermeslogisticsus.com/#organization" },
    areaServed: { "@type": "Country", name: "United States" },
    serviceType: `${config.label} carrier dispatch and operating support`,
    url: canonicalUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Logistics", item: "https://hermeslogisticsus.com/paths/logistics/" },
      { "@type": "ListItem", position: 3, name: "Carriers", item: "https://hermeslogisticsus.com/paths/logistics/carriers/" },
      { "@type": "ListItem", position: 4, name: config.label, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} schema={schema} robots="index,follow,max-image-preview:large">
  <SiteHeader theme="dark" activePath="/paths/logistics/" />
  <LogisticsProductNav theme="dark" active="carriers" />
  <main id="main-content">
    <section class="equipment-hero">
      <div class="shell equipment-hero-grid">
        <div>
          <p class="eyebrow">Hermes Logistics · {config.label}</p>
          <h1>{config.label} loads are not just a rate. Compare the full operating picture.</h1>
          <p class="equipment-lead">Hermes helps qualified carriers compare approved freight sources, total loaded and deadhead miles, equipment fit, timing, negotiation context, and back-office requirements while the carrier keeps final approval of every load.</p>
          <div class="equipment-actions">
            <a class="button button-primary" href={intakeHref}>Start {config.label.toLowerCase()} carrier review <ArrowRight size={18} aria-hidden="true" /></a>
            <a class="button" href={loadBoardHref}>Preview Load Board</a>
          </div>
          <div class="equipment-proofline">
            <span><ShieldCheck size={17} aria-hidden="true" />Carrier approves every load</span>
            <span><Check size={17} aria-hidden="true" />Multi-source comparison</span>
            <span><Check size={17} aria-hidden="true" />Total-mile economics</span>
          </div>
        </div>
        <aside class="equipment-hero-card">
          <p class="eyebrow">What Hermes evaluates</p>
          <h2>Rate per loaded mile is only the starting point.</h2>
          <p>{config.marketFocus}</p>
          <ul>{config.fitChecks.map((item) => <li><Check size={16} aria-hidden="true" />{item}</li>)}</ul>
        </aside>
      </div>
    </section>

    <CarrierMarketEconomics equipment={equipment} showMarkets={true} />

    <section class="section equipment-method">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Hermes operating method</p>
          <h2>Use more sources, but approve freight with one consistent decision model.</h2>
          <p>A board can help discover freight. It does not decide whether a load is profitable for your truck. Hermes can research and organize the facts; the motor carrier remains responsible for final commercial, route, equipment, safety, and compliance decisions.</p>
        </div>
        <div class="equipment-method-grid">
          <article><span>01</span><h3>Search</h3><p>Review approved marketplaces, broker/shipper sources, current truck position, timing, and equipment constraints.</p></article>
          <article><span>02</span><h3>Compare</h3><p>Normalize loaded miles, deadhead, rate, timing, extra work, payment/broker context, and the next likely market.</p></article>
          <article><span>03</span><h3>Negotiate</h3><p>Discuss the rate and terms within carrier-approved instructions instead of treating the posted number as final.</p></article>
          <article><span>04</span><h3>Carrier approves</h3><p>No public calculator or dispatcher replaces the carrier's final decision to accept or reject freight.</p></article>
        </div>
      </div>
    </section>

    <section class="equipment-final">
      <div class="shell equipment-final-grid">
        <div><p class="eyebrow">Ready to compare your real numbers?</p><h2>Bring the truck, market, availability, and current benchmark.</h2><p>Hermes can review the fit without publishing private carrier data or promising a rate, lane, load, utilization level, or revenue result.</p></div>
        <a class="button button-primary" href={intakeHref}>Start carrier review <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .equipment-hero { padding: 5.5rem 0 3.5rem; background: #07111f; color: white; }
  .equipment-hero-grid { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(320px,.8fr); gap: 2rem; align-items: center; }
  .equipment-hero h1 { max-width: 900px; font-size: clamp(2.25rem, 5vw, 4.8rem); line-height: .98; margin: .4rem 0 1rem; }
  .equipment-lead { max-width: 820px; color: #cbd5e1; font-size: 1.08rem; }
  .equipment-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin: 1.4rem 0; }
  .equipment-proofline { display: flex; flex-wrap: wrap; gap: 1rem; color: #dbeafe; font-size: .88rem; }
  .equipment-proofline span { display: inline-flex; gap: .4rem; align-items: center; }
  .equipment-hero-card { border: 1px solid rgba(255,255,255,.16); border-radius: 20px; padding: 1.35rem; background: rgba(255,255,255,.06); }
  .equipment-hero-card h2 { margin: .25rem 0 .75rem; }
  .equipment-hero-card p { color: #cbd5e1; }
  .equipment-hero-card ul { list-style: none; padding: 0; display: grid; gap: .55rem; }
  .equipment-hero-card li { display: flex; gap: .5rem; align-items: flex-start; }
  .equipment-method { background: white; }
  .equipment-method-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: .8rem; }
  .equipment-method-grid article { border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.1rem; }
  .equipment-method-grid article > span { color: #64748b; font-size: .8rem; font-weight: 800; }
  .equipment-method-grid h3 { margin: .35rem 0; }
  .equipment-method-grid p { color: #475569; }
  .equipment-final { padding: 3rem 0; background: #0f172a; color: white; }
  .equipment-final-grid { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; align-items: center; }
  .equipment-final h2 { margin: .25rem 0 .5rem; }
  .equipment-final p { color: #cbd5e1; max-width: 800px; }
  @media (max-width: 900px) { .equipment-hero-grid, .equipment-final-grid { grid-template-columns: 1fr; } .equipment-method-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 580px) { .equipment-method-grid { grid-template-columns: 1fr; } .equipment-hero { padding-top: 4rem; } }
</style>
