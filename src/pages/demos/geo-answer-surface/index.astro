---
import { ArrowRight, CheckCircle2, CircleDot, FileCheck2, Network, Sparkles } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { buildGeoAnswerSchema } from "../../../data/geo-answer-contract";
import { geoAnswerSurfaceDemo } from "../../../data/geo-answer-surface-demo";

const schema = buildGeoAnswerSchema(geoAnswerSurfaceDemo);
const claimsById = new Map(geoAnswerSurfaceDemo.claims.map((claim) => [claim.id, claim]));
const guided = geoAnswerSurfaceDemo.guidedPath;
const threadSteps = ["Question", "Entity", "Data", "Evidence", "Hermes interpretation", "Business action"];
---

<BaseLayout
  title="GEO Answer Surface Preview | Hermes"
  description="Noindex Hermes GEO preview showing a layered answer, entity relationships, evidence labeling, guided action, and machine-readable structure."
  robots="noindex,nofollow,noarchive"
  schema={schema}
>
  <div class="geo-preview hermes-surface-pearl">
    <SiteHeader />

    <main id="main-content">
      <section class="geo-preview-hero">
        <div class="geo-preview-shell">
          <nav class="geo-preview-breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span>
            <span>Demos</span><span aria-hidden="true">/</span>
            <span aria-current="page">GEO answer surface</span>
          </nav>

          <div class="geo-preview-hero-grid">
            <div class="geo-preview-copy">
              <p class="geo-preview-kicker">GEO PREVIEW · DEMO · CEO APPROVAL REQUIRED</p>
              <p class="geo-preview-question">Question</p>
              <h1>{geoAnswerSurfaceDemo.question}</h1>
              <div class="geo-preview-short-answer hermes-card">
                <span>Short answer</span>
                <p>{geoAnswerSurfaceDemo.layers.shortAnswer}</p>
              </div>
              <div class="geo-preview-actions">
                <a class="button button-primary" href="#guided-path">Find your route</a>
                <a class="button" href="#evidence">See evidence model</a>
              </div>
            </div>

            <aside class="geo-preview-intelligence hermes-workspace-panel" aria-label="Hermes intelligence preview">
              <div class="geo-preview-knot" aria-hidden="true"><Sparkles size={26} /></div>
              <p class="geo-preview-kicker">Living intelligence</p>
              <h2>Answer first. Then make it useful.</h2>
              <p>The surface reveals only the next useful layer: why it matters, what supports it, how it applies to you, and what to do next.</p>
              <div class="geo-preview-signal-row" aria-label="Truth labels">
                <span>Demo</span><span>Human-readable</span><span>Machine-readable</span>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="geo-thread-section hermes-surface-obsidian" aria-labelledby="thread-title">
        <div class="geo-preview-shell">
          <div class="geo-preview-heading geo-preview-heading-dark">
            <p class="geo-preview-kicker">Connected Thread</p>
            <h2 id="thread-title">The answer keeps its meaning from question to action.</h2>
            <p>Each node exists because it changes understanding. This is a semantic relationship map, not decorative networking.</p>
          </div>
          <ol class="geo-thread" aria-label="GEO connected thread">
            {threadSteps.map((step, index) => (
              <li>
                <span class="geo-thread-index">{String(index + 1).padStart(2, "0")}</span>
                <span>{step}</span>
                {index < threadSteps.length - 1 && <ArrowRight class="geo-thread-arrow" size={18} aria-hidden="true" />}
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="geo-layer-section" aria-labelledby="layer-title">
        <div class="geo-preview-shell">
          <div class="geo-preview-heading">
            <p class="geo-preview-kicker">Layered answer architecture</p>
            <h2 id="layer-title">Fast enough to scan. Deep enough to decide.</h2>
          </div>

          <div class="geo-layer-grid">
            <article class="hermes-card geo-layer-card">
              <span class="geo-layer-number">01</span>
              <h3>Why</h3>
              <ul>{geoAnswerSurfaceDemo.layers.why.map((item) => <li>{item}</li>)}</ul>
            </article>

            <article class="hermes-card geo-layer-card" id="evidence">
              <span class="geo-layer-number">02</span>
              <h3>Evidence</h3>
              <div class="geo-evidence-stack">
                {geoAnswerSurfaceDemo.layers.evidenceClaimIds.map((claimId) => {
                  const claim = claimsById.get(claimId);
                  return claim && (
                    <div class="geo-evidence-claim">
                      <span class="geo-truth-badge">{claim.truthLabel.replaceAll("_", " ")}</span>
                      <p>{claim.text}</p>
                    </div>
                  );
                })}
              </div>
            </article>

            <article class="hermes-card geo-layer-card">
              <span class="geo-layer-number">03</span>
              <h3>What it means for you</h3>
              <ul>{geoAnswerSurfaceDemo.layers.whatItMeansForYou.map((item) => <li>{item}</li>)}</ul>
            </article>

            <article class="hermes-card geo-layer-card">
              <span class="geo-layer-number">04</span>
              <h3>How to apply it</h3>
              <ol>{geoAnswerSurfaceDemo.layers.howToApply.map((item) => <li>{item}</li>)}</ol>
            </article>
          </div>
        </div>
      </section>

      <section class="geo-entity-section" aria-labelledby="entity-title">
        <div class="geo-preview-shell">
          <div class="geo-preview-heading">
            <p class="geo-preview-kicker">Entity-first design</p>
            <h2 id="entity-title">See who or what the answer is actually about.</h2>
            <p>Technical structure stays underneath. The visitor sees the entity, its role, why it matters, and how it connects.</p>
          </div>

          <div class="geo-entity-grid">
            {geoAnswerSurfaceDemo.entities.map((entity) => (
              <article class="geo-entity-card hermes-card">
                <div class="geo-entity-topline">
                  <span>{entity.type}</span>
                  <span class="geo-truth-badge">{entity.truthLabel}</span>
                </div>
                <h3>{entity.name}</h3>
                <p>{entity.description}</p>
                <dl>
                  <div><dt>Relation to Hermes</dt><dd>{entity.relationToHermes}</dd></div>
                  <div><dt>Why it matters</dt><dd>{entity.whyItMatters}</dd></div>
                </dl>
              </article>
            ))}
          </div>

          <div class="geo-relationship-panel hermes-workspace-panel" aria-label="Entity relationships">
            <div class="geo-relationship-heading">
              <Network size={26} aria-hidden="true" />
              <div><p class="geo-preview-kicker">Relationship map</p><h3>Meaningful edges only</h3></div>
            </div>
            <div class="geo-relationship-list">
              {geoAnswerSurfaceDemo.relationships.map((edge) => {
                const from = geoAnswerSurfaceDemo.entities.find((entity) => entity.id === edge.fromEntityId);
                const to = geoAnswerSurfaceDemo.entities.find((entity) => entity.id === edge.toEntityId);
                return (
                  <div class="geo-relationship-row">
                    <strong>{from?.name}</strong>
                    <span>{edge.relationship}</span>
                    <strong>{to?.name}</strong>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </section>

      {guided && (
        <section class="geo-guided-section" id="guided-path" aria-labelledby="guided-title" data-geo-guided>
          <div class="geo-preview-shell geo-guided-shell">
            <div class="geo-preview-heading">
              <p class="geo-preview-kicker">Question-led experience</p>
              <h2 id="guided-title">What are you trying to improve?</h2>
              <p>One answer creates one small realization, then the next question becomes more specific.</p>
            </div>

            <div class="geo-guided-panel hermes-card">
              <div class="geo-progress" aria-label="Guided progress"><span data-progress-bar></span></div>
              <p class="geo-guided-status" data-guided-realization aria-live="polite">Choose the closest situation. Nothing is submitted or stored.</p>

              {guided.questions.map((question) => (
                <div class="geo-guided-step" data-question-id={question.id} hidden={question.id !== guided.startQuestionId}>
                  <p class="geo-step-label">Question</p>
                  <h3>{question.prompt}</h3>
                  {question.helpText && <p>{question.helpText}</p>}
                  <div class="geo-choice-grid">
                    {question.options.map((option) => (
                      <button
                        type="button"
                        class="geo-choice"
                        data-realization={option.realization}
                        data-next-question={option.nextQuestionId}
                        data-outcome={option.outcomeId}
                      >
                        <CircleDot size={18} aria-hidden="true" />
                        <span>{option.label}</span>
                      </button>
                    ))}
                  </div>
                </div>
              ))}

              {guided.outcomes.map((outcome) => (
                <div class="geo-guided-outcome" data-outcome-id={outcome.id} hidden>
                  <p class="geo-step-label">Personalized outcome · Demo</p>
                  <h3>{outcome.title}</h3>
                  <p>{outcome.diagnosis}</p>
                  <ul>{outcome.application.map((item) => <li><CheckCircle2 size={17} aria-hidden="true" /> <span>{item}</span></li>)}</ul>
                  <a class="button button-primary" href={outcome.nextAction.href}>{outcome.nextAction.label}</a>
                  <button type="button" class="geo-restart" data-guided-restart>Start again</button>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="geo-source-section" aria-labelledby="source-title">
        <div class="geo-preview-shell">
          <div class="geo-preview-heading">
            <p class="geo-preview-kicker">Source / evidence module</p>
            <h2 id="source-title">Trust comes from saying exactly what the evidence is.</h2>
          </div>
          {geoAnswerSurfaceDemo.evidence.map((source) => (
            <article class="geo-source-card hermes-card">
              <FileCheck2 size={24} aria-hidden="true" />
              <div>
                <div class="geo-source-meta"><span>{source.sourceName}</span><span class="geo-truth-badge">{source.truthLabel}</span></div>
                <h3>{source.title}</h3>
                <p>{source.summary}</p>
                <small>Checked: {source.verifiedAt ? new Date(source.verifiedAt).toISOString().slice(0, 10) : "Not configured"}</small>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="geo-next-section hermes-surface-obsidian" aria-labelledby="next-title">
        <div class="geo-preview-shell geo-next-grid">
          <div>
            <p class="geo-preview-kicker">Next action</p>
            <h2 id="next-title">Continue the answer—not the generic funnel.</h2>
            <p>{geoAnswerSurfaceDemo.layers.nextAction.rationale}</p>
          </div>
          <a class="button button-primary" href={geoAnswerSurfaceDemo.layers.nextAction.href}>
            {geoAnswerSurfaceDemo.layers.nextAction.label} <ArrowRight size={18} aria-hidden="true" />
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-geo-guided]");
  if (root) {
    const questions = [...root.querySelectorAll<HTMLElement>("[data-question-id]")];
    const outcomes = [...root.querySelectorAll<HTMLElement>("[data-outcome-id]")];
    const realization = root.querySelector<HTMLElement>("[data-guided-realization]");
    const progress = root.querySelector<HTMLElement>("[data-progress-bar]");
    let completedSteps = 0;

    const hideAll = () => {
      questions.forEach((item) => { item.hidden = true; });
      outcomes.forEach((item) => { item.hidden = true; });
    };

    root.querySelectorAll<HTMLButtonElement>("[data-next-question], [data-outcome]").forEach((button) => {
      button.addEventListener("click", () => {
        completedSteps += 1;
        if (realization) realization.textContent = button.dataset.realization || "Your answer changed the route.";
        if (progress) progress.style.width = `${Math.min(100, completedSteps * 50)}%`;
        hideAll();
        const nextQuestion = button.dataset.nextQuestion;
        const outcome = button.dataset.outcome;
        if (nextQuestion) root.querySelector<HTMLElement>(`[data-question-id="${nextQuestion}"]`)?.removeAttribute("hidden");
        if (outcome) root.querySelector<HTMLElement>(`[data-outcome-id="${outcome}"]`)?.removeAttribute("hidden");
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-guided-restart]").forEach((button) => {
      button.addEventListener("click", () => {
        completedSteps = 0;
        hideAll();
        questions[0]?.removeAttribute("hidden");
        if (realization) realization.textContent = "Choose the closest situation. Nothing is submitted or stored.";
        if (progress) progress.style.width = "0%";
      });
    });
  }
</script>

<style>
  .geo-preview { min-height: 100vh; color: var(--hermes-ink); background: var(--hermes-pearl); }
  .geo-preview-shell { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }
  .geo-preview-hero { padding: clamp(3.5rem, 7vw, 6.5rem) 0 var(--hermes-section-space); background: radial-gradient(circle at 78% 18%, rgba(124, 92, 255, .10), transparent 28rem), var(--hermes-pearl); }
  .geo-preview-breadcrumbs { display: flex; gap: .55rem; flex-wrap: wrap; margin-bottom: 2.5rem; color: var(--hermes-muted); font-size: .86rem; }
  .geo-preview-breadcrumbs a { color: inherit; }
  .geo-preview-hero-grid { display: grid; grid-template-columns: minmax(0, 1.28fr) minmax(300px, .72fr); gap: clamp(2rem, 5vw, 5rem); align-items: end; }
  .geo-preview-copy h1 { max-width: 900px; margin: .5rem 0 1.6rem; font-family: var(--font-display); font-size: clamp(2.8rem, 6vw, 5.7rem); line-height: .94; letter-spacing: var(--hermes-display-tracking); text-wrap: balance; }
  .geo-preview-kicker, .geo-preview-question, .geo-step-label { margin: 0 0 .7rem; text-transform: uppercase; letter-spacing: .14em; font-size: .72rem; font-weight: 800; color: var(--hermes-violet); }
  .geo-preview-question { margin-top: 1.2rem; color: var(--hermes-muted); }
  .geo-preview-short-answer { max-width: 790px; padding: 1.2rem 1.35rem; display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 1rem; align-items: start; }
  .geo-preview-short-answer span { font-size: .74rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--hermes-violet); }
  .geo-preview-short-answer p { margin: 0; font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.5; }
  .geo-preview-actions { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .geo-preview-actions .button, .geo-next-grid .button { min-height: 46px; display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .geo-preview-intelligence { padding: clamp(1.5rem, 3vw, 2.4rem); position: relative; overflow: hidden; }
  .geo-preview-intelligence h2 { margin: .5rem 0 1rem; font-size: clamp(1.7rem, 3vw, 2.5rem); letter-spacing: -.04em; }
  .geo-preview-intelligence p:not(.geo-preview-kicker) { color: var(--hermes-muted-dark); line-height: 1.65; }
  .geo-preview-knot { width: 54px; height: 54px; display: grid; place-items: center; margin-bottom: 2rem; border-radius: 18px; background: var(--hermes-intelligence-gradient); box-shadow: 0 16px 50px rgba(124, 92, 255, .28); }
  .geo-preview-signal-row { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .geo-preview-signal-row span, .geo-truth-badge, .geo-source-meta span, .geo-entity-topline > span:first-child { width: fit-content; border-radius: var(--hermes-radius-pill); padding: .36rem .65rem; font-size: .68rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  .geo-preview-signal-row span { border: 1px solid var(--hermes-line-dark); color: var(--hermes-muted-dark); background: rgba(255,255,255,.04); }

  .geo-thread-section, .geo-next-section { padding: var(--hermes-section-space) 0; }
  .geo-preview-heading { max-width: 800px; margin-bottom: 2rem; }
  .geo-preview-heading h2, .geo-next-grid h2 { margin: .35rem 0 .8rem; font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1; letter-spacing: -.05em; text-wrap: balance; }
  .geo-preview-heading > p:not(.geo-preview-kicker), .geo-next-grid p { color: var(--hermes-muted); line-height: 1.65; }
  .geo-preview-heading-dark > p:not(.geo-preview-kicker), .geo-next-grid p { color: var(--hermes-muted-dark); }
  .geo-thread { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; }
  .geo-thread li { min-width: 0; min-height: 118px; position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; padding: 1rem; border: 1px solid var(--hermes-line-dark); border-right: 0; background: linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.015)); }
  .geo-thread li:first-child { border-radius: var(--hermes-radius-card) 0 0 var(--hermes-radius-card); }
  .geo-thread li:last-child { border-right: 1px solid var(--hermes-line-dark); border-radius: 0 var(--hermes-radius-card) var(--hermes-radius-card) 0; }
  .geo-thread-index { color: var(--hermes-violet); font-size: .72rem; font-weight: 800; }
  .geo-thread-arrow { position: absolute; right: -9px; top: 50%; z-index: 2; color: var(--hermes-ocean); transform: translateY(-50%); }

  .geo-layer-section, .geo-entity-section, .geo-guided-section, .geo-source-section { padding: var(--hermes-section-space) 0; }
  .geo-layer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .geo-layer-card { min-width: 0; padding: clamp(1.35rem, 3vw, 2.2rem); }
  .geo-layer-number { display: inline-block; margin-bottom: 1.5rem; color: var(--hermes-violet); font-size: .76rem; font-weight: 800; }
  .geo-layer-card h3 { margin: 0 0 1rem; font-size: 1.45rem; }
  .geo-layer-card ul, .geo-layer-card ol { margin: 0; padding-left: 1.2rem; color: var(--hermes-muted); line-height: 1.65; }
  .geo-layer-card li + li { margin-top: .65rem; }
  .geo-evidence-stack { display: grid; gap: .75rem; }
  .geo-evidence-claim { padding: 1rem; border-radius: 16px; background: rgba(124,92,255,.055); border: 1px solid rgba(124,92,255,.12); }
  .geo-evidence-claim p { margin: .7rem 0 0; line-height: 1.6; }
  .geo-truth-badge { background: rgba(124,92,255,.10); color: #6545ef; }

  .geo-entity-section { background: #fff; }
  .geo-entity-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .geo-entity-card { min-width: 0; padding: 1.35rem; }
  .geo-entity-topline { display: flex; justify-content: space-between; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .geo-entity-topline > span:first-child { color: var(--hermes-muted); background: rgba(11,13,18,.04); }
  .geo-entity-card h3 { margin: 1.2rem 0 .7rem; font-size: 1.3rem; }
  .geo-entity-card > p { color: var(--hermes-muted); line-height: 1.6; }
  .geo-entity-card dl { margin: 1.2rem 0 0; display: grid; gap: 1rem; }
  .geo-entity-card dt { margin-bottom: .25rem; font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--hermes-violet); }
  .geo-entity-card dd { margin: 0; color: var(--hermes-muted); line-height: 1.5; }
  .geo-relationship-panel { margin-top: 1rem; padding: clamp(1.3rem, 3vw, 2rem); }
  .geo-relationship-heading { display: flex; align-items: center; gap: 1rem; }
  .geo-relationship-heading h3 { margin: .1rem 0 0; font-size: 1.4rem; }
  .geo-relationship-list { display: grid; gap: .65rem; margin-top: 1.4rem; }
  .geo-relationship-row { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: .8rem; align-items: center; padding: .85rem 1rem; border-radius: 15px; background: rgba(255,255,255,.045); border: 1px solid var(--hermes-line-dark); }
  .geo-relationship-row span { color: var(--hermes-ocean); text-align: center; font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; }
  .geo-relationship-row strong:last-child { text-align: right; }

  .geo-guided-shell { max-width: 920px; }
  .geo-guided-panel { padding: clamp(1.3rem, 4vw, 2.7rem); }
  .geo-progress { width: 100%; height: 5px; overflow: hidden; border-radius: 99px; background: rgba(11,13,18,.07); }
  .geo-progress span { display: block; width: 0; height: 100%; background: var(--hermes-intelligence-gradient); transition: width var(--hermes-motion-standard) var(--hermes-ease); }
  .geo-guided-status { min-height: 1.5em; margin: 1rem 0 2rem; color: var(--hermes-muted); }
  .geo-guided-step h3, .geo-guided-outcome h3 { margin: .35rem 0 .6rem; font-size: clamp(1.8rem, 4vw, 2.8rem); letter-spacing: -.04em; }
  .geo-guided-step > p:not(.geo-step-label), .geo-guided-outcome > p { color: var(--hermes-muted); line-height: 1.6; }
  .geo-choice-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; margin-top: 1.4rem; }
  .geo-choice { min-width: 0; min-height: 92px; display: flex; align-items: flex-start; gap: .7rem; padding: 1rem; text-align: left; color: var(--hermes-ink); border: 1px solid var(--hermes-line-light); border-radius: 18px; background: #fff; cursor: pointer; transition: transform var(--hermes-motion-fast) var(--hermes-ease), border-color var(--hermes-motion-fast) var(--hermes-ease), box-shadow var(--hermes-motion-fast) var(--hermes-ease); }
  .geo-choice:hover, .geo-choice:focus-visible { transform: translateY(-2px); border-color: rgba(124,92,255,.35); box-shadow: var(--hermes-shadow-card-hover); outline: none; }
  .geo-choice svg { flex: 0 0 auto; color: var(--hermes-violet); }
  .geo-guided-outcome ul { list-style: none; padding: 0; display: grid; gap: .65rem; margin: 1.4rem 0; }
  .geo-guided-outcome li { display: flex; gap: .6rem; align-items: flex-start; color: var(--hermes-muted); }
  .geo-guided-outcome li svg { flex: 0 0 auto; margin-top: .15rem; color: var(--hermes-success); }
  .geo-restart { margin-left: .8rem; min-height: 44px; border: 0; background: transparent; color: var(--hermes-muted); text-decoration: underline; cursor: pointer; }

  .geo-source-card { max-width: 900px; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; padding: 1.3rem; }
  .geo-source-card > svg { color: var(--hermes-violet); }
  .geo-source-meta { display: flex; gap: .6rem; flex-wrap: wrap; align-items: center; }
  .geo-source-meta > span:first-child { padding-left: 0; background: transparent; color: var(--hermes-muted); }
  .geo-source-card h3 { margin: .6rem 0; }
  .geo-source-card p { margin: 0 0 .7rem; color: var(--hermes-muted); line-height: 1.6; }
  .geo-source-card small { color: var(--hermes-muted); }

  .geo-next-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: center; }
  .geo-next-grid > div { max-width: 700px; }

  @media (max-width: 900px) {
    .geo-preview-hero-grid, .geo-next-grid { grid-template-columns: 1fr; }
    .geo-entity-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .geo-thread { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .7rem; }
    .geo-thread li, .geo-thread li:first-child, .geo-thread li:last-child { border: 1px solid var(--hermes-line-dark); border-radius: 18px; }
    .geo-thread-arrow { display: none; }
