---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
const title = "International Digital Solutions Sales | Hermes Careers";
const description = "Explore international business development for websites, CRM, SEO and AI solutions. Review the role and qualification process; current hiring terms require verification.";
const solutions = [
  ["Websites & redesign", "Business websites, redesign, digital storefronts and accessible mobile experiences."],
  ["SEO and AI discovery", "Search visibility, local SEO, technical SEO and evidence-based AI search readiness."],
  ["CRM & client workflows", "Customer records, lead handling, appointment workflows and operational reporting."],
  ["AI and process automation", "Scoping practical AI assistants, workflows and integration opportunities with technical specialists."],
];
const questions = [
  "Which country and language can you use confidently for business negotiations?",
  "Which products have you sold, and what verifiable results did you achieve in the last 3–6 months?",
  "What average deal size, lead sources and conversion rates did you personally manage?",
  "Which Hermes product and target market would you choose for a 14-day sales plan?",
  "What working hours and collaboration model are available to you?",
];
---
<BaseLayout title={title} description={description} robots="noindex,nofollow">
  <SiteHeader activePath="/paths/technology/" />
  <main id="main-content" class="sales-career">
    <section class="hero">
      <div class="shell">
        <p class="eyebrow">Hermes · International business development</p>
        <h1>Sell digital solutions that help businesses operate and grow.</h1>
        <p class="lead">Explore sales and business development across websites, CRM, SEO and AI automation. We are building multilingual market coverage, with a long-term ambition to reach 110 countries. This page explains the role scope and assessment process; it does not represent a verified open employment offer.</p>
        <div class="actions"><a class="button button-primary" href="#qualification">Review qualification</a><a class="button" href="/logistics/apply/?for=career&role=international-digital-sales&source=hermes_careers">Share general career interest</a><a class="button" href="/logistics/careers/">Current verified vacancies</a></div>
      </div>
    </section>
    <section class="section"><div class="shell">
      <h2>Solutions you could represent</h2>
      <div class="cards">{solutions.map(([name,body]) => <article><h3>{name}</h3><p>{body}</p></article>)}</div>
      <p>Sales managers identify business needs, qualify opportunities, document a CRM pipeline and coordinate commercial proposals with authorized product and technical owners. They do not independently promise unverified integrations, prices or implementation outcomes.</p>
    </div></section>
    <section class="section alt" id="qualification"><div class="shell">
      <h2>How candidates are assessed</h2>
      <p>We consider relevant experience, languages, measurable results and practical sales reasoning. A possible assessment asks you to select one product, define a target customer and outline a 14-day funnel with realistic assumptions.</p>
      <ol>{questions.map((q)=><li>{q}</li>)}</ol>
      <p>Do not submit confidential customer data, passwords, identity documents or unredacted employer records. A practical assessment does not guarantee training, employment or compensation.</p>
      <p><strong>Publication status:</strong> Role-specific hiring organization, employment type, eligible countries, compensation and a verified application receiver are still under review. Until those details are confirmed, this page is an informational role overview, not an active vacancy or application form.</p>
      <p><strong>General interest route:</strong> You may submit factual experience, languages, location and availability to the existing private Hermes HR intake. This records general career interest only; it is not an application to a verified open vacancy and does not create employment, compensation or interview rights.</p>
      <div class="actions"><a class="button button-primary" href="/logistics/apply/?for=career&role=international-digital-sales&source=hermes_careers">Share general career interest</a><a class="button" href="/logistics/careers/">Review the current careers process</a></div>
    </div></section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
.sales-career{background:#f8faff;color:#14213d}.hero{padding:clamp(7rem,12vw,10rem) 0 4rem;background:#0b1c44;color:#fff}.hero h1{max-width:17ch;font-size:clamp(2.6rem,5vw,4.7rem);line-height:1.07}.lead{max-width:75ch;font-size:1.15rem;line-height:1.75;color:#d7e3ff}.actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:2rem}.hero .button:not(.button-primary){color:#fff;border:1px solid #93a9d8}.section{padding:4rem 0}.alt{background:#edf3ff}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1.5rem 0}.cards article{background:#fff;border:1px solid #dce4f2;border-radius:16px;padding:1.5rem}.cards h3{margin-top:0}.cards p,.section p,.section li{line-height:1.7}.section ol{padding-left:1.5rem;max-width:78ch}.section li{margin:.6rem 0}@media(max-width:640px){.cards{grid-template-columns:1fr}.actions .button{width:100%;justify-content:center}}
</style>
