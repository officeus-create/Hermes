---
import { ArrowRight, BriefcaseBusiness, Check, Globe, Mail, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const applicationSubject = "Application · International Sales Manager · Websites & SEO";
const applicationBody = `Name:\nCountry and city:\nLanguages and levels:\nRelevant sales experience:\nExperience with websites, SEO, marketing, or U.S. clients:\nRecent measurable results:\nAvailability and time zone:\nLinkedIn or portfolio:\nWhy this role fits you:`;
const applicationHref = `mailto:officeus@hermeslogisticsus.com?subject=${encodeURIComponent(applicationSubject)}&body=${encodeURIComponent(applicationBody)}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://hermeslogisticsus.com/careers/#page",
  url: "https://hermeslogisticsus.com/careers/",
  name: "Careers at Hermes",
  description: "Explore current Hermes roles in sales, websites, SEO, logistics, marketing, operations, and technology.",
  isPartOf: { "@id": "https://hermeslogisticsus.com/#website" },
  about: { "@id": "https://hermeslogisticsus.com/#organization" },
};
---

<BaseLayout title="Careers at Hermes | Sales, Websites, SEO & Operations" description="Explore current Hermes opportunities, including International Sales Manager for website creation and SEO services in the U.S. market." schema={schema}>
  <SiteHeader theme="dark" />
  <main id="main-content" class="careers-page">
    <section class="careers-hero">
      <div class="shell careers-hero-layout">
        <div>
          <p class="eyebrow">Hermes Careers</p>
          <h1>Build business systems, markets, and client relationships with Hermes.</h1>
          <p class="careers-lead">We publish roles only when there is a defined business need. An application begins a review and does not guarantee an interview, training place, contract, or employment.</p>
          <div class="careers-actions">
            <a class="button button-primary" href="#international-sales-manager">View the priority vacancy<ArrowRight size={18} aria-hidden="true" /></a>
            <a class="button" href={applicationHref}><Mail size={18} aria-hidden="true" />Send an application</a>
          </div>
        </div>
        <aside class="careers-principles" aria-label="How Hermes evaluates applications">
          <BriefcaseBusiness size={28} aria-hidden="true" />
          <h2>What matters in the first review</h2>
          <ul>
            <li><Check size={18} aria-hidden="true" />Clear communication and follow-through</li>
            <li><Check size={18} aria-hidden="true" />Factual experience and measurable results</li>
            <li><Check size={18} aria-hidden="true" />Ability to work with international teams and U.S. clients</li>
            <li><Check size={18} aria-hidden="true" />Readiness to learn the actual Hermes service process</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="section" id="international-sales-manager">
      <div class="shell vacancy-layout">
        <article class="vacancy-card">
          <div class="vacancy-heading">
            <div><p class="eyebrow">Priority opening · International sales</p><h2>International Sales Manager — Websites & SEO for the U.S. market</h2></div>
            <span>Remote · International</span>
          </div>
          <p>This role focuses first on helping U.S. businesses understand and evaluate website creation, website improvement, SEO, and Local SEO services. The manager works with qualified prospects, documents business needs, prepares a clear handoff, and supports the commercial conversation with the Hermes technology and marketing teams.</p>
          <div class="vacancy-grid">
            <section><h3>Main responsibilities</h3><ul>
              <li><Check size={18} aria-hidden="true" />Find and qualify U.S. businesses that may need a website, redesign, SEO, or Local SEO.</li>
              <li><Check size={18} aria-hidden="true" />Conduct structured discovery conversations and record the real business problem.</li>
              <li><Check size={18} aria-hidden="true" />Explain scope honestly without promising rankings, revenue, deadlines, or results that have not been approved.</li>
              <li><Check size={18} aria-hidden="true" />Coordinate proposals, follow-up, and handoff to the appropriate Hermes specialist.</li>
              <li><Check size={18} aria-hidden="true" />Maintain a clear pipeline and report outreach, conversations, qualified opportunities, and next actions.</li>
            </ul></section>
            <section><h3>What strengthens an application</h3><ul>
              <li><Check size={18} aria-hidden="true" />English suitable for business conversations with U.S. clients.</li>
              <li><Check size={18} aria-hidden="true" />Russian or Ukrainian is useful for internal coordination and selected client segments.</li>
              <li><Check size={18} aria-hidden="true" />Sales, account management, marketing, SEO, website, CRM, or B2B experience.</li>
              <li><Check size={18} aria-hidden="true" />Examples of measurable work rather than general claims.</li>
              <li><Check size={18} aria-hidden="true" />A stable internet connection and working availability aligned with agreed U.S. market hours.</li>
            </ul></section>
          </div>
          <div class="vacancy-boundary"><ShieldCheck size={22} aria-hidden="true" /><p>Compensation structure, schedule, targets, trial tasks, contractor or employment status, and commercial terms are discussed only after role fit is reviewed. This page does not promise hiring, earnings, client volume, or a specific start date.</p></div>
          <div class="vacancy-apply"><div><Globe size={22} aria-hidden="true" /><p><strong>Application language:</strong> English, Russian, or Ukrainian. Include your city, time zone, language levels, recent results, and availability.</p></div><a class="button button-primary" href={applicationHref}>Apply by email<ArrowRight size={18} aria-hidden="true" /></a></div>
        </article>
      </div>
    </section>

    <section class="section careers-process" aria-labelledby="careers-process-title"><div class="shell"><div class="section-heading"><p class="eyebrow">Application process</p><h2 id="careers-process-title">A clear review before any commitment.</h2></div><ol>
      <li><span>01</span><div><h3>Structured application</h3><p>Send the requested facts, examples, language levels, location, and availability.</p></div></li>
      <li><span>02</span><div><h3>Role-fit review</h3><p>The team compares your background with current commercial and operational needs.</p></div></li>
      <li><span>03</span><div><h3>Interview or practical task</h3><p>Selected applicants may be invited to a conversation, a test, or a short practical evaluation.</p></div></li>
      <li><span>04</span><div><h3>Terms in writing</h3><p>Only an approved written offer or agreement confirms responsibilities, compensation, schedule, and start conditions.</p></div></li>
    </ol></div></section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .careers-page{background:#f6f3eb;color:#071038}.careers-hero{padding:clamp(8rem,14vw,12rem) 0 clamp(4rem,8vw,7rem);background:radial-gradient(circle at 80% 10%,rgba(79,117,255,.22),transparent 32%),#071038;color:#fff}.careers-hero-layout,.vacancy-layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.75fr);gap:clamp(2rem,6vw,5rem);align-items:start}.careers-hero h1{max-width:880px;font-size:clamp(2.8rem,7vw,6.4rem);line-height:.94;margin:.8rem 0 1.5rem}.careers-lead{max-width:760px;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.65;color:rgba(255,255,255,.78)}.careers-actions,.vacancy-apply{display:flex;flex-wrap:wrap;gap:.9rem;align-items:center;margin-top:2rem}.careers-principles{padding:1.5rem;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.07)}.careers-principles h2{margin:1rem 0;font-size:1.35rem}.careers-principles ul,.vacancy-card ul{display:grid;gap:.8rem;padding:0;margin:0;list-style:none}.careers-principles li,.vacancy-card li{display:grid;grid-template-columns:auto 1fr;gap:.65rem;align-items:start;line-height:1.5}.vacancy-layout{grid-template-columns:1fr}.vacancy-card{background:#fff;border:1px solid rgba(7,16,56,.12);padding:clamp(1.5rem,4vw,3.5rem);box-shadow:0 24px 70px rgba(7,16,56,.08)}.vacancy-heading{display:flex;justify-content:space-between;gap:2rem;align-items:start;margin-bottom:1.5rem}.vacancy-heading h2{max-width:900px;font-size:clamp(2rem,4vw,3.6rem);line-height:1.04;margin:.5rem 0}.vacancy-heading>span{white-space:nowrap;border:1px solid rgba(7,16,56,.18);padding:.55rem .75rem;font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.vacancy-card>p{max-width:920px;font-size:1.08rem;line-height:1.75}.vacancy-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem;margin:2.5rem 0}.vacancy-grid section{padding:1.5rem;background:#f6f3eb}.vacancy-grid h3{margin-top:0;font-size:1.25rem}.vacancy-boundary{display:grid;grid-template-columns:auto 1fr;gap:.9rem;padding:1.2rem;border-left:3px solid #334fdd;background:#eef1ff}.vacancy-boundary p{margin:0;line-height:1.6}.vacancy-apply{justify-content:space-between}.vacancy-apply>div{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.7rem;max-width:760px}.vacancy-apply p{margin:0}.careers-process{background:#fff}.careers-process ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;padding:0;margin:2rem 0 0;list-style:none;background:rgba(7,16,56,.12)}.careers-process li{background:#fff;padding:1.4rem}.careers-process li>span{font-weight:800;color:#334fdd}.careers-process h3{margin:.8rem 0 .45rem}.careers-process p{margin:0;line-height:1.55}@media(max-width:900px){.careers-hero-layout,.vacancy-grid{grid-template-columns:1fr}.careers-process ol{grid-template-columns:repeat(2,minmax(0,1fr))}.vacancy-heading{flex-direction:column}}@media(max-width:560px){.careers-process ol{grid-template-columns:1fr}.careers-actions .button,.vacancy-apply .button{width:100%;justify-content:center}}
</style>
