---
import AcademyPublicPage from "../../../components/AcademyPublicPage.astro";
import { academySubsitePages } from "../../../data/academy-subsite";

const baseContent = academySubsitePages.marketing;
const content = {
  ...baseContent,
  audienceIntro:
    "The program is suitable for learners and working professionals who want to understand the complete growth system rather than treat social posting as an isolated task. For the current international track, working Russian or Ukrainian is useful for internal communication and translation workflows. A second market language — for example Italian, Spanish, French, German, or another language used where the participant lives or works — is a strong advantage. English at B2 level or higher is also a strong advantage and may be required for English-market client work.",
  faq: baseContent.faq.concat(
    {
      question: "Which language combinations are most useful for the Marketing program?",
      answer: "For the current international track, Russian or Ukrainian can support internal communication and translation workflows. Candidates who also speak the language of their local market — for example Italian, Spanish, French, German, or another relevant language — have a strong practical advantage. English at B2 level or higher is also a strong advantage and may be required for English-market client communication.",
    },
    {
      question: "Are there legal or sanctions-related eligibility restrictions?",
      answer: "Yes. Participation is subject to applicable sanctions, export-control, payment, and other legal-compliance requirements. Nationality alone is not an automatic exclusion criterion; an application may be declined or limited where applicable law or sanctions prohibit or materially restrict participation, payments, access, or services.",
    },
  ),
  boundary:
    `${baseContent.boundary} Participation is also subject to applicable sanctions, export-control, payment, and legal-compliance requirements; nationality alone is not an automatic exclusion criterion.`,
};
---

<AcademyPublicPage content={content} />
