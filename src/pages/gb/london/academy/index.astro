---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
const tracks = [
  ["us-logistics-course","US logistics course"],["freight-dispatcher-training","Freight dispatcher training"],["load-planner-training","Load planner training"],["carrier-sales-training","Carrier sales training"],["shipper-dealer-sales-training","Shipper & dealer sales training"],["english-readiness","English readiness for US logistics"],["how-training-works","How training works"],["apply","Apply from the UK"],["faq","UK Academy FAQ"]
];
---
<BaseLayout title="Hermes Academy London | US Logistics Training" description="London and UK entry point to Hermes Academy training in US logistics operations, planning, sales and professional market communication.">
<SiteHeader theme="dark" /><main id="main-content"><section class="section detail-overview"><div class="shell detail-intro"><p class="eyebrow">Hermes Academy · London</p><h1>US logistics training for people building practical market skills from the UK.</h1><p>Study operations, load planning, carrier and broker workflows, sales, negotiation and disciplined pipeline work. Training is educational and does not guarantee employment or income. Live US-market communication tracks require spoken English at B2+.</p><a class="button button-primary" href="/academy/apply/?source=london">Apply to Academy</a></div></section><section class="section"><div class="shell grid">{tracks.map(([slug,title]) => <article><h2><a href={`/gb/london/academy/${slug}/`}>{title}</a></h2><p>Review requirements, scope and the next step for this training path.</p></article>)}</div></section></main><SiteFooter /></BaseLayout>
<style>.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.grid article{padding:1.25rem;border:1px solid #dce3f3;border-radius:12px}@media(max-width:800px){.grid{grid-template-columns:1fr}}</style>
