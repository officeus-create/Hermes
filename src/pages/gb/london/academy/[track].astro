---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import LondonAnalytics from "../../../../components/LondonAnalytics.astro";

export function getStaticPaths(){
  const pages = [
    {track:"us-logistics-course",title:"US Logistics Course London | Hermes Academy",h1:"Build a working map of the US logistics system.",description:"Applied US logistics education for people living in London and the UK, covering operations, load flow, carriers, brokers, sales and disciplined execution.",points:["Carrier, broker, shipper and dealer roles","Loads, equipment and operating flow","Metrics, communication and workflow discipline"]},
    {track:"freight-dispatcher-training",title:"Freight Dispatcher Training London | Hermes Academy",h1:"Learn dispatch as an operating workflow, not a list of load boards.",description:"Freight dispatcher training for UK residents focused on US-market load sourcing, execution, communication, tracking and decision discipline.",points:["Load sourcing and qualification","Driver, broker and load communication","Execution, tracking and exception handling"]},
    {track:"load-planner-training",title:"Load Planner Training London | Hermes Academy",h1:"Learn to plan freight around equipment, geography, timing and gross.",description:"US load planner training in London covering lane logic, equipment constraints, sequencing, rate context and operational trade-offs.",points:["Lane and equipment logic","Scheduling and route sequencing","Gross, deadhead and operational trade-offs"]},
    {track:"carrier-sales-training",title:"Carrier Sales Training London | Hermes Academy",h1:"Learn carrier conversations through qualification, value and follow-up.",description:"Carrier sales training for people in the UK who want to understand US trucking customer acquisition, qualification, objections, follow-up and pipeline discipline.",points:["Carrier qualification","Value positioning and objections","CRM stages and follow-up discipline"]},
    {track:"shipper-dealer-sales-training",title:"Shipper & Dealer Sales Training London | Hermes Academy",h1:"Learn to create direct freight demand conversations.",description:"US shipper and dealer sales training for London and UK residents, focused on research, discovery questions, value, negotiation and pipeline progression.",points:["Prospect research and discovery","Needs, value and negotiation","Follow-up and pipeline progression"]},
    {track:"english-readiness",title:"English for US Logistics Readiness | London",h1:"Use English as an operating skill for US-market communication.",description:"English-readiness guidance for Hermes Academy logistics tracks. Live calls, negotiations and communication-heavy practice require working spoken English at B2 or higher.",points:["Listening under call pressure","Questions, clarification and negotiation","Professional vocabulary and concise follow-up"]},
    {track:"how-training-works",title:"How US Logistics Training Works in the UK | Hermes Academy",h1:"Progress from understanding to practice through clear gates.",description:"How Hermes Academy logistics training works for UK residents: learning, observation, exercises, readiness checks and approved practice without employment or income guarantees.",points:["Learn the operating model","Demonstrate understanding and discipline","Enter approved practice when requirements are met"]},
    {track:"apply",title:"Apply to Hermes Academy from the UK | London",h1:"Apply with your language level, schedule and relevant experience.",description:"UK application entry point for Hermes Academy. Fit depends on track capacity, language, schedule, discipline, experience and applicable legal or compliance requirements.",points:["State location and languages","Describe recent experience and measurable results","Choose the training direction you want to pursue"]},
    {track:"faq",title:"US Logistics Training FAQ London | Hermes Academy",h1:"Questions to answer before choosing a US logistics training track.",description:"London and UK FAQ for Hermes Academy US logistics training covering English readiness, format, progression, outcomes and compliance boundaries.",points:["Live US communication requires B2+ English","Training does not guarantee a job, placement or income","Progression depends on readiness, capacity and program requirements"]},
  ];
  return pages.map(page=>({params:{track:page.track},props:{page}}));
}
const {page}=Astro.props; const url=`https://hermeslogisticsus.com/gb/london/academy/${page.track}/`;
const applyHref=`/academy/apply/?program=us-logistics-operations&utm_source=london&utm_medium=organic&utm_campaign=london-academy&utm_content=${page.track}&track=${page.track}`;
const schema:any[]=[{"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"London Academy",item:"https://hermeslogisticsus.com/gb/london/academy/"},{"@type":"ListItem",position:2,name:page.h1,item:url}]}];
if(!["apply","faq","how-training-works"].includes(page.track)) {
  schema.push({"@context":"https://schema.org","@type":"Course",name:page.h1,description:page.description,provider:{"@type":"Organization",name:"Hermes Academy",sameAs:"https://hermeslogisticsus.com/academy/"},url});
} else {
  schema.push({"@context":"https://schema.org","@type":"WebPage",name:page.h1,description:page.description,url});
}
---
<BaseLayout title={page.title} description={page.description} schema={schema}>
<SiteHeader theme="dark" /><main id="main-content"><section class="section detail-overview"><div class="shell detail-intro"><p class="eyebrow">London · Hermes Academy</p><h1>{page.h1}</h1><p>{page.description}</p><p><a class="button button-primary" href={applyHref}>Apply to Academy</a> <a class="button" href="/gb/london/academy/">London Academy hub</a></p></div></section><section class="section"><div class="shell grid">{page.points.map(point=><article><h2>{point}</h2><p>Training scope and progression are reviewed against the selected track, readiness and approved program format.</p></article>)}</div></section><section class="section"><div class="shell"><p><strong>Boundary:</strong> education and practice do not guarantee employment, placement, earnings or business outcomes. Participation is subject to capacity and applicable legal/compliance requirements.</p></div></section></main><LondonAnalytics /><SiteFooter /></BaseLayout>
<style>.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.grid article{padding:1.25rem;border:1px solid #dce3f3;border-radius:12px}.grid p{color:#64718f;line-height:1.65}@media(max-width:800px){.grid{grid-template-columns:1fr}}</style>
