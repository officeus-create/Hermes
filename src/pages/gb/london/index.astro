---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
---
<BaseLayout title="London Marketing, IT & US Logistics Training | Hermes" description="Hermes services and training for London: marketing, websites, SEO, IT and practical US logistics education.">
  <SiteHeader theme="dark" />
  <main id="main-content">
    <section class="section detail-overview">
      <div class="shell detail-intro">
        <p class="eyebrow">London · United Kingdom</p>
        <h1>Marketing, IT and US logistics training for London.</h1>
        <p>One London hub for businesses that need websites, SEO, social media and automation, and for people who want practical training connected to the US logistics market.</p>
        <p><a class="button button-primary" href="/business-growth/">Request a growth plan</a> <a class="button" href="/academy/us-logistics-operations/">Explore logistics training</a></p>
      </div>
    </section>
    <section class="section"><div class="shell"><div class="cards">
      <article><h2>Marketing</h2><p>Instagram, Facebook, Threads, content systems, Meta Ads and measurable lead generation for London businesses.</p><a href="/gb/london/marketing/">London marketing</a></article>
      <article><h2>IT & websites</h2><p>Business websites, landing pages, SEO foundations, integrations and practical automation.</p><a href="/gb/london/it-web-development/">London IT & web development</a></article>
      <article><h2>US logistics training</h2><p>Training for Russian- and Ukrainian-speaking residents in the UK who want to understand real US logistics operations.</p><a href="/gb/london/us-logistics-training/">London logistics training</a></article>
    </div></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.cards article{padding:1.4rem;border:1px solid #dce3f3;border-radius:12px}.cards p{color:#64718f;line-height:1.6}@media(max-width:800px){.cards{grid-template-columns:1fr}}</style>
