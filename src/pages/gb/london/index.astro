---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import LondonAnalytics from "../../../components/LondonAnalytics.astro";
const alternates=[{lang:"en",href:"/gb/london/"},{lang:"ru",href:"/ru/gb/london/"},{lang:"uk",href:"/ua/gb/london/"},{lang:"x-default",href:"/gb/london/"}];
const url="https://hermeslogisticsus.com/gb/london/";
const schema=[
 {"@context":"https://schema.org","@type":"CollectionPage",name:"Hermes London",description:"London hub for Hermes marketing, IT/web development and US logistics training, with distinct service, industry, guide and Academy paths.",url,isPartOf:{"@id":"https://hermeslogisticsus.com/#website"},about:{"@id":"https://hermeslogisticsus.com/#organization"}},
 {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Hermes",item:"https://hermeslogisticsus.com/"},{"@type":"ListItem",position:2,name:"London",item:url}]}
];
const services=[
 ["social-media-management","Social media management","Build a repeatable social content and lead path across Instagram, Facebook and Threads."],["meta-ads","Meta Ads","Test paid demand with controlled campaign, landing-page and tracking decisions."],["website-development","Website development","Build or rebuild a website around real services, conversion paths and technical SEO."],["seo-services","SEO services","Improve crawlability, canonical ownership, search relevance and qualified organic actions."],["local-seo","Local SEO","Strengthen real London service relevance without fake offices or mass doorway pages."],["google-business-profile","Google Business Profile","Align eligible profile information, services, reviews and website attribution."],["landing-page-development","Landing pages","Create focused campaign destinations with one clear offer and measurable CTA."],["crm-automation","CRM automation","Route, deduplicate and follow up on enquiries inside the existing authoritative workflow."],["content-reels-scripts","Content, reels & scripts","Turn expertise into short-form content tied to a useful next action."],["marketing-audit","Marketing audit","Identify the first measurable bottleneck before adding another channel."]
];
const industries=[
 ["auto-repair-marketing","Auto repair","Service-led local discovery and booking or enquiry paths for garages and repair businesses."],["beauty-salon-marketing","Beauty salons","Visual content, local discovery and booking journeys for beauty services."],["dental-clinic-marketing","Dental clinics","Evidence-aware patient acquisition and privacy-safe enquiry measurement."],["restaurant-marketing","Restaurants","Connect local discovery, menu and venue content with reservation journeys."],["contractor-marketing","Contractors","Qualify real job types and service areas before quote requests reach the team."],["logistics-company-marketing","Logistics companies","Explain operational value to business buyers without unsupported fleet or customer claims."],["car-detailing-marketing","Car detailing","Use permissioned visual proof, real service pages and booking paths."],["cleaning-company-marketing","Cleaning companies","Organise residential or commercial service demand around useful quote context."],["home-services-marketing","Home services","Map real job categories and service areas to qualified enquiry flows."],["professional-services-marketing","Professional services","Turn expertise, process and practitioner-reviewed content into credible demand."]
];
const guides=[
 ["digital-growth-system","Digital growth system"],["small-business-website-guide","Small-business website guide"],["local-seo-london","Local SEO in London"],["meta-ads-expectations","Meta Ads expectations"],["social-media-strategy","Social media strategy"],["website-seo-funnel","Website + SEO funnel"],["us-logistics-roles","US logistics roles"],["dispatcher-vs-load-planner","Dispatcher vs load planner"],["b2-english-us-logistics","B2 English for US logistics"],["training-curriculum","Training curriculum"]
];
const decisionSteps=[
 ["1. Choose the objective","Business growth and Academy training are separate journeys. Start with the outcome you need to understand, not the largest list of available pages."],
 ["2. Open one canonical owner","Use the service, industry, guide or Academy page that best matches the decision. Related pages should support that owner rather than compete with it."],
 ["3. Measure the next action","For commercial pages, evaluate qualified enquiry progression. For Academy pages, evaluate program understanding and appropriate application handoff. Neither journey guarantees an external outcome."],
];
---
<BaseLayout title="London Marketing, IT & US Logistics Training | Hermes" description="Hermes services and training for London: marketing, websites, SEO, IT and practical US logistics education." alternates={alternates} schema={schema}>
  <SiteHeader theme="dark" />
  <main id="main-content">
    <section class="section detail-overview"><div class="shell detail-intro">
      <p class="eyebrow">London · United Kingdom</p>
      <h1>Marketing, IT and US logistics training for London.</h1>
      <p>One London hub for businesses that need websites, SEO, social media and automation, and for people who want practical training connected to the US logistics market. Each route below owns a distinct decision so visitors and search engines do not have to choose between near-identical pages.</p>
      <p><a class="button button-primary" href="/business-growth/?utm_source=london&utm_medium=organic&utm_campaign=london-hub&utm_content=hub&service=marketing">Request a growth plan</a> <a class="button" href="/gb/london/academy/">Explore London Academy</a></p>
      <p class="language-links">Language: <a href="/ru/gb/london/">Русский</a> · <a href="/ua/gb/london/">Українська</a></p>
    </div></section>

    <section class="section"><div class="shell"><div class="cards">
      <article><h2>Marketing</h2><p>For London businesses that need a measurable path from discovery to qualified enquiry across search, social, paid media and follow-up.</p><a href="/gb/london/marketing/">London marketing</a></article>
      <article><h2>IT & websites</h2><p>For businesses that need a website, landing page, technical foundation, integration or automation tied to an actual operating workflow.</p><a href="/gb/london/it-web-development/">London IT & web development</a></article>
      <article><h2>US logistics training</h2><p>For UK residents who want to understand US logistics roles, operating flow, communication and readiness-gated practice without employment or income guarantees.</p><a href="/gb/london/us-logistics-training/">London logistics training</a></article>
    </div></div></section>

    <section class="section decision-section" aria-labelledby="decision-title"><div class="shell">
      <p class="eyebrow">How to use this hub</p><h2 id="decision-title">Choose one owner, then use supporting pages to make the decision clearer.</h2>
      <div class="decision-grid">{decisionSteps.map(([heading,body])=><article><h3>{heading}</h3><p>{body}</p></article>)}</div>
    </div></section>

    <section class="section link-directory"><div class="shell"><p class="eyebrow">London services</p><h2>Choose the first growth problem to solve.</h2><div class="service-grid">{services.map(([slug,label,body])=><a href={`/gb/london/${slug}/`}><strong>{label}</strong><span>{body}</span></a>)}</div></div></section>
    <section class="section link-directory"><div class="shell"><p class="eyebrow">Industry paths</p><h2>Start from the operating reality of the business.</h2><div class="service-grid">{industries.map(([slug,label,body])=><a href={`/gb/london/${slug}/`}><strong>{label}</strong><span>{body}</span></a>)}</div></div></section>
    <section class="section link-directory"><div class="shell"><p class="eyebrow">Guides</p><h2>Learn before choosing a project or training track.</h2><div class="link-grid">{guides.map(([slug,label])=><a href={`/gb/london/guides/${slug}/`}>{label}</a>)}</div></div></section>
  </main>
  <LondonAnalytics />
  <SiteFooter />
</BaseLayout>
<style>
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.cards article,.decision-grid article{padding:1.4rem;border:1px solid #dce3f3;border-radius:12px}.cards p,.decision-grid p{color:#64718f;line-height:1.65}.language-links{margin-top:1rem}.decision-section,.link-directory{border-top:1px solid #e6eaf3}.decision-section h2,.link-directory h2{max-width:24ch}.decision-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.service-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.service-grid a{display:flex;flex-direction:column;gap:.35rem;padding:1rem 1.05rem;border:1px solid #dce3f3;border-radius:12px;text-decoration:none}.service-grid span{color:#64718f;line-height:1.5;font-size:.92rem}.link-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.75rem}.link-grid a{display:flex;align-items:center;min-height:3.5rem;padding:.8rem 1rem;border:1px solid #dce3f3;border-radius:10px;text-decoration:none;font-weight:700}@media(max-width:1000px){.link-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:800px){.cards,.decision-grid,.service-grid,.link-grid{grid-template-columns:1fr}}
</style>
