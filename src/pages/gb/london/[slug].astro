---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import LondonAnalytics from "../../../components/LondonAnalytics.astro";
import { londonCommercialPages } from "../../../data/london-commercial-pages";

const organizationId = "https://hermeslogisticsus.com/#organization";
const serviceBySlug: Record<string,string> = {
  "social-media-management":"smm","meta-ads":"meta-ads","website-development":"website-development","seo-services":"seo","local-seo":"seo","google-business-profile":"seo","landing-page-development":"website-development","crm-automation":"crm","content-reels-scripts":"content","marketing-audit":"marketing",
  "auto-repair-marketing":"marketing","beauty-salon-marketing":"marketing","dental-clinic-marketing":"marketing","restaurant-marketing":"marketing","contractor-marketing":"marketing","logistics-company-marketing":"marketing","car-detailing-marketing":"marketing","cleaning-company-marketing":"marketing","home-services-marketing":"marketing","professional-services-marketing":"marketing"
};
export function getStaticPaths(){return londonCommercialPages.map(page=>({params:{slug:page.slug},props:{page}}));}
const {page}=Astro.props;
const service=serviceBySlug[page.slug] ?? "marketing";
const url=`https://hermeslogisticsus.com/gb/london/${page.slug}/`;
const leadHref=`/business-growth/?utm_source=london&utm_medium=organic&utm_campaign=london-services&utm_content=${page.slug}&service=${service}`;
const isSeoPage=page.slug==="seo-services";
const effectiveTitle=isSeoPage ? "SEO Services London | Local SEO & AI Search Visibility | Hermes" : page.title;
const effectiveDescription=isSeoPage
  ? "SEO services for London businesses covering technical SEO, local search, content architecture, Search Console and GEO/AI visibility across generative search experiences."
  : page.description;
const faq=[
 page.faq,
 ...(isSeoPage ? [{question:"Does GEO replace SEO for London businesses?",answer:"No. Generative-engine visibility depends on many of the same public foundations: clear entities, useful pages, factual service and location context, crawlable content, reputable sources and measurable user journeys. Hermes treats GEO/AI visibility as an additional observation layer rather than a replacement for SEO."}] : []),
 {question:"What does the first London growth audit cover?",answer:"It reviews the current offer, website or landing path, search visibility, social and paid acquisition signals, tracking and follow-up, then identifies the smallest useful first test."},
 {question:"Do you guarantee rankings, leads or revenue?",answer:"No. Hermes can control agreed research, implementation, testing, tracking and optimisation, but search rankings, platform auctions, buyer behaviour, sales execution and revenue cannot be guaranteed."}
];
const schema=[
 {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"London",item:"https://hermeslogisticsus.com/gb/london/"},{"@type":"ListItem",position:2,name:page.h1,item:url}]},
 {"@context":"https://schema.org","@type":"Service",name:page.h1,description:effectiveDescription,provider:{"@id":organizationId},areaServed:{"@type":"City",name:"London"},url},
 {"@context":"https://schema.org","@type":"FAQPage",mainEntity:faq.map(item=>({"@type":"Question",name:item.question,acceptedAnswer:{"@type":"Answer",text:item.answer}}))}
];
---
<BaseLayout title={effectiveTitle} description={effectiveDescription} schema={schema}>
  <SiteHeader theme="dark" />
  <main id="main-content">
    <section class="section detail-overview"><div class="shell detail-intro">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.h1}</h1>
      <p>{effectiveDescription}</p>
      <p><a class="button button-primary" href={leadHref}>Request a London growth audit</a> <a class="button" href="/gb/london/">London hub</a></p>
    </div></section>

    <section class="section fit-section" aria-labelledby="fit-title"><div class="shell fit-card">
      <p class="eyebrow">Where this work fits</p>
      <h2 id="fit-title">Start with the business constraint, not a fixed channel bundle.</h2>
      <p>{page.fit}</p>
    </div></section>

    {isSeoPage && (
      <section class="section geo-section" aria-labelledby="geo-title"><div class="shell">
        <p class="eyebrow">GEO / AI search visibility</p>
        <h2 id="geo-title">Make London services understandable to both search engines and AI systems.</h2>
        <p class="geo-intro">Hermes keeps one canonical London SEO owner while strengthening the public facts that search and generative systems can interpret. The goal is not keyword duplication: it is clearer entity, service, location and evidence context, followed by repeatable provider observations.</p>
        <div class="grid geo-grid">
          <article><h3>Entity and service clarity</h3><p>Keep business identity, service scope, London relevance, canonical URLs and visible structured facts consistent across the website and eligible public profiles.</p></article>
          <article><h3>Answer-ready content</h3><p>Use concise service explanations, useful FAQ, evidence boundaries, internal links and source-worthy resources that can answer real buyer questions without unsupported claims.</p></article>
          <article><h3>AI visibility observations</h3><p>Track bounded prompt sets across ChatGPT, Gemini, Copilot, Perplexity and Google AI where observable, separating mention, citation, correct owner and qualified downstream action.</p></article>
        </div>
        <p class="geo-boundary"><strong>Boundary:</strong> no provider mention, citation, ranking, lead or revenue is guaranteed. London GEO results are recorded only when independently observed.</p>
      </div></section>
    )}

    <section class="section" aria-labelledby="scope-title"><div class="shell">
      <div class="section-heading"><p class="eyebrow">Working scope</p><h2 id="scope-title">Three parts of the operating model.</h2></div>
      <div class="grid">{page.points.map(point=><article><h3>{point.title}</h3><p>{point.body}</p></article>)}</div>
    </div></section>

    <section class="section measurement-section" aria-labelledby="measurement-title"><div class="shell measurement-card">
      <p class="eyebrow">Measurement</p>
      <h2 id="measurement-title">Judge the channel by the next meaningful business action.</h2>
      <p>{page.measurement}</p>
    </div></section>

    <section class="section"><div class="shell faq"><h2>Questions before starting</h2>{faq.map(item=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></section>
    <section class="section"><div class="shell boundary"><p><strong>Commercial boundary:</strong> platform spend, third-party fees and production costs are separate unless explicitly included. Search rankings, leads, sales and revenue are not guaranteed.</p></div></section>
  </main>
  <LondonAnalytics />
  <SiteFooter />
</BaseLayout>
<style>
  .fit-card,.measurement-card,.boundary{max-width:900px}
  .fit-card,.measurement-card{padding:1.5rem;border:1px solid #dce3f3;border-radius:16px;background:#fbfcff}
  .fit-card h2,.measurement-card h2{margin:.35rem 0 .75rem}
  .fit-card p:last-child,.measurement-card p:last-child{color:#55627d;line-height:1.75}
  .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .grid article{padding:1.35rem;border:1px solid #dce3f3;border-radius:12px}
  .grid h3{margin:.1rem 0 .65rem}
  .grid p,.faq p{color:#64718f;line-height:1.65}
  .faq{max-width:850px}.faq details{padding:1rem 0;border-bottom:1px solid #dce3f3}.faq summary{font-weight:800;cursor:pointer}
  .geo-section{background:#eef2ff}.geo-section h2{max-width:24ch}.geo-intro{max-width:76ch;color:#56637f;line-height:1.7}.geo-grid{margin-top:1.2rem}.geo-boundary{max-width:76ch;margin-top:1.2rem;color:#56637f;line-height:1.6}
  @media(max-width:800px){.grid{grid-template-columns:1fr}}
</style>
