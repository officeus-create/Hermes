---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

const pages = [
  { slug:"social-media-management", title:"Social Media Management London | Hermes", eyebrow:"London social media", h1:"Social media management built around leads, not posting volume.", description:"Social media management in London for small and growing businesses across Instagram, Facebook and Threads, with content systems, scripts, tracking and conversion paths.", points:["Instagram, Facebook and Threads planning","Hooks, scripts, captions and publishing workflows","Lead tracking from content into website and CRM"] },
  { slug:"meta-ads", title:"Meta Ads Management London | Hermes", eyebrow:"London Meta Ads", h1:"Run Meta Ads as a measured acquisition channel.", description:"Meta Ads setup and management for London businesses, including campaign structure, tracking, testing, retargeting and landing-page alignment.", points:["Campaign and audience testing","Pixel, event and lead-source tracking","Retargeting and landing-page alignment"] },
  { slug:"website-development", title:"Website Development London | Hermes", eyebrow:"London websites", h1:"Build a business website that can sell, rank and expand.", description:"Website development for London small businesses with responsive design, conversion structure, technical SEO, analytics and lead capture.", points:["Responsive business websites","Service and location landing pages","Analytics, forms and conversion paths"] },
  { slug:"seo-services", title:"SEO Services London | Hermes", eyebrow:"London SEO", h1:"Build search visibility around services people actually buy.", description:"SEO services for London businesses covering technical SEO, on-page optimisation, internal linking, content architecture and measurable search growth.", points:["Technical and on-page SEO","Service-led content architecture","Search performance and conversion measurement"] },
  { slug:"local-seo", title:"Local SEO London | Hermes", eyebrow:"London local SEO", h1:"Compete for local demand without manufacturing fake location signals.", description:"Local SEO for London businesses using legitimate location relevance, service pages, Google Business support, citations, reviews and technical foundations.", points:["Local service and area architecture","Google Business and citation consistency","Review and local authority signals"] },
  { slug:"google-business-profile", title:"Google Business Profile Support London | Hermes", eyebrow:"London Google visibility", h1:"Make Google Business Profile part of the customer journey.", description:"Google Business Profile support for London companies: profile structure, services, tracking, review workflows and website alignment.", points:["Profile and service structure","Review-response workflow","Website, UTM and lead-source alignment"] },
  { slug:"landing-page-development", title:"Landing Page Development London | Hermes", eyebrow:"London landing pages", h1:"Give each campaign one focused conversion destination.", description:"Landing page development for London businesses with clear offers, mobile performance, tracking, forms and paid-organic campaign alignment.", points:["Offer and CTA structure","Fast mobile implementation","Forms, analytics and campaign tracking"] },
  { slug:"crm-automation", title:"CRM & Business Automation London | Hermes", eyebrow:"London automation", h1:"Automate the repetitive steps after a lead appears.", description:"CRM integration and practical business automation for London companies: lead routing, follow-up, booking, reporting and approved AI workflows.", points:["Lead capture and CRM routing","Follow-up and booking workflows","Reporting and practical AI automation"] },
  { slug:"content-reels-scripts", title:"Reels & Social Content Scripts London | Hermes", eyebrow:"London content systems", h1:"Turn expertise into repeatable short-form content.", description:"Reels, hooks and social content scripting for London businesses across Instagram, Facebook and Threads, connected to offers and measurable next actions.", points:["Hooks and short-form scripts","Content pillars and publishing rhythm","CTA and offer alignment"] },
  { slug:"marketing-audit", title:"Digital Marketing Audit London | Hermes", eyebrow:"London marketing audit", h1:"Find the first bottleneck before buying another channel.", description:"Digital marketing audit for London businesses across website, SEO, social media, Meta Ads, tracking, CRM and lead follow-up.", points:["Website and conversion review","Search, social and paid-channel review","Prioritised 30/60/90-day action plan"] },
  { slug:"auto-repair-marketing", title:"Auto Repair Marketing London | Hermes", eyebrow:"London auto repair", h1:"Marketing for garages and auto repair businesses that need booked work.", description:"Digital marketing for London garages and auto repair businesses across websites, local SEO, Google visibility, social content and paid acquisition.", points:["Service-specific website pages","Local SEO and Google visibility","Social proof, offers and lead tracking"] },
  { slug:"beauty-salon-marketing", title:"Beauty Salon Marketing London | Hermes", eyebrow:"London beauty", h1:"Turn visual attention into booked appointments.", description:"Marketing for London beauty salons across Instagram, Reels, Meta Ads, websites, booking flows, local SEO and customer retention.", points:["Reels and portfolio content","Booking-focused landing paths","Local search and retargeting"] },
  { slug:"dental-clinic-marketing", title:"Dental Clinic Marketing London | Hermes", eyebrow:"London dental", h1:"Build measurable patient acquisition without overclaiming outcomes.", description:"Digital marketing support for London dental clinics across websites, local SEO, content, paid acquisition and lead tracking, subject to healthcare advertising rules.", points:["Service and treatment information architecture","Local search foundations","Compliant campaign and enquiry tracking"] },
  { slug:"restaurant-marketing", title:"Restaurant Marketing London | Hermes", eyebrow:"London restaurants", h1:"Connect discovery, social proof and reservations.", description:"Restaurant marketing in London across social media, local search, websites, menu and reservation journeys, content and paid campaigns.", points:["Local discovery and Google visibility","Food and venue content systems","Reservation and campaign tracking"] },
  { slug:"contractor-marketing", title:"Contractor Marketing London | Hermes", eyebrow:"London contractors", h1:"Generate qualified enquiries around the jobs you actually want.", description:"Digital marketing for London contractors across websites, service-area SEO, Google visibility, Meta Ads, proof of work and enquiry tracking.", points:["Service and area landing pages","Project proof and trust signals","Lead qualification and tracking"] },
  { slug:"logistics-company-marketing", title:"Logistics Company Marketing London | Hermes", eyebrow:"London logistics marketing", h1:"Explain operational value clearly enough for buyers to act.", description:"B2B marketing for London logistics companies across websites, SEO, social content, lead generation, CRM and sales-support systems.", points:["B2B service positioning","Search and content architecture","Lead capture, CRM and sales support"] },
  { slug:"car-detailing-marketing", title:"Car Detailing Marketing London | Hermes", eyebrow:"London car detailing", h1:"Use visual proof to create local booking demand.", description:"Marketing for London car detailing businesses across Reels, before-and-after content, local SEO, websites, booking paths and Meta Ads.", points:["Before-and-after content systems","Local SEO and service pages","Booking funnels and retargeting"] },
  { slug:"cleaning-company-marketing", title:"Cleaning Company Marketing London | Hermes", eyebrow:"London cleaning", h1:"Build predictable local enquiries around clear service packages.", description:"Digital marketing for London cleaning companies using websites, local SEO, Google visibility, social proof, paid campaigns and lead routing.", points:["Residential and commercial service pages","Local search and review signals","Quote forms and lead routing"] },
  { slug:"home-services-marketing", title:"Home Services Marketing London | Hermes", eyebrow:"London home services", h1:"Make local service demand easier to find and easier to convert.", description:"Marketing for London home-service companies across local SEO, websites, Google visibility, social content, paid acquisition and CRM workflows.", points:["Service-area search architecture","Trust, reviews and proof of work","Quote and follow-up workflows"] },
  { slug:"professional-services-marketing", title:"Professional Services Marketing London | Hermes", eyebrow:"London professional services", h1:"Turn expertise into credible, measurable demand generation.", description:"Digital marketing for London professional-service firms across websites, SEO, thought-leadership content, paid acquisition and lead qualification.", points:["Authority-led website structure","Search and expert content","Lead qualification and CRM tracking"] },
];

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---
<BaseLayout title={page.title} description={page.description}>
  <SiteHeader theme="dark" />
  <main id="main-content">
    <section class="section detail-overview"><div class="shell detail-intro">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.h1}</h1>
      <p>{page.description}</p>
      <p><a class="button button-primary" href="/business-growth/?source=london">Request a London growth audit</a> <a class="button" href="/gb/london/">London hub</a></p>
    </div></section>
    <section class="section"><div class="shell grid">
      {page.points.map((point) => <article><h2>{point}</h2><p>Scope is selected from the business need, existing assets, budget and measurable next step rather than a fixed bundle.</p></article>)}
    </div></section>
    <section class="section"><div class="shell"><p><strong>Commercial boundary:</strong> platform spend, third-party fees and production costs are separate unless explicitly included. Search rankings, leads, sales and revenue are not guaranteed.</p></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.grid article{padding:1.35rem;border:1px solid #dce3f3;border-radius:12px}.grid p{color:#64718f;line-height:1.65}@media(max-width:800px){.grid{grid-template-columns:1fr}}</style>
