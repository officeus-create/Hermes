---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import EcosystemRail from "../components/EcosystemRail.astro";
import HeroEditorial from "../components/HeroEditorial.astro";
import JourneySteps from "../components/JourneySteps.astro";
import PathCard from "../components/PathCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TrustBand from "../components/TrustBand.astro";
import { site } from "../data/site";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Hermes",
  url: "https://hermeslogisticsus.com/",
  logo: "https://hermeslogisticsus.com/favicon.svg",
  areaServed: [
    { "@type": "State", name: "Wisconsin" },
    { "@type": "Country", name: "United States" },
  ],
  sameAs: [
    "https://www.instagram.com/hermes.logistics/",
    "https://www.threads.com/@hermes.logistics",
    "https://www.instagram.com/progressopro/",
  ],
};
---

<BaseLayout
  title="Hermes Wisconsin | Logistics, Marketing, Academy & IT"
  description="Wisconsin-first logistics, marketing, practical business education, CRM, AI automation, and web development services available across the United States."
  schema={organizationSchema}
>
  <SiteHeader />
  <main id="main-content">
    <HeroEditorial />
    <EcosystemRail />

    <section class="section paths-section" id="paths">
      <div class="shell">
        <div class="section-heading paths-heading">
          <p class="eyebrow">Four paths. One ecosystem.</p>
          <h2>Choose the business direction that fits your goal.</h2>
          <p>Start with what you need today. Each direction has its own team, focus, and working rhythm.</p>
        </div>
        <div class="paths-grid">
          {site.paths.map((path) => <PathCard path={path} />)}
        </div>
      </div>
    </section>

    <JourneySteps />
    <TrustBand />
    <ContactCTA />
  </main>
  <SiteFooter />
</BaseLayout>
