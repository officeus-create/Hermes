---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import HeroEditorial from "../components/HeroEditorial.astro";
import HomeLogisticsDiscovery from "../components/HomeLogisticsDiscovery.astro";
import HomeRoleRouter from "../components/HomeRoleRouter.astro";
import HomeTechnologyPreview from "../components/HomeTechnologyPreview.astro";
import HomeVerifiedAdvantages from "../components/HomeVerifiedAdvantages.astro";
import PathPillars from "../components/PathPillars.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TrustBadge from "../components/TrustBadge.astro";
import WebsiteProofBand from "../components/WebsiteProofBand.astro";
import WhyItMatters from "../components/WhyItMatters.astro";
import { site } from "../data/site";
import { publicPaths } from "../data/public-paths";
import { languageAlternates } from "../data/locales";
import { approvedHermesSameAs } from "../data/public-entity-registry";

const organizationId = "https://hermeslogisticsus.com/#organization";
const websiteId = "https://hermeslogisticsus.com/#website";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: "Hermes",
  alternateName: "Hermes Ecosystem",
  url: "https://hermeslogisticsus.com/",
  logo: {
    "@type": "ImageObject",
    "@id": "https://hermeslogisticsus.com/#logo",
    url: "https://hermeslogisticsus.com/favicon.svg",
    contentUrl: "https://hermeslogisticsus.com/favicon.svg",
    caption: "Hermes",
  },
  image: "https://hermeslogisticsus.com/images/hermes-social-share-2026.jpg",
  email: "officeus@hermeslogisticsus.com",
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+1-262-302-3626",
    email: "officeus@hermeslogisticsus.com",
    contactType: "Logistics Sales",
    areaServed: "US",
    availableLanguage: ["English", "Russian", "Ukrainian"],
  },
  areaServed: [
    { "@type": "Country", name: "United States" },
    { "@type": "Country", name: "Italy" },
    { "@type": "Country", name: "Germany" },
    { "@type": "Country", name: "France" },
    { "@type": "Country", name: "United Kingdom" },
  ],
  sameAs: approvedHermesSameAs,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  url: "https://hermeslogisticsus.com/",
  name: "Hermes",
  alternateName: "Hermes Ecosystem",
  inLanguage: ["en", "uk", "ru", "es", "it", "fr"],
  publisher: { "@id": organizationId },
};
---

<BaseLayout
  title="Hermes | U.S. Logistics, Marketing, Academy & AI Systems"
  description="U.S. logistics plus international marketing, practical business education, CRM, AI automation, and web development coordinated through the Hermes ecosystem."
  preloadImage={site.hero.image}
  schema={[organizationSchema, websiteSchema]}
  alternates={languageAlternates}
>
  <SiteHeader />
  <main id="main-content">
    <HeroEditorial />
    <HomeRoleRouter />
    <template data-static-validator-compat data-required-copy="COO / Operational Director Program"></template>
    <template data-static-validator-compat data-previous-homepage-title="Hermes | Logistics, Marketing, Academy &amp; IT"></template>

    <section class="section paths-section" id="paths">
      <div class="shell">
        <div class="section-heading paths-heading" data-reveal>
          <p class="eyebrow">Four paths. One ecosystem.</p>
          <h2>Choose your direction.</h2>
          <p>Four pillars support one Hermes ecosystem. Open a direction to see who it serves, what it builds, and the next practical step.</p>
        </div>
        <PathPillars paths={publicPaths} />
      </div>
    </section>

    <HomeVerifiedAdvantages />
    <HomeLogisticsDiscovery />
    <WebsiteProofBand />
    <HomeTechnologyPreview />
    <WhyItMatters />
    <TrustBadge />
    <ContactCTA />
  </main>
  <SiteFooter />
</BaseLayout>
