---
// Approved Claude Design "Hermes Directions" Products page: the product family on the
// same direction skeleton, with every product carrying its real status.
import BaseLayout from "../../layouts/BaseLayout.astro";
import DirectionHero from "../../components/DirectionHero.astro";
import DirectionStory from "../../components/DirectionStory.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { directionStories } from "../../data/direction-story";
import { hermesPublicProjects, HERMES_PORTFOLIO_OBSERVED_AT } from "../../data/hermes-projects-public.mjs";
import "../../styles/hermes-public-path-shell.css";
import "../../styles/hermes-public-division-colors.css";

const canonicalUrl = "https://hermeslogisticsus.com/products/";
const title = "Hermes Products: Connect, Load Board and Catalog";
const description =
  "Products Hermes builds, runs and uses itself — Hermes Connect CRM (Repair Shops live pilot), the Hermes Load Board and the Hermes Catalog — each shown with its real status.";

const hero = {
  accent: "#0a164f",
  tone: "#0a164f",
  kicker: "Hermes Products · built and run by us",
  title: "Products we build, run and use ourselves.",
  summary: "Every Hermes direction runs on software we made. Each product carries its real status — live, pilot, private or preview.",
  primary: { label: "Explore Hermes Connect", href: "/services/hermes-connect/" },
  secondary: { label: "Sign in", href: "/services/hermes-connect/access/" },
  reassurance: "Repair Shops is the current live pilot; other modules are shown as reference until verified.",
  windowLabel: "Live window · product team",
  windowLine: "Software we use every day.",
  video: "/media/home/technology-film-v2-540.mp4",
  poster: "/media/home/technology-film-v2-poster.jpg",
};

const faq = directionStories.products.faq;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: canonicalUrl,
    hasPart: [
      { "@type": "SoftwareApplication", name: "Hermes Connect", url: "https://hermeslogisticsus.com/services/hermes-connect/", applicationCategory: "BusinessApplication" },
      { "@type": "WebApplication", name: "Hermes Load Board", url: "https://hermeslogisticsus.com/load-board/" },
      { "@type": "WebPage", name: "Hermes Catalog", url: "https://hermeslogisticsus.com/businesses/" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Products", item: canonicalUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })),
  },
];
---

<BaseLayout title={title} description={description} image="/images/direction-technology-real-2026.jpg" schema={schema}>
  <SiteHeader contactHref="/contacts/" theme="light" />
  <main id="main-content" class="detail-page detail-page-products">
    <DirectionHero hero={hero} alt="Illustrative footage of a product team working together at a screen" />
    <DirectionStory direction="products" part="top" />

    <section class="project-register" id="projects" aria-labelledby="hermes-projects-heading">
      <div class="project-register__intro">
        <p class="eyebrow">Hermes · project portfolio</p>
        <h2 id="hermes-projects-heading">Projects across the Hermes ecosystem</h2>
        <p>Operating services, pilots, development projects and future concepts appear together with clearly separated stages. This reviewed inventory does not imply that every project has launched, secured funding or generated revenue.</p>
        <p class="project-register__asof">Source snapshot: {HERMES_PORTFOLIO_OBSERVED_AT} · Coverage remains partial pending One Brain reconciliation.</p>
      </div>
      <div class="project-register__grid">
        {hermesPublicProjects.map((project) => (
          <article class="project-register__card" data-project-id={project.id}>
            <p class="project-register__meta"><span>{project.direction}</span><span class="project-register__stage">{project.stage}</span></p>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <a href={project.href}>See project context</a>
          </article>
        ))}
      </div>
      <p class="project-register__footer">Interested in an operational pilot or partnership? <a href="/contacts/">Contact Hermes</a>. This overview is not an offer to invest or a statement of securities terms.</p>
    </section>
    <DirectionStory direction="products" part="faq" />
  </main>
  <DirectionStory direction="products" part="final" />
  <SiteFooter />
</BaseLayout>

<style>
.project-register{max-width:1180px;margin:0 auto;padding:clamp(36px,6vw,88px) 24px;color:#16213e}
.project-register__intro{max-width:820px;margin-bottom:28px}
.project-register__intro h2{font-size:clamp(1.8rem,3.1vw,2.8rem);line-height:1.15;margin:12px 0 16px}
.project-register__intro>p{line-height:1.65}
.project-register__asof{font-size:.87rem;opacity:.8}
.project-register__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:16px}
.project-register__card{border:1px solid #dfe5f1;background:#fff;border-radius:16px;padding:22px;display:flex;flex-direction:column;min-height:220px}
.project-register__meta{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;font-size:.79rem;text-transform:uppercase;letter-spacing:.04em;opacity:.76}
.project-register__stage{font-weight:700}
.project-register__card h3{font-size:1.14rem;margin:12px 0}
.project-register__card>p:not(.project-register__meta){line-height:1.55;font-size:.95rem;flex:1}
.project-register__card>a,.project-register__footer a{color:#0f5db5;text-underline-offset:3px;font-weight:700}
.project-register__footer{margin-top:24px;line-height:1.6}
</style>
