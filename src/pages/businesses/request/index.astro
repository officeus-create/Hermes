---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DirectionProductNav from "../../../components/DirectionProductNav.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
const description="Send one structured Hermes Catalog request. Business identity, request type and source context stay attached to the handoff; human verification remains required before claim activation.";
---
<BaseLayout title="Hermes Catalog request | Hermes Catalog" description={description} robots="noindex,follow">
 <SiteHeader theme="light" activePath="/businesses/"/><DirectionProductNav direction="catalog" theme="light"/>
 <main class="request-page"><div class="shell"><a class="back" href="/businesses/">← Hermes Catalog</a><header><p class="eyebrow">Hermes Catalog · structured handoff</p><h1 data-request-title>Hermes Catalog request</h1><p>{description}</p></header>
  <section class="context"><strong>Request context</strong><dl><div><dt>Type</dt><dd data-context-type>Catalog growth</dd></div><div data-context-roadmap hidden><dt>Roadmap</dt><dd data-context-months></dd></div><div data-context-business hidden><dt>Business</dt><dd data-context-business-value></dd></div><div data-context-profile hidden><dt>Catalog profile</dt><dd><a data-context-profile-link></a></dd></div><div data-context-evidence hidden><dt>Evidence reference</dt><dd data-context-evidence-value></dd></div></dl></section>
  <section class="program"><p class="eyebrow">Free launch path · current Repair Shop pilot</p><h2>CRM first. Catalog second. Search visibility compounds over time.</h2><div class="program-grid"><article><strong>1 · Hermes Connect</strong><p>Use the live Repair Shop CRM to keep company details, services, bookings and customers in one owner-controlled workspace. Free registration is currently available through September 15, 2026 (America/Chicago).</p></article><article><strong>2 · Hermes Catalog</strong><p>Approve Catalog publication in Company settings. The same company identity flows into the public Catalog instead of creating a second disconnected profile.</p></article><article><strong>3 · SEO / GEO</strong><p>Publication creates the initial search-ready profile, structured business facts and a crawlable location/service surface. Reporting cadence is monthly. Evaluate organic/local/AI-search progress over a longer horizon, commonly 6+ months; rankings, traffic and leads are not guaranteed.</p></article><article><strong>4 · Optional growth</strong><p>If you want more, request a website, redesign, SEO/GEO for your own site, social media management, paid ads, or done-for-you video/content production.</p></article></div></section>
  <form data-catalog-request data-request-type="catalog-growth" data-business-slug="" data-profile="" data-months="">
   <div class="two"><label>Your name<input name="name" required minlength="2" maxlength="100" autocomplete="name"/></label><label>Email<input name="email" type="email" required maxlength="160" autocomplete="email"/></label></div>
   <div class="two"><label>Business / project<input name="company" required minlength="2" maxlength="140"/></label><label>City / country<input name="city_country" required minlength="2" maxlength="120"/></label></div>
   <div class="two"><label>WhatsApp<input name="whatsapp" maxlength="120" autocomplete="tel"/></label><label>Telegram<input name="telegram" maxlength="120" placeholder="@username"/></label></div>
   <label>Website / social / Catalog profile<input name="website_or_social" required minlength="2" maxlength="240" value="not launched yet"/></label>
   <label>Primary services / offers<textarea name="primary_services" required minlength="3" maxlength="1200" rows="3" placeholder="What do customers hire you for?"></textarea></label>
   <label>Target locations / service area<textarea name="target_locations" required minlength="2" maxlength="800" rows="2" placeholder="Cities, states, radius, or markets you want to grow in"></textarea></label>
   <fieldset><legend>What would you like Hermes to evaluate?</legend><div class="checks"><label><input type="checkbox" name="services" value="CRM & business automation"/>Hermes Connect CRM</label><label><input type="checkbox" name="services" value="Catalog business listing"/>Free Catalog listing</label><label><input type="checkbox" name="services" value="Catalog SEO / GEO"/>Catalog SEO / GEO</label><label><input type="checkbox" name="services" value="Website development"/>Website creation / redesign</label><label><input type="checkbox" name="services" value="SEO"/>SEO / GEO for my website</label><label><input type="checkbox" name="services" value="Social media marketing & organic growth"/>Organic social media</label><label><input type="checkbox" name="services" value="Meta Ads (Facebook / Instagram)"/>Meta targeted ads</label><label><input type="checkbox" name="services" value="Google Ads"/>Google Ads</label><label><input type="checkbox" name="services" value="Video & content production"/>Done-for-you video / creator / actor content</label></div></fieldset>
   <div class="two"><label>Monthly growth budget<select name="planning_budget" required><option value="Not sure yet">Not sure yet</option><option value="Under $1,000">Under $1,000</option><option value="$1,000–$3,000">$1,000–$3,000</option><option value="$3,000–$10,000">$3,000–$10,000</option><option value="$10,000–$25,000">$10,000–$25,000</option><option value="$25,000+">$25,000+</option></select></label><label>Planning horizon<select name="planning_horizon" required><option value="Not sure yet">Not sure yet</option><option value="3 months">3 months</option><option value="6 months">6 months</option><option value="9 months">9 months</option><option value="12 months">12 months</option></select></label></div>
   <div class="two"><label>Preferred language<select name="preferred_language" required><option>English</option><option>Russian</option><option>Ukrainian</option></select></label><label>Best time to contact<input name="preferred_contact_time" required minlength="2" maxlength="120" placeholder="10:00–13:00, your time zone"/></label></div>
   <label>What should Hermes review?<textarea name="message" required minlength="10" maxlength="2000" rows="5">I want Hermes to review this Catalog request and preserve the business context shown above.</textarea></label>
   <label class="consent"><input type="checkbox" name="consent" required/> I agree that Hermes may use these details to respond to this request. <a href="/privacy/">Privacy notice</a>.</label>
   <button type="submit">Send request</button><p class="status" data-request-status role="status"></p>
  </form>
  <section class="success" data-request-success hidden><h2>Request received.</h2><p data-success-copy>Your request keeps its Catalog context.</p><a data-connect-handoff href="/services/hermes-connect/?source=catalog_request">Open Hermes Connect CRM →</a></section>
 </div></main><SiteFooter/>
</BaseLayout>
<script>
 import { trackEvent } from "../../../lib/analytics";
 const form=document.querySelector<HTMLFormElement>("[data-catalog-request]");
 const status=document.querySelector<HTMLElement>("[data-request-status]");
 const success=document.querySelector<HTMLElement>("[data-request-success]");
 const params=new URLSearchParams(location.search);
 const allowedTypes=new Set(["claim","marketing-package","add","catalog-growth"]);
 const rawType=params.get("type")||"catalog-growth";
 const type=allowedTypes.has(rawType)?rawType:"catalog-growth";
 const rawMonths=params.get("months")||"";
 const months=new Set(["3","6","9","12"]).has(rawMonths)?rawMonths:"";
 const clip=(name:string,max:number)=>String(params.get(name)||"").trim().slice(0,max);
 const business=clip("business",140), profile=clip("profile",240), city=clip("city",80), state=clip("state",40), country=clip("country",40), identity=clip("identity",180), evidence=clip("evidence",180);
 const isClaim=type==="claim", isPackage=type==="marketing-package", isAdd=type==="add";
 const title=isClaim?"Claim a Hermes Catalog profile":isPackage?`Request a ${months||"custom"}-month marketing roadmap`:isAdd?"Add your business to Hermes Catalog":"Request Catalog SEO / GEO growth";
 const titleNode=document.querySelector<HTMLElement>("[data-request-title]");if(titleNode)titleNode.textContent=title;
 if(form){form.dataset.requestType=type;form.dataset.businessSlug=identity||business;form.dataset.profile=profile;form.dataset.months=months;}
 const setText=(selector:string,value:string)=>{const node=document.querySelector<HTMLElement>(selector);if(node)node.textContent=value;};
 setText("[data-context-type]",isClaim?"Claim / verification":isPackage?"Marketing roadmap":isAdd?"Add business":"Catalog SEO / GEO");
 const toggle=(selector:string,show:boolean)=>{const node=document.querySelector<HTMLElement>(selector);if(node)node.hidden=!show;};
 toggle("[data-context-roadmap]",Boolean(months));if(months)setText("[data-context-months]",`${months} months`);
 toggle("[data-context-business]",Boolean(business));if(business)setText("[data-context-business-value]",business);
 toggle("[data-context-profile]",Boolean(profile));const profileLink=document.querySelector<HTMLAnchorElement>("[data-context-profile-link]");if(profileLink&&profile){profileLink.href=profile;profileLink.textContent=profile;}
 toggle("[data-context-evidence]",Boolean(evidence));if(evidence)setText("[data-context-evidence-value]",evidence);
 const company=form?.elements.namedItem("company");if(company instanceof HTMLInputElement&&business)company.value=business;
 const cityField=form?.elements.namedItem("city_country");if(cityField instanceof HTMLInputElement)cityField.value=[city,state,country].filter(Boolean).join(", ");
 const web=form?.elements.namedItem("website_or_social");if(web instanceof HTMLInputElement&&profile)web.value=profile;
 const message=form?.elements.namedItem("message");if(message instanceof HTMLTextAreaElement){message.value=isClaim?`I am authorized to request verification of the Hermes Catalog profile for ${business||"this business"}. Catalog identity: ${identity||"not supplied"}. Evidence reference: ${evidence||"not supplied"}. Please verify ownership/authority before changing public facts or activating Hermes Connect.`:isPackage?`I would like a ${months||"custom"}-month marketing roadmap. Please confirm the current scope, deliverables and fee after reviewing my business.`:isAdd?"I would like to add my business to Hermes Catalog. Please review the public facts with me before publication.":"I want to improve my Hermes Catalog profile and local/AI-search visibility. Please review the current business facts, location intent and a scoped SEO/GEO roadmap.";}
 const connect=document.querySelector<HTMLAnchorElement>("[data-connect-handoff]");if(connect){const u=new URL("/services/hermes-connect/",location.origin);u.searchParams.set("source","catalog_request");u.searchParams.set("request_type",type);if(business)u.searchParams.set("business",business);if(identity)u.searchParams.set("catalog_identity",identity);if(profile)u.searchParams.set("catalog_profile",profile);if(months)u.searchParams.set("months",months);connect.href=u.pathname+u.search;}
 const successCopy=document.querySelector<HTMLElement>("[data-success-copy]");if(successCopy)successCopy.textContent=isClaim?"Hermes will verify authority before changing the public profile. You can open Hermes Connect now; registration does not by itself verify this Catalog claim.":"Your request keeps its Catalog context. You can also open Hermes Connect to create or review the operating company profile.";
 form?.addEventListener("submit",async(e)=>{e.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const whatsapp=String(data.get("whatsapp")||"").trim(),telegram=String(data.get("telegram")||"").trim();if(!whatsapp&&!telegram){if(status)status.textContent="Please provide WhatsApp or Telegram so Hermes can verify the request.";return;}const requestType=form.dataset.requestType||"catalog-growth",roadmap=form.dataset.months||"",packageRequest=requestType==="marketing-package";const payload={request_id:crypto.randomUUID(),submitted_at:new Date().toISOString(),source_path:location.pathname+location.search,interest:packageRequest?"ProgressoPro":"Hermes Catalog",name:String(data.get("name")||""),email:String(data.get("email")||""),company:String(data.get("company")||""),city_country:String(data.get("city_country")||""),whatsapp,telegram,website_or_social:String(data.get("website_or_social")||""),planning_budget:String(data.get("planning_budget")||"Not sure yet"),planning_horizon:roadmap?`${roadmap} months`:String(data.get("planning_horizon")||"Not sure yet"),preferred_language:String(data.get("preferred_language")||"English"),preferred_contact_time:String(data.get("preferred_contact_time")||""),services:(()=>{const selected=data.getAll("services").map(String);const required=requestType==="claim"?"Catalog claim / verification":requestType==="add"?"Catalog business listing":packageRequest?"Social media marketing & organic growth":"Catalog SEO / GEO";return [...new Set([required,...selected])];})(),message:[String(data.get("message")||""),`Primary services: ${String(data.get("primary_services")||"")}`,`Target locations: ${String(data.get("target_locations")||"")}`].join("\n"),consent:data.get("consent")==="on",attribution:{utm_source:params.get("utm_source")||"hermes_catalog",utm_medium:params.get("utm_medium")||"internal",utm_campaign:params.get("utm_campaign")||requestType,referrer:document.referrer.slice(0,500)}};const button=form.querySelector<HTMLButtonElement>("button[type=submit]");if(button)button.disabled=true;if(status)status.textContent="Sending…";try{const r=await fetch("/api/business-lead",{method:"POST",headers:{"Content-Type":"application/json","Idempotency-Key":payload.request_id},body:JSON.stringify(payload)});if(!r.ok)throw new Error("delivery");form.hidden=true;if(success)success.hidden=false;if(status)status.textContent="";trackEvent(requestType==="claim"?"catalog_claim_requested":packageRequest?"catalog_marketing_package_requested":"catalog_growth_requested",{requestType,months:Number(roadmap||0),businessContext:Boolean(form.dataset.businessSlug)});}catch{if(status)status.textContent="Delivery is temporarily unavailable. Please try again later.";}finally{if(button)button.disabled=false;}});
</script>
<style>
.program{margin-top:20px;padding:22px;border:1px solid #cfe0ef;border-radius:18px;background:linear-gradient(135deg,#f8fcff,#f5f2ff)}.program h2{margin:.2rem 0 1rem;font-size:clamp(24px,4vw,36px);letter-spacing:-.03em}.program-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.program-grid article{padding:15px;border:1px solid #dce7f0;border-radius:14px;background:#fff}.program-grid p{margin:.45rem 0 0;color:#607186;line-height:1.55;font-size:12px}fieldset{border:1px solid #d7e1eb;border-radius:14px;padding:14px}legend{padding:0 6px;color:#52657a;font-size:12px;font-weight:850}.checks{display:grid;grid-template-columns:1fr 1fr;gap:8px}.checks label{display:flex;grid-template-columns:auto 1fr;align-items:center;gap:8px;padding:9px;border:1px solid #e2e8ef;border-radius:10px;background:#f9fbfd}.checks input{width:17px;min-height:17px}@media(max-width:650px){.program-grid,.checks{grid-template-columns:1fr}}
.request-page{min-height:70vh;background:#f5f7fa;color:#172033}.shell{width:min(880px,calc(100% - 2rem));margin:auto;padding:112px 0 80px}.back{color:#24689f;text-decoration:none;font-weight:800}.eyebrow{margin:25px 0 8px;color:#27679e;font-size:11px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}h1{margin:0;font-size:clamp(38px,6vw,60px);letter-spacing:-.04em}header>p{max-width:760px;color:#637287;line-height:1.65}.context,form,.success{margin-top:20px;padding:22px;border:1px solid #dce4ed;border-radius:18px;background:#fff}.context dl{display:grid;gap:8px}.context dl div{display:grid;grid-template-columns:130px 1fr;gap:10px}.context dt{color:#7a8798}.context dd{margin:0;overflow-wrap:anywhere}.context a{color:#24689f}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}form{display:grid;gap:14px}label{display:grid;gap:6px;color:#52657a;font-size:12px;font-weight:800}input,select,textarea{box-sizing:border-box;width:100%;padding:11px;border:1px solid #ccd9e6;border-radius:11px;background:#fff;color:#172033;font:inherit}.consent{display:flex;grid-template-columns:auto 1fr;align-items:flex-start}.consent input{width:18px}button,.success a{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 16px;border:0;border-radius:11px;background:#172033;color:#fff;text-decoration:none;font-weight:850;cursor:pointer}.status{margin:0;color:#745c19}.success{background:#eef8f2}.success h2{margin-top:0}@media(max-width:650px){.two{grid-template-columns:1fr}.shell{padding-top:96px}.context dl div{grid-template-columns:1fr;gap:2px}}</style>
