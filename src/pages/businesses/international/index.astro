---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import DirectionProductNav from "../../../components/DirectionProductNav.astro";
import { internationalCatalogBusinesses } from "../../../data/catalog-business-concepts";
const countries=[...new Map(internationalCatalogBusinesses.map((business)=>[business.countrySlug,{slug:business.countrySlug,name:business.countryName,count:internationalCatalogBusinesses.filter((item)=>item.countrySlug===business.countrySlug).length}])).values()];
const url="https://hermeslogisticsus.com/businesses/international/";
const schema=[{"@context":"https://schema.org","@type":"CollectionPage",name:"Hermes Catalog International Business Directory",url,description:"Secondary international discovery layer for selected evidence-backed businesses outside the United States.",mainEntity:{"@type":"ItemList",itemListElement:countries.map((country,index)=>({"@type":"ListItem",position:index+1,name:country.name,url:`https://hermeslogisticsus.com/businesses/${country.slug}/`}))}}];
---
<BaseLayout title="International Business Directory | Hermes Catalog" description="Selected evidence-backed businesses outside the United States. The primary Hermes Catalog market remains the USA; international profiles support local and AI-search discovery." schema={schema}>
  <SiteHeader theme="light" activePath="/businesses/" /><DirectionProductNav direction="catalog" theme="light" />
  <main class="hub"><div class="shell"><a class="back" href="/businesses/">← U.S.-first Hermes Catalog</a><header><p class="eyebrow">Secondary international layer</p><h1>International business discovery</h1><p>The main Hermes Catalog prioritizes the United States. This separate indexable layer publishes selected businesses in other countries when there is enough public evidence to build a useful local profile. International listing is free while unclaimed and does not imply a Hermes customer relationship.</p></header><section class="grid">{countries.map((country)=><a href={`/businesses/${country.slug}/`}><strong>{country.name}</strong><span>{country.count} published profile{country.count===1?"":"s"}</span></a>)}</section></div></main><SiteFooter />
</BaseLayout>
<style>.hub{background:#f6f7f9;color:#172033;min-height:70vh}.shell{width:min(1080px,calc(100% - 32px));margin:auto;padding:70px 0 90px}.back{color:#326c9f;text-decoration:none;font-weight:850}.eyebrow{margin-top:32px;color:#2168a6;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}h1{margin:8px 0 16px;font-size:clamp(42px,6vw,72px);letter-spacing:-.05em}.shell header p:last-child{max-width:820px;color:#667589;line-height:1.7}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:30px}.grid a{display:grid;gap:8px;padding:22px;border:1px solid #dfe6ee;border-radius:16px;background:#fff;color:#172033;text-decoration:none}.grid strong{font-size:22px}.grid span{color:#718095;font-size:12px}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style>