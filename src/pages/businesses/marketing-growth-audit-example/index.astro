---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

const funnel = [
  {n:"01",uk:"Public + internal audit",en:"Public + internal audit",ukc:"Відокремити те, що видно ззовні, від Meta/CRM даних, яких без owner access немає.",enc:"Separate what is publicly visible from Meta/CRM data that requires owner access."},
  {n:"02",uk:"Organic programming",en:"Organic programming",ukc:"Запланована content matrix: hooks, гео, pains, formats, Reels/short-form і стабільна cadence.",enc:"A planned content matrix: hooks, geography, pains, formats, Reels/short-form, and stable cadence."},
  {n:"03",uk:"Organic baseline",en:"Organic baseline",ukc:"Reach, ER, retention, saves, shares, profile actions, audience quality і repeatable winners.",enc:"Reach, ER, retention, saves, shares, profile actions, audience quality, and repeatable winners."},
  {n:"04",uk:"Paid learning",en:"Paid learning",ukc:"Малий контрольований spend тільки на organic winners; paid/organic split і learning читаються окремо.",enc:"Small controlled spend only on organic winners; paid and organic learning are read separately."},
  {n:"05",uk:"Signal gate",en:"Signal gate",ukc:"Досить даних, щоб відрізнити випадковий spike від повторюваного response pattern.",enc:"Enough data to separate a random spike from a repeatable response pattern."},
  {n:"06",uk:"Offer hypothesis",en:"Offer hypothesis",ukc:"Лише після signal gate формулюємо offer/CTA як гіпотезу та перевіряємо її.",enc:"Only after the signal gate is the offer/CTA framed as a hypothesis and tested."},
  {n:"07",uk:"CRM attribution",en:"CRM attribution",ukc:"Source, content, campaign, CTA, pain, stage і next action переживають handoff.",enc:"Source, content, campaign, CTA, pain, stage, and next action survive the handoff."},
  {n:"08",uk:"Consultation / sale",en:"Consultation / sale",ukc:"Qualification, fit, objection, decision і attributed revenue — тільки з реальних CRM data.",enc:"Qualification, fit, objection, decision, and attributed revenue only from real CRM data."},
  {n:"09",uk:"Delivery",en:"Delivery",ukc:"Продукт / послуга та verified delivery evidence.",enc:"Product/service delivery and verified delivery evidence."},
  {n:"10",uk:"Outcome / retention",en:"Outcome / retention",ukc:"Baseline → actual → renewal/referral з однаковими definitions.",enc:"Baseline → actual → renewal/referral with consistent definitions."},
];

const metrics = [
  {uk:"Кваліфікована увага",en:"Qualified attention",ukc:"Reach / views від потрібної buyer-аудиторії, а не raw volume сам по собі.",enc:"Reach/view from the intended buying audience, not raw volume alone."},
  {uk:"Lead action",en:"Lead action",ukc:"DM, form, diagnostic або call start з attribution до source asset.",enc:"DM, form, diagnostic or call start attributed to the source asset."},
  {uk:"Кваліфікований lead",en:"Qualified lead",ukc:"Правильний buyer, визначена потреба, fit і usable next action.",enc:"Correct buyer, defined need, fit and usable next action."},
  {uk:"Консультація",en:"Consultation",ukc:"Booked → attended → qualified із loss reason.",enc:"Booked → attended → qualified, with loss reason."},
  {uk:"Продаж + revenue",en:"Sale + revenue",ukc:"Closed deal та attributed revenue, коли CRM-source надійний.",enc:"Closed deal and attributed revenue when the CRM source is trustworthy."},
  {uk:"Unit economics",en:"Unit economics",ukc:"CAC · LTV/retention · ROMI тільки після підключення реальних spend/revenue.",enc:"CAC · LTV/retention · ROMI only after real spend/revenue are connected."},
];

const phases = [
  {window:"0–30 днів",uk:"Побудувати organic baseline",en:"Build the organic baseline",ukc:"Отримати дозволені Insights, почистити measurement contract, запустити scheduled content matrix і зафіксувати baseline без paid pressure.",enc:"Connect permitted Insights, clean the measurement contract, run a scheduled content matrix, and establish the baseline without paid pressure."},
  {window:"31–60 днів",uk:"Навчити organic system",en:"Train the organic system",ukc:"Шукати repeatable hooks/formats/audiences, а не один випадковий viral spike; weekly winner/loser review.",enc:"Find repeatable hooks, formats, and audiences rather than one viral spike; run weekly winner/loser review."},
  {window:"61–90 днів",uk:"Запустити paid learning",en:"Start paid learning",ukc:"Підсилювати тільки organic winners малими контрольованими тестами та читати paid/organic окремо.",enc:"Amplify only organic winners with small controlled tests and read paid/organic separately."},
  {window:"Після signal gate",uk:"Перевірити offer hypothesis",en:"Validate the offer hypothesis",ukc:"Тільки тепер тестувати offer, CTA, landing/DM path і consultation handoff.",enc:"Only now test the offer, CTA, landing/DM path, and consultation handoff."},
  {window:"3–6 місяців",uk:"Масштабувати доказане",en:"Scale what is proven",ukc:"Media plan масштабує підтверджені зв’язки content → paid learning → qualified action → sale, а не витрати заради охоплення.",enc:"The media plan scales proven content → paid learning → qualified action → sale relationships, not spend for reach alone."},
];

const schema = [
  {
    "@context":"https://schema.org",
    "@type":"Article",
    headline:"Marketing Growth Audit Example: Organic → Paid Learning → Offer → CRM",
    description:"A reusable Hermes marketing audit method: public and private evidence, organic programming, controlled paid learning, offer validation, CRM attribution, and measurable outcomes.",
    url:"https://hermeslogisticsus.com/businesses/marketing-growth-audit-example/",
    author:{"@type":"Organization","name":"Hermes"},
  },
  {
    "@context":"https://schema.org",
    "@type":"Service",
    name:"Marketing growth audit and 90-day media plan",
    serviceType:"Marketing audit, organic programming, paid-learning readiness, offer validation and CRM attribution",
    provider:{"@type":"Organization","name":"Hermes"},
    url:"https://hermeslogisticsus.com/businesses/marketing-growth-audit-example/",
  },
  {
    "@context":"https://schema.org",
    "@type":"BreadcrumbList",
    itemListElement:[
      {"@type":"ListItem",position:1,name:"Hermes",item:"https://hermeslogisticsus.com/"},
      {"@type":"ListItem",position:2,name:"Hermes Catalog",item:"https://hermeslogisticsus.com/businesses/"},
      {"@type":"ListItem",position:3,name:"Marketing Growth Audit Example",item:"https://hermeslogisticsus.com/businesses/marketing-growth-audit-example/"},
    ],
  },
  {
    "@context":"https://schema.org",
    "@type":"FAQPage",
    mainEntity:[
      {
        "@type":"Question",
        name:"What does a Hermes marketing growth audit measure?",
        acceptedAnswer:{"@type":"Answer",text:"It connects public marketing signals to a diagnostic, CRM attribution, qualified lead actions, consultations, sales outcomes, delivery, and retention using defined evidence and source rules."},
      },
      {
        "@type":"Question",
        name:"Does the audit guarantee rankings, leads, or revenue?",
        acceptedAnswer:{"@type":"Answer",text:"No. The example separates observed evidence from unknowns and does not promise rankings, leads, or revenue."},
      },
      {
        "@type":"Question",
        name:"When should CAC, LTV, and ROMI be used?",
        acceptedAnswer:{"@type":"Answer",text:"Only after permitted spend, sales or revenue data, and attribution rules are connected well enough to support those calculations."},
      },
    ],
  },
];
---
<BaseLayout
  title="Marketing Growth Audit Example | Hermes Catalog"
  description="See the Hermes organic-first marketing audit method: internal analytics, organic programming, paid learning, offer validation, CRM attribution and a 3–6 month media plan."
  schema={schema}
  htmlLang="uk"
  locale="uk"
>
  <SiteHeader activePath="/businesses/" theme="light" locale="uk" />
  <main id="main-content" class="case-page">
    <div class="case-shell">
      <div class="case-toolbar">
        <a href="/businesses/" data-i18n="back">← Hermes Catalog</a>
        <div class="case-lang" aria-label="Language"><button class="active" type="button" data-lang="uk">UA</button><button type="button" data-lang="en">EN</button></div>
      </div>

      <section class="case-hero">
        <p class="eyebrow">HERMES STRATEGY CASE · MARKETING</p>
        <h1 data-i18n="title">Organic → Paid Learning → Offer → CRM</h1>
        <p class="lead" data-i18n="lead">Public audit не дорівнює готовій воронці. Спочатку піднімаємо organic programming і baseline, потім навчаємо paid system на organic winners, і лише після signal gate тестуємо offer та sales funnel.</p>
        <div class="actions">
          <a class="primary" href="#audit" data-i18n="seeMethod">Подивитися метод</a>
          <a href="/businesses/request/?type=marketing-package&months=3&utm_source=hermes_catalog&utm_medium=strategy_case&utm_campaign=marketing_growth_audit_example" data-case-cta="hero" data-i18n="requestAudit">Замовити подібний аудит →</a>
        </div>
        <div class="truth">
          <span data-i18n="truth1">Public signals ≠ private analytics</span>
          <span data-i18n="truth2">Unknown ≠ zero</span>
          <span data-i18n="truth3">Human-approved claims</span>
          <span data-i18n="truth4">No guaranteed rankings, leads or revenue</span>
        </div>
      </section>

      <section class="panel" id="audit">
        <div class="head"><div><p class="eyebrow">01 · AUDIT</p><h2 data-i18n="auditTitle">Що потрібно знати до будь-якого paid offer або funnel.</h2></div></div>
        <div class="grid four">
          <article><span>01</span><h3 data-i18n="a1">Internal access & baseline</h3><p data-i18n="a1c">Meta Business Suite / Insights / Ads Manager, 90-day trend, audience quality, paid/organic split та CRM outcomes.</p></article>
          <article><span>02</span><h3 data-i18n="a2">Organic programming</h3><p data-i18n="a2c">Scheduled content matrix, hooks, geo, pains, formats, Reels та повторювані organic patterns до paid spend.</p></article>
          <article><span>03</span><h3 data-i18n="a3">Paid-learning gate</h3><p data-i18n="a3c">Paid включається як controlled learning на organic winners, а не як спосіб купити сигнал, якого органічно ще немає.</p></article>
          <article><span>04</span><h3 data-i18n="a4">Offer readiness & proof</h3><p data-i18n="a4c">Offer/CTA з’являється після signal gate; claim → source → observed_at → definition → approved wording.</p></article>
        </div>
      </section>

      <section class="panel readiness">
        <div class="head"><div><p class="eyebrow">READINESS GATE</p><h2 data-uk="Чому неможливо чесно виконати social funnel тільки з відкритих даних." data-en="Why a real social funnel cannot be honestly completed from public data alone.">Чому неможливо чесно виконати social funnel тільки з відкритих даних.</h2></div></div>
        <p class="note" data-uk="Public profile показує контент і частину visible signals. Він не показує повний Reach, ER, retention, audience quality, paid/organic split, Ads Manager learning, CAC або downstream sales. Тому готовий оффер до цих даних — не validated strategy, а припущення." data-en="A public profile shows content and some visible signals. It does not show full Reach, ER, retention, audience quality, paid/organic split, Ads Manager learning, CAC, or downstream sales. A ready offer before those data is therefore an assumption, not a validated strategy.">Public profile показує контент і частину visible signals. Він не показує повний Reach, ER, retention, audience quality, paid/organic split, Ads Manager learning, CAC або downstream sales. Тому готовий оффер до цих даних — не validated strategy, а припущення.</p>
        <div class="gate-grid">
          <article><span>1</span><b>Access</b><small data-uk="Внутрішні Insights / Business Suite / Ads Manager + CRM." data-en="Internal Insights / Business Suite / Ads Manager + CRM.">Внутрішні Insights / Business Suite / Ads Manager + CRM.</small></article>
          <article><span>2</span><b>Organic</b><small data-uk="Програмуємо content system і збираємо baseline." data-en="Program the content system and collect a baseline.">Програмуємо content system і збираємо baseline.</small></article>
          <article><span>3</span><b>Paid learning</b><small data-uk="Підсилюємо organic winners контрольованим spend." data-en="Amplify organic winners with controlled spend.">Підсилюємо organic winners контрольованим spend.</small></article>
          <article><span>4</span><b>Offer hypothesis</b><small data-uk="Тестуємо тільки після достатнього signal." data-en="Test only after sufficient signal.">Тестуємо тільки після достатнього signal.</small></article>
          <article><span>5</span><b>Scale</b><small data-uk="Масштабуємо зв’язок, який довів qualified action / sale." data-en="Scale the relationship that proved a qualified action / sale.">Масштабуємо зв’язок, який довів qualified action / sale.</small></article>
        </div>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">02 · CHANNEL SYSTEM</p><h2 data-i18n="channelsTitle">Канали мають різні ролі, але одну customer identity.</h2></div></div>
        <div class="channel-grid">
          <article><b>Instagram / TikTok</b><small data-i18n="ch1">Attention, hooks, cases, objections, short-form testing.</small></article>
          <article><b>YouTube / Podcast</b><small data-i18n="ch2">Depth, trust, education, long-form intent and searchable proof.</small></article>
          <article><b>Threads</b><small data-i18n="ch3">Fast hypothesis testing, opinions, questions and conversation starters.</small></article>
          <article><b>Telegram / Email</b><small data-i18n="ch4">Nurture, follow-up, event/program reminders and retention.</small></article>
          <article><b>Website</b><small data-i18n="ch5">Canonical offer, proof, diagnostic, conversion and consent.</small></article>
          <article><b>CRM</b><small data-i18n="ch6">One lead/customer identity across every channel and every next action.</small></article>
        </div>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">03 · CONDITIONAL OFFER</p><h2 data-i18n="offerTitle">Оффер — не стартова точка. Це гіпотеза після organic + paid learning gate.</h2></div></div>
        <div class="offer">
          <div>
            <strong data-i18n="offer">“Offer формулюємо тільки після того, як бачимо повторюваний response pattern і можемо виміряти наступну дію.”</strong>
            <p data-i18n="offerCopy">До signal gate ми можемо описати лише offer hypothesis. Після organic baseline і paid learning вже тестуємо конкретний CTA, landing/DM path, qualification та sales handoff.</p>
          </div>
          <ul>
            <li data-i18n="o1">organic evidence до spend;</li>
            <li data-i18n="o2">paid learning замість blind spend;</li>
            <li data-i18n="o3">offer hypothesis після signal gate;</li>
            <li data-i18n="o4">CRM attribution до sale / outcome.</li>
          </ul>
        </div>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">04 · DIAGNOSTIC LENSES</p><h2 data-i18n="riskTitle">Шість зон, де маркетинг може втрачати гроші ще до оптимізації funnel.</h2></div></div>
        <div class="risk-grid">
          <article><span>01</span><b data-uk="Надмірна складність" data-en="Overthinking / complexity">Надмірна складність</b><small data-uk="Чи не ускладнюємо шлях клієнта, повідомлення або процес без потреби." data-en="Are we making the buyer journey, message, or process more complex than necessary?">Чи не ускладнюємо шлях клієнта, повідомлення або процес без потреби.</small></article>
          <article><span>02</span><b data-uk="Дані" data-en="Data">Дані</b><small data-uk="Чи є baseline, definition, source quality і достатня вибірка для рішення." data-en="Do we have a baseline, definition, source quality, and enough evidence for the decision?">Чи є baseline, definition, source quality і достатня вибірка для рішення.</small></article>
          <article><span>03</span><b data-uk="Припущення" data-en="Assumptions">Припущення</b><small data-uk="Чи перевіряємо гіпотезу експериментом, а не пояснюємо результат заднім числом." data-en="Are hypotheses tested by experiment instead of explained after the fact?">Чи перевіряємо гіпотезу експериментом, а не пояснюємо результат заднім числом.</small></article>
          <article><span>04</span><b data-uk="Marketing tactics" data-en="Marketing tactics">Marketing tactics</b><small data-uk="Чи відповідає tactic конкретній стадії funnel, продукту й аудиторії." data-en="Does the tactic fit the funnel stage, product, and audience?">Чи відповідає tactic конкретній стадії funnel, продукту й аудиторії.</small></article>
          <article><span>05</span><b>ROI</b><small data-uk="Чи зв’язана активність із qualified inquiry, sale, revenue і cost." data-en="Is activity connected to qualified inquiry, sale, revenue, and cost?">Чи зв’язана активність із qualified inquiry, sale, revenue і cost.</small></article>
          <article><span>06</span><b data-uk="Human capital" data-en="Human capital">Human capital</b><small data-uk="Чи є owner, компетенція, review loop і відповідальність за next action." data-en="Is there an owner, capability, review loop, and accountability for the next action?">Чи є owner, компетенція, review loop і відповідальність за next action.</small></article>
        </div>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">05 · MINDMAP</p><h2 data-i18n="funnelTitle">Воронка закінчується бізнес-результатом, не охопленням.</h2></div></div>
        <div class="funnel">{funnel.map((item)=><article><span>{item.n}</span><b data-uk={item.uk} data-en={item.en}>{item.uk}</b><small data-uk={item.ukc} data-en={item.enc}>{item.ukc}</small></article>)}</div>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">06 · MEASUREMENT</p><h2 data-i18n="metricsTitle">Шість контрольних рівнів замість vanity metrics.</h2></div></div>
        <div class="metrics">{metrics.map((item,index)=><article><span>0{index+1}</span><div><b data-uk={item.uk} data-en={item.en}>{item.uk}</b><small data-uk={item.ukc} data-en={item.enc}>{item.ukc}</small></div></article>)}</div>
        <p class="note" data-i18n="metricNote">CAC/LTV/ROMI не заповнюються “для красивого дашборду”. Вони з’являються після дозволеного підключення spend, sales/revenue та attribution rules.</p>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">07 · 3–6 MONTH MEDIA PLAN</p><h2 data-i18n="planTitle">Organic first → paid learning → offer validation → scale.</h2></div></div>
        <div class="phases">{phases.map((item)=><article><span>{item.window}</span><h3 data-uk={item.uk} data-en={item.en}>{item.uk}</h3><p data-uk={item.ukc} data-en={item.enc}>{item.ukc}</p></article>)}</div>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">08 · CRM FIELD MAP</p><h2 data-i18n="crmTitle">Що має пережити перехід із social у sales.</h2></div></div>
        <div class="chips">{["source_channel","content_id","campaign_id","CTA / keyword","entry_offer","primary pain","diagnostic_primary_gap","baseline","recommended_module/service","reason_to_believe","business stage","owner / manager","consultation status","objection","sale / revenue","delivery","completion","renewal"].map(x=><span>{x}</span>)}</div>
        <p class="note" data-i18n="crmNote">Instagram → Telegram → form → consultation не повинні створювати чотири різні контакти. Один buyer має одну identity та історію touchpoints.</p>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">09 · CANDIDATE ASSESSMENT</p><h2 data-i18n="assessmentTitle">Той самий метод можна використовувати для тесту маркетолога в CRM.</h2></div></div>
        <div class="training-method">
          <article><span>01</span><b data-uk="Першу колонку спочатку залишаємо порожньою" data-en="Leave the first column blank at first">Першу колонку спочатку залишаємо порожньою</b><small data-uk="До неї повертаємося після колонок 2–4 і пишемо наводящі питання." data-en="Return to it after columns 2–4 and write leading questions.">До неї повертаємося після колонок 2–4 і пишемо наводящі питання.</small></article>
          <article><span>02</span><b data-uk="Усвідомлення" data-en="Awareness">Усвідомлення</b><small data-uk="Що людина має усвідомити про проблему або можливість." data-en="What the person should realize about the problem or opportunity.">Що людина має усвідомити про проблему або можливість.</small></article>
          <article><span>03</span><b data-uk="Розуміння" data-en="Understanding">Розуміння</b><small data-uk="Що вона вже розуміє настільки, щоб пояснити своїми словами." data-en="What they understand well enough to explain in their own words.">Що вона вже розуміє настільки, щоб пояснити своїми словами.</small></article>
          <article><span>04</span><b data-uk="Застосування" data-en="Application">Застосування</b><small data-uk="Як це застосувати на практиці та яка наступна дія логічна." data-en="How to apply it in practice and what next action is logical.">Як це застосувати на практиці та яка наступна дія логічна.</small></article>
        </div>
        <p class="note" data-uk="Після заповнення 2–4 повертаємося до колонки 1: Питання → Усвідомлення → Розуміння → Застосування. Так будуємо Reels, Threads, Stories, каруселі й sales copy. Якщо контент не може пройти ці 4 колонки, він ще не готовий." data-en="After completing columns 2–4, return to column 1: Question → Awareness → Understanding → Application. This becomes the structure for Reels, Threads, Stories, carousels, and sales copy. If a piece cannot pass these four columns, it is not ready.">Після заповнення 2–4 повертаємося до колонки 1: Питання → Усвідомлення → Розуміння → Застосування. Так будуємо Reels, Threads, Stories, каруселі й sales copy. Якщо контент не може пройти ці 4 колонки, він ще не готовий.</p>
        <div class="assessment">
          <span>Evidence & diagnosis · 0–5</span>
          <span>Audience & positioning · 0–5</span>
          <span>Funnel logic · 0–5</span>
          <span>Offer quality · 0–5</span>
          <span>KPI & measurement · 0–5</span>
          <span>Execution thinking · 0–5</span>
        </div>
        <p class="note" data-i18n="assessmentCopy">Brief → deadline → sources → Google Docs / MindMap → reviewer score → human decision. Assessment не змішується з learner progress і не робить кадрове рішення автоматично.</p>
      </section>

      <section class="panel proof">
        <div class="head"><div><p class="eyebrow">10 · PROOF GOVERNANCE</p><h2 data-i18n="proofTitle">Перед масштабуванням — одна canonical версія кожного claim.</h2></div></div>
        <div class="proof-grid">
          <article><b>Claim</b><small data-i18n="p1">Що саме говоримо публічно.</small></article>
