---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

const funnel = [
  {n:"01",uk:"Увага",en:"Attention",ukc:"Short-form / long-form контент за pain-кластерами клієнта.",enc:"Short-form / long-form content grouped by customer pain."},
  {n:"02",uk:"Вимірюваний CTA",en:"Trackable CTA",ukc:"Одна primary action на asset + campaign_id.",enc:"One primary action per asset + campaign_id."},
  {n:"03",uk:"Діагностика",en:"Diagnostic",ukc:"Baseline + головний gap + перші три дії.",enc:"Baseline + primary gap + first three actions."},
  {n:"04",uk:"CRM-контекст",en:"CRM context",ukc:"Source, pain, stage, offer, owner і next action.",enc:"Source, pain, stage, offer, owner, next action."},
  {n:"05",uk:"Консультація",en:"Consultation",ukc:"Fit, economics, objection і decision.",enc:"Fit, economics, objection, decision."},
  {n:"06",uk:"Основний оффер",en:"Core offer",ukc:"Програма / послуга, що відповідає діагностованому gap.",enc:"Program / service matched to the diagnosed gap."},
  {n:"07",uk:"Delivery",en:"Delivery",ukc:"Cohort / project / implementation evidence.",enc:"Cohort / project / implementation evidence."},
  {n:"08",uk:"Результат",en:"Outcome",ukc:"Baseline → actual із source та definition.",enc:"Baseline → actual, with source and definition."},
  {n:"09",uk:"Retention",en:"Retention",ukc:"Renewal / наступна програма / referral.",enc:"Renewal / next program / referral."},
];

const metrics = [
  {uk:"Кваліфікована увага",en:"Qualified attention",ukc:"Reach / views від потрібної buyer-аудиторії, а не raw volume сам по собі.",enc:"Reach/view from the intended buying audience, not raw volume alone."},
  {uk:"Lead action",en:"Lead action",ukc:"DM, form, diagnostic або call start з attribution до source asset.",enc:"DM, form, diagnostic or call start attributed to the source asset."},
  {uk:"Кваліфікований lead",en:"Qualified lead",ukc:"Правильний buyer, визначена потреба, fit і usable next action.",enc:"Correct buyer, defined need, fit and usable next action."},
  {uk:"Консультація",en:"Consultation",ukc:"Booked → attended → qualified із loss reason.",enc:"Booked → attended → qualified, with loss reason."},
  {uk:"Продаж + revenue",en:"Sale + revenue",ukc:"Closed deal та attributed revenue, коли CRM-source надійний.",enc:"Closed deal and attributed revenue when the CRM source is trustworthy."},
  {uk:"Unit economics",en:"Unit economics",ukc:"CAC · LTV/retention · ROMI тільки після підключення реальних spend/revenue.",enc:"CAC · LTV/retention · ROMI only after real spend/revenue are connected."},
];

const phases = [
  {window:"0–7 днів",uk:"Інструментувати",en:"Instrument",ukc:"Єдиний словник CTA, UTM/campaign rules, CRM source fields, proof ledger і baseline dashboard.",enc:"Unify CTA vocabulary, UTM/campaign rules, CRM source fields, proof ledger and baseline dashboard."},
  {window:"8–30 днів",uk:"Навчитися на даних",en:"Learn",ukc:"Розкласти content за pain × funnel stage, порівнювати winners/losers, стандартизувати diagnostic і consultation handoff.",enc:"Map content by pain × funnel stage, compare winners/losers, standardize diagnostic and consultation handoff."},
  {window:"31–90 днів",uk:"Масштабувати",en:"Scale",ukc:"Розширювати proven hooks, retarget qualified audiences і зв’язати delivery/renewal з acquisition source.",enc:"Expand proven hooks, retarget qualified audiences, connect delivery/renewal back to acquisition source."},
];

const schema = [
  {
    "@context":"https://schema.org",
    "@type":"Article",
    headline:"Marketing Growth Audit Example: Social → CRM → Revenue",
    description:"A reusable Hermes marketing strategy example showing how public social signals become a measurable diagnostic, CRM funnel, offer, KPI system and 90-day growth plan.",
    url:"https://hermeslogisticsus.com/businesses/marketing-growth-audit-example/",
    author:{"@type":"Organization","name":"Hermes"},
  },
  {
    "@context":"https://schema.org",
    "@type":"Service",
    name:"Marketing growth audit and 90-day media plan",
    serviceType:"Marketing strategy, social audit, funnel design and CRM attribution",
    provider:{"@type":"Organization","name":"Hermes"},
    url:"https://hermeslogisticsus.com/businesses/marketing-growth-audit-example/",
  },
];
---
<BaseLayout
  title="Marketing Growth Audit Example | Hermes Catalog"
  description="See how Hermes turns a social-channel audit into a measurable offer, funnel, CRM attribution model, KPI system and 90-day growth plan."
  schema={schema}
  htmlLang="uk"
  locale="uk"
>
  <SiteHeader activePath="/businesses/" theme="light" locale="uk" />
  <main id="main-content" class="case-page">
    <div class="case-shell">
      <div class="case-toolbar">
        <a href="/businesses/" data-i18n="back">← Hermes Catalog</a>
        <div class="case-lang" aria-label="Language"><button class="active" type="button" data-lang="uk">UA</button><button type="button" data-lang="en">EN</button></div>
      </div>

      <section class="case-hero">
        <p class="eyebrow">HERMES STRATEGY CASE · MARKETING</p>
        <h1 data-i18n="title">Social → CRM → Revenue</h1>
        <p class="lead" data-i18n="lead">Приклад того, що ми рекомендуємо бізнесу після маркетингового аудиту: не “більше постів”, а одна вимірювана система від контенту до продажу, delivery та повторної покупки.</p>
        <div class="actions">
          <a class="primary" href="#audit" data-i18n="seeMethod">Подивитися метод</a>
          <a href="/businesses/request/?type=marketing-package&months=3&utm_source=hermes_catalog&utm_medium=strategy_case&utm_campaign=marketing_growth_audit_example" data-case-cta="hero" data-i18n="requestAudit">Замовити подібний аудит →</a>
        </div>
        <div class="truth">
          <span data-i18n="truth1">Public signals ≠ private analytics</span>
          <span data-i18n="truth2">Unknown ≠ zero</span>
          <span data-i18n="truth3">Human-approved claims</span>
          <span data-i18n="truth4">No guaranteed rankings, leads or revenue</span>
        </div>
      </section>

      <section class="panel" id="audit">
        <div class="head"><div><p class="eyebrow">01 · AUDIT</p><h2 data-i18n="auditTitle">Що ми перевіряємо до того, як радити tactic.</h2></div></div>
        <div class="grid four">
          <article><span>01</span><h3 data-i18n="a1">Audience & positioning</h3><p data-i18n="a1c">Хто покупець, яка проблема, який stage of awareness і чому оффер має бути релевантним саме зараз.</p></article>
          <article><span>02</span><h3 data-i18n="a2">Content architecture</h3><p data-i18n="a2c">Pain → insight → proof → conversion → retention. Кожен asset має зрозумілу роль у funnel.</p></article>
          <article><span>03</span><h3 data-i18n="a3">CTA & attribution</h3><p data-i18n="a3c">Один primary CTA на asset, campaign_id, UTM/keyword convention та downstream CRM outcome.</p></article>
          <article><span>04</span><h3 data-i18n="a4">Proof consistency</h3><p data-i18n="a4c">Claim → source → observed_at → definition → approved wording → review date.</p></article>
        </div>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">02 · CHANNEL SYSTEM</p><h2 data-i18n="channelsTitle">Канали мають різні ролі, але одну customer identity.</h2></div></div>
        <div class="channel-grid">
          <article><b>Instagram / TikTok</b><small data-i18n="ch1">Attention, hooks, cases, objections, short-form testing.</small></article>
          <article><b>YouTube / Podcast</b><small data-i18n="ch2">Depth, trust, education, long-form intent and searchable proof.</small></article>
          <article><b>Threads</b><small data-i18n="ch3">Fast hypothesis testing, opinions, questions and conversation starters.</small></article>
          <article><b>Telegram / Email</b><small data-i18n="ch4">Nurture, follow-up, event/program reminders and retention.</small></article>
          <article><b>Website</b><small data-i18n="ch5">Canonical offer, proof, diagnostic, conversion and consent.</small></article>
          <article><b>CRM</b><small data-i18n="ch6">One lead/customer identity across every channel and every next action.</small></article>
        </div>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">03 · OFFER</p><h2 data-i18n="offerTitle">Не винаходити lead magnet, якщо в бізнесу вже є сильний diagnostic entry point.</h2></div></div>
        <div class="offer">
          <div>
            <strong data-i18n="offer">“Знайдемо головне вузьке місце росту, зафіксуємо baseline і дамо персональну карту перших 3 дій.”</strong>
            <p data-i18n="offerCopy">Після діагностики sales бачить контекст, а клієнт — reason-to-believe. Основний продукт пропонується тільки після problem-fit, а не замість нього.</p>
          </div>
          <ul>
            <li data-i18n="o1">користь до покупки;</li>
            <li data-i18n="o2">структуровані CRM-дані;</li>
            <li data-i18n="o3">персональний program/service fit;</li>
            <li data-i18n="o4">чистіша attribution та follow-up.</li>
          </ul>
        </div>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">04 · MINDMAP</p><h2 data-i18n="funnelTitle">Воронка закінчується бізнес-результатом, не охопленням.</h2></div></div>
        <div class="funnel">{funnel.map((item)=><article><span>{item.n}</span><b data-uk={item.uk} data-en={item.en}>{item.uk}</b><small data-uk={item.ukc} data-en={item.enc}>{item.ukc}</small></article>)}</div>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">05 · MEASUREMENT</p><h2 data-i18n="metricsTitle">Шість контрольних рівнів замість vanity metrics.</h2></div></div>
        <div class="metrics">{metrics.map((item,index)=><article><span>0{index+1}</span><div><b data-uk={item.uk} data-en={item.en}>{item.uk}</b><small data-uk={item.ukc} data-en={item.enc}>{item.ukc}</small></div></article>)}</div>
        <p class="note" data-i18n="metricNote">CAC/LTV/ROMI не заповнюються “для красивого дашборду”. Вони з’являються після дозволеного підключення spend, sales/revenue та attribution rules.</p>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">06 · 90-DAY OPERATING PLAN</p><h2 data-i18n="planTitle">Спочатку instrumentation, потім learning, потім scale.</h2></div></div>
        <div class="phases">{phases.map((item)=><article><span>{item.window}</span><h3 data-uk={item.uk} data-en={item.en}>{item.uk}</h3><p data-uk={item.ukc} data-en={item.enc}>{item.ukc}</p></article>)}</div>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">07 · CRM FIELD MAP</p><h2 data-i18n="crmTitle">Що має пережити перехід із social у sales.</h2></div></div>
        <div class="chips">{["source_channel","content_id","campaign_id","CTA / keyword","entry_offer","primary pain","diagnostic_primary_gap","baseline","recommended_module/service","reason_to_believe","business stage","owner / manager","consultation status","objection","sale / revenue","delivery","completion","renewal"].map(x=><span>{x}</span>)}</div>
        <p class="note" data-i18n="crmNote">Instagram → Telegram → form → consultation не повинні створювати чотири різні контакти. Один buyer має одну identity та історію touchpoints.</p>
      </section>

      <section class="panel">
        <div class="head"><div><p class="eyebrow">08 · CANDIDATE ASSESSMENT</p><h2 data-i18n="assessmentTitle">Той самий метод можна використовувати для тесту маркетолога в CRM.</h2></div></div>
        <div class="assessment">
          <span>Evidence & diagnosis · 0–5</span>
          <span>Audience & positioning · 0–5</span>
          <span>Funnel logic · 0–5</span>
          <span>Offer quality · 0–5</span>
          <span>KPI & measurement · 0–5</span>
          <span>Execution thinking · 0–5</span>
        </div>
        <p class="note" data-i18n="assessmentCopy">Brief → deadline → sources → Google Docs / MindMap → reviewer score → human decision. Assessment не змішується з learner progress і не робить кадрове рішення автоматично.</p>
      </section>

      <section class="panel proof">
        <div class="head"><div><p class="eyebrow">09 · PROOF GOVERNANCE</p><h2 data-i18n="proofTitle">Перед масштабуванням — одна canonical версія кожного claim.</h2></div></div>
        <div class="proof-grid">
          <article><b>Claim</b><small data-i18n="p1">Що саме говоримо публічно.</small></article>
          <article><b>Source</b><small data-i18n="p2">URL / CRM / document + observed_at.</small></article>
          <article><b>Definition</b><small data-i18n="p3">Population, period, calculation.</small></article>
          <article><b>Owner</b><small data-i18n="p4">Хто відповідає за evidence.</small></article>
          <article><b>Approved wording</b><small data-i18n="p5">Що дозволено site/social/sales.</small></article>
          <article><b>Review date</b><small data-i18n="p6">Коли перевіряти повторно.</small></article>
        </div>
      </section>

      <section class="cta">
        <p class="eyebrow">HERMES MARKETING + CONNECT</p>
        <h2 data-i18n="ctaTitle">Хочете такий самий аудит для свого бізнесу?</h2>
        <p data-i18n="ctaCopy">Ми можемо почати з public-source audit, скласти 90-day media plan і показати, які CRM-поля та attribution потрібні до масштабування.</p>
        <a class="primary" href="/businesses/request/?type=marketing-package&months=3&utm_source=hermes_catalog&utm_medium=strategy_case&utm_campaign=marketing_growth_audit_example&utm_content=final_cta" data-case-cta="final" data-i18n="cta">Запросити аудит →</a>
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { trackCaseOpened, trackEvent } from "../../../lib/analytics";
  trackCaseOpened("marketing_growth_audit_example");
  document.querySelectorAll<HTMLAnchorElement>("[data-case-cta]").forEach((link) => link.addEventListener("click", () => {
    trackEvent("case_study_cta", { caseId: "marketing_growth_audit_example", destination: link.pathname, action: "request_similar_audit", placement: link.dataset.caseCta || "unknown" });
  }));
  const d={
    uk:{back:"← Hermes Catalog",title:"Social → CRM → Revenue",lead:"Приклад того, що ми рекомендуємо бізнесу після маркетингового аудиту: не “більше постів”, а одна вимірювана система від контенту до продажу, delivery та повторної покупки.",seeMethod:"Подивитися метод",requestAudit:"Замовити подібний аудит →",truth1:"Public signals ≠ private analytics",truth2:"Unknown ≠ zero",truth3:"Human-approved claims",truth4:"Без гарантій ranking, leads або revenue",auditTitle:"Що ми перевіряємо до того, як радити tactic.",a1:"Audience & positioning",a1c:"Хто покупець, яка проблема, який stage of awareness і чому оффер має бути релевантним саме зараз.",a2:"Content architecture",a2c:"Pain → insight → proof → conversion → retention. Кожен asset має зрозумілу роль у funnel.",a3:"CTA & attribution",a3c:"Один primary CTA на asset, campaign_id, UTM/keyword convention та downstream CRM outcome.",a4:"Proof consistency",a4c:"Claim → source → observed_at → definition → approved wording → review date.",channelsTitle:"Канали мають різні ролі, але одну customer identity.",ch1:"Attention, hooks, cases, objections, short-form testing.",ch2:"Depth, trust, education, long-form intent and searchable proof.",ch3:"Fast hypothesis testing, opinions, questions and conversation starters.",ch4:"Nurture, follow-up, event/program reminders and retention.",ch5:"Canonical offer, proof, diagnostic, conversion and consent.",ch6:"Одна lead/customer identity через усі канали і next actions.",offerTitle:"Не винаходити lead magnet, якщо в бізнесу вже є сильний diagnostic entry point.",offer:"“Знайдемо головне вузьке місце росту, зафіксуємо baseline і дамо персональну карту перших 3 дій.”",offerCopy:"Після діагностики sales бачить контекст, а клієнт — reason-to-believe. Основний продукт пропонується тільки після problem-fit, а не замість нього.",o1:"користь до покупки;",o2:"структуровані CRM-дані;",o3:"персональний program/service fit;",o4:"чистіша attribution та follow-up.",funnelTitle:"Воронка закінчується бізнес-результатом, не охопленням.",metricsTitle:"Шість контрольних рівнів замість vanity metrics.",metricNote:"CAC/LTV/ROMI не заповнюються “для красивого дашборду”. Вони з’являються після дозволеного підключення spend, sales/revenue та attribution rules.",planTitle:"Спочатку instrumentation, потім learning, потім scale.",crmTitle:"Що має пережити перехід із social у sales.",crmNote:"Instagram → Telegram → form → consultation не повинні створювати чотири різні контакти. Один buyer має одну identity та історію touchpoints.",assessmentTitle:"Той самий метод можна використовувати для тесту маркетолога в CRM.",assessmentCopy:"Brief → deadline → sources → Google Docs / MindMap → reviewer score → human decision. Assessment не змішується з learner progress і не робить кадрове рішення автоматично.",proofTitle:"Перед масштабуванням — одна canonical версія кожного claim.",p1:"Що саме говоримо публічно.",p2:"URL / CRM / document + observed_at.",p3:"Population, period, calculation.",p4:"Хто відповідає за evidence.",p5:"Що дозволено site/social/sales.",p6:"Коли перевіряти повторно.",ctaTitle:"Хочете такий самий аудит для свого бізнесу?",ctaCopy:"Ми можемо почати з public-source audit, скласти 90-day media plan і показати, які CRM-поля та attribution потрібні до масштабування.",cta:"Запросити аудит →"},
    en:{back:"← Hermes Catalog",title:"Social → CRM → Revenue",lead:"An example of what Hermes recommends after a marketing audit: not simply more posts, but one measurable system from content to sale, delivery, and repeat purchase.",seeMethod:"See the method",requestAudit:"Request a similar audit →",truth1:"Public signals ≠ private analytics",truth2:"Unknown ≠ zero",truth3:"Human-approved claims",truth4:"No guaranteed rankings, leads or revenue",auditTitle:"What we check before recommending a tactic.",a1:"Audience & positioning",a1c:"Who buys, which problem matters, the awareness stage, and why the offer is relevant now.",a2:"Content architecture",a2c:"Pain → insight → proof → conversion → retention. Every asset has a clear funnel role.",a3:"CTA & attribution",a3c:"One primary CTA per asset, campaign_id, UTM/keyword convention, and downstream CRM outcome.",a4:"Proof consistency",a4c:"Claim → source → observed_at → definition → approved wording → review date.",channelsTitle:"Channels have different jobs but one customer identity.",ch1:"Attention, hooks, cases, objections, short-form testing.",ch2:"Depth, trust, education, long-form intent and searchable proof.",ch3:"Fast hypothesis testing, opinions, questions and conversation starters.",ch4:"Nurture, follow-up, event/program reminders and retention.",ch5:"Canonical offer, proof, diagnostic, conversion and consent.",ch6:"One lead/customer identity across every channel and next action.",offerTitle:"Do not invent another lead magnet when the business already has a strong diagnostic entry point.",offer:"“We identify the main growth bottleneck, record the baseline, and give a personal map of the first three actions.”",offerCopy:"After the diagnostic, sales has context and the buyer has a reason to believe. The core product is offered after problem-fit, not instead of it.",o1:"value before purchase;",o2:"structured CRM data;",o3:"personalized program/service fit;",o4:"cleaner attribution and follow-up.",funnelTitle:"The funnel ends in a business outcome, not reach.",metricsTitle:"Six control levels instead of vanity metrics.",metricNote:"CAC/LTV/ROMI are not filled for dashboard aesthetics. They appear after permitted spend, sales/revenue and attribution sources are connected.",planTitle:"Instrument first, learn second, scale third.",crmTitle:"What must survive the handoff from social to sales.",crmNote:"Instagram → Telegram → form → consultation should not create four different contacts. One buyer keeps one identity and touchpoint history.",assessmentTitle:"The same method can become a marketer candidate test inside CRM.",assessmentCopy:"Brief → deadline → sources → Google Docs / MindMap → reviewer score → human decision. Assessment stays separate from learner progress and does not automate hiring.",proofTitle:"Before scaling, keep one canonical version of every claim.",p1:"Exactly what we say publicly.",p2:"URL / CRM / document + observed_at.",p3:"Population, period, calculation.",p4:"Who owns the evidence.",p5:"What site/social/sales may use.",p6:"When it must be reviewed again.",ctaTitle:"Want the same type of audit for your business?",ctaCopy:"We can start with a public-source audit, build a 90-day media plan, and show which CRM fields and attribution rules should exist before scaling.",cta:"Request an audit →"}
  } as const;
  type Lang=keyof typeof d;
  const params=new URLSearchParams(location.search);
  let lang:Lang=params.get("lang")==="en"?"en":"uk";
  const apply=(next:Lang)=>{lang=next;document.documentElement.lang=next;try{localStorage.setItem("hermes-connect-language",next)}catch{};document.querySelectorAll<HTMLElement>("[data-i18n]").forEach(n=>{const k=n.dataset.i18n as keyof typeof d.uk;const v=d[next][k];if(v)n.textContent=v});document.querySelectorAll<HTMLElement>("[data-uk][data-en]").forEach(n=>{n.textContent=next==="en"?(n.dataset.en||""):(n.dataset.uk||"")});document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach(b=>b.classList.toggle("active",b.dataset.lang===next));};
  document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach(b=>b.addEventListener("click",()=>{const next:Lang=b.dataset.lang==="en"?"en":"uk";const u=new URL(location.href);u.searchParams.set("lang",next);history.replaceState({}, "", u.pathname+u.search+u.hash);apply(next)}));
  apply(lang);
