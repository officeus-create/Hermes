---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { directoryCities, repairShopDirectory, type RepairShopDirectoryEntry } from "../../data/repair-shop-directory";
const directoryUrl="https://hermeslogisticsus.com/businesses/";
const schema=[
  {"@context":"https://schema.org","@type":"CollectionPage",name:"Hermes Business Directory",url:directoryUrl,mainEntity:{"@type":"ItemList",itemListElement:repairShopDirectory.map((b: RepairShopDirectoryEntry,i: number)=>({"@type":"ListItem",position:i+1,url:`https://hermeslogisticsus.com/businesses/${b.stateSlug}/${b.citySlug}/${b.slug}/`,name:b.businessName}))}},
  {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Business Directory",item:directoryUrl}]}
];
---
<BaseLayout title="U.S. Business Directory | Hermes" description="Evidence-backed public business profiles with claim status, source notes, and optional Hermes Connect activation." schema={schema}>
<SiteHeader activePath="/paths/technology/" />
<main class="dir"><div class="shell"><header class="hero"><p class="eyebrow">Hermes Business Directory</p><h1>Local businesses, with the evidence boundary visible.</h1><p>Profiles can be discovered before a business becomes a Hermes customer. Unclaimed profiles do not enable booking, impersonate an owner, or imply a commercial relationship.</p></header><section class="how"><p class="eyebrow">How profiles work</p><h2>Discovery first. Owner verification before activation.</h2><p>Hermes separates public business discovery from customer activation. A profile may start from bounded public sources with its claim state and evidence notes visible. An authorized owner can later claim the profile, verify or correct the business details, and decide whether to activate Hermes Connect. Appointment booking, customer records, team scheduling, and other private business tools stay off until that verified activation happens.</p></section><section class="cities"><h2>Browse locations</h2>{directoryCities.map((c: (typeof directoryCities)[number])=><a href={`/businesses/${c.stateSlug}/${c.citySlug}/`}><strong>{c.city}, {c.state}</strong><span>{repairShopDirectory.filter((b: RepairShopDirectoryEntry)=>b.stateSlug===c.stateSlug&&b.citySlug===c.citySlug).length} business profile</span></a>)}</section></div></main><SiteFooter />
</BaseLayout>
<style>.dir{min-height:70vh;background:#f6f7f9;color:#152033}.shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:120px 0 80px}.hero{max-width:850px}.eyebrow{color:#2168a6;text-transform:uppercase;letter-spacing:.11em;font-size:12px;font-weight:900}.hero h1{font-size:clamp(38px,6vw,68px);line-height:1.02;margin:.3rem 0 1rem}.hero p,.how p{color:#657286;line-height:1.7}.how{max-width:860px;margin-top:28px;padding:22px;border:1px solid #e1e6ed;border-radius:16px;background:#fff}.how .eyebrow{margin:0 0 7px}.how h2{margin:0 0 8px;font-size:24px}.how p:last-child{margin:0}.cities{margin-top:36px;display:grid;gap:12px}.cities>a{display:flex;justify-content:space-between;gap:16px;padding:18px;border:1px solid #e1e6ed;border-radius:14px;background:#fff;color:#1e2d40;text-decoration:none}.cities span{color:#718095;font-size:13px}@media(max-width:700px){.shell{padding-top:96px}.cities>a{display:grid}}</style>
