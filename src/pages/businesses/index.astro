---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DirectionProductNav from "../../components/DirectionProductNav.astro";
import HermesPromoRail from "../../components/HermesPromoRail.astro";
import CatalogClientBenefit from "../../components/CatalogClientBenefit.astro";
import MarketingPackageSelector from "../../components/MarketingPackageSelector.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { directoryCities, repairShopDirectory, type RepairShopDirectoryEntry } from "../../data/repair-shop-directory";
import { hermesCatalogOffers, priorityGrowthCities } from "../../data/hermes-catalog-offers";
import { academyCountryRegistry, academyLaunchTracks } from "../../data/academy-country-registry";
import { usStateDirectoryTiles } from "../../data/us-state-directory-map";

const directoryUrl = "https://hermeslogisticsus.com/businesses/";
const stateCounts = new Map<string, number>();
for (const business of repairShopDirectory) stateCounts.set(business.stateSlug, (stateCounts.get(business.stateSlug) ?? 0) + 1);
const categoryCounts = [...new Map(repairShopDirectory.map((business) => [business.category, repairShopDirectory.filter((item) => item.category === business.category).length])).entries()];
const popularTerms = [...new Set(["Website development", "Local SEO", "Hermes Connect CRM", "Load Board", ...repairShopDirectory.flatMap((business) => [business.category, ...business.services])])].slice(0, 9);
const academyLocalizedSamples = academyCountryRegistry.filter((country) => country.localizationState === "launch_ready");
const ecosystem = [
  { id: "logistics", label: "Logistics", title: "Keep business discovery close to real transportation operations.", body: "Repair and service discovery can support carriers, fleets and drivers while Hermes Logistics remains a separate operating relationship.", href: "/paths/logistics/", cta: "Explore Logistics" },
  { id: "technology", label: "IT", title: "Turn a claimed profile into an operating workspace.", body: "Hermes Connect is the activation layer for owner-controlled profiles, appointments, customers, services, teams and booking when those capabilities are verified live.", href: "/services/hermes-connect/", cta: "Open Hermes Connect" },
  { id: "marketing", label: "Marketing", title: "Grow a verified business beyond the free listing.", body: "Claimed businesses can move into website, SEO/GEO, social and demand-generation work without mixing marketing claims into unverified directory facts.", href: "/paths/marketing/", cta: "Explore Marketing" },
  { id: "academy", label: "Academy", title: "Connect business owners and teams with practical learning.", body: "Hermes Academy remains the education layer for logistics, marketing, IT, sales and operations skills rather than being folded into the directory itself.", href: "/paths/academy/", cta: "Explore Academy" },
];
const schema = [
  { "@context": "https://schema.org", "@type": "CollectionPage", name: "Hermes Catalog", alternateName: "Hermes Business Directory", url: directoryUrl, description: "Evidence-backed public business discovery with owner claim state and optional Hermes Connect activation.", mainEntity: { "@type": "ItemList", itemListElement: repairShopDirectory.map((business: RepairShopDirectoryEntry, index: number) => ({ "@type": "ListItem", position: index + 1, url: `https://hermeslogisticsus.com/businesses/${business.stateSlug}/${business.citySlug}/${business.slug}/`, name: business.businessName })) } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Hermes Catalog", item: directoryUrl }] },
];
---
<BaseLayout title="Hermes Catalog | Find Businesses, Services & Locations" description="Search evidence-backed public business profiles by company, service and location. Claim a profile and connect verified business details to Hermes Connect, Marketing, Logistics and Academy." schema={schema}>
  <SiteHeader theme="light" activePath="/businesses/" />
  <DirectionProductNav direction="catalog" theme="light" />

  <main class="catalog-page">
    <div class="shell catalog-shell">
      <header class="catalog-hero">
        <p class="eyebrow">Hermes Catalog</p>
        <h1>Find the right business. Anywhere.</h1>
        <p class="hero-copy">Search the public Hermes business discovery layer by company, service or location. The catalog starts with evidence-backed repair and vehicle-service profiles and expands only when useful source evidence exists.</p>
        <form class="catalog-search" id="catalog-search" data-catalog-search role="search">
          <label>
            <span>What do you need?</span>
            <input type="search" name="q" autocomplete="off" placeholder="Business, service, city or state" data-catalog-input />
          </label>
          <button type="submit">Search Catalog</button>
        </form>
        <div class="popular-searches" aria-label="Popular catalog searches">
          <span>Try:</span>
          {popularTerms.map((term) => <button type="button" data-catalog-query={term}>{term}</button>)}
        </div>
        <p class="catalog-search-count" data-catalog-count>{repairShopDirectory.length + hermesCatalogOffers.length} searchable entries</p>
      </header>

      <HermesPromoRail context="catalog" />
      <CatalogClientBenefit context="catalog" />
      <MarketingPackageSelector />

      <section class="catalog-overview" aria-label="Hermes Catalog scope">
        <article><strong>{repairShopDirectory.length}</strong><span>evidence-backed external business profiles</span></article>
        <article><strong>{hermesCatalogOffers.length}</strong><span>Hermes-owned service entries</span></article>
        <article><strong>110</strong><span>Academy country targets in the expansion registry</span></article>
        <article><strong>{priorityGrowthCities.length}</strong><span>priority global growth cities — not office claims</span></article>
      </section>

      <section class="hermes-services" id="hermes-services" aria-labelledby="hermes-services-title">
        <div class="section-heading"><div><p class="eyebrow">Hermes in the Catalog</p><h2 id="hermes-services-title">Services you can discover and order from Hermes</h2></div><p>These are first-party Hermes services, not third-party business profiles. Each card links to its canonical product or service page.</p></div>
        <div class="service-grid">
          {hermesCatalogOffers.map((offer) => (
            <article class="service-card" data-catalog-card data-search-text={[offer.title, offer.direction, offer.summary, offer.availability, ...offer.tags].join(" ").toLowerCase()}>
              <div class="service-card__top"><span>{offer.direction}</span><span>Hermes service</span></div>
              <h3>{offer.title}</h3><p>{offer.summary}</p>
              <div class="service-tags">{offer.tags.map((tag) => <span>{tag}</span>)}</div>
              <small>{offer.availability}</small><a href={offer.href}>Open service →</a>
            </article>
          ))}
        </div>
      </section>

      <section class="catalog-results" aria-labelledby="catalog-results-title">
        <div class="section-heading">
          <div><p class="eyebrow">Live profiles</p><h2 id="catalog-results-title">Businesses you can discover now</h2></div>
          <p>{repairShopDirectory.length} published business profiles</p>
        </div>
        <div class="business-grid" data-catalog-grid>
          {repairShopDirectory.map((business) => (
            <article class="business-card" data-catalog-card data-search-text={[business.businessName, business.category, business.city, business.state, business.region, ...business.services, ...business.serviceArea].join(" ").toLowerCase()}>
              <div class="business-card__top"><span>{business.category}</span><span>{business.claimState === "claimed" ? "Claimed" : "Unclaimed"}</span></div>
              <h3>{business.businessName}</h3>
              <p>{business.city}, {business.state} · {business.serviceArea[0]}</p>
              <ul>{business.services.slice(0, 4).map((service) => <li>{service}</li>)}</ul>
              <div class="business-card__actions"><a href={`/businesses/${business.stateSlug}/${business.citySlug}/${business.slug}/`}>View profile</a><span>{business.bookingEnabled ? "Online booking available" : "Booking after owner activation"}</span></div>
            </article>
          ))}
        </div>
        <p class="catalog-empty" data-catalog-empty hidden>No live catalog profile matches that search yet. Try a broader service or location.</p>
      </section>

      <section class="catalog-categories" id="categories" aria-labelledby="categories-title">
        <div class="section-heading"><div><p class="eyebrow">Browse by category</p><h2 id="categories-title">Current evidence-backed categories</h2></div><p>Only categories represented by live profiles are shown.</p></div>
        <div class="category-grid">
          {categoryCounts.map(([category, count]) => <button type="button" data-catalog-query={category}><strong>{category}</strong><span>{count} profile{count === 1 ? "" : "s"}</span></button>)}
        </div>
      </section>

      <section class="coverage" id="locations" aria-labelledby="coverage-title">
        <div class="coverage-copy"><p class="eyebrow">Browse by location</p><h2 id="coverage-title">U.S. repair shop coverage map</h2><p>A highlighted state has at least one evidence-backed profile. States without a profile remain research targets and do not generate empty SEO pages.</p><div class="legend"><span class="legend-active">Live Catalog state</span><span class="legend-pending">Research queue</span></div></div>
        <div class="map-scroll"><div class="tile-map" role="img" aria-label="United States tile map showing active Hermes Catalog states">{usStateDirectoryTiles.map((state) => { const count = stateCounts.get(state.slug) ?? 0; const style = `grid-row:${state.row};grid-column:${state.col};`; return count > 0 ? <a class="state-tile active" style={style} href={`/businesses/${state.slug}/`} aria-label={`${state.name}: ${count} business profile`}><strong>{state.abbreviation}</strong><span>{count}</span></a> : <span class="state-tile pending" style={style} title={`${state.name}: research queue`} aria-label={`${state.name}: research queue`}><strong>{state.abbreviation}</strong></span>; })}</div></div>
      </section>

      <section class="global-markets" id="global-markets" aria-labelledby="global-markets-title">
        <div class="section-heading"><div><p class="eyebrow">Global market registry</p><h2 id="global-markets-title">Find your next market. Build your next team.</h2></div><p>The Academy registry contains 110 target countries. Marketing highlights priority cities for remote/selected-market delivery. A country or city becomes its own indexable SEO/GEO page only after real scope, unique value and evidence justify it.</p></div>
        <div class="market-panels">
          <article><span class="market-kicker">Academy expansion</span><strong>110-country target registry</strong><p>Each target market carries a primary local language, optional secondary languages and the same four launch tracks: Logistics, Marketing, Sales and COO / Operations. These are recruitment and training targets, not confirmed local branches or open cohorts everywhere.</p><details><summary>View all 110 target countries + primary language</summary><div class="country-cloud">{academyCountryRegistry.map((country) => <span>{country.country} · {country.primaryLanguage}</span>)}</div></details><a class="catalog-benefit__link" href="/paths/academy/#academy-global-network">Explore international training and team pathways →</a></article>
          <article><span class="market-kicker">Marketing growth markets</span><strong>{priorityGrowthCities.length} priority global cities</strong><p>These cities are commercial targeting priorities for website, SEO/GEO, SMM and growth work delivered remotely or under an approved local scope. They are not claims of a Hermes office.</p><div class="city-cloud">{priorityGrowthCities.map((city) => <span>{city}</span>)}</div></article>
        </div>
        <div class="academy-country-contract" aria-label="Academy country localization contract">
          <div><span class="market-kicker">Country launch contract</span><h3>Local language first. One Academy truth underneath.</h3><p>Country pages do not invent a local office. A localized page can explain the training path, application, practice model and possible next roles in the market language while reusing the same canonical Academy curriculum and human-review boundaries.</p><div class="track-cloud">{academyLaunchTracks.map((track) => <span>{track === "operations" ? "COO / Operations" : track[0].toUpperCase() + track.slice(1)}</span>)}</div></div>
          <div><span class="market-kicker">Publication gate</span><h3>Compliance, payment and useful content before indexing.</h3><p>Every country remains registry-only until current sanctions/compliance screening, an available payment or invoicing path, an approved cohort/application route, native-language QA and unique useful content are all verified. Registration targets are not automatically sales-approved markets.</p></div>
        </div>
        <div class="localized-country-grid" aria-label="Localized Academy country examples">
          {academyLocalizedSamples.map((country) => <article data-country-sample={country.slug}><div><span>{country.country}</span><small>{country.primaryLanguage}{country.secondaryLocales.length ? ` · + ${country.secondaryLocales.join(", ")}` : ""}</small></div><h3 lang={country.primaryLocale}>{country.localizedHeadline}</h3><p lang={country.primaryLocale}>{country.localizedBody}</p><footer><span>Localized Academy page live</span><span>Commercial terms reviewed at application</span></footer><a class="country-open" href={`/academy/countries/${country.slug}/`}>Open {country.primaryLanguage} Academy page →</a></article>)}
        </div>
        <p class="country-source-note">Future localized lesson/examples may be adapted from approved Hermes training and recruiting evidence, including historical Telegram/email/work sources, only after anonymization, current-fact reconciliation and privacy review. Raw candidate messages, personal data and unverified employment promises do not become public SEO content.</p>
      </section>

      <section class="cities" aria-labelledby="cities-title"><div class="section-heading"><div><p class="eyebrow">Live locations</p><h2 id="cities-title">Browse cities with published profiles</h2></div></div>{directoryCities.map((city: (typeof directoryCities)[number]) => <a href={`/businesses/${city.stateSlug}/${city.citySlug}/`}><strong>{city.city}, {city.state}</strong><span>{repairShopDirectory.filter((business: RepairShopDirectoryEntry) => business.stateSlug === city.stateSlug && business.citySlug === city.citySlug).length} business profile</span></a>)}</section>

      <section class="owner-panel" id="business-owners" aria-labelledby="business-owner-title">
        <div><p class="eyebrow">Own a business?</p><h2 id="business-owner-title">Start free. Claim only what is yours.</h2><p>A public profile can exist before a business becomes a Hermes customer. An authorized owner can verify or correct the public facts and then independently decide whether to activate Hermes Connect or any paid growth service.</p></div>
        <div class="owner-actions"><a class="primary" href="/businesses/request/?type=add">Add your business free</a><a href="#catalog-search">Find and claim an existing profile</a><a href="/businesses/request/?type=catalog-growth">Request Catalog SEO / GEO</a><a href="/services/hermes-connect/?source=catalog">Connect your business</a></div>
        <ol class="catalog-funnel" aria-label="Hermes Catalog business path"><li>Free listing</li><li>Claim profile</li><li>Hermes Connect</li><li>Enhanced Catalog</li><li>SEO / GEO</li><li>Website</li><li>Sponsored position</li></ol>
      </section>

      <section class="hermes-ecosystem" id="hermes-ecosystem" aria-labelledby="ecosystem-title">
        <div class="section-heading"><div><p class="eyebrow">Connected across Hermes</p><h2 id="ecosystem-title">Catalog is the discovery layer. The four directions stay distinct.</h2></div><p>Useful internal paths connect discovery to the next real need without turning Catalog into a fifth business direction.</p></div>
        <div class="ecosystem-grid">
          {ecosystem.map((item) => <article id={`catalog-${item.id}`}><span>{item.label}</span><h3>{item.title}</h3><p>{item.body}</p><a href={item.href}>{item.cta} →</a></article>)}
        </div>
      </section>

      <section class="how"><p class="eyebrow">How profiles work</p><h2>Discovery first. Owner verification before activation.</h2><p>Hermes separates public business discovery from customer activation. A profile may start from bounded public sources with its claim state and evidence notes visible. An authorized owner can later claim the profile, verify or correct the business details, and decide whether to activate Hermes Connect. Appointment booking, customer records, team scheduling, and other private business tools stay off until that verified activation happens.</p></section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-catalog-search]");
  const input = document.querySelector<HTMLInputElement>("[data-catalog-input]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-catalog-card]")];
  const count = document.querySelector<HTMLElement>("[data-catalog-count]");
  const empty = document.querySelector<HTMLElement>("[data-catalog-empty]");
  const normalize = (value: string) => value.trim().toLowerCase();
  const applySearch = (rawQuery: string) => {
    const query = normalize(rawQuery);
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || (card.dataset.searchText ?? "").includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (count) count.textContent = `${visible} searchable entr${visible === 1 ? "y" : "ies"}`;
    if (empty) empty.hidden = visible !== 0;
  };
  form?.addEventListener("submit", (event) => { event.preventDefault(); applySearch(input?.value ?? ""); });
  input?.addEventListener("input", () => applySearch(input.value));
  document.querySelectorAll<HTMLButtonElement>("[data-catalog-query]").forEach((button) => button.addEventListener("click", () => {
    const query = button.dataset.catalogQuery ?? "";
    if (input) input.value = query;
    applySearch(query);
    document.querySelector("#catalog-search")?.scrollIntoView({ behavior: "smooth", block: "center" });
  }));
</script>

<style>
  .catalog-page{min-height:70vh;background:#f5f7fa;color:#152033}.catalog-shell{width:min(1160px,calc(100% - 2rem));margin:auto;padding:112px 0 88px}.eyebrow{margin:0 0 8px;color:#2168a6;text-transform:uppercase;letter-spacing:.11em;font-size:11px;font-weight:900}.catalog-hero{max-width:980px}.catalog-hero h1{max-width:900px;margin:.2rem 0 1rem;font-size:clamp(44px,7vw,78px);line-height:.98;letter-spacing:-.045em}.hero-copy{max-width:820px;color:#657286;line-height:1.7;font-size:clamp(16px,1.6vw,19px)}.catalog-search{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;margin-top:30px;padding:9px;border:1px solid #d8e1eb;border-radius:18px;background:#fff;box-shadow:0 20px 55px rgba(34,68,103,.09)}.catalog-search label{display:grid;gap:5px;padding:5px 10px}.catalog-search label span{color:#728197;font-size:10px;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.catalog-search input{width:100%;border:0;outline:0;background:transparent;color:#152033;font:inherit;font-size:17px}.catalog-search button,.owner-actions .primary{border:0;border-radius:12px;background:#152033;color:#fff;font-weight:850;cursor:pointer}.catalog-search button{min-width:150px;padding:0 18px}.popular-searches{display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin-top:13px;color:#768398;font-size:12px}.popular-searches button,.category-grid button{border:1px solid #dbe3ec;background:#fff;color:#315676;cursor:pointer}.popular-searches button{padding:7px 10px;border-radius:999px;font-size:11px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:24px}.section-heading h2{margin:0;font-size:clamp(28px,4vw,42px);letter-spacing:-.035em}.section-heading>p,.section-heading>div>p:last-child{max-width:520px;color:#6d7b8e;line-height:1.55}.catalog-results,.catalog-categories,.coverage,.cities,.owner-panel,.hermes-ecosystem,.how,.hermes-services,.global-markets{scroll-margin-top:160px;margin-top:48px}.catalog-search-count{margin:10px 0 0;color:#758397;fo