---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {konsNaBisClient as client} from "../../../../data/catalog-client-kons-na-bis";
---
<BaseLayout title="Конс на Бі$ — Hermes Catalog concept" description="Noindex demo concept for a business academy and club." robots="noindex,nofollow" locale="uk" htmlLang="uk">
<main id="main-content" class="knb-page">
  <div class="knb-top">
    <a href="/businesses/">← Hermes Catalog</a>
    <div class="knb-lang" aria-label="Language"><button type="button" class="active" data-lang="uk">UA</button><button type="button" data-lang="en">EN</button></div>
  </div>
  <p class="knb-kicker" data-i18n="kicker">Hermes Catalog · client concept · це не офіційний сайт бізнесу</p>
  <h1>Конс на Бі$<br><span>Academy × CRM</span></h1>
  <p class="knb-lead" data-i18n="lead">{client.programmeName}: каталог, воронка заявок, навчальний прогрес, аналітика та retention в одному демонстраційному контурі.</p>

  <section class="knb-grid">
    <article><b>01</b><h2 data-i18n="t1">7-тижнева програма</h2><p data-i18n="d1">Уроки, завдання, щотижневі розбори, VIP-сесії та записи.</p></article>
    <article><b>02</b><h2>Sales CRM</h2><p data-i18n="d2">Теплі заявки → консультація → рішення → зарахування → клуб.</p></article>
    <article><b>03</b><h2>Marketing KPI</h2><p data-i18n="d3">Funnel, CAC, LTV, ROMI та revenue attribution без вигаданих цифр.</p></article>
    <article><b>04</b><h2>Academy Operations</h2><p data-i18n="d4">Cohorts, assignments, reviews, attendance, recordings, next action.</p></article>
  </section>

  <section class="knb-path">
    <p class="knb-kicker">HERMES CONNECT PATH</p>
    <h2 data-i18n="pathTitle">Як це має працювати для клієнта.</h2>
    <div>
      <span data-i18n="p1">1. Побачити бізнес у Catalog</span><b>→</b>
      <span data-i18n="p2">2. Зареєструвати Hermes account</span><b>→</b>
      <span data-i18n="p3">3. Підтвердити профіль академії</span><b>→</b>
      <span data-i18n="p4">4. Відкрити Academy CRM</span>
    </div>
  </section>

  <div class="knb-actions">
    <a class="primary" href="/services/hermes-connect/academy/business/auth/?mode=register&source=catalog&business=kons-na-bis&lang=uk" data-language-route data-i18n="register">Зареєструвати / відкрити Academy CRM →</a>
    <a href="/demos/hermes-connect/academy-knb.html" data-i18n="demo">Переглянути CRM demo →</a>
    <a href={client.programmeUrl} target="_blank" rel="noopener noreferrer" data-i18n="official">Офіційна програма ↗</a>
  </div>

  <p class="knb-boundary" data-i18n="boundary">Це демонстраційна структура. Реєстрація, owner claim, оплата та публічна активація клієнта не вважаються завершеними без дії самого власника.</p>
</main>
<script>
const d={
uk:{kicker:"Hermes Catalog · client concept · це не офіційний сайт бізнесу",lead:"Стратегія керованого зростання у бізнесі: каталог, воронка заявок, навчальний прогрес, аналітика та retention в одному демонстраційному контурі.",t1:"7-тижнева програма",d1:"Уроки, завдання, щотижневі розбори, VIP-сесії та записи.",d2:"Теплі заявки → консультація → рішення → зарахування → клуб.",d3:"Funnel, CAC, LTV, ROMI та revenue attribution без вигаданих цифр.",d4:"Cohorts, assignments, reviews, attendance, recordings, next action.",pathTitle:"Як це має працювати для клієнта.",p1:"1. Побачити бізнес у Catalog",p2:"2. Зареєструвати Hermes account",p3:"3. Підтвердити профіль академії",p4:"4. Відкрити Academy CRM",register:"Зареєструвати / відкрити Academy CRM →",demo:"Переглянути CRM demo →",official:"Офіційна програма ↗",boundary:"Це демонстраційна структура. Реєстрація, owner claim, оплата та публічна активація клієнта не вважаються завершеними без дії самого власника."},
en:{kicker:"Hermes Catalog · client concept · this is not the business's official website",lead:"Managed Business Growth Strategy: catalog discovery, lead pipeline, learner progress, analytics, and retention in one demo structure.",t1:"7-week program",d1:"Lessons, assignments, weekly reviews, VIP sessions, and recordings.",d2:"Warm leads → consultation → decision → enrollment → club.",d3:"Funnel, CAC, LTV, ROMI, and revenue attribution without fabricated metrics.",d4:"Cohorts, assignments, reviews, attendance, recordings, and next action.",pathTitle:"How the client path should work.",p1:"1. Find the business in Catalog",p2:"2. Create a Hermes account",p3:"3. Confirm the academy profile",p4:"4. Open Academy CRM",register:"Register / open Academy CRM →",demo:"View CRM demo →",official:"Official program ↗",boundary:"This is a demo structure. Registration, owner claim, billing, and public client activation are not treated as complete without an action by the owner."}
};
type Lang = "uk" | "en";
type TranslationKey = keyof typeof d.uk;
let lang: Lang = "uk";
try {
  const saved = localStorage.getItem("hermes-connect-language");
  if (saved === "en") lang = "en";
} catch {}
function apply(next: Lang) {
  lang = next;
  document.documentElement.lang = next;
  try { localStorage.setItem("hermes-connect-language", next); } catch {}
  document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((node) => {
    const key = node.dataset.i18n as TranslationKey | undefined;
    if (!key) return;
    const value = d[next][key];
    if (value) node.textContent = value;
  });
  document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach((button) => {
    button.classList.toggle("active", button.dataset.lang === next);
  });
  document.querySelectorAll<HTMLAnchorElement>("[data-language-route]").forEach((link) => {
    const url = new URL(link.getAttribute("href") || "/", window.location.origin);
    url.searchParams.set("lang", next);
    link.href = url.pathname + url.search + url.hash;
  });
}
document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach((button) => {
  button.addEventListener("click", () => apply(button.dataset.lang === "en" ? "en" : "uk"));
});
apply(lang);
</script>
<style>
.knb-page{max-width:1180px;margin:auto;padding:38px 24px 70px;font-family:Inter,system-ui;color:#182033}.knb-top{display:flex;justify-content:space-between;align-items:center;gap:16px}.knb-top>a{text-decoration:none;font-weight:800}.knb-lang{display:flex;padding:3px;border:1px solid #dce2e9;border-radius:999px}.knb-lang button{border:0;background:transparent;border-radius:999px;padding:7px 10px;font-weight:900;cursor:pointer}.knb-lang button.active{background:#182033;color:#fff}.knb-kicker{margin-top:34px;font-size:12px;text-transform:uppercase;letter-spacing:.09em;color:#6a548f;font-weight:850}.knb-page h1{font-size:clamp(48px,8vw,96px);line-height:.94;margin:28px 0}.knb-page h1 span{color:#6a548f}.knb-lead{font-size:22px;line-height:1.55;max-width:820px;color:#59697c}.knb-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px;margin:42px 0}.knb-grid article{border:1px solid #dde3ea;border-radius:18px;padding:22px;background:#fff}.knb-grid b{color:#6a548f}.knb-grid h2{font-size:21px}.knb-grid p{color:#64748b;line-height:1.6}.knb-path{padding:28px;border-radius:22px;background:#f5f2fa}.knb-path h2{font-size:30px;margin:8px 0 22px}.knb-path>div{display:flex;align-items:center;flex-wrap:wrap;gap:10px}.knb-path span{padding:11px 13px;border-radius:12px;background:#fff;font-weight:750}.knb-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.knb-actions a{padding:14px 18px;border:1px solid #182033;border-radius:10px;text-decoration:none;font-weight:800}.knb-actions .primary{background:#182033;color:#fff}.knb-boundary{margin-top:38px;padding:16px;border-radius:14px;background:#fff7ed;color:#7c2d12;line-height:1.6}
</style>
</BaseLayout>
