---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {konsNaBisClient as client} from "../../../../data/catalog-client-kons-na-bis";

const observedAt = "2026-10-01";
const socialSnapshot = [
  { label: "Instagram", value: "77.1K", detail: "followers", entity: "company_channel", observedAt, href: "https://www.instagram.com/konsnabis/" },
  { label: "YouTube · Oleksandr", value: "64.2K", detail: "subscribers · 1.3K videos", entity: "personal_brand", observedAt, href: "https://www.youtube.com/@Oleksandr_Morozov_KnB" },
  { label: "TikTok", value: "19.6K", detail: "followers · 163.1K likes", entity: "company_channel", observedAt, href: "https://www.tiktok.com/@konsnabis" },
  { label: "Threads", value: "5,971", detail: "followers · 845 threads", entity: "company_channel", observedAt, href: "https://www.threads.com/@konsnabis" },
  { label: "Facebook", value: "85.7K", detail: "followers · public metadata snapshot", entity: "company_channel", observedAt, href: "https://www.facebook.com/konsnabis/" },
];

const instagramAudit = [
  {
    titleUk: "Сильна база уваги",
    titleEn: "Strong attention base",
    bodyUk: "Велика аудиторія, активний short-form контент, кейси, highlights і зрозуміла тематика для власників бізнесу.",
    bodyEn: "Large audience, active short-form publishing, cases, highlights, and a clear business-owner theme.",
    state: "strength",
  },
  {
    titleUk: "CTA фрагментовані",
    titleEn: "CTA fragmentation",
    bodyUk: "У bio — слово «сертифікат», у частині постів — «+» у Direct, в інших — загальне «долучайтесь». Це ускладнює чисту атрибуцію й порівняння конверсій.",
    bodyEn: "The bio uses the keyword “certificate”, some posts ask for “+” in DM, while others use generic join CTAs. That makes clean attribution and conversion comparison harder.",
    state: "gap",
  },
  {
    titleUk: "Контент є, але потрібна stage-логіка",
    titleEn: "Content needs stage logic",
    bodyUk: "Останні публікації охоплюють сильні болі — стагнація, партнери, сезонність, контент, впровадження. Їх варто розкласти за Awareness → Consideration → Proof → Conversion.",
    bodyEn: "Recent posts cover strong pains—stagnation, partners, seasonality, content, implementation. They should be mapped to Awareness → Consideration → Proof → Conversion.",
    state: "gap",
  },
  {
    titleUk: "Обсяг не дорівнює результату",
    titleEn: "Volume is not the outcome",
    bodyUk: "Висока частота публікацій має сенс лише разом із source/creative/CTA attribution та downstream CRM: qualified lead, consultation, sale, cohort, renewal.",
    bodyEn: "High publishing cadence only matters when source/creative/CTA attribution connects to downstream CRM: qualified lead, consultation, sale, cohort, renewal.",
    state: "gap",
  },
];

const funnel = [
  ["01","CONTENT","Problem / case / insight"],
  ["02","CTA","One trackable action per asset"],
  ["03","DIAGNOSTIC","Existing free business diagnostic → 6 risk lenses"],
  ["04","CRM","Source + pain + business stage"],
  ["05","CONSULTATION","Gap review + fit"],
  ["06","OFFER","7-week program"],
  ["07","DELIVERY","Cohort + assignments + reviews"],
  ["08","OUTCOME","Baseline → actual"],
  ["09","RENEWAL","Club / next program"],
];

const programMap = [
  ["W1","Marketing","Acquisition / positioning / customer flow"],
  ["W2","Key business metrics","Baseline / conversion / economics"],
  ["W3","Hiring system","People / delegation / capacity"],
  ["W4","Facebook system","Paid/social channel execution"],
  ["W5","Instagram system","Content / social monetization"],
  ["W6","Sales system","Consultation / conversion / average check"],
  ["W7","Online packaging","Website / landing / online conversion"],
];

const measurement = [
  ["1","Qualified attention","Reach / views from the intended owner audience"],
  ["2","Lead action","DM / form / diagnostic starts by campaign"],
  ["3","Qualified lead","Business owner + fit + defined problem"],
  ["4","Consultation","Booked → attended → qualified"],
  ["5","Sale","Consultation → paid program + attributed revenue"],
  ["6","Unit economics","CAC · LTV / renewal · ROMI where source data exists"],
];

const firstMoves = [
  ["0–7 days","Instrument","One campaign_id, UTM/keyword convention, CRM source fields, one primary CTA per asset, baseline dashboard."],
  ["8–30 days","Learn","Content matrix by pain × funnel stage; weekly winner/loser review; consultation script tied to diagnostic outputs."],
  ["31–90 days","Scale","Retarget proven audiences, expand winning hooks, connect cohort outcomes and renewal to original acquisition source."],
];

const channelPlan = [
  ["Instagram","Core short-form","Pain hooks → cases → proof → one diagnostic CTA per asset."],
  ["TikTok","Hook laboratory","Test angles quickly; move qualified interest into the same trackable diagnostic path."],
  ["YouTube / Podcast","Depth + searchable trust","Answer complex owner questions, teach the method, then hand off to a trackable consultation/diagnostic."],
  ["Threads","Hypothesis engine","Fast opinions, questions and objections that feed the content backlog and sales FAQ."],
  ["Telegram","Nurture + retention","Continue the relationship after the first signal; cohort, event and renewal communication with source history preserved."],
  ["Facebook","Paid / retarget / proof","Use only with defined audience, creative hypothesis, landing/diagnostic route and downstream CRM attribution."],
];

const proofObservations = [
  ["UA homepage","150 000+ event participants · 10 000+ base-program graduates","Current public homepage snapshot"],
  ["7-week program page","50 000+ seminar participants · 5 000+ base-program graduates","Current public program-page snapshot"],
  ["RU homepage","50 000+ event participants · 7 500+ base-program graduates","Current Russian homepage snapshot"],
  ["About page","30 000+ community · 1 200+ audits/year · 500+ group-coaching participants","Different populations; requires definitions, not forced reconciliation"],
];

const sources = [
  {label:"Instagram @konsnabis",href:"https://www.instagram.com/konsnabis/"},
  {label:"TikTok @konsnabis",href:"https://www.tiktok.com/@konsnabis"},
  {label:"Threads @konsnabis",href:"https://www.threads.com/@konsnabis"},
  {label:"YouTube · Oleksandr Morozov",href:"https://www.youtube.com/@Oleksandr_Morozov_KnB"},
  {label:"KNB official site",href:"https://kons-na-bis.com/"},
  {label:"7-week program",href:client.programmeUrl},
  {label:"KNB Ukrainian homepage · current proof/offer",href:"https://kons-na-bis.com/"},
  {label:"KNB About · community/audit signals",href:"https://kons-na-bis.com/pro-proekt/"},
  {label:"KNB podcast · CRM / managers / customer base",href:"https://podcasts.apple.com/ua/podcast/%D0%BA%D0%BE%D0%BD%D1%81-%D0%BD%D0%B0-%D0%B1%D1%96%24-%D0%B0%D1%83%D0%B4%D1%96%D0%BE%D0%B2%D0%B8%D0%BF%D1%83%D1%81%D0%BA-%D0%BF%D1%80%D0%BE-%D0%B1%D1%96%D0%B7%D0%BD%D0%B5%D1%81-%D0%B4%D0%BB%D1%8F-%D0%BF%D1%96%D0%B4%D0%BF%D1%80%D0%B8%D1%94%D0%BC%D1%86%D1%96%D0%B2/id1894323259"},
];
---
<BaseLayout title="Конс на Бі$ — Marketing Growth Case | Hermes Catalog" description="Noindex Hermes Catalog client concept: public-source social audit, measurable funnel, Academy CRM map and candidate assessment example." robots="noindex,nofollow" locale="uk" htmlLang="uk">
<main id="main-content" class="knb-page">
  <div class="knb-top">
    <a href="/businesses/">← Hermes Catalog</a>
    <div class="knb-lang" aria-label="Language"><button type="button" class="active" data-lang="uk">UA</button><button type="button" data-lang="en">EN</button></div>
  </div>

  <section class="knb-hero">
    <p class="knb-kicker" data-i18n="kicker">Hermes Catalog · client strategy concept · не офіційний сайт КНБ</p>
    <h1>Конс на Бі$<br><span>Social → CRM → Revenue</span></h1>
    <p class="knb-lead" data-i18n="lead">Відповідь на реальний marketing-assessment: не просто аудит соцмережі, а вимірювана система залучення для 7-тижневої програми з прив’язкою до Academy CRM.</p>
    <div class="knb-hero-actions">
      <a class="primary" href="#audit" data-i18n="seeAudit">Дивитися аудит</a>
      <a href="#funnel" data-i18n="seeFunnel">Дивитися funnel</a>
      <a href="/demos/hermes-connect/academy-knb.html" data-language-route data-i18n="openDemo">Відкрити CRM demo</a>
    </div>
    <p class="knb-date"><span data-i18n="snapshot">Public-source snapshot</span> · {observedAt}</p>
  </section>

  <section class="knb-social" aria-labelledby="social-title">
    <div class="knb-section-head">
      <div><p class="knb-kicker">PUBLIC FOOTPRINT</p><h2 id="social-title" data-i18n="socialTitle">Аудиторія вже є. Завдання — зв’язати її з результатом.</h2></div>
      <p data-i18n="socialCopy">Публічні цифри — лише snapshot, не доказ продажів. Для управління потрібен ланцюг від конкретного content asset до CRM outcome.</p>
    </div>
    <div class="knb-social-grid">
      {socialSnapshot.map((item)=><a href={item.href} target="_blank" rel="noopener noreferrer"><small>{item.label}</small><strong>{item.value}</strong><span>{item.detail}</span><em>{item.entity === "personal_brand" ? "personal brand" : "company channel"} · observed {item.observedAt}</em></a>)}
    </div>
  </section>

  <section class="knb-panel" id="audit">
    <div class="knb-section-head">
      <div><p class="knb-kicker">TASK 1 · INSTAGRAM AUDIT</p><h2 data-i18n="auditTitle">Що я б змінив одразу як керівник напряму.</h2></div>
      <a href="https://www.instagram.com/konsnabis/" target="_blank" rel="noopener noreferrer">@konsnabis ↗</a>
    </div>
    <div class="knb-audit-grid">
      {instagramAudit.map((item)=><article class:list={[item.state==="strength"?"strength":"gap"]}><span>{item.state==="strength"?"STRENGTH":"OPPORTUNITY"}</span><h3 data-uk={item.titleUk} data-en={item.titleEn}>{item.titleUk}</h3><p data-uk={item.bodyUk} data-en={item.bodyEn}>{item.bodyUk}</p></article>)}
    </div>
    <div class="knb-evidence-note" data-i18n="recentEvidence">У свіжих Instagram-публікаціях 30.09–01.10 видно кілька різних conversion-механік: «+» у Direct, безкоштовна консультація, загальне «долучайтесь»; у bio — окремий keyword «сертифікат». Public logged-out readback не дає надійних likes/views для цього sample, тому ми не вигадуємо engagement rate або «winner». Для creative ranking потрібне дозволене підключення Instagram Insights.</div>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">HEAD OF MARKETING · OPERATING SYSTEM</p><h2 data-i18n="channelTitle">Що я б запустив одразу: не шість окремих соцмереж, а одну систему ролей каналів.</h2></div></div>
    <div class="knb-channel-plan">
      {channelPlan.map(([channel,role,copy])=><article><span>{channel}</span><b>{role}</b><small>{copy}</small></article>)}
    </div>
    <p class="knb-note" data-i18n="channelCopy">Один content idea може мати різні формати, але не різні customer identities. Source asset, CTA і campaign переходять у CRM; Telegram, form або consultation доповнюють історію, а не створюють нового lead.</p>
  </section>

  <section class="knb-panel" id="funnel">
    <div class="knb-section-head">
      <div><p class="knb-kicker">TASK 2 · 7-WEEK PROGRAM FUNNEL</p><h2 data-i18n="funnelTitle">Один funnel від уваги до renewal.</h2></div>
      <span class="knb-pill" data-i18n="program">Стратегія керованого зростання у бізнесі</span>
    </div>
    <div class="knb-funnel">
      {funnel.map(([n,t,d])=><div><span>{n}</span><b>{t}</b><small>{d}</small></div>)}
    </div>

    <div class="knb-offer">
      <div>
        <p class="knb-kicker">RECOMMENDED OFFER</p>
        <h3 data-i18n="offerTitle">Підсилити вже існуючу безкоштовну діагностику бізнесу: 6 зон ризику + персональна карта перших 3 дій.</h3>
        <p data-i18n="offerCopy">Не створювати ще один lead magnet і не вести social traffic одразу в дисконт. КНБ уже використовує безкоштовну діагностику; її варто зробити canonical entry offer: визначити головний gap, зафіксувати baseline, дати 3 наступні дії та лише після цього показати, чи підходить 7-тижнева програма і який модуль закриває проблему.</p>
      </div>
      <aside>
        <strong data-i18n="whyOffer">Чому цей оффер</strong>
        <ul>
          <li data-i18n="why1">не вигадує новий asset — підсилює те, що КНБ уже використовує;</li>
          <li data-i18n="why2">дає користь до покупки і підвищує довіру;</li>
          <li data-i18n="why3">перетворює діагностику на структуровані CRM-дані для sales;</li>
          <li data-i18n="why4">дозволяє порівняти entry offers і сегментувати follow-up.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">DIAGNOSTIC → PROGRAM FIT</p><h2 data-i18n="mapTitle">Діагностика має одразу показувати, який блок програми закриває головний gap.</h2></div></div>
    <div class="knb-program-map">
      {programMap.map(([week,title,signal])=><article><span>{week}</span><div><b>{title}</b><small>{signal}</small></div></article>)}
    </div>
    <p class="knb-note" data-i18n="mapCopy">CRM зберігає primary gap, рекомендований module і reason-to-believe. Sales-менеджер бачить не просто «lead from Instagram», а контекст: що болить, який baseline і чому конкретний блок програми може бути релевантним.</p>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">MEASUREMENT</p><h2 data-i18n="measurementTitle">Шість контрольних показників замість vanity metrics.</h2></div></div>
    <div class="knb-metrics">
      {measurement.map(([n,t,d])=><article><span>{n}</span><div><b>{t}</b><small>{d}</small></div></article>)}
    </div>
    <p class="knb-note" data-i18n="metricBoundary">Нуль не підставляється замість відсутніх даних. CAC/LTV/ROMI з’являються тільки після підключення витрат, CRM revenue і правил attribution.</p>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">DIAGNOSTIC LENSES · PROVIDED TRAINING</p><h2 data-i18n="riskTitle">Шість зон, де маркетинг може втрачати гроші ще до funnel optimization.</h2></div><a href="https://www.youtube.com/watch?v=umD_Ho4xRj0" target="_blank" rel="noopener noreferrer">Training source ↗</a></div>
    <p data-i18n="riskCopy">Наданий тренінг описує не шість KPI, а шість груп ризику. Ми використовуємо їх як diagnostic lenses, а окремо рахуємо outcome-метрики в CRM.</p>
    <div class="knb-risk-grid">
      <article><span>01</span><b data-i18n="risk1">Overthinking / ускладнення</b><small data-i18n="risk1c">Чи не створюємо процес, контент або funnel складнішими, ніж потрібно для рішення клієнта.</small></article>
      <article><span>02</span><b data-i18n="risk2">Data</b><small data-i18n="risk2c">Чи є baseline, source quality, conversion data і чи відрізняємо unknown від zero.</small></article>
      <article><span>03</span><b data-i18n="risk3">Assumptions / «mind games»</b><small data-i18n="risk3c">Чи перевіряємо гіпотези експериментом, а не пояснюємо результат заднім числом.</small></article>
      <article><span>04</span><b data-i18n="risk4">Marketing tactics</b><small data-i18n="risk4c">Чи відповідає інструмент стадії funnel, продукту й аудиторії, а не просто тренду.</small></article>
      <article><span>05</span><b data-i18n="risk5">ROI</b><small data-i18n="risk5c">Чи зв’язана активність із qualified inquiry, sale, revenue і cost.</small></article>
      <article><span>06</span><b data-i18n="risk6">Human capital</b><small data-i18n="risk6c">Чи є owner, компетенція, review loop і відповідальність за наступну дію.</small></article>
    </div>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">MINDMAP</p><h2 data-i18n="mindmapTitle">Контент має закінчуватися не охопленням, а наступною дією.</h2></div></div>
    <div class="knb-mindmap">
      <b>Instagram / TikTok / Threads / YouTube / Facebook</b><i>→</i>
      <b data-i18n="painCluster">Pain / case cluster</b><i>→</i>
      <b>Trackable CTA</b><i>→</i>
      <b>6-point Diagnostic</b><i>→</i>
      <b>Hermes / Client CRM</b><i>→</i>
      <b>Consultation</b><i>→</i>
      <b>7-week Program</b><i>→</i>
      <b>Cohort delivery</b><i>→</i>
      <b>Outcome + Renewal</b>
    </div>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">0–90 DAY OPERATING PLAN</p><h2 data-i18n="planTitle">Спочатку вимірювання, потім масштаб.</h2></div></div>
    <div class="knb-plan">{firstMoves.map(([window,title,body])=><article><span>{window}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">ORGANIZATION SIGNALS · CURRENT VACANCIES</p><h2 data-i18n="orgTitle">CRM-структура випливає з того, як бізнес уже організовує marketing, sales і HR.</h2></div></div>
    <div class="knb-org-grid">
      <article><span>MARKETING</span><b data-i18n="orgMarketing">CMO · масштабування системи</b><small data-i18n="orgMarketingCopy">Публічна вакансія описує готову команду, інфраструктуру й діючі канали; фокус керівника — масштабування та вплив marketing на revenue/profit.</small><a href="https://robota.ua/company4890229/vacancy11308040" target="_blank" rel="noopener noreferrer">Source ↗</a></article>
      <article><span>SALES</span><b data-i18n="orgSales">Head of Sales · 4 рівні</b><small data-i18n="orgSalesCopy">Вакансія прямо описує 4-рівневу sales-систему та управління керівниками, тому CRM має підтримувати hierarchy, plan, conversion і next action.</small><a href="https://alliance-desktop.robota.ua/ru/company4890229/vacancy11308016" target="_blank" rel="noopener noreferrer">Source ↗</a></article>
      <article><span>CONSULTATION</span><b data-i18n="orgManager">Sales manager · warm lead → decision</b><small data-i18n="orgManagerCopy">Консультація, виявлення потреби, program fit, ведення до рішення, personal plan і CRM reporting — це ядро sales pipeline.</small><a href="https://robota.ua/ru/company4890229/vacancy11224797" target="_blank" rel="noopener noreferrer">Source ↗</a></article>
      <article><span>HR</span><b data-i18n="orgHr">Recruiter · selection → adaptation</b><small data-i18n="orgHrCopy">Первинна комунікація, interview, candidate stages, потенціал/culture review та adaptation підтверджують окремий recruiting workflow.</small><a href="https://robota.ua/company4890229/vacancy11342667" target="_blank" rel="noopener noreferrer">Source ↗</a></article>
    </div>
  </section>

  <section class="knb-panel knb-crm">
    <div class="knb-section-head">
      <div><p class="knb-kicker">HERMES CONNECT · ACADEMY CRM</p><h2 data-i18n="crmTitle">Що має потрапляти в CRM з маркетингу.</h2></div>
      <a href="/services/hermes-connect/academy/business/auth/?mode=register&source=catalog&business=kons-na-bis&lang=uk" data-language-route data-i18n="register">Зареєструвати / відкрити Academy CRM →</a>
    </div>
    <div class="knb-crm-fields">
      {["source_channel","content_id","campaign_id","CTA / keyword","entry_offer","primary pain","diagnostic_primary_gap","baseline","recommended_module","reason_to_believe","business stage","manager","consultation status","program fit","objection","sale / revenue","cohort","completion","renewal"].map((field)=><span>{field}</span>)}
    </div>
    <p data-i18n="crmCopy">Одна людина не повинна ставати новим контактом при переході Instagram → Telegram → consultation. CRM зберігає один lead/customer identity та історію каналів.</p>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">HIRING SYSTEM</p><h2 data-i18n="hiringTitle">Те саме тестове — як reusable Candidate Assessment у CRM.</h2></div></div>
    <p data-i18n="hiringCopy">Brief, deadline, джерела, Google Docs/MindMap submission, rubric, reviewer score та human decision зберігаються в Candidate Assessment. Це окремо від learner progress і не створює автоматичних кадрових рішень.</p>
    <div class="knb-assessment-brief">
      <article><small data-i18n="briefIssued">Brief received</small><strong>01.10.2026 · 18:24</strong></article>
      <article><small data-i18n="briefDeadline">Deadline</small><strong>02.10.2026 · 09:00</strong></article>
      <article><small data-i18n="briefFormat">Submission format</small><strong>Google Docs + MindMap / scheme</strong></article>
      <article><small data-i18n="briefScope">Scope</small><strong>Social audit + 7-week funnel + offer</strong></article>
    </div>
    <div class="knb-assessment">
      <span>Evidence & diagnosis · 0–5</span><span>Audience & positioning · 0–5</span><span>Funnel logic · 0–5</span><span>Offer quality · 0–5</span><span>KPI & measurement · 0–5</span><span>Execution thinking · 0–5</span>
    </div>
  </section>

  <section class="knb-panel knb-form-review">
    <div class="knb-section-head"><div><p class="knb-kicker">CANDIDATE INTAKE · FORM REVIEW</p><h2 data-i18n="formTitle">Менше особистих питань — більше evidence, яке прогнозує робочу якість.</h2></div><span class="knb-pill" data-i18n="formReference">Google Form · reference only · not submitted</span></div>
    <p data-i18n="formCopy">Надана анкета змішує contact/social data, мотивацію, career questions і особисті/lifestyle питання. Для marketing-role наш default intake робить коротшим перший крок і переносить фокус на job-relevant evidence.</p>
