mapTitle:"The diagnostic should immediately show which program block addresses the main gap.",mapCopy:"CRM stores the primary gap, recommended module, and reason to believe. Sales sees more than “lead from Instagram”: the pain, baseline, and why a specific program block may be relevant.",measurementTitle:"Six control metrics instead of vanity metrics.",riskTitle:"Six places where marketing can lose money before funnel optimization.",riskCopy:"The supplied training describes six risk groups, not six numeric KPI. We use them as diagnostic lenses and calculate outcome metrics separately in CRM.",risk1:"Overthinking / complexity",risk1c:"Are the process, content, or funnel more complex than the customer decision requires.",risk2:"Data",risk2c:"Do we have a baseline, source quality, conversion data, and a clear distinction between unknown and zero.",risk3:"Assumptions / mind games",risk3c:"Do we test hypotheses through experiments instead of explaining results after the fact.",risk4:"Marketing tactics",risk4c:"Does the tactic fit the funnel stage, product, and audience instead of merely following a trend.",risk5:"ROI",risk5c:"Is activity connected to qualified inquiry, sale, revenue, and cost.",risk6:"Human capital",risk6c:"Is there a clear owner, capability, review loop, and responsibility for the next action.",metricBoundary:"Unknown data is not turned into zero. CAC/LTV/ROMI appear only after spend, CRM revenue, and attribution rules are connected.",mindmapTitle:"Content should end in a next action, not in reach.",painCluster:"Pain / case cluster",planTitle:"Measure first, then scale.",orgTitle:"The CRM structure follows how the business already organizes marketing, sales, and HR.",orgMarketing:"CMO · scale the system",orgMarketingCopy:"The public vacancy describes an existing team, infrastructure, and active channels; the leadership focus is scaling and marketing impact on revenue/profit.",orgSales:"Head of Sales · four levels",orgSalesCopy:"The vacancy explicitly describes a four-level sales system and management of managers, so CRM needs hierarchy, plan, conversion, and next action.",orgManager:"Sales manager · warm lead → decision",orgManagerCopy:"Consultation, need discovery, program fit, decision follow-through, personal plan, and CRM reporting form the core sales pipeline.",orgHr:"Recruiter · selection → adaptation",orgHrCopy:"Initial communication, interviews, candidate stages, potential/culture review, and adaptation support a separate recruiting workflow.",crmTitle:"What marketing should write into CRM.",crmCopy:"One person should not become a new contact when moving Instagram → Telegram → consultation. CRM keeps one lead/customer identity and the channel history.",
hiringTitle:"The same brief becomes a reusable Candidate Assessment in CRM.",hiringCopy:"Brief, deadline, sources, Google Docs/MindMap submission, rubric, reviewer score, and a human decision live in Candidate Assessment. It stays separate from learner progress and does not automate employment decisions.",formTitle:"Fewer personal questions — more evidence that predicts work quality.",formReference:"Google Form · reference only · not submitted",formCopy:"The supplied form mixes contact/social data, motivation, career questions and personal/lifestyle questions. For a marketing role, our default intake shortens the first step and prioritizes job-relevant evidence.",keep:"KEEP / STRUCTURE",keepTitle:"Role essentials",keepCopy:"Name, contacts, city/timezone, language, availability, role, compensation expectation, portfolio / LinkedIn / professional social.",evidence:"ADD EVIDENCE",evidenceTitle:"Cases + KPI",evidenceCopy:"2–3 cases: problem → action → metric definition → baseline → actual → period → source/proof → personal contribution.",sampleWork:"WORK SAMPLE",sampleTitle:"Candidate Assessment",sampleCopy:"Brief → deadline → sources → Google Docs / MindMap → 30-point rubric → reviewer notes → human decision.",interview:"MOVE TO INTERVIEW",interviewTitle:"Motivation & work style",interviewCopy:"Why this role, what matters at work, career direction, conflict/exit scenario — concise and job-contextual.",defaultOff:"DEFAULT OFF",defaultOffTitle:"Lifestyle / family detail",defaultOffCopy:"Smoking, marital status, partner occupation, children, hardest life period and leisure are not required in our default assessment of marketing work.",replace:"REPLACE",replaceTitle:"Salary history → expectation",replaceCopy:"Instead of prior salary, ask expected compensation range, collaboration format, and the conditions under which the candidate would accept an offer.",
landingTitle:"The website should continue the funnel, not start a new story.",landingHero:"Find the main growth bottleneck in your business.",landingCta:"Take the free diagnostic",landingClose:"Your gap → relevant module → next action.",landingN1:"One primary entry offer",landingN1c:"Use the diagnostic as the primary CTA; give other lead magnets a defined role and attribution.",landingN2:"Proof next to the claim",landingN2c:"Show cases and numbers with source/conditions rather than as a universal guarantee.",landingN3:"Program fit before package pressure",landingN3c:"Establish problem-fit and module-fit before package, price, and follow-up pressure.",landingN4:"CRM continuity",landingN4c:"UTM, campaign_id, entry_offer, and diagnostic result continue into consultation without re-entry.",sameAuditTitle:"Want the same type of audit for your business?",sameAuditCopy:"Hermes can start with audit → funnel → offer → KPI → 90-day roadmap, then connect the right vertical workspace in Hermes Connect.",sameAuditCta:"Request audit + 90-day roadmap →",proofTitle:"One proof, one canonical version before scaling.",proofCopy:"Different official pages can retain different historical/current wording and numbers. CRM should not automatically choose the larger or newer figure; it stores provenance and requires human approval for canonical public wording.",proofClaim:"Claim",proofClaimCopy:"What we intend to say publicly.",proofSource:"Source",proofSourceCopy:"URL / document / CRM record + observed_at.",proofEvidence:"Evidence",proofEvidenceCopy:"Population, period, calculation, and owner definition.",proofWording:"Approved wording",proofWordingCopy:"Copy permitted for site/social/sales use.",proofExpiry:"Review / expiry",proofExpiryCopy:"When the proof must be checked again.",proofBoundary:"Example control issue: current official KNB pages show different sets of scale/proof metrics. This showcase does not normalize them into one “correct” number without client evidence.",sourcesTitle:"Public sources used in this concept.",sourceBoundary:"Metrics are a snapshot on the date above and can change. Business-result claims published by KNB remain client-owned claims and are not presented by Hermes as independently verified.",channelTitle:"What I would launch immediately: not six separate social networks, but one channel-role system.",channelCopy:"One content idea can have different formats but not different customer identities. Source asset, CTA, and campaign travel into CRM; Telegram, form, or consultation enrich the same history instead of creating a new lead.",proofAction:"First management action: define population and period for every claim, approve wording, assign an evidence owner, and set a review date. That removes conflicts between landing pages, social and sales scripts.",briefIssued:"Brief received",briefDeadline:"Deadline",briefFormat:"Submission format",briefScope:"Scope",register:"Register / open Academy CRM →",demo:"View CRM demo →",official:"Official KNB program ↗",boundary:"This is a strategy concept based on public sources and the supplied candidate brief. It does not claim that KNB approved the strategy, activated Hermes Connect, paid for services, or granted access to private analytics."
}
};
type Lang="uk"|"en"; type TranslationKey=keyof typeof d.uk;
let lang:Lang="uk";
try{const saved=localStorage.getItem("hermes-connect-language");if(saved==="en")lang="en";}catch{}
function apply(next:Lang){
 lang=next;document.documentElement.lang=next;try{localStorage.setItem("hermes-connect-language",next)}catch{}
 document.querySelectorAll<HTMLElement>("[data-i18n]").forEach(node=>{const key=node.dataset.i18n as TranslationKey|undefined;if(!key)return;const value=d[next][key];if(value)node.textContent=value;});
 document.querySelectorAll<HTMLElement>("[data-uk][data-en]").forEach(node=>{node.textContent=next==="en"?(node.dataset.en||""):(node.dataset.uk||"");});
 document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach(button=>button.classList.toggle("active",button.dataset.lang===next));
 document.querySelectorAll<HTMLAnchorElement>("[data-language-route]").forEach(link=>{const url=new URL(link.getAttribute("href")||"/",window.location.origin);url.searchParams.set("lang",next);link.href=url.pathname+url.search+url.hash;});
}
document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach(button=>button.addEventListener("click",()=>apply(button.dataset.lang==="en"?"en":"uk")));
apply(lang);
</script>

