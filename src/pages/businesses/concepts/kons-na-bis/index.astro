---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { site } from "../../../../data/site";
import { konsNaBisClient as client } from "../../../../data/catalog-client-kons-na-bis";
import { buildCatalogRequestHref } from "../../../../lib/catalog-request";

const sales = site.paths.find((path) => path.id === "technology")?.directContacts?.[0];
const brief = buildCatalogRequestHref(
  "catalog-growth",
  {
    businessId: "",
    businessName: client.name,
    profileUrl: client.programmeUrl,
    city: "",
    country: "UA",
    sourceRef: client.programmeUrl,
  },
  "Website concept",
) + "&concept=website";

const crmDemo = "/services/hermes-connect/academy/business-demo/kons-na-bis/";
const formats = [
  ["01", "Уроки онлайн", "Матеріали та записи у зручному онлайн-форматі."],
  ["02", "Практичні завдання", "Практика протягом програми та робота над бізнес-задачами."],
  ["03", "Щотижневий розбір", "Домашні завдання, експертні розбори та стратегічні сесії."],
  ["04", "Спільнота", "Приватна група для учасників програми."],
];
const management = [
  ["Marketing", "Канали, воронки, CAC, LTV, ROMI та гіпотези."],
  ["Sales CRM", "Заявка → консультація → програма → рішення → зарахування."],
  ["Academy", "Програми, групи, завдання, перевірки, прогрес і підтримка."],
  ["HR", "Вакансії, кандидати, співбесіди, оцінка та адаптація."],
];
---

<BaseLayout
  title="Конс на Бі$ — website concept | Hermes Catalog"
  description="Оригінальний концепт Hermes для бізнес-клубу та онлайн-програм. Це review-артефакт, а не офіційний сайт клієнта."
  robots="noindex,nofollow"
  locale="uk"
  htmlLang="uk"
>
  <main id="main-content" class="knb">
    <div class="disclosure">
      <strong>Концепт Hermes · це не офіційний сайт бізнесу</strong>
      <span>Review only · CRM та публікація ще не активовані</span>
    </div>

    <nav aria-label="Навігація концепту">
      <a class="brand" href="#top">Конс на Бі<span>$</span><small>КЛУБ ПІДПРИЄМЦІВ</small></a>
      <a href="#format">Формат</a>
      <a href="#system">Система</a>
      <a class="nav-action" href={crmDemo}>CRM demo ↗</a>
    </nav>

    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow">Онлайн · бізнес-освіта · системне зростання</p>
        <h1>Зростати.<br />Керувати.<br /><em>Бачити систему.</em></h1>
        <p class="intro">
          {client.programmeName} — семитижнева онлайн-програма. Hermes показує,
          як публічна презентація може бути зв’язана з CRM, продажами,
          навчальним процесом та аналітикою.
        </p>
        <div class="actions">
          <a class="primary" href="#format">Побачити концепт ↓</a>
          <a class="secondary" href={crmDemo}>Відкрити Academy CRM</a>
        </div>
        <p class="caption">Новий дизайн не позначається як погоджений або офіційний.</p>
      </div>

      <aside class="growth-art" aria-label="Сім кроків програми">
        <div class="art-top"><span>7 ТИЖНІВ</span><span>ONLINE</span></div>
        <div class="steps">
          {Array.from({ length: 7 }, (_, index) => (
            <div class="step" style={"--i:" + index}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <i></i>
            </div>
          ))}
        </div>
        <div class="art-copy">
          <strong>Від заявки — до системної роботи.</strong>
          <span>Візуальна метафора процесу, не обіцянка фінансового результату.</span>
        </div>
      </aside>
    </section>

    <section class="section" id="format">
      <div class="section-head">
        <p class="eyebrow">Підтверджений публічний формат</p>
        <h2>Навчання, практика, розбір, спільнота.</h2>
        <p>
          Структура нижче базується на відкритій сторінці програми. Актуальні
          дати, ціну та умови участі потрібно брати лише з офіційного джерела.
        </p>
      </div>
      <div class="format-grid">
        {formats.map(([number, title, body]) => (
          <article>
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
      <a class="text-link" href={client.programmeUrl} target="_blank" rel="noopener noreferrer">
        Офіційна сторінка програми ↗
      </a>
    </section>

    <section class="section system" id="system">
      <div class="section-head">
        <p class="eyebrow">Hermes Connect · management layer</p>
        <h2>Не просто сайт. Один операційний контур.</h2>
        <p>
          Публічні вакансії клубу показують потребу в аналітиці маркетингу,
          багаторівневих продажах, CRM-звітності та рекрутингу. У демо ці
          напрямки об’єднані в один Academy Business CRM template.
        </p>
      </div>
      <div class="management-grid">
        {management.map(([title, body], index) => (
          <article>
            <span>0{index + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
      <div class="system-actions">
        <a class="primary" href={crmDemo}>Відкрити інтерактивний CRM demo ↗</a>
        <a class="secondary" href={brief}>Обговорити реалізацію через Hermes brief</a>
      </div>
    </section>

    <section class="bridge">
      <p class="eyebrow">Catalog → CRM → Academy</p>
      <h2>Одна компанія. Один профіль. Різні робочі простори.</h2>
      <div class="bridge-row">
        <div><span>01</span><strong>Catalog</strong><p>Публічна картка та discovery.</p></div>
        <b>→</b>
        <div><span>02</span><strong>Sales CRM</strong><p>Заявки, консультації, рішення.</p></div>
        <b>→</b>
        <div><span>03</span><strong>Academy</strong><p>Програми, прогрес, перевірки.</p></div>
        <b>→</b>
        <div><span>04</span><strong>Analytics</strong><p>Канали, продажі, retention.</p></div>
      </div>
    </section>

    <footer>
      <strong>Конс на Бі$ × Hermes — review concept</strong>
      <p>
        Клієнтська конфігурація підготовлена як демо. Ця сторінка не підтверджує
        оплату, активацію CRM, публікацію в каталозі, погодження дизайну або
        реальні KPI.
      </p>
      <div>
        {sales && <a href={sales.href}>Hermes Sales · {sales.value}</a>}
        <a href={client.policyUrl} target="_blank" rel="noopener noreferrer">Офіційні умови клубу ↗</a>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  .knb{--ink:#172e39;--muted:#5c6b70;--paper:#faf8f1;--line:#d7d9d0;--lilac:#e5dcf4;--violet:#6b5590;--lime:#d4ed86;background:var(--paper);color:var(--ink);font-family:Manrope,"Source Sans 3",sans-serif;padding:0 max(22px,calc((100vw - 1280px)/2));min-height:100vh}
  .disclosure{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;padding:14px 0;border-bottom:1px solid var(--line);font-size:13px}
  nav{display:flex;align-items:center;gap:30px;padding:26px 0}nav a{color:inherit;text-underline-offset:5px}.brand{font-size:27px;font-weight:850;letter-spacing:-1px;text-decoration:none;line-height:1;margin-right:auto}.brand>span{color:#748638}.brand small{display:block;font-size:10px;letter-spacing:2px;margin-top:8px}.nav-action,.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border-radius:9px;padding:12px 18px;font-weight:760}.nav-action,.primary{background:var(--ink);color:white}.secondary{border:1px solid #9ca7a3;background:#fffdf8;color:var(--ink)}
  .hero{display:grid;grid-template-columns:1.02fr .98fr;gap:46px;align-items:center;padding:44px 0 78px}.eyebrow{text-transform:uppercase;letter-spacing:1.4px;font-size:12px;font-weight:800}.hero h1{font-size:clamp(48px,5.5vw,84px);line-height:1.01;letter-spacing:-4px;margin:26px 0}.hero h1 em{font-style:normal;color:var(--violet)}.intro{font-size:20px;max-width:610px;line-height:1.55}.actions,.system-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.caption{font-size:13px;color:var(--muted);margin-top:17px}
  .growth-art{background:linear-gradient(145deg,#efede5 0%,#e7e6dc 50%,#e6dff2 100%);border-radius:34px 34px 118px 34px;padding:26px;overflow:hidden;min-height:570px;display:flex;flex-direction:column;justify-content:space-between}.art-top{display:flex;justify-content:space-between;font-size:11px;font-weight:800;letter-spacing:1.5px}.steps{height:370px;position:relative;margin:8px 0}.step{position:absolute;left:calc(var(--i)*10% + 2%);bottom:calc(var(--i)*7% + 4%);width:112px;height:64px;transform:skewY(-25deg);background:linear-gradient(135deg,#c5b4e4,#e9e2f7);border:1px solid #9988b9;box-shadow:0 15px 35px #4c3d6a18}.step:last-child{background:linear-gradient(135deg,#d9ef92,#b7d064);border-color:#91a74d}.step span{position:absolute;left:14px;top:14px;transform:skewY(25deg);font-weight:850}.step i{position:absolute;width:2px;height:54px;background:#172e3938;right:18px;top:-44px}.art-copy{display:flex;justify-content:space-between;align-items:end;gap:25px}.art-copy strong{font-size:23px;line-height:1.2}.art-copy span{max-width:230px;font-size:12px;color:var(--muted)}
  .section{border-top:1px solid var(--line);padding:65px 0}.section-head{max-width:830px}.section h2,.bridge h2{font-size:clamp(31px,3.6vw,50px);line-height:1.12;letter-spacing:-2px;margin:18px 0}.section-head>p:last-child{font-size:18px;color:var(--muted)}.format-grid,.management-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:38px 0}.format-grid article,.management-grid article{border-top:2px solid #9b87bc;padding:22px 12px 0 0}.format-grid article>span,.management-grid article>span{font-size:12px;font-weight:800;color:var(--violet)}.format-grid h3,.management-grid h3{font-size:21px;margin:13px 0 8px}.format-grid p,.management-grid p{color:var(--muted);line-height:1.55}.text-link{font-weight:800;color:inherit;text-underline-offset:5px}.system{background:linear-gradient(90deg,transparent,#f0ebf6 50%,transparent)}.management-grid article:nth-child(2){border-color:#6f8ca0}.management-grid article:nth-child(3){border-color:#9dbb54}.management-grid article:nth-child(4){border-color:#b58a61}
  .bridge{border-top:1px solid var(--line);padding:65px 0}.bridge-row{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:16px;align-items:center;margin-top:35px}.bridge-row>div{background:#fffef9;border:1px solid var(--line);border-radius:14px;padding:21px;min-height:128px}.bridge-row span{font-size:11px;color:var(--violet);font-weight:800}.bridge-row strong{display:block;font-size:20px;margin-top:8px}.bridge-row p{font-size:14px;color:var(--muted)}.bridge-row b{font-size:25px;color:#809092}
  footer{border-top:1px solid var(--line);padding:36px 0 60px}footer p{max-width:850px;color:var(--muted);font-size:14px}footer div{display:flex;gap:28px;flex-wrap:wrap}footer a{color:inherit}
  a:focus-visible{outline:3px solid var(--violet);outline-offset:4px}
  @media(max-width:1000px){.hero{gap:25px}.format-grid,.management-grid{grid-template-columns:repeat(2,1fr)}.bridge-row{grid-template-columns:1fr 1fr}.bridge-row>b{display:none}.step{width:98px}.hero h1{letter-spacing:-2.5px}}
  @media(max-width:720px){.knb{padding:0 20px}.disclosure{font-size:11px}.disclosure span{display:block}nav{gap:12px;flex-wrap:wrap}nav>a:not(.brand):not(.nav-action){display:none}.brand{font-size:23px}.nav-action{font-size:12px;padding:9px 11px}.hero{grid-template-columns:1fr;padding:28px 0 50px}.hero h1{font-size:52px;letter-spacing:-2px}.intro{font-size:17px}.growth-art{min-height:475px;border-radius:26px 26px 70px 26px}.steps{height:300px}.step{width:82px;height:55px}.art-copy{align-items:start;flex-direction:column}.format-grid,.management-grid,.bridge-row{grid-template-columns:1fr 1fr}.section,.bridge{padding:46px 0}.section h2,.bridge h2{letter-spacing:-1.2px}.primary,.secondary{width:100%;box-sizing:border-box}.bridge-row>div{min-height:110px}}
  @media(max-width:440px){.format-grid,.management-grid,.bridge-row{grid-template-columns:1fr}.growth-art{padding:20px}.step{width:68px}.hero h1{font-size:46px}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>