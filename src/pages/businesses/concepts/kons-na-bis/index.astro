---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {konsNaBisClient as client} from "../../../../data/catalog-client-kons-na-bis";

const observedAt = "2026-10-01";
const socialSnapshot = [
  { label: "Instagram", value: "77.1K", detail: "followers", href: "https://www.instagram.com/konsnabis/" },
  { label: "YouTube · Oleksandr", value: "64.2K", detail: "subscribers · 1.3K videos", href: "https://www.youtube.com/@Oleksandr_Morozov_KnB" },
  { label: "TikTok", value: "19.6K", detail: "followers · 163.1K likes", href: "https://www.tiktok.com/@konsnabis" },
  { label: "Threads", value: "5,971", detail: "followers · 845 threads", href: "https://www.threads.com/@konsnabis" },
  { label: "Facebook", value: "85.7K", detail: "followers · public metadata snapshot", href: "https://www.facebook.com/konsnabis/" },
];

const instagramAudit = [
  {
    titleUk: "Сильна база уваги",
    titleEn: "Strong attention base",
    bodyUk: "Велика аудиторія, активний short-form контент, кейси, highlights і зрозуміла тематика для власників бізнесу.",
    bodyEn: "Large audience, active short-form publishing, cases, highlights, and a clear business-owner theme.",
    state: "strength",
  },
  {
    titleUk: "CTA фрагментовані",
    titleEn: "CTA fragmentation",
    bodyUk: "У bio — слово «сертифікат», у частині постів — «+» у Direct, в інших — загальне «долучайтесь». Це ускладнює чисту атрибуцію й порівняння конверсій.",
    bodyEn: "The bio uses the keyword “certificate”, some posts ask for “+” in DM, while others use generic join CTAs. That makes clean attribution and conversion comparison harder.",
    state: "gap",
  },
  {
    titleUk: "Контент є, але потрібна stage-логіка",
    titleEn: "Content needs stage logic",
    bodyUk: "Останні публікації охоплюють сильні болі — стагнація, партнери, сезонність, контент, впровадження. Їх варто розкласти за Awareness → Consideration → Proof → Conversion.",
    bodyEn: "Recent posts cover strong pains—stagnation, partners, seasonality, content, implementation. They should be mapped to Awareness → Consideration → Proof → Conversion.",
    state: "gap",
  },
  {
    titleUk: "Обсяг не дорівнює результату",
    titleEn: "Volume is not the outcome",
    bodyUk: "Висока частота публікацій має сенс лише разом із source/creative/CTA attribution та downstream CRM: qualified lead, consultation, sale, cohort, renewal.",
    bodyEn: "High publishing cadence only matters when source/creative/CTA attribution connects to downstream CRM: qualified lead, consultation, sale, cohort, renewal.",
    state: "gap",
  },
];

const funnel = [
  ["01","CONTENT","Problem / case / insight"],
  ["02","CTA","One trackable action per asset"],
  ["03","DIAGNOSTIC","Existing free business diagnostic → 6 risk lenses"],
  ["04","CRM","Source + pain + business stage"],
  ["05","CONSULTATION","Gap review + fit"],
  ["06","OFFER","7-week program"],
  ["07","DELIVERY","Cohort + assignments + reviews"],
  ["08","OUTCOME","Baseline → actual"],
  ["09","RENEWAL","Club / next program"],
];

const programMap = [
  ["W1","Marketing","Acquisition / positioning / customer flow"],
  ["W2","Key business metrics","Baseline / conversion / economics"],
  ["W3","Hiring system","People / delegation / capacity"],
  ["W4","Facebook system","Paid/social channel execution"],
  ["W5","Instagram system","Content / social monetization"],
  ["W6","Sales system","Consultation / conversion / average check"],
  ["W7","Online packaging","Website / landing / online conversion"],
];

const measurement = [
  ["1","Qualified attention","Reach / views from the intended owner audience"],
  ["2","Lead action","DM / form / diagnostic starts by campaign"],
  ["3","Qualified lead","Business owner + fit + defined problem"],
  ["4","Consultation","Booked → attended → qualified"],
  ["5","Sale","Consultation → paid program + attributed revenue"],
  ["6","Unit economics","CAC · LTV / renewal · ROMI where source data exists"],
];

const firstMoves = [
  ["0–7 days","Instrument","One campaign_id, UTM/keyword convention, CRM source fields, one primary CTA per asset, baseline dashboard."],
  ["8–30 days","Learn","Content matrix by pain × funnel stage; weekly winner/loser review; consultation script tied to diagnostic outputs."],
  ["31–90 days","Scale","Retarget proven audiences, expand winning hooks, connect cohort outcomes and renewal to original acquisition source."],
];

const sources = [
  {label:"Instagram @konsnabis",href:"https://www.instagram.com/konsnabis/"},
  {label:"TikTok @konsnabis",href:"https://www.tiktok.com/@konsnabis"},
  {label:"Threads @konsnabis",href:"https://www.threads.com/@konsnabis"},
  {label:"YouTube · Oleksandr Morozov",href:"https://www.youtube.com/@Oleksandr_Morozov_KnB"},
  {label:"KNB official site",href:"https://kons-na-bis.com/"},
  {label:"7-week program",href:client.programmeUrl},
];
---
<BaseLayout title="Конс на Бі$ — Marketing Growth Case | Hermes Catalog" description="Noindex Hermes Catalog client concept: public-source social audit, measurable funnel, Academy CRM map and candidate assessment example." robots="noindex,nofollow" locale="uk" htmlLang="uk">
<main id="main-content" class="knb-page">
  <div class="knb-top">
    <a href="/businesses/">← Hermes Catalog</a>
    <div class="knb-lang" aria-label="Language"><button type="button" class="active" data-lang="uk">UA</button><button type="button" data-lang="en">EN</button></div>
  </div>

  <section class="knb-hero">
    <p class="knb-kicker" data-i18n="kicker">Hermes Catalog · client strategy concept · не офіційний сайт КНБ</p>
    <h1>Конс на Бі$<br><span>Social → CRM → Revenue</span></h1>
    <p class="knb-lead" data-i18n="lead">Відповідь на реальний marketing-assessment: не просто аудит соцмережі, а вимірювана система залучення для 7-тижневої програми з прив’язкою до Academy CRM.</p>
    <div class="knb-hero-actions">
      <a class="primary" href="#audit" data-i18n="seeAudit">Дивитися аудит</a>
      <a href="#funnel" data-i18n="seeFunnel">Дивитися funnel</a>
      <a href="/demos/hermes-connect/academy-knb.html" data-language-route data-i18n="openDemo">Відкрити CRM demo</a>
    </div>
    <p class="knb-date"><span data-i18n="snapshot">Public-source snapshot</span> · {observedAt}</p>
  </section>

  <section class="knb-social" aria-labelledby="social-title">
    <div class="knb-section-head">
      <div><p class="knb-kicker">PUBLIC FOOTPRINT</p><h2 id="social-title" data-i18n="socialTitle">Аудиторія вже є. Завдання — зв’язати її з результатом.</h2></div>
      <p data-i18n="socialCopy">Публічні цифри — лише snapshot, не доказ продажів. Для управління потрібен ланцюг від конкретного content asset до CRM outcome.</p>
    </div>
    <div class="knb-social-grid">
      {socialSnapshot.map((item)=><a href={item.href} target="_blank" rel="noopener noreferrer"><small>{item.label}</small><strong>{item.value}</strong><span>{item.detail}</span></a>)}
    </div>
  </section>

  <section class="knb-panel" id="audit">
    <div class="knb-section-head">
      <div><p class="knb-kicker">TASK 1 · INSTAGRAM AUDIT</p><h2 data-i18n="auditTitle">Що я б змінив одразу як керівник напряму.</h2></div>
      <a href="https://www.instagram.com/konsnabis/" target="_blank" rel="noopener noreferrer">@konsnabis ↗</a>
    </div>
    <div class="knb-audit-grid">
      {instagramAudit.map((item)=><article class:list={[item.state==="strength"?"strength":"gap"]}><span>{item.state==="strength"?"STRENGTH":"OPPORTUNITY"}</span><h3 data-uk={item.titleUk} data-en={item.titleEn}>{item.titleUk}</h3><p data-uk={item.bodyUk} data-en={item.bodyEn}>{item.bodyUk}</p></article>)}
    </div>
    <div class="knb-evidence-note" data-i18n="recentEvidence">У свіжих Instagram-публікаціях 30.09–01.10 видно кілька різних conversion-механік: «+» у Direct, безкоштовна консультація, загальне «долучайтесь»; у bio — окремий keyword «сертифікат». Public logged-out readback не дає надійних likes/views для цього sample, тому ми не вигадуємо engagement rate або «winner». Для creative ranking потрібне дозволене підключення Instagram Insights.</div>
  </section>

  <section class="knb-panel" id="funnel">
    <div class="knb-section-head">
      <div><p class="knb-kicker">TASK 2 · 7-WEEK PROGRAM FUNNEL</p><h2 data-i18n="funnelTitle">Один funnel від уваги до renewal.</h2></div>
      <span class="knb-pill" data-i18n="program">Стратегія керованого зростання у бізнесі</span>
    </div>
    <div class="knb-funnel">
      {funnel.map(([n,t,d])=><div><span>{n}</span><b>{t}</b><small>{d}</small></div>)}
    </div>

    <div class="knb-offer">
      <div>
        <p class="knb-kicker">RECOMMENDED OFFER</p>
        <h3 data-i18n="offerTitle">Підсилити вже існуючу безкоштовну діагностику бізнесу: 6 зон ризику + персональна карта перших 3 дій.</h3>
        <p data-i18n="offerCopy">Не створювати ще один lead magnet і не вести social traffic одразу в дисконт. КНБ уже використовує безкоштовну діагностику; її варто зробити canonical entry offer: визначити головний gap, зафіксувати baseline, дати 3 наступні дії та лише після цього показати, чи підходить 7-тижнева програма і який модуль закриває проблему.</p>
      </div>
      <aside>
        <strong data-i18n="whyOffer">Чому цей оффер</strong>
        <ul>
          <li data-i18n="why1">не вигадує новий asset — підсилює те, що КНБ уже використовує;</li>
          <li data-i18n="why2">дає користь до покупки і підвищує довіру;</li>
          <li data-i18n="why3">перетворює діагностику на структуровані CRM-дані для sales;</li>
          <li data-i18n="why4">дозволяє порівняти entry offers і сегментувати follow-up.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">DIAGNOSTIC → PROGRAM FIT</p><h2 data-i18n="mapTitle">Діагностика має одразу показувати, який блок програми закриває головний gap.</h2></div></div>
    <div class="knb-program-map">
      {programMap.map(([week,title,signal])=><article><span>{week}</span><div><b>{title}</b><small>{signal}</small></div></article>)}
    </div>
    <p class="knb-note" data-i18n="mapCopy">CRM зберігає primary gap, рекомендований module і reason-to-believe. Sales-менеджер бачить не просто «lead from Instagram», а контекст: що болить, який baseline і чому конкретний блок програми може бути релевантним.</p>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">MEASUREMENT</p><h2 data-i18n="measurementTitle">Шість контрольних показників замість vanity metrics.</h2></div></div>
    <div class="knb-metrics">
      {measurement.map(([n,t,d])=><article><span>{n}</span><div><b>{t}</b><small>{d}</small></div></article>)}
    </div>
    <p class="knb-note" data-i18n="metricBoundary">Нуль не підставляється замість відсутніх даних. CAC/LTV/ROMI з’являються тільки після підключення витрат, CRM revenue і правил attribution.</p>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">DIAGNOSTIC LENSES · PROVIDED TRAINING</p><h2 data-i18n="riskTitle">Шість зон, де маркетинг може втрачати гроші ще до funnel optimization.</h2></div><a href="https://www.youtube.com/watch?v=umD_Ho4xRj0" target="_blank" rel="noopener noreferrer">Training source ↗</a></div>
    <p data-i18n="riskCopy">Наданий тренінг описує не шість KPI, а шість груп ризику. Ми використовуємо їх як diagnostic lenses, а окремо рахуємо outcome-метрики в CRM.</p>
    <div class="knb-risk-grid">
      <article><span>01</span><b data-i18n="risk1">Overthinking / ускладнення</b><small data-i18n="risk1c">Чи не створюємо процес, контент або funnel складнішими, ніж потрібно для рішення клієнта.</small></article>
      <article><span>02</span><b data-i18n="risk2">Data</b><small data-i18n="risk2c">Чи є baseline, source quality, conversion data і чи відрізняємо unknown від zero.</small></article>
      <article><span>03</span><b data-i18n="risk3">Assumptions / «mind games»</b><small data-i18n="risk3c">Чи перевіряємо гіпотези експериментом, а не пояснюємо результат заднім числом.</small></article>
      <article><span>04</span><b data-i18n="risk4">Marketing tactics</b><small data-i18n="risk4c">Чи відповідає інструмент стадії funnel, продукту й аудиторії, а не просто тренду.</small></article>
      <article><span>05</span><b data-i18n="risk5">ROI</b><small data-i18n="risk5c">Чи зв’язана активність із qualified inquiry, sale, revenue і cost.</small></article>
      <article><span>06</span><b data-i18n="risk6">Human capital</b><small data-i18n="risk6c">Чи є owner, компетенція, review loop і відповідальність за наступну дію.</small></article>
    </div>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">MINDMAP</p><h2 data-i18n="mindmapTitle">Контент має закінчуватися не охопленням, а наступною дією.</h2></div></div>
    <div class="knb-mindmap">
      <b>Instagram / TikTok / Threads / YouTube / Facebook</b><i>→</i>
      <b data-i18n="painCluster">Pain / case cluster</b><i>→</i>
      <b>Trackable CTA</b><i>→</i>
      <b>6-point Diagnostic</b><i>→</i>
      <b>Hermes / Client CRM</b><i>→</i>
      <b>Consultation</b><i>→</i>
      <b>7-week Program</b><i>→</i>
      <b>Cohort delivery</b><i>→</i>
      <b>Outcome + Renewal</b>
    </div>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">0–90 DAY OPERATING PLAN</p><h2 data-i18n="planTitle">Спочатку вимірювання, потім масштаб.</h2></div></div>
    <div class="knb-plan">{firstMoves.map(([window,title,body])=><article><span>{window}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
  </section>

  <section class="knb-panel knb-crm">
    <div class="knb-section-head">
      <div><p class="knb-kicker">HERMES CONNECT · ACADEMY CRM</p><h2 data-i18n="crmTitle">Що має потрапляти в CRM з маркетингу.</h2></div>
      <a href="/services/hermes-connect/academy/business/auth/?mode=register&source=catalog&business=kons-na-bis&lang=uk" data-language-route data-i18n="register">Зареєструвати / відкрити Academy CRM →</a>
    </div>
    <div class="knb-crm-fields">
      {["source_channel","content_id","campaign_id","CTA / keyword","entry_offer","primary pain","diagnostic_primary_gap","baseline","recommended_module","business stage","manager","consultation status","program fit","objection","sale / revenue","cohort","completion","renewal"].map((field)=><span>{field}</span>)}
    </div>
    <p data-i18n="crmCopy">Одна людина не повинна ставати новим контактом при переході Instagram → Telegram → consultation. CRM зберігає один lead/customer identity та історію каналів.</p>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">HIRING SYSTEM</p><h2 data-i18n="hiringTitle">Те саме тестове — як reusable Candidate Assessment у CRM.</h2></div></div>
    <p data-i18n="hiringCopy">Brief, deadline, джерела, Google Docs/MindMap submission, rubric, reviewer score та human decision зберігаються в Candidate Assessment. Це окремо від learner progress і не створює автоматичних кадрових рішень.</p>
    <div class="knb-assessment">
      <span>Evidence & diagnosis · 0–5</span><span>Audience & positioning · 0–5</span><span>Funnel logic · 0–5</span><span>Offer quality · 0–5</span><span>KPI & measurement · 0–5</span><span>Execution thinking · 0–5</span>
    </div>
  </section>

  <section class="knb-panel knb-form-review">
    <div class="knb-section-head"><div><p class="knb-kicker">CANDIDATE INTAKE</p><h2 data-i18n="formTitle">Що ми б спростили у формі кандидата.</h2></div></div>
    <p data-i18n="formCopy">Для оцінки маркетолога пріоритет — job-relevant evidence: досвід, portfolio/cases, фактичні KPI, інструменти, мова, availability, test assignment і спосіб мислення. Питання про куріння, сімейний стан, дітей, партнера чи особисті життєві періоди не потрібні для оцінки якості marketing work і не входять у наш default CRM template.</p>
  </section>

  <section class="knb-panel knb-sources">
    <div class="knb-section-head"><div><p class="knb-kicker">EVIDENCE</p><h2 data-i18n="sourcesTitle">Публічні джерела, використані в concept.</h2></div></div>
    <div>{sources.map((source)=><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>)}</div>
    <p data-i18n="sourceBoundary">Метрики — snapshot на дату вище. Вони можуть змінюватися. Бізнес-результати, які КНБ заявляє на власних сторінках, залишаються client-owned claims і не подаються Hermes як незалежно перевірені.</p>
  </section>

  <section class="knb-future-client">
    <div><p class="knb-kicker">FOR FUTURE HERMES CLIENTS</p><h2 data-i18n="sameAuditTitle">Хочете такий самий аудит для свого бізнесу?</h2><p data-i18n="sameAuditCopy">Hermes може почати з audit → funnel → offer → KPI → 90-day roadmap, а потім під’єднати правильний vertical workspace у Hermes Connect.</p></div>
    <a class="primary" href="/businesses/request/?type=marketing-package&months=3&utm_source=hermes_catalog&utm_medium=case_study&utm_campaign=knb_marketing_case&utm_content=request_same_audit" data-future-client-cta data-i18n="sameAuditCta">Запросити аудит і 90-day roadmap →</a>
  </section>

  <div class="knb-actions">
    <a class="primary" href="/services/hermes-connect/academy/business/auth/?mode=register&source=catalog&business=kons-na-bis&lang=uk" data-language-route data-i18n="register">Зареєструвати / відкрити Academy CRM →</a>
    <a href="/demos/hermes-connect/academy-knb.html" data-language-route data-i18n="demo">Переглянути CRM demo →</a>
    <a href={client.programmeUrl} target="_blank" rel="noopener noreferrer" data-i18n="official">Офіційна програма КНБ ↗</a>
  </div>
  <p class="knb-boundary" data-i18n="boundary">Це демонстраційний strategy concept на основі публічних джерел і наданого candidate brief. Він не стверджує, що КНБ погодила стратегію, активувала Hermes Connect, оплатила послуги або надала доступ до приватної аналітики.</p>
</main>

<script>
import { trackCaseOpened, trackEvent } from "../../../../lib/analytics";
trackCaseOpened("knb_marketing_case");
document.querySelector<HTMLAnchorElement>("[data-future-client-cta]")?.addEventListener("click", (event) => {
  const link = event.currentTarget as HTMLAnchorElement;
  trackEvent("case_study_cta", { caseId: "knb_marketing_case", destination: link.pathname, action: "request_similar_audit" });
});
const d={
uk:{
kicker:"Hermes Catalog · client strategy concept · не офіційний сайт КНБ",lead:"Відповідь на реальний marketing-assessment: не просто аудит соцмережі, а вимірювана система залучення для 7-тижневої програми з прив’язкою до Academy CRM.",seeAudit:"Дивитися аудит",seeFunnel:"Дивитися funnel",openDemo:"Відкрити CRM demo",snapshot:"Public-source snapshot",
socialTitle:"Аудиторія вже є. Завдання — зв’язати її з результатом.",socialCopy:"Публічні цифри — лише snapshot, не доказ продажів. Для управління потрібен ланцюг від конкретного content asset до CRM outcome.",auditTitle:"Що я б змінив одразу як керівник напряму.",recentEvidence:"У свіжих Instagram-публікаціях 30.09–01.10 видно кілька різних conversion-механік: «+» у Direct, безкоштовна консультація, загальне «долучайтесь»; у bio — окремий keyword «сертифікат». Public logged-out readback не дає надійних likes/views для цього sample, тому ми не вигадуємо engagement rate або «winner». Для creative ranking потрібне дозволене підключення Instagram Insights.",
funnelTitle:"Один funnel від уваги до renewal.",program:"Стратегія керованого зростання у бізнесі",offerTitle:"Підсилити вже існуючу безкоштовну діагностику бізнесу: 6 зон ризику + персональна карта перших 3 дій.",offerCopy:"Не створювати ще один lead magnet і не вести social traffic одразу в дисконт. КНБ уже використовує безкоштовну діагностику; її варто зробити canonical entry offer: визначити головний gap, зафіксувати baseline, дати 3 наступні дії та лише після цього показати, чи підходить 7-тижнева програма і який модуль закриває проблему.",whyOffer:"Чому цей оффер",why1:"не вигадує новий asset — підсилює те, що КНБ уже використовує;",why2:"дає користь до покупки і підвищує довіру;",why3:"перетворює діагностику на структуровані CRM-дані для sales;",why4:"дозволяє порівняти entry offers і сегментувати follow-up.",
mapTitle:"Діагностика має одразу показувати, який блок програми закриває головний gap.",mapCopy:"CRM зберігає primary gap, рекомендований module і reason-to-believe. Sales-менеджер бачить не просто «lead from Instagram», а контекст: що болить, який baseline і чому конкретний блок програми може бути релевантним.",measurementTitle:"Шість контрольних показників замість vanity metrics.",riskTitle:"Шість зон, де маркетинг може втрачати гроші ще до funnel optimization.",riskCopy:"Наданий тренінг описує не шість KPI, а шість груп ризику. Ми використовуємо їх як diagnostic lenses, а окремо рахуємо outcome-метрики в CRM.",risk1:"Overthinking / ускладнення",risk1c:"Чи не створюємо процес, контент або funnel складнішими, ніж потрібно для рішення клієнта.",risk2:"Data",risk2c:"Чи є baseline, source quality, conversion data і чи відрізняємо unknown від zero.",risk3:"Assumptions / «mind games»",risk3c:"Чи перевіряємо гіпотези експериментом, а не пояснюємо результат заднім числом.",risk4:"Marketing tactics",risk4c:"Чи відповідає інструмент стадії funnel, продукту й аудиторії, а не просто тренду.",risk5:"ROI",risk5c:"Чи зв’язана активність із qualified inquiry, sale, revenue і cost.",risk6:"Human capital",risk6c:"Чи є owner, компетенція, review loop і відповідальність за наступну дію.",metricBoundary:"Нуль не підставляється замість відсутніх даних. CAC/LTV/ROMI з’являються тільки після підключення витрат, CRM revenue і правил attribution.",mindmapTitle:"Контент має закінчуватися не охопленням, а наступною дією.",painCluster:"Pain / case cluster",planTitle:"Спочатку вимірювання, потім масштаб.",crmTitle:"Що має потрапляти в CRM з маркетингу.",crmCopy:"Одна людина не повинна ставати новим контактом при переході Instagram → Telegram → consultation. CRM зберігає один lead/customer identity та історію каналів.",
hiringTitle:"Те саме тестове — як reusable Candidate Assessment у CRM.",hiringCopy:"Brief, deadline, джерела, Google Docs/MindMap submission, rubric, reviewer score та human decision зберігаються в Candidate Assessment. Це окремо від learner progress і не створює автоматичних кадрових рішень.",formTitle:"Що ми б спростили у формі кандидата.",formCopy:"Для оцінки маркетолога пріоритет — job-relevant evidence: досвід, portfolio/cases, фактичні KPI, інструменти, мова, availability, test assignment і спосіб мислення. Питання про куріння, сімейний стан, дітей, партнера чи особисті життєві періоди не потрібні для оцінки якості marketing work і не входять у наш default CRM template.",
sameAuditTitle:"Хочете такий самий аудит для свого бізнесу?",sameAuditCopy:"Hermes може почати з audit → funnel → offer → KPI → 90-day roadmap, а потім під’єднати правильний vertical workspace у Hermes Connect.",sameAuditCta:"Запросити аудит і 90-day roadmap →",sourcesTitle:"Публічні джерела, використані в concept.",sourceBoundary:"Метрики — snapshot на дату вище. Вони можуть змінюватися. Бізнес-результати, які КНБ заявляє на власних сторінках, залишаються client-owned claims і не подаються Hermes як незалежно перевірені.",register:"Зареєструвати / відкрити Academy CRM →",demo:"Переглянути CRM demo →",official:"Офіційна програма КНБ ↗",boundary:"Це демонстраційний strategy concept на основі публічних джерел і наданого candidate brief. Він не стверджує, що КНБ погодила стратегію, активувала Hermes Connect, оплатила послуги або надала доступ до приватної аналітики."
},
en:{
kicker:"Hermes Catalog · client strategy concept · not KNB’s official website",lead:"A response to a real marketing assessment: not just a social audit, but a measurable acquisition system for the seven-week program connected to Academy CRM.",seeAudit:"View audit",seeFunnel:"View funnel",openDemo:"Open CRM demo",snapshot:"Public-source snapshot",
socialTitle:"The audience already exists. The task is to connect it to outcomes.",socialCopy:"Public counts are a snapshot, not proof of sales. Management needs a chain from each content asset to a CRM outcome.",auditTitle:"What I would change immediately as the channel lead.",recentEvidence:"Recent Instagram posts from Sep 30–Oct 1 use several conversion mechanisms: “+” in DM, a free consultation, and a generic join CTA; the bio uses a separate “certificate” keyword. Logged-out public readback does not expose reliable likes/views for this sample, so we do not invent engagement rate or a creative “winner”. Creative ranking requires an authorized Instagram Insights connection.",
funnelTitle:"One funnel from attention to renewal.",program:"Managed Business Growth Strategy",offerTitle:"Upgrade the existing free business diagnostic: 6 risk lenses + a personal map of the first 3 actions.",offerCopy:"Do not create another lead magnet or send social traffic straight into a discount. KNB already uses a free business diagnostic; make it the canonical entry offer: identify the main gap, capture the baseline, give 3 next actions, then show whether the seven-week program fits and which module addresses the problem.",whyOffer:"Why this offer",why1:"does not invent another asset—it strengthens one KNB already uses;",why2:"creates value before purchase and builds trust;",why3:"turns the diagnostic into structured CRM data for sales;",why4:"lets the team compare entry offers and segment follow-up.",
mapTitle:"The diagnostic should immediately show which program block addresses the main gap.",mapCopy:"CRM stores the primary gap, recommended module, and reason to believe. Sales sees more than “lead from Instagram”: the pain, baseline, and why a specific program block may be relevant.",measurementTitle:"Six control metrics instead of vanity metrics.",riskTitle:"Six places where marketing can lose money before funnel optimization.",riskCopy:"The supplied training describes six risk groups, not six numeric KPI. We use them as diagnostic lenses and calculate outcome metrics separately in CRM.",risk1:"Overthinking / complexity",risk1c:"Are the process, content, or funnel more complex than the customer decision requires.",risk2:"Data",risk2c:"Do we have a baseline, source quality, conversion data, and a clear distinction between unknown and zero.",risk3:"Assumptions / mind games",risk3c:"Do we test hypotheses through experiments instead of explaining results after the fact.",risk4:"Marketing tactics",risk4c:"Does the tactic fit the funnel stage, product, and audience instead of merely following a trend.",risk5:"ROI",risk5c:"Is activity connected to qualified inquiry, sale, revenue, and cost.",risk6:"Human capital",risk6c:"Is there a clear owner, capability, review loop, and responsibility for the next action.",metricBoundary:"Unknown data is not turned into zero. CAC/LTV/ROMI appear only after spend, CRM revenue, and attribution rules are connected.",mindmapTitle:"Content should end in a next action, not in reach.",painCluster:"Pain / case cluster",planTitle:"Measure first, then scale.",crmTitle:"What marketing should write into CRM.",crmCopy:"One person should not become a new contact when moving Instagram → Telegram → consultation. CRM keeps one lead/customer identity and the channel history.",
hiringTitle:"The same brief becomes a reusable Candidate Assessment in CRM.",hiringCopy:"Brief, deadline, sources, Google Docs/MindMap submission, rubric, reviewer score, and a human decision live in Candidate Assessment. It stays separate from learner progress and does not automate employment decisions.",formTitle:"What we would simplify in candidate intake.",formCopy:"For a marketing role, prioritize job-relevant evidence: experience, portfolio/cases, actual KPI, tools, language, availability, a work sample, and reasoning. Smoking, family status, children, partner details, or personal life-history questions are not needed to assess marketing-work quality and are not part of our default CRM template.",
sameAuditTitle:"Want the same type of audit for your business?",sameAuditCopy:"Hermes can start with audit → funnel → offer → KPI → 90-day roadmap, then connect the right vertical workspace in Hermes Connect.",sameAuditCta:"Request audit + 90-day roadmap →",sourcesTitle:"Public sources used in this concept.",sourceBoundary:"Metrics are a snapshot on the date above and can change. Business-result claims published by KNB remain client-owned claims and are not presented by Hermes as independently verified.",register:"Register / open Academy CRM →",demo:"View CRM demo →",official:"Official KNB program ↗",boundary:"This is a strategy concept based on public sources and the supplied candidate brief. It does not claim that KNB approved the strategy, activated Hermes Connect, paid for services, or granted access to private analytics."
}
};
type Lang="uk"|"en"; type TranslationKey=keyof typeof d.uk;
let lang:Lang="uk";
try{const saved=localStorage.getItem("hermes-connect-language");if(saved==="en")lang="en";}catch{}
function apply(next:Lang){
 lang=next;document.documentElement.lang=next;try{localStorage.setItem("hermes-connect-language",next)}catch{}
 document.querySelectorAll<HTMLElement>("[data-i18n]").forEach(node=>{const key=node.dataset.i18n as TranslationKey|undefined;if(!key)return;const value=d[next][key];if(value)node.textContent=value;});
 document.querySelectorAll<HTMLElement>("[data-uk][data-en]").forEach(node=>{node.textContent=next==="en"?(node.dataset.en||""):(node.dataset.uk||"");});
 document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach(button=>button.classList.toggle("active",button.dataset.lang===next));
 document.querySelectorAll<HTMLAnchorElement>("[data-language-route]").forEach(link=>{const url=new URL(link.getAttribute("href")||"/",window.location.origin);url.searchParams.set("lang",next);link.href=url.pathname+url.search+url.hash;});
}
document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach(button=>button.addEventListener("click",()=>apply(button.dataset.lang==="en"?"en":"uk")));
apply(lang);
</script>

