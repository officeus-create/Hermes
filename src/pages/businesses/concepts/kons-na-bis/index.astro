---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {konsNaBisClient as client} from "../../../../data/catalog-client-kons-na-bis";

const observedAt = "2026-10-01";
const socialSnapshot = [
  { label: "Instagram", value: "77.1K", detail: "followers", href: "https://www.instagram.com/konsnabis/" },
  { label: "YouTube · Oleksandr", value: "64.2K", detail: "subscribers · 1.3K videos", href: "https://www.youtube.com/@Oleksandr_Morozov_KnB" },
  { label: "TikTok", value: "19.6K", detail: "followers · 163.1K likes", href: "https://www.tiktok.com/@konsnabis" },
  { label: "Threads", value: "5,971", detail: "followers · 845 threads", href: "https://www.threads.com/@konsnabis" },
  { label: "Facebook", value: "85.7K", detail: "followers · public metadata snapshot", href: "https://www.facebook.com/konsnabis/" },
];

const instagramAudit = [
  {
    titleUk: "Сильна база уваги",
    titleEn: "Strong attention base",
    bodyUk: "Велика аудиторія, активний short-form контент, кейси, highlights і зрозуміла тематика для власників бізнесу.",
    bodyEn: "Large audience, active short-form publishing, cases, highlights, and a clear business-owner theme.",
    state: "strength",
  },
  {
    titleUk: "CTA фрагментовані",
    titleEn: "CTA fragmentation",
    bodyUk: "У bio — слово «сертифікат», у частині постів — «+» у Direct, в інших — загальне «долучайтесь». Це ускладнює чисту атрибуцію й порівняння конверсій.",
    bodyEn: "The bio uses the keyword “certificate”, some posts ask for “+” in DM, while others use generic join CTAs. That makes clean attribution and conversion comparison harder.",
    state: "gap",
  },
  {
    titleUk: "Контент є, але потрібна stage-логіка",
    titleEn: "Content needs stage logic",
    bodyUk: "Останні публікації охоплюють сильні болі — стагнація, партнери, сезонність, контент, впровадження. Їх варто розкласти за Awareness → Consideration → Proof → Conversion.",
    bodyEn: "Recent posts cover strong pains—stagnation, partners, seasonality, content, implementation. They should be mapped to Awareness → Consideration → Proof → Conversion.",
    state: "gap",
  },
  {
    titleUk: "Обсяг не дорівнює результату",
    titleEn: "Volume is not the outcome",
    bodyUk: "Висока частота публікацій має сенс лише разом із source/creative/CTA attribution та downstream CRM: qualified lead, consultation, sale, cohort, renewal.",
    bodyEn: "High publishing cadence only matters when source/creative/CTA attribution connects to downstream CRM: qualified lead, consultation, sale, cohort, renewal.",
    state: "gap",
  },
];

const funnel = [
  ["01","CONTENT","Problem / case / insight"],
  ["02","CTA","One trackable action per asset"],
  ["03","DIAGNOSTIC","6-point Growth Score"],
  ["04","CRM","Source + pain + business stage"],
  ["05","CONSULTATION","Gap review + fit"],
  ["06","OFFER","7-week program"],
  ["07","DELIVERY","Cohort + assignments + reviews"],
  ["08","OUTCOME","Baseline → actual"],
  ["09","RENEWAL","Club / next program"],
];

const measurement = [
  ["1","Qualified attention","Reach / views from the intended owner audience"],
  ["2","Lead action","DM / form / diagnostic starts by campaign"],
  ["3","Qualified lead","Business owner + fit + defined problem"],
  ["4","Consultation","Booked → attended → qualified"],
  ["5","Sale","Consultation → paid program + attributed revenue"],
  ["6","Unit economics","CAC · LTV / renewal · ROMI where source data exists"],
];

const firstMoves = [
  ["0–7 days","Instrument","One campaign_id, UTM/keyword convention, CRM source fields, one primary CTA per asset, baseline dashboard."],
  ["8–30 days","Learn","Content matrix by pain × funnel stage; weekly winner/loser review; consultation script tied to diagnostic outputs."],
  ["31–90 days","Scale","Retarget proven audiences, expand winning hooks, connect cohort outcomes and renewal to original acquisition source."],
];

const sources = [
  {label:"Instagram @konsnabis",href:"https://www.instagram.com/konsnabis/"},
  {label:"TikTok @konsnabis",href:"https://www.tiktok.com/@konsnabis"},
  {label:"Threads @konsnabis",href:"https://www.threads.com/@konsnabis"},
  {label:"YouTube · Oleksandr Morozov",href:"https://www.youtube.com/@Oleksandr_Morozov_KnB"},
  {label:"KNB official site",href:"https://kons-na-bis.com/"},
  {label:"7-week program",href:client.programmeUrl},
];
---
<BaseLayout title="Конс на Бі$ — Marketing Growth Case | Hermes Catalog" description="Noindex Hermes Catalog client concept: public-source social audit, measurable funnel, Academy CRM map and candidate assessment example." robots="noindex,nofollow" locale="uk" htmlLang="uk">
<main id="main-content" class="knb-page">
  <div class="knb-top">
    <a href="/businesses/">← Hermes Catalog</a>
    <div class="knb-lang" aria-label="Language"><button type="button" class="active" data-lang="uk">UA</button><button type="button" data-lang="en">EN</button></div>
  </div>

  <section class="knb-hero">
    <p class="knb-kicker" data-i18n="kicker">Hermes Catalog · client strategy concept · не офіційний сайт КНБ</p>
    <h1>Конс на Бі$<br><span>Social → CRM → Revenue</span></h1>
    <p class="knb-lead" data-i18n="lead">Відповідь на реальний marketing-assessment: не просто аудит соцмережі, а вимірювана система залучення для 7-тижневої програми з прив’язкою до Academy CRM.</p>
    <div class="knb-hero-actions">
      <a class="primary" href="#audit" data-i18n="seeAudit">Дивитися аудит</a>
      <a href="#funnel" data-i18n="seeFunnel">Дивитися funnel</a>
      <a href="/demos/hermes-connect/academy-knb.html" data-language-route data-i18n="openDemo">Відкрити CRM demo</a>
    </div>
    <p class="knb-date"><span data-i18n="snapshot">Public-source snapshot</span> · {observedAt}</p>
  </section>

  <section class="knb-social" aria-labelledby="social-title">
    <div class="knb-section-head">
      <div><p class="knb-kicker">PUBLIC FOOTPRINT</p><h2 id="social-title" data-i18n="socialTitle">Аудиторія вже є. Завдання — зв’язати її з результатом.</h2></div>
      <p data-i18n="socialCopy">Публічні цифри — лише snapshot, не доказ продажів. Для управління потрібен ланцюг від конкретного content asset до CRM outcome.</p>
    </div>
    <div class="knb-social-grid">
      {socialSnapshot.map((item)=><a href={item.href} target="_blank" rel="noopener noreferrer"><small>{item.label}</small><strong>{item.value}</strong><span>{item.detail}</span></a>)}
    </div>
  </section>

  <section class="knb-panel" id="audit">
    <div class="knb-section-head">
      <div><p class="knb-kicker">TASK 1 · INSTAGRAM AUDIT</p><h2 data-i18n="auditTitle">Що я б змінив одразу як керівник напряму.</h2></div>
      <a href="https://www.instagram.com/konsnabis/" target="_blank" rel="noopener noreferrer">@konsnabis ↗</a>
    </div>
    <div class="knb-audit-grid">
      {instagramAudit.map((item)=><article class:list={[item.state==="strength"?"strength":"gap"]}><span>{item.state==="strength"?"STRENGTH":"OPPORTUNITY"}</span><h3 data-uk={item.titleUk} data-en={item.titleEn}>{item.titleUk}</h3><p data-uk={item.bodyUk} data-en={item.bodyEn}>{item.bodyUk}</p></article>)}
    </div>
    <div class="knb-evidence-note" data-i18n="recentEvidence">У свіжих Instagram-публікаціях 30.09–01.10 видно кілька різних conversion-механік: «+» у Direct, безкоштовна консультація, загальне «долучайтесь»; у bio — окремий keyword «сертифікат». Це хороший матеріал для A/B testing, але тільки якщо кожен CTA має власний campaign_id та CRM source.</div>
  </section>

  <section class="knb-panel" id="funnel">
    <div class="knb-section-head">
      <div><p class="knb-kicker">TASK 2 · 7-WEEK PROGRAM FUNNEL</p><h2 data-i18n="funnelTitle">Один funnel від уваги до renewal.</h2></div>
      <span class="knb-pill" data-i18n="program">Стратегія керованого зростання у бізнесі</span>
    </div>
    <div class="knb-funnel">
      {funnel.map(([n,t,d])=><div><span>{n}</span><b>{t}</b><small>{d}</small></div>)}
    </div>

    <div class="knb-offer">
      <div>
        <p class="knb-kicker">RECOMMENDED OFFER</p>
        <h3 data-i18n="offerTitle">Безкоштовна діагностика «6 показників росту» + персональна карта перших 3 дій.</h3>
        <p data-i18n="offerCopy">Не починати з дисконту. Спочатку показати власнику, де саме втрачається ріст: увага, lead action, qualification, consultation, sale або unit economics. Якщо 7-тижнева програма реально підходить — показати, який блок програми закриває кожний gap.</p>
      </div>
      <aside>
        <strong data-i18n="whyOffer">Чому цей оффер</strong>
        <ul>
          <li data-i18n="why1">відповідає позиціонуванню КНБ «керувати показниками»;</li>
          <li data-i18n="why2">дає користь до покупки і підвищує довіру;</li>
          <li data-i18n="why3">створює структуровані CRM-дані для sales;</li>
          <li data-i18n="why4">дозволяє сегментувати follow-up без загальних розсилок.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">MEASUREMENT</p><h2 data-i18n="measurementTitle">Шість контрольних показників замість vanity metrics.</h2></div></div>
    <div class="knb-metrics">
      {measurement.map(([n,t,d])=><article><span>{n}</span><div><b>{t}</b><small>{d}</small></div></article>)}
    </div>
    <p class="knb-note" data-i18n="metricBoundary">Нуль не підставляється замість відсутніх даних. CAC/LTV/ROMI з’являються тільки після підключення витрат, CRM revenue і правил attribution.</p>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">MINDMAP</p><h2 data-i18n="mindmapTitle">Контент має закінчуватися не охопленням, а наступною дією.</h2></div></div>
    <div class="knb-mindmap">
      <b>Instagram / TikTok / Threads / YouTube / Facebook</b><i>→</i>
      <b data-i18n="painCluster">Pain / case cluster</b><i>→</i>
      <b>Trackable CTA</b><i>→</i>
      <b>6-point Diagnostic</b><i>→</i>
      <b>Hermes / Client CRM</b><i>→</i>
      <b>Consultation</b><i>→</i>
      <b>7-week Program</b><i>→</i>
      <b>Cohort delivery</b><i>→</i>
      <b>Outcome + Renewal</b>
    </div>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">0–90 DAY OPERATING PLAN</p><h2 data-i18n="planTitle">Спочатку вимірювання, потім масштаб.</h2></div></div>
    <div class="knb-plan">{firstMoves.map(([window,title,body])=><article><span>{window}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
  </section>

  <section class="knb-panel knb-crm">
    <div class="knb-section-head">
      <div><p class="knb-kicker">HERMES CONNECT · ACADEMY CRM</p><h2 data-i18n="crmTitle">Що має потрапляти в CRM з маркетингу.</h2></div>
      <a href="/services/hermes-connect/academy/business/auth/?mode=register&source=catalog&business=kons-na-bis&lang=uk" data-language-route data-i18n="register">Зареєструвати / відкрити Academy CRM →</a>
    </div>
    <div class="knb-crm-fields">
      {["source_channel","content_id","campaign_id","CTA / keyword","lead_magnet","primary pain","business stage","manager","consultation status","program fit","objection","sale / revenue","cohort","completion","renewal"].map((field)=><span>{field}</span>)}
    </div>
    <p data-i18n="crmCopy">Одна людина не повинна ставати новим контактом при переході Instagram → Telegram → consultation. CRM зберігає один lead/customer identity та історію каналів.</p>
  </section>

  <section class="knb-panel">
    <div class="knb-section-head"><div><p class="knb-kicker">HIRING SYSTEM</p><h2 data-i18n="hiringTitle">Те саме тестове — як reusable Candidate Assessment у CRM.</h2></div></div>
    <p data-i18n="hiringCopy">Brief, deadline, джерела, Google Docs/MindMap submission, rubric, reviewer score та human decision зберігаються в Candidate Assessment. Це окремо від learner progress і не створює автоматичних кадрових рішень.</p>
    <div class="knb-assessment">
      <span>Evidence & diagnosis · 0–5</span><span>Audience & positioning · 0–5</span><span>Funnel logic · 0–5</span><span>Offer quality · 0–5</span><span>KPI & measurement · 0–5</span><span>Execution thinking · 0–5</span>
    </div>
  </section>

  <section class="knb-panel knb-form-review">
    <div class="knb-section-head"><div><p class="knb-kicker">CANDIDATE INTAKE</p><h2 data-i18n="formTitle">Що ми б спростили у формі кандидата.</h2></div></div>
    <p data-i18n="formCopy">Для оцінки маркетолога пріоритет — job-relevant evidence: досвід, portfolio/cases, фактичні KPI, інструменти, мова, availability, test assignment і спосіб мислення. Питання про куріння, сімейний стан, дітей, партнера чи особисті життєві періоди не потрібні для оцінки якості marketing work і не входять у наш default CRM template.</p>
  </section>

  <section class="knb-panel knb-sources">
    <div class="knb-section-head"><div><p class="knb-kicker">EVIDENCE</p><h2 data-i18n="sourcesTitle">Публічні джерела, використані в concept.</h2></div></div>
    <div>{sources.map((source)=><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>)}</div>
    <p data-i18n="sourceBoundary">Метрики — snapshot на дату вище. Вони можуть змінюватися. Бізнес-результати, які КНБ заявляє на власних сторінках, залишаються client-owned claims і не подаються Hermes як незалежно перевірені.</p>
  </section>

  <div class="knb-actions">
    <a class="primary" href="/services/hermes-connect/academy/business/auth/?mode=register&source=catalog&business=kons-na-bis&lang=uk" data-language-route data-i18n="register">Зареєструвати / відкрити Academy CRM →</a>
    <a href="/demos/hermes-connect/academy-knb.html" data-language-route data-i18n="demo">Переглянути CRM demo →</a>
    <a href={client.programmeUrl} target="_blank" rel="noopener noreferrer" data-i18n="official">Офіційна програма КНБ ↗</a>
  </div>
  <p class="knb-boundary" data-i18n="boundary">Це демонстраційний strategy concept на основі публічних джерел і наданого candidate brief. Він не стверджує, що КНБ погодила стратегію, активувала Hermes Connect, оплатила послуги або надала доступ до приватної аналітики.</p>
</main>

