---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import IAmDevelopmentPath from "../../../components/IAmDevelopmentPath.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import IAmItalyEditorialVisual from "../../../components/IAmItalyEditorialVisual.astro";
import { iamItalyMerchantCandidates, iamItalyAffiliateNetworkResearch } from "../../../data/i-am-italy-merchant-candidates";

const flow = [
  { number: "01", title: "Plan before landing", body: "Build a device-local list of stores or shopping channels without giving I am your passport, payment or flight information." },
  { number: "02", title: "Open official sellers", body: "Compare the retailer's own terms, stock, eligibility and pickup or delivery conditions when you have connectivity." },
  { number: "03", title: "Buy or reserve with the provider", body: "Payment, reservations, VAT documents and pickup remain entirely with the official merchant or authorized service today." },
  { number: "04", title: "Add a connected workspace later", body: "The proposed future Hermes Connect integration can show sourced receipts, consented actions and merchant status only after partner authorization." },
] as const;
const fulfillmentLabels = {
  "merchant-online-checkout": "External online shopping",
  "direct-boutique-contact": "Official boutique contact",
  "airport-departure-reserve": "Airport pickup when departing",
} as const;
---
<BaseLayout
  title="I am Italy — Travel, Shopping & Cross-Border Startup | Hermes Catalog"
  description="I am is a founder-incubated travel and cross-border technology concept in Hermes Catalog. Italy first: shopping, Tax Free guidance, verified-provider research and a 14-month development roadmap."
  robots="noindex,nofollow"
  locale="en"
  htmlLang="en"
>
  <SiteHeader theme="light" activePath="/businesses/" />
  <main id="main-content" class="italy-catalog">
    <div class="shell">
      <nav aria-label="Breadcrumb" class="crumb"><a href="/businesses/">Hermes Business Catalog</a> <span>/</span> Italy — incubation concept</nav>
      <IAmDevelopmentPath active="Italy" />
      <header class="iam-italy-hero">
        <div class="eyebrow">Italy · International research · Hermes Connect</div>
        <h1>I am. Your personal interface to Italy — starting with shopping and Tax Free.</h1>
        <p class="lead">I am is a founder-incubated personal interface for travel and cross-border life. Italy is the first exploration market: start with shopping and Tax Free guidance, prove a sourced journey, then expand only through verified providers and authorized country workflows. This is not a claim of Italian company registration or an active Tax Free operation.</p>
        <div class="actions">
          <a class="primary" href="/insights/technology/i-am-vision/">Read the official development announcement →</a>
          <a class="secondary" href="/businesses/concepts/i-am/">Explore the I am founder concept</a>
          <a class="secondary" href="/services/hermes-connect/">Application development will continue in Hermes Connect</a>
        </div>
        <div class="truth"><strong>Public concept, not a claimed company.</strong> There is no verified I am legal entity, customer, affiliate contract, payment authorization, inventory integration or ability to place a merchant order on this site.</div>
      </header>
      <IAmItalyEditorialVisual />

      <section class="section" aria-labelledby="merchant-title">
        <div class="section-head"><div><p class="eyebrow">Italy retailer discovery · manually sourced</p><h2 id="merchant-title">Real websites. No invented partners.</h2></div><p>These are independent stores and official services with public information. Their appearance here does not imply affiliation, consent, stock availability, preorders via I am, or a share of sales.</p></div>
        <div class="merchant-grid">
          {iamItalyMerchantCandidates.map((merchant) => (
            <article class="merchant" data-merchant-id={merchant.id}>
              <div class="merchant-top"><span>{merchant.category.replaceAll("-", " ")}</span><span class="state">NOT PARTNERED</span></div>
              <h3>{merchant.name}</h3>
              <p>{merchant.summary}</p>
              <span class="fulfillment">{fulfillmentLabels[merchant.fulfillment]}</span>
              <div class="merchant-links">
                <a href={merchant.shopUrl} target="_blank" rel="noopener noreferrer">Open official retailer ↗</a>
                <a href={merchant.affiliateProgramUrl ?? merchant.sourceUrl} target="_blank" rel="noopener noreferrer">{merchant.affiliateProgramUrl ? "Review published affiliate programme ↗" : "Review official service conditions ↗"}</a>
              </div>
            </article>
          ))}
        </div>
        <p class="merchant-disclosure"><strong>No monetized links yet.</strong> All links above are ordinary external destinations, not tracked affiliate URLs. Commissions, cookie windows, attribution, approved offers and payment conditions are unknown for I am until accepted by each programme. Terms change; verify with the provider before purchase.</p>
      </section>

      <section class="section journey" aria-labelledby="journey-title">
        <p class="eyebrow">Journey design · mobile and desktop</p>
        <h2 id="journey-title">From airplane research to a real merchant, safely.</h2>
        <div class="steps">{flow.map((step)=><article><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}</div>
      </section>

      <section class="section investor-case" aria-labelledby="investor-case-title">
        <p class="eyebrow">Founder incubation · 14-month horizon</p>
        <h2 id="investor-case-title">From one useful Italy journey to a global interface for cross-border life.</h2>
        <p class="section-lead">I am is being designed around a simple idea: the user describes an outcome, the system identifies the relevant country rules and providers, and the user keeps only the modules needed for that journey. Italy shopping and Tax Free guidance are the first bounded proof points, not the final product.</p>
        <div class="value-grid">
          <article><span>01</span><h3>Intent first</h3><p>Replace a giant menu with a conversation: where are you going, what are you trying to do, and what evidence is actually required?</p></article>
          <article><span>02</span><h3>Verified country context</h3><p>Future workflows must carry official sources, effective dates, review ownership and an honest unavailable state when a rule cannot be verified.</p></article>
          <article><span>03</span><h3>One personal workspace</h3><p>Shopping, travel, registrations and approved partner handoffs should reuse one permission-aware Hermes Connect identity instead of fragmented accounts.</p></article>
          <article><span>04</span><h3>Measured completion</h3><p>Success is a verified task or partner receipt, not a page view, AI answer, outbound click or unconfirmed commission.</p></article>
        </div>

        <div class="roadmap-panel">
          <h3>Development plan</h3>
          <div class="roadmap-grid">
            <article><span>Months 1–2</span><strong>Research + foundation</strong><p>Brand, Italy rules, merchant research, public development evidence and safe prototypes.</p></article>
            <article><span>Months 3–5</span><strong>Personal journey</strong><p>Text/voice intent, consented workspace, responsive UX and real user task testing.</p></article>
            <article><span>Months 6–8</span><strong>Authorized handoffs</strong><p>Merchant or administrative actions only where provider authority, privacy and legal review exist.</p></article>
            <article><span>Months 9–11</span><strong>Second verified journey</strong><p>Add one additional country/service after the first workflow proves value and operational reliability.</p></article>
            <article><span>Months 12–14</span><strong>Commercial readiness</strong><p>Security, unit economics, partner reliability, retention and evidence-backed scale decisions.</p></article>
          </div>
        </div>

        <div class="market-grid">
          <article><h3>Global Blue / Planet</h3><p>Mature Tax Free and merchant infrastructure. I am should integrate or hand off where specialists already own the regulated rail rather than pretending to replace it.</p></article>
          <article><h3>TravelAI / iVisa</h3><p>Travel AI and document workflows already exist. Voice alone is not differentiation; cross-domain verified task completion is the harder target.</p></article>
          <article><h3>Stripe Atlas / e-Residency</h3><p>Specific formation routes already work. Future I am company workflows must connect official requirements and qualified providers without promising instant global incorporation.</p></article>
        </div>
        <div class="why-now">
          <div>
            <p class="eyebrow">Why build now</p>
            <h3>An AI-native product can design the workflow before legacy complexity arrives.</h3>
            <p>Many established specialists already own valuable regulated rails. I am does not need to rebuild those rails; the product hypothesis is to orchestrate them around the user's outcome with source, permission and receipt states designed in from the beginning.</p>
          </div>
          <ul>
            <li><strong>Greenfield advantage:</strong> one consent and evidence model can be designed before multiple disconnected products and databases accumulate.</li>
            <li><strong>Specialist leverage:</strong> mature providers can remain fulfillment partners while I am focuses on the cross-domain user journey.</li>
            <li><strong>AI with boundaries:</strong> natural language can simplify discovery, but country rules and provider permissions stay versioned and auditable.</li>
            <li><strong>Measured expansion:</strong> add a country or service only after the previous journey proves completion, support load and economics.</li>
          </ul>
          <p class="why-now-note">This is an architectural hypothesis, not evidence that I am will be cheaper or faster than any named competitor.</p>
        </div>

        <div class="business-model">
          <div>
            <p class="eyebrow">Revenue hypotheses · not current revenue</p>
            <h3>How the platform could make money after proof.</h3>
          </div>
          <ul>
            <li><strong>Approved affiliate commerce:</strong> only after programme acceptance, tracked sale reconciliation and actual payout.</li>
            <li><strong>Merchant software:</strong> workflow, support and customer-status tools where merchants see measurable value.</li>
            <li><strong>Authorized service fees:</strong> only where a licensed or official provider permits the commercial model.</li>
            <li><strong>B2B2C / API:</strong> future partner access to verified journey components after security and permission reviews.</li>
          </ul>
        </div>
        <div class="capital-priorities">
          <p class="eyebrow">What strategic capital would accelerate</p>
          <h3>Fund verified infrastructure, not speculative page count.</h3>
          <div>
            <article><strong>Legal + compliance</strong><span>Country counsel, privacy, merchant/operator contracts and financial-regulatory boundaries.</span></article>
            <article><strong>Product + security</strong><span>Identity, permissions, audit receipts, accessibility, PWA/mobile quality and independent security review.</span></article>
            <article><strong>Provider integrations</strong><span>Approved inventory, affiliate, merchant and official-service adapters with revocation and reliability controls.</span></article>
            <article><strong>Market proof</strong><span>Consented user research, merchant pilots, task-completion measurement and support operations before expansion.</span></article>
          </div>
          <p>No financing amount, valuation, allocation percentage or return is represented as agreed or available in this public presentation.</p>
        </div>

        <div class="proof-panel">
          <div>
            <p class="eyebrow">What is already real</p>
            <h3>Development has public provenance.</h3>
            <p>The first I am development announcement is live in Hermes Insights, the Italy merchant research is source-linked, and the product is being built from existing Hermes Connect patterns rather than presented as a finished licensed service.</p>
            <a href="/insights/technology/i-am-vision/">Read the live Hermes Insights announcement →</a>
          </div>
          <div>
            <p class="eyebrow">Conditional research</p>
            <h3>Future partnerships and financing require verified evidence.</h3>
            <p>No public securities terms, valuation, minimum investment or return promise are offered here. A future financing conversation requires a verified issuer, structure and applicable legal review.</p>
            <p>This presentation does not open a partnership or investor inquiry process. It documents the founder concept and public research only.</p>
          </div>
        </div>
      </section>

      <section class="section separation" aria-labelledby="separation-title">
        <div>
          <p class="eyebrow">Do not confuse shopping channels</p>
          <h2 id="separation-title">Arrival shopping ≠ airport departure reservation ≠ VAT refund.</h2>
          <p>The <a href="https://www.milanairports-shop.com/en/services/eboutique" target="_blank" rel="noopener noreferrer">Milan Airports Boutique</a> service permits official pre-departure reservations for certain terminals and flights, with merchant-side confirmation and payment when collecting. It is not an airport-arrival pickup guarantee.</p>
          <p><a href="https://www.thebicestercollection.com/fidenza-village/en/visit/" target="_blank" rel="noopener noreferrer">Fidenza Village Shop from Home</a> separately offers official boutique contact for remote shopping. Italian Tax Free on qualifying visitor purchases has its own seller-issued documents and customs-validation rules. Online shopping or airport duty-free pricing must not automatically be described as an Italian tourist VAT refund.</p>
          <p>For the tax/customs layer, use the Italian authority rather than I am: <a href="https://www.adm.gov.it/portale/en/progetti-aida-otello" target="_blank" rel="noopener noreferrer">ADM OTELLO official overview</a> and the <a href="https://vatrefund.adm.gov.it/howto" target="_blank" rel="noopener noreferrer">official traveller Vat Refund guide</a>. I am currently provides research and product-development context only.</p>
        </div>
        <a class="primary" href="/demos/hermes-connect/i-am-shopping/">Try the Stage 3 Hermes Connect workspace →</a>
      </section>

      <section class="section next-step" aria-labelledby="next-step-title">
        <div>
          <p class="eyebrow">Hermes technology lab</p>
          <h2 id="next-step-title">A modular commerce capability for Hermes Connect.</h2>
          <p>The I am workspace uses our established Hermes Connect architecture in the future. A product card is not a paid order; a retailer link is not an approved affiliate; a visitor is not a CRM lead unless they explicitly contact us through a verified route.</p>
          <p>The affiliate publisher market includes <a href={iamItalyAffiliateNetworkResearch.url} target="_blank" rel="noopener noreferrer">{iamItalyAffiliateNetworkResearch.name}</a>, but no Hermes programme enrollment or payout is established.</p>
        </div>
        <a class="secondary" href="/it/tecnologia/">Hermes Technology · Italia →</a>
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .italy-catalog{background:#f6f9fb;color:#102e42}.shell{max-width:1190px;margin:auto;padding:0 23px 100px}
  .crumb{display:flex;gap:10px;padding:30px 0;color:#748899;font-size:12px}.crumb a{color:#267489}
  .iam-italy-hero{display:block;overflow:visible;min-width:0;padding:56px 0 45px}.eyebrow{color:#098d8c;font-size:12px;text-transform:uppercase;font-weight:800;letter-spacing:.15em}
  h1{font-size:clamp(38px,6vw,78px);line-height:1.08;letter-spacing:-.055em;max-width:1050px;margin:16px 0 22px}
  .lead{color:#4e6a7e;font-size:clamp(17px,1.8vw,23px);line-height:1.63;max-width:900px}
  .actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:32px}
  .actions a,.separation>a,.next-step>a{display:inline-flex;text-decoration:none;border-radius:12px;padding:15px 20px;font-weight:800;font-size:13px;min-height:44px;align-items:center}
  .primary{background:#164d60;color:white}.secondary{border:1px solid #c3d4da;background:white;color:#185667}
  .actions a:focus-visible,.merchant a:focus-visible,.separation a:focus-visible,.next-step a:focus-visible{outline:3px solid #35a7c8;outline-offset:3px}
  .truth{margin-top:29px;max-width:900px;padding:17px 20px;background:#fff6e5;border:1px solid #f1dbab;border-radius:14px;color:#76592b;line-height:1.65;font-size:13px}
  .section{padding-top:80px}.section-head{display:flex;justify-content:space-between;gap:34px;align-items:end;margin-bottom:27px}
  h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.04em;line-height:1.14;margin:13px 0 19px}
  .section-head>div{max-width:630px}.section-head>p{max-width:360px;color:#648091;line-height:1.65;font-size:13px}
  .merchant-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
  .merchant{background:#fff;border:1px solid #dbe5eb;border-radius:20px;padding:27px;display:flex;flex-direction:column;min-height:257px}
  .merchant-top{display:flex;justify-content:space-between;gap:12px;text-transform:uppercase;letter-spacing:.09em;font-size:10px;font-weight:800;color:#587887}
  .merchant-top .state{color:#915827}.merchant h3{font-size:26px;margin:20px 0 10px;letter-spacing:-.02em}
  .merchant p{color:#5f7888;line-height:1.65;font-size:14px;margin:0 0 15px}
  .fulfillment{color:#207c84;font-size:12px;font-weight:800;margin-top:auto}
  .merchant-links{border-top:1px solid #eef1f5;display:flex;gap:18px;flex-wrap:wrap;margin-top:16px;padding-top:16px}
  .merchant-links a{color:#186d82;font-size:13px;font-weight:800}
  .merchant-disclosure{font-size:13px;color:#6b7e8d;line-height:1.65;margin:24px 0}
  .journey h2{max-width:900px}.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}
  .steps article{background:#e6f0f2;border:1px solid #cbdce3;padding:22px;border-radius:17px}
  .steps span{font-size:11px;color:#11828a;font-weight:900}.steps h3{font-size:19px;margin:15px 0 9px}
  .steps p{line-height:1.6;font-size:13px;color:#617789}
  .section-lead{max-width:900px;color:#5d7587;font-size:16px;line-height:1.75}.value-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-top:28px}.value-grid article,.roadmap-grid article,.market-grid article{border:1px solid #dce6eb;border-radius:17px;background:#fff;padding:21px}.value-grid span,.roadmap-grid span{color:#12858c;font-size:11px;font-weight:900;letter-spacing:.08em}.value-grid h3,.market-grid h3{margin:15px 0 8px;font-size:19px}.value-grid p,.market-grid p,.roadmap-grid p{margin:0;color:#637b8b;font-size:13px;line-height:1.6}.roadmap-panel{margin-top:28px;padding:27px;border-radius:20px;background:#113047;color:#fff}.roadmap-panel>h3{margin:0 0 18px;font-size:25px}.roadmap-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.roadmap-grid article{background:#1a4359;border-color:#345d70}.roadmap-grid strong{display:block;margin:10px 0 8px;font-size:15px}.roadmap-grid p{color:#c3d9df}.roadmap-grid span{color:#76d8d2}.market-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin-top:28px}.why-now{display:grid;grid-template-columns:.9fr 1.1fr;gap:28px;margin-top:28px;padding:28px;border-radius:20px;background:#f7efe3;border:1px solid #ead9bf}.why-now h3{font-size:27px;margin:10px 0}.why-now p:not(.eyebrow){color:#665f58;line-height:1.68}.why-now ul{margin:0;padding-left:20px;color:#635f5b;line-height:1.65}.why-now li+li{margin-top:9px}.why-now-note{grid-column:1/-1;margin:0!important;font-size:12px!important}
  .business-model{display:grid;grid-template-columns:.8fr 1.2fr;gap:28px;margin-top:28px;padding:27px;border:1px solid #dbe5ea;border-radius:20px;background:#eef5f6}.business-model h3{margin:10px 0;font-size:27px}.business-model ul{margin:0;padding-left:20px;color:#557182;line-height:1.7}.business-model li+li{margin-top:9px}.capital-priorities{margin-top:28px;padding:27px;border:1px solid #dbe5ea;border-radius:20px;background:#fff}.capital-priorities h3{font-size:27px;margin:10px 0 20px}.capital-priorities>div{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px}.capital-priorities article{padding:17px;border-radius:14px;background:#f1f6f7}.capital-priorities article strong{display:block;color:#204e60}.capital-priorities article span{display:block;margin-top:8px;color:#687f8d;font-size:12px;line-height:1.55}.capital-priorities>p:last-child{color:#748795;font-size:12px;line-height:1.6;margin:16px 0 0}.proof-panel{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:28px}.proof-panel>div{padding:25px;border:1px solid #dbe6eb;border-radius:18px;background:#fff}.proof-panel h3{margin:10px 0;font-size:23px}.proof-panel p:not(.eyebrow){color:#5f7788;line-height:1.65}.proof-panel a{color:#16727e;font-weight:800}
  .separation,.next-step{display:flex;gap:34px;justify-content:space-between;align-items:center}
  .separation>div,.next-step>div{max-width:830px}.separation p:not(.eyebrow),.next-step p:not(.eyebrow){color:#5e7585;line-height:1.7}
  .separation p a,.next-step p a{color:#167c83}.separation>a,.next-step>a{flex-shrink:0}
  @media(max-width:820px){.section-head,.separation,.next-step{display:block}.section-head>p{max-width:740px}.merchant-grid,.proof-panel{grid-template-columns:1fr}.steps,.value-grid,.market-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.roadmap-grid{grid-template-columns:1fr 1fr}.business-model,.why-now{grid-template-columns:1fr}.capital-priorities>div{grid-template-columns:repeat(2,minmax(0,1fr))}.separation>a,.next-step>a{margin-top:14px}}
  @media(max-width:520px){.shell{padding:0 16px 64px}.iam-italy-hero{padding:34px 0 31px}.actions a{width:100%;justify-content:center}.section{padding-top:60px}.steps,.value-grid,.market-grid,.roadmap-grid,.capital-priorities>div{grid-template-columns:1fr}.merchant{padding:21px}.separation>a,.next-step>a{width:100%;justify-content:center}}
</style>
