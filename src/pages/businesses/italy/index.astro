---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import IAmItalyEditorialVisual from "../../../components/IAmItalyEditorialVisual.astro";
import { iamItalyMerchantCandidates, iamItalyAffiliateNetworkResearch } from "../../../data/i-am-italy-merchant-candidates";

const flow = [
  { number: "01", title: "Plan before landing", body: "Build a device-local list of stores or shopping channels without giving I am your passport, payment or flight information." },
  { number: "02", title: "Open official sellers", body: "Compare the retailer's own terms, stock, eligibility and pickup or delivery conditions when you have connectivity." },
  { number: "03", title: "Buy or reserve with the provider", body: "Payment, reservations, VAT documents and pickup remain entirely with the official merchant or authorized service today." },
  { number: "04", title: "Add a connected workspace later", body: "The proposed future Hermes Connect integration can show sourced receipts, consented actions and merchant status only after partner authorization." },
] as const;
const fulfillmentLabels = {
  "merchant-online-checkout": "External online shopping",
  "direct-boutique-contact": "Official boutique contact",
  "airport-departure-reserve": "Airport pickup when departing",
} as const;
---
<BaseLayout
  title="Italy · I am Shopping Concept | Hermes Catalog"
  description="A transparent Hermes Catalog Italy concept for I am, a planned travel shopping workspace. Discover verified retailer websites and affiliate programmes; no operating orders, partnerships or Tax Free refunds."
  robots="noindex,nofollow"
  locale="en"
  htmlLang="en"
>
  <SiteHeader theme="light" activePath="/businesses/" />
  <main id="main-content" class="italy-catalog">
    <div class="shell">
      <nav aria-label="Breadcrumb" class="crumb"><a href="/businesses/">Hermes Business Catalog</a> <span>/</span> Italy — incubation concept</nav>
      <header class="hero">
        <div class="eyebrow">Italy · International research · Hermes Connect</div>
        <h1>Shop Italy before you land. Start with a plan, not a checkout.</h1>
        <p class="lead">Introducing the I am startup concept: a personal assistant for travellers to collect potential shopping destinations and understand what happens next. Italy is the first exploration market, not a claim of Italian company registration or an active Tax Free operation.</p>
        <div class="actions">
          <a class="primary" href="/demos/hermes-connect/i-am-shopping/">Try the shopping workspace demo →</a>
          <a class="secondary" href="/businesses/concepts/i-am/">Explore the I am founder concept</a>
          <a class="secondary" href="/insights/technology/i-am-vision/">Read the concept announcement</a>
        </div>
        <div class="truth"><strong>Public concept, not a claimed company.</strong> There is no verified I am legal entity, customer, affiliate contract, payment authorization, inventory integration or ability to place a merchant order on this site.</div>
      </header>
      <IAmItalyEditorialVisual />

      <section class="section" aria-labelledby="merchant-title">
        <div class="section-head"><div><p class="eyebrow">Italy retailer discovery · manually sourced</p><h2 id="merchant-title">Real websites. No invented partners.</h2></div><p>These are independent stores and official services with public information. Their appearance here does not imply affiliation, consent, stock availability, preorders via I am, or a share of sales.</p></div>
        <div class="merchant-grid">
          {iamItalyMerchantCandidates.map((merchant) => (
            <article class="merchant" data-merchant-id={merchant.id}>
              <div class="merchant-top"><span>{merchant.category.replaceAll("-", " ")}</span><span class="state">NOT PARTNERED</span></div>
              <h3>{merchant.name}</h3>
              <p>{merchant.summary}</p>
              <span class="fulfillment">{fulfillmentLabels[merchant.fulfillment]}</span>
              <div class="merchant-links">
                <a href={merchant.shopUrl} target="_blank" rel="noopener noreferrer">Open official retailer ↗</a>
                <a href={merchant.affiliateProgramUrl ?? merchant.sourceUrl} target="_blank" rel="noopener noreferrer">{merchant.affiliateProgramUrl ? "Review published affiliate programme ↗" : "Review official service conditions ↗"}</a>
              </div>
            </article>
          ))}
        </div>
        <p class="merchant-disclosure"><strong>No monetized links yet.</strong> All links above are ordinary external destinations, not tracked affiliate URLs. Commissions, cookie windows, attribution, approved offers and payment conditions are unknown for I am until accepted by each programme. Terms change; verify with the provider before purchase.</p>
      </section>

      <section class="section journey" aria-labelledby="journey-title">
        <p class="eyebrow">Journey design · mobile and desktop</p>
        <h2 id="journey-title">From airplane research to a real merchant, safely.</h2>
        <div class="steps">{flow.map((step)=><article><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}</div>
      </section>

      <section class="section separation" aria-labelledby="separation-title">
        <div>
          <p class="eyebrow">Do not confuse shopping channels</p>
          <h2 id="separation-title">Arrival shopping ≠ airport departure reservation ≠ VAT refund.</h2>
          <p>The <a href="https://www.milanairports-shop.com/en/services/eboutique" target="_blank" rel="noopener noreferrer">Milan Airports Boutique</a> service permits official pre-departure reservations for certain terminals and flights, with merchant-side confirmation and payment when collecting. It is not an airport-arrival pickup guarantee.</p>
          <p><a href="https://www.thebicestercollection.com/fidenza-village/en/visit/" target="_blank" rel="noopener noreferrer">Fidenza Village Shop from Home</a> separately offers official boutique contact for remote shopping. Italian Tax Free on qualifying visitor purchases has its own seller-issued documents and customs-validation rules. Online shopping or airport duty-free pricing must not automatically be described as an Italian tourist VAT refund.</p>
        </div>
        <a class="primary" href="/demos/hermes-connect/i-am-shopping/">Build a sample trip list →</a>
      </section>

      <section class="section next-step" aria-labelledby="next-step-title">
        <div>
          <p class="eyebrow">Hermes technology lab</p>
          <h2 id="next-step-title">A modular commerce capability for Hermes Connect.</h2>
          <p>The I am workspace uses our established Hermes Connect architecture in the future. A product card is not a paid order; a retailer link is not an approved affiliate; a visitor is not a CRM lead unless they explicitly contact us through a verified route.</p>
          <p>The affiliate publisher market includes <a href={iamItalyAffiliateNetworkResearch.url} target="_blank" rel="noopener noreferrer">{iamItalyAffiliateNetworkResearch.name}</a>, but no Hermes programme enrollment or payout is established.</p>
        </div>
        <a class="secondary" href="/it/tecnologia/">Hermes Technology · Italia →</a>
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .italy-catalog{background:#f6f9fb;color:#102e42}.shell{max-width:1190px;margin:auto;padding:0 23px 100px}
  .crumb{display:flex;gap:10px;padding:30px 0;color:#748899;font-size:12px}.crumb a{color:#267489}
  .hero{padding:56px 0 45px}.eyebrow{color:#098d8c;font-size:12px;text-transform:uppercase;font-weight:800;letter-spacing:.15em}
  h1{font-size:clamp(38px,6vw,78px);line-height:1.08;letter-spacing:-.055em;max-width:1050px;margin:16px 0 22px}
  .lead{color:#4e6a7e;font-size:clamp(17px,1.8vw,23px);line-height:1.63;max-width:900px}
  .actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:32px}
  .actions a,.separation>a,.next-step>a{display:inline-flex;text-decoration:none;border-radius:12px;padding:15px 20px;font-weight:800;font-size:13px;min-height:44px;align-items:center}
  .primary{background:#164d60;color:white}.secondary{border:1px solid #c3d4da;background:white;color:#185667}
  .actions a:focus-visible,.merchant a:focus-visible,.separation a:focus-visible,.next-step a:focus-visible{outline:3px solid #35a7c8;outline-offset:3px}
  .truth{margin-top:29px;max-width:900px;padding:17px 20px;background:#fff6e5;border:1px solid #f1dbab;border-radius:14px;color:#76592b;line-height:1.65;font-size:13px}
  .section{padding-top:80px}.section-head{display:flex;justify-content:space-between;gap:34px;align-items:end;margin-bottom:27px}
  h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.04em;line-height:1.14;margin:13px 0 19px}
  .section-head>div{max-width:630px}.section-head>p{max-width:360px;color:#648091;line-height:1.65;font-size:13px}
  .merchant-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
  .merchant{background:#fff;border:1px solid #dbe5eb;border-radius:20px;padding:27px;display:flex;flex-direction:column;min-height:257px}
  .merchant-top{display:flex;justify-content:space-between;gap:12px;text-transform:uppercase;letter-spacing:.09em;font-size:10px;font-weight:800;color:#587887}
  .merchant-top .state{color:#915827}.merchant h3{font-size:26px;margin:20px 0 10px;letter-spacing:-.02em}
  .merchant p{color:#5f7888;line-height:1.65;font-size:14px;margin:0 0 15px}
  .fulfillment{color:#207c84;font-size:12px;font-weight:800;margin-top:auto}
  .merchant-links{border-top:1px solid #eef1f5;display:flex;gap:18px;flex-wrap:wrap;margin-top:16px;padding-top:16px}
  .merchant-links a{color:#186d82;font-size:13px;font-weight:800}
  .merchant-disclosure{font-size:13px;color:#6b7e8d;line-height:1.65;margin:24px 0}
  .journey h2{max-width:900px}.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}
  .steps article{background:#e6f0f2;border:1px solid #cbdce3;padding:22px;border-radius:17px}
  .steps span{font-size:11px;color:#11828a;font-weight:900}.steps h3{font-size:19px;margin:15px 0 9px}
  .steps p{line-height:1.6;font-size:13px;color:#617789}
  .separation,.next-step{display:flex;gap:34px;justify-content:space-between;align-items:center}
  .separation>div,.next-step>div{max-width:830px}.separation p:not(.eyebrow),.next-step p:not(.eyebrow){color:#5e7585;line-height:1.7}
  .separation p a,.next-step p a{color:#167c83}.separation>a,.next-step>a{flex-shrink:0}
  @media(max-width:820px){.section-head,.separation,.next-step{display:block}.section-head>p{max-width:740px}.merchant-grid{grid-template-columns:1fr}.steps{grid-template-columns:repeat(2,minmax(0,1fr))}.separation>a,.next-step>a{margin-top:14px}}
  @media(max-width:520px){.shell{padding:0 16px 64px}.hero{padding:34px 0 31px}.actions a{width:100%;justify-content:center}.section{padding-top:60px}.steps{grid-template-columns:1fr}.merchant{padding:21px}.separation>a,.next-step>a{width:100%;justify-content:center}}
</style>
