---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import { repairShopDirectory, type RepairShopDirectoryEntry, type RepairShopDirectorySource } from "../../../../data/repair-shop-directory";
export function getStaticPaths(){return repairShopDirectory.map((business: RepairShopDirectoryEntry)=>({params:{state:business.stateSlug,city:business.citySlug,slug:business.slug},props:{business}}));}
const {business}=Astro.props as { business: RepairShopDirectoryEntry };
const profileUrl=`https://hermeslogisticsus.com/businesses/${business.stateSlug}/${business.citySlug}/${business.slug}/`;
const faqItems=[
 {q:`Is ${business.businessName} a Hermes customer?`,a:"No. This is an unclaimed public directory profile and does not imply a commercial relationship with Hermes."},
 {q:"Can customers book this business through Hermes Connect?",a:"No. Public booking remains off until the business owner verifies the profile and activates Hermes Connect."},
 {q:"Are the listed services and prices owner-confirmed?",a:"The service descriptions come from bounded public-source research. They are not presented as an owner-confirmed current catalog, and no prices are asserted on this page."}
];
const schema=[
 {"@context":"https://schema.org","@type":"AutoRepair","@id":`${profileUrl}#business`,name:business.businessName,url:profileUrl,telephone:business.phone,areaServed:business.serviceArea.map((name: string)=>({"@type":"Place",name})),knowsAbout:business.services,mainEntityOfPage:profileUrl},
 {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Business Directory",item:"https://hermeslogisticsus.com/businesses/"},{"@type":"ListItem",position:2,name:`${business.city}, ${business.state}`,item:`https://hermeslogisticsus.com/businesses/${business.stateSlug}/${business.citySlug}/`},{"@type":"ListItem",position:3,name:business.businessName,item:profileUrl}]},
 {"@context":"https://schema.org","@type":"Service",name:`Public-source mobile auto repair service information for ${business.businessName}`,provider:{"@id":`${profileUrl}#business`},areaServed:business.serviceArea.map((name: string)=>({"@type":"Place",name})),serviceType:business.services,description:"Directory representation based on public sources. Current availability, prices, and the complete service catalog are not owner-confirmed."},
 {"@context":"https://schema.org","@type":"FAQPage",mainEntity:faqItems.map((item)=>({"@type":"Question",name:item.q,acceptedAnswer:{"@type":"Answer",text:item.a}}))}
];
const claimHref=`mailto:officeus@hermeslogisticsus.com?subject=${encodeURIComponent(`Claim Hermes directory profile: ${business.businessName}`)}`;
---
<BaseLayout title={`${business.businessName} | Mobile Auto Repair in ${business.city}, ${business.state}`} description={business.seoSummary} schema={schema}>
<SiteHeader activePath="/paths/technology/"/><main class="profile"><div class="shell"><nav class="crumb"><a href="/businesses/">Business Directory</a><span>→</span><a href={`/businesses/${business.stateSlug}/${business.citySlug}/`}>{business.city}, {business.state}</a></nav><header class="hero"><div><div class="badges"><span>Unclaimed profile</span><span>Not a Hermes customer</span></div><p class="eyebrow">{business.category} · {business.city}, {business.state}</p><h1>{business.businessName}</h1><p>{business.seoSummary}</p><div class="actions"><a class="primary" href={`tel:${business.phone.replace(/[^+\d]/g,"")}`}>Call {business.phone}</a><a class="secondary" href={claimHref}>Claim / activate this profile</a></div></div><aside><strong>Hermes Connect status</strong><dl><div><dt>Claim</dt><dd>Unclaimed</dd></div><div><dt>CRM</dt><dd>Not activated</dd></div><div><dt>Public booking</dt><dd>Off until owner verification</dd></div><div><dt>Google Business</dt><dd>Not confirmed in bounded search</dd></div></dl></aside></header><section class="two"><article><p class="eyebrow">Service area</p><h2>Mobile repair around Central Arkansas</h2><ul>{business.serviceArea.map((area: string)=><li>{area}</li>)}</ul></article><article><p class="eyebrow">Service evidence</p><h2>Services described in public listings</h2><ul>{business.services.map((service: string)=><li>{service}</li>)}</ul><p class="note">These are source-derived descriptions, not an owner-confirmed current price or service catalog.</p></article></section><section class="evidence"><div><p class="eyebrow">Verification</p><h2>Why this profile exists</h2><p>{business.verificationNote}</p><p class="verified">Verified {business.verifiedAt} · Source ref {business.sourceRef}</p></div><div class="sources">{business.sources.map((source: RepairShopDirectorySource)=><a href={source.url} target="_blank" rel="noreferrer noopener"><strong>{source.label}</strong><span>{source.observed}</span></a>)}</div></section><section class="faq"><p class="eyebrow">Directory FAQ</p><h2>What this profile does and does not mean</h2><div>{faqItems.map((item)=><article><h3>{item.q}</h3><p>{item.a}</p></article>)}</div></section><section class="seo"><p class="eyebrow">Hermes directory pilot</p><h2>What changes after the business claims this page?</h2><div><article><strong>1. Verified business profile</strong><p>Name, service area, hours, services, photos, contact details and official links become owner-confirmed.</p></article><article><strong>2. Hermes Connect CRM</strong><p>The business can activate appointments, customers, vehicles, team schedules, services and its shareable booking link.</p></article><article><strong>3. SEO / GEO operations</strong><p>Hermes can then maintain local landing content, structured data, citation consistency and search-performance measurement with the business’s approval.</p></article></div></section></div></main><SiteFooter/></BaseLayout>
<style>.profile{min-height:80vh;background:#f4f6f8;color:#172033}.shell{width:min(1160px,calc(100% - 2rem));margin:auto;padding:104px 0 90px}.crumb{display:flex;gap:8px;color:#748196;font-size:12px}.crumb a{color:#376d9e;text-decoration:none}.hero{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(270px,.65fr);gap:28px;margin-top:28px}.badges{display:flex;gap:7px;flex-wrap:wrap}.badges span{padding:6px 9px;border-radius:999px;background:#fff2d2;color:#775508;font-size:10px;font-weight:900;text-transform:uppercase}.eyebrow{margin:18px 0 7px;color:#2168a6;text-transform:uppercase;letter-spacing:.1em;font-size:11px;font-weight:900}.hero h1{margin:0;font-size:clamp(42px,6vw,70px);line-height:1}.hero>div>p:last-of-type{max-width:760px;color:#637185;line-height:1.7}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.actions a{display:inline-flex;align-items:center;min-height:44px;padding:0 15px;border-radius:11px;text-decoration:none;font-weight:850}.primary{background:#172033;color:#fff}.secondary{border:1px solid #dce3ea;background:#fff;color:#315676}.hero aside{align-self:start;padding:18px;border:1px solid #dfe5eb;border-radius:16px;background:#fff}.hero aside>strong{font-size:14px}.hero dl{margin:12px 0 0}.hero dl div{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-top:1px solid #edf0f3}.hero dt{color:#7a8797;font-size:11px}.hero dd{margin:0;text-align:right;font-size:11px;font-weight:850}.two{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px}.two article,.evidence,.faq,.seo{border:1px solid #dfe5eb;border-radius:18px;background:#fff;padding:22px}.two h2,.evidence h2,.faq h2,.seo h2{margin:0 0 10px}.two ul{padding-left:20px;color:#59687b;line-height:1.75}.note,.evidence p,.faq p,.seo p{color:#687688;line-height:1.65}.evidence{display:grid;grid-template-columns:.8fr 1.2fr;gap:24px;margin-top:14px}.verified{font-size:11px}.sources{display:grid;gap:8px}.sources a{display:grid;gap:3px;padding:12px;border:1px solid #e4e9ee;border-radius:11px;color:#24384d;text-decoration:none}.sources span{color:#718095;font-size:11px;line-height:1.45}.faq,.seo{margin-top:14px}.faq>div{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.faq article{padding:15px;border-radius:12px;background:#f7f9fb}.faq h3{margin:0 0 8px;font-size:14px}.faq p{margin:0;font-size:12px}.seo>div{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.seo article{padding:15px;border-radius:12px;background:#f7f9fb}.seo article strong{font-size:13px}.seo article p{font-size:12px}@media(max-width:800px){.hero,.two,.evidence,.faq>div,.seo>div{grid-template-columns:1fr}.shell{padding-top:92px}}</style>
