---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import DirectionProductNav from "../../../../components/DirectionProductNav.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import { repairShopDirectory, type RepairShopDirectoryEntry, type RepairShopDirectorySource } from "../../../../data/repair-shop-directory";
import { buildCatalogRequestHref } from "../../../../lib/catalog-request";
import CatalogConceptRoute from "../../../../components/CatalogConceptRoute.astro";
import CatalogDigitalAudit from "../../../../components/CatalogDigitalAudit.astro";
import { catalogConceptBusinessRoutes, type CatalogConceptBusinessRoute } from "../../../../lib/catalog-concept-routes";
export function getStaticPaths(){
  const us = repairShopDirectory.map((business: RepairShopDirectoryEntry)=>({
    params:{state:business.stateSlug,city:business.citySlug,slug:business.slug},
    props:{kind:"repair" as const,business}
  }));
  const international = catalogConceptBusinessRoutes.map((route: CatalogConceptBusinessRoute)=>({
    params:{state:route.countrySlug,city:route.localitySlug,slug:route.slug},
    props:{kind:"concept" as const,business:route.business}
  }));
  return [...us, ...international];
}
const {kind,business:routeBusiness}=Astro.props as { kind:"repair"|"concept"; business:RepairShopDirectoryEntry|CatalogConceptBusinessRoute["business"] };
const business=routeBusiness as RepairShopDirectoryEntry;
const conceptBusiness=routeBusiness as CatalogConceptBusinessRoute["business"];
const repairServiceArea = kind === "repair" ? business.serviceArea : [];
const repairCategory = kind === "repair" ? business.category : "";
const profileUrl=`https://hermeslogisticsus.com/businesses/${business.stateSlug}/${business.citySlug}/${business.slug}/`;
const stateUrl=`https://hermeslogisticsus.com/businesses/${business.stateSlug}/`;
const cityUrl=`https://hermeslogisticsus.com/businesses/${business.stateSlug}/${business.citySlug}/`;
const catalogIdentityKey=`${business.stateSlug}/${business.citySlug}/${business.slug}`;
const catalogBusinessId=`repair-shop:${catalogIdentityKey}`;
const mapsHref=business.streetAddress
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${business.streetAddress}, ${business.city}, ${business.state}, ${business.country}`)}`
  : "";
const rawProfileTitle=kind==="repair"?`${business.businessName} | ${business.category} in ${business.city}, ${business.state}`:"Hermes Catalog";
const compactBusinessName=kind==="repair"?business.businessName.replace(/\s+(?:Shop|LLC)$/i,"").trim():"Hermes Catalog";
const compactProfileTitle=kind==="repair"?`${compactBusinessName} | ${business.city}, ${business.state}`:"Hermes Catalog";
const profileTitle=rawProfileTitle.length<=60?rawProfileTitle:compactProfileTitle;
const carrierRelevant=/truck|diesel|fleet|trailer|commercial/i.test([business.category,...business.services].join(" "));
const faqItems=[
 {q:`Is ${business.businessName} a Hermes customer?`,a:"No. This is an unclaimed public Catalog profile and does not imply a commercial relationship with Hermes."},
 {q:"Can customers book this business through Hermes Connect?",a:"No. Public booking remains off until the business owner verifies the profile and activates Hermes Connect."},
 {q:"Are the listed services and prices owner-confirmed?",a:"The service descriptions come from bounded public-source research. They are not presented as an owner-confirmed current catalog, and no prices are asserted on this page."}
];
const schema=[
 {"@context":"https://schema.org","@type":"AutoRepair","@id":`${profileUrl}#business`,name:business.businessName,url:profileUrl,telephone:business.phone,areaServed:repairServiceArea.map((name: string)=>({"@type":"Place",name})),knowsAbout:business.services,mainEntityOfPage:profileUrl,...(mapsHref?{hasMap:mapsHref}:{}),...(business.streetAddress?{address:{"@type":"PostalAddress",streetAddress:business.streetAddress,addressLocality:business.city,addressRegion:business.state,addressCountry:business.country}}:{}),...(business.website?{sameAs:[business.website]}:{})},
 {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Hermes Catalog",item:"https://hermeslogisticsus.com/businesses/"},{"@type":"ListItem",position:2,name:business.region,item:stateUrl},{"@type":"ListItem",position:3,name:`${business.city}, ${business.state}`,item:cityUrl},{"@type":"ListItem",position:4,name:business.businessName,item:profileUrl}]},
 {"@context":"https://schema.org","@type":"Service",name:`Public-source ${repairCategory.toLowerCase()} information for ${business.businessName}`,provider:{"@id":`${profileUrl}#business`},areaServed:repairServiceArea.map((name: string)=>({"@type":"Place",name})),serviceType:business.services,description:"Hermes Catalog profile based on public sources. Current availability, prices, and the complete service catalog are not owner-confirmed."},
 {"@context":"https://schema.org","@type":"FAQPage",mainEntity:faqItems.map((item)=>({"@type":"Question",name:item.q,acceptedAnswer:{"@type":"Answer",text:item.a}}))}
];
const profilePath=`/businesses/${business.stateSlug}/${business.citySlug}/${business.slug}/`;
const claimHref=`/businesses/request/?${new URLSearchParams({type:"claim",business:business.businessName,profile:profilePath,city:business.city,state:business.state,country:"US",identity:catalogIdentityKey,evidence:business.sourceRef})}`;
const businessRequestHref=buildCatalogRequestHref("catalog-business-request",{
  businessId:catalogBusinessId,
  businessName:business.businessName,
  profileUrl,
  city:business.city,
  country:business.country,
  sourceRef:business.sourceRef,
});
const auditRequestHref=buildCatalogRequestHref("marketing-package",{
  businessId:catalogBusinessId,
  businessName:business.businessName,
  profileUrl,
  city:business.city,
  country:business.country,
  sourceRef:business.sourceRef,
},"Digital marketing audit");
const socialPlatformLabel=(url:string)=>{
  const raw=url.toLowerCase();
  if(raw.includes("instagram.com")) return "Instagram";
  if(raw.includes("facebook.com")) return "Facebook";
  if(raw.includes("threads.com")||raw.includes("threads.net")) return "Threads";
  if(raw.includes("tiktok.com")) return "TikTok";
  if(raw.includes("youtube.com")||raw.includes("youtu.be")) return "YouTube";
  if(raw.includes("t.me")||raw.includes("telegram.me")) return "Telegram";
  return null;
};
const repairAuditBusiness={
  website:kind==="repair"?business.website:undefined,
  channels:kind==="repair"?business.sources.flatMap((source:RepairShopDirectorySource)=>{
    const label=socialPlatformLabel(source.url);
    return label?[{label,url:source.url,direction:"secondary" as const}]:[];
  }):[],
};
---
{kind === "concept" ? <CatalogConceptRoute business={conceptBusiness} /> : (<BaseLayout title={profileTitle} description={business.seoSummary} schema={schema}>
<SiteHeader theme="light" activePath="/businesses/"/><DirectionProductNav direction="catalog" theme="light" /><main class="profile"><div class="shell"><nav class="crumb"><a href="/businesses/">Hermes Catalog</a><span>→</span><a href={`/businesses/${business.stateSlug}/`}>{business.region}</a><span>→</span><a href={`/businesses/${business.stateSlug}/${business.citySlug}/`}>{business.city}, {business.state}</a></nav><header class="catalog-profile-hero"><div><div class="badges"><span>Unclaimed profile</span><span>Not a Hermes customer</span></div><p class="eyebrow">{business.category} · {business.city}, {business.state}</p><h1>{business.businessName}</h1><p>{business.seoSummary}</p><div class="actions"><a class="primary" data-catalog-event="call_click" href={`tel:${business.phone.replace(/[^+\d]/g,"")}`}>Call {business.phone}</a><a class="secondary" data-catalog-event="request_start" href={businessRequestHref}>Request service / contact</a>{mapsHref&&<a class="secondary" data-catalog-event="maps_click" href={mapsHref} target="_blank" rel="noreferrer noopener">Directions</a>}<a class="secondary" data-catalog-event="claim_start" href={claimHref}>Request claim / verification</a></div></div><aside><strong>Hermes Connect status</strong><dl><div><dt>Claim</dt><dd>Unclaimed</dd></div><div><dt>CRM</dt><dd>Not linked to this profile</dd></div><div><dt>Public booking</dt><dd>Off until owner verification</dd></div><div><dt>Google Business</dt><dd>{business.googleBusinessStatus==="confirmed"?"Confirmed":"Not confirmed in bounded search"}</dd></div></dl></aside></header>{business.websiteConcept&&<section class="website-concept"><div class="concept-copy"><p class="eyebrow">{business.websiteConcept.eyebrow}</p><h2>{business.websiteConcept.headline}</h2><p>{business.websiteConcept.lead}</p><div class="concept-themes">{business.websiteConcept.searchThemes.map((theme: string)=><span>{theme}</span>)}</div><div class="concept-links">{business.website&&<a data-catalog-event="website_click" href={business.website} target="_blank" rel="noreferrer noopener">Current business website →</a>}<a href="/services/website-development/">Website development →</a><a href="/services/seo-for-auto-repair-shops/">Repair-shop SEO / GEO →</a><a href="/services/hermes-connect/repair-shops/">Hermes Connect CRM →</a></div><p class="concept-disclaimer">Concept preview only. It does not replace or impersonate the business’s current official website and does not imply a Hermes customer relationship.</p></div><div class="concept-browser" aria-label={`Website concept preview for ${business.businessName}`}><div class="browser-top"><span></span><span></span><span></span><b>{business.businessName}</b></div><div class="browser-body"><p>{business.category} · {business.city}, {business.state}</p><h3>{business.websiteConcept.headline}</h3><small>Example homepage structure based on verified public business facts</small><div class="concept-services">{business.services.slice(0,4).map((service: string)=><em>{service}</em>)}</div>{business.hours&&<div class="concept-hours">{business.hours.map((line: string)=><span>{line}</span>)}</div>}<div class="concept-cta"><strong>Call {business.phone}</strong><span>View services</span></div></div></div></section>}<section class="two"><article><p class="eyebrow">Service area</p><h2>{business.category} service area</h2><ul>{business.serviceArea.map((area: string)=><li>{area}</li>)}</ul></article><article><p class="eyebrow">Service evidence</p><h2>Services described in public sources</h2><ul>{business.services.map((service: string)=><li>{service}</li>)}</ul><p class="note">These are source-derived descriptions, not an owner-confirmed current price or service catalog.</p></article></section><CatalogDigitalAudit business={repairAuditBusiness} requestHref={auditRequestHref} defaultLocale="en" /><section class="evidence"><div><p class="eyebrow">Verification</p><h2>Why this profile exists</h2><p>{business.verificationNote}</p><p class="verified">Verified {business.verifiedAt} · Source ref {business.sourceRef}</p></div><div class="sources">{business.sources.map((source: RepairShopDirectorySource)=><a href={source.url} target="_blank" rel="noreferrer noopener"><strong>{source.label}</strong><span>{source.observed}</span></a>)}</div></section>{carrierRelevant&&<section class="carrier-bridge"><p class="eyebrow">For commercial drivers and carriers</p><h2>Repair discovery and carrier operations stay connected, but separate.</h2><p>If you operate a commercial truck, trailer, fleet, or car hauler, Hermes Catalog can help you discover repair options. Hermes also has separate carrier tools for load planning and day-to-day operations. Those Hermes services are not provided by, endorsed by, or bundled with the repair business listed on this page.</p><div><a href="/logistics/car-hauling-dispatch/">Car-hauling dispatch support →</a><a href="/logistics/car-hauler-loads/">Car-hauler load planning →</a><a href="/load-board/">Hermes Load Board →</a><a href="/logistics/start-car-hauling-dispatch/">Request a carrier operations review →</a></div></section>}<section class="faq"><p class="eyebrow">Catalog FAQ</p><h2>What this profile does and does not mean</h2><div>{faqItems.map((item)=><article><h3>{item.q}</h3><p>{item.a}</p></article>)}</div></section><section class="seo"><p class="eyebrow">Hermes Catalog</p><h2>What changes after the business claims this page?</h2><div><article><strong>1. Verified business profile</strong><p>Name, service area, hours, services, photos, contact details and official links become owner-confirmed.</p></article><article><strong>2. Hermes Connect CRM</strong><p>The business can activate appointments, customers, vehicles, team schedules, services and its shareable booking link.</p></article><article><strong>3. SEO / GEO operations</strong><p>Hermes can then maintain local landing content, structured data, citation consistency and search-performance measurement with the business’s approval.</p></article></div></section></div></main><SiteFooter/></BaseLayout>)}
<script is:inline src="/catalog-business-telemetry.js" data-catalog-business-id={catalogBusinessId}></script>
<script is:inline src="/catalog-traffic-stats.js" data-catalog-traffic-loader defer></script>
<style>.profile{min-height:80vh;background:#f4f6f8;color:#172033}.shell{width:min(1160px,calc(100% - 2rem));margin:auto;padding:32px 0 72px}.crumb{display:flex;gap:8px;flex-wrap:wrap;color:#748196;font-size:12px}.crumb a{color:#376d9e;text-decoration:none}.profile .catalog-profile-hero{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(270px,.65fr);gap:clamp(20px,3vw,38px);margin-top:24px;padding:clamp(22px,3vw,38px);background:#fff;color:#172033;border:1px solid #dfe5eb;border-radius:20px;box-shadow:0 14px 44px rgba(22,38,66,.05)}.catalog-profile-hero>div{min-width:0}.badges{display:flex;gap:7px;flex-wrap:wrap}.badges span{padding:6px 9px;border-radius:999px;background:#fff2d2;color:#775508;font-size:10px;font-weight:900;text-transform:uppercase}.eyebrow{margin:18px 0 7px;color:#2168a6;text-transform:uppercase;letter-spacing:.1em;font-size:11px;font-weight:900}.catalog-profile-hero h1{margin:0;font-size:clamp(36px,4.5vw,64px);line-height:1.08;overflow-wrap:anywhere;letter-spacing:-.035em}.catalog-profile-hero>div>p:last-of-type{max-width:760px;color:#637185;line-height:1.7}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.actions a{display:inline-flex;align-items:center;min-height:44px;padding:0 15px;border-radius:11px;text-decoration:none;font-weight:850}.primary{background:#172033;color:#fff}.secondary{border:1px solid #dce3ea;background:#fff;color:#315676}.catalog-profile-hero aside{align-self:start;min-width:0;padding:20px;border:1px solid #dfe8f4;border-radius:16px;background:#f7faff}.catalog-profile-hero aside>strong{font-size:14px}.catalog-profile-hero dl{margin:12px 0 0}.catalog-profile-hero dl div{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-top:1px solid #edf0f3}.catalog-profile-hero dt{color:#7a8797;font-size:11px}.catalog-profile-hero dd{margin:0;text-align:right;font-size:11px;font-weight:850}.website-concept{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.9fr);gap:22px;margin-top:14px;padding:22px;border:1px solid #dfe5eb;border-radius:18px;background:#fff}.concept-copy h2{margin:0 0 10px;font-size:clamp(24px,3vw,38px);letter-spacing:-.025em}.concept-copy>p{color:#687688;line-height:1.65}.concept-themes{display:flex;gap:7px;flex-wrap:wrap;margin-top:14px}.concept-themes span{padding:7px 9px;border-radius:999px;background:#edf6ff;color:#235f91;font-size:11px;font-weight:800}.concept-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.concept-links a{display:inline-flex;align-items:center;min-height:38px;padding:0 10px;border:1px solid #d8e4ee;border-radius:9px;color:#1767ad;text-decoration:none;font-size:11px;font-weight:850}.concept-disclaimer{font-size:10px}.concept-browser{overflow:hidden;border:1px solid #d9e2ea;border-radius:16px;background:#f4f8fc;box-shadow:0 18px 40px rgba(30,55,85,.08)}.browser-top{display:flex;align-items:center;gap:6px;padding:10px 12px;border-bottom:1px solid #e1e7ed;background:#fff}.browser-top span{width:8px;height:8px;border-radius:999px;background:#cdd6df}.browser-top b{margin-left:6px;color:#687688;font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.browser-body{padding:28px}.browser-body>p{margin:0;color:#2168a6;text-transform:uppercase;letter-spacing:.08em;font-size:10px;font-weight:900}.browser-body h3{margin:8px 0;font-size:clamp(25px,3vw,38px);line-height:1.05;letter-spacing:-.035em}.browser-body small{display:block;color:#6d7a8a;line-height:1.5}.concept-services{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:18px}.concept-services em{padding:9px;border:1px solid #dfe8f0;border-radius:9px;background:#fff;color:#35485b;font-size:10px;font-style:normal;font-weight:750}.concept-hours{display:grid;gap:3px;margin-top:12px;color:#657385;font-size:10px}.concept-cta{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.concept-cta strong,.concept-cta span{display:inline-flex;align-items:center;min-height:36px;padding:0 10px;border-radius:9px;font-size:10px}.concept-cta strong{background:#172033;color:#fff}.concept-cta span{border:1px solid #d5e0e9;background:#fff;color:#315676}.two{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px}.two article,.evidence,.faq,.seo,.carrier-bridge{border:1px solid #dfe5eb;border-radius:18px;background:#fff;padding:22px}.two h2,.evidence h2,.faq h2,.seo h2,.carrier-bridge h2{margin:0 0 10px}.two ul{padding-left:20px;color:#59687b;line-height:1.75}.note,.evidence p,.faq p,.seo p,.carrier-bridge p{color:#687688;line-height:1.65}.evidence{display:grid;grid-template-columns:.8fr 1.2fr;gap:24px;margin-top:14px}.verified{font-size:11px}.sources{display:grid;gap:8px}.sources a{display:grid;gap:3px;padding:12px;border:1px solid #e4e9ee;border-radius:11px;color:#24384d;text-decoration:none}.sources span{color:#718095;font-size:11px;line-height:1.45}.carrier-bridge{margin-top:14px;background:#f7fbff}.carrier-bridge>div{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px}.carrier-bridge a{display:inline-flex;min-height:42px;align-items:center;padding:0 12px;border:1px solid #cdddec;border-radius:10px;background:#fff;color:#1767ad;text-decoration:none;font-size:12px;font-weight:850}.faq,.seo{margin-top:14px}.faq>div{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.faq article{padding:15px;border-radius:12px;background:#f7f9fb}.faq h3{margin:0 0 8px;font-size:14px}.faq p{margin:0;font-size:12px}.seo>div{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.seo article{padding:15px;border-radius:12px;background:#f7f9fb}.seo article strong{font-size:13px}.seo article p{font-size:12px}@media(max-width:800px){.profile .catalog-profile-hero,.website-concept,.two,.evidence,.faq>div,.seo>div{grid-template-columns:1fr}.shell{padding-top:24px}}</style>
