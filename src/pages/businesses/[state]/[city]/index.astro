---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import DirectionProductNav from "../../../../components/DirectionProductNav.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import { directoryCities, repairShopDirectory, type RepairShopDirectoryEntry } from "../../../../data/repair-shop-directory";
type DirectoryCity = (typeof directoryCities)[number];
export function getStaticPaths(){return directoryCities.map((city: DirectoryCity)=>({params:{state:city.stateSlug,city:city.citySlug},props:{city}}));}
const {city}=Astro.props as { city: DirectoryCity };
const rows: RepairShopDirectoryEntry[] = repairShopDirectory.filter((b: RepairShopDirectoryEntry)=>b.stateSlug===city.stateSlug&&b.citySlug===city.citySlug);
const cityUrl=`https://hermeslogisticsus.com/businesses/${city.stateSlug}/${city.citySlug}/`;
const categories=[...new Set(rows.map((business)=>business.category))];
const services=[...new Set(rows.flatMap((business)=>business.services))];
const serviceAreas=[...new Set(rows.flatMap((business)=>business.serviceArea))];
const schema=[
  {"@context":"https://schema.org","@type":"CollectionPage",name:`Auto repair businesses in ${city.city}, ${city.state}`,url:cityUrl,mainEntity:{"@type":"ItemList",itemListElement:rows.map((b,i)=>({"@type":"ListItem",position:i+1,url:`https://hermeslogisticsus.com/businesses/${b.stateSlug}/${b.citySlug}/${b.slug}/`,name:b.businessName}))}},
  {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Hermes Catalog",item:"https://hermeslogisticsus.com/businesses/"},{"@type":"ListItem",position:2,name:`${city.city}, ${city.state}`,item:cityUrl}]}
];
---
<BaseLayout title={`Vehicle Repair Businesses in ${city.city}, ${city.state} | Hermes Catalog`} description={`Evidence-backed vehicle repair and service business profiles for ${city.city}, ${city.state}, with claim state, service context, and public-source verification.`} schema={schema}>
<SiteHeader theme="light" activePath="/businesses/"/><DirectionProductNav direction="catalog" theme="light" /><main class="city"><div class="shell"><a class="back" href={`/businesses/${city.stateSlug}/`}>← {city.region} Catalog</a><header><p class="eyebrow">Hermes Catalog · {city.region}</p><h1>Vehicle repair businesses in {city.city}, {city.state}</h1><p>Use this page to compare the evidence-backed repair categories and service coverage currently represented in Hermes Catalog. Profiles remain separate from Hermes customer accounts until an authorized owner claims and verifies one.</p><p class="directory-note">Public booking, CRM, team scheduling, and owner-controlled business details stay off until verified activation. A Catalog listing is discovery evidence, not a Hermes endorsement or customer relationship.</p></header><section class="summary" aria-label="City directory summary"><div><strong>{rows.length}</strong><span>business profile{rows.length===1?"":"s"}</span></div><div><strong>{categories.length}</strong><span>repair categor{categories.length===1?"y":"ies"}</span></div><div><strong>{services.length}</strong><span>source-described service{services.length===1?"":"s"}</span></div></section><section class="context"><div><p class="eyebrow">Repair categories</p><h2>What is represented in {city.city}</h2><ul>{categories.map((category)=><li>{category}</li>)}</ul></div><div><p class="eyebrow">Service coverage</p><h2>Areas named by current sources</h2><ul>{serviceAreas.slice(0,8).map((area)=><li>{area}</li>)}</ul></div></section><section class="grid">{rows.map((b)=><article><div><span class="claim">{b.claimState}</span><h2>{b.businessName}</h2><p>{b.category} · {b.city}, {b.state}</p></div><p>{b.seoSummary}</p><p class="services"><strong>Source-described services:</strong> {b.services.slice(0,5).join(", ")}{b.services.length>5?"…":""}</p><a href={`/businesses/${b.stateSlug}/${b.citySlug}/${b.slug}/`}>Open evidence-backed profile →</a></article>)}</section><section class="evidence"><h2>How to interpret this Catalog</h2><p>Hermes publishes only the business facts supported by the cited public sources for each profile. Owners can claim a profile to correct details and decide whether to activate Hermes Connect. Until then, availability, pricing, appointment capacity, and a commercial relationship with Hermes are not implied.</p></section></div></main><SiteFooter/></BaseLayout>
<style>.city{min-height:70vh;background:#f6f7f9;color:#172033}.shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:110px 0 80px}.back{color:#47729e;text-decoration:none;font-weight:800}.eyebrow{margin:28px 0 8px;color:#2168a6;text-transform:uppercase;letter-spacing:.1em;font-size:11px;font-weight:900}h1{max-width:850px;margin:0;font-size:clamp(36px,5vw,62px);line-height:1.04}header>p,.evidence p{max-width:800px;color:#657286;line-height:1.65}.directory-note{padding:13px 15px;border-left:3px solid #6ea8df;background:#eef5fb;border-radius:0 10px 10px 0}.summary{display:flex;flex-wrap:wrap;gap:12px;margin:26px 0}.summary div{min-width:155px;padding:17px;border:1px solid #e0e6ed;border-radius:14px;background:#fff}.summary strong{display:block;font-size:27px}.summary span{color:#718095;font-size:12px}.context{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:24px}.context>div,.evidence{padding:20px;border:1px solid #e0e6ed;border-radius:16px;background:#fff}.context .eyebrow{margin-top:0}.context h2{margin:0 0 8px;font-size:20px}.context ul{margin:0;padding-left:20px;color:#647286;line-height:1.65}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:20px}.grid article{display:grid;gap:14px;padding:20px;border:1px solid #e0e6ed;border-radius:16px;background:#fff}.grid article h2{margin:8px 0 3px}.grid article p{margin:0;color:#677587;line-height:1.55}.claim{display:inline-flex;padding:5px 8px;border-radius:999px;background:#fff4d7;color:#79590a;text-transform:uppercase;font-size:10px;font-weight:900}.services{font-size:12px}.grid article a{color:#1969b5;text-decoration:none;font-weight:850}.evidence{max-width:850px;margin-top:20px;background:#eef5fb}.evidence h2{margin-top:0}@media(max-width:760px){.context,.grid{grid-template-columns:1fr}.summary{display:grid;grid-template-columns:1fr 1fr}.summary div:last-child{grid-column:1/-1}}</style>
