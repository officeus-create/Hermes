---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import { directoryCities, repairShopDirectory, type RepairShopDirectoryEntry } from "../../../../data/repair-shop-directory";
type DirectoryCity = (typeof directoryCities)[number];
export function getStaticPaths(){return directoryCities.map((city: DirectoryCity)=>({params:{state:city.stateSlug,city:city.citySlug},props:{city}}));}
const {city}=Astro.props as { city: DirectoryCity }; const rows: RepairShopDirectoryEntry[] = repairShopDirectory.filter((b: RepairShopDirectoryEntry)=>b.stateSlug===city.stateSlug&&b.citySlug===city.citySlug);
const schema={"@context":"https://schema.org","@type":"CollectionPage",name:`Auto repair businesses in ${city.city}, ${city.state}`,url:`https://hermeslogisticsus.com/businesses/${city.stateSlug}/${city.citySlug}/`,mainEntity:{"@type":"ItemList",itemListElement:rows.map((b,i)=>({"@type":"ListItem",position:i+1,url:`https://hermeslogisticsus.com/businesses/${b.stateSlug}/${b.citySlug}/${b.slug}/`,name:b.businessName}))}};
---
<BaseLayout title={`Auto Repair Businesses in ${city.city}, ${city.state} | Hermes Directory`} description={`Evidence-backed auto repair business profiles for ${city.city}, ${city.state}, including claim state and public-source verification.`} schema={schema}>
<SiteHeader activePath="/paths/technology/"/><main class="city"><div class="shell"><a class="back" href="/businesses/">← Business Directory</a><header><p class="eyebrow">{city.region} · Local business directory</p><h1>Auto repair businesses in {city.city}, {city.state}</h1><p>Profiles below are separated from Hermes customer accounts. Booking is only enabled after verified owner activation.</p></header><section class="grid">{rows.map((b)=><article><div><span class="claim">{b.claimState}</span><h2>{b.businessName}</h2><p>{b.category} · {b.city}, {b.state}</p></div><p>{b.seoSummary}</p><a href={`/businesses/${b.stateSlug}/${b.citySlug}/${b.slug}/`}>Open verified profile →</a></article>)}</section></div></main><SiteFooter/></BaseLayout>
<style>.city{min-height:70vh;background:#f6f7f9;color:#172033}.shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:110px 0 80px}.back{color:#47729e;text-decoration:none;font-weight:800}.eyebrow{margin:28px 0 8px;color:#2168a6;text-transform:uppercase;letter-spacing:.1em;font-size:11px;font-weight:900}h1{max-width:850px;margin:0;font-size:clamp(36px,5vw,62px);line-height:1.04}header>p:last-child{max-width:780px;color:#657286;line-height:1.65}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:30px}article{display:grid;gap:14px;padding:20px;border:1px solid #e0e6ed;border-radius:16px;background:#fff}article h2{margin:8px 0 3px}article p{margin:0;color:#677587;line-height:1.55}.claim{display:inline-flex;padding:5px 8px;border-radius:999px;background:#fff4d7;color:#79590a;text-transform:uppercase;font-size:10px;font-weight:900}article a{color:#1969b5;text-decoration:none;font-weight:850}@media(max-width:760px){.grid{grid-template-columns:1fr}}</style>
