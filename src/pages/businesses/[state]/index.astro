---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DirectionProductNav from "../../../components/DirectionProductNav.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { directoryStates, directoryCities, repairShopDirectory, type RepairShopDirectoryEntry } from "../../../data/repair-shop-directory";

type DirectoryState = (typeof directoryStates)[number];
export function getStaticPaths(){
  return directoryStates.map((state: DirectoryState)=>({params:{state:state.slug},props:{state}}));
}
const {state}=Astro.props as { state: DirectoryState };
const rows: RepairShopDirectoryEntry[] = repairShopDirectory.filter((business)=>business.stateSlug===state.slug);
const cities = directoryCities.filter((city)=>city.stateSlug===state.slug);
const categories = [...new Set(rows.map((business)=>business.category))];
const serviceTerms = [...new Set(rows.flatMap((business)=>business.services))].slice(0,10);
const serviceAreas = [...new Set(rows.flatMap((business)=>business.serviceArea))].slice(0,8);
const stateUrl=`https://hermeslogisticsus.com/businesses/${state.slug}/`;
const schema=[
  {"@context":"https://schema.org","@type":"CollectionPage",name:`Repair businesses in ${state.name}`,url:stateUrl,mainEntity:{"@type":"ItemList",itemListElement:rows.map((business,index)=>({"@type":"ListItem",position:index+1,url:`https://hermeslogisticsus.com/businesses/${business.stateSlug}/${business.citySlug}/${business.slug}/`,name:business.businessName}))}},
  {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Hermes Catalog",item:"https://hermeslogisticsus.com/businesses/"},{"@type":"ListItem",position:2,name:state.name,item:stateUrl}]}
];
---
<BaseLayout title={`Repair Businesses in ${state.name} | Hermes Catalog`} description={`Evidence-backed repair and service business profiles in ${state.name}, grouped by city with source notes, claim state, and owner-verification boundaries.`} schema={schema}>
<SiteHeader theme="light" activePath="/businesses/"/><DirectionProductNav direction="catalog" theme="light" />
<main class="state-page"><div class="shell">
  <a class="back" href="/businesses/">← Hermes Catalog</a>
  <header><p class="eyebrow">Hermes Catalog · {state.name}</p><h1>Repair businesses in {state.name}</h1><p>This page contains only businesses for which Hermes currently has enough bounded public-source evidence to publish a useful profile. It is not a complete list of repair businesses in {state.name}. Unclaimed listings remain separate from Hermes customer accounts, and private CRM, scheduling, and booking features stay off until an authorized owner verifies the profile.</p></header>
  <section class="summary" aria-label="State directory summary"><div><strong>{rows.length}</strong><span>business profile{rows.length===1?"":"s"}</span></div><div><strong>{cities.length}</strong><span>city location{cities.length===1?"":"s"}</span></div><div><strong>{categories.length}</strong><span>service categor{categories.length===1?"y":"ies"}</span></div></section>
  <section class="coverage"><div><p class="eyebrow">Current evidence-backed coverage</p><h2>What this {state.name} directory currently contains</h2><p>The categories and service terms below come from the live profiles on this page. They describe current public-source coverage only; they do not claim that every business offers every service or that Hermes has mapped the whole state.</p></div><div class="coverage-grid"><article><h3>Business categories</h3><ul>{categories.map((category)=><li>{category}</li>)}</ul></article><article><h3>Service terms in current profiles</h3><ul>{serviceTerms.map((service)=><li>{service}</li>)}</ul></article><article><h3>Published service areas</h3><ul>{serviceAreas.map((area)=><li>{area}</li>)}</ul></article></div></section>
  <section class="cities"><h2>Browse {state.name} by city</h2>{cities.map((city)=><a href={`/businesses/${city.stateSlug}/${city.citySlug}/`}><strong>{city.city}, {city.state}</strong><span>{rows.filter((business)=>business.citySlug===city.citySlug).length} profile</span></a>)}</section>
  <section class="evidence"><h2>How a listing becomes active</h2><p>Hermes first reconciles a business identity against bounded public evidence such as an official site, government or federal record, or established directory source. A public profile may then be published as unclaimed with its source boundary visible. The owner can claim the profile, verify or correct business details, and independently choose whether to activate Hermes Connect scheduling, CRM, team management, or public booking.</p><p>When a source cannot confirm a fact, Hermes leaves it unknown rather than inventing it. A Google Business Profile marked as “not confirmed” means only that the bounded research did not independently verify one; it is not proof that no Google listing exists.</p></section>
</div></main><SiteFooter/>
</BaseLayout>
<style>
.state-page{min-height:70vh;background:#f6f7f9;color:#172033}.shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:110px 0 80px}.back{color:#47729e;text-decoration:none;font-weight:800}.eyebrow{margin:28px 0 8px;color:#2168a6;text-transform:uppercase;letter-spacing:.1em;font-size:11px;font-weight:900}h1{max-width:850px;margin:0;font-size:clamp(36px,5vw,62px);line-height:1.04}header>p,.evidence p,.coverage>div>p{max-width:850px;color:#657286;line-height:1.65}.summary{display:flex;flex-wrap:wrap;gap:12px;margin:28px 0}.summary div{min-width:150px;padding:18px;border:1px solid #e0e6ed;border-radius:15px;background:#fff}.summary strong{display:block;font-size:30px}.summary span{color:#718095;font-size:13px}.coverage{margin-top:30px;padding:22px;border:1px solid #e0e6ed;border-radius:18px;background:#fff}.coverage .eyebrow{margin-top:0}.coverage h2{margin:.2rem 0 .5rem}.coverage-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:18px}.coverage-grid article{padding:16px;border-radius:13px;background:#f7f9fb}.coverage-grid h3{margin:0 0 8px;font-size:14px}.coverage-grid ul{margin:0;padding-left:18px;color:#647286;line-height:1.65;font-size:13px}.cities{display:grid;gap:12px;margin-top:30px}.cities h2{margin-bottom:2px}.cities>a{display:flex;justify-content:space-between;gap:16px;padding:18px;border:1px solid #e0e6ed;border-radius:14px;background:#fff;color:#1e2d40;text-decoration:none}.cities span{color:#718095;font-size:13px}.evidence{max-width:900px;margin-top:32px;padding:22px;border:1px solid #dce5ef;border-radius:16px;background:#eef5fb}.evidence p:last-child{margin-bottom:0}@media(max-width:760px){.summary{display:grid;grid-template-columns:1fr 1fr}.coverage-grid{grid-template-columns:1fr}.cities>a{display:grid}}
</style>
