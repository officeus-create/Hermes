---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import DirectionProductNav from "../../../../components/DirectionProductNav.astro";
import CatalogWebsiteConcept from "../../../../components/CatalogWebsiteConcept.astro";
import { mangalIKazanConcept as business } from "../../../../data/catalog-business-concepts";
import { buildCatalogFaqItems, buildInternationalCatalogSchema, catalogProfileDescription } from "../../../../lib/catalog-business-schema";

const profilePath="/businesses/ukraine/chaiky/mangal-i-kazan/";
const profileUrl=`https://hermeslogisticsus.com${profilePath}`;
const schema=buildInternationalCatalogSchema(business,profileUrl);
const faqItems=buildCatalogFaqItems(business);
---
<BaseLayout title="Мангал і Казан у Чайках | Халяль ресторан і доставка | Hermes Catalog" description={catalogProfileDescription(business)} schema={schema}>
  <SiteHeader theme="light" activePath="/businesses/" />
  <DirectionProductNav direction="catalog" theme="light" />
  <main class="international-profile"><div class="shell">
    <nav><a href="/businesses/">Hermes Catalog</a><span>→</span><a href="/businesses/international/">International</a><span>→</span><a href="/businesses/ukraine/">Ukraine</a><span>→</span><a href="/businesses/ukraine/chaiky/">Чайки</a></nav>
    <CatalogWebsiteConcept business={business} profileUrl={profileUrl} />
    <section class="context">
      <div><p class="eyebrow">LOCAL DISCOVERY</p><h2>Халяль ресторан і доставка по ЖК Чайки</h2><p>Офіційний сайт бізнесу публічно вказує адресу, телефон, щоденний графік, халяльне меню та доставку по ЖК Чайки. Hermes не змінює ці факти і не публікує непідтверджені ціни або наявність страв.</p></div>
      <div><p class="eyebrow">HERMES CONNECT</p><h2>Restaurant CRM preview</h2><p>Базовий Hermes Connect доповнюється меню, позиціями та модифікаторами, заявками/замовленнями, доставкою або самовивозом, статусами замовлень та історією повторних клієнтів.</p><a href="/services/hermes-connect/demos/mangal-i-kazan/">Open restaurant CRM preview →</a></div>
    </section>
    <section class="faq" aria-labelledby="catalog-faq-title">
      <p class="eyebrow">CATALOG FAQ</p><h2 id="catalog-faq-title">What this profile means</h2>
      <div>{faqItems.map((item)=><article><h3>{item.q}</h3><p>{item.a}</p></article>)}</div>
    </section>
  </div></main>
  <SiteFooter />
</BaseLayout>
<style>
.international-profile{background:#f5f6f3;color:#17211e}.shell{width:min(1160px,calc(100% - 32px));margin:auto;padding:36px 0 78px}.shell>nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px;font-size:12px}.shell>nav a{color:#376d9e;text-decoration:none}.shell>nav span{color:#9aa5a1}.context{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.context>div{padding:26px;border:1px solid #dde3df;border-radius:20px;background:#fff}.eyebrow{color:#477568;font-size:11px;font-weight:900;letter-spacing:.12em}.context h2{margin:7px 0 12px;font-size:clamp(26px,3vw,38px)}.context p{color:#65716c;line-height:1.65}.context a{color:#1768af;text-decoration:none;font-weight:850}.faq{margin-top:16px;padding:26px;border:1px solid #dde3df;border-radius:20px;background:#fff}.faq>h2{margin:7px 0 16px;font-size:clamp(26px,3vw,38px)}.faq>div{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.faq article{padding:16px;border-radius:14px;background:#f6f8f7}.faq h3{margin:0 0 8px;font-size:14px}.faq article p{margin:0;color:#65716c;line-height:1.6;font-size:12px}@media(max-width:760px){.context,.faq>div{grid-template-columns:1fr}}
</style>