---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import CatalogWebsiteConcept from "../../../../components/CatalogWebsiteConcept.astro";
import { chaykaStoreConcept as business } from "../../../../data/catalog-business-concepts";
import { buildCatalogConceptSchema } from "../../../../lib/catalog-concept-schema.mjs";

const profileUrl="https://hermeslogisticsus.com/businesses/ukraine/chaiky/chayka-store/";
const schema=buildCatalogConceptSchema({ business, profileUrl });
---
<BaseLayout title="Ремонт телефонів у Чайках | Чайка Store — Hermes Catalog" description="Hermes Catalog website concept for Чайка Store in Чайки: phone repair discovery, contacts and More Chay tea direction." schema={schema}>
  <SiteHeader theme="light" activePath="/businesses/"/>
  <main class="concept-page">
    <CatalogWebsiteConcept business={business} profileUrl={profileUrl} defaultLocale="uk" />
  </main>
  <SiteFooter/>
</BaseLayout>
<style>
.concept-page{min-height:80vh;background:#f6f6f1;color:#18201e;padding:34px max(16px,calc((100% - 1160px)/2)) 70px}
</style>
