---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
const profileUrl="https://hermeslogisticsus.com/businesses/ukraine/chaiky/chayka-store/";
const schema=[{"@context":"https://schema.org","@type":"LocalBusiness","@id":profileUrl+"#business",name:"Чайка Store",url:profileUrl,telephone:"+380639242222",address:{"@type":"PostalAddress",streetAddress:"вул. Валерія Лобановського, 21/3",addressLocality:"Чайки",addressRegion:"Київська область",postalCode:"08135",addressCountry:"UA"},sameAs:["https://www.instagram.com/chayka_store1","https://www.instagram.com/more_chau","https://t.me/more_chay"]}];
---
<BaseLayout title="Ремонт телефонів у Чайках | Чайка Store — Hermes Catalog" description="Hermes Catalog website concept for Чайка Store in Чайки: phone repair discovery, contacts and More Chay tea direction." schema={schema}>
<SiteHeader theme="light" activePath="/businesses/"/>
<main>
<section class="bar"><strong>Hermes Catalog · Website Concept</strong><span>Публічні дані + концепція майбутнього сайту</span><button data-lang>UA / EN</button></section>
<section class="hero shell"><div><p class="eyebrow">Ремонт телефонів · Чайки</p><h1 data-ua="Телефон зламався? Почніть із Чайка Store." data-en="Phone problem? Start with Chayka Store.">Телефон зламався?<br/>Почніть із Чайка Store.</h1><p class="lead" data-ua="Локальна точка в Чайках. Зателефонуйте або напишіть, щоб уточнити ремонт, аксесуари та актуальну наявність." data-en="A local business in Chaiky. Call or message to confirm repair, accessories and current availability.">Локальна точка в Чайках. Зателефонуйте або напишіть, щоб уточнити ремонт, аксесуари та актуальну наявність.</p><div class="actions"><a class="primary" href="tel:+380639242222">+380 63 924 22 22</a><a href="#request">Залишити запит</a></div><div class="proof"><span><b>5.0</b> Google</span><span><b>68</b> відгуків</span><span><b>Чайки</b> Київська обл.</span></div></div><div class="device"><div class="screen"><small>CHAYKA STORE</small><strong>Repair.<br/>Connect.<br/>Continue.</strong><span>Hermes concept preview</span></div></div></section>
<section class="shell grid"><article><p class="eyebrow">PHONE REPAIR</p><h2>Коли телефон потрібен зараз.</h2><p>Конкретні послуги, ціни, строки, гарантія та моделі мають бути підтверджені власником. Концепція не вигадує неперевірені факти.</p><div class="chips"><span>Ремонт · уточнюється</span><span>Аксесуари · уточнюється</span></div><a href="https://www.instagram.com/chayka_store1" target="_blank" rel="noreferrer noopener">Instagram @chayka_store1 →</a></article><article class="tea"><p class="eyebrow">MORE CHAY</p><h2>Окремий напрям — чай.</h2><p>Тепліша історія для чайного напряму, відокремлена від локального наміру «ремонт телефонів».</p><div class="actions"><a href="https://www.instagram.com/more_chau" target="_blank" rel="noreferrer noopener">Instagram</a><a href="https://t.me/more_chay" target="_blank" rel="noreferrer noopener">Telegram</a></div></article></section>
<section class="shell info"><div><p class="eyebrow">LOCAL / NAP</p><h2>Знайти та зв'язатися</h2></div><dl><div><dt>Адреса</dt><dd>вул. Валерія Лобановського, 21/3, Чайки, Київська область, 08135</dd></div><div><dt>Телефон</dt><dd><a href="tel:+380639242222">+380 63 924 22 22</a></dd></div><div><dt>Години</dt><dd>Пн–Сб 10:00–19:00 · Нд 10:00–18:30</dd></div></dl></section>
<section class="shell opportunity"><div><p class="eyebrow">HERMES OPPORTUNITY</p><h2>Так ця компанія може виглядати на власному домені.</h2><p>Це концепція Hermes, а не чинний офіційний сайт бізнесу. Натисніть напрям, щоб побачити, що Hermes може реалізувати.</p></div><div class="offers"><button data-offer="Website / redesign|Перенесемо цю концепцію на ваш домен або зробимо повний редизайн.">Website / redesign</button><button data-offer="Google Maps|Опрацюємо Google Business Profile, локальні сигнали та зв'язок із сайтом.">Google Maps</button><button data-offer="SEO / GEO|Семантична структура, local SEO, schema, internal linking та вимірювання видимості.">SEO / GEO</button><button data-offer="Hermes CRM|Підключимо заявки, клієнтів та керований workflow у Hermes Connect.">Hermes CRM</button><button data-offer="SMM|Зв'яжемо сайт із контентом, органікою та рекламними каналами.">SMM</button><button data-offer="Automation|Автоматизуємо передачу заявок, нагадування та статуси.">Automation</button></div></section>
<section id="request" class="shell request"><div><p class="eyebrow">REQUEST</p><h2>Потрібен ремонт або зв'язок із бізнесом?</h2><p>Залиште контакт. Hermes збереже джерело запиту та передасть його для подальшого зв'язку. Сторінка не означає, що бізнес уже є клієнтом Hermes.</p></div><form data-lead><label>Ім'я / Name<input name="name" required minlength="2"/></label><label>Телефон або email / Contact<input name="contact" required minlength="5"/></label><label>Запит / Request<textarea name="message" required minlength="5" rows="4"></textarea></label><label><input type="checkbox" name="consent" required/> Згоден на використання даних для відповіді.</label><button type="submit">Надіслати / Send</button><p data-status role="status"></p></form></section>
<section class="shell seo"><p class="eyebrow">SEO / GEO FOUNDATION</p><h2>Hermes concept architecture</h2><div class="chips"><span>ремонт телефонів Чайки</span><span>ремонт смартфонів Чайки</span><span>local entity + NAP</span><span>Google Business</span><span>FAQ + schema</span><span>UA / EN</span></div></section>
</main>
<dialog data-modal><button data-close class="x">×</button><p class="eyebrow">HERMES</p><h2 data-title></h2><p data-copy></p><a class="primary" href="/businesses/request/?type=catalog-growth&business=Chayka%20Store&city=Chaiky&country=Ukraine">Запросити / Request</a></dialog>
<SiteFooter/>
</BaseLayout>
<script>
let en=false;document.querySelector("[data-lang]")?.addEventListener("click",()=>{en=!en;document.querySelectorAll("[data-ua]").forEach(n=>{const e=n as HTMLElement;e.textContent=en?(e.dataset.en||e.textContent):(e.dataset.ua||e.textContent);});});
const modal=document.querySelector<HTMLDialogElement>("[data-modal]");document.querySelectorAll("[data-offer]").forEach(b=>b.addEventListener("click",()=>{const [t,c]=String(b.getAttribute("data-offer")||"").split("|");(modal?.querySelector("[data-title]") as HTMLElement).textContent=t;(modal?.querySelector("[data-copy]") as HTMLElement).textContent=c;modal?.showModal();}));document.querySelector("[data-close]")?.addEventListener("click",()=>modal?.close());
const form=document.querySelector<HTMLFormElement>("[data-lead]"),status=document.querySelector<HTMLElement>("[data-status]");form?.addEventListener("submit",async e=>{e.preventDefault();if(!form.reportValidity())return;const f=new FormData(form),contact=String(f.get("contact")||""),isEmail=contact.includes("@"),id=crypto.randomUUID();const payload={request_id:id,submitted_at:new Date().toISOString(),source_path:location.pathname+location.search,interest:"Hermes Catalog",name:String(f.get("name")||""),email:isEmail?contact:"catalog-request@hermeslogisticsus.com",company:"Chayka Store",city_country:"Chaiky, Kyiv region, Ukraine",whatsapp:isEmail?"":contact,telegram:"",website_or_social:location.href,planning_budget:"Not applicable",planning_horizon:"Not applicable",preferred_language:en?"English":"Ukrainian",preferred_contact_time:"Not specified",services:["Customer request for Chayka Store"],message:String(f.get("message")||""),consent:true,attribution:{utm_source:new URLSearchParams(location.search).get("utm_source")||"hermes_catalog",utm_medium:"organic",utm_campaign:"chayka_store_concept",referrer:document.referrer.slice(0,500)}};if(status)status.textContent="Sending…";try{const r=await fetch("/api/business-lead",{method:"POST",headers:{"Content-Type":"application/json","Idempotency-Key":id},body:JSON.stringify(payload)});if(!r.ok)throw 0;form.reset();if(status)status.textContent="Дякуємо. Запит отримано / Request received.";}catch{if(status)status.textContent="Delivery unavailable. Please try again.";}});
</script>
<style>
main{background:#f6f6f1;color:#18201e}.shell{width:min(1160px,calc(100% - 32px));margin:auto}.bar{display:flex;gap:16px;align-items:center;padding:14px max(16px,calc((100% - 1160px)/2));background:#17211e;color:#fff}.bar span{opacity:.65;font-size:12px;flex:1}.bar button{background:#fff;color:#17211e;border:0;border-radius:999px;padding:7px 10px}.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:center;padding-top:72px;padding-bottom:72px}.eyebrow{color:#477568;font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.hero h1{font-size:clamp(48px,7vw,86px);line-height:.96;letter-spacing:-.055em;margin:12px 0 24px}.lead{font-size:18px;line-height:1.65;color:#5d6864;max-width:720px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.actions a,.primary{display:inline-flex;align-items:center;min-height:44px;padding:0 15px;border:1px solid #ccd5d1;border-radius:12px;text-decoration:none;color:#20302b}.actions .primary,.primary{background:#17211e;color:#fff}.proof{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.proof span,.chips span{padding:9px 11px;background:#fff;border:1px solid #dfe4e1;border-radius:999px;font-size:12px}.device{display:grid;place-items:center}.screen{width:min(330px,80vw);aspect-ratio:.62;border-radius:42px;padding:42px 30px;background:linear-gradient(155deg,#18231f,#2d5448);color:#fff;box-shadow:0 30px 70px #17211e30;display:flex;flex-direction:column;justify-content:center}.screen strong{font-size:48px;line-height:.95;margin:18px 0}.screen span{opacity:.55}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.grid article,.info,.opportunity,.request,.seo{padding:28px;border:1px solid #dde3df;border-radius:22px;background:#fff}.grid h2,.info h2,.opportunity h2,.request h2,.seo h2{font-size:clamp(28px,4vw,44px);margin:8px 0 14px;letter-spacing:-.035em}.grid p,.opportunity p,.request p{color:#65716c;line-height:1.65}.tea{background:#f2eee4!important}.chips,.offers{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.info,.opportunity,.request,.seo{margin-top:16px}.info{display:grid;grid-template-columns:.8fr 1.2fr;gap:30px}.info dl{margin:0}.info dl div{display:grid;grid-template-columns:110px 1fr;gap:12px;padding:10px 0;border-top:1px solid #edf0ee}.info dd{margin:0}.offers button{border:1px solid #ccd5d1;background:#f8faf9;border-radius:12px;padding:13px 15px;font-weight:800}.request{display:grid;grid-template-columns:.85fr 1.15fr;gap:30px}.request form{display:grid;gap:10px}.request label{display:grid;gap:5px;font-size:12px;font-weight:800}.request input,.request textarea{width:100%;box-sizing:border-box;padding:11px;border:1px solid #ccd5d1;border-radius:10px}.request label:has(input[type=checkbox]){display:flex}.request input[type=checkbox]{width:auto}.request button{min-height:44px;border:0;border-radius:11px;background:#17211e;color:#fff;font-weight:900}.seo{margin-bottom:70px}dialog{max-width:520px;border:1px solid #dce3df;border-radius:20px;padding:28px;box-shadow:0 30px 80px #0004}dialog::backdrop{background:#17211e99}.x{float:right;border:0;background:transparent;font-size:28px}@media(max-width:760px){.bar span{display:none}.hero,.grid,.info,.request{grid-template-columns:1fr}.hero{padding-top:45px}.device{order:-1}.screen{width:230px}.screen strong{font-size:36px}}
</style>