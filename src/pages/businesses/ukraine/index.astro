---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import DirectionProductNav from "../../../components/DirectionProductNav.astro";
import { catalogBusinessConcepts } from "../../../data/catalog-business-concepts";
const businesses=catalogBusinessConcepts.filter((business)=>business.countrySlug==="ukraine");
const localities=[...new Map(businesses.map((business)=>[business.localitySlug,{slug:business.localitySlug,name:business.locality,count:businesses.filter((item)=>item.localitySlug===business.localitySlug).length}])).values()];
const url="https://hermeslogisticsus.com/businesses/ukraine/";
const schema=[{"@context":"https://schema.org","@type":"CollectionPage",name:"Businesses in Ukraine | Hermes Catalog",url,mainEntity:{"@type":"ItemList",itemListElement:businesses.map((business,index)=>({"@type":"ListItem",position:index+1,name:business.name,url:`${url}${business.localitySlug}/${business.slug}/`}))}},{"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Hermes Catalog",item:"https://hermeslogisticsus.com/businesses/"},{"@type":"ListItem",position:2,name:"International",item:"https://hermeslogisticsus.com/businesses/international/"},{"@type":"ListItem",position:3,name:"Ukraine",item:url}]}];
---
<BaseLayout title="Businesses in Ukraine | Hermes Catalog" description="Secondary international Hermes Catalog profiles in Ukraine, organized by locality and business vertical. U.S. businesses remain the primary Catalog market." schema={schema}>
  <SiteHeader theme="light" activePath="/businesses/" /><DirectionProductNav direction="catalog" theme="light" />
  <main class="hub"><div class="shell"><nav><a href="/businesses/">Hermes Catalog</a><span>→</span><a href="/businesses/international/">International</a></nav><header><p class="eyebrow">International · Ukraine</p><h1>Businesses in Ukraine</h1><p>This is a secondary discovery layer for evidence-backed local businesses. Profiles can be indexed for SEO/GEO and AI discovery without making Ukraine prominent in the U.S.-first Catalog interface.</p></header><section class="locations">{localities.map((locality)=><a href={`/businesses/ukraine/${locality.slug}/`}><strong>{locality.name}</strong><span>{locality.count} profile{locality.count===1?"":"s"}</span></a>)}</section><section class="guide"><h2>What the Ukraine directory contains</h2><p>Profiles are organized around real local businesses and their actual business type: retail, restaurants, barber shops, flower shops and future verticals are kept distinct. Public contact and location facts can support local search discovery, while prices, inventory, appointment capacity and private customer data remain outside the listing unless an authorized owner verifies them. A business can claim its profile later and activate the matching Hermes Connect configuration without creating a separate CRM product.</p></section></div></main><SiteFooter />
</BaseLayout>
<style>.hub{background:#f6f7f9;color:#172033;min-height:70vh}.shell{width:min(1080px,calc(100% - 32px));margin:auto;padding:54px 0 90px}.shell nav{display:flex;gap:8px;font-size:12px}.shell nav a{color:#326c9f;text-decoration:none}.shell nav span{color:#9aa5af}.eyebrow{margin-top:32px;color:#2168a6;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}h1{margin:8px 0 16px;font-size:clamp(42px,6vw,72px);letter-spacing:-.05em}.shell header p:last-child{max-width:820px;color:#667589;line-height:1.7}.locations{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:30px}.locations a{display:flex;justify-content:space-between;padding:22px;border:1px solid #dfe6ee;border-radius:16px;background:#fff;color:#172033;text-decoration:none}.locations span{color:#718095;font-size:12px}@media(max-width:700px){.locations{grid-template-columns:1fr}}.guide{margin-top:18px;padding:22px;border:1px solid #dfe6ee;border-radius:16px;background:#fff}.guide h2{margin:0 0 10px;font-size:24px}.guide p{margin:0;color:#667589;line-height:1.7;font-size:13px}</style>