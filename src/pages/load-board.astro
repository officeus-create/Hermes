---
import { ArrowRight, Building2, Search, ShieldCheck, Truck } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HermesConnectLauncher from "../components/HermesConnectLauncher.astro";

const leadMode = import.meta.env.PUBLIC_CONTACT_MODE === "live" ? "live" : "preview";
const leadEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "";
import "../styles/features/load.css";
---

<BaseLayout
  title="Car Hauling Loads & Load Board Preview | Hermes Logistics"
  description="Car hauler load board preview: review fictional auto transport loads by lane, equipment, deadhead, timing, rate, paperwork, and authority readiness."
>
  <div class="load-board-page">
    <SiteHeader theme="dark" activePath="/load-board/" />
    <main id="main-content">
      <section class="load-board-hero">
        <div class="shell load-board-hero-grid">
          <div>
            <p class="eyebrow">Hermes Logistics · Car Hauling Loads Preview</p>
            <h1>Review Car Hauling Loads Before You Commit</h1>
            <p>Owner-operators and small fleets can review fictional load examples, evaluate equipment and lane fit, and prepare a carrier-access request. Customers, shippers, and dealers who need real vehicle transportation can go directly to the production transport-request path. This local Load Board preview does not publish a load, register an account, book freight, or contact a carrier.</p>
          </div>
          <div class="load-board-safety">
            <ShieldCheck size={28} aria-hidden="true" />
            <strong>Dry-run only</strong>
            <span>Automatic review with explainable reasons and zero external delivery.</span>
          </div>
        </div>
      </section>

      <section class="load-board-role-router" aria-labelledby="load-board-role-title">
        <div class="shell">
          <div class="load-board-section-heading">
            <p class="eyebrow">Two ways to start</p>
            <h2 id="load-board-role-title">What are you here to do?</h2>
            <p>Customer requests and carrier freight review are different workflows. Start with the job that matches the reason for visiting.</p>
          </div>
          <div class="load-board-role-grid">
            <a href="/logistics/request-vehicle-transport/#transport-intake" data-primary-entry="customer">
              <Building2 size={25} aria-hidden="true" />
              <span>Customer / dealer / shipper</span>
              <strong>I need to move a vehicle</strong>
              <small>Use the real transportation-request path for route, vehicle, timing, condition, and contact review.</small>
            </a>
            <a href="?role=carrier#available-loads" aria-label="Carrier or owner-operator — I have a truck — fictional demo freight" data-primary-entry="carrier" data-role-link="carrier">
              <Truck size={25} aria-hidden="true" />
              <span>Carrier / owner-operator</span>
              <strong>I have a truck</strong>
              <small>Review fictional demo freight, lane fit, equipment, rates, and the proposed carrier-access workflow before requesting support.</small>
            </a>
          </div>
          <div class="load-board-section-heading">
            <p><strong>Customer → Hermes → Carrier</strong></p>
            <p>Hermes reviews a transportation request first, then checks authority, insurance, equipment, geography, timing, and actual carrier availability before representing an option as suitable. Submission itself is not a booking.</p>
            <p><strong>No load shown on this page is live or bookable.</strong> The load examples and carrier search below remain a product preview.</p>
            <p><a href="/paths/logistics/brokers/carrier-capacity/"><Search size={17} aria-hidden="true" /> Broker? Request verified carrier capacity.</a></p>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="load-evaluation-title">
        <div class="shell">
          <div class="load-board-section-heading">
            <p class="eyebrow">How to evaluate car hauling loads</p>
            <h2 id="load-evaluation-title">A load is useful only when the complete operating fit works.</h2>
            <p>Do not judge an auto-transport load by the posted rate alone. Review the route, empty miles, equipment, timing, source, requirements, documents, payment terms, and the next reload before the carrier approves anything.</p>
          </div>
          <ol class="carrier-flow" aria-label="Car hauling load evaluation steps">
            <li><span>01</span><strong>Lane and deadhead</strong><small>Pickup position, delivery market, empty miles, tolls, traffic, and reload options</small></li>
            <li><span>02</span><strong>Equipment and units</strong><small>Open, enclosed, hotshot, wedge, multi-car, dimensions, condition, and winch needs</small></li>
            <li><span>03</span><strong>Timing and access</strong><small>Ready date, appointments, auction or dealer hours, keys, release status, and loading limits</small></li>
            <li><span>04</span><strong>Source and paperwork</strong><small>Broker or dealer review, setup packet, insurance certificate, rate confirmation, BOL, and POD</small></li>
            <li><span>05</span><strong>Rate and carrier approval</strong><small>Offered rate, miles, operating cost, payment terms, risk, and the carrier's final decision</small></li>
          </ol>
          <p><strong>Where can I find car hauling loads?</strong> Carriers commonly compare load boards, broker and dealer sources, auctions, repeat shippers, and direct customer opportunities. This Hermes car hauler load board preview shows how to review fictional examples against lane, equipment, deadhead, timing, paperwork, payment terms, and carrier approval before requesting access; it does not publish live or bookable freight.</p>
          <p><strong>New authority:</strong> load access may be limited by broker rules, authority age, insurance, safety profile, documentation, equipment, and payment requirements. A readiness review does not guarantee that a specific load, lane, rate, or broker will be available.</p>
          <p>Need ongoing search, broker communication, paperwork, and back-office support? Review the <a href="/logistics/car-hauling-dispatch/">car hauling dispatch service</a>, the <a href="/paths/logistics/carriers/new-authority/">new-authority carrier path</a>, and the <a href="/logistics/resources/car-hauler-capacity-checklist/">car hauler capacity checklist</a>.</p>
        </div>
      </section>

      <section class="section available-loads-preview" id="available-loads" aria-labelledby="available-loads-title">
        <div class="shell">
          <div class="load-board-section-heading available-loads-heading">
            <div>
              <p class="eyebrow">Available Loads · Demo data</p>
              <h2 id="available-loads-title">See the lane before you spend time on it.</h2>
            </div>
            <p>Fictional examples demonstrate the proposed carrier view. No load below is available to book.</p>
          </div>

          <div class="load-search-bar" aria-label="Demo load filters">
            <label>From <input value="Chicago, IL" list="demo-load-cities" aria-label="Load origin" data-demo-origin /></label>
            <label>Radius <select aria-label="Origin radius"><option>150 miles</option><option>250 miles</option><option>Anywhere</option></select></label>
            <label>To <input placeholder="City, state or anywhere" list="demo-load-cities" aria-label="Load destination" data-demo-destination /></label>
            <label>Equipment <select aria-label="Equipment"><option>Car Hauler</option><option>Hotshot / Gooseneck</option><option>All compatible</option></select></label>
            <button class="button button-primary" type="button" data-demo-search>Search demo loads</button>
          </div>
          <datalist id="demo-load-cities">
            <option value="Chicago, IL"></option><option value="Milwaukee, WI"></option>
            <option value="Madison, WI"></option><option value="Indianapolis, IN"></option>
            <option value="Rockford, IL"></option><option value="Nashville, TN"></option>
            <option value="Green Bay, WI"></option><option value="Des Moines, IA"></option>
          </datalist>
          <div class="demo-city-choices" aria-label="Cities available in the demonstration">
            <span>Try a demo city:</span>
            {["Chicago, IL", "Madison, WI", "Rockford, IL", "Green Bay, WI"].map((city) => (
              <button type="button" data-demo-city={city}>{city}</button>
            ))}
          </div>
          <p class="demo-search-status" role="status" data-demo-search-status>Enter a demo city and search. Results are fictional and cannot be booked.</p>

          <div class="available-loads-layout">
            <div class="available-load-list" aria-label="Fictional available loads">
              <article class="available-load-card" data-demo-load-card data-origin="chicago il" data-destination="milwaukee wi">
                <div class="load-card-route"><span>Chicago, IL</span><ArrowRight size={18} aria-hidden="true" /><span>Milwaukee, WI</span></div>
                <div class="load-card-price"><strong>$620</strong><span>$6.74 / mi</span></div>
                <p>2 operable sedans · Open car hauler · 92 mi</p>
                <dl><div><dt>Pickup</dt><dd>Jul 22 · 8 AM–2 PM</dd></div><div><dt>Posted</dt><dd>18 min ago</dd></div><div><dt>Source</dt><dd>Verified dealer · Demo</dd></div></dl>
                <button type="button" data-demo-load="HLB-1042">Request dispatch</button>
              </article>
              <article class="available-load-card" data-demo-load-card data-origin="madison wi" data-destination="indianapolis in">
                <div class="load-card-route"><span>Madison, WI</span><ArrowRight size={18} aria-hidden="true" /><span>Indianapolis, IN</span></div>
                <div class="load-card-price"><strong>$1,080</strong><span>$3.28 / mi</span></div>
                <p>3 operable vehicles · 3-car wedge · 329 mi</p>
                <dl><div><dt>Pickup</dt><dd>Jul 23</dd></div><div><dt>Posted</dt><dd>41 min ago</dd></div><div><dt>Payment</dt><dd>Quick Pay eligible · Demo</dd></div></dl>
                <button type="button" data-demo-load="HLB-1047">Make an offer</button>
              </article>
              <article class="available-load-card" data-demo-load-card data-origin="rockford il" data-destination="nashville tn">
                <div class="load-card-route"><span>Rockford, IL</span><ArrowRight size={18} aria-hidden="true" /><span>Nashville, TN</span></div>
                <div class="load-card-price"><strong>$1,350</strong><span>$2.35 / mi</span></div>
                <p>1 operable SUV · Hotshot compatible · 575 mi</p>
                <dl><div><dt>Pickup</dt><dd>Jul 24 · appointment</dd></div><div><dt>Posted</dt><dd>1 hr ago</dd></div><div><dt>Stops</dt><dd>Direct · Demo</dd></div></dl>
                <button type="button" data-demo-load="HLB-1051">Request dispatch</button>
              </article>
              <article class="available-load-card" data-demo-load-card data-origin="green bay wi" data-destination="des moines ia">
                <div class="load-card-route"><span>Green Bay, WI</span><ArrowRight size={18} aria-hidden="true" /><span>Des Moines, IA</span></div>
                <div class="load-card-price"><strong>Offer</strong><span>carrier bid</span></div>
                <p>1 inoperable pickup · Winch required · 390 mi</p>
                <dl><div><dt>Pickup</dt><dd>Jul 25–26</dd></div><div><dt>Posted</dt><dd>2 hr ago</dd></div><div><dt>Review</dt><dd>Equipment check · Demo</dd></div></dl>
                <button type="button" data-demo-load="HLB-1058">Make an offer</button>
              </article>
            </div>
            <aside class="load-board-demo-panel" aria-live="polite">
              <p class="eyebrow">Load detail preview</p>
              <h3 data-demo-load-title>Select a demo load</h3>
              <p data-demo-load-copy>Review route, equipment fit, timing, units, rate, source, and special requirements before asking a dispatcher to act.</p>
              <ul>
                <li>Request dispatch does not book automatically.</li>
                <li>Offers and counteroffers require a confirmed carrier account.</li>
                <li>Contact details stay hidden until the operating team approves access.</li>
              </ul>
              <a class="button button-primary" href="#carrier-access">Add your vehicle first</a>
            </aside>
          </div>
        </div>
      </section>

      <section class="section carrier-workspace-preview" id="carrier-access" aria-labelledby="carrier-workspace-title">
        <div class="shell">
          <div class="load-board-section-heading">
            <p class="eyebrow">Carrier workspace · Local preview</p>
            <h2 id="carrier-workspace-title">Get free Load Board access or ask about a load.</h2>
            <p>Leave the minimum carrier and equipment information. Logistics Sales reviews the request, calls you, and explains access, the carrier agreement, and the next step.</p>
          </div>

          <ol class="carrier-flow" aria-label="Proposed carrier flow">
            <li><span>01</span><strong>Create access</strong><small>MC/DOT and contact</small></li>
            <li><span>02</span><strong>Add vehicle</strong><small>Availability and capacity</small></li>
            <li><span>03</span><strong>Dispatcher review</strong><small>Verify and select loads</small></li>
            <li><span>04</span><strong>Available Loads</strong><small>Only assigned matches</small></li>
          </ol>

          <div class="load-board-grid">
            <form class="load-board-form" data-vehicle-form data-lead-mode={leadMode} data-lead-endpoint={leadEndpoint} novalidate>
              <div class="form-alert" role="alert" data-vehicle-alert hidden></div>
              <p class="eyebrow">Carrier / Owner-operator</p>
              <h3>Request free access</h3>
              <p class="load-board-form-note">Simple information for a Logistics Sales follow-up. Equipment-specific details can be confirmed during the call.</p>
              <div class="field-row">
                <label>Your role *
                  <select name="carrier_role" required>
                    <option value="">Choose one</option>
                    <option value="carrier">Carrier</option>
                    <option value="owner_operator">Owner-operator</option>
                    <option value="dispatcher">Dispatcher for a carrier</option>
                  </select>
                </label>
                <label>Company name *
                  <input name="carrier_company_name" maxlength="160" autocomplete="organization" required />
                </label>
              </div>

              <div class="field-row">
                <label>Contact name *
                  <input name="carrier_contact_name" maxlength="100" autocomplete="name" required />
                </label>
                <label>Load reference (optional)
                  <input name="interested_load" maxlength="40" placeholder="Example: HLB-1042" data-interested-load />
                </label>
              </div>

              <div class="field-row">
                <label>MC or USDOT number *
                  <input name="authority_number" maxlength="40" placeholder="MC 123456 or USDOT 1234567" required />
                </label>
                <label>Equipment class *
                  <select name="equipment_class" required>
                    <option value="">Choose one</option>
                    <option value="car_hauler">Car Hauler / Auto Transport</option>
                    <option value="box_truck">Box Truck / Straight Truck</option>
                    <option value="dry_van">Dry Van</option>
                    <option value="flatbed">Flatbed</option>
                    <option value="reefer">Reefer</option>
                    <option value="step_deck">Step Deck</option>
                    <option value="hotshot">Hotshot / Gooseneck</option>
                    <option value="power_only">Power Only</option>
                    <option value="sprinter_van">Sprinter Van</option>
                    <option value="pickup_truck">Pickup Truck</option>
                  </select>
                </label>
              </div>

              <div class="field-row">
                <label>Email *
                  <input name="carrier_email" type="email" maxlength="160" autocomplete="email" required />
                </label>
                <label>Phone *
                  <input name="carrier_phone" type="tel" maxlength="40" autocomplete="tel" required />
                </label>
              </div>

              <div class="field-row">
                <label>Capacity / unit count *
                  <input name="capacity_units" type="number" min="1" max="20" value="1" required />
                </label>
                <label>Available from *
                  <input name="available_from" type="date" required />
                </label>
              </div>

              <div class="field-row">
                <label>Origin city, state or ZIP *
                  <input name="origin_location" maxlength="180" required />
                </label>
                <label>Origin radius (miles) *
                  <input name="origin_radius" type="number" min="1" max="1000" value="100" required />
                </label>
              </div>

              <label>Preferred destination
                <input name="destination_location" maxlength="180" placeholder="City, state, ZIP or region" />
              </label>
              <label class="consent-field">
                <input type="checkbox" name="anywhere" />
                <span>Open to loads going anywhere</span>
              </label>
              <label>Vehicle name (optional)
                <input name="vehicle_name" maxlength="100" placeholder="Example: Blue 3-car wedge" />
              </label>
              <label class="honeypot" aria-hidden="true">Website
                <input name="carrier_website" tabindex="-1" autocomplete="off" />
              </label>
              <label class="consent-field">
                <input type="checkbox" name="carrier_consent" required />
                <span>I agree that Hermes may use these details to contact me about Load Board access, available freight, and logistics services. <a href="/privacy/">Privacy notice</a>.</span>
              </label>
              <button class="button button-primary" type="submit">Review access request <ArrowRight size={18} aria-hidden="true" /></button>
            </form>

            <aside class="load-board-result" data-vehicle-result hidden aria-live="polite">
              <p class="eyebrow">Logistics Sales lead preview</p>
              <h3 data-vehicle-decision></h3>
              <p data-vehicle-state></p>
              <div class="load-board-result-group">
                <h4>Why</h4>
                <ul data-vehicle-reasons></ul>
              </div>
              <div class="load-board-result-group">
                <h4>Required actions</h4>
                <ul data-vehicle-actions></ul>
              </div>
              <div class="load-board-result-group">
                <h4>Next step</h4>
                <p data-vehicle-next-step></p>
              </div>
              <div class="load-board-result-group">
                <h4>What this is not</h4>
                <p data-vehicle-boundary></p>
              </div>
              <p class="load-board-result-delivery" data-vehicle-delivery></p>
            </aside>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
  <HermesConnectLauncher variant="technology" />
</BaseLayout>

<script>
  import { buildVehicleAvailabilityPreview, buildVehicleReview, qualifyCarrierLead, type VehicleAvailabilityPayload } from "../lib/load-board";

  const parseOrigin = (value: string) => value.trim().toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();

  document.querySelectorAll<HTMLElement>("[data-demo-load]").forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.demoLoad ?? "";
      const form = document.querySelector<HTMLFormElement>("[data-vehicle-form]");
      if (!form) return;
      const input = form.elements.namedItem("interested_load") as HTMLInputElement | null;
      if (input) input.value = id;
      document.querySelector("#carrier-access")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  const searchButton = document.querySelector<HTMLButtonElement>("[data-demo-search]");
  const originInput = document.querySelector<HTMLInputElement>("[data-demo-origin]");
  const destinationInput = document.querySelector<HTMLInputElement>("[data-demo-destination]");
  const searchStatus = document.querySelector<HTMLElement>("[data-demo-search-status]");
  const loadCards = [...document.querySelectorAll<HTMLElement>("[data-demo-load-card]")];
  const runDemoSearch = () => {
    const origin = parseOrigin(originInput?.value ?? "");
    const destination = parseOrigin(destinationInput?.value ?? "");
    if (!origin && !destination) {
      loadCards.forEach((card) => { card.hidden = false; });
      if (searchStatus) searchStatus.textContent = "Enter a demo origin or destination to filter the fictional examples.";
      return;
    }
    let visible = 0;
    loadCards.forEach((card) => {
      const originMatch = !origin || (card.dataset.origin ?? "").includes(origin);
      const destinationMatch = !destination || (card.dataset.destination ?? "").includes(destination);
      card.hidden = !(originMatch && destinationMatch);
      if (!card.hidden) visible += 1;
    });
    if (searchStatus) {
      searchStatus.textContent = visible
        ? `${visible} fictional demo load${visible === 1 ? "" : "s"} match the selected demo filter. Nothing shown is live or bookable.`
        : "No fictional demo loads match that filter. Try Chicago, Madison, Rockford, Green Bay, or leave destination blank.";
    }
  };
  searchButton?.addEventListener("click", runDemoSearch);
  document.querySelectorAll<HTMLButtonElement>("[data-demo-city]").forEach((button) => {
    button.addEventListener("click", () => {
      if (originInput) originInput.value = button.dataset.demoCity ?? "";
      runDemoSearch();
    });
  });

  const form = document.querySelector<HTMLFormElement>("[data-vehicle-form]");
  const result = document.querySelector<HTMLElement>("[data-vehicle-result]");
  const alertBox = document.querySelector<HTMLElement>("[data-vehicle-alert]");
  const setText = (selector: string, value: string) => {
    const target = document.querySelector<HTMLElement>(selector);
    if (target) target.textContent = value;
  };
  const fillList = (selector: string, items: string[]) => {
    const list = document.querySelector<HTMLUListElement>(selector);
    if (!list) return;
    list.innerHTML = "";
    items.forEach((item) => {
      const li = document.createElement("li");
      li.textContent = item;
      list.append(li);
    });
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const payload: VehicleAvailabilityPayload = {
      carrier_role: String(data.get("carrier_role") ?? "") as VehicleAvailabilityPayload["carrier_role"],
      carrier_company_name: String(data.get("carrier_company_name") ?? "").trim(),
      carrier_contact_name: String(data.get("carrier_contact_name") ?? "").trim(),
      authority_number: String(data.get("authority_number") ?? "").trim(),
      carrier_email: String(data.get("carrier_email") ?? "").trim(),
      carrier_phone: String(data.get("carrier_phone") ?? "").trim(),
      equipment_class: String(data.get("equipment_class") ?? "") as VehicleAvailabilityPayload["equipment_class"],
      capacity_units: Number(data.get("capacity_units") ?? 1),
      available_from: String(data.get("available_from") ?? ""),
      origin_location: String(data.get("origin_location") ?? "").trim(),
      origin_radius: Number(data.get("origin_radius") ?? 100),
      destination_location: String(data.get("destination_location") ?? "").trim(),
      anywhere: data.get("anywhere") === "on",
      vehicle_name: String(data.get("vehicle_name") ?? "").trim(),
      interested_load: String(data.get("interested_load") ?? "").trim(),
    };
    const consent = data.get("carrier_consent") === "on";
    const review = buildVehicleReview(payload);
    const preview = buildVehicleAvailabilityPreview(payload, review);
    const lead = qualifyCarrierLead(payload);
    result?.removeAttribute("hidden");
    setText("[data-vehicle-decision]", lead.accepted ? "Qualified for Logistics Sales follow-up" : "Needs more information before Sales follow-up");
    setText("[data-vehicle-state]", `Vehicle state: ${review.vehicle_state}`);
    fillList("[data-vehicle-reasons]", review.reasons);
    fillList("[data-vehicle-actions]", review.required_actions);
    setText("[data-vehicle-next-step]", review.next_step);
    setText("[data-vehicle-boundary]", review.what_this_is_not);
    if (!consent) return;
    const leadMode = form.dataset.leadMode ?? "preview";
    const leadEndpoint = form.dataset.leadEndpoint ?? "";
    const deliveryText = leadMode === "live" && leadEndpoint
      ? "Secure lead delivery is enabled for this environment."
      : "Preview mode: the qualified request is prepared locally and is not sent to an external endpoint.";
    setText("[data-vehicle-delivery]", `${preview}\n\n${deliveryText}`);
  });
</script>
