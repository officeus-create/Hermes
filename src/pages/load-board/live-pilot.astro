---
import { ArrowRight, BellRing, CheckCircle2, Filter, Gauge, List, LockKeyhole, Map, RefreshCw, Route, Search, ShieldCheck, Sparkles, Truck } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LogisticsProductNav from "../../components/LogisticsProductNav.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const previewRows = [
  { id: "preview-dv-1", equipment: "Dry Van", origin: "Chicago, IL", destination: "Nashville, TN", pickup: "Today", age: "Preview", rate: "$—", rpm: "—", signal: "High lane activity" },
  { id: "preview-rf-1", equipment: "Reefer", origin: "Dallas, TX", destination: "Atlanta, GA", pickup: "Today", age: "Preview", rate: "$—", rpm: "—", signal: "Temperature controlled" },
  { id: "preview-fb-1", equipment: "Flatbed", origin: "Pittsburgh, PA", destination: "Columbus, OH", pickup: "Today", age: "Preview", rate: "$—", rpm: "—", signal: "Open deck" },
  { id: "preview-sd-1", equipment: "Step Deck", origin: "Tulsa, OK", destination: "Denver, CO", pickup: "Tomorrow", age: "Preview", rate: "$—", rpm: "—", signal: "Specialized" },
  { id: "preview-hs-1", equipment: "Hotshot", origin: "Houston, TX", destination: "Little Rock, AR", pickup: "Today", age: "Preview", rate: "$—", rpm: "—", signal: "Expedited" },
  { id: "preview-ch-1", equipment: "Car Hauler", origin: "Milwaukee, WI", destination: "Indianapolis, IN", pickup: "Tomorrow", age: "Preview", rate: "$—", rpm: "—", signal: "Vehicle transport" },
];
---

<BaseLayout
  title="Hermes Load Board | Live Freight Marketplace Pilot"
  description="Hermes Load Board pilot for live freight discovery, equipment and lane filtering, carrier access, freshness controls, and privacy-safe marketplace activity."
  robots="noindex,nofollow"
>
  <div class="hlb-page">
    <SiteHeader theme="dark" activePath="/load-board/" />
    <LogisticsProductNav theme="dark" active="load-board" />

    <main id="main-content">
      <section class="hlb-hero">
        <div class="shell hlb-hero__grid">
          <div>
            <p class="eyebrow">Hermes Logistics + Hermes IT</p>
            <h1>Live freight. One board. Less deadhead.</h1>
            <p class="hlb-lead">Search freight by lane and equipment, watch approved opportunities arrive, save the searches that matter, and move from public market discovery into verified Hermes Connect access without exposing private source or contact data.</p>
            <div class="hlb-hero__actions">
              <a class="button button-primary" href="#market">Search the board <Search size={18} aria-hidden="true" /></a>
              <a class="button hlb-button-ghost" href="/load-board/?role=carrier#carrier-access">Request carrier access <ArrowRight size={18} aria-hidden="true" /></a>
            </div>
          </div>

          <div class="hlb-hero__status" aria-label="Load Board status">
            <div><span class="hlb-live-dot"></span><strong data-feed-mode>Public feed connecting</strong><small data-feed-status>Checking approved live records…</small></div>
            <div><strong data-live-count>0</strong><small>approved public live loads now</small></div>
            <div><strong>30 sec</strong><small>active-page refresh cadence</small></div>
            <div><strong>Private</strong><small>source contacts stay locked</small></div>
          </div>
        </div>
      </section>

      <section class="hlb-market" id="market" aria-labelledby="hlb-market-title">
        <div class="shell">
          <div class="hlb-market__head">
            <div>
              <p class="eyebrow">Freight marketplace</p>
              <h2 id="hlb-market-title">See the market moving before you unlock the load.</h2>
              <p>Public visitors can explore safe lane and equipment signals. Verified carrier access unlocks the operational workflow; broker/source contact details are never exposed by this public feed.</p>
            </div>
            <div class="hlb-view-controls" aria-label="Load Board view">
              <button type="button" class="is-active" aria-pressed="true"><List size={16} aria-hidden="true" /> List</button>
              <button type="button" aria-pressed="false" title="Map view is in the next product slice"><Map size={16} aria-hidden="true" /> Map</button>
            </div>
          </div>

          <form class="hlb-search" data-hlb-search>
            <label><span>Origin</span><input name="origin" placeholder="City, state or ZIP" autocomplete="off" /></label>
            <label><span>Destination</span><input name="destination" placeholder="City, state or anywhere" autocomplete="off" /></label>
            <label><span>Equipment</span>
              <select name="equipment">
                <option value="">All equipment</option>
                <option value="dry_van">Dry Van</option>
                <option value="reefer">Reefer</option>
                <option value="flatbed">Flatbed</option>
                <option value="step_deck">Step Deck</option>
                <option value="hotshot">Hotshot</option>
                <option value="car_hauler">Car Hauler</option>
                <option value="other">Other</option>
              </select>
            </label>
            <label><span>Pickup</span>
              <select name="pickup">
                <option value="">Any date</option>
                <option value="today">Today</option>
                <option value="tomorrow">Tomorrow</option>
              </select>
            </label>
            <button type="submit"><Search size={17} aria-hidden="true" /> Search</button>
          </form>

          <div class="hlb-tool-row">
            <button type="button" data-hlb-refresh><RefreshCw size={15} aria-hidden="true" /> Refresh</button>
            <button type="button" data-hlb-clear><Filter size={15} aria-hidden="true" /> Clear filters</button>
            <a href="/load-board/?role=carrier#carrier-access"><BellRing size={15} aria-hidden="true" /> Create load alert</a>
            <span data-result-status>Loading approved public records…</span>
          </div>

          <div class="hlb-board-shell">
            <div class="hlb-table" role="table" aria-label="Hermes Load Board" data-hlb-table>
              <div class="hlb-table__header" role="row">
                <span>Equipment</span><span>Origin</span><span>Destination</span><span>Pickup</span><span>Rate</span><span>Signal</span><span>Posted</span><span></span>
              </div>
              <div class="hlb-table__rows" data-hlb-rows>
                {previewRows.map((row) => (
                  <article class="hlb-row" role="row" data-preview-row data-equipment={row.equipment.toLowerCase().replace(" ", "_")} data-origin={row.origin.toLowerCase()} data-destination={row.destination.toLowerCase()}>
                    <div class="hlb-equipment"><Truck size={17} aria-hidden="true" /><strong>{row.equipment}</strong></div>
                    <strong>{row.origin}</strong>
                    <strong>{row.destination}</strong>
                    <span>{row.pickup}</span>
                    <span class="hlb-rate"><strong>{row.rate}</strong><small>{row.rpm}</small></span>
                    <span class="hlb-signal">{row.signal}</span>
                    <span class="hlb-age hlb-age--preview">{row.age}</span>
                    <a href="/load-board/?role=carrier#carrier-access" aria-label={`Unlock ${row.equipment} load preview`}>Unlock <LockKeyhole size={14} aria-hidden="true" /></a>
                  </article>
                ))}
              </div>
            </div>

            <aside class="hlb-side-panel">
              <p class="eyebrow">Hermes Match</p>
              <h3>Your best freight should come to you.</h3>
              <p>The product roadmap combines the strongest workflow patterns from major freight boards without copying their UI: fast search, alerts, fit scoring, lane economics, broker trust, comparison, and multi-trip planning.</p>
              <ul>
                <li><Sparkles size={16} aria-hidden="true" /><span><strong>Best-fit loads</strong><small>Equipment + lane + operating preferences</small></span></li>
                <li><Gauge size={16} aria-hidden="true" /><span><strong>Rate context</strong><small>Lane rate and RPM intelligence</small></span></li>
                <li><ShieldCheck size={16} aria-hidden="true" /><span><strong>Broker trust</strong><small>Authority, payment and relationship signals</small></span></li>
                <li><Route size={16} aria-hidden="true" /><span><strong>Backhaul & multi-trip</strong><small>Reduce empty miles across the whole trip</small></span></li>
                <li><CheckCircle2 size={16} aria-hidden="true" /><span><strong>Compare loads</strong><small>Side-by-side economics before action</small></span></li>
              </ul>
              <a class="button button-primary" href="/load-board/?role=carrier#carrier-access">Create free access</a>
            </aside>
          </div>

          <div class="hlb-preview-boundary" data-preview-boundary>
            <ShieldCheck size={20} aria-hidden="true" />
            <p><strong>Preview rows are clearly marked.</strong> They demonstrate the public experience only and are not bookable freight. As soon as a source has redistribution permission and active records in D1, this page replaces preview rows with the approved live feed automatically.</p>
          </div>
        </div>
      </section>

      <section class="hlb-equipment-section" aria-labelledby="hlb-equipment-title">
        <div class="shell">
          <div class="hlb-section-heading">
            <p class="eyebrow">One board · multiple truck types</p>
            <h2 id="hlb-equipment-title">Dry Van, Reefer, Flatbed, Step Deck, Hotshot, Car Hauler and more.</h2>
            <p>The Load Board is being built as a general Hermes freight marketplace, not a single-equipment demo.</p>
          </div>
          <div class="hlb-equipment-grid">
            {["Dry Van", "Reefer", "Flatbed", "Step Deck", "Hotshot", "Car Hauler"].map((equipment) => (
              <a href={`#market`} data-equipment-shortcut={equipment.toLowerCase().replace(" ", "_")}><Truck size={22} aria-hidden="true" /><strong>{equipment}</strong><span>Search freight</span><ArrowRight size={16} aria-hidden="true" /></a>
            ))}
          </div>
        </div>
      </section>

      <section class="hlb-access" aria-labelledby="hlb-access-title">
        <div class="shell hlb-access__grid">
          <div>
            <p class="eyebrow">Public → verified access</p>
            <h2 id="hlb-access-title">The market is visible. Operational details are controlled.</h2>
            <p>Hermes uses one account boundary across products. Carrier identity, authority and eligibility checks belong before source contacts, booking actions, private rates or operational evidence are revealed.</p>
          </div>
          <ol>
            <li><span>01</span><div><strong>Explore</strong><small>See safe market activity, lanes and equipment.</small></div></li>
            <li><span>02</span><div><strong>Create Hermes access</strong><small>One identity, not a second Load Board account.</small></div></li>
            <li><span>03</span><div><strong>Verify carrier fit</strong><small>MC/DOT, authority, insurance and equipment gates.</small></div></li>
            <li><span>04</span><div><strong>Act</strong><small>Unlock approved load details, alerts and operating workflows.</small></div></li>
          </ol>
          <div class="hlb-access__actions">
            <a class="button button-primary" href="/load-board/?role=carrier#carrier-access">Request Load Board access</a>
            <a class="button" href="/services/hermes-connect/">Open Hermes Connect</a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script>
  type ActiveRecord = {
    id: string;
    type: "load" | "capacity";
    source: string;
    equipment: string;
    origin: string;
    destination: string | null;
    pickupWindow: string | null;
    availability: string | null;
    team: boolean;
    rate: { amount: number; currency: string } | null;
    observedAt: string;
    expiresAt: string;
  };

  const form = document.querySelector<HTMLFormElement>("[data-hlb-search]");
  const rows = document.querySelector<HTMLElement>("[data-hlb-rows]");
  const status = document.querySelector<HTMLElement>("[data-result-status]");
  const count = document.querySelector<HTMLElement>("[data-live-count]");
  const mode = document.querySelector<HTMLElement>("[data-feed-mode]");
  const feedStatus = document.querySelector<HTMLElement>("[data-feed-status]");
  const previewBoundary = document.querySelector<HTMLElement>("[data-preview-boundary]");
  const refreshButton = document.querySelector<HTMLButtonElement>("[data-hlb-refresh]");
  const clearButton = document.querySelector<HTMLButtonElement>("[data-hlb-clear]");
  let latestRecords: ActiveRecord[] = [];
  let liveMode = false;

  const equipmentLabel = (value: string) => ({
    dry_van: "Dry Van",
    reefer: "Reefer",
    flatbed: "Flatbed",
    step_deck: "Step Deck",
    hotshot: "Hotshot",
    car_hauler: "Car Hauler",
    other: "Other",
  }[value] || value.replaceAll("_", " "));

  const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" }[char] || char));

  const relativeAge = (iso: string) => {
    const minutes = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
    if (minutes < 2) return "now";
    if (minutes < 60) return `${minutes}m`;
    const hours = Math.round(minutes / 60);
    return `${hours}h`;
  };

  const renderLive = (records: ActiveRecord[]) => {
    if (!rows) return;
    rows.innerHTML = records.map((record) => {
      const rate = record.rate ? `${record.rate.currency === "USD" ? "$" : `${escapeHtml(record.rate.currency)} `}${Number(record.rate.amount).toLocaleString()}` : "Sign in";
      const destination = record.destination || "Open destination";
      return `<article class="hlb-row hlb-row--live" role="row" data-live-row data-equipment="${escapeHtml(record.equipment)}" data-origin="${escapeHtml(record.origin.toLowerCase())}" data-destination="${escapeHtml(destination.toLowerCase())}">
        <div class="hlb-equipment"><svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 17h4V5H2v12h3"/><path d="M14 8h4l4 4v5h-3"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="16.5" cy="17.5" r="2.5"/></svg><strong>${escapeHtml(equipmentLabel(record.equipment))}</strong></div>
        <strong>${escapeHtml(record.origin)}</strong>
        <strong>${escapeHtml(destination)}</strong>
        <span>${escapeHtml(record.pickupWindow || record.availability || "Current")}</span>
        <span class="hlb-rate"><strong>${rate}</strong><small>${record.team ? "Team" : ""}</small></span>
        <span class="hlb-signal">Approved public record</span>
        <span class="hlb-age">${relativeAge(record.observedAt)}</span>
        <a href="/load-board/?role=carrier#carrier-access">Unlock <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></a>
      </article>`;
    }).join("");
  };

  const filterVisibleRows = () => {
    if (!form || !rows) return;
    const data = new FormData(form);
    const origin = String(data.get("origin") || "").trim().toLowerCase();
    const destination = String(data.get("destination") || "").trim().toLowerCase();
    const equipment = String(data.get("equipment") || "").trim().toLowerCase();
    let visible = 0;
    rows.querySelectorAll<HTMLElement>(".hlb-row").forEach((row) => {
      const rowOrigin = row.dataset.origin || "";
      const rowDestination = row.dataset.destination || "";
      const rowEquipment = row.dataset.equipment || "";
      const match = (!origin || rowOrigin.includes(origin)) && (!destination || rowDestination.includes(destination)) && (!equipment || rowEquipment === equipment);
      row.hidden = !match;
      if (match) visible += 1;
    });
    if (status) status.textContent = `${visible} ${liveMode ? "approved live" : "preview"} result${visible === 1 ? "" : "s"}`;
  };

  const refresh = async () => {
    refreshButton?.setAttribute("aria-busy", "true");
    if (status) status.textContent = "Refreshing approved public records…";
    try {
      const response = await fetch("/api/load-board/active?type=load", { headers: { Accept: "application/json" }, cache: "no-store" });
      if (!response.ok) throw new Error(`feed_${response.status}`);
      const payload = await response.json() as { success?: boolean; records?: ActiveRecord[] };
      latestRecords = Array.isArray(payload.records) ? payload.records : [];
      if (latestRecords.length > 0) {
        liveMode = true;
        renderLive(latestRecords);
        if (count) count.textContent = String(latestRecords.length);
        if (mode) mode.textContent = "Approved public feed live";
        if (feedStatus) feedStatus.textContent = "Fresh records are loaded from Hermes D1.";
        if (previewBoundary) previewBoundary.hidden = true;
      } else {
        liveMode = false;
        if (count) count.textContent = "0";
        if (mode) mode.textContent = "Public feed connecting";
        if (feedStatus) feedStatus.textContent = "No approved public live records yet; preview rows remain clearly marked.";
        if (previewBoundary) previewBoundary.hidden = false;
      }
      filterVisibleRows();
    } catch {
      liveMode = false;
      if (mode) mode.textContent = "Feed temporarily unavailable";
      if (feedStatus) feedStatus.textContent = "Preview remains visible; no private fallback data is exposed.";
      if (status) status.textContent = "Preview results · live feed unavailable";
    } finally {
      refreshButton?.removeAttribute("aria-busy");
    }
  };

  form?.addEventListener("submit", (event) => { event.preventDefault(); filterVisibleRows(); });
  form?.querySelectorAll("input,select").forEach((control) => control.addEventListener("change", filterVisibleRows));
  refreshButton?.addEventListener("click", refresh);
  clearButton?.addEventListener("click", () => { form?.reset(); filterVisibleRows(); });

  document.querySelectorAll<HTMLElement>("[data-equipment-shortcut]").forEach((shortcut) => {
    shortcut.addEventListener("click", () => {
      const equipment = shortcut.dataset.equipmentShortcut || "";
      const select = form?.querySelector<HTMLSelectElement>('select[name="equipment"]');
      if (select) select.value = equipment;
      setTimeout(filterVisibleRows, 0);
    });
  });

  void refresh();
  window.setInterval(() => { if (document.visibilityState === "visible") void refresh(); }, 30_000);
</script>

<style>
  :global(body){background:#f4f6fb}.hlb-page{min-height:100vh;background:#f4f6fb;color:#121629}.hlb-page .shell{width:min(1220px,calc(100% - 40px));margin:0 auto}.hlb-hero{padding:72px 0 54px;background:radial-gradient(circle at 78% 20%,rgba(108,80,255,.23),transparent 34%),linear-gradient(135deg,#071038 0%,#0d1d54 58%,#162e77 100%);color:#fff}.hlb-hero__grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(360px,.65fr);gap:clamp(2rem,6vw,6rem);align-items:end}.hlb-hero h1{max-width:13ch;margin:.35rem 0 1rem;font-size:clamp(3rem,6vw,6.2rem);line-height:.92;letter-spacing:-.055em}.hlb-lead{max-width:760px;margin:0;color:#cbd6ee;font-size:1.05rem;line-height:1.7}.hlb-hero__actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.6rem}.hlb-button-ghost{border-color:rgba(255,255,255,.22)!important;color:#fff!important;background:rgba(255,255,255,.04)!important}.hlb-hero__status{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;overflow:hidden;border:1px solid rgba(255,255,255,.14);border-radius:22px;background:rgba(255,255,255,.12)}.hlb-hero__status>div{display:grid;gap:.25rem;padding:1.1rem;background:rgba(8,18,54,.68)}.hlb-hero__status strong{font-size:1.05rem}.hlb-hero__status small{color:#9fb0d3;line-height:1.35}.hlb-live-dot{display:inline-block;width:8px;height:8px;margin-right:.4rem;border-radius:50%;background:#35d08a;box-shadow:0 0 0 6px rgba(53,208,138,.12)}.hlb-market{padding:54px 0 70px}.hlb-market__head{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:1.4rem}.hlb-market__head h2,.hlb-section-heading h2,.hlb-access h2{max-width:20ch;margin:.35rem 0 .65rem;font-size:clamp(2rem,4vw,3.65rem);line-height:1}.hlb-market__head p,.hlb-section-heading p,.hlb-access p{max-width:760px;color:#66718a;line-height:1.65}.hlb-view-controls{display:flex;gap:.3rem;padding:.3rem;border:1px solid #dce2ef;border-radius:12px;background:#fff}.hlb-view-controls button{display:flex;align-items:center;gap:.35rem;padding:.52r