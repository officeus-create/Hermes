---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactBlock from "../components/ContactBlock.astro";
import ContactCTA from "../components/ContactCTA.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../data/site";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Hermes",
  url: "https://hermeslogisticsus.com/",
  areaServed: [
    { "@type": "Country", name: "United States" },
    { "@type": "Country", name: "Italy" },
    { "@type": "Country", name: "Germany" },
    { "@type": "Country", name: "France" },
    { "@type": "Country", name: "United Kingdom" },
  ],
  contactPoint: site.publicPhones.map((phone) => ({
    "@type": "ContactPoint",
    telephone: phone.href.replace("tel:", ""),
    contactType: phone.label,
    areaServed: "US",
    availableLanguage: ["English", "Russian"],
  })),
};
---

<BaseLayout
  title="Contact Hermes | USA & International"
  description="Contact Hermes Logistics in the United States by phone or email. Marketing, Academy, and IT inquiries are coordinated internationally by email."
  schema={contactSchema}
>
  <SiteHeader />
  <main id="main-content" class="contacts-page">
    <section class="section contacts-hero">
      <div class="shell">
        <p class="eyebrow">USA Logistics · International email coordination</p>
        <h1>Contact Hermes</h1>
        <p>
          Call or email the U.S. Logistics Sales Department. Marketing, Academy, and IT inquiries are handled by email
          across the listed international office locations. The structured form below remains a safe preview.
        </p>
      </div>
    </section>
    <ContactBlock />
    <ContactCTA />
  </main>
  <SiteFooter />
</BaseLayout>
