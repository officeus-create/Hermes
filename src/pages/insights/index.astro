---
import { ArrowRight, Rss } from "@lucide/astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getInsightPath, insightDirectionMeta, insights, type InsightDirection } from "../../data/insights";
import IAmItalyEditorialVisual from "../../components/IAmItalyEditorialVisual.astro";
import "../../styles/hermes-insights.css";

const directions = Object.keys(insightDirectionMeta) as InsightDirection[];
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Hermes Insights",
  itemListElement: insights.filter((post) => post.contentTier === "standalone").map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: new URL(getInsightPath(post), Astro.site).toString(),
    name: post.h1,
  })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Hermes Insights", item: new URL("/insights/", Astro.site).toString() },
  ],
};
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Hermes Insights",
  description: "Reviewed market updates, operating analysis, marketing research, Academy notes, and technology insights from Hermes.",
  url: new URL("/insights/", Astro.site).toString(),
  isPartOf: { "@id": "https://hermeslogisticsus.com/#website" },
};
---

<BaseLayout
  title="Hermes Insights | Logistics, Marketing, Academy & Technology"
  description="Reviewed Hermes insights covering freight markets, carrier operations, SEO and marketing, practical Academy updates, AI, CRM, automation, and technology."
  schema={[collectionSchema, itemList, breadcrumbSchema]}
  feedUrl="/insights/rss.xml"
>
  <div class="insights-page">
    <SiteHeader theme="dark" />
    <main id="main-content">
      <header class="insights-hero" id="top">
        <div class="shell insights-hero-grid">
          <div>
            <p class="eyebrow">Hermes Insights · Reviewed sources, original analysis</p>
            <h1>News becomes useful when it changes a decision.</h1>
            <p>Telegram carries the short update. Hermes Insights keeps the durable version: dated evidence, practical interpretation, operating boundaries, internal links, and a clear next step.</p>
            <div class="insights-filter" aria-label="Insight categories">
              {directions.map((direction) => <a href={`#${direction}`}>{insightDirectionMeta[direction].label}</a>)}
            </div>
            <a class="insights-rss" href="/insights/rss.xml"><Rss size={17} aria-hidden="true" /> RSS feed</a>
          </div>
          <aside>
            <strong>Publication rule</strong>
            <span>External news is never copied into a Hermes page. Standalone posts require a stable source, dated evidence, original analysis, a distinct search purpose, and a safe internal owner page.</span>
          </aside>
        </div>
      </header>

      <section class="iam-news" aria-labelledby="iam-news-title">
        <div class="shell iam-news-grid">
          <IAmItalyEditorialVisual />
          <div class="iam-news-copy">
            <p class="iam-news-kicker">Technology / In Development · 8 October 2026</p>
            <h2 id="iam-news-title">I am enters development: a personal interface to the world.</h2>
            <p>The new founder-led concept begins with Italy shopping and Tax Free guidance and aims toward a voice-first way to organize travel, cross-border business registrations and authorized country services. Its planning horizon is 14 months, not a promise of an already operational platform.</p>
            <p>The first prototype is under controlled testing inside the Hermes Connect technology ecosystem. The team welcomes exploratory strategic and private-investor discussions, without public securities terms, claimed licences or live merchant transactions.</p>
            <div class="iam-news-actions">
              <a href="/insights/technology/i-am-vision/">Read the I am founder story →</a>
              <a href="/businesses/">Hermes Business Catalog · Italy presentation next →</a>
              <a href="/services/hermes-connect/">Hermes Connect · application development →</a>
            </div>
            <small>No affiliate codes, orders, commission or tax refunds are active. This editorial concept is not listed as a live Hermes client.</small>
          </div>
        </div>
      </section>

      <section class="insights-section">
        <div class="shell">
          <div class="insights-heading">
            <div><p class="eyebrow">Current library</p><h2>Four directions, one evidence standard.</h2></div>
            <p>High-value news can become a standalone article. Smaller updates should be grouped into a digest or kept as a hub brief instead of creating thin pages that compete with stronger Hermes pages.</p>
          </div>

          {directions.map((direction) => {
            const posts = insights.filter((post) => post.direction === direction);
            const meta = insightDirectionMeta[direction];
            return (
              <section class="insights-direction-block" id={direction}>
                <div class="insights-heading">
                  <div><p class="eyebrow">{meta.label}</p><h2>{direction === "logistics" ? "Market and operating intelligence" : direction === "marketing" ? "Growth and measurement intelligence" : direction === "academy" ? "Learning and program intelligence" : "Systems and automation intelligence"}</h2></div>
                  <p>{meta.description}</p>
                </div>
                {posts.length ? (
                  <div class="insights-grid">
                    {posts.map((post) => (
                      <article class="insight-card">
                        <div class="insight-card-meta"><span>{post.datePublished}</span><span>·</span><span>{post.contentTier}</span></div>
                        <h3>{post.h1}</h3>
                        <p>{post.description}</p>
                        {post.contentTier === "standalone" ? (
                          <a href={getInsightPath(post)}>Read Hermes analysis <ArrowRight size={17} aria-hidden="true" /></a>
                        ) : (
                          <a href={post.primaryAction.href}>Open related Hermes page <ArrowRight size={17} aria-hidden="true" /></a>
                        )}
                      </article>
                    ))}
                  </div>
                ) : <div class="insights-empty">No standalone insight is published in this direction yet. Smaller updates can still appear in Telegram or a future digest without creating a thin page.</div>}
              </section>
            );
          })}

          <p class="insights-boundary"><strong>Editorial boundary:</strong> a source being public does not make its wording, images, charts, screenshots, or media reusable. Hermes publishes original analysis and links to the original source for the underlying facts.</p>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .iam-news{padding:58px 0;background:#eef4f7;border-bottom:1px solid #d9e4ea}
  .iam-news-grid{display:grid;grid-template-columns:1.12fr .88fr;align-items:center;gap:38px}
  .iam-news-copy{color:#16384b}.iam-news-kicker{text-transform:uppercase;letter-spacing:.13em;font-size:11px;font-weight:900;color:#127e8b}
  .iam-news-copy h2{font-size:clamp(28px,3vw,44px);letter-spacing:-.035em;line-height:1.16;margin:14px 0 22px}
  .iam-news-copy p:not(.iam-news-kicker){font-size:15px;line-height:1.65;color:#536e80;margin:0 0 16px}
  .iam-news-actions{display:grid;gap:10px;margin:20px 0}.iam-news-actions a{font-size:13px;font-weight:850;color:#1a7480}
  .iam-news-copy small{display:block;color:#6a7d88;font-size:11px;line-height:1.5}
  .iam-news a:focus-visible{outline:3px solid #49b9bf;outline-offset:4px}
  @media(max-width:900px){.iam-news-grid{grid-template-columns:1fr}.iam-news{padding:43px 0}}
  @media(max-width:500px){.iam-news{padding:32px 0}.iam-news-grid{gap:23px}}
</style>