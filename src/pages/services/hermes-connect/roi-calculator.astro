---
import HermesConnectCapabilityPage from "../../../components/HermesConnectCapabilityPage.astro";

const faqs = [
  {
    question: "Does ROI Calculator guarantee recovered revenue or savings?",
    answer: "No. It is a reference modeling capability and any output is an estimate based on user-supplied assumptions, not a guaranteed financial result.",
  },
  {
    question: "Does the calculation use the old Hermes Connect subscription prices?",
    answer: "No current subscription price is published on this page. Historical $99–$799 planning ranges are not used as a current product claim.",
  },
];

const capabilities = [
  { title: "Time-savings model", body: "Estimate administrative time that could be reduced using user-supplied workflow assumptions." },
  { title: "Revenue-recovery scenario", body: "Explore what missed or delayed inbound requests might mean financially without presenting the estimate as guaranteed revenue." },
  { title: "Scenario comparison", body: "Compare conservative and optimistic assumptions while keeping the underlying inputs visible and reviewable." },
];
---

<HermesConnectCapabilityPage
  name="ROI Calculator"
  pageTitle="ROI Calculator Reference Capability | Hermes Connect"
  description="Reference documentation for the Hermes Connect ROI Calculator. Financial outputs are illustrative estimates, not guarantees."
  canonicalUrl="https://hermeslogisticsus.com/services/hermes-connect/roi-calculator/"
  lead="A scenario-modeling concept for estimating time savings and potential revenue recovery from faster request handling using explicit user-supplied assumptions."
  capabilities={capabilities}
  boundary="This capability is not a current live paid module and does not use historical Hermes Connect subscription pricing as a public offer. Any modeled savings or revenue remain illustrative and require independent validation."
  faqs={faqs}
/>
