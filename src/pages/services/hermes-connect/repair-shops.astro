---
import { ArrowRight, CalendarDays, CheckCircle2, DollarSign, ShieldCheck, UsersRound, Wrench } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";

const liveCapabilities = [
  {
    title: "One booking link",
    preview: "Customers see services and request a real available time.",
    body: "Give customers a simple public path to choose a service and request an appointment from your real availability.",
  },
  {
    title: "Shop profile & services",
    preview: "Keep the public business facts customers actually need in one place.",
    body: "Keep the business identity, service catalog, hours, and customer-facing details in one place.",
  },
  {
    title: "Online scheduling & availability",
    preview: "Set weekly hours once instead of repeating the same scheduling conversation.",
    body: "Set weekly hours once and let customers request real open times instead of repeating the same scheduling conversation by phone or message.",
  },
  {
    title: "Booking & customer workflow",
    preview: "Move requests through clear statuses with history attached.",
    body: "Process appointment requests through clear statuses and keep the history attached to each booking.",
  },
  {
    title: "Customers & vehicles",
    preview: "Start the next interaction with useful customer and vehicle context.",
    body: "Keep customer and vehicle context connected to booking activity so the next interaction starts with useful history.",
  },
];

const faqs = [
  { question: "What does Hermes Connect repair shop software include?", answer: "You can register an owner account, set up the shop profile and services, configure weekly availability, share a public online booking link, process bookings, review customer and vehicle context, and send private product feedback." },
  { question: "Is Hermes Connect an auto repair CRM?", answer: "Hermes Connect includes limited CRM capabilities for customer and vehicle context, booking history and status, services, and availability in one owner workspace. It is not presented as a full repair-order, inventory, accounting, payroll, or payment-processing suite." },
  { question: "Can customers book repair appointments online?", answer: "Yes. Your shop can publish services and weekly availability and share one booking link. Customers choose a service and request an available time while Hermes Connect keeps the booking attached to the shop workflow." },
  { question: "How much is Hermes Connect for a repair shop?", answer: "The standard Founding Shop price is $99 per month for one repair shop location after setup. During the setup period, the Hermes Connect software fee is $0 while Hermes helps configure the workspace around your shop. Paid activation and the invoice are confirmed with you before billing." },
  { question: "Can I use Hermes Connect free while my shop is being set up?", answer: "Yes. Registration and software access are currently free during the setup period. Configure the shop, services, availability, booking flow, and CRM first. When setup is complete and you want to continue, Hermes confirms the paid Founding Shop activation with you before billing." },
  { question: "Does registration include a Hermes Catalog listing?", answer: "After you complete your business profile, you can approve publication of owner-approved public facts to Hermes Catalog at no listing fee. Hermes develops the directory for SEO, GEO, local search, and AI discovery, but search engines control crawling, indexing, and rankings, and traffic or leads are not guaranteed." },
  { question: "Does Hermes Connect guarantee more customers or revenue?", answer: "No. Hermes Connect provides the shop, booking, customer, and operating tools described here. Customer volume, demand, rankings, revenue, and business results are not guaranteed." },
  { question: "Do I need a native mobile app?", answer: "No. The current product is browser-first and responsive, so an owner can use it from a modern phone or computer without installing an app." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Hermes Connect Repair Shop Software",
    url: "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Modern web browser",
    description: "Auto repair shop software for online booking, scheduling, services, availability, booking operations, customers, and vehicle context.",
    featureList: [
      "Repair shop profile and services",
      "Online appointment booking",
      "Weekly scheduling and availability",
      "Booking status workflow",
      "Customer and vehicle context",
      "Browser-first owner workspace",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
      { "@type": "ListItem", position: 3, name: "Repair Shop Software", item: "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/" },
    ],
  },
];
---

<BaseLayout
  title="Auto Repair Shop Software & Scheduling | Hermes Connect"
  description="Auto repair shop software for independent shops with online scheduling, booking workflow, customer and vehicle context. $0 during setup; standard Founding Shop price is $99/month after setup."
  schema={schema}
>
  <SiteHeader activePath="/paths/technology/" />

  <main id="main-content" class="repair-pilot-page" data-hermes-vertical="repair">
    <section class="repair-live-hero">
      <div class="repair-shell repair-live-grid">
        <div class="repair-hero-copy">
          <p class="repair-kicker">Hermes Connect · Auto Repair Shop Software</p>
          <h1>Auto repair shop software for bookings, customers, and availability.</h1>
          <p class="repair-lead">Hermes Connect gives independent repair shops one clear path from customer service request to organized follow-up. Keep services, weekly availability, bookings, customer history, and vehicle context connected instead of scattered across calls, messages, and notes.</p>

          <div class="repair-actions">
            <a class="repair-primary" href="/services/hermes-connect/repair-shops/auth/?mode=register">Start free setup <ArrowRight size={18} aria-hidden="true" /></a>
            <a class="repair-secondary" href="/services/hermes-connect/repair-shops/plan/">See pricing & plans</a>
          </div>

          <div class="repair-trust" aria-label="Hermes Connect Repair Shops facts">
            <span><CheckCircle2 size={16} aria-hidden="true" />Browser-first · phone or computer</span>
            <span><CheckCircle2 size={16} aria-hidden="true" />Real booking and availability workflow</span>
            <span><DollarSign size={16} aria-hidden="true" />$0 during setup · $99/month after setup</span>
          </div>
        </div>

        <aside class="repair-live-card" aria-label="Hermes Connect repair shop workflow preview">
          <div class="repair-live-card-head">
            <div>
              <small>WORKFLOW PREVIEW</small>
              <strong>From request to customer history</strong>
            </div>
            <span class="repair-live-dot">Live product</span>
          </div>

          <div class="repair-workflow-preview">
            <div class="repair-preview-step is-active">
              <span>01</span>
              <div><strong>Customer requests service</strong><small>Public booking link</small></div>
              <em>New</em>
            </div>
            <div class="repair-preview-line"></div>
            <div class="repair-preview-step">
              <span>02</span>
              <div><strong>Match real availability</strong><small>Your weekly schedule</small></div>
              <em>Open</em>
            </div>
            <div class="repair-preview-line"></div>
            <div class="repair-preview-step">
              <span>03</span>
              <div><strong>Keep the relationship</strong><small>Booking · customer · vehicle</small></div>
              <em>Saved</em>
            </div>
          </div>

          <div class="repair-preview-footer">
            <Wrench size={17} aria-hidden="true" />
            <span>Everything shown here reflects the current Repair Shops workflow available today.</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="repair-section repair-outcome-band" aria-label="Repair shop product outcomes">
      <div class="repair-shell repair-outcome-grid">
        <div><strong>Book</strong><span>One public path from service choice to appointment request.</span></div>
        <div><strong>Operate</strong><span>Services, hours, bookings, customers, and vehicles stay connected.</span></div>
        <div><strong>Discover</strong><span>Approve public business facts for Hermes Catalog and search discovery.</span></div>
      </div>
    </section>

    <section class="repair-section" aria-labelledby="repair-capabilities-title">
      <div class="repair-shell">
        <div class="repair-heading repair-heading-row">
          <div>
            <p class="repair-kicker">Core workflow</p>
            <h2 id="repair-capabilities-title">Move from service request to organized follow-up without scattered tools.</h2>
          </div>
          <p>See the five essentials at a glance. Open details only when you want the deeper workflow.</p>
        </div>

        <div class="repair-disclosure-grid">
          {liveCapabilities.map((capability, index) => (
            <details class="repair-disclosure-card">
              <summary>
                <span class="repair-capability-number">{String(index + 1).padStart(2, "0")}</span>
                <span class="repair-capability-copy">
                  <strong>{capability.title}</strong>
                  <small>{capability.preview}</small>
                </span>
                <span class="repair-disclosure-plus" aria-hidden="true">+</span>
              </summary>
              <div class="repair-disclosure-body">
                <p>{capability.body}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="repair-section repair-plan-section" aria-labelledby="repair-plan-title">
      <div class="repair-shell repair-plan-card">
        <div class="repair-plan-copy">
          <p class="repair-kicker">Free setup → Founding Shop Plan</p>
          <h2 id="repair-plan-title">Build the real workflow first. Decide about paid activation after.</h2>
          <p>During setup, the software fee is $0 while you configure the real shop profile, services, availability, booking flow, customer history, and CRM. When setup is complete, the standard Founding Shop price is $99/month per location if you choose to continue.</p>
          <a class="repair-plan-detail" href="/services/hermes-connect/repair-shops/plan/">Read the full pricing and activation terms <ArrowRight size={16} aria-hidden="true" /></a>
        </div>

        <div class="repair-plan-price" aria-label="$0 during setup, $99 per month after setup">
          <div><span>$</span><strong>0</strong></div>
          <small>during setup</small>
          <hr />
          <b>$99 / month</b>
          <small>standard Founding Shop price after setup</small>
        </div>

        <div class="repair-plan-actions">
          <a class="repair-primary" href="/services/hermes-connect/repair-shops/auth/?mode=register">Start free setup <ArrowRight size={18} aria-hidden="true" /></a>
          <small>No card is charged during setup. Paid activation is confirmed with you before invoicing.</small>
        </div>
      </div>
    </section>

    <section class="repair-section repair-paths-section" aria-labelledby="repair-next-title">
      <div class="repair-shell">
        <div class="repair-heading">
          <p class="repair-kicker">Choose your next action</p>
          <h2 id="repair-next-title">Choose the next step that matches what your shop needs now.</h2>
          <p>Start the workspace, publish approved business facts, or go deeper on search growth when that becomes the priority.</p>
        </div>

        <div class="repair-path-grid">
          <a href="/services/hermes-connect/repair-shops/auth/">
            <UsersRound size={21} aria-hidden="true" />
            <span>OWNER ACCESS</span>
            <strong>Login or create your shop</strong>
            <p>Set up the real workspace, services, hours, booking flow, customers, and vehicles.</p>
            <b>Open workspace →</b>
          </a>
          <a href="/businesses/">
            <CheckCircle2 size={21} aria-hidden="true" />
            <span>CATALOG</span>
            <strong>Publish approved business facts</strong>
            <p>After registration, approve one public profile for Hermes Catalog at no listing fee.</p>
            <b>Explore Catalog →</b>
          </a>
          <a href="/services/seo-for-auto-repair-shops/">
            <CalendarDays size={21} aria-hidden="true" />
            <span>GROWTH</span>
            <strong>Go deeper on SEO & local discovery</strong>
            <p>Add service-page, technical SEO, GEO, local search, and conversion work when a broader growth scope is useful.</p>
            <b>See repair SEO →</b>
          </a>
        </div>

        <p class="repair-search-note">Hermes develops Catalog and related search surfaces for SEO, GEO, local search, and AI discovery. <a href="/services/local-seo/">Explore Local SEO & AI discovery</a> when location visibility becomes the priority. Search engines control crawling, indexing, rankings, and traffic; results are not guaranteed.</p>
      </div>
    </section>

    <section class="repair-section repair-partner-section" aria-labelledby="partner-offer-title">
      <div class="repair-shell">
        <details class="repair-partner-disclosure">
          <summary>
            <div>
              <p class="repair-kicker">Additional opportunity · Hermes Logistics</p>
              <h2 id="partner-offer-title">Want Hermes Logistics to review your shop as a repair partner?</h2>
              <span>This does not change your Hermes Connect plan. Open the corporate offer only if you want Hermes Logistics to review roadside, labor, parts, equipment, and turnaround terms.</span>
            </div>
            <span class="repair-partner-open" aria-hidden="true">Open partner offer +</span>
          </summary>

          <div class="repair-offer-grid">
            <div class="repair-offer-copy">
              <p class="repair-kicker">For repair partners</p>
              <h3>Submit a real corporate service offer.</h3>
              <p>This is separate from the $99 Hermes Connect software plan. Submit a real corporate service offer if your shop wants Hermes Logistics to review its roadside, labor, parts, equipment, and turnaround terms.</p>
              <div class="repair-offer-boundary"><ShieldCheck size={19} aria-hidden="true" /><span>Submitting a partner offer does not automatically create approval, payment, contract execution, or preferred-provider status.</span></div>
            </div>

            <div class="repair-offer-card">
              <div class="repair-lifecycle" data-lifecycle-tracker aria-label="Partner offer lifecycle">
                <div class="step-item active"><span>1</span><small>REGISTERED</small></div>
                <div class="step-item"><span>2</span><small>OFFER_DRAFT</small></div>
                <div class="step-item"><span>3</span><small>OFFER_SUBMITTED</small></div>
                <div class="step-item"><span>4</span><small>HUMAN REVIEW</small></div>
              </div>
              <p class="repair-status">Status: <strong id="status-label">REGISTERED</strong></p>

              <form id="partner-beta-form" class="repair-offer-form">
                <label>Shop name<input id="shop-name" type="text" maxlength="120" required placeholder="Business name" /></label>
                <label>Shop type
                  <select id="shop-type" required>
                    <option value="">Select shop type</option>
                    <option value="auto_repair">Auto repair</option>
                    <option value="truck_diesel">Truck / diesel repair</option>
                    <option value="mobile_mechanic">Mobile mechanic</option>
                    <option value="tire_service">Tire service</option>
                    <option value="body_shop">Body shop</option>
                  </select>
                </label>
                <label>City / state<input id="city-state" type="text" maxlength="120" required placeholder="Milwaukee, WI" /></label>
                <div class="repair-form-grid">
                  <label>Emergency roadside hourly <span>optional</span><input id="roadside-rate" type="number" min="0" max="10000" inputmode="decimal" /></label>
                  <label>Labor discount % <span>optional</span><input id="labor-discount" type="number" min="0" max="100" inputmode="decimal" /></label>
                  <label>Parts discount % <span>optional</span><input id="parts-discount" type="number" min="0" max="100" inputmode="decimal" /></label>
                  <label>Minimum turnaround hours <span>optional</span><input id="turnaround" type="number" min="0" max="10000" inputmode="numeric" /></label>
                </div>
                <fieldset>
                  <legend>Equipment supported <span>optional</span></legend>
                  <div class="repair-checkbox-grid">
                    <label><input type="checkbox" name="equipment" value="car_hauler" />Car hauler</label>
                    <label><input type="checkbox" name="equipment" value="dry_van" />Dry van</label>
                    <label><input type="checkbox" name="equipment" value="reefer" />Reefer</label>
                    <label><input type="checkbox" name="equipment" value="flatbed" />Flatbed</label>
                    <label><input type="checkbox" name="equipment" value="hotshot" />Hotshot</label>
                    <label><input type="checkbox" name="equipment" value="box_truck" />Box truck</label>
                  </div>
                </fieldset>
                <button id="submit-btn" class="repair-submit" type="submit"><span>✦ Prepare Corporate Offer</span><ArrowRight size={17} aria-hidden="true" /></button>
              </form>
            </div>
          </div>
        </details>
      </div>
    </section>

    <section class="repair-section repair-faq" aria-labelledby="repair-faq-title">
      <div class="repair-shell repair-faq-layout">
        <div class="repair-heading repair-faq-heading">
          <p class="repair-kicker">Repair shop software questions</p>
          <h2 id="repair-faq-title">Questions before you start?</h2>
          <p>Open any answer for pricing, CRM scope, booking, Catalog, or setup details.</p>
        </div>
        <div class="repair-faq-grid">
          {faqs.map((faq) => (
            <details class="repair-faq-item">
              <summary><span>{faq.question}</span><b aria-hidden="true">+</b></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .repair-pilot-page {
    min-height: 70vh;
    color: var(--hermes-ink, #0b0d12);
    background:
      radial-gradient(circle at 82% 4%, rgba(30,136,255,.08), transparent 28rem),
      radial-gradient(circle at 12% 2%, rgba(124,92,255,.07), transparent 26rem),
      var(--hermes-pearl, #f7f6f3);
  }

  .repair-shell { width: min(1160px, calc(100% - 2rem)); margin: 0 auto; }
  .repair-live-hero { padding: clamp(4rem, 8vw, 7rem) 0 clamp(3.5rem, 7vw, 5.5rem); border-bottom: 1px solid var(--hermes-line-light, rgba(11,13,18,.10)); }
  .repair-live-grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(360px, .92fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .repair-kicker { margin: 0 0 .75rem; color: #176fc8; font-size: .72rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .repair-live-hero h1 { max-width: 800px; margin: 0; color: var(--hermes-ink, #0b0d12); font-size: clamp(3.1rem, 7.25vw, 6rem); line-height: .93; letter-spacing: -.058em; text-wrap: balance; }
  .repair-lead { max-width: 720px; margin: 1.3rem 0 0; color: var(--hermes-muted, #666c79); font-size: clamp(1.04rem, 1.8vw, 1.22rem); line-height: 1.68; }
  .repair-actions { display: flex; gap: .7rem; flex-wrap: wrap; margin-top: 1.7rem; }
  .repair-primary, .repair-secondary { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; min-height: 50px; padding: .78rem 1.2rem; border-radius: 999px; text-decoration: none; font-weight: 780; transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease; }
  .repair-primary { color: #fff; border: 1px solid #1a73e8; background: #1a73e8; box-shadow: 0 12px 30px rgba(26,115,232,.18); }
  .repair-secondary { color: var(--hermes-ink, #0b0d12); border: 1px solid var(--hermes-line-light, rgba(11,13,18,.10)); background: rgba(255,255,255,.72); }
  .repair-primary:hover, .repair-secondary:hover { transform: translateY(-1px); }
  .repair-trust { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.4rem; color: #626976; font-size: .78rem; }
  .repair-trust span { display: flex; align-items: center; gap: .4rem; min-height: 34px; padding: .42rem .65rem; border: 1px solid rgba(11,13,18,.08); border-radius: 999px; background: rgba(255,255,255,.58); }
  .repair-trust svg { color: var(--hermes-success, #28b487); }

  .repair-live-card { padding: 1.35rem; color: #f7f6f3; border: 1px solid rgba(255,255,255,.08); border-radius: 28px; background: radial-gradient(circle at 90% 0%, rgba(30,136,255,.18), transparent 16rem), radial-gradient(circle at 20% 100%, rgba(124,92,255,.15), transparent 18rem), #172033; box-shadow: 0 32px 90px rgba(23,32,51,.20); }
  .repair-live-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,.08); }
  .repair-live-card-head > div { display: grid; gap: .25rem; }
  .repair-live-card-head small { color: #96a9c9; font-size: .64rem; font-weight: 850; letter-spacing: .13em; }
  .repair-live-card-head strong { color: #fff; font-size: 1.05rem; }
  .repair-live-dot { display: inline-flex; align-items: center; gap: .35rem; white-space: nowrap; color: #a9f1d7; font-size: .68rem; font-weight: 800; }
  .repair-live-dot::before { width: 7px; height: 7px; border-radius: 50%; background: #42d5a0; box-shadow: 0 0 0 4px rgba(66,213,160,.10); content: ""; }
  .repair-workflow-preview { padding: 1.2rem 0 .4rem; }
  .repair-preview-step { display: grid; grid-template-columns: 34px 1fr auto; gap: .75rem; align-items: center; padding: .7rem .75rem; border: 1px solid rgba(255,255,255,.07); border-radius: 14px; background: rgba(255,255,255,.035); }
  .repair-preview-step > span { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; color: #a9cfff; background: rgba(30,136,255,.12); font-size: .7rem; font-weight: 850; }
  .repair-preview-step > div { display: grid; gap: .15rem; }
  .repair-preview-step strong { color: #f7f8fb; font-size: .86rem; }
  .repair-preview-step small { color: #9eabc0; font-size: .7rem; }
  .repair-preview-step em { color: #a9f1d7; font-size: .66rem; font-style: normal; font-weight: 800; }
  .repair-preview-step.is-active { border-color: rgba(30,136,255,.24); background: rgba(30,136,255,.07); }
  .repair-preview-line { width: 1px; height: 16px; margin-left: 28px; background: linear-gradient(#4b91dc, rgba(124,92,255,.32)); }
  .repair-preview-footer { display: flex; align-items: flex-start; gap: .55rem; margin-top: .75rem; padding: .8rem .85rem; border-radius: 13px; color: #aeb8c9; background: rgba(255,255,255,.04); font-size: .72rem; line-height: 1.45; }
  .repair-preview-footer svg { flex: 0 0 auto; color: #9fc7ff; }

  .repair-section { padding: clamp(3.6rem, 7vw, 6rem) 0; }
  .repair-outcome-band { padding: 1.15rem 0; border-bottom: 1px solid var(--hermes-line-light-soft, rgba(11,13,18,.07)); background: rgba(255,255,255,.46); }
  .repair-outcome-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); }
  .repair-outcome-grid > div { display: grid; gap: .25rem; padding: .45rem 1.35rem; border-right: 1px solid var(--hermes-line-light-soft, rgba(11,13,18,.07)); }
  .repair-outcome-grid > div:first-child { padding-left: 0; }
  .repair-outcome-grid > div:last-child { border-right: 0; }
  .repair-outcome-grid strong { color: var(--hermes-ink, #0b0d12); font-size: .82rem; }
  .repair-outcome-grid span { color: var(--hermes-muted, #666c79); font-size: .76rem; line-height: 1.45; }

  .repair-heading { max-width: 800px; margin-bottom: clamp(1.6rem, 3vw, 2.3rem); }
  .repair-heading-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .62fr); gap: 2rem; max-width: none; align-items: end; }
  .repair-heading h2, .repair-plan-card h2, .repair-partner-disclosure > summary h2 { margin: 0; color: var(--hermes-ink, #0b0d12); font-size: clamp(2rem, 4.4vw, 3.4rem); line-height: 1; letter-spacing: -.048em; text-wrap: balance; }
  .repair-heading > p:not(.repair-kicker), .repair-heading-row > p, .repair-plan-copy > p, .repair-partner-disclosure > summary span { margin: .9rem 0 0; color: var(--hermes-muted, #666c79); line-height: 1.65; }

  .repair-disclosure-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .85rem; }
  .repair-disclosure-card { border: 1px solid var(--hermes-line-light, rgba(11,13,18,.10)); border-radius: 18px; background: rgba(255,255,255,.72); box-shadow: 0 14px 42px rgba(31,36,51,.045); overflow: hidden; }
  .repair-disclosure-card[open] { border-color: rgba(30,136,255,.22); background: rgba(255,255,255,.94); box-shadow: 0 18px 48px rgba(31,36,51,.07); }
