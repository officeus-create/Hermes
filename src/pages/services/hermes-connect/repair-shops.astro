---
import { ArrowLeft, ArrowRight, Check, CheckCircle2, Clock, Cpu, FileText, Info, Smartphone, Sparkles, ShieldCheck, HelpCircle, Truck, Wrench } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HermesConnectLauncher from "../../../components/HermesConnectLauncher.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";

const canonicalUrl = "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/";

const subtypes = [
  { id: "auto_repair", name: "Auto Repair" },
  { id: "truck_diesel", name: "Truck / Diesel Repair" },
  { id: "trailer_repair", name: "Trailer Repair" },
  { id: "mobile_mechanic", name: "Mobile Mechanic / Roadside" },
  { id: "parts_supplier", name: "Parts Supplier" },
  { id: "detailing", name: "Detailing" },
  { id: "fleet_maintenance", name: "Fleet Maintenance" },
  { id: "other", name: "Other Auto Service" }
];

const equipmentTypes = [
  { id: "car_hauler", name: "Car Hauler" },
  { id: "dry_van", name: "Dry Van" },
  { id: "reefer", name: "Reefer" },
  { id: "flatbed", name: "Flatbed" },
  { id: "step_deck", name: "Step Deck" },
  { id: "power_only", name: "Power Only" },
  { id: "hotshot", name: "Hotshot" },
  { id: "box_truck", name: "Box Truck" },
  { id: "sprinter", name: "Cargo Van / Sprinter" },
  { id: "truck", name: "Truck" },
  { id: "trailer", name: "Trailer" },
  { id: "other", name: "Other Equipment" }
];

const faqs = [
  {
    question: "What is the Hermes Repair Shop & Truck Repair Partner Beta?",
    answer: "It is an outbound commercial pilot connecting U.S. diesel repair shops, auto detailing centers, parts suppliers, and mobile mechanics with Hermes Logistics' extensive carrier and owner-operator fleets. Participants receive free early access to the Hermes Connect Web App."
  },
  {
    question: "How does the Corporate Offer workflow operate?",
    answer: "Shops can submit proposed corporate rates, terms, labor discounts, and equipment specialities through the platform. These rates are kept strictly secure. All offers undergo a manual review lifecycle (REGISTERED → OFFER_DRAFT → OFFER_SUBMITTED → UNDER_REVIEW) by our load planning team before a partner is approved."
  },
  {
    question: "Can I install Hermes Connect directly on my phone?",
    answer: "Yes. Hermes Connect is built on a standard Progressive Web App (PWA) framework. It can be installed directly from your modern browser to your iPhone or Android home screen without needing an App Store or Google Play listing. Once installed, it works offline using our registered Service Worker."
  },
  {
    question: "Is there any cost or commission fee?",
    answer: "The Partner Beta and early-access workspace are completely free. Commercial commissions and long-term marketing referral models are currently under review and not yet finalized."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Hermes Connect - Repair Shop & Truck Repair Partner Beta",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: canonicalUrl,
    description: "Connect your automotive or truck repair shop to Hermes Logistics' national carrier fleet. Submit corporate discounts, map service capabilities, and gain free Web App early access.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(faq => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
      { "@type": "ListItem", position: 3, name: "Repair Shops", item: canonicalUrl }
    ]
  }
];
---

<BaseLayout
  title="Repair Shop & Truck Repair Partner Beta | Hermes Connect"
  description="Connect your commercial shop, diesel mechanic, auto supplier, or detailing business to our logistics fleet. Access free CRM tools and PWA early access."
  schema={schema}
>
  <SiteHeader activePath="/paths/technology/" />

  <main id="main-content" class="repair-pilot-page">
    <!-- Hero Section -->
    <section class="hero-section" aria-labelledby="hero-title">
      <div class="glow-container">
        <div class="radial-glow glow-1"></div>
        <div class="radial-glow glow-2"></div>
      </div>
      <div class="shell">
        <div class="hero-header-nav">
          <a href="/services/hermes-connect/" class="back-link">
            <ArrowLeft size={16} aria-hidden="true" /> Back to Hermes Connect Hub
          </a>
        </div>
        <div class="hero-grid">
          <div class="hero-content">
            <div class="pilot-badge">
              <Sparkles size={14} aria-hidden="true" /> Outbound Commercial Pilot Beta
            </div>
            <h1 id="hero-title">Connect your shop to our logistics fleet operations.</h1>
            <p class="hero-lead">
              U.S. repair shops, diesel mechanics, parts suppliers, and auto-detailing businesses: submit your corporate discounts, map your equipment capabilities, and unlock free early-access to the <strong>Hermes Connect AI Workspace</strong>.
            </p>
            <div class="hero-actions">
              <a href="/services/hermes-connect/repair-shops/auth" class="btn primary-btn">
                <Wrench size={18} aria-hidden="true" />
                Owner Login / Get Started
              </a>
              <a href="#install-panel" class="btn ghost-btn">
                <Smartphone size={18} aria-hidden="true" />
                Install Web App
              </a>
            </div>
            <div class="hero-limits">
              <span><ShieldCheck size={16} /> Privacy-secure data</span>
              <span><CheckCircle2 size={16} /> No App Store install required</span>
              <span><Info size={16} /> Under corporate review</span>
            </div>
          </div>

          <div class="hero-illustration">
            <div class="workspace-mockup">
              <div class="mockup-header">
                <div class="window-buttons"><span></span><span></span><span></span></div>
                <div class="window-url">connect.hermeslogisticsus.com</div>
              </div>
              <div class="mockup-body">
                <div class="mockup-sidebar">
                  <div class="avatar-circle">AP</div>
                  <div class="sidebar-item active">🔧 Dashboard</div>
                  <div class="sidebar-item">💬 Inbox</div>
                  <div class="sidebar-item">📊 Reports</div>
                </div>
                <div class="mockup-main">
                  <div class="mockup-widget">
                    <span class="widget-kicker">COMMERCIAL OUTBOUND PARTNER</span>
                    <h3>Apex Auto &amp; Truck Care</h3>
                    <div class="tag-row">
                      <span class="tag">Truck &amp; Diesel</span>
                      <span class="tag">Car Hauler Fit</span>
                    </div>
                    <div class="stats-row">
                      <div class="stat-card">
                        <small>Offer State</small>
                        <strong class="status-under-review">UNDER REVIEW</strong>
                      </div>
                      <div class="stat-card">
                        <small>Labor Discount</small>
                        <strong>15% Off</strong>
                      </div>
                    </div>
                  </div>
                  <div class="mockup-log">
                    <div class="log-item"><span>⌁</span> Scored 14 load-rebooking options</div>
                    <div class="log-item"><span>✓</span> Prepared roadside dispatch template</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Multi-Outcome Pipeline -->
    <section class="section pipeline-section" aria-labelledby="pipeline-title">
      <div class="shell">
        <div class="section-header text-center">
          <p class="eyebrow text-iris">Relationship Pipeline</p>
          <h2 id="pipeline-title">One Connection. Multiple Commercial Outcomes.</h2>
          <p class="section-desc">
            We partner with local shops to keep our trucks moving. Our relationship pipeline maps your business to high-value outcomes—from direct carrier load repairs to advanced digital growth.
          </p>
        </div>

        <div class="pipeline-grid">
          <div class="pipeline-card">
            <div class="card-num">01</div>
            <div class="card-icon"><Truck size={24} /></div>
            <h3>Logistics Partner</h3>
            <p>Become a registered repair partner for Hermes' carrier fleets, receiving local referrals and priority roadside calls.</p>
          </div>
          <div class="pipeline-card highlight">
            <div class="card-num">02</div>
            <div class="card-icon"><Cpu size={24} /></div>
            <h3>Hermes Connect Beta</h3>
            <p>Access our responsive workspace for lead intake, automated CRM, parts pricing estimators, and instant proposals free of charge.</p>
            <div style="margin-top: 15px; display: flex; flex-direction: column; gap: 8px;">
              <a href="/download/" style="font-weight: 700; color: #a78bfa; text-decoration: underline;">💿 Download & Setup App →</a>
              <a href="/services/hermes-connect/repair-shops/booking/" style="font-weight: 700; color: #a78bfa; text-decoration: underline;">📅 Live Booking Demo →</a>
            </div>
          </div>
          <div class="pipeline-card">
            <div class="card-num">03</div>
            <div class="card-icon"><Sparkles size={24} /></div>
            <h3>Marketing &amp; Growth</h3>
            <p>Optionally expand into tailored local SEO optimization, customized high-converting websites, and automated ad campaigns to capture local retail deals.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Corporate Offer & Status Lifecycle -->
    <section class="section form-section" id="partner-form" aria-labelledby="form-title">
      <div class="shell">
        <div class="form-grid">
          <div class="form-copy">
            <p class="eyebrow text-iris">Corporate Onboarding</p>
            <h2 id="form-title">Submit Your Capabilities &amp; Corporate Offer</h2>
            <p>
              Complete the form to draft your corporate profile. Your discount specifications and equipment suitability are compiled into a secure rate proposal for our carrier management team.
            </p>

            <div class="lifecycle-box">
              <h3>Partner Offer Status Tracker</h3>
              <p class="sub-text">All commercial offers go through a secure manual review queue. No automatic approval is given.</p>

              <div class="lifecycle-steps" data-lifecycle-tracker>
                <div class="step-item active" data-step="REGISTERED">
                  <div class="step-bullet">1</div>
                  <span>Registered</span>
                </div>
                <div class="step-item" data-step="OFFER_DRAFT">
                  <div class="step-bullet">2</div>
                  <span>Offer Draft</span>
                </div>
                <div class="step-item" data-step="OFFER_SUBMITTED">
                  <div class="step-bullet">3</div>
                  <span>Offer Submitted</span>
                </div>
                <div class="step-item" data-step="UNDER_REVIEW">
                  <div class="step-bullet">4</div>
                  <span>Under Review</span>
                </div>
              </div>
              <div class="current-status-display">
                Current Status: <strong id="status-label">REGISTERED</strong>
              </div>
            </div>

            <div class="disclaimer-alert">
              <Info size={18} class="alert-icon" />
              <div>
                <strong>Non-Finalized Commission Notice:</strong> Long-term sales commissions, marketing referral policies, and billing structures are currently <em>under corporate review</em> and not yet finalized.
              </div>
            </div>
          </div>

          <div class="form-container">
            <form id="partner-beta-form" class="premium-form" data-demo-form>
              <div class="form-row">
                <div class="form-group">
                  <label for="shop-name">Shop Name</label>
                  <input type="text" id="shop-name" placeholder="Apex Auto Care" required />
                </div>
                <div class="form-group">
                  <label for="shop-type">Shop Subtype</label>
                  <select id="shop-type" required>
                    <option value="">Select service subtype...</option>
                    {subtypes.map(s => <option value={s.id}>{s.name}</option>)}
                  </select>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="city-state">City &amp; State</label>
                  <input type="text" id="city-state" placeholder="Green Bay, WI" required />
                </div>
                <div class="form-group">
                  <label for="roadside-rate">Emergency Roadside Hourly ($)</label>
                  <input type="number" id="roadside-rate" placeholder="125" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="labor-discount">Proposed Labor Discount (%)</label>
                  <input type="number" id="labor-discount" placeholder="10" min="0" max="100" />
                </div>
                <div class="form-group">
                  <label for="parts-discount">Proposed Parts Discount (%)</label>
                  <input type="number" id="parts-discount" placeholder="5" min="0" max="100" />
                </div>
              </div>

              <div class="form-group">
                <label>Supported Fleet Equipment Categories (Select all that apply)</label>
                <div class="checkbox-grid">
                  {equipmentTypes.map(eq => (
                    <label class="checkbox-label">
                      <input type="checkbox" name="equipment" value={eq.id} />
                      <span>{eq.name}</span>
                    </label>
                  ))}
                </div>
              </div>

              <div class="form-group">
                <label for="turnaround">Minimum Turnaround Guarantee (hours)</label>
                <input type="number" id="turnaround" placeholder="24" />
              </div>

              <button type="submit" class="submit-btn" id="submit-btn">
                <span>✦ Prepare Corporate Offer Draft</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Device-Aware PWA Installation Panel -->
    <section class="section install-section" id="install-panel" aria-labelledby="install-title">
      <div class="shell">
        <div class="section-header text-center">
          <p class="eyebrow text-iris">Instant Access</p>
          <h2 id="install-title">Install Hermes Connect on Your Device</h2>
          <p class="section-desc">
            Hermes Connect runs as an ultra-fast standalone Web App. It requires no native app downloads and updates itself automatically. Follow the instruction matching your current platform below.
          </p>
        </div>

        <div class="install-panel-container" data-platform-panel>
          <!-- Platform Tabs -->
          <div class="platform-tabs">
            <button class="tab-btn active" data-target-tab="desktop">🖥 Desktop Web App</button>
            <button class="tab-btn" data-target-tab="iphone">📱 Install on iPhone</button>
            <button class="tab-btn" data-target-tab="android">🤖 Install on Android</button>
          </div>

          <!-- Tab Content: Desktop -->
          <div class="platform-content active" id="tab-desktop">
            <div class="tab-grid">
              <div>
                <h3>Access Standalone Workspace</h3>
                <p>Run the full AI command center, load matching simulations, and CRM tools on any laptop or desktop browser. No system resources wasted on thick client files.</p>
                <ul class="benefit-list">
                  <li><Check size={16} /> Fully secure browser cache</li>
                  <li><Check size={16} /> Multiple vertical dashboard switching</li>
                  <li><Check size={16} /> Fast, zero-dependency performance</li>
                </ul>
                <a href="https://connect.hermeslogisticsus.com/workspace" class="btn primary-btn m-top">Open Web App Workspace →</a>
              </div>
              <div class="platform-screenshot">
                <div class="browser-shadow">
                  <div class="browser-window">
                    <span class="dot-btn"></span><span class="dot-btn"></span><span class="dot-btn"></span>
                  </div>
                  <div class="browser-img-placeholder">🖥 Responsive Multi-Vertical Shell</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tab Content: iPhone -->
          <div class="platform-content" id="tab-iphone">
            <div class="tab-grid">
              <div>
                <h3>Step-by-Step iPhone Installation</h3>
                <p>iOS officially supports running progressive web apps in immersive standalone mode via Safari. No App Store account or review necessary.</p>
                <ol class="step-list">
                  <li>Open Safari on your iPhone and visit this website.</li>
                  <li>Tap the <strong>Share</strong> button <span class="share-icon-mock">⎋</span> in Safari's bottom toolbar.</li>
                  <li>Scroll down and tap <strong>Add to Home Screen</strong>.</li>
                  <li>Tap <strong>Add</strong> in the top-right corner to complete.</li>
                </ol>
                <div class="install-hint">
                  <Info size={16} /> Once added, tap the Hermes Connect icon on your Home Screen to launch in standalone immersive mode.
                </div>
                <button type="button" class="btn primary-btn m-top" id="btn-trigger-iphone-guide" style="display: inline-flex; align-items: center; gap: 8px; border: 0; background: linear-gradient(135deg, #7C5CFF, #5AC8FA); color: #fff; font-weight: 800; cursor: pointer;">
                  📱 Open Live Installation Guide
                </button>
              </div>
              <div class="platform-screenshot text-center">
                <div class="phone-mockup">
                  <div class="phone-header">
                    <span>10:20</span>
                    <span class="camera"></span>
                  </div>
                  <div class="phone-body">
                    <h4>Add to Home Screen</h4>
                    <p>Hermes Connect</p>
                    <span class="share-action-item">⎋ Add to Home Screen</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tab Content: Android -->
          <div class="platform-content" id="tab-android">
            <div class="tab-grid">
              <div>
                <h3>Android Standard Installation</h3>
                <p>Android devices allow secure, direct device-level installation matching local package safety standards. Run PWA standalone operations instantly.</p>
                <ul class="benefit-list">
                  <li><Check size={16} /> Secure sandbox directory isolation</li>
                  <li><Check size={16} /> Full offline capability via Service Worker</li>
                  <li><Check size={16} /> Local push notification ready</li>
                </ul>
                <!-- Custom install button trigger -->
                <button type="button" class="btn primary-btn m-top" data-android-install-trigger>
                  <span>🤖 Install Standalone Android App</span>
                </button>
                <span class="mock-pwa-badge">Standard Install Capability Verified</span>
              </div>
              <div class="platform-screenshot">
                <div class="android-prompt-shadow">
                  <div class="prompt-header">🚀 Install App?</div>
                  <div class="prompt-body">
                    <strong>Hermes Connect</strong>
                    <small>connect.hermeslogisticsus.com</small>
                  </div>
                  <div class="prompt-footer">
                    <button class="mock-btn" tabindex="-1">Cancel</button>
                    <button class="mock-btn primary" tabindex="-1">Install</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="section faq-section" aria-labelledby="faq-title">
      <div class="shell">
        <div class="section-header text-center">
          <p class="eyebrow text-iris">FAQ</p>
          <h2 id="faq-title">Frequently Asked Questions</h2>
          <p class="section-desc">Clear, honest answers about the Outbound Pilot and the public Web App.</p>
        </div>

        <div class="faq-list-grid">
          {faqs.map(faq => (
            <div class="faq-card">
              <div class="faq-q">
                <HelpCircle size={18} class="faq-icon" />
                <h3>{faq.question}</h3>
              </div>
              <p class="faq-a">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <!-- Premium Interactive iOS Simulator Modal Overlay -->
  <div class="ios-guide-modal" id="ios-guide-modal" aria-hidden="true" style="display: none;">
    <div class="ios-guide-scrim" id="ios-guide-scrim"></div>
    <div class="ios-guide-container">
      <div class="ios-guide-card">
        <button type="button" class="ios-guide-close" id="ios-guide-close" aria-label="Close guide">×</button>
        <div class="ios-guide-header">
          <div class="ios-guide-badge">✦ Safari Quick-Install</div>
          <h2>Install Hermes Connect on iPhone</h2>
          <p>Follow these 3 simple steps in your Safari browser to install the standalone application.</p>
        </div>
        <div class="ios-simulator">
          <div class="ios-sim-phone">
            <div class="ios-sim-screen">
              <div class="ios-sim-status-bar">
                <span>9:41</span>
                <span class="ios-sim-notch"></span>
                <span>📶 🔋</span>
              </div>
              <div class="ios-sim-browser">
                <div class="ios-sim-url-bar">
                  <span>🔒 hermeslogisticsus.com</span>
                </div>
                <div class="ios-sim-app-content">
                  <div class="ios-sim-app-logo">✦</div>
                  <h3>Hermes Connect</h3>
                  <p>AI logistics workspace active and ready for your Home Screen.</p>
                </div>
                <div class="ios-sim-toolbar">
                  <span>◀</span>
                  <span>▶</span>
                  <span class="ios-sim-share-btn" id="ios-sim-share-btn">⎋</span>
                  <span>📖</span>
                  <span>◽</span>
                </div>
                <!-- Sim Share Sheet (animated overlay) -->
                <div class="ios-sim-share-sheet" id="ios-sim-share-sheet">
                  <div class="share-sheet-handle"></div>
                  <div class="share-sheet-item header-item">
                    <img class="share-app-icon" src="/demos/hermes-connect/apple-touch-icon.png" alt="Hermes Connect">
                    <div>
                      <strong>Hermes Connect Workspace</strong>
                      <p>https://hermeslogisticsus.com/services/hermes-connect/</p>
                    </div>
                  </div>
                  <div class="share-sheet-actions">
                    <div class="share-action-row highlighted" id="ios-sim-add-action">
                      <span>➕</span>
                      <span>Add to Home Screen</span>
                    </div>
                    <div class="share-action-row">
                      <span>🔗</span>
                      <span>Copy Link</span>
                    </div>
                    <div class="share-action-row">
                      <span>⭐️</span>
                      <span>Add to Favorites</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="ios-guide-sidebar">
            <div class="guide-step-card active" data-step-num="1">
              <div class="step-badge">Step 1</div>
              <h4>Tap the Safari Share Icon</h4>
              <p>Look for the Share icon <strong class="text-iris">⎋</strong> at the bottom of your Safari browser toolbar.</p>
            </div>
            <div class="guide-step-card" data-step-num="2">
              <div class="step-badge">Step 2</div>
              <h4>Add to Home Screen</h4>
              <p>Scroll down Safari's menu options and tap <strong class="text-iris">Add to Home Screen</strong>.</p>
            </div>
            <div class="guide-step-card" data-step-num="3">
              <div class="step-badge">Step 3</div>
              <h4>Confirm & Done</h4>
              <p>Name the shortcut "Hermes Connect" and tap <strong class="text-iris">Add</strong> in the top-right corner to open immersive standalone workspace.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <SiteFooter />
</BaseLayout>

<script>
  // Safe Non-PII telemetry function
  function logEvent(eventName: string, params: Record<string, any> = {}) {
    try {
      (window as any).dataLayer = (window as any).dataLayer || [];
      (window as any).dataLayer.push({
        event: eventName,
        ...params,
        timestamp: new Date().toISOString()
      });
      console.log(`[Telemetry] Safe event: ${eventName}`, params);
    } catch (e) {
      console.error("Telemetry failure", e);
    }
  }

  // Onboarding Partner Form Workflow
  const form = document.getElementById("partner-beta-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn");
  const statusLabel = document.getElementById("status-label");
  const stepItems = document.querySelectorAll("[data-lifecycle-tracker] .step-item");

  let currentStep = "REGISTERED";

  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      if (currentStep === "REGISTERED") {
        // Move to Offer Draft
        currentStep = "OFFER_DRAFT";
        if (statusLabel) statusLabel.textContent = "OFFER_DRAFT";
        updateLifecycleVisuals("OFFER_DRAFT");
        if (submitBtn) submitBtn.querySelector("span")!.textContent = "✦ Submit Offer For Review";
        logEvent("connect_offer_draft_prepared", {
          shop_subtype: (document.getElementById("shop-type") as HTMLSelectElement).value,
          city_state: (document.getElementById("city-state") as HTMLInputElement).value
        });
      } else if (currentStep === "OFFER_DRAFT") {
        // Submit Offer
        currentStep = "OFFER_SUBMITTED";
        if (statusLabel) statusLabel.textContent = "OFFER_SUBMITTED";
        updateLifecycleVisuals("OFFER_SUBMITTED");
        if (submitBtn) submitBtn.querySelector("span")!.textContent = "✦ Offer Under Review";
        (submitBtn as HTMLButtonElement).disabled = true;
        (submitBtn as HTMLButtonElement).classList.add("disabled");

        logEvent("connect_offer_submitted", {
          shop_subtype: (document.getElementById("shop-type") as HTMLSelectElement).value,
          city_state: (document.getElementById("city-state") as HTMLInputElement).value
        });

        // Simulate manual background queue trigger
        setTimeout(() => {
          currentStep = "UNDER_REVIEW";
          if (statusLabel) statusLabel.textContent = "UNDER_REVIEW (Human Review Required)";
          updateLifecycleVisuals("UNDER_REVIEW");
          logEvent("connect_offer_queue_received");
        }, 1500);
      }
    });
  }

  function updateLifecycleVisuals(step: string) {
    const stepsMap: Record<string, number> = {
      "REGISTERED": 1,
      "OFFER_DRAFT": 2,
      "OFFER_SUBMITTED": 3,
      "UNDER_REVIEW": 4
    };
    const targetIdx = stepsMap[step] || 1;
    stepItems.forEach((el, idx) => {
      el.classList.toggle("active", idx < targetIdx);
    });
  }

  // Device-Aware Tabs Toggle
  const tabButtons = document.querySelectorAll("[data-target-tab]");
  const platformContents = document.querySelectorAll(".platform-content");

  tabButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      const target = btn.getAttribute("data-target-tab");

      tabButtons.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      platformContents.forEach(content => {
        content.classList.toggle("active", content.id === `tab-${target}`);
      });

      logEvent("connect_installation_tab_switched", { platform: target });
    });
  });

  // Native Android Install trigger mockup
  const androidBtn = document.querySelector("[data-android-install-trigger]");
  if (androidBtn) {
    androidBtn.addEventListener("click", () => {
      androidBtn.querySelector("span")!.textContent = "Mocked Install Prompt Opened...";
      logEvent("connect_installation_prompted", { platform: "android" });
      setTimeout(() => {
        androidBtn.querySelector("span")!.textContent = "Installed Successfully ✓";
        logEvent("connect_installation_completed", { platform: "android" });
      }, 1500);
    });
  }

  // Interactive iOS Simulator Guide Modal Controller
  try {
    const modal = document.getElementById("ios-guide-modal");
    const scrim = document.getElementById("ios-guide-scrim");
    const closeBtn = document.getElementById("ios-guide-close");
    const openBtn = document.getElementById("btn-trigger-iphone-guide");

    const simShareBtn = document.getElementById("ios-sim-share-btn");
    const simShareSheet = document.getElementById("ios-sim-share-sheet");
    const simAddAction = document.getElementById("ios-sim-add-action");
    const sidebarCards = document.querySelectorAll(".guide-step-card");

    const openGuide = () => {
      if (!modal) return;
      modal.style.display = "block";
      modal.setAttribute("aria-hidden", "false");
      resetSimulator();
      logEvent("connect_ios_interactive_guide_opened");
    };

    const closeGuide = () => {
      if (!modal) return;
      modal.style.display = "none";
      modal.setAttribute("aria-hidden", "true");
      logEvent("connect_ios_interactive_guide_closed");
    };

    const resetSimulator = () => {
      if (simShareSheet) simShareSheet.classList.remove("open");
      sidebarCards.forEach((card, idx) => {
        card.classList.toggle("active", idx === 0);
      });
    };

    if (openBtn) {
      openBtn.addEventListener("click", openGuide);
    }
    if (closeBtn) {
      closeBtn.addEventListener("click", closeGuide);
    }
    if (scrim) {
      scrim.addEventListener("click", closeGuide);
    }

    // Step 1 -> Step 2
    if (simShareBtn) {
      simShareBtn.addEventListener("click", () => {
        if (simShareSheet) {
          simShareSheet.classList.add("open");
        }
        sidebarCards.forEach((card, idx) => {
          card.classList.toggle("active", idx === 1);
        });
        logEvent("connect_ios_guide_share_tapped");
      });
    }

    // Step 2 -> Step 3
    if (simAddAction) {
      simAddAction.addEventListener("click", () => {
        sidebarCards.forEach((card, idx) => {
          card.classList.toggle("active", idx === 2);
        });
        logEvent("connect_ios_guide_add_tapped");

        // Mock PWA save and close
        setTimeout(() => {
          closeGuide();
          // Alert user of success!
          alert("✨ Simulated installation successful! You can now launch Hermes Connect directly from your Home Screen.");
        }, 1200);
      });
    }

    // Auto-detect client OS and auto-switch tabs
    const ua = navigator.userAgent.toLowerCase();
    const isIphone = /iphone|ipad|ipod/.test(ua);
    const isAndroid = /android/.test(ua);

    let detectedPlatform = "desktop";
    if (isIphone) {
      detectedPlatform = "iphone";
      // Redirect top button click to launch guide instead of scroll
      const topInstallBtn = document.querySelector('.hero-actions a[href="#install-panel"]');
      if (topInstallBtn) {
        topInstallBtn.addEventListener('click', (e) => {
          e.preventDefault();
          openGuide();
        });
      }
    } else if (isAndroid) {
      detectedPlatform = "android";
    }

    const matchedTabBtn = document.querySelector(`[data-target-tab="${detectedPlatform}"]`);
    if (matchedTabBtn) {
      (matchedTabBtn as HTMLButtonElement).click();
    }
  } catch (e) {
    console.error("Interactive guide setup error", e);
  }
</script>

