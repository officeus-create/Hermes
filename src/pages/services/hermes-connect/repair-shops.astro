---
import { ArrowRight, CalendarDays, CheckCircle2, DollarSign, ShieldCheck, UsersRound, Wrench } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";

const liveCapabilities = [
  { title: "One booking link", body: "Give customers a simple public path to choose a service and request an appointment from your real availability." },
  { title: "Shop profile & services", body: "Keep the business identity, service catalog, hours, and customer-facing details in one place." },
  { title: "Availability", body: "Set weekly hours once instead of repeating the same scheduling conversation by phone or message." },
  { title: "Booking inbox", body: "Process appointment requests through clear statuses and keep the history attached to each booking." },
  { title: "Customers & vehicles", body: "Keep customer and vehicle context connected to booking activity so the next interaction starts with useful history." },
  { title: "Owner feedback", body: "Tell the Hermes product team what saves time, what is confusing, and what your shop needs next." },
];

const faqs = [
  { question: "What can my repair shop use today?", answer: "You can register an owner account, set up the shop profile and services, configure weekly availability, share a public booking link, process bookings, review customer and vehicle context, and send private product feedback." },
  { question: "How much is the Founding Shop Plan?", answer: "The current launch offer is $99 per month for one repair shop location. The website does not collect a card on the activation request; Hermes confirms the shop, plan scope, billing details, and invoice before paid activation." },
  { question: "Can I try the workspace before requesting paid activation?", answer: "Yes. Start with owner registration, configure the shop, and see whether the workflow is useful. When you are ready to keep using it as a paid shop, open the Founding Shop Plan and request activation." },
  { question: "Does Hermes Connect guarantee more customers or revenue?", answer: "No. Hermes Connect provides the shop, booking, customer, and operating tools described here. Customer volume, demand, rankings, revenue, and business results are not guaranteed." },
  { question: "Do I need a native mobile app?", answer: "No. The current product is browser-first and responsive, so an owner can use it from a modern phone or computer without installing an app." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Hermes Connect Repair Shops",
    url: "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Modern web browser",
    description: "Repair shop booking and customer workspace with owner setup, services, availability, public booking, booking operations, customers, and feedback.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
      { "@type": "ListItem", position: 3, name: "Repair Shops", item: "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/" },
    ],
  },
];
---

<BaseLayout
  title="Repair Shop Booking & Customer Workspace | Hermes Connect"
  description="Give customers one repair shop booking link and manage services, availability, bookings, customers, and vehicle context from one owner workspace."
  schema={schema}
>
  <SiteHeader activePath="/paths/technology/" />

  <main id="main-content" class="repair-pilot-page">
    <section class="repair-live-hero">
      <div class="repair-shell repair-live-grid">
        <div>
          <p class="repair-kicker">Hermes Connect · Repair Shops</p>
          <h1>Give customers one link to book your repair shop.</h1>
          <p class="repair-lead">Set your services and hours, share a booking link, process appointments, and keep customer and vehicle context together instead of coordinating everything across calls, messages, and separate notes.</p>
          <div class="repair-actions">
            <a class="repair-primary" href="/services/hermes-connect/repair-shops/auth/">Set up my shop <ArrowRight size={18} aria-hidden="true" /></a>
            <a class="repair-secondary" href="/services/hermes-connect/repair-shops/plan/">View $99 Founding Plan</a>
          </div>
          <div class="repair-trust">
            <span><CheckCircle2 size={16} aria-hidden="true" />Works from a modern phone or computer</span>
            <span><CheckCircle2 size={16} aria-hidden="true" />Real booking, customer, and availability data</span>
            <span><DollarSign size={16} aria-hidden="true" />Founding Shop Plan: $99/month per location</span>
          </div>
        </div>
        <aside class="repair-live-card" aria-label="How to start with Hermes Connect Repair Shops">
          <div class="repair-live-card-head"><Wrench size={24} aria-hidden="true" /><span>From setup to first booking</span></div>
          <ol>
            <li><strong>1</strong><span>Create the owner account</span></li>
            <li><strong>2</strong><span>Add shop details and services</span></li>
            <li><strong>3</strong><span>Set weekly availability</span></li>
            <li><strong>4</strong><span>Share your booking link</span></li>
            <li><strong>5</strong><span>Manage bookings and customers</span></li>
          </ol>
        </aside>
      </div>
    </section>

    <section class="repair-section" aria-labelledby="repair-capabilities-title">
      <div class="repair-shell">
        <div class="repair-heading"><p class="repair-kicker">What you get</p><h2 id="repair-capabilities-title">The everyday shop workflow in one place.</h2><p>Start with the tasks that immediately reduce coordination: publish what you do, show when you are available, let customers request a time, and keep the relationship attached to the booking.</p></div>
        <div class="repair-capability-grid">
          {liveCapabilities.map((capability) => (
            <article><CheckCircle2 size={21} aria-hidden="true" /><h3>{capability.title}</h3><p>{capability.body}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="repair-section repair-plan-section" aria-labelledby="repair-plan-title">
      <div class="repair-shell repair-plan-card">
        <div>
          <p class="repair-kicker">Founding Shop Plan</p>
          <h2 id="repair-plan-title">If the workflow saves your shop time, keep using it for $99/month.</h2>
          <p>One repair shop location gets the current owner workspace, public booking path, availability, booking inbox, customers, vehicle context, and direct product-feedback channel.</p>
        </div>
        <div class="repair-plan-price"><span>$</span><strong>99</strong><small>/month</small></div>
        <div class="repair-plan-actions">
          <a class="repair-primary" href="/services/hermes-connect/repair-shops/plan/">Request paid activation <ArrowRight size={18} aria-hidden="true" /></a>
          <small>No card is collected on this website. Hermes confirms the activation and invoice first.</small>
        </div>
      </div>
    </section>

    <section class="repair-section repair-quick-links" aria-labelledby="repair-workspace-title">
      <div class="repair-shell">
        <div class="repair-heading"><p class="repair-kicker">Owner workspace</p><h2 id="repair-workspace-title">Start with the next useful action.</h2></div>
        <div class="repair-link-grid">
          <a href="/services/hermes-connect/repair-shops/auth/"><UsersRound size={20} aria-hidden="true" /><strong>Login / Register</strong><span>Create your shop or return to the workspace.</span></a>
          <a href="/services/hermes-connect/repair-shops/dashboard/"><Wrench size={20} aria-hidden="true" /><strong>Shop workspace</strong><span>Manage profile, services, bookings, and customer activity.</span></a>
          <a href="/services/hermes-connect/repair-shops/availability/"><CalendarDays size={20} aria-hidden="true" /><strong>Availability</strong><span>Set the hours customers can request.</span></a>
          <a href="/services/hermes-connect/repair-shops/customers/"><UsersRound size={20} aria-hidden="true" /><strong>Customers</strong><span>Review customer and vehicle context.</span></a>
          <a href="/services/hermes-connect/repair-shops/plan/"><DollarSign size={20} aria-hidden="true" /><strong>Founding Shop Plan</strong><span>Request paid activation for $99/month.</span></a>
        </div>
      </div>
    </section>

    <section class="repair-section" aria-labelledby="partner-offer-title">
      <div class="repair-shell repair-offer-grid">
        <div class="repair-offer-copy">
          <p class="repair-kicker">For repair partners</p>
          <h2 id="partner-offer-title">Want your shop reviewed as a Hermes Logistics repair partner too?</h2>
          <p>This is separate from the $99 Hermes Connect software plan. Submit a real corporate service offer if your shop wants Hermes Logistics to review its roadside, labor, parts, equipment, and turnaround terms.</p>
          <div class="repair-offer-boundary"><ShieldCheck size={19} aria-hidden="true" /><span>Submitting a partner offer does not automatically create approval, payment, contract execution, or preferred-provider status.</span></div>
        </div>

        <div class="repair-offer-card">
          <div class="repair-lifecycle" data-lifecycle-tracker aria-label="Partner offer lifecycle">
            <div class="step-item active"><span>1</span><small>REGISTERED</small></div>
            <div class="step-item"><span>2</span><small>OFFER_DRAFT</small></div>
            <div class="step-item"><span>3</span><small>OFFER_SUBMITTED</small></div>
            <div class="step-item"><span>4</span><small>HUMAN REVIEW</small></div>
          </div>
          <p class="repair-status">Status: <strong id="status-label">REGISTERED</strong></p>

          <form id="partner-beta-form" class="repair-offer-form">
            <label>Shop name<input id="shop-name" type="text" maxlength="120" required placeholder="Business name" /></label>
            <label>Shop type
              <select id="shop-type" required>
                <option value="">Select shop type</option>
                <option value="auto_repair">Auto repair</option>
                <option value="truck_diesel">Truck / diesel repair</option>
                <option value="mobile_mechanic">Mobile mechanic</option>
                <option value="tire_service">Tire service</option>
                <option value="body_shop">Body shop</option>
              </select>
            </label>
            <label>City / state<input id="city-state" type="text" maxlength="120" required placeholder="Milwaukee, WI" /></label>
            <div class="repair-form-grid">
              <label>Emergency roadside hourly <span>optional</span><input id="roadside-rate" type="number" min="0" max="10000" inputmode="decimal" /></label>
              <label>Labor discount % <span>optional</span><input id="labor-discount" type="number" min="0" max="100" inputmode="decimal" /></label>
              <label>Parts discount % <span>optional</span><input id="parts-discount" type="number" min="0" max="100" inputmode="decimal" /></label>
              <label>Minimum turnaround hours <span>optional</span><input id="turnaround" type="number" min="0" max="10000" inputmode="numeric" /></label>
            </div>
            <fieldset>
              <legend>Equipment supported <span>optional</span></legend>
              <div class="repair-checkbox-grid">
                <label><input type="checkbox" name="equipment" value="car_hauler" />Car hauler</label>
                <label><input type="checkbox" name="equipment" value="dry_van" />Dry van</label>
                <label><input type="checkbox" name="equipment" value="reefer" />Reefer</label>
                <label><input type="checkbox" name="equipment" value="flatbed" />Flatbed</label>
                <label><input type="checkbox" name="equipment" value="hotshot" />Hotshot</label>
                <label><input type="checkbox" name="equipment" value="box_truck" />Box truck</label>
              </div>
            </fieldset>
            <button id="submit-btn" class="repair-submit" type="submit"><span>✦ Prepare Corporate Offer</span><ArrowRight size={17} aria-hidden="true" /></button>
          </form>
        </div>
      </div>
    </section>

    <section class="repair-section repair-faq" aria-labelledby="repair-faq-title">
      <div class="repair-shell">
        <div class="repair-heading"><p class="repair-kicker">Before you start</p><h2 id="repair-faq-title">Frequently asked questions</h2></div>
        <div class="repair-faq-grid">{faqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .repair-pilot-page{min-height:70vh;color:#f8fafc;background:radial-gradient(circle at 12% 4%,rgba(90,200,250,.08),transparent 30rem),radial-gradient(circle at 88% 8%,rgba(157,136,255,.1),transparent 32rem),#090d16}.repair-shell{width:min(1120px,calc(100% - 2rem));margin:0 auto}.repair-live-hero{padding:clamp(3.5rem,8vw,6.5rem) 0 4rem}.repair-live-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:2.2rem;align-items:center}.repair-kicker{margin:0 0 .65rem;color:#9d88ff;font-size:.76rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.repair-live-hero h1{max-width:760px;margin:0;font-size:clamp(2.7rem,7vw,5.4rem);line-height:.99;letter-spacing:-.05em}.repair-lead{max-width:730px;margin:1.2rem 0 0;color:#a9b5c8;font-size:clamp(1.02rem,2vw,1.18rem);line-height:1.7}.repair-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.5rem}.repair-primary,.repair-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:46px;padding:.75rem 1rem;border-radius:11px;text-decoration:none;font-weight:750}.repair-primary{background:linear-gradient(135deg,#8b5cf6,#5ac8fa);color:#07101c}.repair-secondary{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.03);color:#fff}.repair-trust{display:grid;gap:.5rem;margin-top:1.3rem;color:#aeb9cb;font-size:.82rem}.repair-trust span{display:flex;align-items:center;gap:.45rem}.repair-trust svg{color:#34d399}.repair-live-card{padding:1.35rem;border:1px solid rgba(52,211,153,.24);border-radius:20px;background:linear-gradient(160deg,rgba(52,211,153,.07),rgba(255,255,255,.018));box-shadow:0 24px 70px rgba(0,0,0,.22)}.repair-live-card-head{display:flex;align-items:center;gap:.55rem;color:#6ee7b7;font-weight:800}.repair-live-card ol{display:grid;gap:.7rem;list-style:none;margin:1rem 0 0;padding:0}.repair-live-card li{display:flex;align-items:center;gap:.75rem;padding:.72rem .8rem;border:1px solid rgba(255,255,255,.07);border-radius:12px;background:rgba(255,255,255,.025);color:#b9c5d7}.repair-live-card li strong{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:rgba(157,136,255,.12);color:#c4b5fd}.repair-section{padding:3.4rem 0}.repair-heading{max-width:780px;margin-bottom:1.3rem}.repair-heading h2,.repair-offer-copy h2,.repair-plan-card h2{margin:0;font-size:clamp(1.7rem,4vw,2.65rem);letter-spacing:-.035em}.repair-heading>p:not(.repair-kicker){margin:.8rem 0 0;color:#98a6bb;line-height:1.65}.repair-capability-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.repair-capability-grid article,.repair-link-grid a,.repair-faq-grid article{padding:1.2rem;border:1px solid rgba(255,255,255,.09);border-radius:17px;background:linear-gradient(160deg,rgba(255,255,255,.045),rgba(255,255,255,.018));box-shadow:0 18px 55px rgba(0,0,0,.15)}.repair-capability-grid svg,.repair-link-grid svg{color:#5ac8fa}.repair-capability-grid h3{margin:.7rem 0 .45rem}.repair-capability-grid p,.repair-link-grid span,.repair-faq-grid p,.repair-offer-copy>p,.repair-plan-card>div>p{margin:0;color:#98a6bb;line-height:1.62;font-size:.9rem}.repair-plan-section{padding-top:1.2rem}.repair-plan-card{display:grid;grid-template-columns:1fr auto minmax(240px,.5fr);gap:1.5rem;align-items:center;padding:1.5rem;border:1px solid rgba(52,211,153,.24);border-radius:22px;background:linear-gradient(135deg,rgba(52,211,153,.07),rgba(90,200,250,.045),rgba(157,136,255,.055));box-shadow:0 24px 70px rgba(0,0,0,.18)}.repair-plan-price{display:flex;align-items:flex-end;gap:.15rem;white-space:nowrap}.repair-plan-price span{font-size:1.25rem;font-weight:800;padding-bottom:.55rem}.repair-plan-price strong{font-size:3.8rem;line-height:1;letter-spacing:-.055em}.repair-plan-price small{color:#a9b5c8;padding-bottom:.55rem}.repair-plan-actions{display:grid;gap:.55rem}.repair-plan-actions small{color:#8390a4;line-height:1.45}.repair-link-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1rem}.repair-link-grid a{display:grid;gap:.45rem;color:#fff;text-decoration:none}.repair-link-grid strong{font-size:1rem}.repair-offer-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:2rem;align-items:start}.repair-offer-boundary{display:flex;gap:.55rem;margin-top:1rem;padding:.85rem;border:1px solid rgba(251,191,36,.22);border-radius:12px;background:rgba(251,191,36,.055);color:#d6c68f;font-size:.82rem;line-height:1.5}.repair-offer-boundary svg{flex:0 0 auto;color:#fbbf24}.repair-offer-card{padding:1.3rem;border:1px solid rgba(157,136,255,.2);border-radius:20px;background:rgba(13,17,27,.86);box-shadow:0 24px 70px rgba(0,0,0,.2)}.repair-lifecycle{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.45rem}.step-item{display:grid;gap:.3rem;padding:.65rem;border:1px solid rgba(255,255,255,.07);border-radius:10px;color:#778397}.step-item.active{border-color:rgba(52,211,153,.24);background:rgba(52,211,153,.055);color:#c8f6df}.step-item span{font-weight:850}.step-item small{font-size:.62rem}.repair-status{margin:.85rem 0;color:#9aa7ba;font-size:.82rem}.repair-status strong{color:#fff}.repair-offer-form{display:grid;gap:.9rem}.repair-offer-form>label,.repair-form-grid label{display:grid;gap:.42rem;color:#dfe5ef;font-size:.78rem;font-weight:750}.repair-offer-form label span,.repair-offer-form legend span{color:#78859a;font-size:.68rem}.repair-offer-form input,.repair-offer-form select{width:100%;box-sizing:border-box;padding:.72rem .78rem;border:1px solid rgba(255,255,255,.1);border-radius:10px;background:#0d111b;color:#fff;font:inherit}.repair-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.repair-offer-form fieldset{margin:0;padding:.85rem;border:1px solid rgba(255,255,255,.08);border-radius:12px}.repair-offer-form legend{padding:0 .35rem;color:#dfe5ef;font-size:.78rem;font-weight:750}.repair-checkbox-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}.repair-checkbox-grid label{display:flex;align-items:center;gap:.4rem;color:#b9c5d7;font-size:.78rem}.repair-checkbox-grid input{width:auto}.repair-submit{display:flex;align-items:center;justify-content:center;gap:.4rem;min-height:46px;border:0;border-radius:11px;background:linear-gradient(135deg,#8b5cf6,#5ac8fa);color:#07101c;font-weight:850;cursor:pointer}.repair-submit:disabled{opacity:.65;cursor:wait}.repair-faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.repair-faq-grid h3{margin:0 0 .45rem;font-size:1rem}
  @media(max-width:900px){.repair-live-grid,.repair-offer-grid,.repair-plan-card{grid-template-columns:1fr}.repair-capability-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.repair-plan-price{justify-self:start}}
  @media(max-width:620px){.repair-shell{width:min(100% - 1rem,1120px)}.repair-capability-grid,.repair-faq-grid,.repair-form-grid{grid-template-columns:1fr}.repair-checkbox-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.repair-actions{flex-direction:column}.repair-primary,.repair-secondary{width:100%;box-sizing:border-box}.repair-lifecycle{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>