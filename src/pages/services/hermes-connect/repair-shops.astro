---
import { ArrowRight, CalendarDays, CheckCircle2, ShieldCheck, UsersRound, Wrench } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";

const liveCapabilities = [
  { title: "Owner identity", body: "Register or sign in to the same protected Repair Shop workspace used for profile, services, availability, customers, bookings, and feedback." },
  { title: "Shop profile & services", body: "Publish the business identity, service catalog, and the operational details customers need before requesting an appointment." },
  { title: "Availability & public booking", body: "Set weekly hours and share the public booking flow. Available times are checked against the shop's saved schedule and existing bookings." },
  { title: "Booking operations", body: "Process customer requests through explicit statuses instead of simulated success screens." },
  { title: "Customer workspace", body: "Keep owner-scoped customer and vehicle context connected to real booking activity." },
  { title: "Private beta feedback", body: "Owners can submit private product feedback without publishing it to public analytics or product pages." },
];

const faqs = [
  { question: "Is Repair Shops the current live Hermes Connect product?", answer: "Yes. Repair Shops is the current live pilot. Other Hermes Connect modules are reference capabilities until their production data, access model, and release status are separately verified." },
  { question: "Does the website simulate successful bookings or partner-offer delivery?", answer: "No. The current Repair Shop page does not use a browser-only success simulation. Booking and Corporate Offer success are shown only after the corresponding live server flow confirms the request." },
  { question: "Is there a separate Brand V1 or legacy workspace I should use?", answer: "No. The supported user path stays inside the canonical Hermes Connect product family on hermeslogisticsus.com." },
  { question: "Is a native mobile app required?", answer: "No. The current product is responsive and browser-first. Public App Store, Google Play, or direct APK distribution is not required for the Repair Shop pilot." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Hermes Connect Repair Shops",
    url: "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Modern web browser",
    description: "Current Hermes Connect live pilot for repair shops: owner workspace, services, availability, public booking, booking operations, customers, private feedback, and human-reviewed corporate partner intake.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
      { "@type": "ListItem", position: 3, name: "Repair Shops", item: "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/" },
    ],
  },
];
---

<BaseLayout
  title="Repair Shops | Current Hermes Connect Live Pilot"
  description="The current Hermes Connect live pilot for repair shops: owner workspace, services, availability, booking, customers, feedback, and human-reviewed partner intake."
  schema={schema}
>
  <SiteHeader activePath="/paths/technology/" />

  <main id="main-content" class="repair-pilot-page">
    <section class="repair-live-hero">
      <div class="repair-shell repair-live-grid">
        <div>
          <p class="repair-kicker">Hermes Connect · Current live pilot</p>
          <h1>Run the Repair Shop flow from one product.</h1>
          <p class="repair-lead">Create the shop, publish services and hours, share the booking path, process customer requests, manage customer context, and send product feedback without leaving the canonical Hermes Connect family.</p>
          <div class="repair-actions">
            <a class="repair-primary" href="/services/hermes-connect/repair-shops/auth/">Owner Login / Get Started <ArrowRight size={18} aria-hidden="true" /></a>
            <a class="repair-secondary" href="/services/hermes-connect/">Product Family Hub</a>
          </div>
          <div class="repair-trust">
            <span><CheckCircle2 size={16} aria-hidden="true" />Real owner registration and protected workspace</span>
            <span><CheckCircle2 size={16} aria-hidden="true" />Server-confirmed booking and partner-offer flows</span>
            <span><ShieldCheck size={16} aria-hidden="true" />No legacy workspace required</span>
          </div>
        </div>
        <aside class="repair-live-card" aria-label="Current Repair Shop flow">
          <div class="repair-live-card-head"><Wrench size={24} aria-hidden="true" /><span>Current product path</span></div>
          <ol>
            <li><strong>1</strong><span>Register or sign in</span></li>
            <li><strong>2</strong><span>Configure profile, services, and hours</span></li>
            <li><strong>3</strong><span>Share the public booking link</span></li>
            <li><strong>4</strong><span>Process bookings and customers</span></li>
            <li><strong>5</strong><span>Send private product feedback</span></li>
          </ol>
        </aside>
      </div>
    </section>

    <section class="repair-section" aria-labelledby="repair-capabilities-title">
      <div class="repair-shell">
        <div class="repair-heading"><p class="repair-kicker">Live capability set</p><h2 id="repair-capabilities-title">The pilot covers the full owner-to-booking operating loop.</h2></div>
        <div class="repair-capability-grid">
          {liveCapabilities.map((capability) => (
            <article><CheckCircle2 size={21} aria-hidden="true" /><h3>{capability.title}</h3><p>{capability.body}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="repair-section repair-quick-links" aria-labelledby="repair-workspace-title">
      <div class="repair-shell">
        <div class="repair-heading"><p class="repair-kicker">Owner workspace</p><h2 id="repair-workspace-title">Use one identity across the Repair Shop product.</h2></div>
        <div class="repair-link-grid">
          <a href="/services/hermes-connect/repair-shops/auth/"><UsersRound size={20} aria-hidden="true" /><strong>Login / Register</strong><span>Start or return to the owner workspace.</span></a>
          <a href="/services/hermes-connect/repair-shops/dashboard/"><Wrench size={20} aria-hidden="true" /><strong>Dashboard</strong><span>Open the protected owner operating view.</span></a>
          <a href="/services/hermes-connect/repair-shops/availability/"><CalendarDays size={20} aria-hidden="true" /><strong>Availability</strong><span>Configure the weekly booking schedule.</span></a>
          <a href="/services/hermes-connect/repair-shops/customers/"><UsersRound size={20} aria-hidden="true" /><strong>Customers</strong><span>Review owner-scoped customer context.</span></a>
        </div>
      </div>
    </section>

    <section class="repair-section" aria-labelledby="partner-offer-title">
      <div class="repair-shell repair-offer-grid">
        <div class="repair-offer-copy">
          <p class="repair-kicker">Corporate partner intake</p>
          <h2 id="partner-offer-title">Submit a Repair Shop / Truck Repair Partner offer for human review.</h2>
          <p>Use this form only for a real shop offer. The first submit prepares the draft; the second sends it privately to Hermes Logistics. A success state appears only after the live server endpoint confirms receipt.</p>
          <div class="repair-offer-boundary"><ShieldCheck size={19} aria-hidden="true" /><span>No automatic approval, payment, contract execution, or public analytics disclosure is created by this form.</span></div>
        </div>

        <div class="repair-offer-card">
          <div class="repair-lifecycle" data-lifecycle-tracker aria-label="Partner offer lifecycle">
            <div class="step-item active"><span>1</span><small>REGISTERED</small></div>
            <div class="step-item"><span>2</span><small>OFFER_DRAFT</small></div>
            <div class="step-item"><span>3</span><small>OFFER_SUBMITTED</small></div>
            <div class="step-item"><span>4</span><small>HUMAN REVIEW</small></div>
          </div>
          <p class="repair-status">Status: <strong id="status-label">REGISTERED</strong></p>

          <form id="partner-beta-form" class="repair-offer-form">
            <label>Shop name<input id="shop-name" type="text" maxlength="120" required placeholder="Business name" /></label>
            <label>Shop type
              <select id="shop-type" required>
                <option value="">Select shop type</option>
                <option value="auto_repair">Auto repair</option>
                <option value="truck_diesel">Truck / diesel repair</option>
                <option value="mobile_mechanic">Mobile mechanic</option>
                <option value="tire_service">Tire service</option>
                <option value="body_shop">Body shop</option>
              </select>
            </label>
            <label>City / state<input id="city-state" type="text" maxlength="120" required placeholder="Milwaukee, WI" /></label>
            <div class="repair-form-grid">
              <label>Emergency roadside hourly <span>optional</span><input id="roadside-rate" type="number" min="0" max="10000" inputmode="decimal" /></label>
              <label>Labor discount % <span>optional</span><input id="labor-discount" type="number" min="0" max="100" inputmode="decimal" /></label>
              <label>Parts discount % <span>optional</span><input id="parts-discount" type="number" min="0" max="100" inputmode="decimal" /></label>
              <label>Minimum turnaround hours <span>optional</span><input id="turnaround" type="number" min="0" max="10000" inputmode="numeric" /></label>
            </div>
            <fieldset>
              <legend>Equipment supported <span>optional</span></legend>
              <div class="repair-checkbox-grid">
                <label><input type="checkbox" name="equipment" value="car_hauler" />Car hauler</label>
                <label><input type="checkbox" name="equipment" value="dry_van" />Dry van</label>
                <label><input type="checkbox" name="equipment" value="reefer" />Reefer</label>
                <label><input type="checkbox" name="equipment" value="flatbed" />Flatbed</label>
                <label><input type="checkbox" name="equipment" value="hotshot" />Hotshot</label>
                <label><input type="checkbox" name="equipment" value="box_truck" />Box truck</label>
              </div>
            </fieldset>
            <button id="submit-btn" class="repair-submit" type="submit"><span>✦ Prepare Corporate Offer</span><ArrowRight size={17} aria-hidden="true" /></button>
          </form>
        </div>
      </div>
    </section>

    <section class="repair-section repair-faq" aria-labelledby="repair-faq-title">
      <div class="repair-shell">
        <div class="repair-heading"><p class="repair-kicker">Product clarity</p><h2 id="repair-faq-title">Frequently asked questions</h2></div>
        <div class="repair-faq-grid">{faqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .repair-pilot-page{min-height:70vh;color:#f8fafc;background:radial-gradient(circle at 12% 4%,rgba(90,200,250,.08),transparent 30rem),radial-gradient(circle at 88% 8%,rgba(157,136,255,.1),transparent 32rem),#090d16}.repair-shell{width:min(1120px,calc(100% - 2rem));margin:0 auto}.repair-live-hero{padding:clamp(3.5rem,8vw,6.5rem) 0 4rem}.repair-live-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:2.2rem;align-items:center}.repair-kicker{margin:0 0 .65rem;color:#9d88ff;font-size:.76rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.repair-live-hero h1{max-width:760px;margin:0;font-size:clamp(2.7rem,7vw,5.4rem);line-height:.99;letter-spacing:-.05em}.repair-lead{max-width:730px;margin:1.2rem 0 0;color:#a9b5c8;font-size:clamp(1.02rem,2vw,1.18rem);line-height:1.7}.repair-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.5rem}.repair-primary,.repair-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:46px;padding:.75rem 1rem;border-radius:11px;text-decoration:none;font-weight:750}.repair-primary{background:linear-gradient(135deg,#8b5cf6,#5ac8fa);color:#07101c}.repair-secondary{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.03);color:#fff}.repair-trust{display:grid;gap:.5rem;margin-top:1.3rem;color:#aeb9cb;font-size:.82rem}.repair-trust span{display:flex;align-items:center;gap:.45rem}.repair-trust svg{color:#34d399}.repair-live-card{padding:1.35rem;border:1px solid rgba(52,211,153,.24);border-radius:20px;background:linear-gradient(160deg,rgba(52,211,153,.07),rgba(255,255,255,.018));box-shadow:0 24px 70px rgba(0,0,0,.22)}.repair-live-card-head{display:flex;align-items:center;gap:.55rem;color:#6ee7b7;font-weight:800}.repair-live-card ol{display:grid;gap:.7rem;list-style:none;margin:1rem 0 0;padding:0}.repair-live-card li{display:flex;align-items:center;gap:.75rem;padding:.72rem .8rem;border:1px solid rgba(255,255,255,.07);border-radius:12px;background:rgba(255,255,255,.025);color:#b9c5d7}.repair-live-card li strong{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:rgba(157,136,255,.12);color:#c4b5fd}.repair-section{padding:3.4rem 0}.repair-heading{max-width:780px;margin-bottom:1.3rem}.repair-heading h2,.repair-offer-copy h2{margin:0;font-size:clamp(1.7rem,4vw,2.65rem);letter-spacing:-.035em}.repair-capability-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.repair-capability-grid article,.repair-link-grid a,.repair-faq-grid article{padding:1.2rem;border:1px solid rgba(255,255,255,.09);border-radius:17px;background:linear-gradient(160deg,rgba(255,255,255,.045),rgba(255,255,255,.018));box-shadow:0 18px 55px rgba(0,0,0,.15)}.repair-capability-grid svg,.repair-link-grid svg{color:#5ac8fa}.repair-capability-grid h3{margin:.7rem 0 .45rem}.repair-capability-grid p,.repair-link-grid span,.repair-faq-grid p,.repair-offer-copy>p{margin:0;color:#98a6bb;line-height:1.62;font-size:.9rem}.repair-link-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.repair-link-grid a{display:grid;gap:.45rem;color:#fff;text-decoration:none}.repair-link-grid strong{font-size:1rem}.repair-offer-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:2rem;align-items:start}.repair-offer-boundary{display:flex;gap:.55rem;margin-top:1rem;padding:.85rem;border:1px solid rgba(251,191,36,.22);border-radius:12px;background:rgba(251,191,36,.055);color:#d6c68f;font-size:.82rem;line-height:1.5}.repair-offer-boundary svg{flex:0 0 auto;color:#fbbf24}.repair-offer-card{padding:1.3rem;border:1px solid rgba(157,136,255,.2);border-radius:20px;background:rgba(13,17,27,.86);box-shadow:0 24px 70px rgba(0,0,0,.2)}.repair-lifecycle{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.45rem}.step-item{display:grid;gap:.3rem;padding:.65rem;border:1px solid rgba(255,255,255,.07);border-radius:10px;color:#778397}.step-item.active{border-color:rgba(52,211,153,.24);background:rgba(52,211,153,.055);color:#c8f6df}.step-item span{font-weight:850}.step-item small{font-size:.62rem}.repair-status{margin:.85rem 0;color:#9aa7ba;font-size:.82rem}.repair-status strong{color:#fff}.repair-offer-form{display:grid;gap:.9rem}.repair-offer-form>label,.repair-form-grid label{display:grid;gap:.42rem;color:#dfe5ef;font-size:.78rem;font-weight:750}.repair-offer-form label span,.repair-offer-form legend span{color:#78859a;font-size:.68rem}.repair-offer-form input,.repair-offer-form select{width:100%;box-sizing:border-box;padding:.72rem .78rem;border:1px solid rgba(255,255,255,.1);border-radius:10px;background:#0d111b;color:#fff;font:inherit}.repair-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.repair-offer-form fieldset{margin:0;padding:.85rem;border:1px solid rgba(255,255,255,.08);border-radius:12px}.repair-offer-form legend{padding:0 .35rem;color:#dfe5ef;font-size:.78rem;font-weight:750}.repair-checkbox-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}.repair-checkbox-grid label{display:flex;align-items:center;gap:.4rem;color:#b9c5d7;font-size:.78rem}.repair-checkbox-grid input{width:auto}.repair-submit{display:flex;align-items:center;justify-content:center;gap:.4rem;min-height:46px;border:0;border-radius:11px;background:linear-gradient(135deg,#8b5cf6,#5ac8fa);color:#07101c;font-weight:850;cursor:pointer}.repair-submit:disabled{opacity:.65;cursor:wait}.repair-faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.repair-faq-grid h3{margin:0 0 .45rem;font-size:1rem}
  @media(max-width:900px){.repair-live-grid,.repair-offer-grid{grid-template-columns:1fr}.repair-capability-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.repair-link-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:620px){.repair-shell{width:min(100% - 1rem,1120px)}.repair-capability-grid,.repair-link-grid,.repair-faq-grid,.repair-form-grid{grid-template-columns:1fr}.repair-checkbox-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.repair-actions{flex-direction:column}.repair-primary,.repair-secondary{width:100%}.repair-lifecycle{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
