---
import HermesConnectCapabilityPage from "../../../components/HermesConnectCapabilityPage.astro";

const faqs = [
  {
    question: "Is Unified Inbox live for all Hermes Connect users?",
    answer: "No. Unified Inbox is documented as a reference capability. Repair Shops is the most mature current vertical, and that does not establish Unified Inbox availability for all Hermes Connect users.",
  },
  {
    question: "What is Unified Inbox intended to do?",
    answer: "It is designed to bring approved inbound business requests into one operator view with clear lifecycle states, notes, and human-reviewed next actions.",
  },
];

const capabilities = [
  { title: "Consolidated intake", body: "Bring approved website and business-request sources into one operational queue instead of scattered tabs." },
  { title: "Lifecycle states", body: "Track requests through explicit states without implying that external delivery, SMS, or email automation is active when it is not." },
  { title: "Human-reviewed responses", body: "Keep suggested next actions separate from outbound execution so operators remain in control of customer communication." },
];
---

<HermesConnectCapabilityPage
  name="Unified Inbox"
  pageTitle="Unified Inbox Reference Capability | Hermes Connect"
  description="Reference documentation for the Hermes Connect Unified Inbox capability. No universal live availability is claimed."
  canonicalUrl="https://hermeslogisticsus.com/services/hermes-connect/unified-inbox/"
  lead="A shared intake and lifecycle concept for organizing business requests across the Hermes Connect product family without presenting unconnected messaging gateways as live."
  capabilities={capabilities}
  boundary="This page does not claim a live multi-channel inbox, encrypted local lead store, SMS gateway, or email gateway for the current product. Those integrations require separate verified production evidence before they can be described as live."
  faqs={faqs}
/>
