---
import { RefreshCw, Search, ShieldCheck, UserCheck, Users } from "@lucide/astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../components/SiteFooter.astro";
import HermesConnectExperience from "../../../../../components/HermesConnectExperience.astro";

const isRu = Astro.url.searchParams.get("lang") === "ru";
---
<BaseLayout
  title={isRu ? "Пользователи и регистрации | Hermes Connect" : "Users & Registrations | Hermes Connect"}
  description="Private owner-only Hermes Connect registration operations ledger."
  robots="noindex,nofollow"
>
  <SiteHeader activePath="/paths/technology/" />
  <HermesConnectExperience />
  <main class="registrations-page">
    <div class="shell">
      <header class="hero">
        <div>
          <p class="kicker"><ShieldCheck size={15} /> Hermes Connect · {isRu ? "внутренний контроль" : "internal operations"}</p>
          <h1>{isRu ? "Пользователи / Регистрации" : "Users / Registrations"}</h1>
          <p>{isRu ? "Закрытый реестр реальных регистраций Hermes Connect. Тестовые аккаунты отделены от бизнес-метрик и уведомлений." : "Private registration ledger for Hermes Connect. Synthetic accounts stay separate from real-user KPIs and alerts."}</p>
        </div>
        <span class="owner-badge"><UserCheck size={16} /> {isRu ? "Только владелец" : "Owner only"}</span>
      </header>

      <section class="access" data-access role="status">
        <strong>{isRu ? "Проверяем доступ…" : "Checking owner access…"}</strong>
        <p>{isRu ? "Данные пользователей откроются только после серверной проверки HERMES_INTERNAL_OWNER." : "User data opens only after the server verifies HERMES_INTERNAL_OWNER."}</p>
      </section>

      <section class="content hidden" data-content>
        <div class="summary" aria-label={isRu ? "Сводка регистраций" : "Registration summary"}>
          <article><span>{isRu ? "Всего реальных" : "Total real"}</span><strong data-stat="total_real">0</strong></article>
          <article><span>{isRu ? "Сегодня" : "Today"}</span><strong data-stat="today">0</strong></article>
          <article><span>{isRu ? "7 дней" : "7 days"}</span><strong data-stat="last_7d">0</strong></article>
          <article><span>{isRu ? "30 дней" : "30 days"}</span><strong data-stat="last_30d">0</strong></article>
          <article><span>{isRu ? "Не просмотрено" : "Unreviewed"}</span><strong data-stat="unreviewed">0</strong></article>
          <article><span>{isRu ? "Тестовые" : "Synthetic"}</span><strong data-stat="synthetic">0</strong></article>
        </div>

        <div class="toolbar">
          <label class="search-wrap">
            <Search size={17} />
            <span class="sr-only">{isRu ? "Поиск" : "Search"}</span>
            <input data-search type="search" autocomplete="off" placeholder={isRu ? "Имя, email, телефон, компания, город, источник, access…" : "Name, email, phone, company, city, source, access…"} />
          </label>
          <select data-kind aria-label={isRu ? "Тип аккаунта" : "Account type"}>
            <option value="real">{isRu ? "Реальные" : "Real users"}</option>
            <option value="all">{isRu ? "Все" : "All"}</option>
            <option value="synthetic">{isRu ? "Тестовые" : "Synthetic"}</option>
          </select>
          <select data-role aria-label={isRu ? "Роль / направление" : "Role / vertical"}>
            <option value="all">{isRu ? "Все роли" : "All roles"}</option>
          </select>
          <select data-review-state aria-label={isRu ? "Статус проверки" : "Review status"}>
            <option value="all">{isRu ? "Все статусы" : "All statuses"}</option>
            <option value="unreviewed">{isRu ? "Новые / не проверены" : "New / unreviewed"}</option>
            <option value="reviewed">{isRu ? "Проверены" : "Reviewed"}</option>
            <option value="incomplete">{isRu ? "Неполный профиль" : "Incomplete profile"}</option>
            <option value="alert_failed">{isRu ? "Ошибка уведомления" : "Alert failed"}</option>
          </select>
          <select data-window aria-label={isRu ? "Период регистрации" : "Registration window"}>
            <option value="all">{isRu ? "За всё время" : "All time"}</option>
            <option value="24h">{isRu ? "Последние 24 часа" : "Last 24 hours"}</option>
            <option value="7d">{isRu ? "Последние 7 дней" : "Last 7 days"}</option>
            <option value="30d">{isRu ? "Последние 30 дней" : "Last 30 days"}</option>
          </select>
          <select data-page-size aria-label={isRu ? "Строк на странице" : "Rows per page"}>
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
          </select>
          <button class="refresh" type="button" data-refresh><RefreshCw size={16}/>{isRu ? "Обновить" : "Refresh"}</button>
        </div>

        <div class="status-line" data-status aria-live="polite"></div>
        <div class="table-wrap">
          <table>
            <thead><tr>
              <th><button class="sort" type="button" data-sort="name">{isRu ? "Пользователь" : "User"} <span aria-hidden="true">↕</span></button></th>
              <th>{isRu ? "Контакты" : "Contact"}</th>
              <th><button class="sort" type="button" data-sort="shop_name">{isRu ? "Компания / локация" : "Company / location"} <span aria-hidden="true">↕</span></button></th>
              <th>{isRu ? "Роль / источник" : "Role / source"}</th>
              <th>{isRu ? "Профиль / доступ" : "Profile / access"}</th>
              <th><button class="sort" type="button" data-sort="created_at">{isRu ? "Регистрация / активность" : "Registered / activity"} <span aria-hidden="true">↕</span></button></th>
              <th>Telegram</th>
              <th>{isRu ? "Контроль" : "Review"}</th>
            </tr></thead>
            <tbody data-rows></tbody>
          </table>
        </div>
        <div class="pager" data-pager aria-label={isRu ? "Навигация по страницам" : "Pagination"}>
          <button type="button" data-page-prev>{isRu ? "← Назад" : "← Previous"}</button>
          <span data-page-status></span>
          <button type="button" data-page-next>{isRu ? "Далее →" : "Next →"}</button>
        </div>
        <div class="empty hidden" data-empty><Users size={28}/><strong>{isRu ? "Нет подходящих регистраций" : "No matching registrations"}</strong></div>
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { filterHermesGridRows, nextHermesGridSort, paginateHermesGridRows, sortHermesGridRows, type HermesGridSortDirection } from "../../../../../lib/hermes-connect-data-grid";
  type Registration = {
    id:string; name?:string; email?:string; role?:string; location?:string; created_at?:string;
    shop_id?:string|null; shop_name?:string|null; phone?:string|null; city?:string|null; state?:string|null; shop_updated_at?:string|null;
    access_state?:string|null; plan_id?:string|null; current_period_end?:string|null; last_session_at?:string|null; profile_complete?:number|boolean|null;
    salesperson_code?:string|null; source?:string|null; synthetic?:number|boolean; reviewed_at?:string|null;
    registration_alert_status?:string|null; registration_alert_sent_at?:string|null; registration_alert_error?:string|null;
  };
  type Payload = {success?:boolean; summary?:Record<string,number|string>; registrations?:Registration[]; error?:string; hydration?:Record<string,unknown>};
  const ru=new URLSearchParams(location.search).get("lang")==="ru";
  const t=(en:string,ruText:string)=>ru?ruText:en;
  const q=<T extends HTMLElement>(selector:string)=>document.querySelector<T>(selector);
  const access=q<HTMLElement>("[data-access]"); const content=q<HTMLElement>("[data-content]"); const tbody=q<HTMLTableSectionElement>("[data-rows]");
  const search=q<HTMLInputElement>("[data-search]"); const kind=q<HTMLSelectElement>("[data-kind]"); const status=q<HTMLElement>("[data-status]"); const empty=q<HTMLElement>("[data-empty]");
  const pageSizeControl=q<HTMLSelectElement>("[data-page-size]"); const pageStatus=q<HTMLElement>("[data-page-status]"); const prev=q<HTMLButtonElement>("[data-page-prev]"); const next=q<HTMLButtonElement>("[data-page-next]");
  const roleFilter=q<HTMLSelectElement>("[data-role]"); const reviewFilter=q<HTMLSelectElement>("[data-review-state]"); const windowFilter=q<HTMLSelectElement>("[data-window]");
  let rows:Registration[]=[]; let page=1; let pageSize=50; let sortKey="created_at"; let sortDirection:HermesGridSortDirection="desc";
  let savedKind="real"; let savedRole="all"; let savedReview="all"; let savedWindow="all";
  const preferenceKey="hc_internal_registrations_grid_v1";
  try{const saved=JSON.parse(localStorage.getItem(preferenceKey)||"{}");if([25,50,100,200].includes(Number(saved.pageSize)))pageSize=Number(saved.pageSize);if(["name","shop_name","created_at"].includes(String(saved.sortKey)))sortKey=String(saved.sortKey);if(saved.sortDirection==="asc"||saved.sortDirection==="desc")sortDirection=saved.sortDirection;if(["real","all","synthetic"].includes(String(saved.kind)))savedKind=String(saved.kind);if(typeof saved.role==="string")savedRole=saved.role;if(["all","unreviewed","reviewed","incomplete","alert_failed"].includes(String(saved.review)))savedReview=String(saved.review);if(["all","24h","7d","30d"].includes(String(saved.window)))savedWindow=String(saved.window);}catch{}
  if(pageSizeControl)pageSizeControl.value=String(pageSize);if(kind)kind.value=savedKind;if(reviewFilter)reviewFilter.value=savedReview;if(windowFilter)windowFilter.value=savedWindow;
  const savePreferences=()=>{try{localStorage.setItem(preferenceKey,JSON.stringify({pageSize,sortKey,sortDirection,kind:kind?.value||"real",role:roleFilter?.value||"all",review:reviewFilter?.value||"all",window:windowFilter?.value||"all"}))}catch{}};
  const text=(value:unknown)=>String(value??"").trim();
  const date=(value?:string|null)=>value?new Date(value).toLocaleString(ru?"ru-RU":"en-US",{dateStyle:"medium",timeStyle:"short"}):"—";
  const isSynthetic=(row:Registration)=>Number(row.synthetic||0)===1;
  const isShopOwner=(row:Registration)=>text(row.role)==="Shop Owner";
  const isProfileComplete=(row:Registration)=>Number(row.profile_complete||0)===1;
  const syntheticDemoKind=(row:Registration)=>{const local=text(row.email).toLowerCase().split("@")[0]||"";const name=text(row.name);if(/(^|[._+-])office($|[._+-])/i.test(local)||/^office\b/i.test(name))return"office";if(/(^|[._+-])volkogon($|[._+-])/i.test(local)||/^volkogon\b/i.test(name))return"volkogon";return"";};
  const create=(tag:string,className?:string,value?:string)=>{const el=document.createElement(tag);if(className)el.className=className;if(value!==undefined)el.textContent=value;return el;};
  const searchValues=(row:Registration)=>[row.name,row.email,row.phone,row.shop_name,row.city,row.state,row.location,row.role,row.source,row.salesperson_code,row.access_state,row.plan_id];
  async function mutate(row:Registration,action:string,extra:Record<string,unknown>={}){
    if(status)status.textContent=action==="hydrate_synthetic_repair_demo"?t("Hydrating synthetic Repair Shop CRM…","Заполняем тестовую CRM СТО…"):t("Updating…","Обновляем…");
    const response=await fetch("/api/internal/registrations",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({specialist_id:row.id,action,...extra})});
    let payload:any={};try{payload=await response.json()}catch{}
    if(!response.ok||!payload.success){if(status)status.textContent=action==="hydrate_synthetic_repair_demo"?t(`Hydration failed: ${text(payload.error)||response.status}`,`Не удалось заполнить CRM: ${text(payload.error)||response.status}`):t("Update failed.","Не удалось обновить.");return;}
    const hydration=payload.hydration;
    await load();
    if(action==="hydrate_synthetic_repair_demo"&&hydration&&status){status.textContent=t(`Synthetic CRM ready · ${Number(hydration.appointment_count||0)} appointments · ${Number(hydration.staff_count||0)} staff · ${Number(hydration.service_count||0)+Number(hydration.benchmark_service_count||0)} services · through ${text(hydration.seeded_through)||"—"}`,`Тестовая CRM готова · ${Number(hydration.appointment_count||0)} записей · ${Number(hydration.staff_count||0)} сотрудников · ${Number(hydration.service_count||0)+Number(hydration.benchmark_service_count||0)} услуг · до ${text(hydration.seeded_through)||"—"}`);}
  }
  function actionButton(label:string,onClick:()=>void,className="secondary") { const button=create("button",className,label) as HTMLButtonElement;button.type="button";button.addEventListener("click",onClick);return button; }
  const matchesWindow=(row:Registration,windowValue:string)=>{if(windowValue==="all")return true;const created=Date.parse(String(row.created_at||""));if(!Number.isFinite(created))return false;const hours=windowValue==="24h"?24:windowValue==="7d"?24*7:24*30;return created>=Date.now()-hours*60*60*1000;};
  const matchesReview=(row:Registration,state:string)=>state==="all"||(state==="unreviewed"&&!isSynthetic(row)&&!row.reviewed_at)||(state==="reviewed"&&Boolean(row.reviewed_at))||(state==="incomplete"&&isShopOwner(row)&&!isProfileComplete(row))||(state==="alert_failed"&&row.registration_alert_status==="failed");
  function syncRoleOptions(){
    if(!roleFilter)return;const current=roleFilter.dataset.ready==="true"?(roleFilter.value||"all"):(savedRole||"all");const roles=[...new Set(rows.map(row=>text(row.role)).filter(Boolean))].sort((a,b)=>a.localeCompare(b));
    roleFilter.replaceChildren();const all=document.createElement("option");all.value="all";all.textContent=t("All roles","Все роли");roleFilter.append(all);
    for(const role of roles){const option=document.createElement("option");option.value=role;option.textContent=role;roleFilter.append(option);}
    roleFilter.value=roles.includes(current)?current:"all";roleFilter.dataset.ready="true";savedRole=roleFilter.value;
  }
  function render(){
    if(!tbody)return;tbody.replaceChildren();const term=search?.value||"";const mode=kind?.value||"real";const selectedRole=roleFilter?.value||"all";const selectedReview=reviewFilter?.value||"all";const selectedWindow=windowFilter?.value||"all";
    const scoped=rows.filter(row=>(mode==="all"||(mode==="real"&&!isSynthetic(row))||(mode==="synthetic"&&isSynthetic(row)))&&(selectedRole==="all"||text(row.role)===selectedRole)&&matchesReview(row,selectedReview)&&matchesWindow(row,selectedWindow));
    const filtered=filterHermesGridRows(scoped,term,searchValues);
    const sortValue=(row:Registration)=>sortKey==="name"?row.name:sortKey==="shop_name"?row.shop_name:row.created_at;
    const sorted=sortHermesGridRows(filtered,sortValue,sortDirection);
    const result=paginateHermesGridRows(sorted,page,pageSize);page=result.page;
    empty?.classList.toggle("hidden",result.total>0);
    for(const row of result.rows){
      const tr=document.createElement("tr");if(!row.reviewed_at&&!isSynthetic(row))tr.classList.add("unreviewed");if(isSynthetic(row))tr.classList.add("synthetic");if(isShopOwner(row)&&!isProfileComplete(row))tr.classList.add("incomplete");
      const user=document.createElement("td");user.append(create("strong","",text(row.name)||"—"),create("small","mono",text(row.id).slice(0,22)));
      const contact=document.createElement("td");contact.append(create("span","",text(row.email)||"—"),create("small",text(row.phone)?"":"needs",text(row.phone)||t("No phone yet","Телефон пока не указан")));
      const company=document.createElement("td");company.append(create("strong","",text(row.shop_name)||t("Profile not completed","Профиль не заполнен")),create("small","",[text(row.city),text(row.state)].filter(Boolean).join(", ")||text(row.location)||"—"));
      const source=document.createElement("td");source.append(create("span","",text(row.role)||"—"),create("small","",[text(row.salesperson_code),text(row.source)].filter(Boolean).join(" · ")||t("Direct / unknown","Прямой / неизвестно")));
      const profile=document.createElement("td");
      if(isShopOwner(row)) profile.append(create("span",isProfileComplete(row)?"ok":"needs",isProfileComplete(row)?t("Profile complete","Профиль заполнен"):t("Needs profile / phone","Нужен профиль / телефон")),create("small","",text(row.access_state)?`${text(row.access_state)}${text(row.plan_id)?` · ${text(row.plan_id)}`:""}`:t("No access state yet","Access-state пока нет")));
      else profile.append(create("span","",t("Hermes identity","Hermes identity")),create("small","",t("No business profile required","Бизнес-профиль не требуется")));
      const registered=document.createElement("td");registered.append(create("span","",date(row.created_at)),create("small",isSynthetic(row)?"test":"",`${isSynthetic(row)?t("Synthetic / QA","Тестовый / QA"):(row.reviewed_at?t("Reviewed","Просмотрено"):t("New","Новый"))} · ${t("Last session","Последняя сессия")}: ${date(row.last_session_at)}`));
      const telegram=document.createElement("td");telegram.append(create("span",`alert-${text(row.registration_alert_status)||"none"}`,text(row.registration_alert_status)||t("Not queued","Не ставилось")),create("small","",row.registration_alert_sent_at?date(row.registration_alert_sent_at):(text(row.registration_alert_error)||"—")));
      const controls=document.createElement("td");controls.className="controls";
      if(!row.reviewed_at&&!isSynthetic(row))controls.append(actionButton(t("Mark reviewed","Просмотрено"),()=>void mutate(row,"review")));
      controls.append(actionButton(isSynthetic(row)?t("Mark real","Сделать реальным"):t("Mark test","Сделать тестовым"),()=>void mutate(row,"set_synthetic",{synthetic:!isSynthetic(row)}),"ghost"));
      if(isSynthetic(row)&&isShopOwner(row)&&syntheticDemoKind(row))controls.append(actionButton(t("Hydrate test CRM","Заполнить тестовую CRM"),()=>void mutate(row,"hydrate_synthetic_repair_demo")));
      if(!isSynthetic(row)&&["failed","pending",null,undefined].includes(row.registration_alert_status as any))controls.append(actionButton(t("Retry Telegram","Повторить Telegram"),()=>void mutate(row,"retry_registration_alert"),"ghost"));
      tr.append(user,contact,company,source,profile,registered,telegram,controls);tbody.append(tr);
    }
    if(status)status.textContent=t(`${result.start}–${result.end} of ${result.total} matching · ${rows.length} loaded`,`${result.start}–${result.end} из ${result.total} найденных · загружено ${rows.length}`);
    if(pageStatus)pageStatus.textContent=t(`Page ${result.page} of ${result.pageCount}`,`Страница ${result.page} из ${result.pageCount}`);
    if(prev)prev.disabled=result.page<=1;if(next)next.disabled=result.page>=result.pageCount;
    document.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach(button=>{const active=button.dataset.sort===sortKey;button.dataset.active=String(active);button.setAttribute("aria-pressed",String(active));button.setAttribute("aria-label",active?t(`Sort ${button.textContent?.trim()||""} ${sortDirection==="asc"?"descending":"ascending"}`,`Сортировать ${button.textContent?.trim()||""} ${sortDirection==="asc"?"по убыванию":"по возрастанию"}`):t(`Sort by ${button.textContent?.trim()||""}`,`Сортировать по ${button.textContent?.trim()||""}`));const marker=button.querySelector("span");if(marker)marker.textContent=active?(sortDirection==="asc"?"↑":"↓"):"↕";});
  }
  async function load(){
    if(status)status.textContent=t("Loading registrations…","Загружаем регистрации…");
    const response=await fetch("/api/internal/registrations",{credentials:"same-origin",headers:{Accept:"application/json"}});let payload:Payload={};try{payload=await response.json()}catch{}
    if(!response.ok||!payload.success){if(access){access.querySelector("strong")!.textContent=response.status===401?t("Sign in required","Нужно войти"):t("Internal owner capability required","Нужен доступ владельца");access.querySelector("p")!.textContent=t("This ledger never exposes user data without the server-side owner capability.","Реестр не раскрывает данные пользователей без серверного права владельца.");}return;}
    access?.classList.add("hidden");content?.classList.remove("hidden");rows=Array.isArray(payload.registrations)?payload.registrations:[];syncRoleOptions();
    for(const [key,value] of Object.entries(payload.summary||{})){const el=document.querySelector<HTMLElement>(`[data-stat="${key}"]`);if(el)el.textContent=String(value)}render();
  }
  search?.addEventListener("input",()=>{page=1;render()});kind?.addEventListener("change",()=>{page=1;savePreferences();render()});
  roleFilter?.addEventListener("change",()=>{page=1;savePreferences();render()});reviewFilter?.addEventListener("change",()=>{page=1;savePreferences();render()});windowFilter?.addEventListener("change",()=>{page=1;savePreferences();render()});
  pageSizeControl?.addEventListener("change",()=>{pageSize=Number(pageSizeControl.value)||50;page=1;savePreferences();render()});
  prev?.addEventListener("click",()=>{page=Math.max(1,page-1);render()});next?.addEventListener("click",()=>{page+=1;render()});
  document.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach(button=>button.addEventListener("click",()=>{const requested=button.dataset.sort||"created_at";const nextSort=nextHermesGridSort(sortKey,sortDirection,requested);sortKey=nextSort.key;sortDirection=nextSort.direction;page=1;savePreferences();render()}));
  q<HTMLButtonElement>("[data-refresh]")?.addEventListener("click",()=>void load());void load();
</script>

<style>
.registrations-page{min-height:78vh;background:#f7f6f3;color:#11161f}.shell{width:min(1320px,calc(100% - 2rem));margin:auto;padding:2.2rem 0 5rem}.hero{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.2rem}.hero h1{font-size:clamp(2.2rem,5vw,3.8rem);margin:.32rem 0 .6rem}.hero p{max-width:820px;color:#657083;line-height:1.6}.kicker{display:flex;align-items:center;gap:.4rem;color:#a75000!important;font-size:.72rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase;margin:0}.owner-badge{display:inline-flex;align-items:center;gap:.4rem;border:1px solid rgba(167,80,0,.18);border-radius:999px;padding:.5rem .7rem;background:#fff8f0;color:#8a4300;font-size:.75rem;font-weight:800;white-space:nowrap}.access,.summary article,.toolbar,.table-wrap,.empty{border:1px solid rgba(17,22,31,.1);background:rgba(255,255,255,.94);box-shadow:0 16px 38px rgba(24,32,48,.055)}.access{border-radius:1rem;padding:1.1rem}.access p{margin:.3rem 0 0;color:#657083}.hidden{display:none!important}.content{display:grid;gap:.85rem}.summary{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.7rem}.summary article{border-radius:1rem;padding:.95rem}.summary span{display:block;color:#768192;font-size:.7rem}.summary strong{display:block;margin-top:.2rem;font-size:1.35rem}.toolbar{display:grid;grid-template-columns:minmax(240px,1fr) repeat(6,auto);gap:.7rem;padding:.75rem;border-radius:1rem}.search-wrap{display:flex;align-items:center;gap:.55rem;min-height:44px;border:1px solid rgba(17,22,31,.11);border-radius:.75rem;padding:0 .75rem;background:#fff}.search-wrap input{width:100%;border:0;outline:0;background:transparent;color:#11161f;font:inherit}.toolbar select,.refresh{min-height:44px;border:1px solid rgba(17,22,31,.11);border-radius:.75rem;background:#fff;color:#11161f;padding:.55rem .75rem;font:inherit;font-weight:700}.refresh{display:inline-flex;align-items:center;gap:.4rem;cursor:pointer}.status-line{min-height:1.4rem;color:#657083;font-