---
import { Activity, Bot, Building2, CircleDollarSign, GraduationCap, Megaphone, Mic, PackageCheck, Route, ShieldCheck, Sparkles, Truck, Users, Wrench } from "@lucide/astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../components/SiteFooter.astro";
import HermesConnectExperience from "../../../../../components/HermesConnectExperience.astro";
import HermesConnectInternalAiNav from "../../../../../components/HermesConnectInternalAiNav.astro";
import HermesAiArchitecture from "../../../../../components/HermesAiArchitecture.astro";
import { HAE_OWNER_PROCESS_TEMPLATES } from "../../../../../lib/hae-process-control.mjs";
const ru=Astro.url.searchParams.get("lang")==="ru";
const modules=[
  {key:"marketing",icon:Megaphone,title:ru?"Маркетинг":"Marketing",copy:ru?"Сайт, SEO/GEO, SMM, рекламные каналы и доказуемый путь до заявки.":"Website, SEO/GEO, social, paid channels and an inspectable path to inquiry.",links:[["Marketing","/paths/marketing/"],["Website Development","/services/website-development/"],["Unified Inbox","/services/hermes-connect/unified-inbox/"]]},
  {key:"logistics",icon:Truck,title:ru?"Логистика":"Logistics",copy:ru?"Car hauling, carriers, dealer/shipper operations и Load Board.":"Car hauling, carriers, dealer/shipper operations and Load Board.",links:[["Logistics","/paths/logistics/"],["Load Board","/load-board/"],["Rate Negotiator","/services/hermes-connect/rate-negotiator/"]]},
  {key:"sales",icon:Users,title:ru?"Продажи":"Sales",copy:ru?"Лиды, qualification, предложения, follow-up и переход к полученным деньгам.":"Leads, qualification, proposals, follow-up and the path to collected revenue.",links:[["Unified Inbox","/services/hermes-connect/unified-inbox/"],["Proposal Builder","/services/hermes-connect/proposal-builder/"],["ROI Calculator","/services/hermes-connect/roi-calculator/"]]},
  {key:"technology",icon:Wrench,title:ru?"Технологии":"Technology",copy:ru?"Hermes Connect, сайты, CRM-модули, автоматизация и внутренний AI.":"Hermes Connect, websites, CRM modules, automation and internal AI.",links:[["Hermes Connect","/services/hermes-connect/"],["AI Connect","/services/hermes-connect/internal/ai-connect/"],["AI Assistant","/services/hermes-connect/internal/ai-assistant/"]]},
  {key:"academy",icon:GraduationCap,title:ru?"Академия":"Academy",copy:ru?"Обучение, практика, CRM учебного бизнеса и прогресс участников.":"Training, practice, Academy-business CRM and participant progress.",links:[["Academy","/services/hermes-connect/academy/"],["Academy Dashboard","/services/hermes-connect/academy/dashboard/"],["Business Workspace","/services/hermes-connect/academy/business/workspace/"]]},
  {key:"finance",icon:CircleDollarSign,title:ru?"Финансы":"Finance",copy:ru?"Экономика проектов и ROI. Платёжный/бухгалтерский модуль пока не объявляется объединённым.":"Project economics and ROI. Billing/accounting is not yet claimed as one unified live module.",links:[["ROI Calculator","/services/hermes-connect/roi-calculator/"]]},
  {key:"operations",icon:PackageCheck,title:ru?"Операции":"Operations",copy:ru?"Внутренние процессы, inbox, автоматизация и межотдельная очередь владельца.":"Internal processes, inbox, automation and the owner cross-team queue.",links:[["Business Automation","/services/hermes-connect/business-automation/"],["Unified Inbox","/services/hermes-connect/unified-inbox/"]]},
];
---
<BaseLayout title={ru?"Центр управления бизнесом | Hermes Connect":"Business Command Center | Hermes Connect"} description={ru?"Приватная CRM-админка владельца Hermes: направления бизнеса, очередь задач и AI runner.":"Private Hermes owner CRM/admin: business directions, work backlog and AI runner."} robots="noindex,nofollow,noarchive">
  <SiteHeader activePath="/paths/technology/"/>
  <HermesConnectExperience/>
  <HermesConnectInternalAiNav/>
  <main class="command-page" data-command-center>
    <div class="shell">
      <header class="hero">
        <div><p class="kicker"><Sparkles size={15}/>Hermes Connect · Owner OS</p><h1>{ru?"Центр управления бизнесом":"Business Command Center"}</h1><p>{ru?"Одно место для направлений Hermes, задач владельца и AI-исполнения. Задачи хранятся в облаке: Mac может быть офлайн, а очередь не пропадёт.":"One place for Hermes business directions, owner work and AI execution. Work is stored in the cloud: the Mac may be offline without losing the queue."}</p></div>
        <span class="owner-pill"><ShieldCheck size={16}/>HERMES_INTERNAL_OWNER</span>
      </header>

      <section class="access-card" data-access role="status"><strong>{ru?"Проверяем доступ владельца…":"Checking owner access…"}</strong><p>{ru?"Данные откроются только после серверной проверки owner capability.":"Data opens only after server-side owner capability verification."}</p></section>

      <div data-private hidden>
        <section class="status-grid">
          <article><span>{ru?"Облако":"Cloud"}</span><strong>Cloudflare + D1</strong><small>{ru?"CRM и очередь доступны независимо от Mac":"CRM and queue remain available without the Mac"}</small></article>
          <article><span>{ru?"Агент":"Agent"}</span><strong data-runner-state>—</strong><small data-runner-copy>—</small></article>
          <article><span>{ru?"Очередь":"Backlog"}</span><strong data-backlog-count>0</strong><small>{ru?"незавершённых work items":"unfinished work items"}</small></article>
          <article><span>{ru?"Подтверждения":"Approvals"}</span><strong data-approval-count>0</strong><small>{ru?"AI-задач ждут owner gate":"AI tasks waiting at owner gate"}</small></article>
        </section>

        <section class="section panel account-portfolio"><div class="section-head"><div><p class="kicker"><Building2 size={14}/>{ru?"Мой Hermes":"My Hermes"}</p><h2>{ru?"Подключённые рабочие пространства":"Connected workspaces"}</h2></div><span data-account-identity class="cloud-note">—</span></div><div class="workspace-grid" data-account-workspaces><p class="muted">{ru?"Загружаем доступы…":"Loading access…"}</p></div></section>

        <HermesAiArchitecture ru={ru}/>

        <section class="section">
          <div class="section-head"><div><p class="kicker"><Building2 size={14}/>{ru?"Направления":"Business directions"}</p><h2>{ru?"Что сейчас есть в системе":"What is already connected"}</h2></div></div>
          <div class="module-grid">
            {modules.map((module)=>{const Icon=module.icon;return <article class="module-card" data-module={module.key}><div class="module-top"><span class={"module-icon "+module.key}><Icon size={19}/></span><span class="module-state">{ru?"Открыть":"Open"}</span></div><h3>{module.title}</h3><p>{module.copy}</p><div class="module-links">{module.links.map(([label,href])=><a href={href}>{label}</a>)}</div><button type="button" class="module-focus" data-focus-workstream={module.key}>{ru?"Показать задачи направления":"Show direction work"}</button></article>})}
            <article class="module-card agents"><div class="module-top"><span class="module-icon agents"><Bot size={19}/></span><span class="module-state" data-agent-badge>—</span></div><h3>{ru?"Агенты":"Agents"}</h3><p>{ru?"Hermes AI runner, история выполнения, approval gates и PR/evidence.":"Hermes AI runner, execution history, approval gates and PR/evidence."}</p><div class="module-links"><a href="#hermes-ai-architecture">{ru?"Архитектура ИИ":"AI Architecture"}</a><a href="/services/hermes-connect/internal/ai-connect/">{ru?"AI Connect":"AI Connect"}</a><a href="/services/hermes-connect/internal/ai-connect/activity/">{ru?"История":"Activity"}</a></div></article>
          </div>
        </section>

        <section class="section two-col">
          <article class="panel capture-panel">
            <div class="section-head"><div><p class="kicker"><Mic size={14}/>{ru?"Быстрый ввод":"Quick capture"}</p><h2>{ru?"Надиктуй или запиши задачу":"Dictate or type a task"}</h2></div><span class="cloud-note">{ru?"Сохраняется в D1":"Saved to D1"}</span></div>
            <form data-work-form>
              <div class="row"><label>{ru?"Направление":"Direction"}<select name="workstream"><option value="marketing">Marketing</option><option value="logistics">Logistics</option><option value="sales">Sales</option><option value="technology">Technology</option><option value="academy">Academy</option><option value="finance">Finance</option><option value="operations">Operations</option></select></label><label>{ru?"Приоритет":"Priority"}<select name="priority"><option value="p0">P0 · Critical</option><option value="p1">P1 · High</option><option value="p2" selected>P2 · Normal</option><option value="p3">P3 · Later</option></select></label></div>
              <label>{ru?"Название (необязательно)":"Title (optional)"}<input name="title" maxlength="160" placeholder={ru?"Если оставить пустым, возьмём первую строку задания":"If blank, the first instruction line becomes the title"}/></label>
              <label>{ru?"Что нужно сделать":"Instructions"}<textarea name="details" rows="7" maxlength="10000" required placeholder={ru?"Говори обычным языком. Это попадёт в backlog, а не сразу запустит агента.":"Use normal language. This goes to the backlog and does not immediately run the agent."}></textarea></label>
              <div class="capture-actions"><button type="button" class="secondary" data-dictate><Mic size={15}/>{ru?"Диктовать":"Dictate"}</button><button type="submit" class="primary"><PackageCheck size={15}/>{ru?"Сохранить в очередь":"Save to backlog"}</button></div>
              <p data-capture-status role="status"></p>
            </form>
          </article>

          <article class="panel agent-panel">
            <div class="section-head"><div><p class="kicker"><Activity size={14}/>{ru?"Исполнение":"Execution"}</p><h2>{ru?"Mac runner":"Mac runner"}</h2></div></div>
            <dl><div><dt>Status</dt><dd data-agent-status>—</dd></div><div><dt>{ru?"Последний heartbeat":"Last heartbeat"}</dt><dd data-agent-seen>—</dd></div><div><dt>{ru?"Активная AI-задача":"Active AI task"}</dt><dd data-active-task>—</dd></div><div><dt>Repo SHA</dt><dd data-agent-sha>—</dd></div></dl>
            <p class="muted">{ru?"Если Mac выключится, новые work items остаются в D1. Кнопка Run передаёт только одну задачу в существующую AI-очередь; остальные ждут.":"If the Mac goes offline, new work items remain in D1. Run dispatches only one item to the existing AI queue; the rest wait."}</p>
            <a class="text-link" href="/services/hermes-connect/internal/ai-connect/">{ru?"Открыть AI Control Center →":"Open AI Control Center →"}</a>
          </article>
        </section>

        <section class="section panel process-control" data-process-control>
          <div class="section-head"><div><p class="kicker"><Activity size={14}/>{ru?"Автономная работа":"Autonomous work"}</p><h2>{ru?"Процессы HAE 24/7":"HAE 24/7 processes"}</h2></div><span class="cloud-note">D1 · Queue · $0 default</span></div>
          <p class="muted">{ru?"Создай процесс из проверенной read-only возможности, затем явно активируй его. HAE подхватит процесс на ближайшем часовом tick, сохранит каждый запуск и продолжит работать без открытого чата. Внешние отправки и платный AI здесь отключены.":"Create a process from a verified read-only capability, then activate it explicitly. HAE picks it up on the next hourly tick, records every run and continues without an open chat. External sends and paid AI are disabled here."}</p>
          <form data-process-form class="process-form">
            <label>{ru?"Название процесса":"Process name"}<input name="name" maxlength="160" placeholder={ru?"Можно оставить пустым":"Optional"}/></label>
            <label>{ru?"Что проверять":"Capability"}<select name="job_type">{HAE_OWNER_PROCESS_TEMPLATES.map((template)=><option value={template.job_type} data-cadences={template.allowed_cadence_hours.join(",")}>{ru?template.label_ru:template.label}</option>)}</select></label>
            <label>{ru?"Частота":"Cadence"}<select name="cadence_hours"><option value="1">{ru?"Каждый час":"Every hour"}</option><option value="6">{ru?"Каждые 6 часов":"Every 6 hours"}</option><option value="12">{ru?"Каждые 12 часов":"Every 12 hours"}</option><option value="24">{ru?"Каждые 24 часа":"Every 24 hours"}</option><option value="168">{ru?"Каждую неделю":"Every week"}</option></select></label>
            <button type="submit" class="primary">{ru?"Создать на паузе":"Create paused"}</button>
            <p data-process-status role="status"></p>
          </form>
          <div class="process-list" data-process-list><p class="muted">{ru?"Загружаем процессы…":"Loading processes…"}</p></div>
        </section>

        <section class="section panel">
          <div class="section-head"><div><p class="kicker"><Route size={14}/>{ru?"Backlog":"Backlog"}</p><h2 data-backlog-title>{ru?"Все задания владельца":"Owner work queue"}</h2></div><button type="button" class="secondary" data-refresh>{ru?"Обновить":"Refresh"}</button></div>
          <div class="filters" data-filters><button class="active" data-filter="open">{ru?"Открытые":"Open"}</button><button data-filter="awaiting_acceptance">{ru?"На приёмке":"Needs acceptance"}</button><button data-filter="marketing">Marketing</button><button data-filter="logistics">Logistics</button><button data-filter="sales">Sales</button><button data-filter="technology">Technology</button><button data-filter="academy">Academy</button><button data-filter="finance">Finance</button><button data-filter="operations">Operations</button><button data-filter="done">{ru?"Принято":"Accepted"}</button></div>
          <div class="work-list" data-work-list><p>{ru?"Загружаем очередь…":"Loading backlog…"}</p></div>
        </section>

        <section class="section panel access-admin">
          <div class="section-head"><div><p class="kicker"><ShieldCheck size={14}/>{ru?"Доступ":"Access"}</p><h2>{ru?"Владельцы Command Center":"Command Center owners"}</h2></div></div>
          <p class="muted">{ru?"Доступ не определяется по имени или домену почты. Выдавать capability можно только уже существующему Hermes-аккаунту; каждое изменение пишется в audit trail.":"Access is never inferred from a name or email domain. Capability can be granted only to an existing Hermes account; every change is audited."}</p>
          <div class="owner-list" data-owner-list></div>
          <form data-access-form><label>{ru?"Email существующего Hermes-аккаунта":"Existing Hermes account email"}<input name="email" type="email" autocomplete="off" required placeholder="team@example.com"/></label><div class="access-actions"><button type="submit" name="action" value="grant" class="primary">{ru?"Выдать доступ":"Grant access"}</button><button type="submit" name="action" value="revoke" class="danger">{ru?"Отозвать":"Revoke"}</button></div><p data-access-status role="status"></p></form>
        </section>
      </div>
    </div>
  </main>
  <SiteFooter/>
</BaseLayout>

<script>
type WorkItem={id:string;workstream:string;priority:string;title:string;details:string;source:string;status:string;created_at?:string;updated_at?:string;completed_at?:string|null;accepted_by?:string|null;accepted_at?:string|null;linked_task_id?:string|null;linked_task_status?:string|null;linked_task_pr_url?:string|null;linked_task_output_summary?:string|null;blocked_reason?:string|null};
type HaeProcess={id:string;name:string;job_type:string;business_lane:string;workstream:string;role_id:string;cadence_hours:number;status:string;next_run_at?:string|null;last_run_at?:string|null;last_job_id?:string|null;last_job_state?:string|null;last_job_completed_at?:string|null;last_error_class?:string|null;template_label:string;template_label_ru:string};
const isRu=new URLSearchParams(location.search).get("lang")==="ru";
const q=<T extends HTMLElement=HTMLElement>(s:string)=>document.querySelector<T>(s);
const t=(en:string,ru:string)=>isRu?ru:en;
let items:WorkItem[]=[],processes:HaeProcess[]=[],filter="open",runtime:any=null,tasks:any[]=[];
const stamp=(v?:string|null)=>v?new Date(v).toLocaleString(isRu?"ru-RU":"en-US",{dateStyle:"medium",timeStyle:"short"}):"—";
async function jsonFetch(url:string,options:RequestInit={}){const r=await fetch(url,{credentials:"same-origin",cache:"no-store",...options,headers:{Accept:"application/json",...(options.body?{"Content-Type":"application/json"}:{}),...(options.headers||{})}});let d:any={};try{d=await r.json()}catch{}return{r,d}}
function setText(sel:string,value:string){const n=q(sel);if(n)n.textContent=value}
function safePr(value?:string|null){if(!value)return null;try{const u=new URL(value);return u.protocol==="https:"&&u.hostname==="github.com"&&/^\/officeus-create\/Hermes\/pull\/\d+\/?$/.test(u.pathname)?u.href:null}catch{return null}}
async function loadAll(){
  const status=await jsonFetch("/api/internal-ai/status");
  if(!status.r.ok||!status.d.success){q("[data-private]")!.hidden=true;const access=q("[data-access]")!;access.hidden=false;access.querySelector("strong")!.textContent=status.r.status===401?t("Sign in required","Нужно войти"):t("HERMES_INTERNAL_OWNER required","Нужен HERMES_INTERNAL_OWNER");return}
  q("[data-access]")!.hidden=true;q("[data-private]")!.hidden=false;runtime=status.d.runtime||{};const active=status.d.active_task||null;
  setText("[data-runner-state]",runtime.online?t("Online","Онлайн"):t("Offline","Офлайн"));setText("[data-runner-copy]",runtime.online?t("Mac runner is accepting work","Mac runner принимает работу"):t("Cloud backlog remains safe","Облачная очередь сохранена"));
  setText("[data-agent-badge]",runtime.online?t("Online","Онлайн"):t("Offline","Офлайн"));setText("[data-agent-status]",runtime.online?t("Online","Онлайн"):t("Offline","Офлайн"));setText("[data-agent-seen]",stamp(runtime.last_seen_at));setText("[data-agent-sha]",runtime.repo_sha||"—");
  setText("[data-ai-map-runner]",runtime.online?t("Online · Local Qwen","Онлайн · Локальный Qwen"):t("Offline / awaiting heartbeat","Офлайн / ожидается heartbeat"));
  setText("[data-ai-map-runner-time]",runtime.last_seen_at?t("Last heartbeat: ","Последний сигнал: ")+stamp(runtime.last_seen_at):t("No verified heartbeat","Нет подтверждённого heartbeat"));setText("[data-active-task]",active?(String(active.status||"")+(active.id?" · "+String(active.id).slice(-10):"")):t("None","Нет"));
  const [work,taskList,accessList,account,processList]=await Promise.all([jsonFetch("/api/internal-command-center/work-items"),jsonFetch("/api/internal-ai/tasks"),jsonFetch("/api/internal-command-center/access"),jsonFetch("/api/hermes-connect/account"),jsonFetch("/api/internal-command-center/processes")]);
  if(work.r.ok&&work.d.success)items=work.d.work_items||[]; if(taskList.r.ok&&taskList.d.success)tasks=taskList.d.tasks||[]; if(account.r.ok&&account.d.success)renderAccount(account.d);if(processList.r.ok&&processList.d.success)processes=processList.d.processes||[];
  setText("[data-backlog-count]",String(items.filter(x=>!["done","cancelled"].includes(x.status)).length));setText("[data-approval-count]",String(tasks.filter(x=>x.status==="needs_approval").length));
  document.querySelectorAll<HTMLElement>("[data-module]").forEach(card=>{const key=card.dataset.module||"";const count=items.filter(x=>x.workstream===key&&!["done","cancelled"].includes(x.status)).length;const badge=card.querySelector<HTMLElement>(".module-state");if(badge)badge.textContent=count?String(count)+" "+t("open","открыто"):t("Clear","Чисто")});
  renderItems();renderProcesses(); if(accessList.r.ok&&accessList.d.success)renderOwners(accessList.d);
}
function visible(item:WorkItem){if(filter==="open")return !["done","cancelled"].includes(item.status);if(filter==="done")return item.status==="done";if(filter==="awaiting_acceptance")return item.status==="awaiting_acceptance";return item.workstream===filter}
function renderItems(){
 const box=q("[data-work-list]");if(!box)return;box.replaceChildren();const rows=items.filter(visible);
 if(!rows.length){const p=document.createElement("p");p.className="muted";p.textContent=t("No work items in this view.","В этом списке задач нет.");box.append(p);return}
 rows.forEach(item=>{const card=document.createElement("article");card.className="work-card";const top=document.createElement("div");top.className="work-top";const meta=document.createElement("div");const title=document.createElement("strong");title.textContent=item.title;const line=document.createElement("span");line.textContent=item.workstream.toUpperCase()+" · "+item.priority.toUpperCase()+" · "+item.status.replaceAll("_"," ");meta.append(title,line);const time=document.createElement("small");time.textContent=stamp(item.updated_at||item.created_at);top.append(meta,time);
 const body=document.createElement("p");body.textContent=item.details;card.append(top,body);if(item.blocked_reason){const b=document.createElement("p");b.className="blocked";b.textContent=item.blocked_reason;card.append(b)}
 if(item.linked_task_status){const l=document.createElement("p");l.className="linked";l.textContent=t("Execution: ","Выполнение: ")+item.linked_task_status;card.append(l)}
 if(item.status==="awaiting_acceptance"){const review=document.createElement("p");review.className="acceptance-note";review.textContent=t("Execution finished. Review the evidence before accepting the business result.","Выполнение закончено. Проверь результат и доказательства перед приёмкой.");card.append(review)}
 if(item.linked_task_output_summary){const output=document.createElement("p");output.className="output-summary";output.textContent=t("Result: ","Результат: ")+item.linked_task_output_summary;card.append(output)}
 const actions=document.createElement("div");actions.className="work-actions";
 const make=(label:string,action:string,cls="secondary")=>{const b=document.createElement("button");b.type="button";b.className=cls;b.textContent=label;b.addEventListener("click",()=>mutate(item.id,action));return b};
 if(item.status==="planned"||(item.status==="blocked"&&item.linked_task_status!=="completed"))actions.append(make(t("Ready","В очередь"),"ready"));
 if(["planned","ready","blocked"].includes(item.status))actions.append(make(t("Run with Hermes AI","Запустить Hermes AI"),"dispatch","primary"));
 if(item.status==="awaiting_acceptance"){actions.append(make(t("Accept result","Принять результат"),"accept","primary"));const rework=document.createElement("button");rework.type="button";rework.className="secondary";rework.textContent=t("Needs rework","Нужна доработка");rework.addEventListener("click",()=>{const reason=prompt(t("What must be corrected?","Что нужно исправить?"));if(reason?.trim())void mutate(item.id,"block",reason.trim())});actions.append(rework)}
 if(!item.linked_task_id&&!["done","cancelled","in_progress","awaiting_acceptance"].includes(item.status))actions.append(make(t("Mark manual work done","Завершить вручную"),"complete"));
 if(!["done","cancelled"].includes(item.status)&&!["queued","running","needs_approval"].includes(item.linked_task_status||""))actions.append(make(t("Cancel","Отменить"),"cancel","danger"));
 const pr=safePr(item.linked_task_pr_url);if(pr){const a=document.createElement("a");a.href=pr;a.target="_blank";a.rel="noopener";a.textContent="PR ↗";actions.append(a)}
 card.append(actions);box.append(card)});
}
async function mutate(id:string,action:string,reason?:string){const x=await jsonFetch("/api/internal-command-center/work-items/"+encodeURIComponent(id),{method:"PATCH",body:JSON.stringify({action,...(reason?{reason}:{})})});if(!x.r.ok){alert(String(x.d.error||"update_failed"));return}await loadAll()}
function renderProcesses(){const box=q("[data-process-list]");if(!box)return;box.replaceChildren();if(!processes.length){const p=document.createElement("p");p.className="muted";p.textContent=t("No autonomous processes configured yet.","Автономные процессы пока не настроены.");box.append(p);return}processes.forEach(process=>{const card=document.createElement("article");card.className="process-card";const head=document.createElement("div");head.className="process-head";const identity=document.createElement("div");const strong=document.createElement("strong");strong.textContent=process.name;const meta=document.createElement("small");meta.textContent=(isRu?process.template_label_ru:process.template_label)+" · "+process.role_id+" · "+process.cadence_hours+"h";identity.append(strong,meta);const state=document.createElement("span");state.className="process-state "+process.status;state.textContent=process.status.replaceAll("_"," ");head.append(identity,state);card.append(head);const timing=document.createElement("dl");timing.innerHTML=`<div><dt>${t("Next HAE tick","Следующий запуск HAE")}</dt><dd>${stamp(process.next_run_at)}</dd></div><div><dt>${t("Last run","Последний запуск")}</dt><dd>${stamp(process.last_run_at)}</dd></div><div><dt>${t("Last job","Последняя job")}</dt><dd>${process.last_job_state||"—"}</dd></div>`;card.append(timing);if(process.last_error_class){const error=document.createElement("p");error.className="blocked";error.textContent=t("Error: ","Ошибка: ")+process.last_error_class;card.append(error)}const actions=document.createElement("div");actions.className="work-actions";const button=(label:string,action:string,cls="secondary")=>{const b=document.createElement("button");b.type="button";b.className=cls;b.textContent=label;b.addEventListener("click",()=>mutateProcess(process.id,action));return b};if(process.status!=="active")actions.append(button(t("Activate","Активировать"),"activate","primary"));if(process.status==="active"){actions.append(button(t("Run on next HAE tick","Запустить на следующем tick"),"run_next_tick","primary"));actions.append(button(t("Pause","Пауза"),"pause"))}card.append(actions);box.append(card)})}
async function mutateProcess(id:string,action:string){const x=await jsonFetch("/api/internal-command-center/processes/"+encodeURIComponent(id),{method:"PATCH",body:JSON.stringify({action})});if(!x.r.ok){setText("[data-process-status]",String(x.d.error||"process_update_failed"));return}setText("[data-process-status]",action==="activate"?t("Activated. HAE will claim it on the next hourly tick.","Активировано. HAE заберёт процесс на следующем часовом tick."):t("Process updated.","Процесс обновлён."));await loadAll()}
q("[data-work-form]")?.addEventListener("submit",async(e)=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const data=new FormData(form);const source=form.dataset.source==="voice"?"voice":"text";const x=await jsonFetch("/api/internal-command-center/work-items",{method:"POST",body:JSON.stringify({workstream:data.get("workstream"),priority:data.get("priority"),title:data.get("title"),details:data.get("details"),source})});if(!x.r.ok){setText("[data-capture-status]",String(x.d.error||"save_failed"));return}form.reset();form.dataset.source="text";setText("[data-capture-status]",t("Saved to cloud backlog.","Сохранено в облачную очередь."));await loadAll()});
const processForm=q<HTMLFormElement>("[data-process-form]");const processType=processForm?.elements.namedItem("job_type") as HTMLSelectElement|null;const processCadence=processForm?.elements.namedItem("cadence_hours") as HTMLSelectElement|null;function syncProcessCadence(){if(!processType||!processCadence)return;const allowed=(processType.selectedOptions[0]?.dataset.cadences||"").split(",");Array.from(processCadence.options).forEach(option=>option.hidden=!allowed.includes(option.value));if(!allowed.includes(processCadence.value))processCadence.value=allowed[0]||"24"}processType?.addEventListener("change",syncProcessCadence);syncProcessCadence();processForm?.addEventListener("submit",async(e)=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const data=new FormData(form);const x=await jsonFetch("/api/internal-command-center/processes",{method:"POST",body:JSON.stringify({name:data.get("name"),job_type:data.get("job_type"),cadence_hours:Number(data.get("cadence_hours"))})});if(!x.r.ok){setText("[data-process-status]",String(x.d.error||"process_create_failed"));return}form.reset();syncProcessCadence();setText("[data-process-status]",t("Process created paused. Review it, then activate.","Процесс создан на паузе. Проверь и активируй."));await loadAll()});
q("[data-dictate]")?.addEventListener("click",()=>{const Ctor=(window as any).SpeechRecognition||(window as any).webkitSpeechRecognition;if(!Ctor){setText("[data-capture-status]",t("Browser speech recognition is unavailable. Use the keyboard or OS dictation.","Распознавание речи браузером недоступно. Используй клавиатуру или диктовку ОС."));return}const rec=new Ctor();rec.lang=isRu?"ru-RU":"en-US";rec.interimResults=false;rec.maxAlternatives=1;setText("[data-capture-status]",t("Listening…","Слушаю…"));rec.onresult=(ev:any)=>{const text=String(ev.results?.[0]?.[0]?.transcript||"").trim();const area=q<HTMLTextAreaElement>('textarea[name="details"]');if(area){area.value=(area.value?area.value+"\n":"")+text;(q<HTMLFormElement>("[data-work-form]")!).dataset.source="voice"}setText("[data-capture-status]",t("Dictation added. Review before saving.","Диктовка добавлена. Проверь перед сохранением."))};rec.onerror=()=>setText("[data-capture-status]",t("Dictation failed; nothing was saved.","Диктовка не сработала; ничего не сохранено."));rec.start()});
q("[data-refresh]")?.addEventListener("click",()=>void loadAll());
document.querySelectorAll<HTMLButtonElement>("[data-focus-workstream]").forEach(button=>button.addEventListener("click",()=>{const next=button.dataset.focusWorkstream||"open";filter=next;const filterButton=q("[data-filters]")?.querySelector<HTMLButtonElement>(`[data-filter="${CSS.escape(next)}"]`);q("[data-filters]")?.querySelectorAll("button").forEach(x=>x.classList.toggle("active",x===filterButton));setText("[data-backlog-title]",t("Work queue · ","Очередь · ")+next.charAt(0).toUpperCase()+next.slice(1));renderItems();const url=new URL(location.href);url.searchParams.set("direction",next);history.replaceState(null,"",url);q("[data-work-list]")?.scrollIntoView({behavior:"smooth",block:"start"})}));
const initialDirection=new URLSearchParams(location.search).get("direction");if(initialDirection&&["marketing","logistics","sales","technology","academy","finance","operations"].includes(initialDirection)){filter=initialDirection;const initialButton=q("[data-filters]")?.querySelector<HTMLButtonElement>(`[data-filter="${CSS.escape(initialDirection)}"]`);q("[data-filters]")?.querySelectorAll("button").forEach(x=>x.classList.toggle("active",x===initialButton));setText("[data-backlog-title]",t("Work queue · ","Очередь · ")+initialDirection.charAt(0).toUpperCase()+initialDirection.slice(1));}
q("[data-filters]")?.addEventListener("click",(e)=>{const b=(e.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");if(!b)return;filter=b.dataset.filter||"open";q("[data-filters]")?.querySelectorAll("button").forEach(x=>x.classList.toggle("active",x===b));renderItems()});
function renderAccount(data:any){const box=q("[data-account-workspaces]");if(!box)return;box.replaceChildren();const identity=data.identity||{};setText("[data-account-identity]",identity.name||identity.email||t("Owner account","Аккаунт владельца"));const rows=[...(data.owned_businesses||[]).map((x:any)=>({label:x.name||x.key,href:x.href,state:x.workspace_state||"business"})),...(data.workspaces||[]).map((x:any)=>({label:String(x.key||"workspace").replaceAll("_"," "),href:x.href,state:x.kind||"workspace"}))];if(!rows.length){const p=document.createElement("p");p.className="muted";p.textContent=t("No connected business workspaces for this account yet.","У этого аккаунта пока нет подключённых бизнес-workspaces.");box.append(p);return}rows.forEach((row:any)=>{const a=document.createElement("a");a.className="workspace-tile";a.href=String(row.href||"#");const strong=document.createElement("strong");strong.textContent=String(row.label||"Workspace");const small=document.createElement("small");small.textContent=String(row.state||"workspace").replaceAll("_"," ");a.append(strong,small);box.append(a)})}
function renderOwners(data:any){const box=q("[data-owner-list]");if(!box)return;box.replaceChildren();(data.access||[]).forEach((owner:any)=>{const row=document.createElement("div");row.className="owner-row";const identity=document.createElement("div");const strong=document.createElement("strong");strong.textContent=owner.name||owner.email||owner.specialist_id;const small=document.createElement("small");small.textContent=(owner.email||"")+" · "+(owner.active?t("active","активен"):t("revoked","отозван"));identity.append(strong,small);const tag=document.createElement("span");tag.textContent=owner.specialist_id===data.current_specialist_id?t("You","Вы"):(owner.active?t("Owner","Владелец"):t("Inactive","Неактивен"));row.append(identity,tag);box.append(row)})}
q<HTMLFormElement>("[data-access-form]")?.addEventListener("submit",async(e)=>{e.preventDefault();const submit=(e as SubmitEvent).submitter as HTMLButtonElement|null;const action=submit?.value||"grant";const form=e.currentTarget as HTMLFormElement;const data=new FormData(form);if(!confirm(action==="grant"?t("Grant internal owner access to this existing Hermes account?","Выдать этому существующему Hermes-аккаунту внутренний owner-доступ?"):t("Revoke internal owner access from this account?","Отозвать внутренний owner-доступ у этого аккаунта?")))return;const x=await jsonFetch("/api/internal-command-center/access",{method:"POST",body:JSON.stringify({action,email:data.get("email")})});setText("[data-access-status]",x.r.ok?t("Access updated.","Доступ обновлён."):String(x.d.error||"access_update_failed"));if(x.r.ok){form.reset();await loadAll()}});
void loadAll();const timer=setInterval(()=>void loadAll(),15000);addEventListener("pagehide",()=>clearInterval(timer),{once:true});
</script>

