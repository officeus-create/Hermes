---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../components/SiteFooter.astro";
import HermesBusinessCommandCenterShell from "../../../../../components/HermesBusinessCommandCenterShell.astro";
import HermesCommandCenterOwnerWorkspace from "../../../../../components/HermesCommandCenterOwnerWorkspace.astro";
import "../../../../../styles/hermes-business-command-center.css";
const ru=Astro.url.searchParams.get("lang")==="ru";
const nav=[
  {key:"today",label:ru?"Сегодня":"Today"},
  {key:"projects",label:ru?"Проекты":"Projects"},
  {key:"tasks",label:ru?"Задачи":"Tasks"},
  {key:"automations",label:ru?"Автоматизации":"Automations"},
  {key:"agents",label:ru?"Агенты":"Agents"},
  {key:"evidence",label:"Evidence"},
  {key:"access",label:ru?"Доступ":"Access"},
];
---
<BaseLayout title={ru?"Business Command Center | Hermes Connect":"Business Command Center | Hermes Connect"} description={ru?"Закрытое рабочее пространство владельца Hermes: решения, проекты, задачи, AI, автоматизация и evidence.":"Private Hermes owner workspace for decisions, projects, tasks, AI, automation and evidence."} robots="noindex,nofollow,noarchive" htmlLang={ru?"ru":"en"}>
  <SiteHeader activePath="/paths/technology/"/>
  <HermesBusinessCommandCenterShell
    mode="private"
    ru={ru}
    title="Business Command Center"
    lead={ru?"Одно рабочее пространство владельца: что требует решения, что выполняется, что заблокировано и какое действие следующее.":"One owner workspace for what needs a decision, what is running, what is blocked and what should happen next."}
    eyebrow="Hermes Connect · Owner workspace"
    badge={ru?"Закрытый кабинет владельца":"Private owner workspace"}
    nav={nav}
    activeKey="today"
  >
    <Fragment slot="hero-actions"><div class="hcc-actions"><a class="hcc-secondary" href={"/services/hermes-connect/command-center/"+(ru?"?lang=ru":"")}>{ru?"Публичная версия":"Public version"}</a></div></Fragment>
    <section class="access-card" data-access role="status"><strong>{ru?"Проверяем защищённую сессию…":"Verifying secure session…"}</strong><p>{ru?"Рабочее пространство откроется только после серверной проверки доступа владельца.":"The workspace opens only after server-side owner verification."}</p></section>
    <HermesCommandCenterOwnerWorkspace ru={ru}/>
  </HermesBusinessCommandCenterShell>
  <SiteFooter/>
</BaseLayout>

<script>
type WorkItem={id:string;project_id?:string|null;workstream:string;priority:string;title:string;details:string;source:string;status:string;created_at?:string;updated_at?:string;completed_at?:string|null;accepted_by?:string|null;accepted_at?:string|null;linked_task_id?:string|null;linked_task_status?:string|null;linked_task_pr_url?:string|null;linked_task_output_summary?:string|null;blocked_reason?:string|null};
type HaeProcess={id:string;name:string;job_type:string;business_lane:string;workstream:string;role_id:string;cadence_hours:number;status:string;next_run_at?:string|null;last_run_at?:string|null;last_job_id?:string|null;last_job_state?:string|null;last_job_completed_at?:string|null;last_error_class?:string|null;template_label:string;template_label_ru:string};
const isRu=new URLSearchParams(location.search).get("lang")==="ru";
const q=<T extends HTMLElement=HTMLElement>(s:string)=>document.querySelector<T>(s);
const t=(en:string,ru:string)=>isRu?ru:en;
let items:WorkItem[]=[],processes:HaeProcess[]=[],filter="open",projectFilter="all",searchTerm="",runtime:any=null,tasks:any[]=[],projects:{id:string;title:string;department:string}[]=[];
const stamp=(v?:string|null)=>v?new Date(v).toLocaleString(isRu?"ru-RU":"en-US",{dateStyle:"medium",timeStyle:"short"}):"—";
async function jsonFetch(url:string,options:RequestInit={}){const r=await fetch(url,{credentials:"same-origin",cache:"no-store",...options,headers:{Accept:"application/json",...(options.body?{"Content-Type":"application/json"}:{}),...(options.headers||{})}});let d:any={};try{d=await r.json()}catch{}return{r,d}}
function setText(sel:string,value:string){const n=q(sel);if(n)n.textContent=value}
function showOwnerToast(message:string){const n=q<HTMLElement>("[data-owner-toast]");if(!n)return;n.textContent=message;n.hidden=false}
function safePr(value?:string|null){if(!value)return null;try{const u=new URL(value);return u.protocol==="https:"&&u.hostname==="github.com"&&/^\/officeus-create\/Hermes\/pull\/\d+\/?$/.test(u.pathname)?u.href:null}catch{return null}}
async function loadAll(){
  const status=await jsonFetch("/api/internal-ai/status");
  if(!status.r.ok||!status.d.success){q("[data-private]")!.hidden=true;const access=q("[data-access]")!;access.hidden=false;access.querySelector("strong")!.textContent=status.r.status===401?t("Sign in required","Нужно войти"):t("Owner access required","Нужен доступ владельца");return}
  q("[data-access]")!.hidden=true;q("[data-private]")!.hidden=false;runtime=status.d.runtime||{};const active=status.d.active_task||null;
  setText("[data-runner-state]",runtime.online?t("Online","Онлайн"):t("Offline","Офлайн"));setText("[data-runner-copy]",runtime.online?t("Mac runner is accepting work","Mac runner принимает работу"):t("Cloud backlog remains safe","Облачная очередь сохранена"));
  setText("[data-agent-badge]",runtime.online?t("Online","Онлайн"):t("Offline","Офлайн"));setText("[data-agent-status]",runtime.online?t("Online","Онлайн"):t("Offline","Офлайн"));setText("[data-agent-seen]",stamp(runtime.last_seen_at));setText("[data-agent-sha]",runtime.repo_sha||"—");setText("[data-active-task]",active?(String(active.status||"")+(active.id?" · "+String(active.id).slice(-10):"")):t("None","Нет"));
  const [work,taskList,accessList,account,processList]=await Promise.all([jsonFetch("/api/internal-command-center/work-items"),jsonFetch("/api/internal-ai/tasks"),jsonFetch("/api/internal-command-center/access"),jsonFetch("/api/hermes-connect/account"),jsonFetch("/api/internal-command-center/processes")]);
  if(work.r.ok&&work.d.success){
    const all:WorkItem[]=[...(work.d.work_items||[])];
    let offset=work.d.next_offset;
    const seen=new Set<number>();
    while(Number.isSafeInteger(offset)&&offset>=0&&offset<=100000&&!seen.has(offset)){
      seen.add(offset);
      const next=await jsonFetch("/api/internal-command-center/work-items?offset="+offset);
      if(!next.r.ok||!next.d.success)break;
      all.push(...(next.d.work_items||[]));
      offset=next.d.next_offset;
    }
    items=all;
  }
  if(taskList.r.ok&&taskList.d.success)tasks=taskList.d.tasks||[]; if(account.r.ok&&account.d.success)renderAccount(account.d);if(processList.r.ok&&processList.d.success)processes=processList.d.processes||[];
  setText("[data-backlog-count]",String(items.filter(x=>!["done","cancelled"].includes(x.status)).length));setText("[data-approval-count]",String(tasks.filter(x=>x.status==="needs_approval").length));
  document.querySelectorAll<HTMLElement>("[data-module]").forEach(card=>{const key=card.dataset.module||"";const count=items.filter(x=>x.workstream===key&&!["done","cancelled"].includes(x.status)).length;const badge=card.querySelector<HTMLElement>(".module-state");if(badge)badge.textContent=count?String(count)+" "+t("open","открыто"):t("Clear","Чисто")});
  renderItems();renderProcesses();renderOwnerOverview();renderEvidence();if(accessList.r.ok&&accessList.d.success)renderOwners(accessList.d);
  void loadProjects();
}
// Project lookup is optional metadata: never block cloud backlog or HAE processing when it fails.
async function loadProjects(){
  try {
      const projectList=await jsonFetch("/api/internal-command-center/projects");
      if(projectList.r.ok&&projectList.d.success){
        const known=[...(projectList.d.projects||[])];let offset=projectList.d.next_offset;const visited=new Set<number>();
        while(Number.isSafeInteger(offset)&&offset>=0&&offset<=100000&&!visited.has(offset)){
          visited.add(offset);const next=await jsonFetch("/api/internal-command-center/projects?offset="+offset);
          if(!next.r.ok||!next.d.success)break;known.push(...(next.d.projects||[]));offset=next.d.next_offset;
        }
        projects=known.map((project:any)=>({id:String(project.id),title:String(project.title),department:String(project.department)}));
        refreshProjectSelectors();
      }
  } catch(error) {
    console.warn("Command Center project metadata unavailable; task backlog remains usable.");
  }
  renderItems();renderOwnerOverview();
}
function priorityRank(value:string){return ({p0:0,p1:1,p2:2,p3:3} as Record<string,number>)[value]??9}
function renderOwnerOverview(){
  const pending=items.filter(item=>item.status==="awaiting_acceptance");
  const runningTasks=tasks.filter((task:any)=>["queued","running"].includes(String(task.status))).length;
  const activeProcesses=processes.filter(process=>process.status==="active").length;
  const blocked=items.filter(item=>item.status==="blocked").length+processes.filter(process=>process.status==="blocked").length;
  const open=items.filter(item=>!["done","cancelled"].includes(item.status)).sort((a,b)=>priorityRank(a.priority)-priorityRank(b.priority));
  const next=pending[0]||open[0]||null;
  setText("[data-today-decision]",String(pending.length));
  setText("[data-today-running]",String(runningTasks+activeProcesses));
  setText("[data-today-blocked]",String(blocked));
  setText("[data-today-next]",next?next.title:t("No action","Нет действий"));
  const box=q("[data-today-list]");if(!box)return;box.replaceChildren();
  const rows=[...pending,...open.filter(item=>!pending.some(review=>review.id===item.id))].slice(0,5);
  if(!rows.length){const p=document.createElement("p");p.className="muted";p.textContent=t("Nothing needs owner attention right now.","Сейчас нет задач, требующих внимания владельца.");box.append(p);return}
  rows.forEach(item=>{const row=document.createElement("article");row.className="owner-today-item";const copy=document.createElement("div");const strong=document.createElement("strong");strong.textContent=item.title;const small=document.createElement("small");small.textContent=item.workstream+" · "+item.priority.toUpperCase()+(item.project_id?" · "+(projects.find(project=>project.id===item.project_id)?.title||item.project_id):"");copy.append(strong,small);const state=document.createElement("span");state.textContent=item.status==="awaiting_acceptance"?t("Needs decision","Нужно решение"):item.status.replaceAll("_"," ");row.append(copy,state);row.addEventListener("click",()=>{filter=item.status==="awaiting_acceptance"?"awaiting_acceptance":"open";switchView("tasks");renderItems()});box.append(row)});
}
function renderEvidence(){
  const box=q("[data-evidence-list]");if(!box)return;box.replaceChildren();
  const rows=items.filter(item=>item.linked_task_id||item.linked_task_pr_url||item.linked_task_output_summary||item.accepted_at).sort((a,b)=>String(b.updated_at||b.created_at||"").localeCompare(String(a.updated_at||a.created_at||"")));
  if(!rows.length){const p=document.createElement("p");p.className="muted";p.textContent=t("No task-linked evidence yet.","Пока нет evidence, привязанного к задачам.");box.append(p);return}
  rows.forEach(item=>{const card=document.createElement("article");card.className="owner-evidence-item";const body=document.createElement("div");const title=document.createElement("strong");title.textContent=item.title;const meta=document.createElement("small");meta.textContent=(item.linked_task_status||item.status)+" · "+stamp(item.updated_at||item.created_at);body.append(title,meta);if(item.linked_task_output_summary){const p=document.createElement("p");p.textContent=item.linked_task_output_summary;body.append(p)}const pr=safePr(item.linked_task_pr_url);if(pr){const a=document.createElement("a");a.href=pr;a.target="_blank";a.rel="noopener";a.textContent="PR ↗";body.append(a)}const state=document.createElement("span");state.textContent=item.accepted_at?t("ACCEPTED","ПРИНЯТО"):item.status==="awaiting_acceptance"?t("REVIEW","ПРОВЕРКА"):t("EVIDENCE","EVIDENCE");card.append(body,state);box.append(card)});
}
function switchView(view:string){
  const valid=new Set(["today","projects","tasks","automations","agents","evidence","access"]);
  const next=valid.has(view)?view:"today";
  document.querySelectorAll<HTMLElement>("[data-cc-view]").forEach(section=>{const active=section.dataset.ccView===next;section.hidden=!active;section.classList.toggle("is-active",active)});
  document.querySelectorAll<HTMLButtonElement>("[data-cc-nav]").forEach(button=>{const active=button.dataset.ccNav===next;button.classList.toggle("is-active",active);button.setAttribute("aria-current",active?"page":"false")});
  const url=new URL(location.href);if(next==="today")url.searchParams.delete("view");else url.searchParams.set("view",next);history.replaceState(null,"",url);
}
document.querySelectorAll<HTMLButtonElement>("[data-cc-nav]").forEach(button=>button.addEventListener("click",()=>{switchView(button.dataset.ccNav||"today");button.closest("details")?.removeAttribute("open")}));
const captureDialog=q<HTMLDialogElement>("[data-capture-dialog]");
document.querySelectorAll<HTMLButtonElement>("[data-new-task]").forEach(button=>button.addEventListener("click",()=>captureDialog?.showModal()));
q("[data-capture-cancel]")?.addEventListener("click",()=>captureDialog?.close());
const initialView=new URLSearchParams(location.search).get("view");if(initialView)switchView(initialView);

function refreshProjectSelectors(){
  for(const [selector,first] of [["[data-work-project]","unassigned"],["[data-edit-project]","unassigned"],["[data-project-filter]","all"]] as const){
    const select=q<HTMLSelectElement>(selector);if(!select)return;
    const saved=select.value;select.replaceChildren();
    const base=document.createElement("option");base.value=first==="all"?"all":"";base.textContent=first==="all"?t("All projects","Все проекты"):t("Unassigned","Без проекта");select.append(base);
    if(first==="all"){const blank=document.createElement("option");blank.value="unassigned";blank.textContent=t("Unassigned","Без проекта");select.append(blank);}
    for(const project of projects){const option=document.createElement("option");option.value=project.id;option.textContent=project.title+" · "+project.department;select.append(option);}
    if(Array.from(select.options).some(option=>option.value===saved))select.value=saved;
  }
}
q<HTMLSelectElement>("[data-project-filter]")?.addEventListener("change",event=>{
  projectFilter=(event.currentTarget as HTMLSelectElement).value;renderItems();
});
function visible(item:WorkItem){
  if(projectFilter==="unassigned"&&item.project_id)return false;
  if(projectFilter!=="all"&&projectFilter!=="unassigned"&&item.project_id!==projectFilter)return false;
  const projectTitle=projects.find(project=>project.id===item.project_id)?.title||"";
  const matches=searchTerm===""||[item.title,item.details,item.id,item.workstream,projectTitle].some(value=>value.toLocaleLowerCase().includes(searchTerm));
  if(!matches)return false;
  if(filter==="open")return !["done","cancelled"].includes(item.status);
  if(filter==="done")return item.status==="done";
  if(filter==="awaiting_acceptance")return item.status==="awaiting_acceptance";
  return item.workstream===filter;
}
function renderItems(){
 const box=q("[data-work-list]");if(!box)return;box.replaceChildren();const rows=items.filter(visible);
 if(!rows.length){const p=document.createElement("p");p.className="muted";p.textContent=t("No work items in this view.","В этом списке задач нет.");box.append(p);return}
 rows.forEach(item=>{const card=document.createElement("article");card.className="work-card";const top=document.createElement("div");top.className="work-top";const meta=document.createElement("div");const title=document.createElement("strong");title.textContent=item.title;const line=document.createElement("span");line.textContent=item.workstream.toUpperCase()+" · "+item.priority.toUpperCase()+" · "+item.status.replaceAll("_"," ");if(item.project_id){const name=projects.find(project=>project.id===item.project_id)?.title||item.project_id;line.textContent+=" · "+name;}meta.append(title,line);const time=document.createElement("small");time.textContent=stamp(item.updated_at||item.created_at);top.append(meta,time);
 const body=document.createElement("p");body.textContent=item.details;card.append(top,body);if(item.blocked_reason){const b=document.createElement("p");b.className="blocked";b.textContent=item.blocked_reason;card.append(b)}
 if(item.linked_task_status){const l=document.createElement("p");l.className="linked";l.textContent=t("Execution: ","Выполнение: ")+item.linked_task_status;card.append(l)}
 if(item.status==="awaiting_acceptance"){const review=document.createElement("p");review.className="acceptance-note";review.textContent=t("Execution finished. Review the evidence before accepting the business result.","Выполнение закончено. Проверь результат и доказательства перед приёмкой.");card.append(review)}
 if(item.linked_task_output_summary){const output=document.createElement("p");output.className="output-summary";output.textContent=t("Result: ","Результат: ")+item.linked_task_output_summary;card.append(output)}
 const actions=document.createElement("div");actions.className="work-actions";
 const make=(label:string,action:string,cls="secondary")=>{const b=document.createElement("button");b.type="button";b.className=cls;b.textContent=label;b.addEventListener("click",()=>mutate(item.id,action));return b};
 if(["planned","ready","blocked"].includes(item.status)&&!item.linked_task_id){const edit=document.createElement("button");edit.type="button";edit.className="secondary";edit.textContent=t("Edit","Редактировать");edit.addEventListener("click",()=>openWorkEdit(item));actions.append(edit)}
  if(item.status==="planned"||(item.status==="blocked"&&item.linked_task_status!=="completed"))actions.append(make(t("Ready","В очередь"),"ready"));
 if(["planned","ready","blocked"].includes(item.status))actions.append(make(t("Run with Hermes AI","Запустить Hermes AI"),"dispatch","primary"));
 if(item.status==="awaiting_acceptance"){actions.append(make(t("Accept result","Принять результат"),"accept","primary"));const rework=document.createElement("button");rework.type="button";rework.className="secondary";rework.textContent=t("Needs rework","Нужна доработка");rework.addEventListener("click",()=>{const reason=prompt(t("What must be corrected?","Что нужно исправить?"));if(reason?.trim())void mutate(item.id,"block",reason.trim())});actions.append(rework)}
 if(!item.linked_task_id&&!["done","cancelled","in_progress","awaiting_acceptance"].includes(item.status))actions.append(make(t("Mark manual work done","Завершить вручную"),"complete"));
 if(!["done","cancelled"].includes(item.status)&&!["queued","running","needs_approval"].includes(item.linked_task_status||""))actions.append(make(t("Cancel","Отменить"),"cancel","danger"));
 const pr=safePr(item.linked_task_pr_url);if(pr){const a=document.createElement("a");a.href=pr;a.target="_blank";a.rel="noopener";a.textContent="PR ↗";actions.append(a)}
 card.append(actions);box.append(card)});
}
function openWorkEdit(item:WorkItem){
  const dialog=q<HTMLDialogElement>("[data-edit-dialog]");
  const form=q<HTMLFormElement>("[data-edit-form]");
  if(!dialog||!form)return;
  for(const [name,value] of Object.entries({edit_id:item.id,edit_updated_at:item.updated_at||"",edit_title:item.title,edit_details:item.details,edit_priority:item.priority,edit_workstream:item.workstream,edit_project_id:item.project_id||""})){
    const field=form.elements.namedItem(name) as HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement|null;
    if(field)field.value=value;
  }
  setText("[data-edit-status]","");
  dialog.showModal();
}
document.querySelectorAll("[data-edit-cancel]").forEach(button=>button.addEventListener("click",()=>q<HTMLDialogElement>("[data-edit-dialog]")?.close()));
q<HTMLFormElement>("[data-edit-form]")?.addEventListener("submit",async(event)=>{
  event.preventDefault();
  const form=event.currentTarget as HTMLFormElement;
  const data=new FormData(form);
  const id=String(data.get("edit_id")||"");
  const payload={action:"edit",updated_at:data.get("edit_updated_at"),title:data.get("edit_title"),details:data.get("edit_details"),priority:data.get("edit_priority"),workstream:data.get("edit_workstream"),project_id:data.get("edit_project_id")||null};
  setText("[data-edit-status]",t("Saving…","Сохраняем…"));
  const {r,d}=await jsonFetch("/api/internal-command-center/work-items/"+encodeURIComponent(id),{method:"PATCH",body:JSON.stringify(payload)});
  if(!r.ok){setText("[data-edit-status]",r.status===409?t("Task changed elsewhere; refresh and reopen.","Задача изменилась в другой сессии; обновите список и откройте её заново."):String(d.error||"save_failed"));return}
  q<HTMLDialogElement>("[data-edit-dialog]")?.close();
  await loadAll();
});
async function mutate(id:string,action:string,reason?:string){const x=await jsonFetch("/api/internal-command-center/work-items/"+encodeURIComponent(id),{method:"PATCH",body:JSON.stringify({action,...(reason?{reason}:{})})});if(!x.r.ok){alert(String(x.d.error||"update_failed"));return}await loadAll()}
function renderProcesses(){const box=q("[data-process-list]");if(!box)return;box.replaceChildren();if(!processes.length){const p=document.createElement("p");p.className="muted";p.textContent=t("No autonomous processes configured yet.","Автономные процессы пока не настроены.");box.append(p);return}processes.forEach(process=>{const card=document.createElement("article");card.className="process-card";const head=document.createElement("div");head.className="process-head";const identity=document.createElement("div");const strong=document.createElement("strong");strong.textContent=process.name;const meta=document.createElement("small");meta.textContent=(isRu?process.template_label_ru:process.template_label)+" · "+process.role_id+" · "+process.cadence_hours+"h";identity.append(strong,meta);const state=document.createElement("span");state.className="process-state "+process.status;state.textContent=process.status.replaceAll("_"," ");head.append(identity,state);card.append(head);const timing=document.createElement("dl");timing.innerHTML=`<div><dt>${t("Next HAE tick","Следующий запуск HAE")}</dt><dd>${stamp(process.next_run_at)}</dd></div><div><dt>${t("Last run","Последний запуск")}</dt><dd>${stamp(process.last_run_at)}</dd></div><div><dt>${t("Last job","Последняя job")}</dt><dd>${process.last_job_state||"—"}</dd></div>`;card.append(timing);if(process.last_error_class){const error=document.createElement("p");error.className="blocked";error.textContent=t("Error: ","Ошибка: ")+process.last_error_class;card.append(error)}const actions=document.createElement("div");actions.className="work-actions";const button=(label:string,action:string,cls="secondary")=>{const b=document.createElement("button");b.type="button";b.className=cls;b.textContent=label;b.addEventListener("click",()=>mutateProcess(process.id,action));return b};if(process.status!=="active")actions.append(button(t("Activate","Активировать"),"activate","primary"));if(process.status==="active"){actions.append(button(t("Run on next HAE tick","Запустить на следующем tick"),"run_next_tick","primary"));actions.append(button(t("Pause","Пауза"),"pause"))}card.append(actions);box.append(card)})}
async function mutateProcess(id:string,action:string){const x=await jsonFetch("/api/internal-command-center/processes/"+encodeURIComponent(id),{method:"PATCH",body:JSON.stringify({action})});if(!x.r.ok){setText("[data-process-status]",String(x.d.error||"process_update_failed"));return}setText("[data-process-status]",action==="activate"?t("Activated. HAE will claim it on the next hourly tick.","Активировано. HAE заберёт процесс на следующем часовом tick."):t("Process updated.","Процесс обновлён."));await loadAll()}
q("[data-work-form]")?.addEventListener("submit",async(e)=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const data=new FormData(form);const source=form.dataset.source==="voice"?"voice":"text";const x=await jsonFetch("/api/internal-command-center/work-items",{method:"POST",body:JSON.stringify({workstream:data.get("workstream"),priority:data.get("priority"),title:data.get("title"),details:data.get("details"),project_id:data.get("project_id")||null,source})});if(!x.r.ok){setText("[data-capture-status]",String(x.d.error||"save_failed"));return}form.reset();form.dataset.source="text";setText("[data-capture-status]",t("Saved to cloud backlog.","Сохранено в облачную очередь."));showOwnerToast(t("Saved to cloud backlog.","Сохранено в облачную очередь."));captureDialog?.close();switchView("tasks");await loadAll()});
const processForm=q<HTMLFormElement>("[data-process-form]");const processType=processForm?.elements.namedItem("job_type") as HTMLSelectElement|null;const processCadence=processForm?.elements.namedItem("cadence_hours") as HTMLSelectElement|null;function syncProcessCadence(){if(!processType||!processCadence)return;const allowed=(processType.selectedOptions[0]?.dataset.cadences||"").split(",");Array.from(processCadence.options).forEach(option=>option.hidden=!allowed.includes(option.value));if(!allowed.includes(processCadence.value))processCadence.value=allowed[0]||"24"}processType?.addEventListener("change",syncProcessCadence);syncProcessCadence();processForm?.addEventListener("submit",async(e)=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const data=new FormData(form);const x=await jsonFetch("/api/internal-command-center/processes",{method:"POST",body:JSON.stringify({name:data.get("name"),job_type:data.get("job_type"),cadence_hours:Number(data.get("cadence_hours"))})});if(!x.r.ok){setText("[data-process-status]",String(x.d.error||"process_create_failed"));return}form.reset();syncProcessCadence();setText("[data-process-status]",t("Process created paused. Review it, then activate.","Процесс создан на паузе. Проверь и активируй."));await loadAll()});
q("[data-dictate]")?.addEventListener("click",()=>{const Ctor=(window as any).SpeechRecognition||(window as any).webkitSpeechRecognition;if(!Ctor){setText("[data-capture-status]",t("Browser speech recognition is unavailable. Use the keyboard or OS dictation.","Распознавание речи браузером недоступно. Используй клавиатуру или диктовку ОС."));return}const rec=new Ctor();rec.lang=isRu?"ru-RU":"en-US";rec.interimResults=false;rec.maxAlternatives=1;setText("[data-capture-status]",t("Listening…","Слушаю…"));rec.onresult=(ev:any)=>{const text=String(ev.results?.[0]?.[0]?.transcript||"").trim();const area=q<HTMLTextAreaElement>('textarea[name="details"]');if(area){area.value=(area.value?area.value+"\n":"")+text;(q<HTMLFormElement>("[data-work-form]")!).dataset.source="voice"}setText("[data-capture-status]",t("Dictation added. Review before saving.","Диктовка добавлена. Проверь перед сохранением."))};rec.onerror=()=>setText("[data-capture-status]",t("Dictation failed; nothing was saved.","Диктовка не сработала; ничего не сохранено."));rec.start()});
q("[data-refresh]")?.addEventListener("click",()=>void loadAll());
