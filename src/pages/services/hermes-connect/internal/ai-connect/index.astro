---
import { Activity, ArrowRight, FolderKanban, ShieldCheck, Sparkles, Wrench } from "@lucide/astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../components/SiteFooter.astro";
import HermesConnectExperience from "../../../../../components/HermesConnectExperience.astro";
import HermesConnectInternalCabinetNav from "../../../../../components/HermesConnectInternalCabinetNav.astro";
---
<BaseLayout title="AI Connect | Hermes Connect" description="Private internal Hermes Connect AI project overview." robots="noindex,nofollow">
  <SiteHeader activePath="/paths/technology/" />
  <HermesConnectExperience />
  <HermesConnectInternalCabinetNav />
  <main id="main-content" class="ai-connect-page">
    <div class="ai-connect-shell">
      <header class="ai-connect-hero">
        <div>
          <p class="ai-connect-kicker"><Sparkles size={15} /><span data-en="AI Connect · owner workspace" data-ru="AI Connect · кабинет владельца">AI Connect · owner workspace</span></p>
          <h1>AI Connect</h1>
          <p data-en="Manage internal Hermes AI work from one familiar cabinet: project, agent, current task, runtime state and the next safe action." data-ru="Управляйте внутренней ИИ-работой Hermes из одного привычного кабинета: проект, агент, текущая задача, состояние системы и следующий безопасный шаг.">Manage internal Hermes AI work from one familiar cabinet: project, agent, current task, runtime state and the next safe action.</p>
        </div>
        <span class="ai-connect-badge"><ShieldCheck size={16} /><span data-en="Internal owner only" data-ru="Только для владельца">Internal owner only</span></span>
      </header>

      <section class="ai-connect-state" data-access-state role="status">
        <strong data-access-title data-en="Checking internal access…" data-ru="Проверяем доступ…">Checking internal access…</strong>
        <p data-access-copy data-en="AI Connect opens only after Hermes Connect verifies the HERMES_INTERNAL_OWNER capability." data-ru="AI Connect открывается только после проверки внутреннего доступа владельца Hermes Connect.">AI Connect opens only after Hermes Connect verifies the HERMES_INTERNAL_OWNER capability.</p>
      </section>

      <div class="ai-connect-content hidden" data-ai-connect-content>
        <section class="ai-connect-grid">
          <article class="ai-connect-card project-card">
            <div class="card-heading">
              <div>
                <p class="ai-connect-kicker"><FolderKanban size={14} /><span data-en="Current project" data-ru="Текущий проект">Current project</span></p>
                <h2>Hermes Connect · Internal AI Pilot</h2>
              </div>
              <span class="status-pill" data-project-status>Ready</span>
            </div>
            <p data-en="Current objective: prove the internal owner → task → runner → Codex → evidence loop without exposing customer access or remote shell behavior." data-ru="Текущая цель: доказать полный цикл владелец → задача → runner → Codex → результат без доступа клиентов и без удалённого терминала.">Current objective: prove the internal owner → task → runner → Codex → evidence loop without exposing customer access or remote shell behavior.</p>
            <dl class="project-facts">
              <div><dt data-en="Agent" data-ru="Агент">Agent</dt><dd>Software Engineer</dd></div>
              <div><dt data-en="Active task" data-ru="Активная задача">Active task</dt><dd data-active-task>None</dd></div>
              <div><dt data-en="Task status" data-ru="Статус задачи">Task status</dt><dd data-task-status>Idle</dd></div>
              <div><dt data-en="Last update" data-ru="Последнее обновление">Last update</dt><dd data-task-updated>—</dd></div>
            </dl>
            <div class="project-actions">
              <a class="primary-action" data-cabinet-link href="/services/hermes-connect/internal/ai-connect/projects/hermes-connect-internal-ai-pilot/"><span data-en="Open project" data-ru="Открыть проект">Open project</span><ArrowRight size={16} /></a>
              <a class="secondary-action" data-cabinet-link href="/services/hermes-connect/internal/ai-assistant/"><span data-en="Open AI Assistant" data-ru="Открыть ИИ-ассистент">Open AI Assistant</span><ArrowRight size={16} /></a>
            </div>
          </article>

          <aside class="ai-connect-card runtime-card">
            <p class="ai-connect-kicker"><Activity size={14} /><span data-en="Runtime" data-ru="Система">Runtime</span></p>
            <h2 data-en="Execution health" data-ru="Состояние выполнения">Execution health</h2>
            <div class="runtime-line"><span data-en="Hermes runner" data-ru="Hermes runner">Hermes runner</span><strong data-runner-state>Unknown</strong></div>
            <div class="runtime-line"><span data-en="Codex role" data-ru="Роль Codex">Codex role</span><strong>Software Engineer</strong></div>
            <div class="runtime-line"><span data-en="Tenant scope" data-ru="Контур доступа">Tenant scope</span><strong>hermes_internal</strong></div>
            <p class="runtime-note" data-en="Only sanitized internal status is shown here. Provider keys, runner tokens, cookies and raw credentials never appear in the cabinet." data-ru="Здесь показывается только безопасный внутренний статус. Ключи провайдеров, токены runner, cookies и другие секреты в кабинете не отображаются.">Only sanitized internal status is shown here. Provider keys, runner tokens, cookies and raw credentials never appear in the cabinet.</p>
          </aside>
        </section>

        <section class="ai-connect-card next-card">
          <div>
            <p class="ai-connect-kicker"><Wrench size={14} /><span data-en="Next action" data-ru="Следующее действие">Next action</span></p>
            <h2 data-next-title data-en="Start the first bounded task" data-ru="Запустить первую безопасную задачу">Start the first bounded task</h2>
            <p data-next-copy data-en="Use AI Assistant to queue one safe Software Engineer task. Results and evidence return to the same Hermes Connect cabinet." data-ru="Откройте ИИ-ассистент и поставьте одну безопасную задачу Software Engineer. Результат и подтверждения вернутся в этот же кабинет Hermes Connect.">Use AI Assistant to queue one safe Software Engineer task. Results and evidence return to the same Hermes Connect cabinet.</p>
          </div>
          <a class="secondary-action" data-cabinet-link href="/services/hermes-connect/internal/ai-assistant/"><span data-en="Continue in AI Assistant" data-ru="Продолжить в ИИ-ассистенте">Continue in AI Assistant</span><ArrowRight size={16} /></a>
        </section>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  type Task = { id?: string; status?: string; updated_at?: string | null };
  const $ = <T extends HTMLElement = HTMLElement>(selector: string) => document.querySelector<T>(selector);
  const locale = () => document.documentElement.dataset.internalCabinetLocale === "ru" ? "ru" : "en";
  const t = (en: string, ru: string) => locale() === "ru" ? ru : en;
  const text = (selector: string, value: string) => { const node = $(selector); if (node) node.textContent = value; };
  const lock = (titleEn: string, titleRu: string, copyEn: string, copyRu: string) => {
    text("[data-access-title]", t(titleEn, titleRu));
    text("[data-access-copy]", t(copyEn, copyRu));
    $("[data-access-state]")?.classList.remove("hidden");
    $("[data-ai-connect-content]")?.classList.add("hidden");
  };
  const status = (value?: string | null) => {
    const map: Record<string, [string,string]> = { queued:["Queued","В очереди"], running:["Running","В работе"], completed:["Completed","Завершено"], failed:["Failed","Ошибка"], cancelled:["Cancelled","Отменено"], needs_approval:["Needs approval","Нужно подтверждение"] };
    return value && map[value] ? t(map[value][0], map[value][1]) : t("Idle","Нет активной задачи");
  };

  async function refresh() {
    const response = await fetch("/api/internal-ai/status", { credentials: "same-origin", headers: { Accept: "application/json" } });
    let data: any = {};
    try { data = await response.json(); } catch {}
    if (response.status === 401) return lock("Sign in required","Нужно войти","Sign in to Hermes Connect, then reopen AI Connect.","Войдите в Hermes Connect и снова откройте AI Connect.");
    if (response.status === 403) return lock("Internal owner capability required","Нужен доступ владельца","Customer and ordinary Hermes Connect accounts cannot access AI Connect.","Клиентские и обычные аккаунты Hermes Connect не имеют доступа к AI Connect.");
    if (!response.ok || !data.success) return lock("AI Connect is unavailable","AI Connect недоступен",String(data.error || "runtime_unavailable"),String(data.error || "runtime_unavailable"));

    $("[data-access-state]")?.classList.add("hidden");
    $("[data-ai-connect-content]")?.classList.remove("hidden");
    const task: Task | null = data.active_task || data.latest_task || null;
    text("[data-runner-state]", data.runtime?.online ? t("Online","Онлайн") : t("Not connected","Не подключён"));
    text("[data-active-task]", task?.id || t("None","Нет"));
    text("[data-task-status]", status(task?.status));
    text("[data-task-updated]", task?.updated_at ? new Date(task.updated_at).toLocaleString(locale() === "ru" ? "ru-RU" : "en-US") : "—");
    text("[data-project-status]", task?.status === "running" ? t("In progress","В работе") : task?.status === "needs_approval" ? t("Needs approval","Нужно подтверждение") : task ? t("Active","Активен") : t("Ready","Готов"));
    if (task?.status === "needs_approval") {
      text("[data-next-title]", t("Review the approval gate","Проверить запрос на подтверждение"));
      text("[data-next-copy]", t("The active task stopped at an owner gate. Open AI Assistant and review sanitized evidence before continuing.","Активная задача остановилась на шаге, требующем решения владельца. Откройте ИИ-ассистент и проверьте безопасные подтверждения перед продолжением."));
    } else if (task?.status === "running" || task?.status === "queued") {
      text("[data-next-title]", t("Let the current task finish","Дождаться завершения текущей задачи"));
      text("[data-next-copy]", t("A Software Engineer task is already active. Open AI Assistant to watch activity and evidence.","Задача Software Engineer уже выполняется. Откройте ИИ-ассистент, чтобы видеть ход работы и подтверждения."));
    }
  }

  window.addEventListener("hc-internal-locale-ready", () => void refresh());
  void refresh();
  const timer = window.setInterval(() => void refresh(), 8000);
  window.addEventListener("pagehide", () => window.clearInterval(timer), { once: true });
</script>

<style>
  .ai-connect-page{min-height:calc(100vh - 12rem);background:#090d16;color:#edf2fb}.ai-connect-shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:2rem 0 4rem}.ai-connect-hero{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.5rem}.ai-connect-hero h1{font-size:clamp(2.2rem,5vw,4rem);margin:.3rem 0 .75rem}.ai-connect-hero p{max-width:760px;color:#b9c5d8;line-height:1.6}.ai-connect-kicker{display:flex;gap:.4rem;align-items:center;margin:0;color:#a99aff;font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.ai-connect-badge,.status-pill{display:inline-flex;align-items:center;gap:.4rem;white-space:nowrap;border:1px solid rgba(96,165,250,.32);border-radius:999px;padding:.5rem .72rem;color:#dceaff;background:rgba(96,165,250,.1);font-size:.78rem;font-weight:750}.ai-connect-state,.ai-connect-card{border:1px solid rgba(255,255,255,.11);border-radius:1.25rem;background:rgba(17,24,39,.82);box-shadow:0 18px 40px rgba(0,0,0,.18)}.ai-connect-state{padding:1.2rem}.ai-connect-state p,.ai-connect-card>p,.runtime-note,.next-card p{color:#b9c5d8;line-height:1.55}.hidden{display:none!important}.ai-connect-content{display:grid;gap:1rem}.ai-connect-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:1rem}.ai-connect-card{padding:1.25rem}.card-heading{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.ai-connect-card h2{margin:.35rem 0 .75rem;font-size:1.25rem}.project-facts{display:grid;grid-template-columns:1fr 1fr;gap:.85rem;margin:1rem 0 1.2rem}.project-facts dt{color:#9eabc0;font-size:.75rem}.project-facts dd{margin:.2rem 0 0;overflow-wrap:anywhere}.project-actions{display:flex;gap:.6rem;flex-wrap:wrap}.primary-action,.secondary-action{display:inline-flex;align-items:center;gap:.45rem;border-radius:.7rem;padding:.72rem .9rem;text-decoration:none;font-weight:800}.primary-action{background:#8bdbff;color:#07101c}.secondary-action{border:1px solid rgba(255,255,255,.14);color:#fff;background:rgba(255,255,255,.06)}.runtime-line{display:flex;justify-content:space-between;gap:1rem;padding:.75rem 0;border-bottom:1px solid rgba(255,255,255,.08)}.runtime-line span{color:#9eabc0}.runtime-note{margin:1rem 0 0;font-size:.85rem}.next-card{display:flex;justify-content:space-between;gap:1.5rem;align-items:center}.next-card>div{max-width:760px}.next-card p{margin-bottom:0}@media(max-width:700px){.ai-connect-shell{padding-top:1.4rem}.ai-connect-hero,.next-card,.card-heading{align-items:stretch;flex-direction:column}.ai-connect-grid{grid-template-columns:1fr}.project-facts{grid-template-columns:1fr}.ai-connect-badge{white-space:normal}.primary-action,.secondary-action{justify-content:center;width:100%;box-sizing:border-box}.project-actions{display:grid}}
</style>
