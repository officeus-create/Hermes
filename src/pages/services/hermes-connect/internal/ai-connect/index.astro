---
import { Activity, ArrowRight, Bot, CircleAlert, ExternalLink, FolderKanban, ShieldCheck, Sparkles, Square, Wrench } from "@lucide/astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../components/SiteFooter.astro";
import HermesConnectExperience from "../../../../../components/HermesConnectExperience.astro";
import HermesConnectAccountSwitcher from "../../../../../components/HermesConnectAccountSwitcher.astro";
import HermesConnectInternalAiNav from "../../../../../components/HermesConnectInternalAiNav.astro";
const isRu=Astro.url.searchParams.get("lang")==="ru";const suffix=isRu?"?lang=ru":"";
---
<BaseLayout title="AI Connect | Hermes Connect" description={isRu?"Приватный AI Control Center владельца Hermes Connect.":"Private Hermes Connect owner AI Control Center."} robots="noindex,nofollow">
  <SiteHeader activePath="/paths/technology/"/>
  <HermesConnectExperience/>
  <HermesConnectInternalAiNav/>
  <main class="ai-control-page"><div class="shell">
    <header class="hero"><div><p class="kicker"><Sparkles size={15}/>Hermes Connect · {isRu?"внутренний AI":"internal AI"}</p><h1>{isRu?"AI Control Center":"AI Control Center"}</h1><p>{isRu?"Твой приватный кабинет управления Hermes AI: поставить задачу, увидеть runner, следить за выполнением, branch/PR/evidence и безопасными остановками на подтверждение.":"Your private Hermes AI control room: start a task, see the runner, follow execution, branch/PR/evidence and safe approval stops."}</p></div><span class="badge"><ShieldCheck size={16}/>{isRu?"HERMES_INTERNAL_OWNER":"HERMES_INTERNAL_OWNER"}</span></header>
    <HermesConnectAccountSwitcher current="ai"/>
    <section class="access" data-access role="status"><strong data-access-title>{isRu?"Проверяем внутренний доступ…":"Checking internal access…"}</strong><p data-access-copy>{isRu?"Control Center откроется только после серверной проверки capability владельца.":"Control Center opens only after server-side owner capability verification."}</p></section>

    <div class="content hidden" data-content>
      <section class="status-grid">
        <article class="card runtime-card"><div class="card-head"><div><p class="kicker"><Activity size={14}/>{isRu?"Среда выполнения":"Runtime"}</p><h2>{isRu?"Контур исполнения":"Execution path"}</h2></div><span class="state" data-runner-state>—</span></div><dl><div><dt>Runner</dt><dd data-runner-detail>—</dd></div><div><dt>{isRu?"Repo SHA":"Repo SHA"}</dt><dd data-runner-sha>—</dd></div><div><dt>{isRu?"Версия":"Version"}</dt><dd data-runner-version>—</dd></div></dl><p class="note">{isRu?"Runner работает только исходящими запросами. Remote shell, provider keys, cookies и credentials в браузер не передаются.":"The runner is outbound-only. No remote shell, provider keys, cookies or credentials are exposed to the browser."}</p></article>
        <article class="card project-card"><div class="card-head"><div><p class="kicker"><FolderKanban size={14}/>{isRu?"Текущий проект":"Current project"}</p><h2>Hermes Connect · Internal AI Pilot</h2></div><span class="state" data-project-state>{isRu?"Готов":"Ready"}</span></div><p>{isRu?"Сначала доводим одного Software Engineer до полностью доказанного owner → task → runner → Codex → evidence цикла. Новых агентов добавим только после этого.":"First prove one Software Engineer through the full owner → task → runner → Codex → evidence loop. More agents come only after that."}</p><div class="project-links"><a href={`/services/hermes-connect/internal/ai-connect/projects/${suffix}`}>{isRu?"Проекты":"Projects"}<ArrowRight size={15}/></a><a href={`/services/hermes-connect/internal/ai-connect/activity/${suffix}`}>{isRu?"Активность":"Activity"}<ArrowRight size={15}/></a></div></article>
      </section>

      <section class="card task-console">
        <div class="console-head"><div><p class="kicker"><Bot size={14}/>{isRu?"Управление задачей":"Task control"}</p><h2>{isRu?"Дай поручение Hermes AI":"Give Hermes AI an assignment"}</h2><p>{isRu?"Обычная низкорисковая работа в репозитории может выполняться автономно. Merge/deploy, credentials, billing, внешние сообщения и другие значимые действия остановятся на owner approval.":"Ordinary low-risk repository work may run autonomously. Merge/deploy, credentials, billing, external communication and other consequential actions stop at owner approval."}</p></div><span class="agent-pill">Software Engineer</span></div>
        <form data-task-form class="task-form"><label>{isRu?"Задача":"Task"}<textarea data-task-prompt maxlength="12000" rows="5" required placeholder={isRu?"Например: проверь текущий Hermes Connect AI Control Center, исправь найденные безопасные ошибки, запусти тесты и подготовь PR. Не merge/deploy.":"Example: inspect the current Hermes Connect AI Control Center, fix safe issues, run tests and prepare a PR. Do not merge/deploy."}></textarea></label><div class="form-actions"><button class="primary" data-start type="submit"><Wrench size={16}/>{isRu?"Запустить задачу":"Start task"}</button><p data-form-status role="status"></p></div></form>
      </section>

      <section class="card current-task" data-task-panel>
        <div class="card-head"><div><p class="kicker"><Activity size={14}/>{isRu?"Текущая / последняя задача":"Current / latest task"}</p><h2 data-task-title>{isRu?"Задач пока нет":"No task yet"}</h2></div><span class="task-status" data-task-status>—</span></div>
        <p class="task-prompt hidden" data-task-prompt-view></p>
        <dl class="task-meta"><div><dt>{isRu?"Обновлено":"Updated"}</dt><dd data-task-updated>—</dd></div><div><dt>{isRu?"Ветка":"Branch"}</dt><dd data-task-branch>—</dd></div><div><dt>Evidence</dt><dd data-task-evidence>—</dd></div></dl>
        <div class="approval hidden" data-approval><CircleAlert size={17}/><div><strong>{isRu?"Нужно твоё подтверждение":"Your approval is required"}</strong><p data-approval-copy></p></div></div>
        <div class="result hidden" data-result><strong>{isRu?"Очищенный результат":"Sanitized result"}</strong><pre data-result-copy></pre></div>
        <div class="task-actions"><a class="pr-link hidden" data-pr-link target="_blank" rel="noopener"><ExternalLink size={15}/>{isRu?"Открыть PR":"Open PR"}</a><button class="cancel hidden" data-cancel type="button"><Square size={14}/>{isRu?"Отменить задачу":"Cancel task"}</button><a class="secondary" href={`/services/hermes-connect/internal/ai-connect/activity/${suffix}`}>{isRu?"Полная история":"Full history"}</a></div>
        <div class="events" data-events aria-live="polite"></div>
      </section>
    </div>
  </div></main>
  <SiteFooter/>
</BaseLayout>

<script>
  type Task={id?:string,prompt?:string,status?:string,created_at?:string|null,started_at?:string|null,completed_at?:string|null,updated_at?:string|null,repo_sha?:string|null,branch?:string|null,pr_url?:string|null,evidence_class?:string|null,output_summary?:string|null,approval_gate?:string|null,cancel_requested?:boolean};
  type EventRow={id?:number,event_type?:string,message?:string,created_at?:string};
  const ru=new URLSearchParams(location.search).get("lang")==="ru";const q=<T extends HTMLElement=HTMLElement>(s:string)=>document.querySelector<T>(s);const t=(e:string,r:string)=>ru?r:e;
  let currentTask:Task|null=null;
  const labels:Record<string,string>={queued:t("Queued","В очереди"),running:t("Running","В работе"),completed:t("Completed","Завершено"),failed:t("Failed","Ошибка"),cancelled:t("Cancelled","Отменено"),needs_approval:t("Needs approval","Нужно подтверждение")};
  const safePr=(v?:string|null)=>{if(!v)return null;try{const u=new URL(v);return u.protocol==="https:"&&u.hostname==="github.com"&&/^\/officeus-create\/Hermes\/pull\/\d+\/?$/.test(u.pathname)?u.href:null}catch{return null}};
  const stamp=(v?:string|null)=>v?new Date(v).toLocaleString(ru?"ru-RU":"en-US",{dateStyle:"medium",timeStyle:"short"}):"—";
  const set=(s:string,v:string)=>{const n=q(s);if(n)n.textContent=v};
  function lock(status:number,error?:string){set("[data-access-title]",status===401?t("Sign in required","Нужно войти"):status===403?t("Internal owner capability required","Нужен доступ внутреннего владельца"):t("AI Control Center unavailable","AI Control Center недоступен"));set("[data-access-copy]",status===401?t("Sign in to your Hermes account and reopen this page.","Войдите в свой аккаунт Hermes и снова откройте страницу."):status===403?t("This workspace is never inferred from email or role. It opens only with an active HERMES_INTERNAL_OWNER capability.","Этот кабинет не определяется по email или роли. Он открывается только с активной capability HERMES_INTERNAL_OWNER."):String(error||"runtime_unavailable"));q("[data-access]")?.classList.remove("hidden");q("[data-content]")?.classList.add("hidden");}
  function renderEvents(events:EventRow[]){const box=q("[data-events]");if(!box)return;box.replaceChildren();if(!events.length)return;const title=document.createElement("strong");title.textContent=t("Recent execution events","Последние события выполнения");box.append(title);events.slice(-8).forEach(e=>{const row=document.createElement("div");const meta=document.createElement("span");meta.textContent=`${e.event_type||"event"} · ${stamp(e.created_at)}`;const msg=document.createElement("p");msg.textContent=String(e.message||"");row.append(meta,msg);box.append(row)});}
  function renderTask(task:Task|null,events:EventRow[]=[]){currentTask=task;const start=q<HTMLButtonElement>("[data-start]");const cancel=q<HTMLButtonElement>("[data-cancel]");const active=Boolean(task&&["queued","running","needs_approval"].includes(task.status||""));if(start)start.disabled=active;if(!task){set("[data-task-title]",t("No task yet","Задач пока нет"));set("[data-task-status]","—");q("[data-task-prompt-view]")?.classList.add("hidden");q("[data-approval]")?.classList.add("hidden");q("[data-result]")?.classList.add("hidden");q("[data-pr-link]")?.classList.add("hidden");q("[data-cancel]")?.classList.add("hidden");renderEvents([]);return;}
    set("[data-task-title]",`${t("Task","Задача")} ${String(task.id||"").replace(/^hcai_/,'').slice(0,12)}`);set("[data-task-status]",labels[task.status||""]||String(task.status||"—"));set("[data-task-updated]",stamp(task.updated_at||task.completed_at||task.started_at||task.created_at));set("[data-task-branch]",task.branch||"—");set("[data-task-evidence]",task.evidence_class||"—");const prompt=q("[data-task-prompt-view]");if(prompt&&task.prompt){prompt.textContent=task.prompt;prompt.classList.remove("hidden");}else prompt?.classList.add("hidden");
    const approval=q("[data-approval]");if(task.status==="needs_approval"){approval?.classList.remove("hidden");set("[data-approval-copy]",t(`Safe stop at gate: ${(task.approval_gate||"owner decision").replaceAll("_"," ")}. Review evidence; continuation is not auto-authorized.`,`Безопасная остановка: ${(task.approval_gate||"решение владельца").replaceAll("_"," ")}. Проверь evidence; продолжение автоматически не разрешается.`));}else approval?.classList.add("hidden");
    const result=q("[data-result]");if(task.output_summary){result?.classList.remove("hidden");set("[data-result-copy]",task.output_summary);}else result?.classList.add("hidden");const pr=q<HTMLAnchorElement>("[data-pr-link]");const url=safePr(task.pr_url);if(pr&&url){pr.href=url;pr.classList.remove("hidden");}else pr?.classList.add("hidden");if(cancel){cancel.classList.toggle("hidden",!active);cancel.disabled=Boolean(task.cancel_requested);}renderEvents(events);
  }
  async function loadTaskDetail(task:Task|null){if(!task?.id)return renderTask(task);const r=await fetch(`/api/internal-ai/tasks/${encodeURIComponent(task.id)}`,{credentials:"same-origin",headers:{Accept:"application/json"}});let d:any={};try{d=await r.json()}catch{}if(r.ok&&d.success)return renderTask(d.task,Array.isArray(d.events)?d.events:[]);renderTask(task);}
  async function refresh(){const r=await fetch("/api/internal-ai/status",{credentials:"same-origin",headers:{Accept:"application/json"}});let d:any={};try{d=await r.json()}catch{}if(!r.ok||!d.success)return lock(r.status,d.error);q("[data-access]")?.classList.add("hidden");q("[data-content]")?.classList.remove("hidden");set("[data-runner-state]",d.runtime?.online?t("Online","Онлайн"):t("Offline","Офлайн"));set("[data-runner-detail]",d.runtime?.online?t("Outbound runner connected","Outbound runner подключён"):t("Waiting for Mac runner","Ожидаем Mac runner"));set("[data-runner-sha]",d.runtime?.repo_sha||"—");set("[data-runner-version]",d.runtime?.runtime_version||"—");const task=d.active_task||d.latest_task||null;set("[data-project-state]",task?.status==="running"?t("In progress","В работе"):task?.status==="needs_approval"?t("Needs approval","Нужно подтверждение"):t("Ready","Готов"));await loadTaskDetail(task);}
  q<HTMLFormElement>("[data-task-form]")?.addEventListener("submit",async e=>{e.preventDefault();const prompt=q<HTMLTextAreaElement>("[data-task-prompt]")?.value.trim()||"";if(!prompt)return;const button=q<HTMLButtonElement>("[data-start]");if(button)button.disabled=true;set("[data-form-status]",t("Queueing task…","Ставим задачу в очередь…"));try{const r=await fetch("/api/internal-ai/tasks",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({prompt})});let d:any={};try{d=await r.json()}catch{}if(r.status===409&&d.active_task_id){set("[data-form-status]",t("Another task is already active. Showing it below.","Уже есть активная задача. Показываю её ниже."));await refresh();return;}if(!r.ok||!d.success){set("[data-form-status]",String(d.error||t("Unable to start task.","Не удалось запустить задачу.")));return;}q<HTMLTextAreaElement>("[data-task-prompt]")!.value="";set("[data-form-status]",t("Task queued. The outbound runner can claim it now.","Задача поставлена в очередь. Outbound runner может забрать её."));await refresh();}catch{set("[data-form-status]",t("Network error while queueing task.","Ошибка сети при постановке задачи."));}finally{if(button)button.disabled=Boolean(currentTask&&["queued","running","needs_approval"].includes(currentTask.status||""));}});
  q<HTMLButtonElement>("[data-cancel]")?.addEventListener("click",async()=>{if(!currentTask?.id)return;const button=q<HTMLButtonElement>("[data-cancel]");if(button)button.disabled=true;const r=await fetch(`/api/internal-ai/tasks/${encodeURIComponent(currentTask.id)}`,{method:"PATCH",credentials:"same-origin",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({action:"cancel"})});let d:any={};try{d=await r.json()}catch{}if(!r.ok||!d.success){set("[data-form-status]",String(d.error||t("Unable to cancel task.","Не удалось отменить задачу.")));if(button)button.disabled=false;return;}set("[data-form-status]",t("Cancellation recorded.","Отмена зафиксирована."));await refresh();});
  void refresh();const timer=setInterval(()=>void refresh(),8000);addEventListener("pagehide",()=>clearInterval(timer),{once:true});
</script>

<style>
.ai-control-page{min-height:76vh;background:radial-gradient(circle at 8% 3%,rgba(255,122,0,.08),transparent 27rem),radial-gradient(circle at 90% 8%,rgba(124,92,255,.05),transparent 29rem),#f7f6f3;color:#11161f}.shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:2.2rem 0 5rem}.hero{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.2rem}.hero h1{font-size:clamp(2.25rem,5vw,4rem);margin:.3rem 0 .65rem}.hero p{max-width:790px;color:#657083;line-height:1.6}.kicker{display:flex;align-items:center;gap:.4rem;margin:0;color:#d76500;font-size:.72rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase}.badge,.state,.task-status,.agent-pill{display:inline-flex;align-items:center;gap:.4rem;border:1px solid rgba(255,122,0,.22);border-radius:999px;padding:.46rem .66rem;background:rgba(255,122,0,.08);color:#934600;font-size:.75rem;font-weight:800}.access,.card{border:1px solid rgba(17,22,31,.1);border-radius:1.2rem;background:rgba(255,255,255,.9);box-shadow:0 18px 40px rgba(24,32,48,.07)}.access{padding:1.1rem}.access p{margin:.3rem 0 0;color:#657083}.hidden{display:none!important}.content{display:grid;gap:1rem}.status-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:1rem}.card{padding:1.2rem}.card-head,.console-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.card h2{margin:.35rem 0 .7rem}.card p{color:#657083;line-height:1.55}.runtime-card dl,.task-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem;margin:.9rem 0}.runtime-card dl div,.task-meta div{padding:.68rem;border-radius:.7rem;background:#f7f6f3;min-width:0}.runtime-card dt,.task-meta dt{color:#7a8595;font-size:.68rem}.runtime-card dd,.task-meta dd{margin:.15rem 0 0;overflow-wrap:anywhere}.note{font-size:.82rem}.project-links{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1rem}.project-links a,.secondary,.pr-link{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:.35rem;padding:.55rem .72rem;border:1px solid rgba(17,22,31,.12);border-radius:.7rem;background:#fff;color:#11161f;text-decoration:none;font-weight:800}.task-form{display:grid;gap:.8rem;margin-top:1rem}.task-form label{display:grid;gap:.45rem;font-weight:800}.task-form textarea{box-sizing:border-box;width:100%;resize:vertical;border:1px solid rgba(17,22,31,.14);border-radius:.85rem;padding:.85rem;background:#fff;color:#11161f;font:inherit;line-height:1.5}.task-form textarea:focus{outline:3px solid rgba(255,122,0,.13);border-color:rgba(255,122,0,.5)}.form-actions{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap}.form-actions p{margin:0}.primary,.cancel{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:.4rem;border-radius:.72rem;padding:.62rem .86rem;font-weight:850;cursor:pointer}.primary{border:0;background:#11161f;color:#fff}.primary:disabled,.cancel:disabled{opacity:.55;cursor:not-allowed}.task-prompt{margin:.85rem 0;padding:.8rem;border-left:3px solid #ff7a00;border-radius:.5rem;background:#fff8f1;color:#4f5b6d;white-space:pre-wrap}.approval{display:flex;gap:.65rem;align-items:flex-start;margin:.85rem 0;padding:.8rem;border:1px solid rgba(245,158,11,.28);border-radius:.8rem;background:rgba(245,158,11,.08);color:#7e4700}.approval p{margin:.2rem 0 0;color:#7e5a24}.result{margin:.85rem 0;padding:.85rem;border:1px solid rgba(17,22,31,.09);border-radius:.8rem;background:#f7f6f3}.result pre{margin:.45rem 0 0;white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;color:#4f5b6d}.task-actions{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}.pr-link{color:#8e4300}.cancel{border:1px solid rgba(180,40,40,.18);background:#fff;color:#a33131}.events{display:grid;gap:.5rem;margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(17,22,31,.08)}.events>div{padding:.65rem;border-radius:.7rem;background:#f7f6f3}.events span{color:#7a8595;font-size:.68rem}.events p{margin:.25rem 0 0;white-space:pre-wrap;overflow-wrap:anywhere}@media(max-width:760px){.hero,.console-head{flex-direction:column;align-items:stretch}.status-grid{grid-template-columns:1fr}.badge{white-space:normal}.runtime-card dl,.task-meta{grid-template-columns:1fr}.form-actions,.task-actions{align-items:stretch;flex-direction:column}.primary,.cancel,.secondary,.pr-link{width:100%;box-sizing:border-box}}
</style>
