---
import { Activity, ArrowLeft, ArrowRight, CheckCircle2, CircleAlert, FolderKanban, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../../../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../../../components/SiteFooter.astro";
import HermesConnectExperience from "../../../../../../../components/HermesConnectExperience.astro";
import HermesConnectAccountSwitcher from "../../../../../../../components/HermesConnectAccountSwitcher.astro";
import HermesConnectInternalAiNav from "../../../../../../../components/HermesConnectInternalAiNav.astro";
const isRu=Astro.url.searchParams.get("lang")==="ru";const suffix=isRu?"?lang=ru":"";
---
<BaseLayout title={isRu?"Внутренний AI-пилот | Hermes Connect":"Internal AI Pilot | Hermes Connect"} description="Private Hermes Connect internal AI pilot workspace." robots="noindex,nofollow">
<SiteHeader activePath="/paths/technology/"/><HermesConnectExperience/><HermesConnectInternalAiNav/>
<main class="project-page"><div class="shell">
<a class="back" href={`/services/hermes-connect/internal/ai-connect/projects/${suffix}`}><ArrowLeft size={15}/>{isRu?"Все проекты":"All projects"}</a>
<header class="hero"><div><p class="kicker"><FolderKanban size={15}/>{isRu?"Текущий проект":"Current project"}</p><h1>Hermes Connect · Internal AI Pilot</h1><p>{isRu?"Цель — доказать полный безопасный цикл управления AI из кабинета: задача → outbound runner → Hermes Codex → branch/PR/evidence → результат или owner approval.":"Prove the full safe cabinet-controlled AI loop: task → outbound runner → Hermes Codex → branch/PR/evidence → result or owner approval."}</p></div><span class="badge"><ShieldCheck size={16}/>{isRu?"Только для владельца":"Internal owner only"}</span></header>
<HermesConnectAccountSwitcher current="ai"/>
<section class="access" data-access role="status"><strong>{isRu?"Проверяем доступ…":"Checking internal access…"}</strong><p>{isRu?"Проект откроется после проверки HERMES_INTERNAL_OWNER.":"The project opens after HERMES_INTERNAL_OWNER is verified."}</p></section>
<div class="content hidden" data-content>
<section class="grid top-grid"><article class="card"><p class="kicker"><CheckCircle2 size={14}/>{isRu?"Фундамент":"Foundation"}</p><h2>{isRu?"Что уже реально работает":"What is already real"}</h2><ul><li>{isRu?"Один Hermes identity и отдельная HERMES_INTERNAL_OWNER capability.":"One Hermes identity with a separate HERMES_INTERNAL_OWNER capability."}</li><li>{isRu?"Очередь задач, события, отмена, evidence и approval-state в D1.":"D1 task queue, events, cancellation, evidence and approval state."}</li><li>{isRu?"Mac runner работает только исходящими запросами и не открывает remote shell.":"The Mac runner is outbound-only and exposes no remote shell."}</li><li>{isRu?"Codex запускается в отдельной task-ветке и обязан остановиться на consequential gate.":"Codex runs on an isolated task branch and must stop at consequential gates."}</li></ul></article>
<aside class="card"><p class="kicker"><Activity size={14}/>{isRu?"Живое состояние":"Live state"}</p><h2 data-runtime-title>{isRu?"Ожидаем проверку runtime":"Checking runtime"}</h2><div class="line"><span>Runner</span><strong data-runner>—</strong></div><div class="line"><span>{isRu?"Задача":"Task"}</span><strong data-task>—</strong></div><div class="line"><span>{isRu?"Ветка":"Branch"}</span><strong data-branch>—</strong></div><div class="line"><span>Evidence</span><strong data-evidence>—</strong></div></aside></section>
<section class="card action-card"><div><p class="kicker"><CircleAlert size={14}/>{isRu?"Следующий шаг":"Next action"}</p><h2 data-next-title>{isRu?"Подключить живой runner и выполнить одну задачу":"Connect the live runner and execute one task"}</h2><p data-next-copy>{isRu?"После этого проект можно считать настоящим управляемым AI-контуром, а не только интерфейсом.":"After that the project becomes a real managed AI loop rather than only an interface."}</p></div><a class="action" href={`/services/hermes-connect/internal/ai-connect/${suffix}`}>{isRu?"Открыть Control Center":"Open Control Center"}<ArrowRight size={16}/></a></section>
</div></div></main><SiteFooter/>
</BaseLayout>
<script>
const ru=new URLSearchParams(location.search).get("lang")==="ru";const q=(s:string)=>document.querySelector<HTMLElement>(s);const t=(e:string,r:string)=>ru?r:e;const label=(s?:string)=>({queued:t("Queued","В очереди"),running:t("Running","В работе"),needs_approval:t("Needs approval","Нужно подтверждение"),completed:t("Completed","Завершено"),failed:t("Failed","Ошибка"),cancelled:t("Cancelled","Отменено")} as Record<string,string>)[s||""]||t("None","Нет");
async function refresh(){const r=await fetch("/api/internal-ai/status",{credentials:"same-origin",headers:{Accept:"application/json"}});let d:any={};try{d=await r.json()}catch{}if(!r.ok||!d.success){const a=q("[data-access]");if(a)a.querySelector("strong")!.textContent=r.status===401?t("Sign in required","Нужно войти"):t("Internal owner capability required","Нужен доступ внутреннего владельца");return;}q("[data-access]")?.classList.add("hidden");q("[data-content]")?.classList.remove("hidden");const task=d.active_task||d.latest_task;if(q("[data-runner]"))q("[data-runner]")!.textContent=d.runtime?.online?t("Online","Онлайн"):t("Not connected","Не подключён");if(q("[data-task]"))q("[data-task]")!.textContent=label(task?.status);if(q("[data-branch]"))q("[data-branch]")!.textContent=task?.branch||"—";if(q("[data-evidence]"))q("[data-evidence]")!.textContent=task?.evidence_class||"—";if(q("[data-runtime-title]"))q("[data-runtime-title]")!.textContent=d.runtime?.online?t("Execution path online","Контур выполнения онлайн"):t("Waiting for runner","Ожидаем runner");if(task?.status==="needs_approval"){q("[data-next-title]")!.textContent=t("Owner approval required","Нужно решение владельца");q("[data-next-copy]")!.textContent=t("Review the sanitized result and approval gate in Control Center before any consequential action.","Проверьте очищенный результат и approval gate в Control Center перед значимым действием.");}else if(task?.status==="running"||task?.status==="queued"){q("[data-next-title]")!.textContent=t("Observe the active task","Следить за активной задачей");q("[data-next-copy]")!.textContent=t("Keep one writer and wait for a result or approval gate.","Сохраняем одного исполнителя и ждём результата или запроса на подтверждение.");}else if(d.runtime?.online){q("[data-next-title]")!.textContent=t("Run one bounded task","Запустить одну безопасную задачу");q("[data-next-copy]")!.textContent=t("Use Control Center to prove the complete task receipt and evidence return.","Через Control Center подтвердите полный цикл получения задачи и возврата evidence.");}}
void refresh();const timer=setInterval(()=>void refresh(),8000);addEventListener("pagehide",()=>clearInterval(timer),{once:true});
</script>
<style>
.project-page{min-height:76vh;background:radial-gradient(circle at 8% 3%,rgba(255,122,0,.07),transparent 26rem),#f7f6f3;color:#11161f}.shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:1.7rem 0 5rem}.back{display:inline-flex;align-items:center;gap:.4rem;min-height:44px;color:#596577;text-decoration:none;font-weight:800}.hero{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin:1rem 0 1.2rem}.hero h1{font-size:clamp(2rem,5vw,3.5rem);margin:.3rem 0 .65rem}.hero p{max-width:780px;color:#657083;line-height:1.6}.kicker{display:flex;align-items:center;gap:.4rem;margin:0;color:#d76500;font-size:.72rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase}.badge{display:inline-flex;align-items:center;gap:.4rem;border:1px solid rgba(255,122,0,.22);border-radius:999px;padding:.46rem .66rem;background:rgba(255,122,0,.08);color:#934600;font-size:.75rem;font-weight:800}.access,.card{border:1px solid rgba(17,22,31,.1);border-radius:1.2rem;background:rgba(255,255,255,.9);box-shadow:0 18px 40px rgba(24,32,48,.07)}.access{padding:1.1rem}.access p,.card p{color:#657083}.hidden{display:none!important}.content{display:grid;gap:1rem}.grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.top-grid{grid-template-columns:1.2fr .8fr}.card{padding:1.2rem}.card h2{margin:.35rem 0 .75rem}.card ul{display:grid;gap:.6rem;padding-left:1.1rem;color:#4f5b6d;line-height:1.5}.card li::marker{color:#ff7a00}.line{display:flex;justify-content:space-between;gap:1rem;padding:.72rem 0;border-bottom:1px solid rgba(17,22,31,.08)}.line span{color:#7a8595}.line strong{overflow-wrap:anywhere;text-align:right}.action-card{display:flex;align-items:center;justify-content:space-between;gap:1.5rem}.action-card>div{max-width:760px}.action{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:44px;padding:.62rem .86rem;border-radius:.72rem;background:#11161f;color:#fff;text-decoration:none;font-weight:850;white-space:nowrap}@media(max-width:700px){.hero,.action-card{flex-direction:column;align-items:stretch}.grid,.top-grid{grid-template-columns:1fr}.badge{white-space:normal}.action{width:100%;box-sizing:border-box}}
</style>
