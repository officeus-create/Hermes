---
import { ArrowRight, FolderKanban, ShieldCheck, Sparkles } from "@lucide/astro";
import BaseLayout from "../../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../../components/SiteFooter.astro";
import HermesConnectExperience from "../../../../../../components/HermesConnectExperience.astro";
import HermesConnectInternalCabinetNav from "../../../../../../components/HermesConnectInternalCabinetNav.astro";
---
<BaseLayout title="Projects | AI Connect | Hermes Connect" description="Private internal AI Connect project list." robots="noindex,nofollow">
  <SiteHeader activePath="/paths/technology/" />
  <HermesConnectExperience />
  <HermesConnectInternalCabinetNav />
  <main id="main-content" class="projects-page">
    <div class="projects-shell">
      <header class="projects-hero">
        <div>
          <p class="projects-kicker"><Sparkles size={15} /><span data-en="AI Connect · projects" data-ru="AI Connect · проекты">AI Connect · projects</span></p>
          <h1 data-en="Projects" data-ru="Проекты">Projects</h1>
          <p data-en="Open a workstream the same way you would open a project in any familiar workspace. Only real Hermes projects with proven state appear here." data-ru="Открывайте направление работы как обычный проект в привычном рабочем кабинете. Здесь отображаются только реальные проекты Hermes с подтверждённым состоянием.">Open a workstream the same way you would open a project in any familiar workspace. Only real Hermes projects with proven state appear here.</p>
        </div>
        <span class="projects-badge"><ShieldCheck size={16} /><span data-en="Internal owner only" data-ru="Только для владельца">Internal owner only</span></span>
      </header>

      <section class="projects-state" data-access-state role="status">
        <strong data-access-title data-en="Checking internal access…" data-ru="Проверяем доступ…">Checking internal access…</strong>
        <p data-access-copy data-en="Projects open only after Hermes Connect verifies the internal owner capability." data-ru="Проекты открываются только после проверки внутреннего доступа владельца Hermes Connect.">Projects open only after Hermes Connect verifies the internal owner capability.</p>
      </section>

      <div class="projects-content hidden" data-projects-content>
        <div class="projects-summary">
          <strong data-en="1 current project" data-ru="1 текущий проект">1 current project</strong>
          <span data-en="No demo or placeholder projects" data-ru="Без демонстрационных и выдуманных проектов">No demo or placeholder projects</span>
        </div>

        <section class="projects-grid" aria-label="AI Connect projects">
          <article class="project-card">
            <div class="project-card__top">
              <div class="project-icon" aria-hidden="true"><FolderKanban size={22} /></div>
              <span class="project-status" data-project-status>Ready</span>
            </div>
            <div>
              <p class="projects-kicker" data-en="Current workstream" data-ru="Текущее направление">Current workstream</p>
              <h2>Hermes Connect · Internal AI Pilot</h2>
              <p data-en="Finish the first safe owner → task → runner → Codex → evidence loop before expanding to more agents or projects." data-ru="Завершить первый безопасный цикл владелец → задача → runner → Codex → подтверждения до расширения на новых агентов и проекты.">Finish the first safe owner → task → runner → Codex → evidence loop before expanding to more agents or projects.</p>
            </div>
            <dl class="project-meta">
              <div><dt data-en="Agent" data-ru="Агент">Agent</dt><dd>Software Engineer</dd></div>
              <div><dt data-en="Task" data-ru="Задача">Task</dt><dd data-task-state>None</dd></div>
              <div><dt data-en="Runner" data-ru="Runner">Runner</dt><dd data-runner-state>Unknown</dd></div>
            </dl>
            <a class="project-open" data-cabinet-link href="/services/hermes-connect/internal/ai-connect/projects/hermes-connect-internal-ai-pilot/"><span data-en="Open project" data-ru="Открыть проект">Open project</span><ArrowRight size={16} /></a>
          </article>
        </section>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  type Task = { status?: string | null };
  const $ = <T extends HTMLElement = HTMLElement>(selector:string) => document.querySelector<T>(selector);
  const locale = () => document.documentElement.dataset.internalCabinetLocale === "ru" ? "ru" : "en";
  const t = (en:string, ru:string) => locale() === "ru" ? ru : en;
  const text = (selector:string,value:string) => { const node=$(selector); if(node) node.textContent=value; };
  const taskStatus = (value?:string|null) => {
    const map:Record<string,[string,string]> = {queued:["Queued","В очереди"],running:["Running","В работе"],completed:["Completed","Завершено"],failed:["Failed","Ошибка"],cancelled:["Cancelled","Отменено"],needs_approval:["Needs approval","Нужно подтверждение"]};
    return value && map[value] ? t(map[value][0],map[value][1]) : t("None","Нет");
  };
  const lock = (titleEn:string,titleRu:string,copyEn:string,copyRu:string) => {
    text("[data-access-title]",t(titleEn,titleRu));
    text("[data-access-copy]",t(copyEn,copyRu));
    $("[data-access-state]")?.classList.remove("hidden");
    $("[data-projects-content]")?.classList.add("hidden");
  };
  async function refresh(){
    const response = await fetch("/api/internal-ai/status",{credentials:"same-origin",headers:{Accept:"application/json"}});
    let data:any={}; try{data=await response.json()}catch{}
    if(response.status===401) return lock("Sign in required","Нужно войти","Sign in to Hermes Connect, then reopen Projects.","Войдите в Hermes Connect и снова откройте Проекты.");
    if(response.status===403) return lock("Internal owner capability required","Нужен доступ владельца","Customer and ordinary Hermes Connect accounts cannot access internal projects.","Клиентские и обычные аккаунты Hermes Connect не имеют доступа к внутренним проектам.");
    if(!response.ok||!data.success) return lock("Projects are unavailable","Проекты недоступны",String(data.error||"runtime_unavailable"),String(data.error||"runtime_unavailable"));
    $("[data-access-state]")?.classList.add("hidden");
    $("[data-projects-content]")?.classList.remove("hidden");
    const task:Task|null=data.active_task||data.latest_task||null;
    text("[data-task-state]",taskStatus(task?.status));
    text("[data-runner-state]",data.runtime?.online?t("Online","Онлайн"):t("Not connected","Не подключён"));
    text("[data-project-status]",task?.status==="running"?t("In progress","В работе"):task?.status==="needs_approval"?t("Needs approval","Нужно подтверждение"):task?t("Active","Активен"):t("Ready","Готов"));
  }
  window.addEventListener("hc-internal-locale-ready",()=>void refresh());
  void refresh();
  const timer=window.setInterval(()=>void refresh(),8000);
  window.addEventListener("pagehide",()=>window.clearInterval(timer),{once:true});
</script>

<style>
.projects-page{min-height:calc(100vh - 10rem);background:#090d16;color:#edf2fb}.projects-shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:2rem 0 4rem}.projects-hero{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.5rem}.projects-hero h1{font-size:clamp(2.2rem,5vw,3.8rem);margin:.3rem 0 .7rem}.projects-hero p{max-width:760px;color:#b9c5d8;line-height:1.6}.projects-kicker{display:flex;gap:.4rem;align-items:center;margin:0;color:#a99aff;font-size:.72rem;font-weight:820;letter-spacing:.09em;text-transform:uppercase}.projects-badge,.project-status{display:inline-flex;align-items:center;gap:.4rem;white-space:nowrap;border:1px solid rgba(96,165,250,.3);border-radius:999px;padding:.48rem .68rem;color:#dceaff;background:rgba(96,165,250,.1);font-size:.76rem;font-weight:760}.projects-state,.project-card{border:1px solid rgba(255,255,255,.11);border-radius:1.2rem;background:rgba(17,24,39,.82);box-shadow:0 18px 40px rgba(0,0,0,.18)}.projects-state{padding:1.2rem}.projects-state p{margin:.35rem 0 0;color:#b9c5d8}.hidden{display:none!important}.projects-content{display:grid;gap:1rem}.projects-summary{display:flex;justify-content:space-between;gap:1rem;color:#9eabc0;font-size:.82rem}.projects-summary strong{color:#edf2fb}.projects-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem}.project-card{padding:1.3rem;display:grid;gap:1rem}.project-card__top{display:flex;align-items:center;justify-content:space-between;gap:1rem}.project-icon{display:grid;place-items:center;width:2.7rem;height:2.7rem;border-radius:.8rem;background:rgba(169,154,255,.1);color:#c8bcff}.project-card h2{margin:.3rem 0 .55rem;font-size:1.35rem}.project-card p{color:#b9c5d8;line-height:1.55}.project-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem;margin:0}.project-meta div{padding:.75rem;border-radius:.75rem;background:rgba(255,255,255,.035)}.project-meta dt{color:#8fa0b8;font-size:.72rem}.project-meta dd{margin:.22rem 0 0;overflow-wrap:anywhere}.project-open{justify-self:start;display:inline-flex;align-items:center;gap:.45rem;border-radius:.7rem;padding:.72rem .9rem;text-decoration:none;font-weight:800;background:#8bdbff;color:#07101c}@media(max-width:700px){.projects-shell{padding-top:1.3rem}.projects-hero{flex-direction:column;align-items:stretch}.projects-badge{white-space:normal}.projects-summary{flex-direction:column;gap:.25rem}.project-meta{grid-template-columns:1fr}.project-open{width:100%;box-sizing:border-box;justify-content:center}}
</style>
