---
import { Activity, ExternalLink, ShieldCheck, Sparkles } from "@lucide/astro";
import BaseLayout from "../../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../../components/SiteFooter.astro";
import HermesConnectExperience from "../../../../../../components/HermesConnectExperience.astro";
import HermesConnectAccountSwitcher from "../../../../../../components/HermesConnectAccountSwitcher.astro";
import HermesConnectInternalAiNav from "../../../../../../components/HermesConnectInternalAiNav.astro";
const isRu = Astro.url.searchParams.get("lang") === "ru";
const suffix = isRu ? "?lang=ru" : "";
---
<BaseLayout title={isRu ? "Активность | AI Connect | Hermes Connect" : "Activity | AI Connect | Hermes Connect"} description="Private sanitized Hermes Connect internal AI activity." robots="noindex,nofollow">
  <SiteHeader activePath="/paths/technology/" />
  <HermesConnectExperience />
  <HermesConnectInternalAiNav />
  <main class="ai-activity-page"><div class="shell">
    <header class="hero"><div><p class="kicker"><Sparkles size={15}/> AI Connect · {isRu?"активность":"activity"}</p><h1>{isRu?"Активность":"Activity"}</h1><p>{isRu?"История внутренних AI-задач: безопасные результаты, ветки, PR, evidence и остановки на подтверждение. Исходные секреты и credentials здесь не отображаются.":"Internal AI task history: sanitized results, branches, PRs, evidence and approval stops. Raw secrets and credentials are never rendered here."}</p></div><span class="badge"><ShieldCheck size={16}/>{isRu?"Только для владельца":"Internal owner only"}</span></header>
    <HermesConnectAccountSwitcher current="ai" />
    <section class="access" data-access role="status"><strong>{isRu?"Проверяем доступ…":"Checking internal access…"}</strong><p>{isRu?"Активность откроется после проверки HERMES_INTERNAL_OWNER.":"Activity opens after HERMES_INTERNAL_OWNER is verified."}</p></section>
    <section class="content hidden" data-content>
      <div class="summary"><div><span>{isRu?"Последние задачи":"Recent tasks"}</span><strong data-task-count>0</strong></div><div><span>{isRu?"Нужно подтверждение":"Needs approval"}</span><strong data-approval-count>0</strong></div><a href={`/services/hermes-connect/internal/ai-assistant/${suffix}`}>{isRu?"Запустить задачу":"Start task"}</a></div>
      <div class="list" data-list aria-live="polite"></div>
    </section>
  </div></main>
  <SiteFooter />
</BaseLayout>
<script>
  type Task={id?:string,status?:string,created_at?:string|null,updated_at?:string|null,started_at?:string|null,completed_at?:string|null,branch?:string|null,pr_url?:string|null,evidence_class?:string|null,output_summary?:string|null,approval_gate?:string|null};
  const ru=new URLSearchParams(location.search).get("lang")==="ru";const q=(s:string)=>document.querySelector<HTMLElement>(s);const t=(en:string,ruText:string)=>ru?ruText:en;
  const statusLabel=(s?:string)=>({queued:t("Queued","В очереди"),running:t("Running","В работе"),completed:t("Completed","Завершено"),failed:t("Failed","Ошибка"),cancelled:t("Cancelled","Отменено"),needs_approval:t("Needs approval","Нужно подтверждение")} as Record<string,string>)[s||""]||t("Unknown","Неизвестно");
  const safePr=(value?:string|null)=>{if(!value)return null;try{const u=new URL(value);return u.protocol==="https:"&&u.hostname==="github.com"&&/^\/officeus-create\/Hermes\/pull\/\d+\/?$/.test(u.pathname)?u.href:null}catch{return null}};
  const date=(value?:string|null)=>value?new Date(value).toLocaleString(ru?"ru-RU":"en-US",{dateStyle:"medium",timeStyle:"short"}):"—";
  function render(tasks:Task[]){if(q("[data-task-count]"))q("[data-task-count]")!.textContent=String(tasks.length);if(q("[data-approval-count]"))q("[data-approval-count]")!.textContent=String(tasks.filter(x=>x.status==="needs_approval").length);const list=q("[data-list]");if(!list)return;list.replaceChildren();if(!tasks.length){const e=document.createElement("article");e.className="empty";e.innerHTML=`<strong>${t("No activity yet","Истории задач пока нет")}</strong><p>${t("Start one bounded task from AI Assistant.","Запустите одну безопасную задачу через AI Assistant.")}</p>`;list.append(e);return;}tasks.forEach((task,index)=>{const card=document.createElement("article");card.className=`task-card status-${task.status||"unknown"}`;const top=document.createElement("div");top.className="task-top";const title=document.createElement("div");const eyebrow=document.createElement("span");eyebrow.className="agent";eyebrow.textContent="Software Engineer";const h=document.createElement("h2");h.textContent=`${t("Task","Задача")} ${String(task.id||index+1).replace(/^hcai_/,'').slice(0,12)}`;title.append(eyebrow,h);const st=document.createElement("span");st.className="task-status";st.textContent=statusLabel(task.status);top.append(title,st);card.append(top);const meta=document.createElement("dl");[[t("Updated","Обновлено"),date(task.updated_at||task.completed_at||task.started_at||task.created_at)],[t("Branch","Ветка"),task.branch||"—"],[t("Evidence","Подтверждение"),task.evidence_class||"—"]].forEach(([a,b])=>{const d=document.createElement("div"),dt=document.createElement("dt"),dd=document.createElement("dd");dt.textContent=a;dd.textContent=b;d.append(dt,dd);meta.append(d)});card.append(meta);const out=document.createElement("p");out.className="output";out.textContent=task.output_summary||t("No sanitized result returned yet.","Очищенный результат пока не получен.");card.append(out);if(task.status==="needs_approval"){const ap=document.createElement("div");ap.className="approval";ap.textContent=t(`Approval required: ${(task.approval_gate||"owner decision").replaceAll("_"," ")}.`,`Нужно подтверждение: ${(task.approval_gate||"решение владельца").replaceAll("_"," ")}.`);card.append(ap)}const pr=safePr(task.pr_url);if(pr){const a=document.createElement("a");a.className="pr";a.href=pr;a.target="_blank";a.rel="noopener";a.textContent=t("Open PR ↗","Открыть PR ↗");card.append(a)}list.append(card)});}
  async function refresh(){const r=await fetch("/api/internal-ai/tasks",{credentials:"same-origin",headers:{Accept:"application/json"}});let data:any={};try{data=await r.json()}catch{}if(!r.ok||!data.success){const a=q("[data-access]");if(a)a.querySelector("strong")!.textContent=r.status===401?t("Sign in required","Нужно войти"):t("Internal owner capability required","Нужен доступ внутреннего владельца");return;}q("[data-access]")?.classList.add("hidden");q("[data-content]")?.classList.remove("hidden");render(Array.isArray(data.tasks)?data.tasks:[])}
  void refresh();const timer=setInterval(()=>void refresh(),8000);addEventListener("pagehide",()=>clearInterval(timer),{once:true});
</script>
<style>
.ai-activity-page{min-height:76vh;background:radial-gradient(circle at 8% 3%,rgba(255,122,0,.07),transparent 26rem),#f7f6f3;color:#11161f}.shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:2.2rem 0 5rem}.hero{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.2rem}.hero h1{font-size:clamp(2.2rem,5vw,3.8rem);margin:.3rem 0 .65rem}.hero p{max-width:780px;color:#657083;line-height:1.6}.kicker{display:flex;align-items:center;gap:.4rem;margin:0;color:#d76500;font-size:.72rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase}.badge,.task-status{display:inline-flex;align-items:center;gap:.4rem;border:1px solid rgba(255,122,0,.22);border-radius:999px;padding:.46rem .66rem;background:rgba(255,122,0,.08);color:#934600;font-size:.75rem;font-weight:800}.access,.summary,.task-card,.empty{border:1px solid rgba(17,22,31,.1);border-radius:1.2rem;background:rgba(255,255,255,.9);box-shadow:0 18px 40px rgba(24,32,48,.07)}.access{padding:1.1rem}.access p{margin:.3rem 0 0;color:#657083}.hidden{display:none!important}.content,.list{display:grid;gap:.85rem}.summary{display:grid;grid-template-columns:1fr 1fr auto;align-items:center;gap:.8rem;padding:1rem}.summary div{display:grid}.summary span{color:#7a8595;font-size:.7rem}.summary strong{font-size:1.12rem}.summary a{min-height:44px;display:inline-flex;align-items:center;justify-content:center;padding:.55rem .75rem;border-radius:.7rem;background:#11161f;color:#fff;text-decoration:none;font-weight:800}.task-card{padding:1.15rem;display:grid;gap:.85rem}.task-top{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem}.agent{color:#7a8595;font-size:.7rem;font-weight:800}.task-card h2{margin:.15rem 0 0;font-size:1rem}.task-card dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem;margin:0}.task-card dl div{padding:.68rem;border-radius:.7rem;background:#f7f6f3;min-width:0}.task-card dt{color:#7a8595;font-size:.68rem}.task-card dd{margin:.15rem 0 0;overflow-wrap:anywhere}.output{margin:0;color:#566174;line-height:1.55;white-space:pre-wrap;overflow-wrap:anywhere}.approval{padding:.7rem;border:1px solid rgba(245,158,11,.28);border-radius:.72rem;background:rgba(245,158,11,.08);color:#8a4b00;font-weight:700}.pr{justify-self:start;color:#a75000;text-decoration:none;font-weight:800}.empty{padding:2rem;text-align:center}.empty p{color:#657083}.status-completed .task-status{border-color:rgba(16,185,129,.25);background:rgba(16,185,129,.07);color:#087653}.status-needs_approval .task-status{border-color:rgba(245,158,11,.28);background:rgba(245,158,11,.08);color:#8a4b00}@media(max-width:700px){.hero{flex-direction:column}.badge{white-space:normal}.summary{grid-template-columns:1fr 1fr}.summary a{grid-column:1/-1}.task-card dl{grid-template-columns:1fr}.task-top{align-items:flex-start}}
</style>
