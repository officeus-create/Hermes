---
import { CircleStop, ExternalLink, Send, ShieldCheck, Sparkles } from "@lucide/astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../components/SiteFooter.astro";
import HermesConnectExperience from "../../../../../components/HermesConnectExperience.astro";
import HermesConnectInternalCabinetNav from "../../../../../components/HermesConnectInternalCabinetNav.astro";
---
<BaseLayout title="AI Assistant | Hermes Connect" description="Private internal Hermes Connect AI Assistant." robots="noindex,nofollow">
  <SiteHeader activePath="/paths/technology/" />
  <HermesConnectExperience />
  <HermesConnectInternalCabinetNav />
  <main id="main-content" class="internal-ai-page">
    <div class="internal-ai-shell">
      <header class="internal-ai-hero">
        <div>
          <p class="internal-ai-kicker"><Sparkles size={15} /><span data-en="AI Connect · execution" data-ru="AI Connect · выполнение">AI Connect · execution</span></p>
          <h1 data-en="AI Assistant" data-ru="ИИ-ассистент">AI Assistant</h1>
          <p data-en="Give one bounded software task to Hermes Codex. Activity, result and evidence stay inside your Hermes Connect cabinet." data-ru="Поставьте одну безопасную задачу Hermes Codex. Ход работы, результат и подтверждения останутся внутри вашего кабинета Hermes Connect.">Give one bounded software task to Hermes Codex. Activity, result and evidence stay inside your Hermes Connect cabinet.</p>
        </div>
        <span class="internal-ai-badge"><ShieldCheck size={16} /><span data-en="Internal owner only" data-ru="Только для владельца">Internal owner only</span></span>
      </header>

      <section class="internal-ai-state" data-access-state role="status">
        <strong data-access-title data-en="Checking internal access…" data-ru="Проверяем доступ…">Checking internal access…</strong>
        <p data-access-copy data-en="A valid Hermes Connect session still requires the separate internal owner capability." data-ru="Даже после входа Hermes Connect отдельно проверяет внутренний доступ владельца.">A valid Hermes Connect session still requires the separate internal owner capability.</p>
      </section>

      <div class="internal-ai-content hidden" data-ai-content>
        <section class="internal-ai-grid">
          <article class="internal-ai-card internal-ai-composer">
            <div class="internal-ai-heading">
              <div><p class="internal-ai-kicker" data-en="Ask AI" data-ru="Поставить задачу">Ask AI</p><h2>Software Engineer</h2></div>
              <span data-runner-state>Runner status unknown</span>
            </div>
            <label for="internal-ai-prompt"><span data-en="What should Hermes Codex do?" data-ru="Что должен сделать Hermes Codex?">What should Hermes Codex do?</span>
              <textarea id="internal-ai-prompt" data-task-prompt maxlength="12000" rows="8" data-placeholder-en="Describe one bounded task. Hermes Codex follows AGENTS.md and stops at consequential owner gates." data-placeholder-ru="Опишите одну конкретную безопасную задачу. Hermes Codex соблюдает AGENTS.md и останавливается на действиях, требующих решения владельца." placeholder="Describe one bounded task. Hermes Codex follows AGENTS.md and stops at consequential owner gates."></textarea>
            </label>
            <div class="internal-ai-composer-footer">
              <p data-en="Your text is task input, not a shell command." data-ru="Ваш текст передаётся как задача, а не как команда терминала.">Your text is task input, not a shell command.</p>
              <button type="button" data-run><Send size={16} /><span data-en="Start task" data-ru="Запустить задачу">Start task</span></button>
            </div>
            <p class="internal-ai-alert hidden" data-task-alert role="status"></p>
          </article>

          <aside class="internal-ai-card">
            <div class="internal-ai-heading"><div><p class="internal-ai-kicker" data-en="Current task" data-ru="Текущая задача">Current task</p><h2 data-task-title>No active task</h2></div><span class="internal-ai-status" data-task-status>Idle</span></div>
            <dl class="internal-ai-details">
              <div><dt data-en="Role" data-ru="Роль">Role</dt><dd>Software Engineer</dd></div>
              <div><dt data-en="Phase" data-ru="Этап">Phase</dt><dd data-task-phase>Ready</dd></div>
              <div><dt data-en="Started" data-ru="Начато">Started</dt><dd data-task-started>—</dd></div>
              <div><dt data-en="Branch" data-ru="Ветка">Branch</dt><dd data-task-branch>—</dd></div>
            </dl>
            <div class="internal-ai-actions">
              <a class="hidden" data-pr-link href="#" target="_blank" rel="noopener"><ExternalLink size={15} /><span data-en="Open PR" data-ru="Открыть PR">Open PR</span></a>
              <button class="hidden cancel" type="button" data-stop><CircleStop size={15} /><span data-en="Cancel task" data-ru="Отменить задачу">Cancel task</span></button>
            </div>
          </aside>
        </section>

        <section class="internal-ai-card">
          <div class="internal-ai-heading"><div><p class="internal-ai-kicker" data-en="Activity" data-ru="Ход работы">Activity</p><h2 data-en="Sanitized events" data-ru="Безопасные события">Sanitized events</h2></div><span data-event-count>0 events</span></div>
          <div class="internal-ai-events" data-events><p data-en="No activity yet." data-ru="Событий пока нет.">No activity yet.</p></div>
        </section>

        <section class="internal-ai-grid">
          <article class="internal-ai-card"><p class="internal-ai-kicker" data-en="Result" data-ru="Результат">Result</p><h2 data-en="Evidence" data-ru="Подтверждения">Evidence</h2><p data-result>Task results, branch, pull request and safe evidence will appear here.</p></article>
          <article class="internal-ai-card needs-approval"><p class="internal-ai-kicker" data-en="Needs approval" data-ru="Нужно подтверждение">Needs approval</p><h2 data-approval-title>No approval needed</h2><p data-approval-copy>Only consequential AGENTS.md gates appear here.</p></article>
        </section>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  type Task = { id:string; agent_role:string; prompt:string; status:string; started_at?:string|null; branch?:string|null; pr_url?:string|null; output_summary?:string|null; approval_gate?:string|null; cancel_requested?:boolean };
  type Event = { id:number; event_type:string; message:string; created_at:string };
  const $ = <T extends HTMLElement = HTMLElement>(s:string) => document.querySelector<T>(s);
  let active:Task|null=null; let refreshTimer:number|undefined;
  const locale=()=>document.documentElement.dataset.internalCabinetLocale === "ru" ? "ru" : "en";
  const t=(en:string,ru:string)=>locale()==="ru"?ru:en;
  const text=(s:string,v:string)=>{const node=$(s);if(node)node.textContent=v};
  const date=(v?:string|null)=>v?new Date(v).toLocaleString(locale()==="ru"?"ru-RU":"en-US"):"—";
  const statusLabel=(status?:string|null)=>{const map:Record<string,[string,string]>={queued:["Queued","В очереди"],running:["Running","В работе"],completed:["Completed","Завершено"],failed:["Failed","Ошибка"],cancelled:["Cancelled","Отменено"],needs_approval:["Needs approval","Нужно подтверждение"]};return status&&map[status]?t(map[status][0],map[status][1]):t("Idle","Нет активной задачи")};
  function alert(message:string,kind="error"){const node=$("[data-task-alert]");if(!node)return;node.textContent=message;node.className=`internal-ai-alert ${kind}`}
  async function api(path:string,init?:RequestInit){const response=await fetch(path,{credentials:"same-origin",...init,headers:{"Content-Type":"application/json",...(init?.headers||{})}});let data:any={};try{data=await response.json()}catch{}return{response,data}}
  function renderEvents(events:Event[]){const list=$("[data-events]");if(!list)return;list.replaceChildren();text("[data-event-count]",locale()==="ru"?`${events.length} событий`:`${events.length} ${events.length===1?"event":"events"}`);if(!events.length){list.textContent=t("No activity yet.","Событий пока нет.");return}for(const event of events){const row=document.createElement("article"),meta=document.createElement("strong"),time=document.createElement("time"),body=document.createElement("pre");meta.textContent=event.event_type;time.textContent=date(event.created_at);body.textContent=event.message;row.append(meta,time,body);list.append(row)}}
  function renderTask(task:Task|null){active=task;text("[data-task-title]",task?"Software Engineer":t("No active task","Нет активной задачи"));text("[data-task-status]",statusLabel(task?.status));text("[data-task-phase]",statusLabel(task?.status));text("[data-task-started]",date(task?.started_at));text("[data-task-branch]",task?.branch||"—");text("[data-result]",task?.output_summary||t("Task results, branch, pull request and safe evidence will appear here.","Здесь появятся результат задачи, ветка, pull request и безопасные подтверждения."));const gate=task?.approval_gate;text("[data-approval-title]",gate?t(`Approval required: ${gate.replaceAll("_"," ")}`,`Нужно подтверждение: ${gate.replaceAll("_"," ")}`):t("No approval needed","Подтверждение не требуется"));text("[data-approval-copy]",gate?t("This task stopped at a real consequential owner gate. Review the evidence before acting.","Задача остановилась на реальном действии, требующем решения владельца. Сначала проверьте подтверждения."):t("Only consequential AGENTS.md gates appear here: deletion, credentials, merge/deploy, permissions, external communication, legal, destructive database change, scope expansion or unresolved evidence.","Здесь появляются только реальные действия из AGENTS.md, требующие решения владельца: удаление, секреты, merge/deploy, права доступа, внешние сообщения, юридические действия, разрушительные изменения базы, расширение области или неразрешённые доказательства."));const pr=$<HTMLAnchorElement>("[data-pr-link]");if(pr){pr.classList.toggle("hidden",!task?.pr_url);if(task?.pr_url)pr.href=task.pr_url}$("[data-stop]")?.classList.toggle("hidden",!task||!["queued","running","needs_approval"].includes(task.status));}
  async function loadTask(id:string){const {response,data}=await api(`/api/internal-ai/tasks/${encodeURIComponent(id)}`);if(response.ok&&data.success){renderTask(data.task);renderEvents(data.events||[])}}
  function lock(titleEn:string,titleRu:string,copyEn:string,copyRu:string){text("[data-access-title]",t(titleEn,titleRu));text("[data-access-copy]",t(copyEn,copyRu));$("[data-access-state]")?.classList.remove("hidden");$("[data-ai-content]")?.classList.add("hidden")}
  async function refresh(){const {response,data}=await api("/api/internal-ai/status");if(response.status===401)return lock("Sign in required","Нужно войти","Sign in to Hermes Connect, then reopen AI Assistant.","Войдите в Hermes Connect и снова откройте ИИ-ассистент.");if(response.status===403)return lock("Internal owner capability required","Нужен доступ владельца","Repair Shop and ordinary Hermes Connect accounts cannot access internal AI tasks.","Клиентские и обычные аккаунты Hermes Connect не имеют доступа к внутренним ИИ-задачам.");if(!response.ok||!data.success)return lock("AI Assistant is unavailable","ИИ-ассистент недоступен",String(data.error||"runtime_unavailable"),String(data.error||"runtime_unavailable"));$("[data-access-state]")?.classList.add("hidden");$("[data-ai-content]")?.classList.remove("hidden");text("[data-runner-state]",data.runtime?.online?t("Runner online","Runner онлайн"):t("Runner not connected","Runner не подключён"));const task=data.active_task||data.latest_task||null;renderTask(task);if(task?.id)await loadTask(task.id)}
  $<HTMLButtonElement>("[data-run]")?.addEventListener("click",async()=>{const prompt=$<HTMLTextAreaElement>("[data-task-prompt]")?.value.trim()||"";if(!prompt)return alert(t("Describe a bounded task first.","Сначала опишите конкретную безопасную задачу."));const {response,data}=await api("/api/internal-ai/tasks",{method:"POST",body:JSON.stringify({prompt})});if(!response.ok||!data.success)return alert(data.error||t("Unable to create task.","Не удалось создать задачу."));alert(t("Task queued for the internal runner.","Задача поставлена в очередь внутреннего runner."),"success");renderTask(data.task);await refresh()});
  $<HTMLButtonElement>("[data-stop]")?.addEventListener("click",async()=>{if(!active)return;const {response,data}=await api(`/api/internal-ai/tasks/${encodeURIComponent(active.id)}`,{method:"PATCH",body:JSON.stringify({action:"cancel"})});if(!response.ok||!data.success)return alert(data.error||t("Unable to cancel task.","Не удалось отменить задачу."));alert(t("Cancellation requested.","Запрошена отмена задачи."),"success");renderTask(data.task)});
  window.addEventListener("hc-internal-locale-ready",()=>void refresh());
  void refresh();refreshTimer=window.setInterval(()=>void refresh(),8000);window.addEventListener("pagehide",()=>{if(refreshTimer)window.clearInterval(refreshTimer)},{once:true});
</script>

<style>
.internal-ai-page{min-height:calc(100vh - 12rem);background:#090d16;color:#edf2fb}.internal-ai-shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:2rem 0 4rem}.internal-ai-hero{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.5rem}.internal-ai-hero h1{font-size:clamp(2.2rem,5vw,4rem);margin:.3rem 0 .75rem}.internal-ai-hero p{max-width:720px;color:#b9c5d8;line-height:1.6}.internal-ai-kicker{display:flex;gap:.4rem;align-items:center;margin:0;color:#a99aff;font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.internal-ai-badge,.internal-ai-status{display:inline-flex;align-items:center;gap:.4rem;white-space:nowrap;border:1px solid rgba(96,165,250,.32);border-radius:999px;padding:.5rem .72rem;color:#dceaff;background:rgba(96,165,250,.1);font-size:.78rem;font-weight:750}.internal-ai-state,.internal-ai-card{border:1px solid rgba(255,255,255,.11);border-radius:1.25rem;background:rgba(17,24,39,.82);box-shadow:0 18px 40px rgba(0,0,0,.18)}.internal-ai-state{padding:1.2rem}.internal-ai-state p{margin:.35rem 0 0;color:#b9c5d8}.hidden{display:none!important}.internal-ai-content{display:grid;gap:1rem}.internal-ai-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem}.internal-ai-card{padding:1.25rem}.internal-ai-heading{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.internal-ai-card h2{margin:.35rem 0 .7rem;font-size:1.2rem}.internal-ai-composer label{display:grid;gap:.5rem;font-weight:700}.internal-ai-composer textarea{width:100%;box-sizing:border-box;resize:vertical;margin-top:.5rem;border-radius:.8rem;border:1px solid rgba(255,255,255,.15);padding:.85rem;background:#070b13;color:#fff;font:inherit;line-height:1.5}.internal-ai-composer-footer,.internal-ai-actions{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:.85rem}.internal-ai-composer-footer p,.internal-ai-card>p{color:#b9c5d8;line-height:1.5}.internal-ai-composer button,.internal-ai-actions a,.internal-ai-actions button{display:inline-flex;align-items:center;gap:.45rem;border:0;border-radius:.7rem;padding:.7rem .9rem;font:inherit;font-weight:800;text-decoration:none;color:#07101c;background:#8bdbff;cursor:pointer}.internal-ai-actions .cancel{background:rgba(255,255,255,.1);color:#fff}.internal-ai-alert{margin:.75rem 0 0;padding:.7rem;border-radius:.6rem;background:rgba(248,113,113,.15);color:#fecaca}.internal-ai-alert.success{background:rgba(52,211,153,.12);color:#bbf7d0}.internal-ai-details{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin:1rem 0}.internal-ai-details div{min-width:0}.internal-ai-details dt{color:#9eabc0;font-size:.75rem}.internal-ai-details dd{margin:.2rem 0 0;overflow-wrap:anywhere}.internal-ai-events{display:grid;gap:.7rem;max-height:24rem;overflow:auto}.internal-ai-events>p{color:#b9c5d8}.internal-ai-events article{padding:.75rem;border-radius:.75rem;background:rgba(255,255,255,.045)}.internal-ai-events time{display:block;margin-top:.2rem;color:#9eabc0;font-size:.75rem}.internal-ai-events pre{margin:.55rem 0 0;white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;color:#dce5f4}.needs-approval{border-color:rgba(251,191,36,.28)}@media(max-width:700px){.internal-ai-shell{padding-top:1.4rem}.internal-ai-hero,.internal-ai-composer-footer,.internal-ai-actions{align-items:stretch;flex-direction:column}.internal-ai-grid{grid-template-columns:1fr}.internal-ai-badge{white-space:normal}.internal-ai-composer button{justify-content:center}.internal-ai-details{grid-template-columns:1fr}}
</style>
