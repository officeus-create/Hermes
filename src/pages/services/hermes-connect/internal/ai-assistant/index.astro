---
import { CircleStop, ExternalLink, Send, ShieldCheck, Sparkles } from "@lucide/astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../components/SiteFooter.astro";
import HermesConnectExperience from "../../../../../components/HermesConnectExperience.astro";
---
<BaseLayout title="AI Assistant | Hermes Connect" description="Private internal Hermes Connect AI Assistant." robots="noindex,nofollow">
  <SiteHeader activePath="/paths/technology/" />
  <HermesConnectExperience />
  <main id="main-content" class="internal-ai-page">
    <div class="internal-ai-shell">
      <header class="internal-ai-hero">
        <div><p class="internal-ai-kicker"><Sparkles size={15} /> Hermes Connect · Internal capability</p><h1>AI Assistant</h1><p>Give one bounded software task to the internal Hermes runner. Tasks create evidence and reviewable work; they never authorize deployment or other consequential actions.</p></div>
        <span class="internal-ai-badge"><ShieldCheck size={16} /> Internal owner only</span>
      </header>
      <section class="internal-ai-state" data-access-state role="status"><strong data-access-title>Checking internal access…</strong><p data-access-copy>Valid Hermes Connect sessions still require the separate internal owner capability.</p></section>
      <div class="internal-ai-content hidden" data-ai-content>
        <section class="internal-ai-grid">
          <article class="internal-ai-card internal-ai-composer"><div class="internal-ai-heading"><div><p class="internal-ai-kicker">Ask AI</p><h2>Software Engineer</h2></div><span data-runner-state>Runner status unknown</span></div>
            <label for="internal-ai-prompt">What should Hermes Codex do?<textarea id="internal-ai-prompt" data-task-prompt maxlength="12000" rows="8" placeholder="Describe one bounded task. The runner follows AGENTS.md and stops at consequential owner gates."></textarea></label>
            <div class="internal-ai-composer-footer"><p>Task text is passed as input, never executed as a shell command.</p><button type="button" data-run><Send size={16} /> Start task</button></div><p class="internal-ai-alert hidden" data-task-alert role="status"></p>
          </article>
          <aside class="internal-ai-card"><div class="internal-ai-heading"><div><p class="internal-ai-kicker">Current task</p><h2 data-task-title>No active task</h2></div><span class="internal-ai-status" data-task-status>Idle</span></div><dl class="internal-ai-details"><div><dt>Role</dt><dd>Software Engineer</dd></div><div><dt>Phase</dt><dd data-task-phase>Ready</dd></div><div><dt>Started</dt><dd data-task-started>—</dd></div><div><dt>Branch</dt><dd data-task-branch>—</dd></div></dl><div class="internal-ai-actions"><a class="hidden" data-pr-link href="#" target="_blank" rel="noopener"><ExternalLink size={15} /> Open PR</a><button class="hidden cancel" type="button" data-stop><CircleStop size={15} /> Cancel task</button></div></aside>
        </section>
        <section class="internal-ai-card"><div class="internal-ai-heading"><div><p class="internal-ai-kicker">Activity</p><h2>Sanitized events</h2></div><span data-event-count>0 events</span></div><div class="internal-ai-events" data-events><p>No activity yet.</p></div></section>
        <section class="internal-ai-grid"><article class="internal-ai-card"><p class="internal-ai-kicker">Result</p><h2>Evidence</h2><p data-result>Task results, branch, pull request and safe evidence will appear here.</p></article><article class="internal-ai-card needs-approval"><p class="internal-ai-kicker">Needs approval</p><h2 data-approval-title>No approval needed</h2><p data-approval-copy>Only consequential AGENTS.md gates appear here: deletion, credentials, merge/deploy, permissions, external communication, legal, destructive database change, scope expansion, or unresolved evidence.</p></article></section>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
<script>
  type Task = { id:string; agent_role:string; prompt:string; status:string; started_at?:string|null; branch?:string|null; pr_url?:string|null; output_summary?:string|null; approval_gate?:string|null; cancel_requested?:boolean };
  type Event = { id:number; event_type:string; message:string; created_at:string };
  const $ = <T extends HTMLElement = HTMLElement>(s:string) => document.querySelector<T>(s); let active:Task|null=null; let refreshTimer:number|undefined;
  const text=(s:string,v:string)=>{const node=$(s);if(node)node.textContent=v}; const date=(v?:string|null)=>v?new Date(v).toLocaleString():"—";
  function alert(message:string,kind="error"){const node=$("[data-task-alert]");if(!node)return;node.textContent=message;node.className=`internal-ai-alert ${kind}`}
  async function api(path:string,init?:RequestInit){const response=await fetch(path,{credentials:"same-origin",...init,headers:{"Content-Type":"application/json",...(init?.headers||{})}});let data:any={};try{data=await response.json()}catch{}return{response,data}}
  function renderEvents(events:Event[]){const list=$("[data-events]");if(!list)return;list.replaceChildren();text("[data-event-count]",`${events.length} ${events.length===1?"event":"events"}`);if(!events.length){list.textContent="No activity yet.";return}for(const event of events){const row=document.createElement("article"), meta=document.createElement("strong"), time=document.createElement("time"), body=document.createElement("pre");meta.textContent=event.event_type;time.textContent=date(event.created_at);body.textContent=event.message;row.append(meta,time,body);list.append(row)}}
  function renderTask(task:Task|null){active=task;text("[data-task-title]",task?"Software Engineer":"No active task");text("[data-task-status]",task?.status?.replaceAll("_"," ")||"Idle");text("[data-task-phase]",task?.status||"Ready");text("[data-task-started]",date(task?.started_at));text("[data-task-branch]",task?.branch||"—");text("[data-result]",task?.output_summary||"Task results, branch, pull request and safe evidence will appear here.");const gate=task?.approval_gate;text("[data-approval-title]",gate?`Approval required: ${gate.replaceAll("_"," ")}`:"No approval needed");text("[data-approval-copy]",gate?"This task has stopped at a real consequential owner gate. Review the evidence before acting.":"Only consequential AGENTS.md gates appear here: deletion, credentials, merge/deploy, permissions, external communication, legal, destructive database change, scope expansion, or unresolved evidence.");const pr=$<HTMLAnchorElement>("[data-pr-link]");if(pr){pr.classList.toggle("hidden",!task?.pr_url);if(task?.pr_url)pr.href=task.pr_url}$("[data-stop]")?.classList.toggle("hidden",!task||!["queued","running","needs_approval"].includes(task.status));}
  async function loadTask(id:string){const {response,data}=await api(`/api/internal-ai/tasks/${encodeURIComponent(id)}`);if(response.ok&&data.success){renderTask(data.task);renderEvents(data.events||[])}}
  function lock(title:string,copy:string){text("[data-access-title]",title);text("[data-access-copy]",copy);$("[data-access-state]")?.classList.remove("hidden");$("[data-ai-content]")?.classList.add("hidden")}
  async function refresh(){const {response,data}=await api("/api/internal-ai/status");if(response.status===401)return lock("Sign in required","Use your Hermes Connect account, then reopen this internal route.");if(response.status===403)return lock("Internal owner capability required","Repair Shop and ordinary Hermes Connect accounts cannot access internal AI tasks.");if(!response.ok||!data.success)return lock("AI Assistant is unavailable",String(data.error||"runtime_unavailable"));$("[data-access-state]")?.classList.add("hidden");$("[data-ai-content]")?.classList.remove("hidden");text("[data-runner-state]",data.runtime?.online?"Runner online":"Runner not connected");const task=data.active_task||data.latest_task||null;renderTask(task);if(task?.id)await loadTask(task.id)}
  $<HTMLButtonElement>("[data-run]")?.addEventListener("click",async()=>{const prompt=$<HTMLTextAreaElement>("[data-task-prompt]")?.value.trim()||"";if(!prompt)return alert("Describe a bounded task first.");const {response,data}=await api("/api/internal-ai/tasks",{method:"POST",body:JSON.stringify({prompt})});if(!response.ok||!data.success)return alert(data.error||"Unable to create task.");alert("Task queued for the internal runner.","success");renderTask(data.task);await refresh()});
  $<HTMLButtonElement>("[data-stop]")?.addEventListener("click",async()=>{if(!active)return;const {response,data}=await api(`/api/internal-ai/tasks/${encodeURIComponent(active.id)}`,{method:"PATCH",body:JSON.stringify({action:"cancel"})});if(!response.ok||!data.success)return alert(data.error||"Unable to cancel task.");alert("Cancellation requested.","success");renderTask(data.task)});
  void refresh();refreshTimer=window.setInterval(()=>void refresh(),8000);window.addEventListener("pagehide",()=>{if(refreshTimer)window.clearInterval(refreshTimer)},{once:true});
</script>
<style>
.internal-ai-page{min-height:76vh;background:#090d16;color:#edf2fb}.internal-ai-shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:3rem 0 5rem}.internal-ai-hero{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.5rem}.internal-ai-hero h1{font-size:clamp(2.2rem,5vw,4rem);margin:.3rem 0 .75rem}.internal-ai-hero p{max-width:720px;color:#b9c5d8;line-height:1.6}.internal-ai-kicker{display:flex;gap:.4rem;align-items:center;margin:0;color:#a99aff;font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.internal-ai-badge,.internal-ai-status{white-space:nowrap;border:1px solid rgba(96,165,250,.32);border-radius:999px;padding:.5rem .72rem;color:#dceaff;background:rgba(96,165,250,.1);font-size:.78rem;font-weight:750}.internal-ai-state,.internal-ai-card{border:1px solid rgba(255,255,255,.11);border-radius:1.25rem;background:rgba(17,24,39,.82);box-shadow:0 18px 40px rgba(0,0,0,.18)}.internal-ai-state{padding:1.2rem}.internal-ai-state p{margin:.35rem 0 0;color:#b9c5d8}.hidden{display:none!important}.internal-ai-content{display:grid;gap:1rem}.internal-ai-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem}.internal-ai-card{padding:1.25rem}.internal-ai-heading{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.internal-ai-card h2{margin:.35rem 0 .7rem;font-size:1.2rem}.internal-ai-composer label{display:grid;gap:.5rem;font-weight:700}.internal-ai-composer textarea{width:100%;box-sizing:border-box;resize:vertical;margin-top:.5rem;border-radius:.8rem;border:1px solid rgba(255,255,255,.15);padding:.85rem;background:#070b13;color:#fff;font:inherit;line-height:1.5}.internal-ai-composer-footer,.internal-ai-actions{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:.85rem}.internal-ai-composer-footer p,.internal-ai-card>p{color:#b9c5d8;line-height:1.5}.internal-ai-composer button,.internal-ai-actions a,.internal-ai-actions button{display:inline-flex;align-items:center;gap:.45rem;border:0;border-radius:.7rem;padding:.7rem .9rem;font:inherit;font-weight:800;text-decoration:none;color:#07101c;background:#8bdbff;cursor:pointer}.internal-ai-actions .cancel{background:rgba(255,255,255,.1);color:#fff}.internal-ai-alert{margin:.75rem 0 0;padding:.7rem;border-radius:.6rem;background:rgba(248,113,113,.15);color:#fecaca}.internal-ai-alert.success{background:rgba(52,211,153,.12);color:#bbf7d0}.internal-ai-details{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin:1rem 0}.internal-ai-details div{min-width:0}.internal-ai-details dt{color:#9eabc0;font-size:.75rem}.internal-ai-details dd{margin:.2rem 0 0;overflow-wrap:anywhere}.internal-ai-events{display:grid;gap:.7rem;max-height:24rem;overflow:auto}.internal-ai-events>p{color:#b9c5d8}.internal-ai-events article{padding:.75rem;border-radius:.75rem;background:rgba(255,255,255,.045)}.internal-ai-events time{display:block;margin-top:.2rem;color:#9eabc0;font-size:.75rem}.internal-ai-events pre{margin:.55rem 0 0;white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;color:#dce5f4}.needs-approval{border-color:rgba(251,191,36,.28)}@media(max-width:700px){.internal-ai-shell{padding-top:2rem}.internal-ai-hero,.internal-ai-composer-footer,.internal-ai-actions{align-items:stretch;flex-direction:column}.internal-ai-grid{grid-template-columns:1fr}.internal-ai-badge{white-space:normal}.internal-ai-composer button{justify-content:center}.internal-ai-details{grid-template-columns:1fr}}
</style>
