---
import { CircleStop, ExternalLink, Send, ShieldCheck, Sparkles } from "@lucide/astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../components/SiteFooter.astro";
import HermesConnectExperience from "../../../../../components/HermesConnectExperience.astro";
import HermesConnectAccountSwitcher from "../../../../../components/HermesConnectAccountSwitcher.astro";

const isRu = Astro.url.searchParams.get("lang") === "ru";
const c = isRu ? {
  title: "AI Assistant | Hermes Connect", description: "Приватный внутренний AI Assistant Hermes Connect.", kicker: "Hermes Connect · внутренняя capability", intro: "Поставьте одну ограниченную задачу внутреннему Hermes runner. Задачи создают evidence и проверяемую работу; они не дают разрешение на deploy или другие значимые действия.", ownerOnly: "Только внутренний владелец", checking: "Проверяем внутренний доступ…", checkingCopy: "Даже действующая сессия Hermes Connect требует отдельной capability внутреннего владельца.", ask: "Задание для AI", engineer: "Software Engineer", runnerUnknown: "Статус runner неизвестен", promptLabel: "Что должен сделать Hermes Codex?", promptPlaceholder: "Опишите одну ограниченную задачу. Runner следует AGENTS.md и останавливается на значимых owner-gates.", promptNote: "Текст задачи передаётся как входные данные и никогда не выполняется как shell-команда.", start: "Запустить задачу", currentTask: "Текущая задача", noTask: "Нет активной задачи", idle: "Ожидание", role: "Роль", phase: "Этап", ready: "Готово", started: "Запущено", branch: "Ветка", openPr: "Открыть PR", cancel: "Отменить задачу", activity: "Активность", events: "Очищенные события", noActivity: "Активности пока нет.", result: "Результат", evidence: "Evidence", resultCopy: "Здесь появятся результаты задачи, ветка, pull request и безопасные evidence.", needsApproval: "Нужно подтверждение", noApproval: "Подтверждение не требуется", approvalCopy: "Здесь появляются только значимые gates из AGENTS.md: удаление, credentials, merge/deploy, права, внешняя коммуникация, legal, destructive database changes, расширение scope или нерешённые evidence.",
} : {
  title: "AI Assistant | Hermes Connect", description: "Private internal Hermes Connect AI Assistant.", kicker: "Hermes Connect · Internal capability", intro: "Give one bounded software task to the internal Hermes runner. Tasks create evidence and reviewable work; they never authorize deployment or other consequential actions.", ownerOnly: "Internal owner only", checking: "Checking internal access…", checkingCopy: "Valid Hermes Connect sessions still require the separate internal owner capability.", ask: "Ask AI", engineer: "Software Engineer", runnerUnknown: "Runner status unknown", promptLabel: "What should Hermes Codex do?", promptPlaceholder: "Describe one bounded task. The runner follows AGENTS.md and stops at consequential owner gates.", promptNote: "Task text is passed as input, never executed as a shell command.", start: "Start task", currentTask: "Current task", noTask: "No active task", idle: "Idle", role: "Role", phase: "Phase", ready: "Ready", started: "Started", branch: "Branch", openPr: "Open PR", cancel: "Cancel task", activity: "Activity", events: "Sanitized events", noActivity: "No activity yet.", result: "Result", evidence: "Evidence", resultCopy: "Task results, branch, pull request and safe evidence will appear here.", needsApproval: "Needs approval", noApproval: "No approval needed", approvalCopy: "Only consequential AGENTS.md gates appear here: deletion, credentials, merge/deploy, permissions, external communication, legal, destructive database change, scope expansion, or unresolved evidence.",
};
---
<BaseLayout title={c.title} description={c.description} robots="noindex,nofollow">
  <SiteHeader activePath="/paths/technology/" />
  <HermesConnectExperience />
  <main id="main-content" class="internal-ai-page">
    <div class="internal-ai-shell">
      <header class="internal-ai-hero">
        <div><p class="internal-ai-kicker"><Sparkles size={15} /> {c.kicker}</p><h1>AI Assistant</h1><p>{c.intro}</p></div>
        <span class="internal-ai-badge"><ShieldCheck size={16} /> {c.ownerOnly}</span>
      </header>

      <HermesConnectAccountSwitcher current="ai" />

      <section class="internal-ai-state" data-access-state role="status"><strong data-access-title>{c.checking}</strong><p data-access-copy>{c.checkingCopy}</p></section>
      <div class="internal-ai-content hidden" data-ai-content>
        <section class="internal-ai-grid">
          <article class="internal-ai-card internal-ai-composer"><div class="internal-ai-heading"><div><p class="internal-ai-kicker">{c.ask}</p><h2>{c.engineer}</h2></div><span data-runner-state>{c.runnerUnknown}</span></div>
            <label for="internal-ai-prompt">{c.promptLabel}<textarea id="internal-ai-prompt" data-task-prompt maxlength="12000" rows="8" placeholder={c.promptPlaceholder}></textarea></label>
            <div class="internal-ai-composer-footer"><p>{c.promptNote}</p><button type="button" data-run><Send size={16} /> {c.start}</button></div><p class="internal-ai-alert hidden" data-task-alert role="status"></p>
          </article>
          <aside class="internal-ai-card"><div class="internal-ai-heading"><div><p class="internal-ai-kicker">{c.currentTask}</p><h2 data-task-title>{c.noTask}</h2></div><span class="internal-ai-status" data-task-status>{c.idle}</span></div><dl class="internal-ai-details"><div><dt>{c.role}</dt><dd>Software Engineer</dd></div><div><dt>{c.phase}</dt><dd data-task-phase>{c.ready}</dd></div><div><dt>{c.started}</dt><dd data-task-started>—</dd></div><div><dt>{c.branch}</dt><dd data-task-branch>—</dd></div></dl><div class="internal-ai-actions"><a class="hidden" data-pr-link href="#" target="_blank" rel="noopener"><ExternalLink size={15} /> {c.openPr}</a><button class="hidden cancel" type="button" data-stop><CircleStop size={15} /> {c.cancel}</button></div></aside>
        </section>
        <section class="internal-ai-card"><div class="internal-ai-heading"><div><p class="internal-ai-kicker">{c.activity}</p><h2>{c.events}</h2></div><span data-event-count>0</span></div><div class="internal-ai-events" data-events><p>{c.noActivity}</p></div></section>
        <section class="internal-ai-grid"><article class="internal-ai-card"><p class="internal-ai-kicker">{c.result}</p><h2>{c.evidence}</h2><p data-result>{c.resultCopy}</p></article><article class="internal-ai-card needs-approval"><p class="internal-ai-kicker">{c.needsApproval}</p><h2 data-approval-title>{c.noApproval}</h2><p data-approval-copy>{c.approvalCopy}</p></article></section>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
<script>
  type Task = { id:string; agent_role:string; prompt:string; status:string; started_at?:string|null; branch?:string|null; pr_url?:string|null; output_summary?:string|null; approval_gate?:string|null; cancel_requested?:boolean };
  type Event = { id:number; event_type:string; message:string; created_at:string };
  const $ = <T extends HTMLElement = HTMLElement>(s:string) => document.querySelector<T>(s); let active:Task|null=null; let refreshTimer:number|undefined;
  const ru = new URLSearchParams(window.location.search).get("lang") === "ru";
  const ui = ru ? {
    noTask:"Нет активной задачи", idle:"Ожидание", ready:"Готово", result:"Здесь появятся результаты задачи, ветка, pull request и безопасные evidence.", noApproval:"Подтверждение не требуется", approvalDefault:"Здесь появляются только значимые gates из AGENTS.md: удаление, credentials, merge/deploy, права, внешняя коммуникация, legal, destructive database changes, расширение scope или нерешённые evidence.", approvalRequired:"Требуется подтверждение", approvalCopy:"Задача остановлена на значимом owner-gate. Проверьте evidence перед действием.", eventOne:"событие", eventMany:"событий", noActivity:"Активности пока нет.", signIn:"Требуется вход", signInCopy:"Войдите в аккаунт Hermes Connect и снова откройте этот внутренний раздел.", owner:"Нужны права внутреннего владельца", ownerCopy:"Аккаунты СТО и обычные Hermes Connect-аккаунты не имеют доступа к внутренним AI-задачам.", unavailable:"AI Assistant недоступен", runnerOnline:"Runner в сети", runnerOffline:"Runner не подключён", describe:"Сначала опишите ограниченную задачу.", createError:"Не удалось создать задачу.", queued:"Задача поставлена во внутреннюю очередь runner.", cancelError:"Не удалось отменить задачу.", cancelRequested:"Запрос на отмену отправлен.", taskTitle:"Software Engineer",
  } : {
    noTask:"No active task", idle:"Idle", ready:"Ready", result:"Task results, branch, pull request and safe evidence will appear here.", noApproval:"No approval needed", approvalDefault:"Only consequential AGENTS.md gates appear here: deletion, credentials, merge/deploy, permissions, external communication, legal, destructive database change, scope expansion, or unresolved evidence.", approvalRequired:"Approval required", approvalCopy:"This task has stopped at a real consequential owner gate. Review the evidence before acting.", eventOne:"event", eventMany:"events", noActivity:"No activity yet.", signIn:"Sign in required", signInCopy:"Use your Hermes Connect account, then reopen this internal route.", owner:"Internal owner capability required", ownerCopy:"Repair Shop and ordinary Hermes Connect accounts cannot access internal AI tasks.", unavailable:"AI Assistant is unavailable", runnerOnline:"Runner online", runnerOffline:"Runner not connected", describe:"Describe a bounded task first.", createError:"Unable to create task.", queued:"Task queued for the internal runner.", cancelError:"Unable to cancel task.", cancelRequested:"Cancellation requested.", taskTitle:"Software Engineer",
  };
  const text=(s:string,v:string)=>{const node=$(s);if(node)node.textContent=v}; const date=(v?:string|null)=>v?new Date(v).toLocaleString(ru?"ru-RU":undefined):"—";
  function alert(message:string,kind="error"){const node=$("[data-task-alert]");if(!node)return;node.textContent=message;node.className=`internal-ai-alert ${kind}`}
  async function api(path:string,init?:RequestInit){const response=await fetch(path,{credentials:"same-origin",...init,headers:{"Content-Type":"application/json",...(init?.headers||{})}});let data:any={};try{data=await response.json()}catch{}return{response,data}}
  function renderEvents(events:Event[]){const list=$("[data-events]");if(!list)return;list.replaceChildren();text("[data-event-count]",`${events.length} ${events.length===1?ui.eventOne:ui.eventMany}`);if(!events.length){list.textContent=ui.noActivity;return}for(const event of events){const row=document.createElement("article"), meta=document.createElement("strong"), time=document.createElement("time"), body=document.createElement("pre");meta.textContent=event.event_type;time.textContent=date(event.created_at);body.textContent=event.message;row.append(meta,time,body);list.append(row)}}
  function renderTask(task:Task|null){active=task;text("[data-task-title]",task?ui.taskTitle:ui.noTask);text("[data-task-status]",task?.status?.replaceAll("_"," ")||ui.idle);text("[data-task-phase]",task?.status||ui.ready);text("[data-task-started]",date(task?.started_at));text("[data-task-branch]",task?.branch||"—");text("[data-result]",task?.output_summary||ui.result);const gate=task?.approval_gate;text("[data-approval-title]",gate?`${ui.approvalRequired}: ${gate.replaceAll("_"," ")}`:ui.noApproval);text("[data-approval-copy]",gate?ui.approvalCopy:ui.approvalDefault);const pr=$<HTMLAnchorElement>("[data-pr-link]");if(pr){pr.classList.toggle("hidden",!task?.pr_url);if(task?.pr_url)pr.href=task.pr_url}$("[data-stop]")?.classList.toggle("hidden",!task||!["queued","running","needs_approval"].includes(task.status));}
  async function loadTask(id:string){const {response,data}=await api(`/api/internal-ai/tasks/${encodeURIComponent(id)}`);if(response.ok&&data.success){renderTask(data.task);renderEvents(data.events||[])}}
  function lock(title:string,copy:string){text("[data-access-title]",title);text("[data-access-copy]",copy);$("[data-access-state]")?.classList.remove("hidden");$("[data-ai-content]")?.classList.add("hidden")}
  async function refresh(){const {response,data}=await api("/api/internal-ai/status");if(response.status===401)return lock(ui.signIn,ui.signInCopy);if(response.status===403)return lock(ui.owner,ui.ownerCopy);if(!response.ok||!data.success)return lock(ui.unavailable,String(data.error||"runtime_unavailable"));$("[data-access-state]")?.classList.add("hidden");$("[data-ai-content]")?.classList.remove("hidden");text("[data-runner-state]",data.runtime?.online?ui.runnerOnline:ui.runnerOffline);const task=data.active_task||data.latest_task||null;renderTask(task);if(task?.id)await loadTask(task.id)}
  $<HTMLButtonElement>("[data-run]")?.addEventListener("click",async()=>{const prompt=$<HTMLTextAreaElement>("[data-task-prompt]")?.value.trim()||"";if(!prompt)return alert(ui.describe);const {response,data}=await api("/api/internal-ai/tasks",{method:"POST",body:JSON.stringify({prompt})});if(!response.ok||!data.success)return alert(data.error||ui.createError);alert(ui.queued,"success");renderTask(data.task);await refresh()});
  $<HTMLButtonElement>("[data-stop]")?.addEventListener("click",async()=>{if(!active)return;const {response,data}=await api(`/api/internal-ai/tasks/${encodeURIComponent(active.id)}`,{method:"PATCH",body:JSON.stringify({action:"cancel"})});if(!response.ok||!data.success)return alert(data.error||ui.cancelError);alert(ui.cancelRequested,"success");renderTask(data.task)});
  void refresh();refreshTimer=window.setInterval(()=>void refresh(),8000);window.addEventListener("pagehide",()=>{if(refreshTimer)window.clearInterval(refreshTimer)},{once:true});
</script>
<style>
.internal-ai-page{min-height:76vh;background:radial-gradient(circle at 10% 4%,rgba(255,122,0,.08),transparent 28rem),radial-gradient(circle at 88% 10%,rgba(124,92,255,.06),transparent 30rem),#f7f6f3;color:#11161f}.internal-ai-shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:3rem 0 5rem}.internal-ai-hero{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin-bottom:1.5rem}.internal-ai-hero h1{font-size:clamp(2.2rem,5vw,4rem);margin:.3rem 0 .75rem}.internal-ai-hero p{max-width:720px;color:#657083;line-height:1.6}.internal-ai-kicker{display:flex;gap:.4rem;align-items:center;margin:0;color:#d76500;font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.internal-ai-badge,.internal-ai-status{white-space:nowrap;border:1px solid rgba(255,122,0,.22);border-radius:999px;padding:.5rem .72rem;color:#9a4900;background:rgba(255,122,0,.08);font-size:.78rem;font-weight:750}.internal-ai-state,.internal-ai-card{border:1px solid rgba(17,22,31,.1);border-radius:1.25rem;background:rgba(255,255,255,.86);box-shadow:0 18px 40px rgba(24,32,48,.08)}.internal-ai-state{padding:1.2rem}.internal-ai-state p{margin:.35rem 0 0;color:#657083}.hidden{display:none!important}.internal-ai-content{display:grid;gap:1rem}.internal-ai-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem}.internal-ai-card{padding:1.25rem}.internal-ai-heading{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.internal-ai-card h2{margin:.35rem 0 .7rem;font-size:1.2rem}.internal-ai-composer label{display:grid;gap:.5rem;font-weight:700}.internal-ai-composer textarea{width:100%;box-sizing:border-box;resize:vertical;margin-top:.5rem;border-radius:.8rem;border:1px solid rgba(17,22,31,.14);padding:.85rem;background:#fff;color:#11161f;font:inherit;line-height:1.5;box-shadow:inset 0 1px 2px rgba(24,32,48,.04)}.internal-ai-composer-footer,.internal-ai-actions{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:.85rem}.internal-ai-composer-footer p,.internal-ai-card>p{color:#657083;line-height:1.5}.internal-ai-composer button,.internal-ai-actions a,.internal-ai-actions button{display:inline-flex;align-items:center;gap:.45rem;border:0;border-radius:.7rem;padding:.7rem .9rem;font:inherit;font-weight:800;text-decoration:none;color:#fff;background:#11161f;cursor:pointer}.internal-ai-actions .cancel{background:#eef0f3;color:#11161f}.internal-ai-alert{margin:.75rem 0 0;padding:.7rem;border-radius:.6rem;background:rgba(220,38,38,.08);color:#a61b1b}.internal-ai-alert.success{background:rgba(22,163,74,.08);color:#176b36}.internal-ai-details{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin:1rem 0}.internal-ai-details div{min-width:0}.internal-ai-details dt{color:#7a8595;font-size:.75rem}.internal-ai-details dd{margin:.2rem 0 0;overflow-wrap:anywhere}.internal-ai-events{display:grid;gap:.7rem;max-height:24rem;overflow:auto}.internal-ai-events>p{color:#657083}.internal-ai-events article{padding:.75rem;border-radius:.75rem;background:#f4f5f7}.internal-ai-events time{display:block;margin-top:.2rem;color:#7a8595;font-size:.75rem}.internal-ai-events pre{margin:.55rem 0 0;white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;color:#313946}.needs-approval{border-color:rgba(217,119,6,.24);background:linear-gradient(180deg,rgba(255,247,237,.9),rgba(255,255,255,.9))}@media(max-width:700px){.internal-ai-shell{padding-top:2rem}.internal-ai-hero,.internal-ai-composer-footer,.internal-ai-actions{align-items:stretch;flex-direction:column}.internal-ai-grid{grid-template-columns:1fr}.internal-ai-badge{white-space:normal}.internal-ai-composer button{justify-content:center}.internal-ai-details{grid-template-columns:1fr}}
</style>