---
import HermesConnectCapabilityPage from "../../../components/HermesConnectCapabilityPage.astro";

const faqs = [
  {
    question: "Are all previously listed industry verticals live in Hermes Connect?",
    answer: "No. Business Automation is a reference capability. Repair Shops is the most mature current vertical; other vertical workflows require separate verification before they are described as live products.",
  },
  {
    question: "What is the intended product-family role of Business Automation?",
    answer: "It is intended to provide reusable intake and workflow patterns that can be adapted by verified Hermes Connect verticals without creating separate disconnected products.",
  },
];

const capabilities = [
  { title: "Reusable intake patterns", body: "Share common request, qualification, and workflow primitives across verified verticals instead of maintaining separate product forks." },
  { title: "Vertical terminology", body: "Adapt labels and required fields only after a vertical's real operating needs and data contracts are verified." },
  { title: "Controlled integrations", body: "Treat webhooks, external CRM/ERP connections, and automated actions as unavailable until each production integration is explicitly validated." },
];
---

<HermesConnectCapabilityPage
  name="Business Automation"
  pageTitle="Business Automation Reference Capability | Hermes Connect"
  description="Reference documentation for reusable Hermes Connect business-automation patterns. Repair Shops is the most mature current vertical; this page does not claim verified live availability."
  canonicalUrl="https://hermeslogisticsus.com/services/hermes-connect/business-automation/"
  lead="A product-family architecture concept for reusing intake, qualification, and workflow primitives across verified business verticals without creating disconnected Hermes Connect products."
  capabilities={capabilities}
  boundary="Logistics, real estate, beauty, fitness, agency, and other historical vertical claims are not treated as current live Hermes Connect products. Complex webhook, CRM, and ERP integrations are also not claimed until verified in production."
  faqs={faqs}
/>
