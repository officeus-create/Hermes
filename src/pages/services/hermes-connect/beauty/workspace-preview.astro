---
import {
  ArrowLeft,
  Building2,
  Check,
  ChevronRight,
  Globe2,
  MapPin,
  Settings2,
  Sparkles,
  Users,
} from "@lucide/astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="CEO Preview · Beauty Owner Workspace | Hermes Connect"
  description="CEO visual preview for the Hermes Connect Beauty B1 salon owner workspace. Representative data only."
  robots="noindex,nofollow,noarchive"
>
  <main id="main-content" class="beauty-preview">
    <div class="truth-bar">
      <span></span>
      CEO PREVIEW · REPRESENTATIVE DATA · NO LIVE SALON METRICS · NOT PRODUCTION
    </div>

    <div class="app-shell">
      <aside class="sidebar" aria-label="Beauty owner preview navigation">
        <a class="brand" href="#overview" aria-label="Hermes Connect Beauty Owner Workspace">
          <span class="brand-mark">H</span>
          <span><strong>Hermes Connect</strong><small>Beauty Owner OS · B1</small></span>
        </a>

        <div class="workspace-card">
          <span>Workspace</span>
          <strong>Aurelia Studio</strong>
          <small>Miami, FL · Owner preview</small>
        </div>

        <nav>
          <a href="#overview" aria-current="page"><Sparkles />Overview</a>
          <a href="#profile"><Building2 />Salon profile</a>
          <a href="#team"><Users />Team</a>
          <a href="#context"><Globe2 />Service context</a>
          <a href="#settings"><Settings2 />Settings</a>
        </nav>

        <div class="sidebar-note">
          <strong>B1 boundary</strong>
          <p>Profile + team + shared service context only. Appointments, payments and clinical data are not part of this preview.</p>
        </div>
      </aside>

      <div class="mobile-head">
        <div class="brand"><span class="brand-mark">H</span><span><strong>Hermes Connect</strong><small>Beauty Owner OS</small></span></div>
        <span class="preview-chip">B1 Preview</span>
      </div>

      <nav class="mobile-nav" aria-label="Beauty owner mobile preview navigation">
        <a href="#overview">Overview</a>
        <a href="#profile">Profile</a>
        <a href="#team">Team</a>
        <a href="#context">Context</a>
      </nav>

      <section class="workspace" id="overview">
        <header class="topbar">
          <div>
            <a class="back" href="/services/hermes-connect/"><ArrowLeft />Hermes Connect</a>
            <p class="eyebrow">BEAUTY OWNER OS · B1 CEO PREVIEW</p>
            <h1>Your salon foundation, in one calm workspace.</h1>
            <p class="lead">The B1 owner surface is intentionally narrow: establish the business, verify location and timezone, add the team, and connect the salon to the shared Hermes Connect service model.</p>
          </div>
          <span class="preview-chip">Representative data</span>
        </header>

        <section class="intelligence-card" aria-labelledby="owner-focus-title">
          <div>
            <small>HERMES INTELLIGENCE · B1 READINESS</small>
            <h2 id="owner-focus-title">Finish the operating foundation before adding growth modules.</h2>
            <p>The preview does not invent appointments, revenue, utilization or customer demand. Those surfaces stay hidden until their real data models exist.</p>
          </div>
          <div class="readiness">
            <span><Check />Salon profile structure</span>
            <span><Check />Owner-scoped team foundation</span>
            <span><Check />Shared service context</span>
          </div>
        </section>

        <div class="grid-two">
          <section class="panel" id="profile" aria-labelledby="profile-title">
            <div class="panel-head">
              <div><p class="panel-kicker">OWNER-SCOPED · REPRESENTATIVE</p><h2 id="profile-title">Salon profile</h2></div>
              <span class="status-chip">Preview</span>
            </div>

            <div class="profile-summary">
              <span class="salon-mark">AS</span>
              <div><strong>Aurelia Studio</strong><small><MapPin />Miami, Florida · America/New_York</small></div>
            </div>

            <div class="field-grid" aria-label="Representative Beauty B1 profile fields">
              <label><span>Salon name</span><input value="Aurelia Studio" readonly /></label>
              <label><span>Phone</span><input value="+1 305 555 0148" readonly /></label>
              <label class="wide"><span>Website</span><input value="https://example.com" readonly /></label>
              <label><span>City</span><input value="Miami" readonly /></label>
              <label><span>Region</span><input value="Florida" readonly /></label>
              <label><span>Country</span><input value="US" readonly /></label>
              <label><span>Timezone</span><input value="America/New_York" readonly /></label>
            </div>
            <p class="data-note">Fields mirror the existing canonical Beauty B1 profile API. This preview does not write data.</p>
          </section>

          <section class="panel" id="team" aria-labelledby="team-title">
            <div class="panel-head">
              <div><p class="panel-kicker">TEAM FOUNDATION · REPRESENTATIVE</p><h2 id="team-title">People in this salon</h2></div>
              <span class="status-chip">2 sample members</span>
            </div>

            <div class="team-list">
              <article>
                <span class="avatar">LM</span>
                <div><strong>Leah Morgan</strong><small>Studio Manager · Public title: Studio Manager</small></div>
                <em>Public</em>
              </article>
              <article>
                <span class="avatar">SP</span>
                <div><strong>Sofia Park</strong><small>Beauty Specialist · Public title: Senior Specialist</small></div>
                <em>Public</em>
              </article>
            </div>

            <div class="team-rule">
              <Users />
              <div><strong>Team members are business-domain people, not Hermes login identities.</strong><p>B1 keeps owner authentication separate from team roster data and does not create extra credentials.</p></div>
            </div>
          </section>
        </div>

        <section class="panel context-panel" id="context" aria-labelledby="context-title">
          <div class="panel-head">
            <div><p class="panel-kicker">ONE PRODUCT · SHARED CONTEXT</p><h2 id="context-title">Beauty uses the canonical Hermes Connect service model.</h2></div>
            <span class="status-chip is-ready"><Check />Architecture ready</span>
          </div>
          <div class="context-flow">
            <div><small>Identity</small><strong>Existing Hermes session</strong><span>One owner login</span></div>
            <ChevronRight />
            <div><small>Business</small><strong>Beauty salon</strong><span>Owner-scoped profile</span></div>
            <ChevronRight />
            <div><small>Service context</small><strong>beauty_salon</strong><span>Shared services model</span></div>
          </div>
        </section>

        <section class="future-boundary" id="settings" aria-labelledby="future-title">
          <div>
            <p class="panel-kicker">DO NOT CLAIM YET</p>
            <h2 id="future-title">Modules intentionally outside Beauty B1</h2>
            <p>These can be designed only when their canonical data model and release evidence exist.</p>
          </div>
          <div class="future-list">
            <span>Appointments · deferred</span>
            <span>Customer CRM · deferred</span>
            <span>Payments · deferred</span>
            <span>Revenue metrics · no evidence</span>
            <span>Clinical / medical data · excluded</span>
          </div>
        </section>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .beauty-preview{min-height:100vh;background:#f4f1ec;color:#11131a}.truth-bar{position:fixed;z-index:80;top:0;left:0;right:0;display:flex;justify-content:center;align-items:center;gap:8px;min-height:30px;padding:5px 16px;background:#11131a;color:#d7d3cb;font:700 10px/1.3 var(--font-mono);letter-spacing:.08em}.truth-bar span{width:7px;height:7px;border-radius:50%;background:#9d88ff}.app-shell{display:grid;grid-template-columns:255px minmax(0,1fr);min-height:100vh;padding-top:30px}.sidebar{position:sticky;top:30px;display:flex;flex-direction:column;height:calc(100vh - 30px);padding:20px 16px;background:#11131a;color:#f8f6f2;border-right:1px solid rgba(255,255,255,.07)}.brand{display:flex;align-items:center;gap:10px;text-decoration:none}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#7c5cff,#5ac8fa);color:white;font:800 15px var(--font-display)}.brand>span:last-child{display:grid}.brand strong{font:750 13px var(--font-display)}.brand small{color:#8f96a5;font-size:9px}.workspace-card{display:grid;gap:4px;margin:24px 0 16px;padding:13px;border:1px solid rgba(255,255,255,.08);border-radius:14px;background:rgba(255,255,255,.035)}.workspace-card span,.workspace-card small{color:#838b9a;font-size:9px}.workspace-card strong{font-size:12px}.sidebar nav{display:grid;gap:3px}.sidebar nav a{display:flex;align-items:center;gap:9px;min-height:40px;padding:8px 10px;border-radius:10px;color:#aeb4c0;text-decoration:none;font-size:11px;font-weight:700}.sidebar nav a svg{width:15px}.sidebar nav a:hover,.sidebar nav a:focus-visible,.sidebar nav a[aria-current="page"]{background:rgba(124,92,255,.13);color:#fff;outline:2px solid transparent}.sidebar-note{margin-top:auto;padding:14px;border-radius:14px;background:rgba(124,92,255,.08);border:1px solid rgba(157,136,255,.12)}.sidebar-note strong{font-size:11px}.sidebar-note p{margin:7px 0 0;color:#949cab;font-size:9px;line-height:1.55}.workspace{min-width:0;padding:54px clamp(20px,4vw,54px) 70px}.topbar{display:flex;justify-content:space-between;gap:30px;align-items:flex-start;max-width:1180px;margin:0 auto 24px}.back{display:inline-flex;align-items:center;gap:6px;margin-bottom:26px;color:#656b75;text-decoration:none;font-size:11px;font-weight:750}.back svg{width:14px}.eyebrow,.panel-kicker{margin:0 0 7px;color:#785ce6;font:800 9px/1.3 var(--font-mono);letter-spacing:.12em}.topbar h1{max-width:740px;margin:0 0 12px;font:750 clamp(34px,4.6vw,64px)/.98 var(--font-display);letter-spacing:-.045em}.lead{max-width:760px;margin:0;color:#656b75;font-size:14px;line-height:1.65}.preview-chip,.status-chip{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;padding:7px 9px;border:1px solid rgba(17,19,26,.1);border-radius:999px;background:#fff;color:#5f6470;font-size:9px;font-weight:800}.status-chip.is-ready{background:#eef9f2;color:#2f7d4c;border-color:#cce8d6}.status-chip svg{width:12px}.intelligence-card,.panel,.future-boundary{max-width:1180px;margin:0 auto;border:1px solid rgba(17,19,26,.08);border-radius:20px;background:rgba(255,255,255,.82);box-shadow:0 16px 45px rgba(27,25,22,.045)}.intelligence-card{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,.7fr);gap:24px;padding:24px;margin-bottom:16px;background:radial-gradient(circle at 100% 0,rgba(124,92,255,.12),transparent 42%),#11131a;color:white}.intelligence-card small{color:#a998ff;font:750 9px var(--font-mono);letter-spacing:.12em}.intelligence-card h2{max-width:700px;margin:9px 0 8px;font-size:25px;letter-spacing:-.03em}.intelligence-card p{margin:0;color:#aeb5c1;font-size:12px;line-height:1.65}.readiness{display:grid;align-content:center;gap:8px}.readiness span{display:flex;align-items:center;gap:8px;padding:10px;border:1px solid rgba(255,255,255,.08);border-radius:11px;background:rgba(255,255,255,.035);font-size:10px;font-weight:750}.readiness svg{width:13px;color:#6ee7b7}.grid-two{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;max-width:1180px;margin:0 auto 16px}.panel{padding:22px}.panel-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:18px}.panel h2,.future-boundary h2{margin:0;font-size:21px;letter-spacing:-.025em}.profile-summary{display:flex;align-items:center;gap:12px;margin-bottom:17px;padding:13px;border-radius:13px;background:#f7f5f1}.salon-mark,.avatar{display:grid;place-items:center;flex:0 0 auto;border-radius:12px;background:#eee9fb;color:#6548d1;font-weight:850}.salon-mark{width:43px;height:43px}.profile-summary>div{display:grid;gap:4px}.profile-summary strong{font-size:13px}.profile-summary small{display:flex;align-items:center;gap:4px;color:#747985;font-size:10px}.profile-summary small svg{width:12px}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.field-grid label{display:grid;gap:5px}.field-grid label.wide{grid-column:1/-1}.field-grid span{color:#747985;font-size:9px;font-weight:750}.field-grid input{min-width:0;min-height:39px;border:1px solid #e1ded8;border-radius:9px;background:#fff;color:#22242b;padding:0 10px;font-size:11px}.data-note{margin:14px 0 0;color:#8a8f97;font-size:9px;line-height:1.55}.team-list{display:grid}.team-list article{display:grid;grid-template-columns:38px minmax(0,1fr) auto;gap:10px;align-items:center;padding:12px 0;border-top:1px solid #ece9e3}.team-list article:first-child{border-top:0}.avatar{width:38px;height:38px;font-size:10px}.team-list article>div{display:grid;gap:3px;min-width:0}.team-list strong{font-size:11px}.team-list small{color:#818690;font-size:9px;overflow-wrap:anywhere}.team-list em{font-style:normal;padding:5px 7px;border-radius:999px;background:#eef9f2;color:#397552;font-size:8px;font-weight:800}.team-rule{display:grid;grid-template-columns:32px 1fr;gap:10px;margin-top:14px;padding:13px;border-radius:12px;background:#f7f5f1}.team-rule>svg{width:16px;color:#7557df}.team-rule strong{font-size:10px}.team-rule p{margin:5px 0 0;color:#7a7f88;font-size:9px;line-height:1.5}.context-panel{margin-bottom:16px}.context-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:12px}.context-flow>div{display:grid;gap:5px;padding:16px;border-radius:13px;background:#f7f5f1}.context-flow>svg{width:15px;color:#969ba4}.context-flow small{color:#8b9098;font-size:8px;text-transform:uppercase;letter-spacing:.08em}.context-flow strong{font-size:11px}.context-flow span{color:#757a84;font-size:9px}.future-boundary{display:grid;grid-template-columns:1fr 1.2fr;gap:24px;padding:22px;background:#f0ede7;border-style:dashed}.future-boundary p{margin:8px 0 0;color:#747982;font-size:11px}.future-list{display:flex;flex-wrap:wrap;gap:7px;align-content:center}.future-list span{padding:7px 9px;border-radius:999px;background:#fff;color:#666b74;border:1px solid #ddd9d2;font-size:9px;font-weight:750}.mobile-head,.mobile-nav{display:none}@media(max-width:900px){.app-shell{grid-template-columns:1fr}.sidebar{display:none}.mobile-head{position:sticky;z-index:60;top:30px;display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:#11131a;color:white}.mobile-head .brand small{color:#8f96a5}.mobile-nav{position:sticky;z-index:55;top:84px;display:flex;gap:6px;padding:8px 12px;overflow-x:auto;background:rgba(244,241,236,.97);border-bottom:1px solid #dedad3}.mobile-nav a{flex:0 0 auto;padding:7px 9px;border-radius:999px;background:#fff;color:#4e535d;text-decoration:none;font-size:9px;font-weight:800}.workspace{padding:32px 14px 60px}.topbar{display:block}.topbar>.preview-chip{margin-top:14px}.grid-two{grid-template-columns:1fr}.intelligence-card{grid-template-columns:1fr}.future-boundary{grid-template-columns:1fr}.context-flow{grid-template-columns:1fr}.context-flow>svg{display:none}}@media(max-width:520px){.truth-bar{justify-content:flex-start;overflow:hidden;white-space:nowrap;font-size:8px}.field-grid{grid-template-columns:1fr}.field-grid label.wide{grid-column:auto}.panel-head{display:block}.panel-head .status-chip{margin-top:9px}.team-list article{grid-template-columns:36px minmax(0,1fr)}.team-list em{grid-column:2;justify-self:start}.topbar h1{font-size:38px}.mobile-head .preview-chip{display:none}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important;animation:none!important}}a:focus-visible,input:focus-visible{outline:3px solid #7c5cff;outline-offset:2px}
</style>
