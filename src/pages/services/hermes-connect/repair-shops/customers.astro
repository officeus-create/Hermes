---
import { ArrowLeft, CalendarDays, Car, Mail, Phone, Search, Users } from "@lucide/astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
---

<BaseLayout
  title="Repair Shop Customers | Hermes Connect"
  description="Owner-only customer and vehicle history for Hermes Connect Repair Shops."
  robots="noindex,nofollow"
>
  <SiteHeader activePath="/paths/technology/" />
  <main class="customers-page">
    <div class="shell">
      <a class="back-link" href="/services/hermes-connect/repair-shops/dashboard/"><ArrowLeft size={16} /> Shop Owner Workspace</a>

      <header class="hero">
        <div>
          <p class="eyebrow">Hermes Connect · Repair Shops</p>
          <h1>Customers</h1>
          <p class="muted">A private customer view built from your shop’s real Hermes Connect bookings and saved vehicle details.</p>
        </div>
        <span id="customer-count" class="pill">0 customers</span>
      </header>

      <div id="page-alert" class="alert hidden" role="status"></div>

      <section class="panel search-panel" aria-label="Customer search">
        <Search size={18} />
        <input id="customer-search" type="search" placeholder="Search name, email, phone, vehicle, VIN, or service" autocomplete="off" />
      </section>

      <div id="customers-loading" class="state-card">Loading customer history…</div>
      <div id="customers-empty" class="state-card hidden"><strong>No customers yet</strong><span>Customers appear automatically after real bookings are created through your public booking link.</span></div>
      <div id="customers-list" class="customer-list hidden"></div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  type Vehicle = { year: number | null; make: string; model: string; mileage: number | null; vin: string | null; last_seen_date: string };
  type NextAppointment = { booking_id: string; appointment_date: string; start_time: string; service_name: string; status: string };
  type Customer = {
    id: string;
    name: string;
    email: string;
    phone: string;
    total_bookings: number;
    completed_visits: number;
    cancelled_bookings: number;
    last_activity_at: string;
    last_service_date: string | null;
    next_appointment: NextAppointment | null;
    services: string[];
    vehicles: Vehicle[];
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const alertBox = $("page-alert");
  const searchInput = $<HTMLInputElement>("customer-search");
  let customers: Customer[] = [];

  function showAlert(message: string) { if (!alertBox) return; alertBox.textContent = message; alertBox.className = "alert"; }
  async function readJson(response: Response) { try { return await response.json(); } catch { return { success: false, error: "invalid_server_response" }; } }
  function redirectToAuth() { window.location.replace("/services/hermes-connect/repair-shops/auth/"); }
  function formatDate(value: string | null) {
    if (!value) return "None yet";
    const date = new Date(`${value}T12:00:00Z`);
    return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat("en-US", { month:"short", day:"numeric", year:"numeric", timeZone:"UTC" }).format(date);
  }
  function formatTime(value: string) { const [h,m] = value.split(":").map(Number); return `${h % 12 || 12}:${String(m).padStart(2,"0")} ${h >= 12 ? "PM" : "AM"}`; }

  function vehicleText(vehicle: Vehicle) {
    const name = `${vehicle.year ?? ""} ${vehicle.make} ${vehicle.model}`.trim();
    const mileage = vehicle.mileage == null ? "Mileage not provided" : `${vehicle.mileage.toLocaleString()} mi`;
    return `${name} · ${mileage}`;
  }

  function matchesSearch(customer: Customer, query: string) {
    if (!query) return true;
    const vehicleTextBlob = customer.vehicles.map((vehicle) => `${vehicle.year ?? ""} ${vehicle.make} ${vehicle.model} ${vehicle.vin ?? ""}`).join(" ");
    const haystack = `${customer.name} ${customer.email} ${customer.phone} ${customer.services.join(" ")} ${vehicleTextBlob}`.toLowerCase();
    return haystack.includes(query.toLowerCase());
  }

  function render(filtered: Customer[]) {
    const list = $("customers-list")!;
    const empty = $("customers-empty")!;
    $("customers-loading")?.classList.add("hidden");
    $("customer-count")!.textContent = `${filtered.length} ${filtered.length === 1 ? "customer" : "customers"}`;
    list.innerHTML = "";

    if (!filtered.length) {
      list.classList.add("hidden");
      empty.classList.remove("hidden");
      return;
    }
    empty.classList.add("hidden");
    list.classList.remove("hidden");

    for (const customer of filtered) {
      const card = document.createElement("article");
      card.className = "customer-card";

      const header = document.createElement("div");
      header.className = "customer-header";
      const heading = document.createElement("div");
      const name = document.createElement("strong"); name.textContent = customer.name || customer.email;
      const meta = document.createElement("span"); meta.className = "muted small"; meta.textContent = `${customer.total_bookings} ${customer.total_bookings === 1 ? "booking" : "bookings"} · ${customer.completed_visits} completed`;
      heading.append(name, meta);
      const badge = document.createElement("span"); badge.className = "pill"; badge.textContent = customer.next_appointment ? "Upcoming" : customer.completed_visits ? "Past customer" : "Lead";
      header.append(heading, badge);

      const contact = document.createElement("div"); contact.className = "contact-grid";
      const email = document.createElement("a"); email.href = `mailto:${customer.email}`; email.textContent = customer.email; email.className = "contact-link";
      const phone = document.createElement("a"); phone.href = `tel:${customer.phone}`; phone.textContent = customer.phone; phone.className = "contact-link";
      contact.append(email, phone);

      const stats = document.createElement("div"); stats.className = "stats";
      const last = document.createElement("div"); last.innerHTML = `<span>Last completed service</span><strong>${formatDate(customer.last_service_date)}</strong>`;
      const services = document.createElement("div"); services.innerHTML = `<span>Services</span><strong>${customer.services.length ? customer.services.join(", ") : "None yet"}</strong>`;
      stats.append(last, services);

      if (customer.next_appointment) {
        const next = document.createElement("div"); next.className = "next-appointment";
        next.textContent = `Next: ${formatDate(customer.next_appointment.appointment_date)} at ${formatTime(customer.next_appointment.start_time)} · ${customer.next_appointment.service_name}`;
        card.append(header, contact, next, stats);
      } else {
        card.append(header, contact, stats);
      }

      const vehicleSection = document.createElement("div"); vehicleSection.className = "vehicle-section";
      const vehicleTitle = document.createElement("span"); vehicleTitle.className = "mini-label"; vehicleTitle.textContent = "Vehicles"; vehicleSection.append(vehicleTitle);
      if (!customer.vehicles.length) {
        const none = document.createElement("p"); none.className = "muted small"; none.textContent = "No vehicle details were captured for earlier bookings."; vehicleSection.append(none);
      } else {
        const grid = document.createElement("div"); grid.className = "vehicle-grid";
        for (const vehicle of customer.vehicles) {
          const item = document.createElement("div"); item.className = "vehicle-card";
          const title = document.createElement("strong"); title.textContent = vehicleText(vehicle);
          const sub = document.createElement("span"); sub.textContent = `${vehicle.vin ? `VIN ${vehicle.vin} · ` : ""}Last seen ${formatDate(vehicle.last_seen_date)}`;
          item.append(title, sub); grid.append(item);
        }
        vehicleSection.append(grid);
      }
      card.append(vehicleSection);
      list.append(card);
    }
  }

  async function initialize() {
    const session = await fetch("/api/auth/me", { credentials:"same-origin" });
    if (session.status === 401) return redirectToAuth();
    if (!session.ok) return showAlert("Unable to verify your secure session.");

    const response = await fetch("/api/repair-shop/customers", { credentials:"same-origin" });
    if (response.status === 401) return redirectToAuth();
    const data = await readJson(response);
    if (!response.ok || !data.success) return showAlert(data.error || "Unable to load customers.");
    customers = Array.isArray(data.customers) ? data.customers : [];
    render(customers);
  }

  searchInput?.addEventListener("input", () => render(customers.filter((customer) => matchesSearch(customer, searchInput.value.trim()))));
  initialize().catch(() => showAlert("Unable to initialize customer history."));
</script>

<style>
.customers-page{min-height:100vh;padding:116px 24px 80px;color:#f6f7fb;background:radial-gradient(circle at 12% 8%,rgba(124,92,255,.16),transparent 32%),radial-gradient(circle at 86% 18%,rgba(78,185,250,.1),transparent 30%),#090a0f}.shell{width:min(1000px,100%);margin:auto}.back-link{display:inline-flex;align-items:center;gap:8px;color:#a5aab7;text-decoration:none;font-weight:750;margin-bottom:26px}.hero{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:22px}.eyebrow,.mini-label{margin:0 0 8px;color:#9d88ff;text-transform:uppercase;letter-spacing:.12em;font-size:12px;font-weight:850}h1{margin:0 0 8px;font-size:clamp(34px,5vw,52px)}.muted{margin:0;color:#a6acb9;line-height:1.55}.small{font-size:12px}.pill{display:inline-flex;padding:7px 10px;border-radius:999px;background:rgba(124,92,255,.13);border:1px solid rgba(157,136,255,.24);color:#d6cfff;font-size:12px;font-weight:800}.panel,.customer-card,.state-card{border:1px solid rgba(255,255,255,.09);background:rgba(17,18,26,.88);border-radius:18px;box-shadow:0 18px 60px rgba(0,0,0,.2)}.search-panel{display:flex;align-items:center;gap:10px;padding:14px 16px;margin-bottom:18px}.search-panel svg{color:#9180ec;flex:none}.search-panel input{width:100%;border:0;outline:0;background:transparent;color:#fff;font:inherit}.search-panel input::placeholder{color:#757c8d}.state-card{padding:20px;color:#a8aebb;display:flex;flex-direction:column;gap:5px}.customer-list{display:grid;gap:14px}.customer-card{padding:20px}.customer-header{display:flex;justify-content:space-between;gap:16px}.customer-header>div{display:flex;flex-direction:column;gap:4px}.contact-grid{display:flex;gap:12px;flex-wrap:wrap;margin:13px 0}.contact-link{color:#bfc8ff;text-decoration:none;font-size:13px}.contact-link:hover{text-decoration:underline}.next-appointment{padding:11px 13px;border:1px solid rgba(95,231,164,.17);background:rgba(45,145,100,.09);border-radius:11px;color:#bff3d6;font-size:13px;font-weight:700;margin:10px 0}.stats{display:grid;grid-template-columns:1fr 2fr;gap:10px;margin:12px 0}.stats>div{padding:12px;border-radius:11px;background:rgba(255,255,255,.025);display:flex;flex-direction:column;gap:5px}.stats span{font-size:11px;color:#868d9d;text-transform:uppercase;letter-spacing:.07em}.stats strong{font-size:13px;color:#e9ebf1}.vehicle-section{margin-top:15px;padding-top:14px;border-top:1px solid rgba(255,255,255,.07)}.vehicle-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.vehicle-card{display:flex;flex-direction:column;gap:5px;padding:12px;border-radius:11px;background:rgba(124,92,255,.06);border:1px solid rgba(124,92,255,.12)}.vehicle-card strong{font-size:13px}.vehicle-card span{color:#8f96a7;font-size:11px}.alert{padding:13px 15px;border-radius:12px;margin-bottom:18px;background:rgba(177,47,47,.15);border:1px solid rgba(255,100,100,.2);color:#ffc2c2}.hidden{display:none!important}@media(max-width:720px){.customers-page{padding:100px 15px 60px}.hero{display:block}.hero .pill{margin-top:12px}.stats,.vehicle-grid{grid-template-columns:1fr}.customer-header{display:block}.customer-header .pill{margin-top:10px}}
</style>
