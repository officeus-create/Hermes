---
import { ArrowLeft, ArrowRight, Check, CheckCircle2, Clock, Calendar, Smartphone, Sparkles, ShieldCheck, HelpCircle, Wrench } from "@lucide/astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";

const canonicalUrl = "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/booking/";

const services = [
  { id: "oil_change", name: "Full Synthetic Oil Change", duration: "45 mins", price: "$89.99", desc: "Includes premium OEM synthetic oil, high-efficiency filter, and 15-point inspection." },
  { id: "brake_service", name: "Premium Brake Pad Replacement", duration: "1.5 hours", price: "$149.99", desc: "Includes premium ceramic brake pads and caliper inspection." },
  { id: "diagnostic", name: "Engine Diagnostic Scan", duration: "30 mins", price: "$120.00", desc: "Full OBD-II sensor sweep and error code reports." },
  { id: "tire_rotation", name: "Tire Rotation & Balance", duration: "40 mins", price: "$45.00", desc: "Improves tread life, balance correction for smooth highway runs." },
  { id: "ac_recharge", name: "AC Recharge & Leak Check", duration: "1 hour", price: "$160.00", desc: "Eco-friendly refrigerant recharge and system integrity verification." }
];

const timeSlots = [
  { id: "09:00", label: "09:00 AM" },
  { id: "11:00", label: "11:00 AM" },
  { id: "13:00", label: "01:00 PM" },
  { id: "15:00", label: "03:00 PM" },
  { id: "17:00", label: "05:00 PM" }
];

const weekdays = [
  { id: "MON", label: "Monday, Aug 17" },
  { id: "TUE", label: "Tuesday, Aug 18" },
  { id: "WED", label: "Wednesday, Aug 19" },
  { id: "THU", label: "Thursday, Aug 20" },
  { id: "FRI", label: "Friday, Aug 21" }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Apex Auto Care - Instant Booking Portal",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: canonicalUrl,
    description: "Book high-quality vehicle repair and maintenance slots at Apex Auto Care. Interactive scheduling and PWA early access.",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
      { "@type": "ListItem", position: 3, name: "Repair Shops", item: "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/" },
      { "@type": "ListItem", position: 4, name: "Booking Portal", item: canonicalUrl }
    ]
  }
];
---

<BaseLayout
  title="Apex Auto Care - Live Booking Portal | Hermes Connect"
  description="Schedule a synthetic oil change, brake service, tire rotation, or engine diagnostic. View live bay availability and book instantly."
  schema={schema}
>
  <SiteHeader activePath="/paths/technology/" />

  <main id="main-content" class="booking-portal-page">
    <div class="booking-glow-container">
      <div class="radial-glow glow-1"></div>
      <div class="radial-glow glow-2"></div>
    </div>

    <div class="container">
      <!-- Back Link -->
      <a href="/services/hermes-connect/repair-shops/" class="back-link">
        <ArrowLeft class="icon" /> Back to Partner Portal
      </a>

      <!-- Page Header -->
      <header class="portal-header">
        <div class="shop-badge">
          <span class="live-dot animate-pulse"></span>
          <span class="badge-text">APEX AUTO CARE · OFFICIAL REPAIR PARTNER</span>
        </div>
        <h1>Live Customer Booking Intake</h1>
        <p class="subtitle">
          Secure your priority maintenance appointment below. During our <strong>Hermes Public Beta</strong>, 
          all services are processed with 100% discount, zero subscriptions, and direct CRM scheduling.
        </p>
      </header>

      <!-- Main Booking Interface -->
      <div class="booking-grid">
        <!-- Form Panel -->
        <div class="booking-card glass-panel" id="booking-wizard-card">
          <!-- Step Tracker -->
          <div class="steps-progress" role="navigation" aria-label="Booking steps progress">
            <div class="step-progress-item active" data-step-indicator="1">
              <span class="step-number">1</span>
              <span class="step-label">Service</span>
            </div>
            <div class="step-divider"></div>
            <div class="step-progress-item" data-step-indicator="2">
              <span class="step-number">2</span>
              <span class="step-label">Time Slot</span>
            </div>
            <div class="step-divider"></div>
            <div class="step-progress-item" data-step-indicator="3">
              <span class="step-number">3</span>
              <span class="step-label">Vehicle</span>
            </div>
            <div class="step-divider"></div>
            <div class="step-progress-item" data-step-indicator="4">
              <span class="step-number">4</span>
              <span class="step-label">Contact</span>
            </div>
          </div>

          <form id="booking-form" class="mt-8">
            <!-- STEP 1: Select Service -->
            <div class="step-section active" data-step-section="1">
              <h2 class="section-title">Select Your Vehicle Service</h2>
              <p class="section-desc">Choose from our premium automotive service catalog. Pricing is fully waived during early access.</p>
              
              <div class="services-list" role="radiogroup" aria-label="Available services">
                {services.map((svc) => (
                  <label class="service-option" for={`svc-${svc.id}`}>
                    <input type="radio" name="selected_service" id={`svc-${svc.id}`} value={svc.id} data-name={svc.name} data-price={svc.price} required class="sr-only" />
                    <div class="service-selection-indicator"></div>
                    <div class="service-details">
                      <div class="service-header">
                        <h3>{svc.name}</h3>
                        <div class="price-badge-group">
                          <span class="original-price">{svc.price}</span>
                          <span class="free-badge">FREE BETA</span>
                        </div>
                      </div>
                      <p class="service-desc">{svc.desc}</p>
                      <div class="service-meta">
                        <span class="meta-item"><Clock class="meta-icon" /> {svc.duration}</span>
                        <span class="meta-item"><Wrench class="meta-icon" /> Bay 1 · Assigned</span>
                      </div>
                    </div>
                  </label>
                ))}
              </div>
            </div>

            <!-- STEP 2: Select Time Slot -->
            <div class="step-section" data-step-section="2">
              <h2 class="section-title">Select Date & Available Slot</h2>
              <p class="section-desc">Our capacity is strictly capped at 3 active bays. Slots marked as exhausted cannot be booked.</p>

              <!-- Day Selector -->
              <h3 class="subsection-title">1. Select Weekday</h3>
              <div class="days-grid" role="radiogroup" aria-label="Available weekdays">
                {weekdays.map((day) => (
                  <label class="day-option" for={`day-${day.id}`}>
                    <input type="radio" name="selected_day" id={`day-${day.id}`} value={day.id} data-label={day.label} required class="sr-only" />
                    <span class="day-label-text">{day.label.split(',')[0]}</span>
                    <span class="day-date-text">{day.label.split(',')[1]}</span>
                  </label>
                ))}
              </div>

              <!-- Time Slot Selector -->
              <h3 class="subsection-title mt-6">2. Choose Time</h3>
              <div id="slots-container" class="slots-grid" role="radiogroup" aria-label="Available time slots">
                {timeSlots.map((slot) => (
                  <label class="slot-option" for={`slot-${slot.id}`} id={`label-slot-${slot.id}`}>
                    <input type="radio" name="selected_slot" id={`slot-${slot.id}`} value={slot.id} data-label={slot.label} required class="sr-only" />
                    <span class="slot-time-text">{slot.label}</span>
                    <span class="slot-status-text" id={`capacity-slot-${slot.id}`}>3 of 3 Bays Open</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- STEP 3: Vehicle Details -->
            <div class="step-section" data-step-section="3">
              <h2 class="section-title">Add Vehicle Information</h2>
              <p class="section-desc">Provide accurate vehicle details to ensure our technicians prepare the correct equipment and fluids.</p>

              <div class="form-group-grid mt-6">
                <div class="form-group">
                  <label for="vehicle_year">Model Year</label>
                  <input type="number" id="vehicle_year" name="vehicle_year" min="1990" max="2027" placeholder="e.g. 2021" required class="form-input" />
                </div>
                <div class="form-group">
                  <label for="vehicle_make">Vehicle Make</label>
                  <input type="text" id="vehicle_make" name="vehicle_make" placeholder="e.g. Ford" required class="form-input" />
                </div>
                <div class="form-group">
                  <label for="vehicle_model">Vehicle Model</label>
                  <input type="text" id="vehicle_model" name="vehicle_model" placeholder="e.g. F-150" required class="form-input" />
                </div>
                <div class="form-group">
                  <label for="vehicle_mileage">Current Odometer (Miles)</label>
                  <input type="number" id="vehicle_mileage" name="vehicle_mileage" min="0" placeholder="e.g. 45000" required class="form-input" />
                </div>
              </div>
            </div>

            <!-- STEP 4: Contact Information -->
            <div class="step-section" data-step-section="4">
              <h2 class="section-title">Add Owner Contact</h2>
              <p class="section-desc">Enter your contact details to receive booking alerts and direct sync status notifications.</p>

              <div class="form-group-grid mt-6">
                <div class="form-group">
                  <label for="customer_name">Full Name</label>
                  <input type="text" id="customer_name" name="customer_name" placeholder="John Doe" required class="form-input" />
                </div>
                <div class="form-group">
                  <label for="customer_email">Email Address</label>
                  <input type="email" id="customer_email" name="customer_email" placeholder="john@example.com" required class="form-input" />
                </div>
                <div class="form-group">
                  <label for="customer_phone">Phone Number</label>
                  <input type="tel" id="customer_phone" name="customer_phone" placeholder="(555) 000-0000" required class="form-input" />
                </div>
              </div>

              <div class="form-group mt-4">
                <label for="booking_notes">Special Service Notes (Optional)</label>
                <textarea id="booking_notes" name="booking_notes" rows="3" placeholder="Describe any specific issues, codes, or requests..." class="form-input"></textarea>
              </div>
            </div>

            <!-- Navigation Controls -->
            <div class="form-nav-controls">
              <button type="button" id="prev-btn" class="nav-btn prev-btn hidden">
                <ArrowLeft class="icon" /> Back
              </button>
              <div class="spacer"></div>
              <button type="button" id="next-btn" class="nav-btn next-btn">
                Next <ArrowRight class="icon" />
              </button>
              <button type="submit" id="submit-btn" class="nav-btn submit-btn hidden">
                Confirm Booking <CheckCircle2 class="icon" />
              </button>
            </div>
          </form>
        </div>

        <!-- Success Screen (Hidden by default) -->
        <div class="booking-card glass-panel hidden" id="booking-success-card">
          <div class="success-header">
            <div class="success-icon-container">
              <Check class="success-checkmark" />
            </div>
            <h2>Appointment Confirmed!</h2>
            <p>Your repair slot is successfully persisted to Apex Auto Care's live CRM database.</p>
          </div>

          <div class="receipt-card">
            <h3>APEX AUTO CARE RECEIPT</h3>
            <div class="receipt-divider"></div>
            <div class="receipt-row">
              <span>Appointment ID:</span>
              <strong id="receipt-id">APX-738902</strong>
            </div>
            <div class="receipt-row">
              <span>Customer:</span>
              <strong id="receipt-customer">John Doe</strong>
            </div>
            <div class="receipt-row">
              <span>Vehicle:</span>
              <strong id="receipt-vehicle">2021 Ford F-150</strong>
            </div>
            <div class="receipt-row">
              <span>Service:</span>
              <strong id="receipt-service">Synthetic Oil Change</strong>
            </div>
            <div class="receipt-row">
              <span>Time Slot:</span>
              <strong id="receipt-slot">Friday, Aug 21 at 11:00 AM</strong>
            </div>
            <div class="receipt-divider"></div>
            <div class="receipt-row total">
              <span>Total Price (Early Access):</span>
              <strong>$0.00 (FREE BETA)</strong>
            </div>
          </div>

          <div class="success-actions mt-6">
            <button id="download-ics-btn" class="success-btn primary-success-btn">
              <Calendar class="icon" /> Add to Apple / Google Calendar (.ics)
            </button>
            <a href="/services/hermes-connect/repair-shops/" class="success-btn secondary-success-btn">
              Book Another Appointment
            </a>
          </div>

          <!-- Growth Loop Card -->
          <article class="viral-growth-card mt-8">
            <div class="viral-content">
              <div class="viral-badge">
                <Sparkles class="viral-icon" /> GROW YOUR BUSINESS
              </div>
              <h4>Are you an Auto Service or Fleet Owner?</h4>
              <p>
                Get your own custom-branded customer booking portal, high-impact localized SEO, 
                and automated dispatch channels powered by Hermes Connect. Free early onboarding is currently open.
              </p>
            </div>
            <button id="viral-loop-cta" class="viral-cta-btn">
              Talk to Hermes Specialists <ArrowRight class="icon" />
            </button>
          </article>
        </div>

        <!-- Sidebar Summary / Bay Status -->
        <aside class="sidebar-panel">
          <!-- Active Bay Status Card -->
          <section class="glass-panel bay-status-card" aria-labelledby="bay-status-title">
            <h2 id="bay-status-title" class="card-title">Live Technician Bay Status</h2>
            <p class="card-desc">Currently scheduling for our premium local service team in Madison, WI.</p>

            <div class="bays-vertical-list">
              <div class="bay-row">
                <div class="bay-indicator active"></div>
                <div class="bay-info">
                  <strong>Bay 1 — Diagnostic & Maintenance</strong>
                  <span class="bay-tech">Lead Tech: Marcus V. (ASE Certified)</span>
                </div>
                <span class="bay-status-tag">Live Active</span>
              </div>
              <div class="bay-row">
                <div class="bay-indicator active"></div>
                <div class="bay-info">
                  <strong>Bay 2 — Heavy Engine & Brake Rig</strong>
                  <span class="bay-tech">Lead Tech: Dave K. (Heavy Diesel)</span>
                </div>
                <span class="bay-status-tag">Live Active</span>
              </div>
              <div class="bay-row">
                <div class="bay-indicator idle"></div>
                <div class="bay-info">
                  <strong>Bay 3 — Wheel Alignment & Balance</strong>
                  <span class="bay-tech">Lead Tech: Chris R. (Suspension)</span>
                </div>
                <span class="bay-status-tag idle">Awaiting Crew</span>
              </div>
            </div>
          </section>

          <!-- System Trust Card -->
          <section class="glass-panel trust-badge-card" aria-labelledby="trust-title">
            <h2 id="trust-title" class="hidden">Trust Badges</h2>
            <div class="trust-flex-row">
              <ShieldCheck class="trust-icon" />
              <div>
                <strong>Hermes Verified Integrity</strong>
                <p>All bookings write back to live CRM caches instantly. No ghost appointments or overlapping slots.</p>
              </div>
            </div>
          </section>
        </aside>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  :root {
    --purple-glow: rgba(124, 92, 255, 0.15);
    --teal-glow: rgba(90, 200, 250, 0.08);
  }

  .booking-portal-page {
    position: relative;
    padding: 100px 0 160px;
    background-color: #07080c;
    color: #f7f6f3;
    overflow: hidden;
    min-height: 100vh;
    font-family: 'Inter', -apple-system, sans-serif;
  }

  .booking-glow-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .radial-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
  }

  .glow-1 {
    top: 5%;
    left: 10%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, var(--purple-glow), transparent 70%);
  }

  .glow-2 {
    bottom: 15%;
    right: 5%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, var(--teal-glow), transparent 70%);
  }

  .container {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #a0a5b2;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 32px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #7c5cff;
  }

  .back-link .icon {
    width: 16px;
    height: 16px;
  }

  .portal-header {
    margin-bottom: 48px;
  }

  .shop-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(124, 92, 255, 0.08);
    border: 1px solid rgba(124, 92, 255, 0.25);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #ab98ff;
    margin-bottom: 16px;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #319a75;
    box-shadow: 0 0 10px #319a75;
  }

  .portal-header h1 {
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -0.04em;
    margin: 0 0 16px;
    background: linear-gradient(135deg, #ffffff, #d2caff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle {
    font-size: 16px;
    color: #a0a5b2;
    max-width: 800px;
    line-height: 1.6;
    margin: 0;
  }

  .booking-grid {
    display: grid;
    grid-template-columns: 1.35fr .65fr;
    gap: 28px;
    align-items: start;
  }

  .glass-panel {
    background: rgba(23, 26, 35, 0.55);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }

  .booking-card {
    padding: 36px;
  }

  .steps-progress {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .step-progress-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #6a6e7d;
    font-weight: 700;
    font-size: 13px;
  }

  .step-progress-item.active {
    color: #7c5cff;
  }

  .step-progress-item.completed {
    color: #319a75;
  }

  .step-number {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    transition: all 0.2s ease;
  }

  .step-progress-item.active .step-number {
    background-color: #7c5cff;
    color: #fff;
    border-color: #7c5cff;
    box-shadow: 0 0 15px rgba(124, 92, 255, 0.4);
  }

  .step-progress-item.completed .step-number {
    background-color: #319a75;
    color: #fff;
    border-color: #319a75;
  }

  .step-divider {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
  }

  .step-section {
    display: none;
    animation: fadeIn 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .step-section.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  .section-title {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }

  .section-desc {
    font-size: 14px;
    color: #a0a5b2;
    margin: 0 0 32px;
  }

  .services-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .service-option {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 16px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 18px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .service-option:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(124, 92, 255, 0.2);
    transform: translateY(-1px);
  }

  .service-option.checked {
    background: rgba(124, 92, 255, 0.06);
    border-color: rgba(124, 92, 255, 0.4);
    box-shadow: inset 0 0 20px rgba(124, 92, 255, 0.05);
  }

  .service-selection-indicator {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.2);
    margin-top: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.2s ease;
  }

  .service-option.checked .service-selection-indicator {
    border-color: #7c5cff;
  }

  .service-option.checked .service-selection-indicator::after {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #7c5cff;
    position: absolute;
    box-shadow: 0 0 8px #7c5cff;
  }

  .service-details {
    display: grid;
  }

  .service-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 6px;
  }

  .service-header h3 {
    font-size: 16px;
    font-weight: 700;
    margin: 0;
  }

  .price-badge-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .original-price {
    font-size: 14px;
    color: #727685;
    text-decoration: line-through;
  }

  .free-badge {
    background: rgba(49, 154, 117, 0.08);
    border: 1px solid rgba(49, 154, 117, 0.25);
    border-radius: 4px;
    padding: 3px 6px;
    font-size: 9px;
    font-weight: 800;
    color: #5ad39d;
  }

  .service-desc {
    font-size: 13px;
    color: #8b8f9d;
    line-height: 1.45;
    margin: 0 0 12px;
  }

  .service-meta {
    display: flex;
    gap: 16px;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: #a0a5b2;
    font-weight: 600;
  }

  .meta-icon {
    width: 13px;
    height: 13px;
    color: #7c5cff;
  }

  .subsection-title {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ab98ff;
    margin-bottom: 12px;
  }

  .days-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
  }

  .day-option {
    display: flex;
    flex-direction: column;
