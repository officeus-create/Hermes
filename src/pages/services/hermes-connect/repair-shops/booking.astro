---
import { ArrowLeft, CalendarDays, CheckCircle2, Clock3, MapPin, Wrench } from "@lucide/astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
---

<BaseLayout
  title="Repair Shop Booking | Hermes Connect"
  description="Book a real appointment with a repair shop using Hermes Connect public beta scheduling."
  robots="noindex,nofollow"
>
  <SiteHeader activePath="/paths/technology/" />
  <main class="booking-page">
    <div class="shell">
      <a class="back-link" href="/services/hermes-connect/repair-shops/"><ArrowLeft size={16} /> Repair Shop Beta</a>

      <header class="hero">
        <p class="eyebrow">Hermes Connect · Public Booking</p>
        <h1 id="shop-title">Loading repair shop…</h1>
        <p id="shop-meta" class="muted">Loading shop profile, services, and hours from production.</p>
      </header>

      <div id="page-alert" class="alert hidden" role="status"></div>

      <section id="booking-panel" class="panel hidden" aria-labelledby="booking-title">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">Real appointment intake</p>
            <h2 id="booking-title">Book a service</h2>
            <p class="muted">Hermes Connect software is in free public beta. Repair services themselves are not advertised as free.</p>
          </div>
          <span id="timezone-pill" class="pill"></span>
        </div>

        <form id="booking-form" class="booking-form">
          <label class="field span-2">Service
            <select id="service-select" required>
              <option value="">Select a service</option>
            </select>
          </label>

          <label class="field">Date
            <select id="date-select" required disabled>
              <option value="">Select a date</option>
            </select>
          </label>

          <label class="field">Time
            <select id="time-select" required disabled>
              <option value="">Select a time</option>
            </select>
          </label>

          <div id="slot-state" class="slot-state span-2">Choose a service and date to load current availability.</div>

          <div class="divider span-2"></div>
          <div class="section-label span-2"><strong>Vehicle</strong><span>Saved with this appointment so the shop can prepare before you arrive.</span></div>
          <label class="field">Year<input id="vehicle-year" type="number" min="1900" max="2100" inputmode="numeric" required placeholder="2021" /></label>
          <label class="field">Make<input id="vehicle-make" minlength="1" maxlength="80" required placeholder="Ford" /></label>
          <label class="field">Model<input id="vehicle-model" minlength="1" maxlength="80" required placeholder="F-150" /></label>
          <label class="field">Mileage<input id="vehicle-mileage" type="number" min="0" max="2000000" inputmode="numeric" placeholder="84500" /></label>
          <label class="field span-2">VIN <span class="optional">optional</span><input id="vehicle-vin" minlength="11" maxlength="17" autocomplete="off" placeholder="Optional vehicle identification number" /></label>

          <div class="divider span-2"></div>
          <div class="section-label span-2"><strong>Contact</strong><span>The repair shop uses this information for your appointment.</span></div>
          <label class="field">Full name<input id="client-name" minlength="2" maxlength="120" autocomplete="name" required /></label>
          <label class="field">Phone<input id="client-phone" minlength="7" maxlength="40" autocomplete="tel" inputmode="tel" required /></label>
          <label class="field span-2">Email<input id="client-email" type="email" maxlength="200" autocomplete="email" required /></label>

          <button id="submit-btn" class="primary-btn span-2" type="submit">Confirm appointment</button>
        </form>
      </section>

      <section id="success-panel" class="panel success-panel hidden" aria-live="polite">
        <CheckCircle2 class="success-icon" size={54} />
        <p class="eyebrow">Production booking created</p>
        <h2>Appointment confirmed</h2>
        <p id="success-summary" class="muted"></p>
        <dl class="receipt">
          <div><dt>Booking ID</dt><dd id="receipt-id"></dd></div>
          <div><dt>Shop</dt><dd id="receipt-shop"></dd></div>
          <div><dt>Service</dt><dd id="receipt-service"></dd></div>
          <div><dt>Vehicle</dt><dd id="receipt-vehicle"></dd></div>
          <div><dt>Date</dt><dd id="receipt-date"></dd></div>
          <div><dt>Time</dt><dd id="receipt-time"></dd></div>
          <div><dt>Status</dt><dd id="receipt-status"></dd></div>
        </dl>
        <button id="calendar-btn" class="secondary-btn" type="button"><CalendarDays size={17} /> Add to calendar (.ics)</button>
      </section>

      <aside class="trust-panel">
        <div><Wrench size={18} /><span>Services come from this shop’s owner workspace.</span></div>
        <div><Clock3 size={18} /><span>Times are checked against the shop’s saved weekly hours and existing bookings.</span></div>
        <div><MapPin size={18} /><span id="location-note">Shop location loads from the saved public profile.</span></div>
      </aside>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  type Service = { id: string; name: string; duration_minutes: number };
  type AvailabilityDay = { day_of_week: number; is_open: boolean; start_time: string | null; end_time: string | null };
  type Shop = { id: string; name: string; slug: string; phone?: string | null; address_line1?: string | null; city: string; state: string; postal_code?: string | null; timezone: string };
  type BusyInterval = { start_time: string; end_time: string; status: string };
  type PublicPayload = { success: boolean; shop?: Shop; services?: Service[]; availability?: AvailabilityDay[]; error?: string };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const alertBox = $("page-alert");
  const form = $<HTMLFormElement>("booking-form");
  const serviceSelect = $<HTMLSelectElement>("service-select");
  const dateSelect = $<HTMLSelectElement>("date-select");
  const timeSelect = $<HTMLSelectElement>("time-select");
  const submitButton = $<HTMLButtonElement>("submit-btn");
  let shop: Shop | null = null;
  let services: Service[] = [];
  let availability: AvailabilityDay[] = [];
  let lastBooking: any = null;

  const toMinutes = (value: string) => { const [h, m] = value.split(":").map(Number); return h * 60 + m; };
  const fromMinutes = (value: number) => `${String(Math.floor(value / 60)).padStart(2, "0")}:${String(value % 60).padStart(2, "0")}`;
  const formatTime = (value: string) => {
    const [h, m] = value.split(":").map(Number);
    const suffix = h >= 12 ? "PM" : "AM";
    const hour = h % 12 || 12;
    return `${hour}:${String(m).padStart(2, "0")} ${suffix}`;
  };
  const readJson = async (response: Response) => { try { return await response.json(); } catch { return { success: false, error: "invalid_server_response" }; } };

  function showAlert(message: string) {
    if (!alertBox) return;
    alertBox.textContent = message;
    alertBox.className = "alert";
  }
  function clearAlert() { if (alertBox) { alertBox.textContent = ""; alertBox.className = "alert hidden"; } }

  function localDateParts(timezone: string, date = new Date()) {
    const parts = new Intl.DateTimeFormat("en-US", { timeZone: timezone, year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(date);
    const pick = (type: string) => parts.find((part) => part.type === type)?.value || "";
    return `${pick("year")}-${pick("month")}-${pick("day")}`;
  }

  function weekdayForDate(value: string) { return new Date(`${value}T12:00:00Z`).getUTCDay(); }

  function buildDates() {
    if (!shop || !dateSelect) return;
    const today = localDateParts(shop.timezone);
    const base = new Date(`${today}T12:00:00Z`);
    dateSelect.innerHTML = '<option value="">Select a date</option>';
    let count = 0;
    for (let offset = 0; offset <= 21; offset++) {
      const candidate = new Date(base.getTime() + offset * 86400000);
      const date = candidate.toISOString().slice(0, 10);
      const day = availability.find((item) => Number(item.day_of_week) === candidate.getUTCDay());
      if (!day?.is_open || !day.start_time || !day.end_time) continue;
      const option = document.createElement("option");
      option.value = date;
      option.textContent = new Intl.DateTimeFormat("en-US", { weekday: "short", month: "short", day: "numeric", timeZone: "UTC" }).format(candidate);
      dateSelect.append(option);
      count++;
    }
    dateSelect.disabled = count === 0;
    if (count === 0) showAlert("This shop has not opened any booking days yet.");
  }

  function selectedService() { return services.find((item) => item.id === serviceSelect?.value) || null; }

  async function refreshSlots() {
    if (!shop || !dateSelect || !timeSelect) return;
    const service = selectedService();
    const date = dateSelect.value;
    timeSelect.innerHTML = '<option value="">Select a time</option>';
    timeSelect.disabled = true;
    if (!service || !date) { $("slot-state")!.textContent = "Choose a service and date to load current availability."; return; }

    const day = availability.find((item) => Number(item.day_of_week) === weekdayForDate(date));
    if (!day?.is_open || !day.start_time || !day.end_time) { $("slot-state")!.textContent = "The shop is closed on this date."; return; }

    $("slot-state")!.textContent = "Checking current production bookings…";
    const response = await fetch(`/api/public/repair-booking?shop=${encodeURIComponent(shop.slug)}&date=${encodeURIComponent(date)}`);
    const data = await readJson(response);
    if (!response.ok || !data.success) { $("slot-state")!.textContent = data.error || "Unable to load live availability."; return; }
    const busy = Array.isArray(data.busy) ? data.busy as BusyInterval[] : [];

    const openStart = toMinutes(day.start_time);
    const openEnd = toMinutes(day.end_time);
    const duration = Number(service.duration_minutes);
    let availableCount = 0;
    for (let start = openStart; start + duration <= openEnd; start += 30) {
      const end = start + duration;
      const overlaps = busy.some((row) => start < toMinutes(row.end_time) && end > toMinutes(row.start_time));
      if (overlaps) continue;
      const value = fromMinutes(start);
      const option = document.createElement("option");
      option.value = value;
      option.textContent = `${formatTime(value)} · ${duration} min`;
      timeSelect.append(option);
      availableCount++;
    }
    timeSelect.disabled = availableCount === 0;
    $("slot-state")!.textContent = availableCount ? `${availableCount} live ${availableCount === 1 ? "time" : "times"} available.` : "No open times remain for this service on that date.";
  }

  async function loadShop() {
    const slug = new URLSearchParams(window.location.search).get("shop")?.trim() || "";
    if (!slug) { showAlert("This booking link is missing its shop identifier. Ask the repair shop for its current Hermes Connect booking link."); return; }
    const response = await fetch(`/api/public/repair-shop?slug=${encodeURIComponent(slug)}`);
    const data = await readJson(response) as PublicPayload;
    if (!response.ok || !data.success || !data.shop) { showAlert(data.error === "shop_not_found" ? "This repair shop booking link is not active." : data.error || "Unable to load this repair shop."); return; }

    shop = data.shop;
    services = Array.isArray(data.services) ? data.services : [];
    availability = Array.isArray(data.availability) ? data.availability : [];
    $("shop-title")!.textContent = shop.name;
    $("shop-meta")!.textContent = `${shop.city}, ${shop.state} · ${shop.phone || "Contact details available from the shop"}`;
    $("timezone-pill")!.textContent = shop.timezone;
    $("location-note")!.textContent = `${shop.address_line1 ? `${shop.address_line1}, ` : ""}${shop.city}, ${shop.state}${shop.postal_code ? ` ${shop.postal_code}` : ""}`;

    if (serviceSelect) {
      for (const service of services) {
        const option = document.createElement("option"); option.value = service.id; option.textContent = `${service.name} · ${service.duration_minutes} min`; serviceSelect.append(option);
      }
      serviceSelect.disabled = services.length === 0;
    }
    buildDates();
    $("booking-panel")?.classList.remove("hidden");
    if (!services.length) showAlert("This shop has not published any services yet.");
  }

  serviceSelect?.addEventListener("change", () => { if (dateSelect) dateSelect.value = ""; if (timeSelect) { timeSelect.value = ""; timeSelect.disabled = true; } clearAlert(); });
  dateSelect?.addEventListener("change", () => { clearAlert(); refreshSlots().catch(() => showAlert("Unable to refresh live time slots.")); });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault(); clearAlert();
    if (!shop || !serviceSelect || !dateSelect || !timeSelect) return;
    const service = selectedService();
    if (!service) return showAlert("Select a service.");
    submitButton!.disabled = true;
    try {
      const response = await fetch("/api/public/repair-booking", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          shop_slug: shop.slug,
          service_id: service.id,
          appointment_date: dateSelect.value,
          start_time: timeSelect.value,
          client_name: $<HTMLInputElement>("client-name")?.value,
          client_email: $<HTMLInputElement>("client-email")?.value,
          client_phone: $<HTMLInputElement>("client-phone")?.value,
          vehicle_year: Number($<HTMLInputElement>("vehicle-year")?.value),
          vehicle_make: $<HTMLInputElement>("vehicle-make")?.value,
          vehicle_model: $<HTMLInputElement>("vehicle-model")?.value,
          mileage: $<HTMLInputElement>("vehicle-mileage")?.value || null,
          vin: $<HTMLInputElement>("vehicle-vin")?.value || null,
        }),
      });
      const data = await readJson(response);
      if (!response.ok || !data.success || !data.booking) {
        if (data.error === "slot_unavailable") { showAlert("That time was just booked. Please choose another available time."); await refreshSlots(); return; }
        return showAlert(data.error || "Unable to create the appointment.");
      }
      lastBooking = data.booking;
      $("receipt-id")!.textContent = data.booking.id;
      $("receipt-shop")!.textContent = data.booking.shop_name;
      $("receipt-service")!.textContent = data.booking.service_name;
      $("receipt-vehicle")!.textContent = `${data.booking.vehicle.year} ${data.booking.vehicle.make} ${data.booking.vehicle.model}${data.booking.vehicle.mileage == null ? "" : ` · ${Number(data.booking.vehicle.mileage).toLocaleString()} mi`}`;
      $("receipt-date")!.textContent = data.booking.appointment_date;
      $("receipt-time")!.textContent = `${formatTime(data.booking.start_time)} – ${formatTime(data.booking.end_time)} (${data.booking.timezone})`;
      $("receipt-status")!.textContent = data.booking.status;
      $("success-summary")!.textContent = `${data.booking.client_name}, your appointment and vehicle details were written to the shop’s Hermes Connect booking inbox.`;
      $("booking-panel")?.classList.add("hidden");
      $("success-panel")?.classList.remove("hidden");
    } catch { showAlert("Network error while creating the appointment."); }
    finally { submitButton!.disabled = false; }
  });

  $("calendar-btn")?.addEventListener("click", () => {
    if (!lastBooking) return;
    const compact = (date: string, time: string) => `${date.replaceAll("-", "")}T${time.replace(":", "")}00`;
    const lines = [
      "BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//Hermes Connect//Repair Booking//EN", "BEGIN:VEVENT",
      `UID:${lastBooking.id}@hermeslogisticsus.com`,
      `DTSTART;TZID=${lastBooking.timezone}:${compact(lastBooking.appointment_date, lastBooking.start_time)}`,
      `DTEND;TZID=${lastBooking.timezone}:${compact(lastBooking.appointment_date, lastBooking.end_time)}`,
      `SUMMARY:${lastBooking.service_name} - ${lastBooking.shop_name}`,
      `DESCRIPTION:Hermes Connect booking ${lastBooking.id}`,
      "END:VEVENT", "END:VCALENDAR",
    ];
    const blob = new Blob([lines.join("\r\n")], { type: "text/calendar;charset=utf-8" });
    const url = URL.createObjectURL(blob); const anchor = document.createElement("a"); anchor.href = url; anchor.download = `${lastBooking.id}.ics`; anchor.click(); URL.revokeObjectURL(url);
  });

  loadShop().catch(() => showAlert("Unable to initialize this booking link."));
</script>

<style>
  .booking-page{min-height:100vh;padding:116px 24px 80px;color:#f7f8fb;background:radial-gradient(circle at 12% 8%,rgba(124,92,255,.16),transparent 34%),radial-gradient(circle at 88% 16%,rgba(63,185,255,.1),transparent 28%),#090a0f}.shell{width:min(920px,100%);margin:auto}.back-link{display:inline-flex;align-items:center;gap:8px;color:#a7adba;text-decoration:none;font-weight:700;margin-bottom:28px}.hero{margin-bottom:26px}.eyebrow{margin:0 0 8px;color:#9e8cff;text-transform:uppercase;letter-spacing:.12em;font-size:12px;font-weight:850}h1{margin:0 0 10px;font-size:clamp(34px,6vw,58px);line-height:1.02}h2{margin:0 0 8px;font-size:28px}.muted{margin:0;color:#a8adba;line-height:1.65}.panel,.trust-panel{border:1px solid rgba(255,255,255,.1);background:rgba(18,19,27,.88);box-shadow:0 22px 70px rgba(0,0,0,.28);backdrop-filter:blur(18px);border-radius:22px}.panel{padding:28px}.panel-heading{display:flex;justify-content:space-between;gap:22px;align-items:flex-start;margin-bottom:24px}.pill{padding:8px 11px;border-radius:999px;background:rgba(124,92,255,.14);border:1px solid rgba(157,136,255,.28);font-size:12px;font-weight:800;color:#d8d0ff}.booking-form{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{display:flex;flex-direction:column;gap:8px;color:#dfe2ea;font-size:13px;font-weight:750}.field input,.field select{width:100%;box-sizing:border-box;border:1px solid rgba(255,255,255,.11);border-radius:12px;padding:13px 14px;background:#10121a;color:#fff;font:inherit;outline:none}.field input:focus,.field select:focus{border-color:#8f78ff;box-shadow:0 0 0 3px rgba(143,120,255,.12)}.span-2{grid-column:1/-1}.divider{height:1px;background:rgba(255,255,255,.08);margin:2px 0}.section-label{display:flex;align-items:baseline;gap:10px;color:#f1f2f7}.section-label span{font-size:12px;color:#8f95a5;font-weight:500}.optional{color:#858b9a;font-size:11px;font-weight:600}.slot-state{padding:12px 14px;border-radius:12px;background:rgba(255,255,255,.035);color:#aab0bd;font-size:13px}.primary-btn,.secondary-btn{display:inline-flex;justify-content:center;align-items:center;gap:8px;border-radius:12px;padding:13px 17px;font-weight:850;cursor:pointer}.primary-btn{border:0;background:linear-gradient(135deg,#8068ff,#5baef7);color:white}.primary-btn:disabled{opacity:.55;cursor:not-allowed}.secondary-btn{border:1px solid rgba(255,255,255,.12);background:#151722;color:#fff}.alert{padding:14px 16px;border:1px solid rgba(255,114,114,.25);background:rgba(180,42,42,.14);border-radius:14px;color:#ffc4c4;margin-bottom:20px}.hidden{display:none!important}.success-panel{text-align:center}.success-icon{color:#79e7b1;margin-bottom:12px}.receipt{margin:24px auto;max-width:680px;text-align:left;border-top:1px solid rgba(255,255,255,.08)}.receipt div{display:grid;grid-template-columns:150px 1fr;gap:14px;padding:13px 0;border-bottom:1px solid rgba(255,255,255,.08)}.receipt dt{color:#9096a6}.receipt dd{margin:0;color:#f7f8fb;font-weight:720;overflow-wrap:anywhere}.trust-panel{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:20px;overflow:hidden}.trust-panel>div{display:flex;gap:10px;align-items:flex-start;padding:18px;background:rgba(255,255,255,.018);color:#adb3c0;font-size:13px;line-height:1.5}.trust-panel svg{flex:none;color:#9e8cff}@media(max-width:720px){.booking-page{padding:100px 16px 60px}.panel{padding:20px}.panel-heading{display:block}.pill{display:inline-block;margin-top:12px}.booking-form{grid-template-columns:1fr}.span-2{grid-column:auto}.section-label{display:block}.section-label span{display:block;margin-top:4px}.trust-panel{grid-template-columns:1fr}.receipt div{grid-template-columns:1fr;gap:4px}}
</style>