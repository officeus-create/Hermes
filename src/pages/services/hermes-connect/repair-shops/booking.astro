---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
---
<BaseLayout title="Repair Shop Booking | Hermes Connect" description="Book a real appointment with a repair shop using Hermes Connect scheduling." robots="noindex,nofollow">
<SiteHeader activePath="/paths/technology/" />
<main class="booking-page"><div class="shell">
<a class="back-link" href="/services/hermes-connect/repair-shops/">← <span data-b="0">Repair Shops</span></a>
<header class="hero"><p class="eyebrow" data-b="1">Hermes Connect · Public Booking</p><h1 id="shop-title" data-b="2">Loading repair shop…</h1><p id="shop-meta" class="muted" data-b="3">Loading shop profile, services, and hours.</p></header>
<div id="page-alert" class="alert hidden" role="status"></div>
<section id="booking-panel" class="panel hidden" aria-labelledby="booking-title"><div class="panel-heading"><div><p class="eyebrow" data-b="4">Real appointment intake</p><h2 id="booking-title" data-b="5">Book a service</h2><p class="muted" data-b="6">Live pilot. Service prices are set by the shop.</p></div><span id="timezone-pill" class="pill"></span></div>
<form id="booking-form" class="booking-form">
<label class="field span-2"><span data-b="7">Service</span><select id="service-select" required><option value="" data-b="8">Select a service</option></select></label>
<label class="field"><span data-b="9">Date</span><select id="date-select" required disabled><option value="" data-b="10">Select a date</option></select></label>
<label class="field"><span data-b="11">Time</span><select id="time-select" required disabled><option value="" data-b="12">Select a time</option></select></label>
<div id="slot-state" class="slot-state span-2" data-b="13">Choose a service and date to see availability.</div><div class="divider span-2"></div>
<div class="section-label span-2"><strong data-b="14">Vehicle</strong><span data-b="15">Helps the shop prepare for your visit.</span></div>
<label class="field"><span data-b="16">Year</span><input id="vehicle-year" type="number" min="1900" max="2100" inputmode="numeric" required placeholder="2021" /></label>
<label class="field"><span data-b="17">Make</span><input id="vehicle-make" maxlength="80" required placeholder="Ford" /></label>
<label class="field"><span data-b="18">Model</span><input id="vehicle-model" maxlength="80" required placeholder="F-150" /></label>
<label class="field"><span data-b="19">Mileage</span><input id="vehicle-mileage" type="number" min="0" max="2000000" inputmode="numeric" placeholder="84500" /></label>
<label class="field span-2"><span>VIN</span> <span class="optional" data-b="20">optional</span><input id="vehicle-vin" minlength="11" maxlength="17" autocomplete="off" placeholder="Optional VIN" data-bp /></label>
<div class="divider span-2"></div><div class="section-label span-2"><strong data-b="21">Contact</strong><span data-b="22">Used by the shop for this appointment.</span></div>
<label class="field"><span data-b="23">Full name</span><input id="client-name" minlength="2" maxlength="120" autocomplete="name" required /></label>
<label class="field"><span data-b="24">Phone</span><input id="client-phone" minlength="7" maxlength="40" autocomplete="tel" inputmode="tel" required /></label>
<label class="field span-2"><span>Email</span><input id="client-email" type="email" maxlength="200" autocomplete="email" required /></label>
<button id="submit-btn" class="primary-btn span-2" type="submit" data-b="25">Confirm appointment</button></form></section>
<section id="success-panel" class="panel success-panel hidden" aria-live="polite"><div class="success-icon">✓</div><p class="eyebrow" data-b="26">Booking created</p><h2 data-b="27">Appointment confirmed</h2><p id="success-summary" class="muted"></p><dl class="receipt"><div><dt data-b="28">Booking ID</dt><dd id="receipt-id"></dd></div><div><dt data-b="29">Shop</dt><dd id="receipt-shop"></dd></div><div><dt data-b="7">Service</dt><dd id="receipt-service"></dd></div><div><dt data-b="14">Vehicle</dt><dd id="receipt-vehicle"></dd></div><div><dt data-b="9">Date</dt><dd id="receipt-date"></dd></div><div><dt data-b="11">Time</dt><dd id="receipt-time"></dd></div><div><dt data-b="30">Status</dt><dd id="receipt-status"></dd></div></dl><button id="calendar-btn" class="secondary-btn" type="button"><span data-b="31">Add to calendar (.ics)</span></button></section>
<aside class="trust-panel"><div data-b="32">Services come from the shop workspace.</div><div data-b="33">Times reflect shop hours and bookings.</div><div id="location-note" data-b="34">Location comes from the public shop profile.</div></aside>
</div></main><SiteFooter />
</BaseLayout>
