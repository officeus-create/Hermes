---
import { ArrowLeft, CalendarDays, CheckCircle2, Clock3, MapPin, Wrench } from "@lucide/astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
---

<BaseLayout title="Repair Shop Booking | Hermes Connect" description="Book a real appointment with a repair shop using Hermes Connect scheduling." robots="noindex,nofollow">
  <SiteHeader activePath="/paths/technology/" />
  <main class="booking-page"><div class="shell">
    <a class="back-link" href="/services/hermes-connect/repair-shops/"><ArrowLeft size={16} /> <span data-b="back">Repair Shops</span></a>
    <header class="hero"><p class="eyebrow" data-b="pub">Hermes Connect · Public Booking</p><h1 id="shop-title" data-b="loading">Loading repair shop…</h1><p id="shop-meta" class="muted" data-b="loadingMeta">Loading shop profile, services, and hours.</p></header>
    <div id="page-alert" class="alert hidden" role="status"></div>

    <section id="booking-panel" class="panel hidden" aria-labelledby="booking-title">
      <div class="panel-heading"><div><p class="eyebrow" data-b="intake">Real appointment intake</p><h2 id="booking-title" data-b="book">Book a service</h2><p class="muted" data-b="pilot">Live pilot. Service prices are set by the shop.</p></div><span id="timezone-pill" class="pill"></span></div>
      <form id="booking-form" class="booking-form">
        <label class="field span-2"><span data-b="service">Service</span><select id="service-select" required><option value="" data-b="selectService">Select a service</option></select></label>
        <label class="field"><span data-b="date">Date</span><select id="date-select" required disabled><option value="" data-b="selectDate">Select a date</option></select></label>
        <label class="field"><span data-b="time">Time</span><select id="time-select" required disabled><option value="" data-b="selectTime">Select a time</option></select></label>
        <div id="slot-state" class="slot-state span-2" data-b="choose">Choose a service and date to see availability.</div>
        <div class="divider span-2"></div>
        <div class="section-label span-2"><strong data-b="vehicle">Vehicle</strong><span data-b="vehicleHelp">Helps the shop prepare for your visit.</span></div>
        <label class="field"><span data-b="year">Year</span><input id="vehicle-year" type="number" min="1900" max="2100" inputmode="numeric" required placeholder="2021" /></label>
        <label class="field"><span data-b="make">Make</span><input id="vehicle-make" minlength="1" maxlength="80" required placeholder="Ford" /></label>
        <label class="field"><span data-b="model">Model</span><input id="vehicle-model" minlength="1" maxlength="80" required placeholder="F-150" /></label>
        <label class="field"><span data-b="mileage">Mileage</span><input id="vehicle-mileage" type="number" min="0" max="2000000" inputmode="numeric" placeholder="84500" /></label>
        <label class="field span-2"><span>VIN</span> <span class="optional" data-b="optional">optional</span><input id="vehicle-vin" minlength="11" maxlength="17" autocomplete="off" placeholder="Optional VIN" data-bp="vin" /></label>
        <div class="divider span-2"></div>
        <div class="section-label span-2"><strong data-b="contact">Contact</strong><span data-b="contactHelp">Used by the shop for this appointment.</span></div>
        <label class="field"><span data-b="name">Full name</span><input id="client-name" minlength="2" maxlength="120" autocomplete="name" required /></label>
        <label class="field"><span data-b="phone">Phone</span><input id="client-phone" minlength="7" maxlength="40" autocomplete="tel" inputmode="tel" required /></label>
        <label class="field span-2"><span>Email</span><input id="client-email" type="email" maxlength="200" autocomplete="email" required /></label>
        <button id="submit-btn" class="primary-btn span-2" type="submit" data-b="confirm">Confirm appointment</button>
      </form>
    </section>

    <section id="success-panel" class="panel success-panel hidden" aria-live="polite">
      <CheckCircle2 class="success-icon" size={54} /><p class="eyebrow" data-b="created">Booking created</p><h2 data-b="confirmed">Appointment confirmed</h2><p id="success-summary" class="muted"></p>
      <dl class="receipt"><div><dt data-b="bookingId">Booking ID</dt><dd id="receipt-id"></dd></div><div><dt data-b="shop">Shop</dt><dd id="receipt-shop"></dd></div><div><dt data-b="service">Service</dt><dd id="receipt-service"></dd></div><div><dt data-b="vehicle">Vehicle</dt><dd id="receipt-vehicle"></dd></div><div><dt data-b="date">Date</dt><dd id="receipt-date"></dd></div><div><dt data-b="time">Time</dt><dd id="receipt-time"></dd></div><div><dt data-b="status">Status</dt><dd id="receipt-status"></dd></div></dl>
      <button id="calendar-btn" class="secondary-btn" type="button"><CalendarDays size={17} /> <span data-b="calendar">Add to calendar (.ics)</span></button>
    </section>

    <aside class="trust-panel"><div><Wrench size={18} /><span data-b="trustServices">Services come from the shop workspace.</span></div><div><Clock3 size={18} /><span data-b="trustTimes">Times reflect shop hours and bookings.</span></div><div><MapPin size={18} /><span id="location-note" data-b="trustLocation">Location comes from the public shop profile.</span></div></aside>
  </div></main>
  <SiteFooter />
</BaseLayout>

<script>
  type Service={id:string;name:string;duration_minutes:number};
  type Day={day_of_week:number;is_open:boolean;start_time:string|null;end_time:string|null};
  type Shop={id:string;name:string;slug:string;phone?:string|null;address_line1?:string|null;city:string;state:string;postal_code?:string|null;timezone:string};
  type Busy={start_time:string;end_time:string;status:string};
  type Locale="en"|"ru"|"uk"|"es"|"it"|"fr";
  type Copy=Record<string,string>;

  const S:Record<Exclude<Locale,"en">,Copy>={
    ru:{back:"СТО",pub:"Hermes Connect · публичная запись",loading:"Загружаем СТО…",loadingMeta:"Загружаем профиль и график.",intake:"Запись на визит",book:"Записаться на услугу",pilot:"Действующий пилот. Цены устанавливает СТО.",service:"Услуга",selectService:"Выберите услугу",date:"Дата",selectDate:"Выберите дату",time:"Время",selectTime:"Выберите время",choose:"Выберите услугу и дату, чтобы увидеть свободное время.",vehicle:"Автомобиль",vehicleHelp:"Поможет СТО подготовиться к визиту.",year:"Год",make:"Марка",model:"Модель",mileage:"Пробег",optional:"необязательно",contact:"Контакты",contactHelp:"СТО использует их для этой записи.",name:"Имя и фамилия",phone:"Телефон",confirm:"Подтвердить запись",created:"Запись создана",confirmed:"Запись подтверждена",bookingId:"ID записи",shop:"СТО",status:"Статус",calendar:"Добавить в календарь (.ics)",trustServices:"Услуги загружаются из кабинета СТО.",trustTimes:"Время учитывает график и записи СТО.",trustLocation:"Адрес загружается из профиля СТО.",vin:"VIN, необязательно"},
    uk:{back:"СТО",pub:"Hermes Connect · Онлайн-запис",loading:"Завантажуємо СТО…",loadingMeta:"Завантажуємо профіль і графік.",intake:"Запис на візит",book:"Записатися на послугу",pilot:"Діючий пілот. Ціни встановлює СТО.",service:"Послуга",selectService:"Оберіть послугу",date:"Дата",selectDate:"Оберіть дату",time:"Час",selectTime:"Оберіть час",choose:"Оберіть послугу й дату, щоб побачити вільний час.",vehicle:"Автомобіль",vehicleHelp:"Допоможе СТО підготуватися до візиту.",year:"Рік",make:"Марка",model:"Модель",mileage:"Пробіг",optional:"необов’язково",contact:"Контакти",contactHelp:"СТО використовує їх для цього запису.",name:"Ім’я та прізвище",phone:"Телефон",confirm:"Підтвердити запис",created:"Запис створено",confirmed:"Запис підтверджено",bookingId:"ID запису",shop:"СТО",status:"Статус",calendar:"Додати до календаря (.ics)",trustServices:"Послуги завантажуються з кабінету СТО.",trustTimes:"Час враховує графік і записи СТО.",trustLocation:"Адреса завантажується з профілю СТО.",vin:"VIN, необов’язково"},
    es:{back:"Talleres",pub:"Hermes Connect · Reserva pública",loading:"Cargando taller…",loadingMeta:"Cargando perfil y horario.",intake:"Solicitud de cita",book:"Reservar un servicio",pilot:"Piloto activo. El taller fija sus precios.",service:"Servicio",selectService:"Selecciona un servicio",date:"Fecha",selectDate:"Selecciona una fecha",time:"Hora",selectTime:"Selecciona una hora",choose:"Selecciona servicio y fecha para ver disponibilidad.",vehicle:"Vehículo",vehicleHelp:"Ayuda al taller a preparar tu visita.",year:"Año",make:"Marca",model:"Modelo",mileage:"Kilometraje",optional:"opcional",contact:"Contacto",contactHelp:"El taller los usa para esta cita.",name:"Nombre completo",phone:"Teléfono",confirm:"Confirmar cita",created:"Reserva creada",confirmed:"Cita confirmada",bookingId:"ID de reserva",shop:"Taller",status:"Estado",calendar:"Añadir al calendario (.ics)",trustServices:"Los servicios vienen del espacio del taller.",trustTimes:"Los horarios reflejan agenda y reservas.",trustLocation:"La ubicación viene del perfil público.",vin:"VIN opcional"},
    it:{back:"Officine",pub:"Hermes Connect · Prenotazione pubblica",loading:"Caricamento officina…",loadingMeta:"Caricamento profilo e orari.",intake:"Richiesta appuntamento",book:"Prenota un servizio",pilot:"Pilota attivo. L’officina stabilisce i prezzi.",service:"Servizio",selectService:"Seleziona un servizio",date:"Data",selectDate:"Seleziona una data",time:"Ora",selectTime:"Seleziona un orario",choose:"Seleziona servizio e data per vedere la disponibilità.",vehicle:"Veicolo",vehicleHelp:"Aiuta l’officina a preparare la visita.",year:"Anno",make:"Marca",model:"Modello",mileage:"Chilometraggio",optional:"facoltativo",contact:"Contatti",contactHelp:"L’officina li usa per questo appuntamento.",name:"Nome e cognome",phone:"Telefono",confirm:"Conferma appuntamento",created:"Prenotazione creata",confirmed:"Appuntamento confermato",bookingId:"ID prenotazione",shop:"Officina",status:"Stato",calendar:"Aggiungi al calendario (.ics)",trustServices:"I servizi vengono dall’area dell’officina.",trustTimes:"Gli orari riflettono agenda e prenotazioni.",trustLocation:"La posizione viene dal profilo pubblico.",vin:"VIN facoltativo"},
    fr:{back:"Garages",pub:"Hermes Connect · Réservation publique",loading:"Chargement du garage…",loadingMeta:"Chargement du profil et des horaires.",intake:"Demande de rendez-vous",book:"Réserver un service",pilot:"Pilote actif. Le garage fixe ses prix.",service:"Service",selectService:"Sélectionnez un service",date:"Date",selectDate:"Sélectionnez une date",time:"Heure",selectTime:"Sélectionnez une heure",choose:"Choisissez service et date pour voir les disponibilités.",vehicle:"Véhicule",vehicleHelp:"Aide le garage à préparer votre visite.",year:"Année",make:"Marque",model:"Modèle",mileage:"Kilométrage",optional:"facultatif",contact:"Contact",contactHelp:"Le garage les utilise pour ce rendez-vous.",name:"Nom complet",phone:"Téléphone",confirm:"Confirmer le rendez-vous",created:"Réservation créée",confirmed:"Rendez-vous confirmé",bookingId:"ID de réservation",shop:"Garage",status:"Statut",calendar:"Ajouter au calendrier (.ics)",trustServices:"Les services viennent de l’espace du garage.",trustTimes:"Les horaires reflètent l’agenda et les réservations.",trustLocation:"L’adresse vient du profil public.",vin:"VIN facultatif"}
  };
  const R:Record<Locale,Copy>={
    en:{noDays:"This shop has no booking days yet.",closed:"The shop is closed on this date.",checking:"Checking bookings…",availabilityError:"Unable to load live availability.",noTimes:"No open times remain on this date.",missing:"This booking link is missing its shop identifier.",inactive:"This repair shop booking link is not active.",loadError:"Unable to load this repair shop.",contact:"Contact details available from the shop",noServices:"This shop has not published services yet.",refresh:"Unable to refresh live time slots.",select:"Select a service.",taken:"That time was just booked. Choose another time.",create:"Unable to create the appointment.",network:"Network error while creating the appointment.",init:"Unable to initialize this booking link.",min:"min",one:"1 live time available.",many:"{count} live times available.",success:"{name}, your appointment and vehicle were saved to the shop booking inbox.",cal:"Hermes Connect booking {id}",confirmed:"Confirmed",pending:"Pending",progress:"In progress",completed:"Completed",cancelled:"Cancelled"},
    ru:{noDays:"СТО пока не открыло дни для записи.",closed:"В эту дату СТО закрыто.",checking:"Проверяем записи…",availabilityError:"Не удалось загрузить актуальное свободное время.",noTimes:"На эту дату свободного времени нет.",missing:"В ссылке отсутствует идентификатор СТО. Попросите актуальную ссылку Hermes Connect.",inactive:"Эта ссылка на запись сейчас неактивна.",loadError:"Не удалось загрузить СТО.",contact:"Контакты доступны у СТО",noServices:"СТО пока не опубликовало услуги.",refresh:"Не удалось обновить свободное время.",select:"Выберите услугу.",taken:"Это время только что заняли. Выберите другое.",create:"Не удалось создать запись.",network:"Ошибка сети при создании записи.",init:"Не удалось открыть ссылку записи.",min:"мин",one:"Доступно 1 время.",many:"Доступно вариантов: {count}.",success:"{name}, запись и автомобиль сохранены в Hermes Connect СТО.",cal:"Запись Hermes Connect {id}",confirmed:"Подтверждено",pending:"Ожидает",progress:"В работе",completed:"Завершено",cancelled:"Отменено"},
    uk:{noDays:"СТО ще не відкрило дні для запису.",closed:"У цю дату СТО зачинене.",checking:"Перевіряємо записи…",availabilityError:"Не вдалося завантажити вільний час.",noTimes:"На цю дату вільного часу немає.",missing:"У посиланні немає ідентифікатора СТО.",inactive:"Це посилання на запис зараз неактивне.",loadError:"Не вдалося завантажити СТО.",contact:"Контакти доступні у СТО",noServices:"СТО ще не опублікувало послуги.",refresh:"Не вдалося оновити вільний час.",select:"Оберіть послугу.",taken:"Цей час щойно зайняли. Оберіть інший.",create:"Не вдалося створити запис.",network:"Помилка мережі під час створення запису.",init:"Не вдалося відкрити посилання запису.",min:"хв",one:"Доступний 1 час.",many:"Доступно варіантів: {count}.",success:"{name}, запис і автомобіль збережено в Hermes Connect СТО.",cal:"Запис Hermes Connect {id}",confirmed:"Підтверджено",pending:"Очікує",progress:"У роботі",completed:"Завершено",cancelled:"Скасовано"},
    es:{noDays:"El taller aún no abrió días de reserva.",closed:"El taller está cerrado en esta fecha.",checking:"Comprobando reservas…",availabilityError:"No se pudo cargar la disponibilidad.",noTimes:"No quedan horas disponibles en esa fecha.",missing:"Falta el identificador del taller en este enlace.",inactive:"Este enlace de reserva no está activo.",loadError:"No se pudo cargar el taller.",contact:"Contacto disponible en el taller",noServices:"El taller aún no publicó servicios.",refresh:"No se pudieron actualizar las horas.",select:"Selecciona un servicio.",taken:"Esa hora acaba de reservarse. Elige otra.",create:"No se pudo crear la cita.",network:"Error de red al crear la cita.",init:"No se pudo abrir este enlace.",min:"min",one:"Hay 1 hora disponible.",many:"Hay {count} horas disponibles.",success:"{name}, tu cita y vehículo se guardaron en Hermes Connect.",cal:"Reserva Hermes Connect {id}",confirmed:"Confirmada",pending:"Pendiente",progress:"En curso",completed:"Completada",cancelled:"Cancelada"},
    it:{noDays:"L’officina non ha ancora aperto giorni di prenotazione.",closed:"L’officina è chiusa in questa data.",checking:"Verifica prenotazioni…",availabilityError:"Impossibile caricare la disponibilità.",noTimes:"Non restano orari disponibili in quella data.",missing:"Manca l’identificativo dell’officina nel link.",inactive:"Questo link di prenotazione non è attivo.",loadError:"Impossibile caricare l’officina.",contact:"Contatti disponibili presso l’officina",noServices:"L’officina non ha ancora pubblicato servizi.",refresh:"Impossibile aggiornare gli orari.",select:"Seleziona un servizio.",taken:"Questo orario è appena stato prenotato. Scegline un altro.",create:"Impossibile creare l’appuntamento.",network:"Errore di rete durante la prenotazione.",init:"Impossibile aprire questo link.",min:"min",one:"È disponibile 1 orario.",many:"Sono disponibili {count} orari.",success:"{name}, appuntamento e veicolo sono salvati in Hermes Connect.",cal:"Prenotazione Hermes Connect {id}",confirmed:"Confermato",pending:"In attesa",progress:"In corso",completed:"Completato",cancelled:"Annullato"},
    fr:{noDays:"Le garage n’a pas encore ouvert de jours de réservation.",closed:"Le garage est fermé à cette date.",checking:"Vérification des réservations…",availabilityError:"Impossible de charger les disponibilités.",noTimes:"Aucun créneau ne reste à cette date.",missing:"L’identifiant du garage manque dans ce lien.",inactive:"Ce lien de réservation n’est pas actif.",loadError:"Impossible de charger le garage.",contact:"Coordonnées disponibles auprès du garage",noServices:"Le garage n’a pas encore publié de services.",refresh:"Impossible d’actualiser les créneaux.",select:"Sélectionnez un service.",taken:"Ce créneau vient d’être réservé. Choisissez-en un autre.",create:"Impossible de créer le rendez-vous.",network:"Erreur réseau pendant la réservation.",init:"Impossible d’ouvrir ce lien.",min:"min",one:"1 créneau est disponible.",many:"{count} créneaux sont disponibles.",success:"{name}, votre rendez-vous et véhicule sont enregistrés dans Hermes Connect.",cal:"Réservation Hermes Connect {id}",confirmed:"Confirmé",pending:"En attente",progress:"En cours",completed:"Terminé",cancelled:"Annulé"}
  };

  const params=new URLSearchParams(location.search), requested=(params.get("lang")||"en").toLowerCase();
  const locale:Locale=(new Set(["en","ru","uk","es","it","fr"]).has(requested)?requested:"en") as Locale;
  const intl:Record<Locale,string>={en:"en-US",ru:"ru-RU",uk:"uk-UA",es:"es-ES",it:"it-IT",fr:"fr-FR"};
  const fill=(s:string,v:Record<string,string|number>={})=>Object.entries(v).reduce((a,[k,x])=>a.replaceAll(`{${k}}`,String(x)),s);
  const r=(k:string,v:Record<string,string|number>={})=>fill(R[locale][k]||R.en[k]||k,v);
  if(locale!=="en"){
    const c=S[locale as Exclude<Locale,"en">];
    document.querySelectorAll<HTMLElement>("[data-b]").forEach(n=>{const k=n.dataset.b;if(k&&c[k])n.textContent=c[k]});
    document.querySelectorAll<HTMLInputElement>("[data-bp]").forEach(n=>{const k=n.dataset.bp;if(k&&c[k])n.placeholder=c[k]});
  }

  const $=<T extends HTMLElement=HTMLElement>(id:string)=>document.getElementById(id) as T|null;
  const alertBox=$("page-alert"), form=$<HTMLFormElement>("booking-form"), serviceSelect=$<HTMLSelectElement>("service-select"), dateSelect=$<HTMLSelectElement>("date-select"), timeSelect=$<HTMLSelectElement>("time-select"), submit=$<HTMLButtonElement>("submit-btn");
  let shop:Shop|null=null,services:Service[]=[],days:Day[]=[],last:any=null;
  const show=(m:string)=>{if(alertBox){alertBox.textContent=m;alertBox.className="alert"}}, clear=()=>{if(alertBox){alertBox.textContent="";alertBox.className="alert hidden"}};
  const json=async(res:Response)=>{try{return await res.json()}catch{return{success:false,error:"invalid_server_response"}}};
  const friendly=(code:unknown,fallback:string)=>code==="shop_not_found"?r("inactive"):code==="slot_unavailable"?r("taken"):r(fallback);
  const status=(v:unknown)=>({confirmed:r("confirmed"),pending:r("pending"),in_progress:r("progress"),completed:r("completed"),cancelled:r("cancelled"),canceled:r("cancelled")}[String(v||"").toLowerCase()]||r("pending"));
  const mins=(v:string)=>{const[h,m]=v.split(":").map(Number);return h*60+m}, clock=(v:number)=>`${String(Math.floor(v/60)).padStart(2,"0")}:${String(v%60).padStart(2,"0")}`;
  const formatTime=(v:string)=>{const[h,m]=v.split(":").map(Number);return new Intl.DateTimeFormat(intl[locale],{hour:"numeric",minute:"2-digit",timeZone:"UTC"}).format(new Date(Date.UTC(2026,0,1,h,m)))};
  const localDate=(tz:string)=>{const p=new Intl.DateTimeFormat("en-US",{timeZone:tz,year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(new Date()),x=(t:string)=>p.find(i=>i.type===t)?.value||"";return`${x("year")}-${x("month")}-${x("day")}`};

  function buildDates(){if(!shop||!dateSelect)return;const base=new Date(`${localDate(shop.timezone)}T12:00:00Z`);dateSelect.innerHTML=`<option value="">${locale==="en"?"Select a date":S[locale as Exclude<Locale,"en">].selectDate}</option>`;let n=0;for(let o=0;o<=21;o++){const d=new Date(base.getTime()+o*86400000),day=days.find(x=>x.day_of_week===d.getUTCDay());if(!day?.is_open||!day.start_time||!day.end_time)continue;const opt=document.createElement("option");opt.value=d.toISOString().slice(0,10);opt.textContent=new Intl.DateTimeFormat(intl[locale],{weekday:"short",month:"short",day:"numeric",timeZone:"UTC"}).format(d);dateSelect.append(opt);n++}dateSelect.disabled=n===0;if(!n)show(r("noDays"))}
  const selected=()=>services.find(x=>x.id===serviceSelect?.value)||null;

  async function slots(){if(!shop||!dateSelect||!timeSelect)return;const svc=selected(),date=dateSelect.value,selectTime=locale==="en"?"Select a time":S[locale as Exclude<Locale,"en">].selectTime;timeSelect.innerHTML=`<option value="">${selectTime}</option>`;timeSelect.disabled=true;if(!svc||!date){$("slot-state")!.textContent=locale==="en"?"Choose a service and date to see availability.":S[locale as Exclude<Locale,"en">].choose;return}const day=days.find(x=>x.day_of_week===new Date(`${date}T12:00:00Z`).getUTCDay());if(!day?.is_open||!day.start_time||!day.end_time){$("slot-state")!.textContent=r("closed");return}$("slot-state")!.textContent=r("checking");const res=await fetch(`/api/public/repair-booking?shop=${encodeURIComponent(shop.slug)}&date=${encodeURIComponent(date)}`),data=await json(res);if(!res.ok||!data.success){$("slot-state")!.textContent=friendly(data.error,"availabilityError");return}const busy=Array.isArray(data.busy)?data.busy as Busy[]:[];let count=0;for(let start=mins(day.start_time);start+svc.duration_minutes<=mins(day.end_time);start+=30){const end=start+svc.duration_minutes;if(busy.some(x=>start<mins(x.end_time)&&end>mins(x.start_time)))continue;const value=clock(start),opt=document.createElement("option");opt.value=value;opt.textContent=`${formatTime(value)} · ${svc.duration_minutes} ${r("min")}`;timeSelect.append(opt);count++}timeSelect.disabled=!count;$("slot-state")!.textContent=!count?r("noTimes"):count===1?r("one"):r("many",{count})}

  async function load(){const slug=params.get("shop")?.trim()||"";if(!slug){show(r("missing"));return}const res=await fetch(`/api/public/repair-shop?slug=${encodeURIComponent(slug)}`),data=await json(res);if(!res.ok||!data.success||!data.shop){show(friendly(data.error,"loadError"));return}const loadedShop=data.shop as Shop;shop=loadedShop;services=Array.isArray(data.services)?data.services:[];days=Array.isArray(data.availability)?data.availability:[];$("shop-title")!.textContent=loadedShop.name;$("shop-meta")!.textContent=`${loadedShop.city}, ${loadedShop.state} · ${loadedShop.phone||r("contact")}`;$("timezone-pill")!.textContent=loadedShop.timezone;$("location-note")!.textContent=`${loadedShop.address_line1?`${loadedShop.address_line1}, `:""}${loadedShop.city}, ${loadedShop.state}${loadedShop.postal_code?` ${loadedShop.postal_code}`:""}`;if(serviceSelect){const label=locale==="en"?"Select a service":S[locale as Exclude<Locale,"en">].selectService;serviceSelect.innerHTML=`<option value="">${label}</option>`;for(const svc of services){const opt=document.createElement("option");opt.value=svc.id;opt.textContent=`${svc.name} · ${svc.duration_minutes} ${r("min")}`;serviceSelect.append(opt)}serviceSelect.disabled=!services.length}buildDates();$("booking-panel")?.classList.remove("hidden");if(!services.length)show(r("noServices"))}

  serviceSelect?.addEventListener("change",()=>{if(dateSelect)dateSelect.value="";if(timeSelect){timeSelect.value="";timeSelect.disabled=true}clear();$("slot-state")!.textContent=locale==="en"?"Choose a service and date to see availability.":S[locale as Exclude<Locale,"en">].choose});
  dateSelect?.addEventListener("change",()=>{clear();slots().catch(()=>show(r("refresh")))});
  form?.addEventListener("submit",async e=>{e.preventDefault();clear();if(!shop||!serviceSelect||!dateSelect||!timeSelect)return;const svc=selected();if(!svc)return show(r("select"));submit!.disabled=true;try{const res=await fetch("/api/public/repair-booking",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({shop_slug:shop.slug,service_id:svc.id,appointment_date:dateSelect.value,start_time:timeSelect.value,client_name:$<HTMLInputElement>("client-name")?.value,client_email:$<HTMLInputElement>("client-email")?.value,client_phone:$<HTMLInputElement>("client-phone")?.value,vehicle_year:Number($<HTMLInputElement>("vehicle-year")?.value),vehicle_make:$<HTMLInputElement>("vehicle-make")?.value,vehicle_model:$<HTMLInputElement>("vehicle-model")?.value,mileage:$<HTMLInputElement>("vehicle-mileage")?.value||null,vin:$<HTMLInputElement>("vehicle-vin")?.value||null})}),data=await json(res);if(!res.ok||!data.success||!data.booking){if(data.error==="slot_unavailable"){show(r("taken"));await slots();return}show(friendly(data.error,"create"));return}last=data.booking;$("receipt-id")!.textContent=last.id;$("receipt-shop")!.textContent=last.shop_name;$("receipt-service")!.textContent=last.service_name;$("receipt-vehicle")!.textContent=`${last.vehicle.year} ${last.vehicle.make} ${last.vehicle.model}${last.vehicle.mileage==null?"":` · ${Number(last.vehicle.mileage).toLocaleString(intl[locale])} mi`}`;$("receipt-date")!.textContent=new Intl.DateTimeFormat(intl[locale],{year:"numeric",month:"long",day:"numeric",timeZone:"UTC"}).format(new Date(`${last.appointment_date}T12:00:00Z`));$("receipt-time")!.textContent=`${formatTime(last.start_time)} – ${formatTime(last.end_time)} (${last.timezone})`;$("receipt-status")!.textContent=status(last.status);$("success-summary")!.textContent=r("success",{name:last.client_name});$("booking-panel")?.classList.add("hidden");$("success-panel")?.classList.remove("hidden")}catch{show(r("network"))}finally{submit!.disabled=false}});
  $("calendar-btn")?.addEventListener("click",()=>{if(!last)return;const compact=(d:string,t:string)=>`${d.replaceAll("-","")}T${t.replace(":","")}00`,lines=["BEGIN:VCALENDAR","VERSION:2.0","PRODID:-//Hermes Connect//Repair Booking//EN","BEGIN:VEVENT",`UID:${last.id}@hermeslogisticsus.com`,`DTSTART;TZID=${last.timezone}:${compact(last.appointment_date,last.start_time)}`,`DTEND;TZID=${last.timezone}:${compact(last.appointment_date,last.end_time)}`,`SUMMARY:${last.service_name} - ${last.shop_name}`,`DESCRIPTION:${r("cal",{id:last.id})}`,"END:VEVENT","END:VCALENDAR"],blob=new Blob([lines.join("\r\n")],{type:"text/calendar;charset=utf-8"}),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download=`${last.id}.ics`;a.click();URL.revokeObjectURL(url)});
  load().catch(()=>show(r("init")));
</script>

