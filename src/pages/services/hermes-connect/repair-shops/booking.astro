---
import { ArrowLeft, CalendarDays, CheckCircle2, Clock3, MapPin, Wrench } from "@lucide/astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
---

<BaseLayout
  title="Repair Shop Booking | Hermes Connect"
  description="Book a real appointment with a repair shop using Hermes Connect scheduling."
  robots="noindex,nofollow"
>
  <SiteHeader activePath="/paths/technology/" />
  <main class="booking-page">
    <div class="shell">
      <a class="back-link" href="/services/hermes-connect/repair-shops/"><ArrowLeft size={16} /> <span data-booking-copy="back">Repair Shops</span></a>

      <header class="hero">
        <p class="eyebrow" data-booking-copy="publicBooking">Hermes Connect · Public Booking</p>
        <h1 id="shop-title" data-booking-copy="loadingShop">Loading repair shop…</h1>
        <p id="shop-meta" class="muted" data-booking-copy="loadingMeta">Loading shop profile, services, and hours.</p>
      </header>

      <div id="page-alert" class="alert hidden" role="status"></div>

      <section id="booking-panel" class="panel hidden" aria-labelledby="booking-title">
        <div class="panel-heading">
          <div>
            <p class="eyebrow" data-booking-copy="intake">Real appointment intake</p>
            <h2 id="booking-title" data-booking-copy="bookService">Book a service</h2>
            <p class="muted" data-booking-copy="pilotNote">Hermes Connect Repair Shops is the current live pilot. Repair service pricing is set by each participating shop.</p>
          </div>
          <span id="timezone-pill" class="pill"></span>
        </div>

        <form id="booking-form" class="booking-form">
          <label class="field span-2"><span data-booking-copy="service">Service</span>
            <select id="service-select" required>
              <option value="" data-booking-copy="selectService">Select a service</option>
            </select>
          </label>

          <label class="field"><span data-booking-copy="date">Date</span>
            <select id="date-select" required disabled>
              <option value="" data-booking-copy="selectDate">Select a date</option>
            </select>
          </label>

          <label class="field"><span data-booking-copy="time">Time</span>
            <select id="time-select" required disabled>
              <option value="" data-booking-copy="selectTime">Select a time</option>
            </select>
          </label>

          <div id="slot-state" class="slot-state span-2" data-booking-copy="chooseAvailability">Choose a service and date to load current availability.</div>

          <div class="divider span-2"></div>
          <div class="section-label span-2"><strong data-booking-copy="vehicle">Vehicle</strong><span data-booking-copy="vehicleHelp">Saved with this appointment so the shop can prepare before you arrive.</span></div>
          <label class="field"><span data-booking-copy="year">Year</span><input id="vehicle-year" type="number" min="1900" max="2100" inputmode="numeric" required placeholder="2021" /></label>
          <label class="field"><span data-booking-copy="make">Make</span><input id="vehicle-make" minlength="1" maxlength="80" required placeholder="Ford" /></label>
          <label class="field"><span data-booking-copy="model">Model</span><input id="vehicle-model" minlength="1" maxlength="80" required placeholder="F-150" /></label>
          <label class="field"><span data-booking-copy="mileage">Mileage</span><input id="vehicle-mileage" type="number" min="0" max="2000000" inputmode="numeric" placeholder="84500" /></label>
          <label class="field span-2"><span data-booking-copy="vin">VIN</span> <span class="optional" data-booking-copy="optional">optional</span><input id="vehicle-vin" minlength="11" maxlength="17" autocomplete="off" placeholder="Optional vehicle identification number" data-booking-placeholder="vinPlaceholder" /></label>

          <div class="divider span-2"></div>
          <div class="section-label span-2"><strong data-booking-copy="contact">Contact</strong><span data-booking-copy="contactHelp">The repair shop uses this information for your appointment.</span></div>
          <label class="field"><span data-booking-copy="fullName">Full name</span><input id="client-name" minlength="2" maxlength="120" autocomplete="name" required /></label>
          <label class="field"><span data-booking-copy="phone">Phone</span><input id="client-phone" minlength="7" maxlength="40" autocomplete="tel" inputmode="tel" required /></label>
          <label class="field span-2"><span data-booking-copy="email">Email</span><input id="client-email" type="email" maxlength="200" autocomplete="email" required /></label>

          <button id="submit-btn" class="primary-btn span-2" type="submit" data-booking-copy="confirm">Confirm appointment</button>
        </form>
      </section>

      <section id="success-panel" class="panel success-panel hidden" aria-live="polite">
        <CheckCircle2 class="success-icon" size={54} />
        <p class="eyebrow" data-booking-copy="created">Production booking created</p>
        <h2 data-booking-copy="confirmed">Appointment confirmed</h2>
        <p id="success-summary" class="muted"></p>
        <dl class="receipt">
          <div><dt data-booking-copy="bookingId">Booking ID</dt><dd id="receipt-id"></dd></div>
          <div><dt data-booking-copy="shop">Shop</dt><dd id="receipt-shop"></dd></div>
          <div><dt data-booking-copy="service">Service</dt><dd id="receipt-service"></dd></div>
          <div><dt data-booking-copy="vehicle">Vehicle</dt><dd id="receipt-vehicle"></dd></div>
          <div><dt data-booking-copy="date">Date</dt><dd id="receipt-date"></dd></div>
          <div><dt data-booking-copy="time">Time</dt><dd id="receipt-time"></dd></div>
          <div><dt data-booking-copy="status">Status</dt><dd id="receipt-status"></dd></div>
        </dl>
        <button id="calendar-btn" class="secondary-btn" type="button"><CalendarDays size={17} /> <span data-booking-copy="addCalendar">Add to calendar (.ics)</span></button>
      </section>

      <aside class="trust-panel">
        <div><Wrench size={18} /><span data-booking-copy="trustServices">Services come from this shop’s owner workspace.</span></div>
        <div><Clock3 size={18} /><span data-booking-copy="trustTimes">Times are checked against the shop’s saved weekly hours and existing bookings.</span></div>
        <div><MapPin size={18} /><span id="location-note" data-booking-copy="trustLocation">Shop location loads from the saved public profile.</span></div>
      </aside>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

