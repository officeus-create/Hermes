<script is:inline>
  // Customer-Facing Booking Portal Logic
  document.addEventListener('DOMContentLoaded', () => {
    let currentStep = 1;
    const maxSteps = 4;

    // Elements
    const form = document.getElementById('booking-form');
    const wizardCard = document.getElementById('booking-wizard-card');
    const successCard = document.getElementById('booking-success-card');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const submitBtn = document.getElementById('submit-btn');

    // Init custom checked class for service options
    const serviceLabels = document.querySelectorAll('.service-option');
    serviceLabels.forEach(label => {
      const radio = label.querySelector('input[type="radio"]');
      if (radio.checked) {
        label.classList.add('checked');
      }
      radio.addEventListener('change', () => {
        serviceLabels.forEach(l => l.classList.remove('checked'));
        if (radio.checked) {
          label.classList.add('checked');
        }
      });
    });

    // Init custom checked class for day options
    const dayLabels = document.querySelectorAll('.day-option');
    dayLabels.forEach(label => {
      const radio = label.querySelector('input[type="radio"]');
      if (radio.checked) {
        label.classList.add('checked');
      }
      radio.addEventListener('change', () => {
        dayLabels.forEach(l => l.classList.remove('checked'));
        if (radio.checked) {
          label.classList.add('checked');
          updateSlotsAvailability();
        }
      });
    });

    // Init custom checked class for slot options
    const slotLabels = document.querySelectorAll('.slot-option');
    slotLabels.forEach(label => {
      const radio = label.querySelector('input[type="radio"]');
      if (radio.checked) {
        label.classList.add('checked');
      }
      radio.addEventListener('change', () => {
        if (label.classList.contains('exhausted')) {
          radio.checked = false;
          return;
        }
        slotLabels.forEach(l => l.classList.remove('checked'));
        if (radio.checked) {
          label.classList.add('checked');
        }
      });
    });

    // Slots Capacity Engine
    function updateSlotsAvailability() {
      const selectedDayInput = document.querySelector('input[name="selected_day"]:checked');
      if (!selectedDayInput) return;
      const day = selectedDayInput.value;

      // Read current bookings from local storage
      let bookings = [];
      try {
        const bookingsStr = localStorage.getItem('hermes_connect_bookings');
        if (bookingsStr) bookings = JSON.parse(bookingsStr);
      } catch (e) {
        // Safe fail
      }

      // Count bookings per slot for the selected day
      const capacityMap = {};
      bookings.forEach(b => {
        if (b.status !== 'CANCELLED' && b.date_id === day) {
          capacityMap[b.time_slot_id] = (capacityMap[b.time_slot_id] || 0) + 1;
        }
      });

      // Update slot displays
      const slotInputs = document.querySelectorAll('input[name="selected_slot"]');
      slotInputs.forEach(input => {
        const slotId = input.value;
        const count = capacityMap[slotId] || 0;
        const remaining = Math.max(0, 3 - count);
        const label = document.getElementById(`label-slot-${slotId}`);
        const textSpan = document.getElementById(`capacity-slot-${slotId}`);

        if (label && textSpan) {
          if (remaining === 0) {
            label.classList.add('exhausted');
            textSpan.textContent = "Fully Booked (0/3)";
            textSpan.style.color = "#ff5c5c";
            if (input.checked) {
              input.checked = false;
              label.classList.remove('checked');
            }
          } else {
            label.classList.remove('exhausted');
            textSpan.textContent = `${remaining} of 3 Bays Open`;
            textSpan.style.color = "#319a75";
          }
        }
      });
    }

    // Step navigation
    function updateWizard() {
      // Hide all steps
      const sections = document.querySelectorAll('.step-section');
      sections.forEach(s => s.classList.remove('active'));

      // Show current step section
      const activeSection = document.querySelector(`[data-step-section="${currentStep}"]`);
      activeSection.classList.add('active');

      // Update step headers
      const indicators = document.querySelectorAll('[data-step-indicator]');
      indicators.forEach(ind => {
        const stepNum = parseInt(ind.dataset.stepIndicator);
        ind.classList.remove('active', 'completed');
        if (stepNum === currentStep) {
          ind.classList.add('active');
        } else if (stepNum < currentStep) {
          ind.classList.add('completed');
        }
      });

      // Nav buttons visibility
      if (currentStep === 1) {
        prevBtn.classList.add('hidden');
      } else {
        prevBtn.classList.remove('hidden');
      }

      if (currentStep === maxSteps) {
        nextBtn.classList.add('hidden');
        submitBtn.classList.remove('hidden');
      } else {
        nextBtn.classList.remove('hidden');
        submitBtn.classList.add('hidden');
      }
    }

    // Form inputs validation per step
    function validateStep(step) {
      if (step === 1) {
        const checked = document.querySelector('input[name="selected_service"]:checked');
        if (!checked) {
          alert('Please select a service before continuing.');
          return false;
        }
        return true;
      }
      if (step === 2) {
        const dayChecked = document.querySelector('input[name="selected_day"]:checked');
        const slotChecked = document.querySelector('input[name="selected_slot"]:checked');
        if (!dayChecked) {
          alert('Please select a weekday.');
          return false;
        }
        if (!slotChecked) {
          alert('Please select an available time slot.');
          return false;
        }
        const label = document.getElementById(`label-slot-${slotChecked.value}`);
        if (label && label.classList.contains('exhausted')) {
          alert('The selected slot is fully booked. Please choose another time.');
          return false;
        }
        return true;
      }
      if (step === 3) {
        const year = document.getElementById('vehicle_year').value;
        const make = document.getElementById('vehicle_make').value;
        const model = document.getElementById('vehicle_model').value;
        const mileage = document.getElementById('vehicle_mileage').value;
        if (!year || !make || !model || !mileage) {
          alert('All vehicle fields are required.');
          return false;
        }
        return true;
      }
      return true;
    }

    nextBtn.addEventListener('click', () => {
      if (validateStep(currentStep)) {
        currentStep++;
        updateWizard();
      }
    });

    prevBtn.addEventListener('click', () => {
      currentStep--;
      updateWizard();
    });

    // Form submission
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Final validate
      const name = document.getElementById('customer_name').value;
      const email = document.getElementById('customer_email').value;
      const phone = document.getElementById('customer_phone').value;
      const notes = document.getElementById('booking_notes').value;

      if (!name || !email || !phone) {
        alert('Please complete all contact details.');
        return;
      }

      // Collect complete state
      const serviceInput = document.querySelector('input[name="selected_service"]:checked');
      const dayInput = document.querySelector('input[name="selected_day"]:checked');
      const slotInput = document.querySelector('input[name="selected_slot"]:checked');
      
      const vYear = document.getElementById('vehicle_year').value;
      const vMake = document.getElementById('vehicle_make').value;
      const vModel = document.getElementById('vehicle_model').value;
      const vMileage = document.getElementById('vehicle_mileage').value;

      const bookingId = `booking-${Date.now()}`;
      const serviceName = serviceInput.dataset.name;
      const originalPrice = serviceInput.dataset.price;
      const weekdayLabel = dayInput.dataset.label;
      const slotTimeLabel = slotInput.dataset.label;

      const newBooking = {
        booking_id: bookingId,
        customer_name: name,
        customer_phone: phone,
        customer_email: email,
        service: serviceName,
        price: `${originalPrice} (Free during Beta)`,
        date: weekdayLabel,
        date_id: dayInput.value,
        time_slot: slotTimeLabel,
        time_slot_id: slotInput.value,
        vehicle: {
          make: vMake,
          model: vModel,
          year: vYear,
          mileage: vMileage
        },
        status: "NEW",
        notes: notes,
        created_at: new Date().toISOString()
      };

      // Persist to local storage
      let currentBookings = [];
      try {
        const storedStr = localStorage.getItem('hermes_connect_bookings');
        if (storedStr) currentBookings = JSON.parse(storedStr);
      } catch (err) {
        // fail safe
      }

      currentBookings.push(newBooking);
      localStorage.setItem('hermes_connect_bookings', JSON.stringify(currentBookings));

      // Trigger automatic Lead Store synchronization
      syncLeadStore(newBooking);

      // Populate Success Receipts
      document.getElementById('receipt-id').textContent = bookingId.replace('booking-', 'APX-').toUpperCase();
      document.getElementById('receipt-customer').textContent = name;
      document.getElementById('receipt-vehicle').textContent = `${vYear} ${vMake} ${vModel}`;
      document.getElementById('receipt-service').textContent = serviceName;
      document.getElementById('receipt-slot').textContent = `${weekdayLabel} at ${slotTimeLabel}`;

      // Transition to Success Card
      wizardCard.classList.add('hidden');
      successCard.classList.remove('hidden');

      // Setup Add to Calendar (.ics)
      document.getElementById('download-ics-btn').onclick = () => {
        downloadIcs(newBooking);
      };
    });

    // Local Synchronization to CRM Lead Store
    function syncLeadStore(booking) {
      try {
        let leads = [];
        const storedLeads = localStorage.getItem('hermes_lead_store');
        if (storedLeads) leads = JSON.parse(storedLeads);

        // Map booking status to CRM status
        let leadStatus = 'NEW';

        const serviceKey = booking.service.toLowerCase().replace(/\s+/g, '_');
        const initials = booking.customer_name ? booking.customer_name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase() : 'BC';

        const newLead = {
          id: booking.booking_id,
          name: booking.customer_name,
          email: booking.customer_email,
          phone: booking.customer_phone,
          company: `${booking.vehicle.year} ${booking.vehicle.make} ${booking.vehicle.model}`,
          initials: initials,
          verticalKey: 'auto',
          verticalName: 'Apex Auto Care',
          message: booking.notes || `Booked a ${booking.service} for my ${booking.vehicle.year} ${booking.vehicle.make} ${booking.vehicle.model} on ${booking.date} at ${booking.time_slot}.`,
          status: leadStatus,
          confidenceNum: 0.99,
          confidence: '99%',
          priority: 'HIGH',
          timestamp: 'Just now',
          autoBooking: {
            serviceKey: serviceKey,
            serviceName: booking.service,
            vehicle: `${booking.vehicle.year} ${booking.vehicle.make} ${booking.vehicle.model} (Mileage: ${booking.vehicle.mileage})`,
            duration: booking.service === 'Full Synthetic Oil Change' ? '45 mins' : booking.service === 'Premium Brake Pad Replacement' ? '1.5 Hours' : '30 mins',
            costRange: booking.price,
            bay: "Bay 1 · Live Booking",
            slot: `${booking.date} at ${booking.time_slot}`,
            summary: `Live booked appointment via public customer booking link.`
          },
          aiSuggestedAction: 'Review booking slot & click Confirm Booking.'
        };

        leads.unshift(newLead);
        localStorage.setItem('hermes_lead_store', JSON.stringify(leads));
      } catch (e) {
        console.error('Error syncing dynamic lead store from booking client:', e);
      }
    }

    // High-Compatibility iCalendar (.ics) Generator
    function downloadIcs(booking) {
      const startDateTime = "20260821T110000"; // Default static mapped date FRI 11AM
      const endDateTime = "20260821T120000";

      const icsLines = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Hermes Connect//Apex Auto Care Portal//EN",
        "BEGIN:VEVENT",
        `UID:${booking.booking_id}@connect.hermeslogisticsus.com`,
        `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z'}`,
        `DTSTART:${startDateTime}`,
        `DTEND:${endDateTime}`,
        `SUMMARY:Apex Auto Care Booking: ${booking.service}`,
        `DESCRIPTION:Confirmed booking for ${booking.customer_name} \\nVehicle: ${booking.vehicle.year} ${booking.vehicle.make} ${booking.vehicle.model} \\nNotes: ${booking.notes || 'None'} \\nPrice: FREE BETA`,
        "LOCATION:Apex Auto Care - Madison Facility, 1402 Atlas Ave, Madison, WI 53714",
        "STATUS:CONFIRMED",
        "END:VEVENT",
        "END:VCALENDAR"
      ];

      const icsString = icsLines.join("\r\n");
      const blob = new Blob([icsString], { type: "text/calendar;charset=utf-8" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `apex_auto_care_${booking.booking_id}.ics`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    // Viral Growth Loop Button Tracking
    const viralBtn = document.getElementById('viral-loop-cta');
    if (viralBtn) {
      viralBtn.addEventListener('click', () => {
        try {
          const viralLeads = JSON.parse(localStorage.getItem('hermes_connect_viral_leads') || '[]');
          viralLeads.push({
            id: `viral-${Date.now()}`,
            timestamp: new Date().toISOString(),
            triggered_by_booking: document.getElementById('receipt-id').textContent
          });
          localStorage.setItem('hermes_connect_viral_leads', JSON.stringify(viralLeads));
        } catch (e) {
          // fail safe
        }
        viralBtn.innerHTML = "✓ Inquiry Request Sent!";
        viralBtn.style.backgroundColor = "#319a75";
        viralBtn.style.color = "#fff";
        viralBtn.disabled = true;
      });
    }

    // Initialize Slots Availability on Startup
    updateSlotsAvailability();
  });
</script>
