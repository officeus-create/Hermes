---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
---

<BaseLayout
  title="Repair Shop Appointments | Hermes Connect"
  description="Owner-only appointment operations for Hermes Connect Repair Shops."
  robots="noindex,nofollow"
>
  <SiteHeader activePath="/paths/technology/" />
  <main class="appointments-page">
    <div class="shell">
      <header class="appointments-header">
        <div>
          <p class="eyebrow" data-i18n="eyebrow">Repair Shop CRM</p>
          <h1 data-i18n="title">Appointments</h1>
          <p class="muted" data-i18n="subtitle">Manage real bookings, customers, vehicles, and status history from one operational queue.</p>
        </div>
        <span id="appointment-count" class="count-pill">0</span>
      </header>

      <div id="appointments-alert" class="alert hidden" role="status"></div>

      <section class="appointments-toolbar" aria-label="Appointment filters">
        <label class="search-field">
          <span data-i18n="searchLabel">Search</span>
          <input id="appointment-search" type="search" data-i18n-placeholder="searchPlaceholder" placeholder="Customer, phone, email, vehicle, VIN, service, or technician" autocomplete="off" />
        </label>
        <label class="filter-field">
          <span data-i18n="statusLabel">Status</span>
          <select id="appointment-status">
            <option value="all" data-i18n="all">All</option>
            <option value="confirmed" data-i18n="confirmed">Confirmed</option>
            <option value="in_progress" data-i18n="inProgress">In progress</option>
            <option value="completed" data-i18n="completed">Completed</option>
            <option value="cancelled" data-i18n="cancelled">Cancelled</option>
          </select>
        </label>
      </section>

      <div id="appointments-loading" class="state-card" data-i18n="loading">Loading appointments…</div>
      <div id="appointments-empty" class="state-card hidden"><strong data-i18n="emptyTitle">No appointments found</strong><span data-i18n="emptyCopy">New bookings from your public booking page will appear here.</span></div>
      <section id="appointments-list" class="appointments-list hidden" aria-live="polite"></section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  type BookingHistory = { id: string; from_status: string | null; to_status: string; changed_at: string };
  type BookingVehicle = { year: number | null; make: string; model: string; mileage: number | null; vin: string | null };
  type BookingTechnician = { id: string; name: string };
  type Booking = {
    id: string;
    service_name: string;
    duration_minutes: number;
    appointment_date: string;
    start_time: string;
    end_time: string;
    status: string;
    client_name: string;
    client_email: string;
    client_phone: string;
    technician?: BookingTechnician | null;
    vehicle?: BookingVehicle | null;
    history?: BookingHistory[];
  };

  const supported = new Set(["en", "ru", "uk", "es", "it", "fr"]);
  const requested = (new URLSearchParams(window.location.search).get("lang") || "en").toLowerCase();
  const locale = supported.has(requested) ? requested : "en";
  const copy: Record<string, Record<string, string>> = {
    en: { eyebrow:"Repair Shop CRM", title:"Appointments", subtitle:"Manage real bookings, customers, vehicles, and status history from one operational queue.", searchLabel:"Search", searchPlaceholder:"Customer, phone, email, vehicle, VIN, service, or technician", statusLabel:"Status", all:"All", confirmed:"Confirmed", inProgress:"In progress", completed:"Completed", cancelled:"Cancelled", loading:"Loading appointments…", emptyTitle:"No appointments found", emptyCopy:"New bookings from your public booking page will appear here.", customer:"Customer", vehicle:"Vehicle", technician:"Technician", noVehicle:"Vehicle not provided", history:"Status history", noHistory:"No status changes yet", openCustomer:"Open customer", nextStatus:"Change status", unable:"Unable to load appointments.", session:"Unable to verify your secure session.", updateFailed:"Unable to update appointment status.", updated:"Appointment status updated.", appointments:"appointments" },
    ru: { eyebrow:"CRM СТО", title:"Записи", subtitle:"Управляйте реальными записями, клиентами, автомобилями и историей статусов в одной рабочей очереди.", searchLabel:"Поиск", searchPlaceholder:"Клиент, телефон, email, автомобиль, VIN, услуга или мастер", statusLabel:"Статус", all:"Все", confirmed:"Подтверждено", inProgress:"В работе", completed:"Завершено", cancelled:"Отменено", loading:"Загружаем записи…", emptyTitle:"Записи не найдены", emptyCopy:"Новые записи с публичной страницы СТО появятся здесь.", customer:"Клиент", vehicle:"Автомобиль", technician:"Мастер", noVehicle:"Автомобиль не указан", history:"История статусов", noHistory:"Изменений статуса пока нет", openCustomer:"Открыть клиента", nextStatus:"Изменить статус", unable:"Не удалось загрузить записи.", session:"Не удалось проверить защищённую сессию.", updateFailed:"Не удалось изменить статус записи.", updated:"Статус записи обновлён.", appointments:"записей" },
    uk: { eyebrow:"CRM СТО", title:"Записи", subtitle:"Керуйте реальними записами, клієнтами, автомобілями та історією статусів в одній робочій черзі.", searchLabel:"Пошук", searchPlaceholder:"Клієнт, телефон, email, автомобіль, VIN, послуга або майстер", statusLabel:"Статус", all:"Усі", confirmed:"Підтверджено", inProgress:"В роботі", completed:"Завершено", cancelled:"Скасовано", loading:"Завантажуємо записи…", emptyTitle:"Записів не знайдено", emptyCopy:"Нові записи з публічної сторінки СТО з’являться тут.", customer:"Клієнт", vehicle:"Автомобіль", technician:"Майстер", noVehicle:"Автомобіль не вказано", history:"Історія статусів", noHistory:"Змін статусу поки немає", openCustomer:"Відкрити клієнта", nextStatus:"Змінити статус", unable:"Не вдалося завантажити записи.", session:"Не вдалося перевірити захищену сесію.", updateFailed:"Не вдалося змінити статус запису.", updated:"Статус запису оновлено.", appointments:"записів" },
    es: { eyebrow:"CRM del taller", title:"Citas", subtitle:"Gestiona reservas reales, clientes, vehículos e historial de estados desde una sola cola operativa.", searchLabel:"Buscar", searchPlaceholder:"Cliente, teléfono, email, vehículo, VIN, servicio o técnico", statusLabel:"Estado", all:"Todas", confirmed:"Confirmada", inProgress:"En curso", completed:"Completada", cancelled:"Cancelada", loading:"Cargando citas…", emptyTitle:"No se encontraron citas", emptyCopy:"Las nuevas reservas de tu página pública aparecerán aquí.", customer:"Cliente", vehicle:"Vehículo", technician:"Técnico", noVehicle:"Vehículo no indicado", history:"Historial de estados", noHistory:"Aún no hay cambios de estado", openCustomer:"Abrir cliente", nextStatus:"Cambiar estado", unable:"No se pudieron cargar las citas.", session:"No se pudo verificar tu sesión segura.", updateFailed:"No se pudo actualizar el estado.", updated:"Estado de la cita actualizado.", appointments:"citas" },
    it: { eyebrow:"CRM officina", title:"Appuntamenti", subtitle:"Gestisci prenotazioni reali, clienti, veicoli e cronologia degli stati da un’unica coda operativa.", searchLabel:"Cerca", searchPlaceholder:"Cliente, telefono, email, veicolo, VIN, servizio o tecnico", statusLabel:"Stato", all:"Tutti", confirmed:"Confermato", inProgress:"In corso", completed:"Completato", cancelled:"Annullato", loading:"Caricamento appuntamenti…", emptyTitle:"Nessun appuntamento trovato", emptyCopy:"Le nuove prenotazioni dalla pagina pubblica appariranno qui.", customer:"Cliente", vehicle:"Veicolo", technician:"Tecnico", noVehicle:"Veicolo non indicato", history:"Cronologia stati", noHistory:"Nessun cambio di stato", openCustomer:"Apri cliente", nextStatus:"Cambia stato", unable:"Impossibile caricare gli appuntamenti.", session:"Impossibile verificare la sessione.", updateFailed:"Impossibile aggiornare lo stato.", updated:"Stato appuntamento aggiornato.", appointments:"appuntamenti" },
    fr: { eyebrow:"CRM atelier", title:"Rendez-vous", subtitle:"Gérez les réservations réelles, clients, véhicules et l’historique des statuts depuis une seule file opérationnelle.", searchLabel:"Rechercher", searchPlaceholder:"Client, téléphone, email, véhicule, VIN, service ou technicien", statusLabel:"Statut", all:"Tous", confirmed:"Confirmé", inProgress:"En cours", completed:"Terminé", cancelled:"Annulé", loading:"Chargement des rendez-vous…", emptyTitle:"Aucun rendez-vous trouvé", emptyCopy:"Les nouvelles réservations de votre page publique apparaîtront ici.", customer:"Client", vehicle:"Véhicule", technician:"Technicien", noVehicle:"Véhicule non indiqué", history:"Historique des statuts", noHistory:"Aucun changement de statut", openCustomer:"Ouvrir le client", nextStatus:"Changer le statut", unable:"Impossible de charger les rendez-vous.", session:"Impossible de vérifier votre session.", updateFailed:"Impossible de mettre à jour le statut.", updated:"Statut du rendez-vous mis à jour.", appointments:"rendez-vous" },
  };
  const t = copy[locale] || copy.en;
  document.documentElement.lang = locale;
  document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((node) => { const key = node.dataset.i18n || ""; if (t[key]) node.textContent = t[key]; });
  document.querySelectorAll<HTMLInputElement>("[data-i18n-placeholder]").forEach((node) => { const key = node.dataset.i18nPlaceholder || ""; if (t[key]) node.placeholder = t[key]; });

  const search = document.getElementById("appointment-search") as HTMLInputElement | null;
  const statusFilter = document.getElementById("appointment-status") as HTMLSelectElement | null;
  const alertBox = document.getElementById("appointments-alert");
  let bookings: Booking[] = [];

  const statusLabels: Record<string, string> = { confirmed:t.confirmed, in_progress:t.inProgress, completed:t.completed, cancelled:t.cancelled, canceled:t.cancelled };
  const transitions: Record<string, string[]> = { confirmed:["in_progress","completed","cancelled"], in_progress:["completed","cancelled"], completed:[], cancelled:[], canceled:[] };

  const showAlert = (message: string, kind = "error") => { if (!alertBox) return; alertBox.textContent = message; alertBox.className = `alert ${kind}`; };
  const readJson = async (response: Response) => { try { return await response.json(); } catch { return { success:false, error:"invalid_server_response" }; } };
  const withLocale = (path: string) => {
    const url = new URL(path, window.location.origin);
    if (locale !== "en") url.searchParams.set("lang", locale);
    return `${url.pathname}${url.search}${url.hash}`;
  };
  const redirectToAuth = () => window.location.replace(withLocale("/services/hermes-connect/repair-shops/auth/"));
  const formatDate = (value: string) => {
    const date = new Date(`${value}T12:00:00Z`);
    return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat(locale === "en" ? "en-US" : locale, { month:"short", day:"numeric", year:"numeric", timeZone:"UTC" }).format(date);
  };
  const formatTime = (value: string) => {
    const [h,m] = value.split(":").map(Number);
    return new Intl.DateTimeFormat(locale === "en" ? "en-US" : locale, { hour:"numeric", minute:"2-digit", timeZone:"UTC" }).format(new Date(Date.UTC(2026,0,1,h || 0,m || 0)));
  };
  const formatHistory = (value: string) => {
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat(locale === "en" ? "en-US" : locale, { dateStyle:"medium", timeStyle:"short" }).format(date);
  };
  const vehicleLabel = (vehicle?: BookingVehicle | null) => {
    if (!vehicle) return t.noVehicle;
    const title = `${vehicle.year ?? ""} ${vehicle.make || ""} ${vehicle.model || ""}`.replace(/\s+/g," ").trim();
    const extras = [vehicle.mileage == null ? "" : `${Number(vehicle.mileage).toLocaleString()} mi`, vehicle.vin ? `VIN ${vehicle.vin}` : ""].filter(Boolean).join(" · ");
    return extras ? `${title} · ${extras}` : title || t.noVehicle;
  };
  const matches = (booking: Booking) => {
    const q = (search?.value || "").trim().toLowerCase();
    const status = statusFilter?.value || "all";
    if (status !== "all" && booking.status !== status && !(status === "cancelled" && booking.status === "canceled")) return false;
    if (!q) return true;
    const vehicle = booking.vehicle ? `${booking.vehicle.year ?? ""} ${booking.vehicle.make} ${booking.vehicle.model} ${booking.vehicle.vin ?? ""}` : "";
    const technician = booking.technician?.name || "";
    return `${booking.service_name} ${booking.client_name} ${booking.client_email} ${booking.client_phone} ${vehicle} ${technician}`.toLowerCase().includes(q);
  };

  const addText = (parent: HTMLElement, tag: keyof HTMLElementTagNameMap, className: string, text: string) => {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = text;
    parent.append(node);
    return node;
  };

  async function updateStatus(booking: Booking, nextStatus: string, button: HTMLButtonElement) {
    button.disabled = true;
    try {
      const response = await fetch(`/api/repair-shop/bookings/${encodeURIComponent(booking.id)}/status`, { method:"PATCH", credentials:"same-origin", headers:{"Content-Type":"application/json"}, body:JSON.stringify({ status:nextStatus }) });
      const data = await readJson(response);
      if (!response.ok || !data.success) return showAlert(data.error || t.updateFailed);
      showAlert(t.updated, "success");
      await loadBookings();
    } catch { showAlert(t.updateFailed); } finally { button.disabled = false; }
  }

  function render() {
    const list = document.getElementById("appointments-list")!;
    const empty = document.getElementById("appointments-empty")!;
    document.getElementById("appointments-loading")?.classList.add("hidden");
    const filtered = bookings.filter(matches);
    document.getElementById("appointment-count")!.textContent = `${filtered.length} ${t.appointments}`;
    list.replaceChildren();
    if (!filtered.length) { list.classList.add("hidden"); empty.classList.remove("hidden"); return; }
    empty.classList.add("hidden"); list.classList.remove("hidden");

    for (const booking of filtered) {
      const card = document.createElement("article");
      card.className = "appointment-card";
      card.dataset.bookingId = booking.id;

      const main = document.createElement("div"); main.className = "appointment-main";
      const time = document.createElement("div"); time.className = "appointment-time";
      addText(time,"strong","",formatDate(booking.appointment_date));
      addText(time,"span","",`${formatTime(booking.start_time)}–${formatTime(booking.end_time)}`);
      main.append(time);

      const body = document.createElement("div"); body.className = "appointment-body";
      addText(body,"strong","appointment-service",booking.service_name);
      if (booking.technician?.name) addText(body,"span","appointment-technician",`${t.technician}: ${booking.technician.name}`);
      addText(body,"span","appointment-customer",`${booking.client_name || booking.client_email} · ${booking.client_phone || booking.client_email}`);
      addText(body,"span","appointment-vehicle",vehicleLabel(booking.vehicle));
      main.append(body);

      const side = document.createElement("div"); side.className = "appointment-side";
      addText(side,"span",`status-pill status-${booking.status}`,statusLabels[booking.status] || booking.status);
      const customerLink = document.createElement("a"); customerLink.className="customer-link"; customerLink.textContent=t.openCustomer; customerLink.href=withLocale(`/services/hermes-connect/repair-shops/customers/?customer=${encodeURIComponent(booking.client_email.toLowerCase())}`); side.append(customerLink);
      main.append(side);
      card.append(main);

      const allowed = transitions[booking.status] || [];
      if (allowed.length) {
        const actions = document.createElement("div"); actions.className="status-actions";
        addText(actions,"span","mini-label",t.nextStatus);
        for (const next of allowed) {
          const button = document.createElement("button"); button.type="button"; button.textContent=statusLabels[next] || next; button.addEventListener("click",()=>updateStatus(booking,next,button)); actions.append(button);
        }
        card.append(actions);
      }

      const history = document.createElement("details"); history.className="history";
      const summary = document.createElement("summary"); summary.textContent=t.history; history.append(summary);
      const entries = Array.isArray(booking.history) ? booking.history : [];
      if (!entries.length) addText(history,"p","history-empty",t.noHistory);
      else {
        const historyList=document.createElement("ol");
        for (const item of entries) {
          const li=document.createElement("li"); li.textContent=`${statusLabels[item.to_status] || item.to_status} · ${formatHistory(item.changed_at)}`; historyList.append(li);
        }
        history.append(historyList);
      }
      card.append(history);
      list.append(card);
    }
  }

  async function loadBookings() {
    const response = await fetch("/api/repair-shop/bookings", { credentials:"same-origin" });
    if (response.status === 401) return redirectToAuth();
    const data = await readJson(response);
    if (!response.ok || !data.success) return showAlert(data.error || t.unable);
    bookings = Array.isArray(data.bookings) ? data.bookings : [];
    render();
  }

  async function initialize() {
    const session = await fetch("/api/auth/me", { credentials:"same-origin" });
    if (session.status === 401) return redirectToAuth();
    if (!session.ok) return showAlert(t.session);
    await loadBookings();
  }

  search?.addEventListener("input", render);
  statusFilter?.addEventListener("change", render);
  initialize().catch(() => showAlert(t.unable));
</script>

<style>
  .appointments-page{min-height:100vh;padding:24px;color:#172033;background:#f4f6f8}.shell{width:min(1120px,100%);margin:0 auto}.appointments-header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:20px}.eyebrow,.mini-label{margin:0 0 7px;color:#6b7280;text-transform:uppercase;letter-spacing:.1em;font-size:11px;font-weight:850}.appointments-header h1{margin:0 0 7px;font-size:32px;letter-spacing:-.03em}.muted{margin:0;color:#697586;line-height:1.55}.count-pill{display:inline-flex;align-items:center;min-height:34px;padding:0 11px;border:1px solid #dfe5ec;border-radius:999px;background:#fff;color:#4d5a6c;font-size:12px;font-weight:800}.appointments-toolbar{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:12px;margin-bottom:16px;padding:14px;border:1px solid #e1e6ed;border-radius:14px;background:#fff}.search-field,.filter-field{display:grid;gap:6px;color:#667285;font-size:11px;font-weight:800}.search-field input,.filter-field select{width:100%;min-height:44px;box-sizing:border-box;border:1px solid #dfe5ec;border-radius:10px;background:#fff;color:#172033;padding:0 12px;font:inherit;font-size:13px;outline:none}.search-field input:focus,.filter-field select:focus{border-color:#6b9fe8;box-shadow:0 0 0 3px rgba(30,136,255,.1)}.appointments-list{display:grid;gap:10px}.appointment-card,.state-card{border:1px solid #e1e6ed;border-radius:14px;background:#fff;box-shadow:0 10px 30px rgba(23,32,51,.04)}.appointment-card{padding:16px}.appointment-main{display:grid;grid-template-columns:160px minmax(0,1fr) auto;gap:18px;align-items:start}.appointment-time,.appointment-body,.appointment-side{display:grid;gap:5px;min-width:0}.appointment-time strong{font-size:13px}.appointment-time span,.appointment-technician,.appointment-customer,.appointment-vehicle{color:#728095;font-size:12px;overflow-wrap:anywhere}.appointment-technician{color:#3f5f84;font-weight:800}.appointment-service{font-size:15px;overflow-wrap:anywhere}.appointment-side{justify-items:end}.status-pill{display:inline-flex;align-items:center;min-height:28px;padding:0 9px;border-radius:999px;background:#eef3f8;color:#536174;font-size:11px;font-weight:850}.status-confirmed{background:#eaf3ff;color:#1b66b0}.status-in_progress{background:#fff5d9;color:#8a6100}.status-completed{background:#e9f8ef;color:#267a48}.status-cancelled,.status-canceled{background:#fcebed;color:#9a3c4b}.customer-link{color:#1d6fc4;text-decoration:none;font-size:12px;font-weight:800}.customer-link:hover{text-decoration:underline}.status-actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:14px;padding-top:12px;border-top:1px solid #eef1f5}.status-actions .mini-label{margin:0 5px 0 0}.status-actions button{min-height:36px;padding:0 10px;border:1px solid #dfe5ec;border-radius:9px;background:#fff;color:#415064;font-size:11px;font-weight:800;cursor:pointer}.status-actions button:hover{background:#f4f7fa}.status-actions button:disabled{opacity:.5;cursor:wait}.history{margin-top:10px;color:#657285;font-size:12px}.history summary{cursor:pointer;font-weight:800}.history ol{margin:8px 0 0;padding-left:20px}.history li{margin:4px 0}.history-empty{margin:8px 0 0}.state-card{padding:18px;color:#667285;display:grid;gap:4px}.alert{margin-bottom:14px;padding:12px 14px;border:1px solid #f3c9ce;border-radius:11px;background:#fff1f3;color:#94384a;font-size:13px}.alert.success{border-color:#bfe6cf;background:#effaf3;color:#257247}.hidden{display:none!important}
  @media(max-width:760px){.appointments-page{padding:16px 12px 48px}.appointments-header{display:block}.count-pill{margin-top:12px}.appointments-toolbar{grid-template-columns:1fr}.appointment-main{grid-template-columns:1fr;gap:10px}.appointment-side{justify-items:start;grid-template-columns:auto auto;align-items:center}.appointment-card{padding:14px}}
</style>