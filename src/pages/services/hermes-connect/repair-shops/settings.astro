y-action,.primary-action{min-height:42px;padding:.6rem .85rem;border:1px solid #cad7e5;border-radius:12px;background:#fff;color:#294760;font-weight:800;text-decoration:none;cursor:pointer}.primary-action{border-color:#1677d2;background:#1677d2;color:#fff}.primary-action:hover{background:#1067b8}button:disabled{opacity:.55;cursor:not-allowed}.booking-row{justify-content:space-between;flex-wrap:wrap}.booking-row code{max-width:100%;overflow-wrap:anywhere;padding:.65rem .8rem;border-radius:12px;background:#f3f7fb}.status-pill,.connection-status{display:inline-flex;padding:.28rem .62rem;border-radius:999px;background:#eef3f8;color:#5f7288;font-size:.72rem;font-weight:850}.status-pill.active{background:#e8f7ed;color:#247443}.status-pill.inactive{background:#f0f2f5;color:#7b8794}.needs-auth{background:#fff2cf;color:#8b5c00}.planned{background:#eef2f8;color:#63728a}.company-alert{padding:.85rem 1rem;border:1px solid #ffd2d2;border-radius:14px;background:#fff0f0;color:#9c3838}.company-alert.success{border-color:#c7ead3;background:#ebf9f0;color:#287146}.hidden{display:none!important}.staff-list{display:grid;gap:.65rem}.staff-card{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.9rem;border:1px solid #e0e8f0;border-radius:16px;background:#fbfdff}.staff-card>div:first-child{display:grid;gap:.18rem}.staff-card span,.staff-card small{color:#66788d}.staff-card-actions{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap}.staff-card-actions button{min-height:34px;padding:.38rem .6rem;font-size:.74rem}.check-label{display:flex!important;align-items:center;gap:.5rem}.check-label input{width:18px;min-height:18px}.empty-state{padding:1rem;border:1px dashed #c8d7e6;border-radius:14px;background:#f8fbfe;color:#74859a;text-align:center}.schedule-person{max-width:360px;margin-bottom:.8rem}.schedule-form{display:grid;gap:.6rem}.schedule-head,.schedule-row{display:grid;grid-template-columns:72px 80px minmax(190px,1fr) minmax(190px,1fr);align-items:center;gap:.7rem}.schedule-head{padding:0 .65rem;color:#7b8999;font-size:.7rem;font-weight:850;text-transform:uppercase}.schedule-row{padding:.7rem;border:1px solid #e0e8f0;border-radius:14px;background:#fbfdff}.schedule-row label input{width:18px;min-height:18px}.connection-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.connection-card{padding:1rem;border:1px solid #dfe8f1;border-radius:16px;background:#fbfdff}.connection-card.priority{border-color:#bad8f6;background:linear-gradient(135deg,#f8fcff,#f3f8ff)}.connection-card>div{display:flex;justify-content:space-between;align-items:center;gap:.7rem}.connection-card p{margin:.65rem 0 0;color:#66788d;line-height:1.5}.connection-card button{margin-top:.75rem}
  @media(max-width:760px){.company-page{padding:1rem .7rem 3rem}.company-hero,.split-head{align-items:flex-start;flex-direction:column}.profile-grid,.staff-form,.connection-grid{grid-template-columns:1fr}.span-2{grid-column:auto}.inline-row,.booking-row{align-items:stretch;flex-direction:column}.schedule-head{display:none}.schedule-row{grid-template-columns:56px 48px 1fr}.schedule-row .time-pair:last-child{grid-column:3}.staff-card{align-items:flex-start;flex-direction:column}.staff-card-actions{width:100%}}
