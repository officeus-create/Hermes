---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import HermesConnectAccountSwitcher from "../../../../components/HermesConnectAccountSwitcher.astro";
---

<BaseLayout
  title="Company | Hermes Connect Repair Shop"
  description="Owner-only company profile, team schedules, booking link, and connection readiness."
  robots="noindex,nofollow"
>
  <div class="site-header company-account-source" aria-hidden="true">
    <HermesConnectAccountSwitcher current="repair" mode="menu" />
  </div>

  <main id="main-content" class="company-page">
    <div class="company-shell">
      <header class="company-hero">
        <div>
          <p class="eyebrow" data-i18n="eyebrow">Repair Shop CRM</p>
          <h1 data-i18n="title">Company</h1>
          <p class="muted" data-i18n="subtitle">Company profile, team, shifts, breaks and connection readiness in one place.</p>
        </div>
        <span id="profile-state" class="status-pill" data-i18n="notConfigured">Not configured</span>
      </header>

      <div id="page-alert" class="company-alert hidden" role="status" aria-live="polite"></div>

      <nav class="company-tabs" aria-label="Company sections">
        <a href="#profile" data-i18n="profileTab">Profile</a>
        <a href="#team" data-i18n="teamTab">Team</a>
        <a href="#schedule" data-i18n="scheduleTab">Schedules</a>
        <a href="#connections" data-i18n="connectionsTab">Connections</a>
      </nav>

      <section id="profile" class="company-card">
        <div class="card-head">
          <p class="eyebrow" data-i18n="profileEyebrow">Company profile</p>
          <h2 data-i18n="profileTitle">Business details</h2>
          <p class="muted" data-i18n="profileCopy">These saved details are used by your public booking experience.</p>
        </div>
        <form id="profile-form" class="profile-grid">
          <label class="span-2"><span data-i18n="shopName">Shop name</span><input id="shop-name" maxlength="120" required autocomplete="organization" placeholder="Apex Auto Care" /></label>
          <label><span data-i18n="phone">Phone</span><input id="shop-phone" maxlength="32" inputmode="tel" autocomplete="tel" placeholder="+1 414 555 0100" /></label>
          <label><span data-i18n="address">Address</span><input id="shop-address" maxlength="160" autocomplete="street-address" placeholder="123 Main St" /></label>
          <label><span data-i18n="city">City</span><input id="shop-city" maxlength="100" required autocomplete="address-level2" /></label>
          <label><span data-i18n="region">Region / state</span><input id="shop-region" maxlength="100" autocomplete="address-level1" /></label>
          <label><span data-i18n="country">Country code</span><input id="shop-country" maxlength="2" minlength="2" required autocomplete="country" placeholder="US" pattern="[A-Za-z]{2}" /></label>
          <label><span data-i18n="postal">Postal code</span><input id="shop-postal" maxlength="24" autocomplete="postal-code" /></label>
          <label class="span-2"><span data-i18n="timezone">Timezone</span><div class="inline-row"><input id="shop-timezone" maxlength="64" required list="timezone-suggestions" placeholder="America/Chicago" /><button id="detect-timezone" class="secondary-action" type="button" data-i18n="detectTimezone">Use browser timezone</button></div></label>
          <datalist id="timezone-suggestions"><option value="America/New_York"></option><option value="America/Chicago"></option><option value="America/Denver"></option><option value="America/Los_Angeles"></option><option value="Europe/Kyiv"></option><option value="Europe/London"></option><option value="Europe/Paris"></option><option value="Europe/Berlin"></option></datalist>
          <button id="save-profile" class="primary-action span-2" type="submit" data-i18n="saveProfile">Save company profile</button>
        </form>
      </section>

      <section id="public-booking-card" class="company-card hidden">
        <div class="card-head"><p class="eyebrow" data-i18n="bookingEyebrow">Customer access</p><h2 data-i18n="bookingTitle">Public booking link</h2><p class="muted" data-i18n="bookingCopy">Share this stable link after services and availability are ready.</p></div>
        <div class="booking-row"><code id="public-booking-link"></code><div class="booking-actions"><button id="copy-booking-link" class="secondary-action" type="button" data-i18n="copy">Copy</button><a id="open-booking-link" class="secondary-action" href="#" target="_blank" rel="noopener" data-i18n="open">Open</a></div></div>
      </section>

      <section id="team" class="company-card">
        <div class="card-head split-head">
          <div><p class="eyebrow" data-i18n="teamEyebrow">People</p><h2 data-i18n="teamTitle">Team</h2><p class="muted" data-i18n="teamCopy">Add technicians, roles and specialties.</p></div>
          <button id="new-staff" class="secondary-action" type="button" data-i18n="addEmployee">Add employee</button>
        </div>
        <form id="staff-form" class="staff-form hidden">
          <input id="staff-id" type="hidden" />
          <label><span data-i18n="employeeName">Employee name</span><input id="staff-name" maxlength="100" required /></label>
          <label><span data-i18n="role">Role</span><input id="staff-role" maxlength="80" placeholder="Technician" /></label>
          <label class="span-2"><span data-i18n="specialties">Specialties</span><input id="staff-specialties" maxlength="500" placeholder="Brakes, Diagnostics, Electrical" /></label>
          <label class="check-label"><input id="staff-active" type="checkbox" checked /><span data-i18n="activeEmployee">Active employee</span></label>
          <div class="form-actions span-2"><button class="primary-action" type="submit" data-i18n="saveEmployee">Save employee</button><button id="cancel-staff" class="secondary-action" type="button" data-i18n="cancel">Cancel</button></div>
        </form>
        <div id="staff-empty" class="empty-state" data-i18n="staffEmpty">No employees yet. Add your first technician or team member.</div>
        <div id="staff-list" class="staff-list"></div>
      </section>

      <section id="schedule" class="company-card">
        <div class="card-head"><p class="eyebrow" data-i18n="scheduleEyebrow">Working time</p><h2 data-i18n="scheduleTitle">Shifts & breaks</h2><p class="muted" data-i18n="scheduleCopy">Set each employee’s local weekly shift and breaks. Google Calendar free/busy conflicts will layer on top only after authorization.</p></div>
        <label class="schedule-person"><span data-i18n="employee">Employee</span><select id="schedule-staff"></select></label>
        <div id="schedule-empty" class="empty-state" data-i18n="scheduleEmpty">Add an employee before creating a schedule.</div>
        <form id="schedule-form" class="schedule-form hidden">
          <div class="schedule-head"><span data-i18n="day">Day</span><span data-i18n="working">Working</span><span data-i18n="shift">Shift</span><span data-i18n="break">Break</span></div>
          <div id="schedule-days"></div>
          <button class="primary-action" type="submit" data-i18n="saveSchedule">Save schedule</button>
        </form>
      </section>

      <section id="connections" class="company-card">
        <div class="card-head"><p class="eyebrow" data-i18n="connectionsEyebrow">Connections</p><h2 data-i18n="connectionsTitle">Apps & channels</h2><p class="muted" data-i18n="connectionsCopy">No live account is connected from this page yet. These statuses are intentionally honest.</p></div>
        <div class="connection-grid">
          <article class="connection-card priority"><div><strong>Google Calendar</strong><span class="connection-status needs-auth" data-i18n="needsAuth">Needs authorization</span></div><p data-i18n="calendarCopy">First adapter: privacy-minimal free/busy only. Titles, attendees and descriptions are not required. Hermes-created events need separate permission.</p><button type="button" disabled data-i18n="connectLater">Connect after adapter approval</button></article>
          <article class="connection-card"><div><strong data-i18n="email">Email</strong><span class="connection-status planned" data-i18n="planned">Planned</span></div><p data-i18n="emailCopy">Company mailbox connection for owner-authorized operational context.</p></article>
          <article class="connection-card"><div><strong data-i18n="websiteBrand">Website & brandbook</strong><span class="connection-status planned" data-i18n="planned">Planned</span></div><p data-i18n="brandCopy">Logo, colors and brand assets can later flow into the public company page after owner approval.</p></article>
          <article class="connection-card"><div><strong data-i18n="socials">Social channels</strong><span class="connection-status planned" data-i18n="planned">Planned</span></div><p>Instagram · Facebook · Threads · LinkedIn · X</p></article>
          <article class="connection-card"><div><strong data-i18n="jobs">Jobs</strong><span class="connection-status planned" data-i18n="planned">Planned</span></div><p data-i18n="jobsCopy">Vacancy synchronization will use owner-approved sources. Nothing is published automatically.</p></article>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  type Staff = { id:string; name:string; role:string; specialties:string[]; active:boolean };
  type ScheduleDay = { day_of_week:number; is_working:boolean; start_time:string|null; end_time:string|null; breaks:{start_time:string;end_time:string}[] };
  const supported = new Set(["en","ru","uk","es","it","fr"]);
  const params = new URLSearchParams(location.search);
  const requested = (params.get("lang") || "en").toLowerCase();
  const locale = supported.has(requested) ? requested : "en";
  const common = {
    en:{title:"Company",subtitle:"Company profile, team, shifts, breaks and connection readiness in one place.",profileTab:"Profile",teamTab:"Team",scheduleTab:"Schedules",connectionsTab:"Connections",teamTitle:"Team",scheduleTitle:"Shifts & breaks",connectionsTitle:"Apps & channels",needsAuth:"Needs authorization",planned:"Planned",addEmployee:"Add employee",employeeName:"Employee name",role:"Role",specialties:"Specialties",activeEmployee:"Active employee",saveEmployee:"Save employee",cancel:"Cancel",staffEmpty:"No employees yet. Add your first technician or team member.",employee:"Employee",scheduleEmpty:"Add an employee before creating a schedule.",day:"Day",working:"Working",shift:"Shift",break:"Break",saveSchedule:"Save schedule",saveProfile:"Save company profile",saved:"Saved",notConfigured:"Not configured",edit:"Edit",remove:"Remove",deleteConfirm:"Remove this employee?",loadFailed:"Unable to load company settings.",saveFailed:"Unable to save changes.",savedMessage:"Changes saved.",connectionsCopy:"No live account is connected from this page yet. These statuses are intentionally honest.",activeStatus:"Active",inactiveStatus:"Inactive"},
    ru:{title:"Компания",subtitle:"Профиль компании, сотрудники, смены, перерывы и готовность подключений — в одном месте.",eyebrow:"CRM автосервиса",notConfigured:"Не настроено",profileTab:"Профиль",teamTab:"Команда",scheduleTab:"Графики",connectionsTab:"Подключения",profileEyebrow:"Профиль компании",profileTitle:"Данные компании",profileCopy:"Сохранённые данные используются в публичной записи клиентов.",shopName:"Название СТО",phone:"Телефон",address:"Адрес",city:"Город",region:"Регион / штат",country:"Код страны",postal:"Почтовый индекс",timezone:"Часовой пояс",detectTimezone:"Использовать часовой пояс браузера",saveProfile:"Сохранить профиль компании",bookingEyebrow:"Доступ для клиентов",bookingTitle:"Публичная ссылка для записи",bookingCopy:"Делитесь этой постоянной ссылкой после настройки услуг и графика.",copy:"Копировать",open:"Открыть",teamEyebrow:"Сотрудники",teamTitle:"Команда",teamCopy:"Добавляйте мастеров, роли и специализации.",addEmployee:"Добавить сотрудника",employeeName:"Имя сотрудника",role:"Роль",specialties:"Специализации",activeEmployee:"Активный сотрудник",saveEmployee:"Сохранить сотрудника",cancel:"Отмена",staffEmpty:"Сотрудников пока нет. Добавьте первого мастера или члена команды.",scheduleEyebrow:"Рабочее время",scheduleTitle:"Смены и перерывы",scheduleCopy:"Настройте для каждого сотрудника недельные смены и перерывы по местному времени. Конфликты Google Calendar free/busy будут учитываться только после авторизации.",employee:"Сотрудник",scheduleEmpty:"Сначала добавьте сотрудника, затем настройте график.",day:"День",working:"Работает",shift:"Смена",break:"Перерыв",saveSchedule:"Сохранить график",connectionsEyebrow:"Подключения",connectionsTitle:"Приложения и каналы",connectionsCopy:"С этой страницы пока не подключается ни один живой аккаунт. Статусы показывают реальное состояние.",needsAuth:"Нужна авторизация",calendarCopy:"Первый адаптер: только минимальные данные free/busy. Названия событий, участники и описания не нужны. Для событий, создаваемых Hermes, потребуется отдельное разрешение.",connectLater:"Подключить после утверждения адаптера",email:"Электронная почта",planned:"Запланировано",emailCopy:"Подключение корпоративной почты для рабочего контекста, разрешённого владельцем.",websiteBrand:"Сайт и брендбук",brandCopy:"Логотип, цвета и бренд-материалы позже можно будет переносить на публичную страницу компании после подтверждения владельца.",socials:"Социальные сети",jobs:"Вакансии",jobsCopy:"Синхронизация вакансий будет использовать только источники, подтверждённые владельцем. Автоматической публикации нет.",saved:"Сохранено",edit:"Изменить",remove:"Удалить",deleteConfirm:"Удалить этого сотрудника?",loadFailed:"Не удалось загрузить раздел компании.",saveFailed:"Не удалось сохранить изменения.",savedMessage:"Изменения сохранены.",activeStatus:"Активен",inactiveStatus:"Неактивен"},
    uk:{title:"Компанія",profileTab:"Профіль",teamTab:"Команда",scheduleTab:"Графіки",connectionsTab:"Підключення",teamTitle:"Команда",scheduleTitle:"Зміни та перерви",connectionsTitle:"Застосунки та канали",needsAuth:"Потрібна авторизація",planned:"Заплановано",addEmployee:"Додати співробітника",saveProfile:"Зберегти профіль компанії",saved:"Збережено",notConfigured:"Не налаштовано"},
    es:{title:"Empresa",profileTab:"Perfil",teamTab:"Equipo",scheduleTab:"Horarios",connectionsTab:"Conexiones",teamTitle:"Equipo",scheduleTitle:"Turnos y descansos",connectionsTitle:"Aplicaciones y canales",needsAuth:"Requiere autorización",planned:"Planificado",addEmployee:"Añadir empleado",saveProfile:"Guardar perfil",saved:"Guardado",notConfigured:"Sin configurar"},
    it:{title:"Azienda",profileTab:"Profilo",teamTab:"Team",scheduleTab:"Orari",connectionsTab:"Connessioni",teamTitle:"Team",scheduleTitle:"Turni e pause",connectionsTitle:"App e canali",needsAuth:"Autorizzazione necessaria",planned:"Pianificato",addEmployee:"Aggiungi dipendente",saveProfile:"Salva profilo",saved:"Salvato",notConfigured:"Non configurato"},
    fr:{title:"Entreprise",profileTab:"Profil",teamTab:"Équipe",scheduleTab:"Horaires",connectionsTab:"Connexions",teamTitle:"Équipe",scheduleTitle:"Équipes et pauses",connectionsTitle:"Applications et canaux",needsAuth:"Autorisation requise",planned:"Planifié",addEmployee:"Ajouter un employé",saveProfile:"Enregistrer le profil",saved:"Enregistré",notConfigured:"Non configuré"},
  } as Record<string,Record<string,string>>;
  const fallback = common.en;
  const t = { ...fallback, ...(common[locale] || {}) };
  const days = locale === "ru" ? ["Вс","Пн","Вт","Ср","Чт","Пт","Сб"] : locale === "uk" ? ["Нд","Пн","Вт","Ср","Чт","Пт","Сб"] : ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
  const $ = <T extends HTMLElement>(selector:string) => document.querySelector(selector) as T|null;
  const alertBox = $("#page-alert");
  let staff:Staff[] = [];
  let publicBookingUrl = "";

  document.documentElement.lang = locale;
  document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((node)=>{ const key=node.dataset.i18n||""; if(t[key]) node.textContent=t[key]; });
  const setAlert=(message:string,tone:"error"|"success"="error")=>{if(!alertBox)return;alertBox.textContent=message;alertBox.classList.remove("hidden","success");if(tone==="success")alertBox.classList.add("success");};
  const clearAlert=()=>{if(!alertBox)return;alertBox.textContent="";alertBox.classList.add("hidden");alertBox.classList.remove("success");};
  const authRedirect=()=>{const url=new URL("/services/hermes-connect/repair-shops/auth/",location.origin);if(locale!=="en")url.searchParams.set("lang",locale);location.assign(`${url.pathname}${url.search}`);};
  const requestJson=async(url:string,init?:RequestInit)=>{const response=await fetch(url,{credentials:"same-origin",...init,headers:{"Content-Type":"application/json",...(init?.headers||{})}});if(response.status===401){authRedirect();throw new Error("not_authenticated");}const data=await response.json().catch(()=>({success:false,error:"invalid_response"}));if(!response.ok||!data?.success)throw new Error(String(data?.error||"request_failed"));return data;};
  const escapeHtml=(value:string)=>value.replace(/[&<>'"]/g,(char)=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;","\"":"&quot;"}[char]||char));

  const fillProfile=(shop:any)=>{if(!shop)return;($<HTMLInputElement>("#shop-name")!).value=shop.name||"";($<HTMLInputElement>("#shop-phone")!).value=shop.phone||"";($<HTMLInputElement>("#shop-address")!).value=shop.address_line1||"";($<HTMLInputElement>("#shop-city")!).value=shop.city||"";($<HTMLInputElement>("#shop-region")!).value=shop.region||shop.state||"";($<HTMLInputElement>("#shop-country")!).value=shop.country_code||"US";($<HTMLInputElement>("#shop-postal")!).value=shop.postal_code||"";($<HTMLInputElement>("#shop-timezone")!).value=shop.timezone||"";const state=$("#profile-state");if(state)state.textContent=t.saved;$("#public-booking-card")?.classList.remove("hidden");const url=new URL(`/services/hermes-connect/repair-shops/booking/?shop=${encodeURIComponent(shop.slug)}`,location.origin);if(locale!=="en")url.searchParams.set("lang",locale);publicBookingUrl=url.href;const code=$("#public-booking-link");if(code)code.textContent=publicBookingUrl;const open=$("#open-booking-link") as HTMLAnchorElement|null;if(open)open.href=publicBookingUrl;};
  $("#profile-form")?.addEventListener("submit",async(event)=>{event.preventDefault();clearAlert();try{const body={name:$<HTMLInputElement>("#shop-name")?.value.trim(),phone:$<HTMLInputElement>("#shop-phone")?.value.trim(),address_line1:$<HTMLInputElement>("#shop-address")?.value.trim(),city:$<HTMLInputElement>("#shop-city")?.value.trim(),region:$<HTMLInputElement>("#shop-region")?.value.trim(),country_code:$<HTMLInputElement>("#shop-country")?.value.trim().toUpperCase(),postal_code:$<HTMLInputElement>("#shop-postal")?.value.trim(),timezone:$<HTMLInputElement>("#shop-timezone")?.value.trim()};const data=await requestJson("/api/repair-shop/profile",{method:"PUT",body:JSON.stringify(body)});fillProfile(data.shop);setAlert(t.savedMessage,"success");}catch{setAlert(t.saveFailed);}});
  $("#detect-timezone")?.addEventListener("click",()=>{const tz=Intl.DateTimeFormat().resolvedOptions().timeZone;const input=$<HTMLInputElement>("#shop-timezone");if(tz&&input)input.value=tz;});
  $("#copy-booking-link")?.addEventListener("click",async()=>{if(!publicBookingUrl)return;try{await navigator.clipboard.writeText(publicBookingUrl);setAlert(t.savedMessage,"success");}catch{setAlert(t.saveFailed);}});

  const staffForm=$("#staff-form") as HTMLFormElement|null;
  const showStaffForm=(member?:Staff)=>{staffForm?.classList.remove("hidden");($<HTMLInputElement>("#staff-id")!).value=member?.id||"";($<HTMLInputElement>("#staff-name")!).value=member?.name||"";($<HTMLInputElement>("#staff-role")!).value=member?.role||"Technician";($<HTMLInputElement>("#staff-specialties")!).value=(member?.specialties||[]).join(", ");($<HTMLInputElement>("#staff-active")!).checked=member?.active??true;$<HTMLInputElement>("#staff-name")?.focus();};
  const hideStaffForm=()=>{staffForm?.classList.add("hidden");staffForm?.reset();const id=$<HTMLInputElement>("#staff-id");if(id)id.value="";};
  $("#new-staff")?.addEventListener("click",()=>showStaffForm());$("#cancel-staff")?.addEventListener("click",hideStaffForm);
  const renderStaff=()=>{const list=$("#staff-list");const empty=$("#staff-empty");const select=$<HTMLSelectElement>("#schedule-staff");if(!list||!select)return;list.innerHTML="";select.innerHTML="";empty?.classList.toggle("hidden",staff.length>0);staff.forEach((member)=>{const card=document.createElement("article");card.className="staff-card";card.innerHTML=`<div><strong>${escapeHtml(member.name)}</strong><span>${escapeHtml(member.role)}</span><small>${escapeHtml(member.specialties.join(" · ")||"—")}</small></div><div class="staff-card-actions"><span class="status-pill ${member.active?"active":"inactive"}">${member.active?t.activeStatus:t.inactiveStatus}</span><button type="button" data-edit="${member.id}">${t.edit}</button><button type="button" data-remove="${member.id}">${t.remove}</button></div>`;list.appendChild(card);const option=document.createElement("option");option.value=member.id;option.textContent=member.name;select.appendChild(option);});document.querySelectorAll<HTMLElement>("[data-edit]").forEach((button)=>button.addEventListener("click",()=>{const member=staff.find((item)=>item.id===button.dataset.edit);if(member)showStaffForm(member);}));document.querySelectorAll<HTMLElement>("[data-remove]").forEach((button)=>button.addEventListener("click",async()=>{const id=button.dataset.remove||"";if(!id||!confirm(t.deleteConfirm))return;try{const data=await requestJson("/api/repair-shop/staff",{method:"DELETE",body:JSON.stringify({id})});staff=data.staff||[];renderStaff();setAlert(t.savedMessage,"success");}catch{setAlert(t.saveFailed);}}));$("#schedule-empty")?.classList.toggle("hidden",staff.length>0);$("#schedule-form")?.classList.toggle("hidden",staff.length===0);if(staff.length)void refreshSchedule();};
  staffForm?.addEventListener("submit",async(event)=>{event.preventDefault();clearAlert();const id=$<HTMLInputElement>("#staff-id")?.value.trim()||"";const body={id,name:$<HTMLInputElement>("#staff-name")?.value.trim(),role:$<HTMLInputElement>("#staff-role")?.value.trim(),specialties:($<HTMLInputElement>("#staff-specialties")?.value||"").split(",").map((item)=>item.trim()).filter(Boolean),active:Boolean($<HTMLInputElement>("#staff-active")?.checked)};try{const data=await requestJson("/api/repair-shop/staff",{method:id?"PUT":"POST",body:JSON.stringify(body)});staff=data.staff||[];hideStaffForm();renderStaff();setAlert(t.savedMessage,"success");}catch{setAlert(t.saveFailed);}});

  const defaultDays=():ScheduleDay[]=>Array.from({length:7},(_,day)=>({day_of_week:day,is_working:day>0&&day<6,start_time:day>0&&day<6?"09:00":null,end_time:day>0&&day<6?"17:00":null,breaks:day>0&&day<6?[{start_time:"12:00",end_time:"12:30"}]:[]}));
  const renderSchedule=(values:ScheduleDay[])=>{const root=$("#schedule-days");if(!root)return;root.innerHTML="";const map=new Map(values.map((item)=>[item.day_of_week,item]));defaultDays().forEach((fallback)=>{const value=map.get(fallback.day_of_week)||fallback;const firstBreak=value.breaks?.[0]||{start_time:"",end_time:""};const row=document.createElement("div");row.className="schedule-row";row.dataset.day=String(value.day_of_week);row.innerHTML=`<strong>${days[value.day_of_week]}</strong><label><input class="working-input" type="checkbox" ${value.is_working?"checked":""}/></label><div class="time-pair"><input class="start-input" type="time" value="${value.start_time||"09:00"}"/><span>–</span><input class="end-input" type="time" value="${value.end_time||"17:00"}"/></div><div class="time-pair"><input class="break-start-input" type="time" value="${firstBreak.start_time||""}"/><span>–</span><input class="break-end-input" type="time" value="${firstBreak.end_time||""}"/></div>`;root.appendChild(row);});};
  async function refreshSchedule(){const select=$<HTMLSelectElement>("#schedule-staff");if(!select?.value)return;try{const data=await requestJson(`/api/repair-shop/staff-schedule?staff_id=${encodeURIComponent(select.value)}`);renderSchedule(data.schedules||[]);}catch{renderSchedule(defaultDays());}}
  $("#schedule-staff")?.addEventListener("change",()=>void refreshSchedule());
  $("#schedule-form")?.addEventListener("submit",async(event)=>{event.preventDefault();const select=$<HTMLSelectElement>("#schedule-staff");if(!select?.value)return;const payload=[...document.querySelectorAll<HTMLElement>(".schedule-row")].map((row)=>{const isWorking=Boolean(row.querySelector<HTMLInputElement>(".working-input")?.checked);const breakStart=row.querySelector<HTMLInputElement>(".break-start-input")?.value||"";const breakEnd=row.querySelector<HTMLInputElement>(".break-end-input")?.value||"";return{day_of_week:Number(row.dataset.day),is_working:isWorking,start_time:isWorking?(row.querySelector<HTMLInputElement>(".start-input")?.value||""):null,end_time:isWorking?(row.querySelector<HTMLInputElement>(".end-input")?.value||""):null,breaks:isWorking&&breakStart&&breakEnd?[{start_time:breakStart,end_time:breakEnd}]:[]};});try{const data=await requestJson("/api/repair-shop/staff-schedule",{method:"PUT",body:JSON.stringify({staff_id:select.value,days:payload})});renderSchedule(data.schedules||[]);setAlert(t.savedMessage,"success");}catch{setAlert(t.saveFailed);}});

  const init=async()=>{try{const [profile,staffData]=await Promise.all([requestJson("/api/repair-shop/profile"),requestJson("/api/repair-shop/staff")]);if(profile.shop)fillProfile(profile.shop);staff=staffData.staff||[];renderStaff();}catch{setAlert(t.loadFailed);}};void init();
</script>

