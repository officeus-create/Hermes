---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import HermesConnectAccountSwitcher from "../../../../components/HermesConnectAccountSwitcher.astro";
---

<BaseLayout
  title="Company | Hermes Connect Repair Shop"
  description="Owner-only company profile, team schedules, booking link, and connection readiness."
  robots="noindex,nofollow"
>
  <div class="site-header company-account-source" aria-hidden="true">
    <HermesConnectAccountSwitcher current="repair" mode="menu" />
  </div>

  <main id="main-content" class="company-page">
    <div class="company-shell">
      <header class="company-hero">
        <div>
          <p class="eyebrow" data-i18n="eyebrow">Repair Shop CRM</p>
          <h1 data-i18n="title">Company</h1>
          <p class="muted" data-i18n="subtitle">Company profile, team, shifts, breaks and connection readiness in one place.</p>
        </div>
        <span id="profile-state" class="status-pill" data-i18n="notConfigured">Not configured</span>
      </header>

      <div id="page-alert" class="company-alert hidden" role="status" aria-live="polite"></div>

      <nav class="company-tabs" aria-label="Company sections">
        <a href="#profile" data-i18n="profileTab">Profile</a>
        <a href="#team" data-i18n="teamTab">Team</a>
        <a href="#schedule" data-i18n="scheduleTab">Schedules</a>
        <a href="#connections" data-i18n="connectionsTab">Connections</a>
      </nav>

      <section id="profile" class="company-card">
        <div class="card-head">
          <p class="eyebrow" data-i18n="profileEyebrow">Company profile</p>
          <h2 data-i18n="profileTitle">Business details</h2>
          <p class="muted" data-i18n="profileCopy">These saved details are used by your public booking experience.</p>
        </div>
        <form id="profile-form" class="profile-grid">
          <label class="span-2"><span data-i18n="shopName">Shop name</span><input id="shop-name" maxlength="120" required autocomplete="organization" placeholder="Apex Auto Care" /></label>
          <label><span data-i18n="phone">Phone</span><input id="shop-phone" maxlength="32" inputmode="tel" autocomplete="tel" placeholder="+1 414 555 0100" /></label>
          <label><span data-i18n="address">Address</span><input id="shop-address" maxlength="160" autocomplete="street-address" placeholder="123 Main St" /></label>
          <label><span data-i18n="city">City</span><input id="shop-city" maxlength="100" required autocomplete="address-level2" /></label>
          <label><span data-i18n="region">Region / state</span><input id="shop-region" maxlength="100" autocomplete="address-level1" /></label>
          <label><span data-i18n="country">Country code</span><input id="shop-country" maxlength="2" minlength="2" required autocomplete="country" placeholder="US" pattern="[A-Za-z]{2}" /></label>
          <label><span data-i18n="postal">Postal code</span><input id="shop-postal" maxlength="24" autocomplete="postal-code" /></label>
          <label class="span-2"><span data-i18n="timezone">Timezone</span><div class="inline-row"><input id="shop-timezone" maxlength="64" required list="timezone-suggestions" placeholder="America/Chicago" /><button id="detect-timezone" class="secondary-action" type="button" data-i18n="detectTimezone">Use browser timezone</button></div></label>
          <datalist id="timezone-suggestions"><option value="America/New_York"></option><option value="America/Chicago"></option><option value="America/Denver"></option><option value="America/Los_Angeles"></option><option value="Europe/Kyiv"></option><option value="Europe/London"></option><option value="Europe/Paris"></option><option value="Europe/Berlin"></option></datalist>
          <button id="save-profile" class="primary-action span-2" type="submit" data-i18n="saveProfile">Save company profile</button>
        </form>
      </section>

      <section id="public-booking-card" class="company-card hidden">
        <div class="card-head"><p class="eyebrow" data-i18n="bookingEyebrow">Customer access</p><h2 data-i18n="bookingTitle">Public booking link</h2><p class="muted" data-i18n="bookingCopy">Share this stable link after services and availability are ready.</p></div>
        <div class="booking-row"><code id="public-booking-link"></code><div class="booking-actions"><button id="copy-booking-link" class="secondary-action" type="button" data-i18n="copy">Copy</button><a id="open-booking-link" class="secondary-action" href="#" target="_blank" rel="noopener" data-i18n="open">Open</a></div></div>
      </section>

      <section id="team" class="company-card">
        <div class="card-head split-head">
          <div><p class="eyebrow" data-i18n="teamEyebrow">People</p><h2 data-i18n="teamTitle">Team</h2><p class="muted" data-i18n="teamCopy">Add technicians, roles and specialties.</p></div>
          <button id="new-staff" class="secondary-action" type="button" data-i18n="addEmployee">Add employee</button>
        </div>
        <form id="staff-form" class="staff-form hidden">
          <input id="staff-id" type="hidden" />
          <label><span data-i18n="employeeName">Employee name</span><input id="staff-name" maxlength="100" required /></label>
          <label><span data-i18n="role">Role</span><input id="staff-role" maxlength="80" placeholder="Technician" /></label>
          <label class="span-2"><span data-i18n="specialties">Specialties</span><input id="staff-specialties" maxlength="500" placeholder="Brakes, Diagnostics, Electrical" /></label>
          <label class="check-label"><input id="staff-active" type="checkbox" checked /><span data-i18n="activeEmployee">Active employee</span></label>
          <div class="form-actions span-2"><button class="primary-action" type="submit" data-i18n="saveEmployee">Save employee</button><button id="cancel-staff" class="secondary-action" type="button" data-i18n="cancel">Cancel</button></div>
        </form>
        <div id="staff-empty" class="empty-state" data-i18n="staffEmpty">No employees yet. Add your first technician or team member.</div>
        <div id="staff-list" class="staff-list"></div>
      </section>

      <section id="schedule" class="company-card">
        <div class="card-head"><p class="eyebrow" data-i18n="scheduleEyebrow">Working time</p><h2 data-i18n="scheduleTitle">Shifts & breaks</h2><p class="muted" data-i18n="scheduleCopy">Set each employee’s local weekly shift and breaks. Google Calendar free/busy conflicts will layer on top only after authorization.</p></div>
        <label class="schedule-person"><span data-i18n="employee">Employee</span><select id="schedule-staff"></select></label>
        <div id="schedule-empty" class="empty-state" data-i18n="scheduleEmpty">Add an employee before creating a schedule.</div>
        <form id="schedule-form" class="schedule-form hidden">
          <div class="schedule-head"><span data-i18n="day">Day</span><span data-i18n="working">Working</span><span data-i18n="shift">Shift</span><span data-i18n="break">Break</span></div>
          <div id="schedule-days"></div>
          <button class="primary-action" type="submit" data-i18n="saveSchedule">Save schedule</button>
        </form>
      </section>

      <section id="connections" class="company-card">
        <div class="card-head"><p class="eyebrow" data-i18n="connectionsEyebrow">Connections</p><h2 data-i18n="connectionsTitle">Apps & channels</h2><p class="muted" data-i18n="connectionsCopy">No live account is connected from this page yet. These statuses are intentionally honest.</p></div>
        <div class="connection-grid">
          <article class="connection-card priority"><div><strong>Google Calendar</strong><span class="connection-status needs-auth" data-i18n="needsAuth">Needs authorization</span></div><p data-i18n="calendarCopy">First adapter: privacy-minimal free/busy only. Titles, attendees and descriptions are not required. Hermes-created events need separate permission.</p><button type="button" disabled data-i18n="connectLater">Connect after adapter approval</button></article>
          <article class="connection-card"><div><strong data-i18n="email">Email</strong><span class="connection-status planned" data-i18n="planned">Planned</span></div><p data-i18n="emailCopy">Company mailbox connection for owner-authorized operational context.</p></article>
          <article class="connection-card"><div><strong data-i18n="websiteBrand">Website & brandbook</strong><span class="connection-status planned" data-i18n="planned">Planned</span></div><p data-i18n="brandCopy">Logo, colors and brand assets can later flow into the public company page after owner approval.</p></article>
          <article class="connection-card"><div><strong data-i18n="socials">Social channels</strong><span class="connection-status planned" data-i18n="planned">Planned</span></div><p>Instagram · Facebook · Threads · LinkedIn · X</p></article>
          <article class="connection-card"><div><strong data-i18n="jobs">Jobs</strong><span class="connection-status planned" data-i18n="planned">Planned</span></div><p data-i18n="jobsCopy">Vacancy synchronization will use owner-approved sources. Nothing is published automatically.</p></article>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

