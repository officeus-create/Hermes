---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import HermesConnectAccountSwitcher from "../../../../components/HermesConnectAccountSwitcher.astro";
---

<BaseLayout title="Schedule | Hermes Connect Repair Shop" description="Owner-only shop hours, employee shifts and breaks." robots="noindex,nofollow">
  <div class="site-header company-account-source" aria-hidden="true"><HermesConnectAccountSwitcher current="repair" mode="menu" /></div>
  <main id="main-content" class="schedule-page">
    <div class="hc4-page-shell">
      <header class="hc4-page-head"><div><p class="hc4-kicker" data-i18n="kicker">Working time</p><h1 data-i18n="title">Schedule</h1><p data-i18n="subtitle">Shop booking hours and employee shifts are separate controls, shown together without mixing their data.</p></div></header>
      <div id="page-alert" class="hc4-alert hc4-hidden" role="status" aria-live="polite"></div>
      <div class="hc4-segmented" role="tablist" aria-label="Schedule mode"><button type="button" class="is-active" data-schedule-tab="shop" role="tab" aria-selected="true" data-i18n="shopHours">Shop hours</button><button type="button" data-schedule-tab="staff" role="tab" aria-selected="false" data-i18n="staffShifts">Staff shifts & breaks</button></div>

      <section class="hc4-card" data-schedule-panel="shop">
        <div class="hc4-card-head"><div><p class="hc4-eyebrow" data-i18n="bookingWindow">Booking window</p><h2 data-i18n="shopHours">Shop hours</h2><p data-i18n="shopCopy">These are the real hours used to build customer booking windows.</p></div><span id="shop-timezone" class="hc4-status">—</span></div>
        <div id="shop-day-tabs" class="hc4-day-tabs" aria-label="Choose day"></div>
        <form id="shop-hours-form">
          <div class="hc4-schedule-head"><span data-i18n="day">Day</span><span data-i18n="open">Open</span><span data-i18n="hours">Hours</span></div>
          <div id="shop-hours-list" class="hc4-schedule-list"></div>
          <div class="hc4-actions hc4-save-row"><button id="save-shop-hours" class="hc4-button primary" type="submit" data-i18n="saveShop">Save shop hours</button></div>
        </form>
      </section>

      <section class="hc4-card hc4-hidden" data-schedule-panel="staff">
        <div class="hc4-card-head"><div><p class="hc4-eyebrow" data-i18n="employeeTime">Employee time</p><h2 data-i18n="staffShifts">Staff shifts & breaks</h2><p data-i18n="staffCopy">Choose one employee, then edit their weekly shift and break windows.</p></div><span id="calendar-source" class="hc4-status" data-i18n="localOnly">Local schedule only</span></div>
        <label class="hc4-field hc4-employee-select"><span data-i18n="employee">Employee</span><select id="schedule-staff"></select></label>
        <div id="staff-schedule-empty" class="hc4-empty hc4-hidden" data-i18n="noStaff">Add an employee in Team before creating a staff schedule.</div>
        <form id="staff-schedule-form" class="hc4-hidden">
          <div id="staff-day-tabs" class="hc4-day-tabs" aria-label="Choose day"></div>
          <div class="hc4-schedule-head hc4-staff-head"><span data-i18n="day">Day</span><span data-i18n="working">Working</span><span data-i18n="shift">Shift</span><span data-i18n="break">Break</span></div>
          <div id="staff-schedule-list" class="hc4-schedule-list"></div>
          <div class="hc4-actions hc4-save-row"><button id="save-staff-schedule" class="hc4-button primary" type="submit" data-i18n="saveStaff">Save staff schedule</button></div>
        </form>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  type ShopDay={day_of_week:number;is_open:boolean;start_time:string|null;end_time:string|null};
  type Staff={id:string;name:string;active:boolean};
  type StaffDay={day_of_week:number;is_working:boolean;start_time:string|null;end_time:string|null;breaks:{start_time:string;end_time:string}[]};
  const supported=new Set(["en","ru","uk","es","it","fr"]);const requested=(new URLSearchParams(location.search).get("lang")||"en").toLowerCase();const locale=supported.has(requested)?requested:"en";const localeTag=locale==="en"?"en-US":locale;
  const strings:Record<string,Record<string,string>>={
    en:{kicker:"Working time",title:"Schedule",subtitle:"Shop booking hours and employee shifts are separate controls, shown together without mixing their data.",shopHours:"Shop hours",staffShifts:"Staff shifts & breaks",bookingWindow:"Booking window",shopCopy:"These are the real hours used to build customer booking windows.",employeeTime:"Employee time",staffCopy:"Choose one employee, then edit their weekly shift and break windows.",localOnly:"Local schedule only",employee:"Employee",noStaff:"Add an employee in Team before creating a staff schedule.",day:"Day",open:"Open",hours:"Hours",working:"Working",shift:"Shift",break:"Break",saveShop:"Save shop hours",saveStaff:"Save staff schedule",saved:"Schedule saved.",loadFailed:"Unable to load schedule.",saveFailed:"Unable to save schedule.",closed:"Closed",off:"Off"},
    ru:{kicker:"Рабочее время",title:"График",subtitle:"Часы записи СТО и смены сотрудников — разные настройки. Здесь они рядом, но данные не смешиваются.",shopHours:"Часы работы СТО",staffShifts:"Смены и перерывы",bookingWindow:"Окно записи",shopCopy:"Эти реальные часы используются для формирования доступной записи клиентов.",employeeTime:"Время сотрудника",staffCopy:"Выберите сотрудника и настройте его смены и перерывы на неделю.",localOnly:"Только локальный график",employee:"Сотрудник",noStaff:"Сначала добавьте сотрудника в разделе Команда.",day:"День",open:"Открыто",hours:"Часы",working:"Работает",shift:"Смена",break:"Перерыв",saveShop:"Сохранить часы СТО",saveStaff:"Сохранить график сотрудника",saved:"График сохранён.",loadFailed:"Не удалось загрузить график.",saveFailed:"Не удалось сохранить график.",closed:"Закрыто",off:"Выходной"},
    uk:{kicker:"Робочий час",title:"Графік",subtitle:"Години запису СТО та зміни співробітників — окремі налаштування.",shopHours:"Години роботи СТО",staffShifts:"Зміни та перерви",bookingWindow:"Вікно запису",shopCopy:"Ці години використовуються для реального запису клієнтів.",employeeTime:"Час співробітника",staffCopy:"Оберіть співробітника та налаштуйте зміни й перерви.",localOnly:"Лише локальний графік",employee:"Співробітник",noStaff:"Спочатку додайте співробітника в Команді.",day:"День",open:"Відкрито",hours:"Години",working:"Працює",shift:"Зміна",break:"Перерва",saveShop:"Зберегти години СТО",saveStaff:"Зберегти графік",saved:"Графік збережено.",loadFailed:"Не вдалося завантажити графік.",saveFailed:"Не вдалося зберегти графік.",closed:"Зачинено",off:"Вихідний"},
    es:{kicker:"Tiempo de trabajo",title:"Horario",subtitle:"El horario del taller y los turnos del equipo son controles separados.",shopHours:"Horario del taller",staffShifts:"Turnos y descansos",bookingWindow:"Ventana de reserva",shopCopy:"Estas horas reales generan las ventanas de reserva.",employeeTime:"Tiempo del empleado",staffCopy:"Elige un empleado y edita sus turnos y descansos.",localOnly:"Solo horario local",employee:"Empleado",noStaff:"Añade un empleado en Equipo primero.",day:"Día",open:"Abierto",hours:"Horas",working:"Trabaja",shift:"Turno",break:"Descanso",saveShop:"Guardar horario",saveStaff:"Guardar turnos",saved:"Horario guardado.",loadFailed:"No se pudo cargar.",saveFailed:"No se pudo guardar.",closed:"Cerrado",off:"Libre"},
    it:{kicker:"Orario di lavoro",title:"Orari",subtitle:"Orari officina e turni del personale sono controlli separati.",shopHours:"Orari officina",staffShifts:"Turni e pause",bookingWindow:"Finestra prenotazioni",shopCopy:"Questi orari reali generano le finestre di prenotazione.",employeeTime:"Orario dipendente",staffCopy:"Scegli un dipendente e modifica turni e pause.",localOnly:"Solo orario locale",employee:"Dipendente",noStaff:"Aggiungi prima un dipendente in Team.",day:"Giorno",open:"Aperto",hours:"Orari",working:"Lavora",shift:"Turno",break:"Pausa",saveShop:"Salva orari",saveStaff:"Salva turni",saved:"Orario salvato.",loadFailed:"Impossibile caricare.",saveFailed:"Impossibile salvare.",closed:"Chiuso",off:"Libero"},
    fr:{kicker:"Temps de travail",title:"Planning",subtitle:"Les horaires de l’atelier et les shifts des employés restent séparés.",shopHours:"Horaires atelier",staffShifts:"Shifts et pauses",bookingWindow:"Fenêtre de réservation",shopCopy:"Ces horaires réels déterminent les créneaux de réservation.",employeeTime:"Temps employé",staffCopy:"Choisissez un employé puis modifiez ses shifts et pauses.",localOnly:"Planning local uniquement",employee:"Employé",noStaff:"Ajoutez d’abord un employé dans Équipe.",day:"Jour",open:"Ouvert",hours:"Horaires",working:"Travaille",shift:"Shift",break:"Pause",saveShop:"Enregistrer les horaires",saveStaff:"Enregistrer les shifts",saved:"Planning enregistré.",loadFailed:"Impossible de charger.",saveFailed:"Impossible d’enregistrer.",closed:"Fermé",off:"Repos"}
  };const t=strings[locale]||strings.en;document.documentElement.lang=locale;document.querySelectorAll<HTMLElement>("[data-i18n]").forEach(n=>{const k=n.dataset.i18n||"";if(t[k])n.textContent=t[k]});
  const $=<T extends HTMLElement=HTMLElement>(id:string)=>document.getElementById(id) as T|null;const order=[1,2,3,4,5,6,0];let shopDays:ShopDay[]=Array.from({length:7},(_,d)=>({day_of_week:d,is_open:false,start_time:null,end_time:null}));let staff:Staff[]=[];let staffDays:StaffDay[]=[];let selectedStaff="";const alertBox=$("page-alert");
  const dayName=(d:number,long=false)=>new Intl.DateTimeFormat(localeTag,{weekday:long?"long":"short",timeZone:"UTC"}).format(new Date(Date.UTC(2026,0,4+d)));
  const redirectAuth=()=>{const u=new URL("/services/hermes-connect/repair-shops/auth/",location.origin);if(locale!=="en")u.searchParams.set("lang",locale);location.assign(`${u.pathname}${u.search}`)};const read=async(r:Response)=>{try{return await r.json()}catch{return {success:false}}};const alert=(m:string,tone="")=>{if(!alertBox)return;alertBox.textContent=m;alertBox.className=`hc4-alert ${tone}`.trim()};
  const setMobileDay=(rootId:string,tabsId:string,day:number)=>{document.querySelectorAll<HTMLElement>(`#${rootId} .hc4-schedule-row`).forEach(row=>row.classList.toggle("is-mobile-selected",Number(row.dataset.day)===day));document.querySelectorAll<HTMLButtonElement>(`#${tabsId} button`).forEach(btn=>{const active=Number(btn.dataset.day)===day;btn.classList.toggle("is-active",active);btn.setAttribute("aria-selected",String(active))})};
  const renderDayTabs=(id:string,rootId:string)=>{const root=$(id)!;root.replaceChildren();for(const d of order){const b=document.createElement("button");b.type="button";b.dataset.day=String(d);b.textContent=dayName(d);b.setAttribute("aria-selected",String(d===1));b.addEventListener("click",()=>setMobileDay(rootId,id,d));root.append(b)}};
  function renderShop(){const root=$("shop-hours-list")!;root.replaceChildren();for(const d of order){const value=shopDays.find(x=>x.day_of_week===d)||{day_of_week:d,is_open:false,start_time:null,end_time:null};const row=document.createElement("div");row.className=`hc4-schedule-row ${d===1?"is-mobile-selected":""}`;row.dataset.day=String(d);const name=document.createElement("strong");name.textContent=dayName(d,true);const toggle=document.createElement("label");toggle.className="hc4-switch";const check=document.createElement("input");check.type="checkbox";check.checked=value.is_open;check.setAttribute("aria-label",`${dayName(d,true)} ${t.open}`);const track=document.createElement("span");toggle.append(check,track);const times=document.createElement("div");times.className="hc4-time-pair";const start=document.createElement("input");start.type="time";start.value=value.start_time||"08:00";const sep=document.createElement("span");sep.textContent="–";const end=document.createElement("input");end.type="time";end.value=value.end_time||"17:00";start.disabled=end.disabled=!check.checked;check.addEventListener("change",()=>{start.disabled=end.disabled=!check.checked});times.append(start,sep,end);row.append(name,toggle,times);root.append(row)}renderDayTabs("shop-day-tabs","shop-hours-list")}
  function defaultStaffDays():StaffDay[]{return Array.from({length:7},(_,d)=>({day_of_week:d,is_working:d>0&&d<6,start_time:d>0&&d<6?"09:00":null,end_time:d>0&&d<6?"17:00":null,breaks:[]}))}
  function renderStaff(){const root=$("staff-schedule-list")!;root.replaceChildren();for(const d of order){const value=staffDays.find(x=>x.day_of_week===d)||defaultStaffDays()[d];const br=value.breaks?.[0]||{start_time:"",end_time:""};const row=document.createElement("div");row.className=`hc4-schedule-row hc4-staff-row ${d===1?"is-mobile-selected":""}`;row.dataset.day=String(d);const name=document.createElement("strong");name.textContent=dayName(d,true);const toggle=document.createElement("label");toggle.className="hc4-switch";const check=document.createElement("input");check.type="checkbox";check.checked=value.is_working;const track=document.createElement("span");toggle.append(check,track);const shift=document.createElement("div");shift.className="hc4-time-pair";const start=document.createElement("input");start.className="start-input";start.type="time";start.value=value.start_time||"09:00";const sep=document.createElement("span");sep.textContent="–";const end=document.createElement("input");end.className="end-input";end.type="time";end.value=value.end_time||"17:00";shift.append(start,sep,end);const breaks=document.createElement("div");breaks.className="hc4-time-pair";const bs=document.createElement("input");bs.className="break-start-input";bs.type="time";bs.value=br.start_time||"";const bsep=document.createElement("span");bsep.textContent="–";const be=document.createElement("input");be.className="break-end-input";be.type="time";be.value=br.end_time||"";breaks.append(bs,bsep,be);const sync=()=>{[start,end,bs,be].forEach(input=>input.disabled=!check.checked)};check.addEventListener("change",sync);sync();row.append(name,toggle,shift,breaks);root.append(row)}renderDayTabs("staff-day-tabs","staff-schedule-list")}
  async function loadShop(){const r=await fetch("/api/repair-shop/availability",{credentials:"same-origin"});if(r.status===401)return redirectAuth();const d=await read(r);if(!r.ok||!d.success){alert(t.loadFailed,"error");return}shopDays=Array.isArray(d.days)?d.days:shopDays;$("shop-timezone")!.textContent=d.timezone||"—";renderShop()}
  async function loadStaffList(){const r=await fetch("/api/repair-shop/staff",{credentials:"same-origin"});if(r.status===401)return redirectAuth();const d=await read(r);if(!r.ok||!d.success){alert(t.loadFailed,"error");return}staff=Array.isArray(d.staff)?d.staff.filter((x:Staff)=>x.active!==false):[];const select=$<HTMLSelectElement>("schedule-staff")!;select.replaceChildren();if(!staff.length){$("staff-schedule-empty")?.classList.remove("hc4-hidden");$("staff-schedule-form")?.classList.add("hc4-hidden");return}for(const member of staff){const option=document.createElement("option");option.value=member.id;option.textContent=member.name;select.append(option)}selectedStaff=staff[0].id;$("staff-schedule-empty")?.classList.add("hc4-hidden");$("staff-schedule-form")?.classList.remove("hc4-hidden");await loadStaffSchedule(selectedStaff)}
  async function loadStaffSchedule(staffId:string){if(!staffId)return;const r=await fetch(`/api/repair-shop/staff-schedule?staff_id=${encodeURIComponent(staffId)}`,{credentials:"same-origin"});if(r.status===401)return redirectAuth();const d=await read(r);if(!r.ok||!d.success){alert(t.loadFailed,"error");return}staffDays=Array.isArray(d.schedules)&&d.schedules.length?d.schedules:defaultStaffDays();const source=$("calendar-source");if(source)source.textContent=d.calendar_conflicts_source==="local_only"?t.localOnly:String(d.calendar_conflicts_source||t.localOnly);renderStaff()}
  document.querySelectorAll<HTMLButtonElement>("[data-schedule-tab]").forEach(button=>button.addEventListener("click",()=>{const mode=button.dataset.scheduleTab;document.querySelectorAll<HTMLButtonElement>("[data-schedule-tab]").forEach(b=>{const active=b===button;b.classList.toggle("is-active",active);b.setAttribute("aria-selected",String(active))});document.querySelectorAll<HTMLElement>("[data-schedule-panel]").forEach(panel=>panel.classList.toggle("hc4-hidden",panel.dataset.schedulePanel!==mode))}));
  $<HTMLSelectElement>("schedule-staff")?.addEventListener("change",async(event)=>{selectedStaff=(event.currentTarget as HTMLSelectElement).value;await loadStaffSchedule(selectedStaff)});
  $<HTMLFormElement>("shop-hours-form")?.addEventListener("submit",async(event)=>{event.preventDefault();const rows=[...document.querySelectorAll<HTMLElement>("#shop-hours-list .hc4-schedule-row")];const days=rows.map(row=>{const check=row.querySelector<HTMLInputElement>('input[type="checkbox"]')!;const times=row.querySelectorAll<HTMLInputElement>('input[type="time"]');return{day_of_week:Number(row.dataset.day),is_open:check.checked,start_time:check.checked?times[0].value:null,end_time:check.checked?times[1].value:null}});const save=$<HTMLButtonElement>("save-shop-hours");if(save)save.disabled=true;try{const r=await fetch("/api/repair-shop/availability",{method:"PUT",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({days})});if(r.status===401)return redirectAuth();const d=await read(r);if(!r.ok||!d.success)return alert(t.saveFailed,"error");shopDays=d.days||days;renderShop();alert(t.saved,"success")}catch{alert(t.saveFailed,"error")}finally{if(save)save.disabled=false}});
  $<HTMLFormElement>("staff-schedule-form")?.addEventListener("submit",async(event)=>{event.preventDefault();const rows=[...document.querySelectorAll<HTMLElement>("#staff-schedule-list .hc4-schedule-row")];const days=rows.map(row=>{const check=row.querySelector<HTMLInputElement>('input[type="checkbox"]')!;const start=row.querySelector<HTMLInputElement>(".start-input")!;const end=row.querySelector<HTMLInputElement>(".end-input")!;const bs=row.querySelector<HTMLInputElement>(".break-start-input")!;const be=row.querySelector<HTMLInputElement>(".break-end-input")!;const breaks=check.checked&&bs.value&&be.value?[{start_time:bs.value,end_time:be.value}]:[];return{day_of_week:Number(row.dataset.day),is_working:check.checked,start_time:check.checked?start.value:null,end_time:check.checked?end.value:null,breaks}});const save=$<HTMLButtonElement>("save-staff-schedule");if(save)save.disabled=true;try{const r=await fetch("/api/repair-shop/staff-schedule",{method:"PUT",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({staff_id:selectedStaff,days})});if(r.status===401)return redirectAuth();const d=await read(r);if(!r.ok||!d.success)return alert(t.saveFailed,"error");staffDays=d.schedules||days;renderStaff();alert(t.saved,"success")}catch{alert(t.saveFailed,"error")}finally{if(save)save.disabled=false}});
  Promise.all([loadShop(),loadStaffList()]);
</script>

<style>
  .hc4-segmented{display:inline-grid;grid-template-columns:1fr 1fr;gap:3px;justify-self:start;padding:3px;border:1px solid #e1e7ee;border-radius:12px;background:#fff}.hc4-segmented button{min-height:38px;padding:0 13px;border:0;border-radius:9px;background:transparent;color:#69778a;font:inherit;font-size:11px;font-weight:800;cursor:pointer}.hc4-segmented button.is-active{background:#edf5ff;color:#165fae}.hc4-employee-select{max-width:360px;margin-bottom:14px}.hc4-schedule-head,.hc4-schedule-row{display:grid;grid-template-columns:minmax(120px,.75fr) 72px minmax(220px,1fr);align-items:center;gap:12px}.hc4-staff-head,.hc4-staff-row{grid-template-columns:minmax(120px,.7fr) 72px minmax(190px,1fr) minmax(190px,1fr)}.hc4-schedule-head{padding:0 11px 7px;color:#8d98a7;font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.hc4-schedule-list{display:grid;gap:6px}.hc4-schedule-row{min-height:52px;padding:8px 11px;border:1px solid #e6ebf1;border-radius:11px;background:#fbfcfe}.hc4-schedule-row>strong{color:#39475c;font-size:11px}.hc4-switch{position:relative;display:inline-flex;align-items:center;width:38px;height:22px}.hc4-switch input{position:absolute;opacity:0}.hc4-switch span{width:36px;height:20px;border-radius:999px;background:#d7dee7;transition:.12s}.hc4-switch span::after{content:"";display:block;width:16px;height:16px;margin:2px;border-radius:50%;background:#fff;box-shadow:0 1px 4px rgba(25,38,58,.2);transition:.12s}.hc4-switch input:checked+span{background:#2775d5}.hc4-switch input:checked+span::after{transform:translateX(16px)}.hc4-time-pair{display:grid;grid-template-columns:minmax(0,1fr) 12px minmax(0,1fr);align-items:center;gap:5px}.hc4-time-pair input{width:100%;min-width:0;min-height:36px;padding:0 7px;border:1px solid #dce3eb;border-radius:8px;background:#fff;color:#344258;font:inherit;font-size:10px}.hc4-time-pair span{text-align:center;color:#9aa5b3}.hc4-time-pair input:disabled{background:#f1f3f6;color:#a4adba}.hc4-save-row{margin-top:12px}.hc4-day-tabs{display:none}
  @media(max-width:780px){.hc4-segmented{display:grid;width:100%;box-sizing:border-box}.hc4-schedule-head{display:none}.hc4-day-tabs{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;margin:0 0 10px}.hc4-day-tabs button{min-width:0;min-height:36px;padding:0;border:1px solid #e2e8ef;border-radius:9px;background:#fff;color:#7b8797;font:inherit;font-size:9px;font-weight:850;text-transform:uppercase}.hc4-day-tabs button.is-active{border-color:#cfe0f5;background:#edf5ff;color:#135eab}.hc4-schedule-row{display:none;grid-template-columns:minmax(0,1fr) 46px;gap:10px;padding:13px}.hc4-schedule-row.is-mobile-selected{display:grid}.hc4-schedule-row>strong{font-size:14px}.hc4-schedule-row>.hc4-time-pair{grid-column:1/-1}.hc4-staff-row>.hc4-time-pair::before{display:block;grid-column:1/-1;margin-bottom:2px;color:#8995a4;font-size:9px;font-weight:800;text-transform:uppercase}.hc4-staff-row>.hc4-time-pair:nth-of-type(1)::before{content:"Shift"}.hc4-staff-row>.hc4-time-pair:nth-of-type(2)::before{content:"Break"}.hc4-time-pair{grid-template-columns:minmax(0,1fr) 14px minmax(0,1fr)}.hc4-time-pair input{min-height:44px;font-size:12px}.hc4-save-row .hc4-button{width:100%}}
</style>
