---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import HermesConnectAccountSwitcher from "../../../../components/HermesConnectAccountSwitcher.astro";
---

<BaseLayout title="Driver Benefits | Hermes Connect Repair Shop" description="Owner-only driver discount configuration." robots="noindex,nofollow">
  <div class="site-header company-account-source" aria-hidden="true"><HermesConnectAccountSwitcher current="repair" mode="menu" /></div>
  <main id="main-content" class="benefits-page">
    <div class="hc4-page-shell">
      <header class="hc4-page-head"><div><p class="hc4-kicker" data-i18n="kicker">Driver program</p><h1 data-i18n="title">Driver Benefits</h1><p data-i18n="subtitle">Configure one clear, publishable benefit without the oversized dashboard module.</p></div><span id="benefit-state" class="hc4-status" data-i18n="loading">Loading…</span></header>
      <div id="page-alert" class="hc4-alert hc4-hidden" role="status" aria-live="polite"></div>
      <section class="hc4-card hc4-benefit-card">
        <div class="hc4-benefit-top">
          <div class="hc4-benefit-symbol" aria-hidden="true">%</div>
          <div><p class="hc4-eyebrow" data-i18n="eyebrow">Hermes Connect driver benefit</p><h2 data-i18n="discount">Driver discount</h2><p data-i18n="discountCopy">Choose the discount, scope and services. Nothing is shown publicly until you enable it.</p></div>
          <label class="hc4-publish"><input id="discount-enabled" type="checkbox" /><span><b data-i18n="publish">Public</b><small data-i18n="publishCopy">Show on booking page</small></span></label>
        </div>
        <form id="benefit-form" class="hc4-benefit-form">
          <section class="hc4-benefit-section">
            <div class="hc4-benefit-section-head"><div><p class="hc4-eyebrow" data-i18n="services">Services</p><h3 data-i18n="serviceDiscount">Service discount</h3></div><label class="hc4-percent"><input id="service-percent" type="number" min="0" max="100" step="1" value="0" /><span>%</span></label></div>
            <div class="hc4-scope"><label><input type="radio" name="service-scope" value="all" checked /><span data-i18n="allServices">All published services</span></label><label><input type="radio" name="service-scope" value="selected" /><span data-i18n="selectedServices">Selected services</span></label></div>
            <div id="selected-services" class="hc4-selected hc4-hidden"><p data-i18n="chooseServices">Choose discounted services</p><div id="service-list" class="hc4-service-picks"></div></div>
          </section>
          <section class="hc4-benefit-section">
            <div class="hc4-benefit-section-head"><div><p class="hc4-eyebrow" data-i18n="materials">Parts & materials</p><h3 data-i18n="materialsDiscount">Materials discount</h3></div><label class="hc4-percent"><input id="materials-percent" type="number" min="0" max="100" step="1" value="0" /><span>%</span></label></div>
            <div class="hc4-scope"><label><input type="radio" name="materials-scope" value="all" checked /><span data-i18n="allMaterials">All parts & materials</span></label><label><input type="radio" name="materials-scope" value="selected" /><span data-i18n="selectedMaterials">Selected items</span></label></div>
            <div id="selected-materials" class="hc4-selected hc4-hidden"><label class="hc4-field"><span data-i18n="listMaterials">Discounted parts / materials</span><textarea id="materials-list" maxlength="1700" placeholder="engine oil, filters, brake pads"></textarea></label></div>
          </section>
          <div class="hc4-benefit-footer"><p id="benefit-summary" class="hc4-benefit-summary" data-i18n="summaryOff">Discount is currently off.</p><button id="save-benefit" class="hc4-button primary" type="submit" data-i18n="save">Save driver benefit</button></div>
        </form>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const supported=new Set(["en","ru","uk","es","it","fr"]);const requested=(new URLSearchParams(location.search).get("lang")||"en").toLowerCase();const locale=supported.has(requested)?requested:"en";
  const strings:Record<string,Record<string,string>>={
    en:{kicker:"Driver program",title:"Driver Benefits",subtitle:"Configure one clear, publishable benefit without the oversized dashboard module.",loading:"Loading…",enabled:"Public",disabled:"Private",eyebrow:"Hermes Connect driver benefit",discount:"Driver discount",discountCopy:"Choose the discount, scope and services. Nothing is shown publicly until you enable it.",publish:"Public",publishCopy:"Show on booking page",services:"Services",serviceDiscount:"Service discount",allServices:"All published services",selectedServices:"Selected services",chooseServices:"Choose discounted services",materials:"Parts & materials",materialsDiscount:"Materials discount",allMaterials:"All parts & materials",selectedMaterials:"Selected items",listMaterials:"Discounted parts / materials",summaryOff:"Discount is currently off.",save:"Save driver benefit",saved:"Driver benefit saved.",loadFailed:"Unable to load driver benefit.",saveFailed:"Unable to save driver benefit.",profileFirst:"Save the Company profile before configuring Driver Benefits.",valueRequired:"Enter at least one discount above 0% or turn the benefit off.",serviceRequired:"Choose at least one service.",materialRequired:"List at least one part or material."},
    ru:{kicker:"Программа для водителей",title:"Льготы водителям",subtitle:"Настройте одну понятную публичную выгоду без огромного блока на Dashboard.",loading:"Загрузка…",enabled:"Публично",disabled:"Скрыто",eyebrow:"Выгода Hermes Connect",discount:"Скидка для водителей",discountCopy:"Выберите размер скидки и область действия. Публично она появится только после включения.",publish:"Публично",publishCopy:"Показывать при записи",services:"Услуги",serviceDiscount:"Скидка на услуги",allServices:"Все опубликованные услуги",selectedServices:"Выбранные услуги",chooseServices:"Выберите услуги со скидкой",materials:"Запчасти и материалы",materialsDiscount:"Скидка на материалы",allMaterials:"Все запчасти и материалы",selectedMaterials:"Выбранные позиции",listMaterials:"Запчасти / материалы со скидкой",summaryOff:"Скидка сейчас выключена.",save:"Сохранить льготу",saved:"Льгота для водителей сохранена.",loadFailed:"Не удалось загрузить льготу.",saveFailed:"Не удалось сохранить льготу.",profileFirst:"Сначала сохраните профиль в разделе Компания.",valueRequired:"Укажите хотя бы одну скидку больше 0% или выключите льготу.",serviceRequired:"Выберите хотя бы одну услугу.",materialRequired:"Укажите хотя бы одну запчасть или материал."}
  };const t=strings[locale]||strings.en;document.documentElement.lang=locale;document.querySelectorAll<HTMLElement>("[data-i18n]").forEach(n=>{const k=n.dataset.i18n||"";if(t[k])n.textContent=t[k]});
  const $=<T extends HTMLElement=HTMLElement>(id:string)=>document.getElementById(id) as T|null;let services:any[]=[];const alertBox=$("page-alert");
  const redirectAuth=()=>{const u=new URL("/services/hermes-connect/repair-shops/auth/",location.origin);if(locale!=="en")u.searchParams.set("lang",locale);location.assign(`${u.pathname}${u.search}`)};const read=async(r:Response)=>{try{return await r.json()}catch{return {success:false}}};const alert=(m:string,tone="")=>{if(!alertBox)return;alertBox.textContent=m;alertBox.className=`hc4-alert ${tone}`.trim()};const split=(v:string)=>[...new Set(v.split(/[\n,]+/).map(x=>x.trim()).filter(Boolean))].slice(0,20);
  const scope=(name:string)=>document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value||"all";
  const syncScopes=()=>{$("selected-services")?.classList.toggle("hc4-hidden",scope("service-scope")!=="selected");$("selected-materials")?.classList.toggle("hc4-hidden",scope("materials-scope")!=="selected")};document.querySelectorAll('input[name="service-scope"],input[name="materials-scope"]').forEach(n=>n.addEventListener("change",syncScopes));
  const renderServices=(selected:string[]=[])=>{const root=$("service-list")!;root.replaceChildren();const selectedSet=new Set(selected.map(String));for(const service of services){const label=document.createElement("label");label.className="hc4-service-pick";const input=document.createElement("input");input.type="checkbox";input.value=String(service.id);input.checked=selectedSet.has(String(service.id));const span=document.createElement("span");span.textContent=String(service.name||"Service");label.append(input,span);root.append(label)}};
  const updateSummary=()=>{const enabled=Boolean($<HTMLInputElement>("discount-enabled")?.checked);const sp=Number($<HTMLInputElement>("service-percent")?.value||0);const mp=Number($<HTMLInputElement>("materials-percent")?.value||0);$("benefit-state")!.textContent=enabled?t.enabled:t.disabled;$("benefit-summary")!.textContent=enabled?[sp?`${sp}% services`:"",mp?`${mp}% parts/materials`:""].filter(Boolean).join(" · ")||t.summaryOff:t.summaryOff};
  [$<HTMLInputElement>("discount-enabled"),$<HTMLInputElement>("service-percent"),$<HTMLInputElement>("materials-percent")].forEach(n=>n?.addEventListener("input",updateSummary));
  async function load(){try{const [dr,sr]=await Promise.all([fetch("/api/repair-shop/driver-discount",{credentials:"same-origin"}),fetch("/api/services",{credentials:"same-origin"})]);if(dr.status===401||sr.status===401)return redirectAuth();const dd=await read(dr),sd=await read(sr);if(dr.status===409&&dd.error==="shop_profile_required"){alert(t.profileFirst,"error");document.querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLButtonElement>("#benefit-form input,#benefit-form textarea,#benefit-form button").forEach(n=>n.disabled=true);return}if(!dr.ok||!dd.success)throw new Error();services=sr.ok&&sd.success&&Array.isArray(sd.services)?sd.services:[];const d=dd.discount||{};($<HTMLInputElement>("discount-enabled")!).checked=Boolean(d.enabled);($<HTMLInputElement>("service-percent")!).value=String(d.service_discount_percent||0);($<HTMLInputElement>("materials-percent")!).value=String(d.materials_discount_percent||0);const ss=document.querySelector<HTMLInputElement>(`input[name="service-scope"][value="${d.service_scope==="selected"?"selected":"all"}"]`);if(ss)ss.checked=true;const ms=document.querySelector<HTMLInputElement>(`input[name="materials-scope"][value="${d.materials_scope==="selected"?"selected":"all"}"]`);if(ms)ms.checked=true;renderServices(Array.isArray(d.service_ids)?d.service_ids:[]);($<HTMLTextAreaElement>("materials-list")!).value=Array.isArray(d.materials_items)?d.materials_items.join(", "):"";syncScopes();updateSummary()}catch{alert(t.loadFailed,"error")}}
  $<HTMLFormElement>("benefit-form")?.addEventListener("submit",async(event)=>{event.preventDefault();const button=$<HTMLButtonElement>("save-benefit");if(button)button.disabled=true;const serviceScope=scope("service-scope"),materialsScope=scope("materials-scope");const serviceIds=[...document.querySelectorAll<HTMLInputElement>("#service-list input:checked")].map(n=>n.value);const materialsItems=split($<HTMLTextAreaElement>("materials-list")?.value||"");const payload={enabled:Boolean($<HTMLInputElement>("discount-enabled")?.checked),service_discount_percent:Number($<HTMLInputElement>("service-percent")?.value||0),service_scope:serviceScope,service_ids:serviceIds,materials_discount_percent:Number($<HTMLInputElement>("materials-percent")?.value||0),materials_scope:materialsScope,materials_items:materialsItems};if(payload.enabled&&payload.service_discount_percent===0&&payload.materials_discount_percent===0){alert(t.valueRequired,"error");if(button)button.disabled=false;return}if(payload.service_discount_percent>0&&serviceScope==="selected"&&!serviceIds.length){alert(t.serviceRequired,"error");if(button)button.disabled=false;return}if(payload.materials_discount_percent>0&&materialsScope==="selected"&&!materialsItems.length){alert(t.materialRequired,"error");if(button)button.disabled=false;return}try{const r=await fetch("/api/repair-shop/driver-discount",{method:"PUT",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});if(r.status===401)return redirectAuth();const d=await read(r);if(!r.ok||!d.success)return alert(t.saveFailed,"error");updateSummary();alert(t.saved,"success")}catch{alert(t.saveFailed,"error")}finally{if(button)button.disabled=false}});
  syncScopes();load();
</script>

<style>
  .hc4-benefit-card{padding:0!important;overflow:hidden}.hc4-benefit-top{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:14px;padding:18px;border-bottom:1px solid #e7ebf1;background:linear-gradient(120deg,#f5fbf7,#fff 50%,#f5f8ff)}.hc4-benefit-symbol{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:#e9f7ee;color:#227448;font-size:21px;font-weight:950}.hc4-benefit-top h2{margin:2px 0 4px;color:#1d2a3f;font-size:19px}.hc4-benefit-top p:last-child{margin:0;color:#758297;font-size:11px;line-height:1.45}.hc4-publish{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid #dce7e0;border-radius:11px;background:#fff;cursor:pointer}.hc4-publish input{width:18px;height:18px;accent-color:#258858}.hc4-publish span{display:grid;gap:1px}.hc4-publish b{color:#2a5e40;font-size:10px}.hc4-publish small{color:#82908a;font-size:8px}.hc4-benefit-form{display:grid;grid-template-columns:1fr 1fr;gap:0}.hc4-benefit-section{padding:18px}.hc4-benefit-section+section{border-left:1px solid #e7ebf1}.hc4-benefit-section-head{display:flex;align-items:center;justify-content:space-between;gap:14px}.hc4-benefit-section h3{margin:2px 0;color:#243147;font-size:15px}.hc4-percent{display:flex;align-items:center;gap:4px;color:#5f6d80;font-size:12px;font-weight:850}.hc4-percent input{width:66px;min-height:40px;padding:0 7px;border:1px solid #dce3eb;border-radius:9px;background:#fff;color:#233147;font:inherit;font-weight:850;text-align:center}.hc4-scope{display:grid;gap:7px;margin:14px 0}.hc4-scope label,.hc4-service-pick{display:flex;align-items:center;gap:8px;color:#536176;font-size:11px;font-weight:680}.hc4-scope input,.hc4-service-pick input{accent-color:#1769d2}.hc4-selected{margin-top:10px;padding-top:10px;border-top:1px solid #edf0f4}.hc4-selected>p{margin:0 0 8px;color:#8490a0;font-size:9px;font-weight:850;text-transform:uppercase}.hc4-service-picks{display:grid;grid-template-columns:1fr 1fr;gap:6px}.hc4-service-pick{padding:8px;border:1px solid #e6ebf1;border-radius:9px;background:#fafbfd}.hc4-benefit-footer{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 18px;border-top:1px solid #e7ebf1;background:#fbfcfe}.hc4-benefit-summary{margin:0;color:#657387;font-size:11px;font-weight:740}
  @media(max-width:780px){.hc4-benefit-top{grid-template-columns:auto minmax(0,1fr)}.hc4-publish{grid-column:1/-1;justify-content:flex-start}.hc4-benefit-form{grid-template-columns:1fr}.hc4-benefit-section+section{border-top:1px solid #e7ebf1;border-left:0}.hc4-service-picks{grid-template-columns:1fr}.hc4-benefit-footer{align-items:stretch;flex-direction:column}.hc4-benefit-footer .hc4-button{width:100%}}
</style>
