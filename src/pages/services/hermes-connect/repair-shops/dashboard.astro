---
import { ArrowLeft, CalendarClock, Copy, ExternalLink, LogOut, MessageSquareText, Plus, Users } from "@lucide/astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
---

<BaseLayout
  title="Repair Shop Workspace | Hermes Connect"
  description="Manage your repair shop profile, services, availability, bookings, and service history in Hermes Connect."
  robots="noindex,nofollow"
>
  <SiteHeader activePath="/paths/technology/" />
  <main class="workspace-page">
    <div class="shell">
      <a href="/services/hermes-connect/repair-shops/" class="back-link"><ArrowLeft size={16} /> Repair Shop Beta</a>

      <header class="workspace-header">
        <div><p class="eyebrow">Hermes Connect · Repair Shops</p><h1>Shop Owner Workspace</h1><p id="owner-summary" class="muted">Loading your secure workspace…</p></div>
        <div class="workspace-actions"><a class="secondary-btn" href="/services/hermes-connect/repair-shops/customers/"><Users size={16} /> Customers</a><button id="logout-btn" class="secondary-btn" type="button"><LogOut size={16} /> Logout</button></div>
      </header>

      <div id="workspace-alert" class="alert hidden" role="status"></div>

      <section class="panel" aria-labelledby="profile-title">
        <div class="panel-heading"><div><p class="eyebrow">Production profile</p><h2 id="profile-title">Shop profile</h2><p class="muted">Your saved profile controls the public booking link and timezone.</p></div><span id="profile-state" class="pill">Not configured</span></div>
        <form id="profile-form" class="grid-form">
          <label class="field span-2">Shop name<input id="shop-name" maxlength="120" required placeholder="Apex Auto Care" /></label>
          <label class="field">Phone<input id="shop-phone" maxlength="32" inputmode="tel" placeholder="+1 414 555 0100" /></label>
          <label class="field">Address<input id="shop-address" maxlength="160" placeholder="123 Main St" /></label>
          <label class="field">City<input id="shop-city" maxlength="80" required placeholder="Milwaukee" /></label>
          <label class="field">State<input id="shop-state" maxlength="2" required placeholder="WI" /></label>
          <label class="field">ZIP<input id="shop-zip" maxlength="16" placeholder="53202" /></label>
          <label class="field">Timezone<select id="shop-timezone" required><option value="America/New_York">Eastern</option><option value="America/Chicago" selected>Central</option><option value="America/Denver">Mountain</option><option value="America/Phoenix">Arizona</option><option value="America/Los_Angeles">Pacific</option><option value="America/Anchorage">Alaska</option><option value="Pacific/Honolulu">Hawaii</option></select></label>
          <button id="save-profile-btn" class="primary-btn span-2" type="submit">Save shop profile</button>
        </form>
        <div id="public-link-wrap" class="public-link hidden">
          <div><span class="mini-label">Public booking link</span><strong id="public-link-text"></strong></div>
          <div class="link-actions"><button id="copy-link-btn" class="secondary-btn" type="button"><Copy size={15} /> Copy</button><a id="open-link-btn" class="secondary-btn" href="#" target="_blank" rel="noopener"><ExternalLink size={15} /> Open</a></div>
        </div>
      </section>

      <section class="panel" aria-labelledby="services-title">
        <div class="panel-heading"><div><p class="eyebrow">Real D1 data</p><h2 id="services-title">Services</h2><p class="muted">These are the same services customers see on your public booking page.</p></div><span id="service-count" class="pill">0 services</span></div>
        <form id="service-form" class="service-form">
          <label class="field grow">Service name<input id="service-name" minlength="2" maxlength="120" required placeholder="Brake inspection" /></label>
          <label class="field duration">Duration<select id="service-duration" required><option value="15">15 min</option><option value="30" selected>30 min</option><option value="45">45 min</option><option value="60">60 min</option><option value="90">90 min</option><option value="120">120 min</option><option value="180">180 min</option><option value="240">240 min</option></select></label>
          <button id="add-service-btn" class="primary-btn" type="submit"><Plus size={17} /> Add service</button>
        </form>
        <div id="services-loading" class="state-card">Loading services…</div>
        <div id="services-empty" class="state-card hidden"><strong>No services yet</strong><span>Add the first service your shop accepts.</span></div>
        <div id="services-list" class="list hidden"></div>
      </section>

      <section class="panel availability-panel">
        <div><p class="eyebrow">Scheduling</p><h2>Weekly availability</h2><p class="muted">Set real opening hours before sharing your public booking link.</p></div>
        <a class="primary-btn" href="/services/hermes-connect/repair-shops/availability/"><CalendarClock size={17} /> Manage availability</a>
      </section>

      <section class="panel" aria-labelledby="bookings-title">
        <div class="panel-heading"><div><p class="eyebrow">Customer intake</p><h2 id="bookings-title">Booking inbox</h2><p class="muted">Appointments from your public link appear here with vehicle details and persisted status history.</p></div><span id="booking-count" class="pill">0 bookings</span></div>
        <div id="bookings-loading" class="state-card">Loading bookings…</div>
        <div id="bookings-empty" class="state-card hidden"><strong>No bookings yet</strong><span>Share your public booking link after services and hours are configured.</span></div>
        <div id="bookings-list" class="booking-list hidden"></div>
      </section>

      <section class="panel" aria-labelledby="feedback-title">
        <div class="panel-heading"><div><p class="eyebrow">Private beta</p><h2 id="feedback-title"><MessageSquareText size={22} /> Product feedback</h2><p class="muted">Tell the Hermes team what helps or blocks your shop.</p></div><span id="feedback-count" class="pill">0 notes</span></div>
        <form id="feedback-form" class="grid-form">
          <label class="field">Area<select id="feedback-category" required><option value="setup">Setup</option><option value="booking">Booking</option><option value="customers">Customers</option><option value="mobile">Mobile use</option><option value="other">Other</option></select></label>
          <label class="field">Rating<select id="feedback-rating" required><option value="5">5 — Excellent</option><option value="4">4 — Good</option><option value="3">3 — Okay</option><option value="2">2 — Difficult</option><option value="1">1 — Blocked</option></select></label>
          <label class="field span-2">What happened?<textarea id="feedback-message" minlength="10" maxlength="2000" required placeholder="What worked, what was confusing, or what should change next?"></textarea></label>
          <p class="privacy-note span-2">Private beta record. Your note is available only in your authenticated workspace and to the Hermes product team. It is never sent to GA4 or shown on public shop pages, and is automatically deleted after 180 days.</p>
          <button id="submit-feedback-btn" class="primary-btn span-2" type="submit">Send private feedback</button>
        </form>
        <div id="feedback-loading" class="state-card">Loading feedback…</div>
        <div id="feedback-empty" class="state-card hidden"><strong>No feedback sent yet</strong><span>Your recent private notes will appear here.</span></div>
        <div id="feedback-list" class="list hidden"></div>
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  type Service = { id: string; name: string; duration_minutes: number; owner_specialist_id: string };
  type Shop = { id: string; name: string; slug: string; phone?: string | null; address_line1?: string | null; city: string; state: string; postal_code?: string | null; timezone: string };
  type BookingHistory = { id: string; booking_id: string; from_status: string | null; to_status: string; changed_at: string };
  type BookingVehicle = { year: number | null; make: string; model: string; mileage: number | null; vin: string | null };
  type Booking = { id: string; service_name: string; duration_minutes: number; appointment_date: string; start_time: string; end_time: string; status: string; client_name: string; client_email: string; client_phone: string; vehicle?: BookingVehicle | null; history?: BookingHistory[] };
  type Feedback = { id: string; category: string; rating: number; message: string; created_at: string; retention_until: string };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const alertBox = $("workspace-alert");
  const serviceForm = $<HTMLFormElement>("service-form");
  const profileForm = $<HTMLFormElement>("profile-form");
  const addServiceButton = $<HTMLButtonElement>("add-service-btn");
  const saveProfileButton = $<HTMLButtonElement>("save-profile-btn");
  const feedbackForm = $<HTMLFormElement>("feedback-form");
  const submitFeedbackButton = $<HTMLButtonElement>("submit-feedback-btn");
  let publicBookingUrl = "";

  const statusLabels: Record<string, string> = { confirmed: "Confirmed", in_progress: "In progress", completed: "Completed", cancelled: "Cancelled" };
  const transitions: Record<string, string[]> = { confirmed: ["in_progress", "completed", "cancelled"], in_progress: ["completed", "cancelled"], completed: [], cancelled: [] };

  function showAlert(message: string, kind: "error" | "success" = "error") { if (!alertBox) return; alertBox.textContent = message; alertBox.className = `alert ${kind}`; }
  function clearAlert() { if (alertBox) { alertBox.textContent = ""; alertBox.className = "alert hidden"; } }
  async function readJson(response: Response) { try { return await response.json(); } catch { return { success: false, error: "invalid_server_response" }; } }
  function redirectToAuth() { window.location.replace("/services/hermes-connect/repair-shops/auth/"); }
  function formatTime(value: string) { const [h,m] = value.split(":").map(Number); return `${h % 12 || 12}:${String(m).padStart(2,"0")} ${h >= 12 ? "PM" : "AM"}`; }
  function formatHistoryTime(value: string) { const date = new Date(value); return Number.isNaN(date.getTime()) ? value : date.toLocaleString([], { dateStyle: "medium", timeStyle: "short" }); }

  async function requireOwnerSession() {
    const response = await fetch("/api/auth/me", { credentials: "same-origin" });
    if (response.status === 401) { redirectToAuth(); return false; }
    const data = await readJson(response);
    if (!response.ok || !data.success || !data.specialist) { showAlert(data.error || "Unable to load your secure session."); return false; }
    $("owner-summary")!.textContent = `${data.specialist.name} · ${data.specialist.email}`; return true;
  }

  function fillProfile(shop: Shop | null) {
    const linkWrap = $("public-link-wrap");
    if (!shop) { $("profile-state")!.textContent = "Not configured"; linkWrap?.classList.add("hidden"); return; }
    $("profile-state")!.textContent = "Saved";
    $<HTMLInputElement>("shop-name")!.value = shop.name || ""; $<HTMLInputElement>("shop-phone")!.value = shop.phone || ""; $<HTMLInputElement>("shop-address")!.value = shop.address_line1 || ""; $<HTMLInputElement>("shop-city")!.value = shop.city || ""; $<HTMLInputElement>("shop-state")!.value = shop.state || ""; $<HTMLInputElement>("shop-zip")!.value = shop.postal_code || ""; $<HTMLSelectElement>("shop-timezone")!.value = shop.timezone || "America/Chicago";
    publicBookingUrl = `${window.location.origin}/services/hermes-connect/repair-shops/booking/?shop=${encodeURIComponent(shop.slug)}`;
    $("public-link-text")!.textContent = publicBookingUrl; $<HTMLAnchorElement>("open-link-btn")!.href = publicBookingUrl; linkWrap?.classList.remove("hidden");
  }

  async function loadProfile() { const response = await fetch("/api/repair-shop/profile", { credentials: "same-origin" }); if (response.status === 401) return redirectToAuth(); const data = await readJson(response); if (!response.ok || !data.success) return showAlert(data.error || "Unable to load shop profile."); fillProfile(data.shop || null); }

  profileForm?.addEventListener("submit", async (event) => {
    event.preventDefault(); clearAlert(); if (saveProfileButton) saveProfileButton.disabled = true;
    try {
      const response = await fetch("/api/repair-shop/profile", { method:"PUT", credentials:"same-origin", headers:{"Content-Type":"application/json"}, body:JSON.stringify({ name:$<HTMLInputElement>("shop-name")?.value, phone:$<HTMLInputElement>("shop-phone")?.value, address_line1:$<HTMLInputElement>("shop-address")?.value, city:$<HTMLInputElement>("shop-city")?.value, state:$<HTMLInputElement>("shop-state")?.value, postal_code:$<HTMLInputElement>("shop-zip")?.value, timezone:$<HTMLSelectElement>("shop-timezone")?.value }) });
      const data = await readJson(response); if (!response.ok || !data.success) return showAlert(data.error || "Unable to save shop profile."); fillProfile(data.shop); showAlert("Shop profile saved to production.","success");
    } catch { showAlert("Network error while saving shop profile."); } finally { if (saveProfileButton) saveProfileButton.disabled = false; }
  });

  $("copy-link-btn")?.addEventListener("click", async () => { if (!publicBookingUrl) return; try { await navigator.clipboard.writeText(publicBookingUrl); showAlert("Public booking link copied.","success"); } catch { showAlert("Could not copy the link. Select it manually."); } });

  function renderServices(items: Service[]) {
    $("services-loading")?.classList.add("hidden"); $("service-count")!.textContent = `${items.length} ${items.length === 1 ? "service" : "services"}`;
    const list = $("services-list")!; const empty = $("services-empty")!; list.innerHTML = "";
    if (!items.length) { list.classList.add("hidden"); empty.classList.remove("hidden"); return; }
    empty.classList.add("hidden"); list.classList.remove("hidden");
    for (const service of items) {
      const row = document.createElement("article"); row.className = "row";
      const info = document.createElement("div"); const name = document.createElement("strong"); name.textContent = service.name; const meta = document.createElement("span"); meta.className="muted small"; meta.textContent=`${service.duration_minutes} min`; info.append(name,meta);
      const remove = document.createElement("button"); remove.type="button"; remove.className="danger-btn"; remove.textContent="Delete";
      remove.addEventListener("click", async () => { clearAlert(); remove.disabled=true; try { const response=await fetch(`/api/services/${encodeURIComponent(service.id)}`,{method:"DELETE",credentials:"same-origin"}); const data=await readJson(response); if(!response.ok||!data.success) return showAlert(data.error==="service_has_bookings"?"This service has bookings and cannot be deleted.":data.error||"Unable to delete service."); showAlert(`${service.name} deleted.`,"success"); await loadServices(); } catch { showAlert("Network error while deleting service."); } finally { remove.disabled=false; } });
      row.append(info,remove); list.append(row);
    }
  }

  async function loadServices() { const response=await fetch("/api/services",{credentials:"same-origin"}); if(response.status===401)return redirectToAuth(); const data=await readJson(response); if(!response.ok||!data.success){$("services-loading")?.classList.add("hidden");return showAlert(data.error||"Unable to load services.");} renderServices(Array.isArray(data.services)?data.services:[]); }

  serviceForm?.addEventListener("submit", async (event) => { event.preventDefault(); clearAlert(); if(addServiceButton)addServiceButton.disabled=true; try { const response=await fetch("/api/services",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({name:$<HTMLInputElement>("service-name")?.value,duration_minutes:Number($<HTMLSelectElement>("service-duration")?.value)})}); const data=await readJson(response); if(!response.ok||!data.success)return showAlert(data.error==="service_already_exists"?"A service with this name already exists.":data.error||"Unable to add service."); serviceForm.reset(); $<HTMLSelectElement>("service-duration")!.value="30"; showAlert(`${data.service.name} added.`,"success"); await loadServices(); } catch { showAlert("Network error while adding service."); } finally { if(addServiceButton)addServiceButton.disabled=false; } });

  function createStatusControl(booking: Booking) {
    const wrap = document.createElement("div"); wrap.className = "status-control";
    const label = document.createElement("span"); label.className = `status-pill status-${booking.status}`; label.textContent = statusLabels[booking.status] || booking.status; wrap.append(label);
    const allowed = transitions[booking.status] || [];
    if (!allowed.length) return wrap;
    const select = document.createElement("select"); select.className = "status-select"; select.setAttribute("aria-label", `Change status for ${booking.service_name}`);
    const placeholder = document.createElement("option"); placeholder.value=""; placeholder.textContent="Change status…"; select.append(placeholder);
    for (const next of allowed) { const option=document.createElement("option"); option.value=next; option.textContent=statusLabels[next] || next; select.append(option); }
    select.addEventListener("change", async () => {
      const nextStatus = select.value; if (!nextStatus) return;
      clearAlert(); select.disabled = true;
      try {
        const response = await fetch(`/api/repair-shop/bookings/${encodeURIComponent(booking.id)}/status`, { method:"PATCH", credentials:"same-origin", headers:{"Content-Type":"application/json"}, body:JSON.stringify({status:nextStatus}) });
        const data = await readJson(response);
        if (!response.ok || !data.success) { select.value = ""; return showAlert(data.error === "invalid_status_transition" ? "That booking status transition is no longer allowed. Refreshing current state." : data.error || "Unable to change booking status."); }
        showAlert(`Booking moved to ${statusLabels[nextStatus] || nextStatus}.`, "success"); await loadBookings();
      } catch { select.value=""; showAlert("Network error while changing booking status."); }
      finally { select.disabled = false; }
    });
    wrap.append(select); return wrap;
  }

  function renderHistory(history: BookingHistory[] = []) {
    const section = document.createElement("div"); section.className="history";
    const title = document.createElement("span"); title.className="mini-label"; title.textContent="Status history"; section.append(title);
    if (!history.length) { const none=document.createElement("span"); none.className="muted small"; none.textContent="No history recorded yet."; section.append(none); return section; }
    const list=document.createElement("ol");
    for (const item of history) { const li=document.createElement("li"); const strong=document.createElement("strong"); strong.textContent=statusLabels[item.to_status] || item.to_status; const time=document.createElement("span"); time.textContent=formatHistoryTime(item.changed_at); li.append(strong,time); list.append(li); }
    section.append(list); return section;
  }

  function renderBookings(items: Booking[]) {
    $("bookings-loading")?.classList.add("hidden"); $("booking-count")!.textContent = `${items.length} ${items.length === 1 ? "booking" : "bookings"}`;
    const list=$("bookings-list")!; const empty=$("bookings-empty")!; list.innerHTML="";
    if(!items.length){list.classList.add("hidden");empty.classList.remove("hidden");return;} empty.classList.add("hidden");list.classList.remove("hidden");
    for(const booking of items){
      const card=document.createElement("article"); card.className="booking-card"; card.dataset.bookingId=booking.id;
      const top=document.createElement("div"); top.className="booking-top"; const title=document.createElement("strong"); title.textContent=booking.service_name; top.append(title,createStatusControl(booking));
      const when=document.createElement("p"); when.className="booking-when"; when.textContent=`${booking.appointment_date} · ${formatTime(booking.start_time)}–${formatTime(booking.end_time)} · ${booking.duration_minutes} min`;
      const customer=document.createElement("p"); customer.className="muted small"; customer.textContent=`${booking.client_name} · ${booking.client_email} · ${booking.client_phone}`;
      const vehicle=document.createElement("p"); vehicle.className="vehicle-line";
      if(booking.vehicle){vehicle.textContent=`${booking.vehicle.year ?? ""} ${booking.vehicle.make} ${booking.vehicle.model}${booking.vehicle.mileage == null ? "" : ` · ${Number(booking.vehicle.mileage).toLocaleString()} mi`}${booking.vehicle.vin ? ` · VIN ${booking.vehicle.vin}` : ""}`.trim();} else {vehicle.textContent="Vehicle details were not captured for this booking."; vehicle.classList.add("muted","small");}
      const id=document.createElement("code"); id.textContent=booking.id;
      card.append(top,when,customer,vehicle,renderHistory(Array.isArray(booking.history)?booking.history:[]),id); list.append(card);
    }
  }

  async function loadBookings(){const response=await fetch("/api/repair-shop/bookings",{credentials:"same-origin"});if(response.status===401)return redirectToAuth();const data=await readJson(response);if(!response.ok||!data.success){$("bookings-loading")?.classList.add("hidden");return showAlert(data.error||"Unable to load booking inbox.");}renderBookings(Array.isArray(data.bookings)?data.bookings:[]);}

  function renderFeedback(items: Feedback[]) {
    $("feedback-loading")?.classList.add("hidden"); $("feedback-count")!.textContent = `${items.length} ${items.length === 1 ? "note" : "notes"}`;
    const list=$("feedback-list")!; const empty=$("feedback-empty")!; list.innerHTML="";
    if(!items.length){list.classList.add("hidden");empty.classList.remove("hidden");return;} empty.classList.add("hidden");list.classList.remove("hidden");
    for(const item of items){const row=document.createElement("article");row.className="feedback-row";const top=document.createElement("div");const category=document.createElement("strong");category.textContent=item.category.charAt(0).toUpperCase()+item.category.slice(1);const rating=document.createElement("span");rating.className="pill";rating.textContent=`${item.rating}/5`;top.append(category,rating);const message=document.createElement("p");message.textContent=item.message;const time=document.createElement("span");time.className="muted small";time.textContent=formatHistoryTime(item.created_at);row.append(top,message,time);list.append(row);}
  }

  async function loadFeedback(){const response=await fetch("/api/repair-shop/feedback",{credentials:"same-origin"});if(response.status===401)return redirectToAuth();const data=await readJson(response);if(!response.ok||!data.success){$("feedback-loading")?.classList.add("hidden");return showAlert(data.error||"Unable to load private feedback.");}renderFeedback(Array.isArray(data.feedback)?data.feedback:[]);}

  feedbackForm?.addEventListener("submit",async(event)=>{event.preventDefault();clearAlert();if(submitFeedbackButton)submitFeedbackButton.disabled=true;try{const response=await fetch("/api/repair-shop/feedback",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({category:$<HTMLSelectElement>("feedback-category")?.value,rating:Number($<HTMLSelectElement>("feedback-rating")?.value),message:$<HTMLTextAreaElement>("feedback-message")?.value})});const data=await readJson(response);if(!response.ok||!data.success)return showAlert(data.error||"Unable to save private feedback.");feedbackForm.reset();$<HTMLSelectElement>("feedback-rating")!.value="5";showAlert("Private feedback saved. Thank you.","success");await loadFeedback();}catch{showAlert("Network error while saving private feedback.");}finally{if(submitFeedbackButton)submitFeedbackButton.disabled=false;}});

  $("logout-btn")?.addEventListener("click",async()=>{const response=await fetch("/api/auth/logout",{method:"POST",credentials:"same-origin"});if(response.ok)redirectToAuth();else showAlert("Logout failed.");});
  async function initialize(){try{if(!(await requireOwnerSession()))return;await Promise.all([loadProfile(),loadServices(),loadBookings(),loadFeedback()]);}catch{showAlert("Unable to initialize the shop workspace.");}}
  initialize();
</script>

<style>
.workspace-page{min-height:100vh;padding:116px 24px 80px;color:#f6f7fb;background:radial-gradient(circle at 15% 10%,rgba(124,92,255,.17),transparent 32%),radial-gradient(circle at 85% 20%,rgba(90,200,250,.11),transparent 30%),#090a0f}.shell{width:min(980px,100%);margin:auto}.back-link{display:inline-flex;align-items:center;gap:8px;color:#a4a9b6;text-decoration:none;font-weight:700;margin-bottom:26px}.workspace-header,.panel-heading,.availability-panel{display:flex;justify-content:space-between;gap:24px;align-items:flex-start}.workspace-header{margin-bottom:28px}.workspace-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.eyebrow,.mini-label{margin:0 0 8px;text-transform:uppercase;letter-spacing:.12em;font-size:12px;font-weight:800;color:#9d88ff}h1{margin:0 0 8px;font-size:clamp(32px,5vw,50px);line-height:1.05}h2{margin:0 0 8px;font-size:25px}.muted{margin:0;color:#a5aab7;line-height:1.55}.small{font-size:12px}.panel{border:1px solid rgba(255,255,255,.1);background:rgba(17,18,26,.88);box-shadow:0 20px 70px rgba(0,0,0,.24);border-radius:20px;padding:24px;margin-top:18px}.pill,.status-pill{padding:7px 10px;border-radius:999px;background:rgba(124,92,255,.13);border:1px solid rgba(157,136,255,.24);color:#d6cfff;font-size:12px;font-weight:800}.status-completed{background:rgba(32,156,101,.12);border-color:rgba(96,230,166,.22);color:#baf2d4}.status-cancelled{background:rgba(171,53,53,.12);border-color:rgba(255,108,108,.22);color:#ffc1c1}.status-in_progress{background:rgba(55,139,208,.12);border-color:rgba(100,185,255,.22);color:#c0e4ff}.grid-form{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:20px}.field{display:flex;flex-direction:column;gap:7px;color:#dfe2ea;font-size:13px;font-weight:700}.field input,.field select,.status-select{box-sizing:border-box;width:100%;border:1px solid rgba(255,255,255,.1);background:#0f1119;color:#fff;border-radius:11px;padding:12px 13px;outline:none}.field input:focus,.field select:focus,.status-select:focus{borde