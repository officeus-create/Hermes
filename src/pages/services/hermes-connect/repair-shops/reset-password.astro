---
import { ArrowLeft, KeyRound, LockKeyhole } from "@lucide/astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
---

<BaseLayout title="Choose a new password | Hermes Connect" description="Set a new password for your Repair Shop owner account." robots="noindex,nofollow">
  <SiteHeader activePath="/paths/technology/" />
  <main id="main-content" class="recovery-page">
    <section class="recovery-card" aria-labelledby="reset-title">
      <a id="reset-back" class="back-link" href="/services/hermes-connect/repair-shops/auth/"><ArrowLeft size={16} /><span>Back to login</span></a>
      <div class="icon-wrap"><KeyRound size={30} /></div>
      <h1 id="reset-title">Choose a new password</h1>
      <p id="reset-subtitle">Set a new password for your Repair Shop owner account.</p>
      <div id="reset-message" class="message" hidden></div>
      <form id="reset-form">
        <label id="reset-password-label" for="reset-password">New password</label>
        <div class="input-wrap"><LockKeyhole size={17} aria-hidden="true" /><input id="reset-password" type="password" autocomplete="new-password" minlength="8" required /></div>
        <label id="reset-confirm-label" for="reset-confirm">Confirm password</label>
        <div class="input-wrap"><LockKeyhole size={17} aria-hidden="true" /><input id="reset-confirm" type="password" autocomplete="new-password" minlength="8" required /></div>
        <button id="reset-submit" type="submit">Update password</button>
      </form>
      <a id="request-new" class="request-new" href="/services/hermes-connect/repair-shops/forgot-password/" hidden>This reset link is invalid, expired, or already used. Request a new one.</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script is:inline>
  (() => {
    const copies = {
      en: { title:"Choose a new password", subtitle:"Set a new password for your Repair Shop owner account.", password:"New password", confirm:"Confirm password", submit:"Update password", back:"Back to login", success:"Password updated. Sign in with your new password.", mismatch:"Passwords do not match.", invalid:"This reset link is invalid, expired, or already used. Request a new one.", short:"Use at least 8 characters." },
      ru: { title:"Новый пароль", subtitle:"Установите новый пароль для аккаунта владельца СТО.", password:"Новый пароль", confirm:"Повторите пароль", submit:"Обновить пароль", back:"Вернуться ко входу", success:"Пароль обновлён. Войдите с новым паролем.", mismatch:"Пароли не совпадают.", invalid:"Ссылка недействительна, истекла или уже использована. Запросите новую.", short:"Используйте минимум 8 символов." },
      uk: { title:"Новий пароль", subtitle:"Встановіть новий пароль для акаунта власника СТО.", password:"Новий пароль", confirm:"Повторіть пароль", submit:"Оновити пароль", back:"Повернутися до входу", success:"Пароль оновлено. Увійдіть із новим паролем.", mismatch:"Паролі не збігаються.", invalid:"Посилання недійсне, прострочене або вже використане. Запросіть нове.", short:"Використовуйте щонайменше 8 символів." },
      es: { title:"Elige una nueva contraseña", subtitle:"Configura una nueva contraseña para la cuenta del propietario del taller.", password:"Nueva contraseña", confirm:"Confirmar contraseña", submit:"Actualizar contraseña", back:"Volver al inicio de sesión", success:"Contraseña actualizada. Inicia sesión con la nueva contraseña.", mismatch:"Las contraseñas no coinciden.", invalid:"El enlace no es válido, ha caducado o ya se utilizó. Solicita uno nuevo.", short:"Usa al menos 8 caracteres." },
      it: { title:"Scegli una nuova password", subtitle:"Imposta una nuova password per l’account del proprietario dell’officina.", password:"Nuova password", confirm:"Conferma password", submit:"Aggiorna password", back:"Torna all’accesso", success:"Password aggiornata. Accedi con la nuova password.", mismatch:"Le password non coincidono.", invalid:"Il link non è valido, è scaduto o è già stato usato. Richiedine uno nuovo.", short:"Usa almeno 8 caratteri." },
      fr: { title:"Choisir un nouveau mot de passe", subtitle:"Définissez un nouveau mot de passe pour le compte propriétaire de l’atelier.", password:"Nouveau mot de passe", confirm:"Confirmer le mot de passe", submit:"Mettre à jour", back:"Retour à la connexion", success:"Mot de passe mis à jour. Connectez-vous avec votre nouveau mot de passe.", mismatch:"Les mots de passe ne correspondent pas.", invalid:"Ce lien est invalide, expiré ou déjà utilisé. Demandez-en un nouveau.", short:"Utilisez au moins 8 caractères." },
    };
    const params = new URLSearchParams(window.location.search);
    const requested = (params.get("lang") || "en").toLowerCase();
    const lang = Object.prototype.hasOwnProperty.call(copies, requested) ? requested : "en";
    const copy = copies[lang];
    const token = (params.get("token") || "").trim().toLowerCase();
    const loginHref = `/services/hermes-connect/repair-shops/auth/${lang === "en" ? "" : `?lang=${encodeURIComponent(lang)}`}`;
    const forgotHref = `/services/hermes-connect/repair-shops/forgot-password/${lang === "en" ? "" : `?lang=${encodeURIComponent(lang)}`}`;
    document.documentElement.lang = lang;
    document.title = `${copy.title} | Hermes Connect`;

    const title = document.getElementById("reset-title");
    const subtitle = document.getElementById("reset-subtitle");
    const passwordLabel = document.getElementById("reset-password-label");
    const confirmLabel = document.getElementById("reset-confirm-label");
    const submit = document.getElementById("reset-submit");
    const back = document.getElementById("reset-back");
    const requestNew = document.getElementById("request-new");
    if (title) title.textContent = copy.title;
    if (subtitle) subtitle.textContent = copy.subtitle;
    if (passwordLabel) passwordLabel.textContent = copy.password;
    if (confirmLabel) confirmLabel.textContent = copy.confirm;
    if (submit) submit.textContent = copy.submit;
    if (back) {
      const label = back.querySelector("span");
      if (label) label.textContent = copy.back;
      back.href = loginHref;
    }
    if (requestNew) {
      requestNew.textContent = copy.invalid;
      requestNew.href = forgotHref;
    }

    const form = document.getElementById("reset-form");
    const message = document.getElementById("reset-message");
    const show = (text, type = "error") => {
      if (!message) return;
      message.textContent = text;
      message.className = `message ${type}`;
      message.hidden = false;
    };
    const invalidate = () => {
      show(copy.invalid);
      if (form) form.hidden = true;
      if (requestNew) requestNew.hidden = false;
    };
    if (!/^[a-f0-9]{64}$/.test(token)) invalidate();

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const passwordInput = document.getElementById("reset-password");
      const confirmInput = document.getElementById("reset-confirm");
      const password = passwordInput instanceof HTMLInputElement ? passwordInput.value : "";
      const confirm = confirmInput instanceof HTMLInputElement ? confirmInput.value : "";
      if (password.length < 8) return show(copy.short);
      if (password !== confirm) return show(copy.mismatch);
      const button = form.querySelector("button");
      if (button instanceof HTMLButtonElement) button.disabled = true;
      try {
        const response = await fetch("/api/auth/reset-password", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token, password }),
        });
        const data = await response.json();
        if (!response.ok || !data.success) return invalidate();
        show(copy.success, "success");
        form.hidden = true;
        window.history.replaceState({}, "", window.location.pathname + (lang !== "en" ? `?lang=${encodeURIComponent(lang)}` : ""));
        window.setTimeout(() => { window.location.href = loginHref; }, 1200);
      } catch {
        show(copy.invalid);
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  })();
</script>

<style>
  .recovery-page{min-height:80vh;padding:120px 20px 72px;background:#090a0f;color:#f5f7fb;display:flex;justify-content:center;align-items:flex-start}
  .recovery-card{box-sizing:border-box;width:min(100%,480px);padding:34px 30px;border:1px solid rgba(255,255,255,.08);border-radius:22px;background:rgba(23,26,35,.68);box-shadow:0 24px 60px rgba(0,0,0,.32)}
  .back-link{display:inline-flex;align-items:center;gap:7px;margin-bottom:28px;color:#aab3c3;text-decoration:none;font-size:14px;font-weight:700}.icon-wrap{display:grid;place-items:center;width:52px;height:52px;margin-bottom:18px;border-radius:16px;background:rgba(124,92,255,.14);color:#a694ff}
  h1{margin:0 0 10px;font-size:28px;line-height:1.1}p{margin:0 0 26px;color:#a5afbf;line-height:1.55}form{display:grid;gap:12px}label{font-size:13px;font-weight:750;color:#dbe1ea}.input-wrap{display:flex;align-items:center;gap:9px;padding:0 13px;border:1px solid rgba(255,255,255,.12);border-radius:11px;background:rgba(0,0,0,.2)}
  input{min-width:0;width:100%;padding:14px 0;border:0;outline:0;background:transparent;color:#fff;font:inherit}button{min-height:48px;margin-top:8px;border:0;border-radius:12px;background:linear-gradient(135deg,#7c5cff,#5ac8fa);color:#06101c;font-weight:850;cursor:pointer}button:disabled{opacity:.55;cursor:wait}.message{margin:0 0 20px;padding:13px 14px;border-radius:10px;font-size:14px;line-height:1.45}.message.success{border:1px solid rgba(52,211,153,.25);background:rgba(52,211,153,.08);color:#baf3dc}.message.error{border:1px solid rgba(248,113,113,.25);background:rgba(248,113,113,.08);color:#fecaca}.request-new{display:block;margin-top:16px;color:#a694ff;font-size:14px;font-weight:750;line-height:1.45;text-decoration:none}
  @media(max-width:520px){.recovery-page{padding:92px 14px 56px}.recovery-card{padding:26px 20px;border-radius:18px}h1{font-size:25px}}
</style>
