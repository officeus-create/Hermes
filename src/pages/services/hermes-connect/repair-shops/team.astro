---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import HermesConnectAccountSwitcher from "../../../../components/HermesConnectAccountSwitcher.astro";
---

<BaseLayout title="Team | Hermes Connect Repair Shop" description="Owner-only repair shop team management." robots="noindex,nofollow">
  <div class="site-header company-account-source" aria-hidden="true"><HermesConnectAccountSwitcher current="repair" mode="menu" /></div>
  <main id="main-content" class="team-page">
    <div class="hc4-page-shell">
      <header class="hc4-page-head">
        <div><p class="hc4-kicker" data-i18n="kicker">People</p><h1 data-i18n="title">Team</h1><p data-i18n="subtitle">Manage real employees, roles and specialties without mixing schedules or company settings into the same screen.</p></div>
        <span id="staff-count" class="hc4-count">0</span>
      </header>
      <div id="page-alert" class="hc4-alert hc4-hidden" role="status" aria-live="polite"></div>

      <section class="hc4-card">
        <div class="hc4-card-head"><div><p class="hc4-eyebrow" data-i18n="directory">Directory</p><h2 data-i18n="employees">Employees</h2><p data-i18n="employeesCopy">Only saved staff from the Repair Shop account appear here.</p></div><button id="new-staff" class="hc4-button primary" type="button" data-i18n="add">Add employee</button></div>
        <form id="staff-form" class="hc4-form-grid hc4-hidden">
          <input id="staff-id" type="hidden" />
          <label class="hc4-field"><span data-i18n="name">Employee name</span><input id="staff-name" maxlength="100" required autocomplete="off" /></label>
          <label class="hc4-field"><span data-i18n="role">Role</span><input id="staff-role" maxlength="80" placeholder="Technician" /></label>
          <label class="hc4-field span-2"><span data-i18n="specialties">Specialties</span><input id="staff-specialties" maxlength="500" placeholder="Brakes, Diagnostics, Electrical" /></label>
          <label class="hc4-active span-2"><input id="staff-active" type="checkbox" checked /><span data-i18n="active">Active employee</span></label>
          <div class="hc4-actions span-2"><button class="hc4-button primary" type="submit" data-i18n="save">Save employee</button><button id="cancel-staff" class="hc4-button" type="button" data-i18n="cancel">Cancel</button></div>
        </form>
        <div id="staff-loading" class="hc4-empty" data-i18n="loading">Loading team…</div>
        <div id="staff-empty" class="hc4-empty hc4-hidden" data-i18n="empty">No employees yet. Add the first technician or team member.</div>
        <div id="staff-list" class="hc4-team-list hc4-hidden" aria-live="polite"></div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  type Staff={id:string;name:string;role:string;specialties:string[];active:boolean};
  const supported=new Set(["en","ru","uk","es","it","fr"]);const requested=(new URLSearchParams(location.search).get("lang")||"en").toLowerCase();const locale=supported.has(requested)?requested:"en";
  const strings:Record<string,Record<string,string>>={
    en:{kicker:"People",title:"Team",subtitle:"Manage real employees, roles and specialties without mixing schedules or company settings into the same screen.",directory:"Directory",employees:"Employees",employeesCopy:"Only saved staff from the Repair Shop account appear here.",add:"Add employee",name:"Employee name",role:"Role",specialties:"Specialties",active:"Active employee",save:"Save employee",cancel:"Cancel",loading:"Loading team…",empty:"No employees yet. Add the first technician or team member.",activeStatus:"Active",inactiveStatus:"Inactive",edit:"Edit",remove:"Remove",confirm:"Remove this employee?",loadFailed:"Unable to load team.",saveFailed:"Unable to save employee.",saved:"Employee saved.",removed:"Employee removed."},
    ru:{kicker:"Сотрудники",title:"Команда",subtitle:"Управляйте реальными сотрудниками, ролями и специализациями отдельно от графиков и настроек компании.",directory:"Состав",employees:"Сотрудники",employeesCopy:"Здесь отображаются только сохранённые сотрудники этого СТО.",add:"Добавить сотрудника",name:"Имя сотрудника",role:"Роль",specialties:"Специализации",active:"Активный сотрудник",save:"Сохранить сотрудника",cancel:"Отмена",loading:"Загружаем команду…",empty:"Сотрудников пока нет. Добавьте первого мастера или члена команды.",activeStatus:"Активен",inactiveStatus:"Неактивен",edit:"Изменить",remove:"Удалить",confirm:"Удалить сотрудника?",loadFailed:"Не удалось загрузить команду.",saveFailed:"Не удалось сохранить сотрудника.",saved:"Сотрудник сохранён.",removed:"Сотрудник удалён."},
    uk:{kicker:"Співробітники",title:"Команда",subtitle:"Керуйте реальними співробітниками, ролями та спеціалізаціями окремо від графіків і налаштувань.",directory:"Склад",employees:"Співробітники",employeesCopy:"Тут відображаються лише збережені співробітники цього СТО.",add:"Додати співробітника",name:"Ім’я",role:"Роль",specialties:"Спеціалізації",active:"Активний співробітник",save:"Зберегти",cancel:"Скасувати",loading:"Завантаження команди…",empty:"Співробітників ще немає.",activeStatus:"Активний",inactiveStatus:"Неактивний",edit:"Змінити",remove:"Видалити",confirm:"Видалити співробітника?",loadFailed:"Не вдалося завантажити команду.",saveFailed:"Не вдалося зберегти.",saved:"Співробітника збережено.",removed:"Співробітника видалено."},
    es:{kicker:"Personas",title:"Equipo",subtitle:"Gestiona empleados, roles y especialidades reales en una pantalla dedicada.",directory:"Directorio",employees:"Empleados",employeesCopy:"Solo aparecen empleados guardados de este taller.",add:"Añadir empleado",name:"Nombre",role:"Rol",specialties:"Especialidades",active:"Empleado activo",save:"Guardar",cancel:"Cancelar",loading:"Cargando equipo…",empty:"Aún no hay empleados.",activeStatus:"Activo",inactiveStatus:"Inactivo",edit:"Editar",remove:"Eliminar",confirm:"¿Eliminar este empleado?",loadFailed:"No se pudo cargar el equipo.",saveFailed:"No se pudo guardar.",saved:"Empleado guardado.",removed:"Empleado eliminado."},
    it:{kicker:"Persone",title:"Team",subtitle:"Gestisci dipendenti, ruoli e specialità reali in una schermata dedicata.",directory:"Elenco",employees:"Dipendenti",employeesCopy:"Mostra solo il personale salvato dell’officina.",add:"Aggiungi dipendente",name:"Nome",role:"Ruolo",specialties:"Specialità",active:"Dipendente attivo",save:"Salva",cancel:"Annulla",loading:"Caricamento team…",empty:"Nessun dipendente.",activeStatus:"Attivo",inactiveStatus:"Inattivo",edit:"Modifica",remove:"Rimuovi",confirm:"Rimuovere questo dipendente?",loadFailed:"Impossibile caricare il team.",saveFailed:"Impossibile salvare.",saved:"Dipendente salvato.",removed:"Dipendente rimosso."},
    fr:{kicker:"Équipe",title:"Équipe",subtitle:"Gérez les employés, rôles et spécialités réels dans un écran dédié.",directory:"Annuaire",employees:"Employés",employeesCopy:"Seuls les employés enregistrés de cet atelier apparaissent ici.",add:"Ajouter",name:"Nom",role:"Rôle",specialties:"Spécialités",active:"Employé actif",save:"Enregistrer",cancel:"Annuler",loading:"Chargement de l’équipe…",empty:"Aucun employé pour le moment.",activeStatus:"Actif",inactiveStatus:"Inactif",edit:"Modifier",remove:"Supprimer",confirm:"Supprimer cet employé ?",loadFailed:"Impossible de charger l’équipe.",saveFailed:"Impossible d’enregistrer.",saved:"Employé enregistré.",removed:"Employé supprimé."}
  };const t=strings[locale]||strings.en;document.documentElement.lang=locale;document.querySelectorAll<HTMLElement>("[data-i18n]").forEach(n=>{const k=n.dataset.i18n||"";if(t[k])n.textContent=t[k]});
  const $=<T extends HTMLElement=HTMLElement>(id:string)=>document.getElementById(id) as T|null;let staff:Staff[]=[];const form=$<HTMLFormElement>("staff-form");const alertBox=$("page-alert");
  const redirectAuth=()=>{const u=new URL("/services/hermes-connect/repair-shops/auth/",location.origin);if(locale!=="en")u.searchParams.set("lang",locale);location.assign(`${u.pathname}${u.search}`)};const read=async(r:Response)=>{try{return await r.json()}catch{return {success:false}}};const alert=(m:string,tone="")=>{if(!alertBox)return;alertBox.textContent=m;alertBox.className=`hc4-alert ${tone}`.trim()};
  const hideForm=()=>{form?.classList.add("hc4-hidden");form?.reset();if($("staff-id"))($<HTMLInputElement>("staff-id")!).value=""};const showForm=(member?:Staff)=>{form?.classList.remove("hc4-hidden");($<HTMLInputElement>("staff-id")!).value=member?.id||"";($<HTMLInputElement>("staff-name")!).value=member?.name||"";($<HTMLInputElement>("staff-role")!).value=member?.role||"Technician";($<HTMLInputElement>("staff-specialties")!).value=(member?.specialties||[]).join(", ");($<HTMLInputElement>("staff-active")!).checked=member?.active??true;$<HTMLInputElement>("staff-name")?.focus()};
  const render=()=>{const list=$("staff-list")!,empty=$("staff-empty")!,loading=$("staff-loading")!;loading.classList.add("hc4-hidden");$("staff-count")!.textContent=String(staff.length);list.replaceChildren();if(!staff.length){empty.classList.remove("hc4-hidden");list.classList.add("hc4-hidden");return}empty.classList.add("hc4-hidden");list.classList.remove("hc4-hidden");for(const member of staff){const card=document.createElement("article");card.className="hc4-team-card";const info=document.createElement("div");info.className="hc4-team-info";const title=document.createElement("strong");title.textContent=member.name;const role=document.createElement("span");role.textContent=member.role||"Technician";const specs=document.createElement("small");specs.textContent=(member.specialties||[]).join(" · ")||"—";info.append(title,role,specs);const actions=document.createElement("div");actions.className="hc4-team-actions";const status=document.createElement("span");status.className=`hc4-status ${member.active?"is-active":""}`;status.textContent=member.active?t.activeStatus:t.inactiveStatus;const edit=document.createElement("button");edit.type="button";edit.className="hc4-button";edit.textContent=t.edit;edit.addEventListener("click",()=>showForm(member));const remove=document.createElement("button");remove.type="button";remove.className="hc4-button danger";remove.textContent=t.remove;remove.addEventListener("click",()=>removeMember(member,remove));actions.append(status,edit,remove);card.append(info,actions);list.append(card)}};
  async function load(){const r=await fetch("/api/repair-shop/staff",{credentials:"same-origin"});if(r.status===401)return redirectAuth();const d=await read(r);if(!r.ok||!d.success)return alert(t.loadFailed,"error");staff=Array.isArray(d.staff)?d.staff:[];render()}
  async function removeMember(member:Staff,button:HTMLButtonElement){if(!confirm(t.confirm))return;button.disabled=true;try{const r=await fetch("/api/repair-shop/staff",{method:"DELETE",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:member.id})});if(r.status===401)return redirectAuth();const d=await read(r);if(!r.ok||!d.success)return alert(t.saveFailed,"error");staff=Array.isArray(d.staff)?d.staff:staff.filter(x=>x.id!==member.id);render();alert(t.removed,"success")}catch{alert(t.saveFailed,"error")}finally{button.disabled=false}}
  $("new-staff")?.addEventListener("click",()=>showForm());$("cancel-staff")?.addEventListener("click",hideForm);
  form?.addEventListener("submit",async(event)=>{event.preventDefault();const id=$<HTMLInputElement>("staff-id")?.value||"";const payload={id:id||undefined,name:$<HTMLInputElement>("staff-name")?.value.trim(),role:$<HTMLInputElement>("staff-role")?.value.trim()||"Technician",specialties:($<HTMLInputElement>("staff-specialties")?.value||"").split(",").map(v=>v.trim()).filter(Boolean),active:Boolean($<HTMLInputElement>("staff-active")?.checked)};const save=form.querySelector<HTMLButtonElement>('button[type="submit"]');if(save)save.disabled=true;try{const r=await fetch("/api/repair-shop/staff",{method:id?"PUT":"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});if(r.status===401)return redirectAuth();const d=await read(r);if(!r.ok||!d.success)return alert(t.saveFailed,"error");staff=Array.isArray(d.staff)?d.staff:staff;hideForm();render();alert(t.saved,"success")}catch{alert(t.saveFailed,"error")}finally{if(save)save.disabled=false}});
  load();
</script>

<style is:global>
  .hc4-active{display:flex;align-items:center;gap:9px;color:#536176;font-size:11px;font-weight:760}.hc4-active input{width:18px;height:18px;accent-color:#1769d2}.hc4-team-list{display:grid;gap:9px}.hc4-team-card{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 14px;border:1px solid #e4e9f0;border-radius:13px;background:#fbfcfe}.hc4-team-info{display:grid;gap:3px;min-width:0}.hc4-team-info strong{overflow:hidden;color:#233147;font-size:13px;text-overflow:ellipsis;white-space:nowrap}.hc4-team-info span{color:#66758a;font-size:11px}.hc4-team-info small{overflow:hidden;color:#8a96a5;font-size:10px;text-overflow:ellipsis;white-space:nowrap}.hc4-team-actions{display:flex;align-items:center;justify-content:flex-end;gap:7px;flex-wrap:wrap}.hc4-status.is-active{border-color:#d4eadb;background:#f1faf4;color:#246a43}@media(max-width:780px){.hc4-card-head{display:grid}.hc4-card-head #new-staff{width:100%}.hc4-team-card{align-items:stretch;flex-direction:column}.hc4-team-actions{display:grid;grid-template-columns:1fr 1fr}.hc4-team-actions .hc4-status{grid-column:1/-1;justify-self:start}}
</style>
