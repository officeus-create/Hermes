---
import { ArrowLeft, Mail, KeyRound } from "@lucide/astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";

const supported = ["en", "ru", "uk", "es", "it", "fr"] as const;
const requested = Astro.url.searchParams.get("lang") || "en";
const lang = (supported as readonly string[]).includes(requested) ? requested as typeof supported[number] : "en";
const copy = {
  en: { title:"Reset your password", subtitle:"Enter the email used for your Repair Shop owner account.", email:"Business email", submit:"Send reset link", back:"Back to login", sent:"If an eligible Repair Shop owner account exists for that email, a reset link will be sent shortly.", error:"We could not submit the request. Please try again." },
  ru: { title:"Сброс пароля", subtitle:"Введите email, который используется для аккаунта владельца СТО.", email:"Рабочий email", submit:"Отправить ссылку", back:"Вернуться ко входу", sent:"Если для этого email существует подходящий аккаунт владельца СТО, ссылка для сброса будет отправлена в ближайшее время.", error:"Не удалось отправить запрос. Попробуйте ещё раз." },
  uk: { title:"Скидання пароля", subtitle:"Введіть email, який використовується для акаунта власника СТО.", email:"Робочий email", submit:"Надіслати посилання", back:"Повернутися до входу", sent:"Якщо для цього email існує відповідний акаунт власника СТО, посилання для скидання буде надіслано найближчим часом.", error:"Не вдалося надіслати запит. Спробуйте ще раз." },
  es: { title:"Restablecer contraseña", subtitle:"Introduce el correo usado para la cuenta del propietario del taller.", email:"Correo del negocio", submit:"Enviar enlace", back:"Volver al inicio de sesión", sent:"Si existe una cuenta de propietario de taller válida para ese correo, enviaremos un enlace de restablecimiento en breve.", error:"No pudimos enviar la solicitud. Inténtalo de nuevo." },
  it: { title:"Reimposta password", subtitle:"Inserisci l’email usata per l’account del proprietario dell’officina.", email:"Email aziendale", submit:"Invia link", back:"Torna all’accesso", sent:"Se esiste un account proprietario officina idoneo per questa email, il link di reimpostazione verrà inviato a breve.", error:"Impossibile inviare la richiesta. Riprova." },
  fr: { title:"Réinitialiser le mot de passe", subtitle:"Saisissez l’e-mail utilisé pour le compte propriétaire de l’atelier.", email:"E-mail professionnel", submit:"Envoyer le lien", back:"Retour à la connexion", sent:"Si un compte propriétaire d’atelier admissible existe pour cet e-mail, un lien de réinitialisation sera envoyé sous peu.", error:"Impossible d’envoyer la demande. Réessayez." },
}[lang];
const loginHref = `/services/hermes-connect/repair-shops/auth/${lang === "en" ? "" : `?lang=${lang}`}`;
---

<BaseLayout title={`${copy.title} | Hermes Connect`} description={copy.subtitle} robots="noindex,nofollow" locale={lang as any}>
  <SiteHeader activePath="/paths/technology/" />
  <main id="main-content" class="recovery-page">
    <section class="recovery-card" aria-labelledby="recovery-title">
      <a class="back-link" href={loginHref}><ArrowLeft size={16} />{copy.back}</a>
      <div class="icon-wrap"><KeyRound size={30} /></div>
      <h1 id="recovery-title">{copy.title}</h1>
      <p>{copy.subtitle}</p>
      <div id="recovery-message" class="message" hidden></div>
      <form id="forgot-form">
        <label for="forgot-email">{copy.email}</label>
        <div class="input-wrap"><Mail size={17} aria-hidden="true" /><input id="forgot-email" name="email" type="email" autocomplete="email" required placeholder="owner@shop.com" /></div>
        <button type="submit">{copy.submit}</button>
      </form>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script define:vars={{ lang, sentCopy: copy.sent, errorCopy: copy.error }}>
  const form = document.getElementById("forgot-form") as HTMLFormElement | null;
  const message = document.getElementById("recovery-message");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector("button");
    const email = (document.getElementById("forgot-email") as HTMLInputElement | null)?.value || "";
    if (button) button.disabled = true;
    try {
      const response = await fetch("/api/auth/forgot-password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, lang }),
      });
      if (!response.ok) throw new Error("request_failed");
      if (message) {
        message.textContent = sentCopy;
        message.className = "message success";
        message.hidden = false;
      }
      form.reset();
    } catch {
      if (message) {
        message.textContent = errorCopy;
        message.className = "message error";
        message.hidden = false;
      }
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .recovery-page{min-height:80vh;padding:120px 20px 72px;background:#090a0f;color:#f5f7fb;display:flex;justify-content:center;align-items:flex-start}
  .recovery-card{box-sizing:border-box;width:min(100%,480px);padding:34px 30px;border:1px solid rgba(255,255,255,.08);border-radius:22px;background:rgba(23,26,35,.68);box-shadow:0 24px 60px rgba(0,0,0,.32)}
  .back-link{display:inline-flex;align-items:center;gap:7px;margin-bottom:28px;color:#aab3c3;text-decoration:none;font-size:14px;font-weight:700}
  .icon-wrap{display:grid;place-items:center;width:52px;height:52px;margin-bottom:18px;border-radius:16px;background:rgba(124,92,255,.14);color:#a694ff}
  h1{margin:0 0 10px;font-size:28px;line-height:1.1}p{margin:0 0 26px;color:#a5afbf;line-height:1.55}
  form{display:grid;gap:12px}label{font-size:13px;font-weight:750;color:#dbe1ea}.input-wrap{display:flex;align-items:center;gap:9px;padding:0 13px;border:1px solid rgba(255,255,255,.12);border-radius:11px;background:rgba(0,0,0,.2)}
  input{min-width:0;width:100%;padding:14px 0;border:0;outline:0;background:transparent;color:#fff;font:inherit}button{min-height:48px;margin-top:8px;border:0;border-radius:12px;background:linear-gradient(135deg,#7c5cff,#5ac8fa);color:#06101c;font-weight:850;cursor:pointer}button:disabled{opacity:.55;cursor:wait}
  .message{margin:0 0 20px;padding:13px 14px;border-radius:10px;font-size:14px;line-height:1.45}.message.success{border:1px solid rgba(52,211,153,.25);background:rgba(52,211,153,.08);color:#baf3dc}.message.error{border:1px solid rgba(248,113,113,.25);background:rgba(248,113,113,.08);color:#fecaca}
  @media(max-width:520px){.recovery-page{padding:92px 14px 56px}.recovery-card{padding:26px 20px;border-radius:18px}h1{font-size:25px}}
</style>
