---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import HermesConnectAccountSwitcher from "../../../../components/HermesConnectAccountSwitcher.astro";
---

<BaseLayout title="Settings | Hermes Connect Repair Shop" description="Owner-only Repair Shop workspace settings and connection readiness." robots="noindex,nofollow">
  <div class="site-header company-account-source" aria-hidden="true"><HermesConnectAccountSwitcher current="repair" mode="menu" /></div>
  <main id="main-content" class="settings-v4-page">
    <div class="hc4-page-shell">
      <header class="hc4-page-head"><div><p class="hc4-kicker" data-i18n="kicker">Workspace</p><h1 data-i18n="title">Settings</h1><p data-i18n="subtitle">Connection readiness and workspace preferences. Statuses stay explicit: nothing is shown as connected without a real authorization state.</p></div></header>

      <section class="hc4-card">
        <div class="hc4-card-head"><div><p class="hc4-eyebrow" data-i18n="connections">Connections</p><h2 data-i18n="apps">Apps & channels</h2><p data-i18n="connectionsCopy">These cards describe current readiness only. They do not simulate live integrations.</p></div></div>
        <div class="hc4-connection-grid">
          <article class="hc4-connection priority"><div class="hc4-connection-head"><span class="hc4-app-mark">G</span><div><strong>Google Calendar</strong><small data-i18n="calendarRole">Free/busy conflict layer</small></div><span class="hc4-connection-status needs-auth" data-i18n="needsAuth">Needs authorization</span></div><p data-i18n="calendarCopy">Privacy-minimal free/busy access is the intended first adapter. Event titles, attendees and descriptions are not required.</p><button class="hc4-button" type="button" disabled data-i18n="adapterApproval">Available after adapter approval</button></article>
          <article class="hc4-connection"><div class="hc4-connection-head"><span class="hc4-app-mark">@</span><div><strong data-i18n="email">Email</strong><small data-i18n="opsContext">Operational context</small></div><span class="hc4-connection-status planned" data-i18n="planned">Planned</span></div><p data-i18n="emailCopy">Owner-authorized company mailbox context. No production mailbox is connected from this screen.</p></article>
          <article class="hc4-connection"><div class="hc4-connection-head"><span class="hc4-app-mark">W</span><div><strong data-i18n="brand">Website & brand</strong><small data-i18n="publicAssets">Public assets</small></div><span class="hc4-connection-status planned" data-i18n="planned">Planned</span></div><p data-i18n="brandCopy">Logo, colors and approved brand assets can later flow to the public shop page after owner approval.</p></article>
          <article class="hc4-connection"><div class="hc4-connection-head"><span class="hc4-app-mark">S</span><div><strong data-i18n="social">Social channels</strong><small>Instagram · Facebook · Threads · LinkedIn · X</small></div><span class="hc4-connection-status planned" data-i18n="planned">Planned</span></div><p data-i18n="socialCopy">No social account is shown as connected until a real account authorization exists.</p></article>
        </div>
      </section>

      <section class="hc4-card hc4-settings-note">
        <div><p class="hc4-eyebrow" data-i18n="truth">Backend truth</p><h2 data-i18n="truthTitle">What this screen does not claim</h2></div>
        <div class="hc4-truth-grid"><span data-i18n="truth1">No fake Connected status</span><span data-i18n="truth2">No synthetic revenue</span><span data-i18n="truth3">No invented appointments</span><span data-i18n="truth4">No automatic publishing</span></div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const supported=new Set(["en","ru","uk","es","it","fr"]);const requested=(new URLSearchParams(location.search).get("lang")||"en").toLowerCase();const locale=supported.has(requested)?requested:"en";
  const en={kicker:"Workspace",title:"Settings",subtitle:"Connection readiness and workspace preferences. Statuses stay explicit: nothing is shown as connected without a real authorization state.",connections:"Connections",apps:"Apps & channels",connectionsCopy:"These cards describe current readiness only. They do not simulate live integrations.",calendarRole:"Free/busy conflict layer",needsAuth:"Needs authorization",calendarCopy:"Privacy-minimal free/busy access is the intended first adapter. Event titles, attendees and descriptions are not required.",adapterApproval:"Available after adapter approval",email:"Email",opsContext:"Operational context",planned:"Planned",emailCopy:"Owner-authorized company mailbox context. No production mailbox is connected from this screen.",brand:"Website & brand",publicAssets:"Public assets",brandCopy:"Logo, colors and approved brand assets can later flow to the public shop page after owner approval.",social:"Social channels",socialCopy:"No social account is shown as connected until a real account authorization exists.",truth:"Backend truth",truthTitle:"What this screen does not claim",truth1:"No fake Connected status",truth2:"No synthetic revenue",truth3:"No invented appointments",truth4:"No automatic publishing"};
  const ru={kicker:"Рабочее пространство",title:"Настройки",subtitle:"Готовность подключений и настройки рабочего пространства. Ничего не показывается как подключённое без реальной авторизации.",connections:"Подключения",apps:"Приложения и каналы",connectionsCopy:"Карточки показывают только текущее состояние готовности и не имитируют живые интеграции.",calendarRole:"Слой конфликтов free/busy",needsAuth:"Нужна авторизация",calendarCopy:"Первый адаптер предполагает минимальные данные free/busy. Названия событий, участники и описания не требуются.",adapterApproval:"После одобрения адаптера",email:"Почта",opsContext:"Операционный контекст",planned:"Запланировано",emailCopy:"Контекст почты только после авторизации владельцем. С этой страницы production mailbox не подключён.",brand:"Сайт и бренд",publicAssets:"Публичные материалы",brandCopy:"Логотип, цвета и утверждённые материалы позже смогут попадать на публичную страницу после подтверждения владельца.",social:"Социальные каналы",socialCopy:"Ни один социальный аккаунт не показывается как подключённый без реальной авторизации.",truth:"Правда backend",truthTitle:"Чего этот экран не утверждает",truth1:"Нет fake Connected",truth2:"Нет выдуманной выручки",truth3:"Нет выдуманных записей",truth4:"Нет автоматической публикации"};
  const t=locale==="ru"?ru:en;document.documentElement.lang=locale;document.querySelectorAll<HTMLElement>("[data-i18n]").forEach(n=>{const k=n.dataset.i18n||"";if(t[k])n.textContent=t[k]});
</script>

<style>
  .hc4-connection-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.hc4-connection{display:grid;align-content:start;gap:10px;min-height:154px;padding:14px;border:1px solid #e5eaf0;border-radius:13px;background:#fbfcfe}.hc4-connection.priority{border-color:#d9e5f4;background:#f8fbff}.hc4-connection-head{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:9px}.hc4-app-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:#edf4ff;color:#1769d2;font-size:12px;font-weight:900}.hc4-connection-head>div{display:grid;gap:2px;min-width:0}.hc4-connection-head strong{color:#263348;font-size:12px}.hc4-connection-head small{overflow:hidden;color:#8a95a4;font-size:9px;text-overflow:ellipsis;white-space:nowrap}.hc4-connection-status{display:inline-flex;align-items:center;min-height:25px;padding:0 7px;border-radius:999px;font-size:8.5px;font-weight:850;white-space:nowrap}.hc4-connection-status.needs-auth{background:#fff4df;color:#99610a}.hc4-connection-status.planned{background:#eef2f7;color:#687688}.hc4-connection p{margin:0;color:#6e7c90;font-size:10.5px;line-height:1.5}.hc4-connection .hc4-button{justify-self:start;min-height:36px}.hc4-settings-note{display:grid;grid-template-columns:minmax(220px,.65fr) 1.35fr;gap:18px;align-items:center}.hc4-settings-note h2{margin:3px 0 0;color:#28364a;font-size:16px}.hc4-truth-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.hc4-truth-grid span{padding:10px 11px;border:1px solid #e6ebf1;border-radius:10px;background:#fafbfd;color:#657386;font-size:10px;font-weight:760}
  @media(max-width:780px){.hc4-connection-grid{grid-template-columns:1fr}.hc4-connection{min-height:0}.hc4-connection-head{grid-template-columns:auto minmax(0,1fr)}.hc4-connection-status{grid-column:2;justify-self:start}.hc4-settings-note{grid-template-columns:1fr}.hc4-truth-grid{grid-template-columns:1fr 1fr}}
</style>
