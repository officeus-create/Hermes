---
import HermesConnectCapabilityPage from "../../../components/HermesConnectCapabilityPage.astro";

const faqs = [
  {
    question: "Are the old Starter, Pro, and Enterprise prices current public Hermes Connect pricing?",
    answer: "No. Historical planning prices are not published on this canonical product page. Current commercial terms must be explicitly approved and verified before any pricing is presented as live.",
  },
  {
    question: "What is Proposal Builder intended to do?",
    answer: "It is designed to structure itemized service proposals from approved inputs and prepare a human-reviewable document before any signature or commercial commitment.",
  },
];

const capabilities = [
  { title: "Structured proposal inputs", body: "Turn approved scope, service, and commercial inputs into a consistent proposal outline." },
  { title: "Human-reviewed output", body: "Keep pricing, scope, and terms reviewable before anything is treated as an approved customer offer." },
  { title: "Export-ready structure", body: "Prepare content for document or PDF export without claiming a live e-signature or DocuSign integration." },
];
---

<HermesConnectCapabilityPage
  name="Proposal Builder"
  pageTitle="Proposal Builder Reference Capability | Hermes Connect"
  description="Reference documentation for the Hermes Connect Proposal Builder. Historical subscription pricing is not presented as current public pricing."
  canonicalUrl="https://hermeslogisticsus.com/services/hermes-connect/proposal-builder/"
  lead="A proposal-assembly concept for turning approved service inputs into consistent, reviewable commercial documents without presenting historical pricing or e-signature integrations as live."
  capabilities={capabilities}
  boundary="Historical subscription-tier prices are not current public Hermes Connect pricing. Automated e-signature, DocuSign, billing, and contract execution require separately verified production flows."
  faqs={faqs}
/>
