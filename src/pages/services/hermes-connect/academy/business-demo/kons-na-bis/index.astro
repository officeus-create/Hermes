(--muted);line-height:1.55}.panel-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.pipeline{display:grid;gap:8px}.lead-row{display:grid;grid-template-columns:1.2fr .8fr 1fr;gap:12px;align-items:center;border-top:1px solid #edf0f1;padding:11px 0}.lead-row:first-child{border-top:0}.lead-row strong,.lead-row small,.lead-row b{display:block}.lead-row small{font-size:10px;color:var(--muted);margin-top:3px}.lead-row>span{font-size:11px;background:#eef1f7;border-radius:999px;padding:6px 8px;width:max-content}.requirement-list{padding-left:18px;margin:10px 0}.requirement-list li{margin:11px 0;color:var(--muted)}.requirement-list b{color:var(--ink)}.integration{display:grid;grid-template-columns:1.2fr 1fr;gap:25px;align-items:center}.integration-links{display:grid;grid-template-columns:1fr 1fr;gap:7px}.integration-links a{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border:1px solid var(--line);border-radius:8px;padding:9px;font-size:10px;color:inherit}.funnel{display:grid;gap:7px}.funnel>div{display:grid;grid-template-columns:34px 1fr 60px;align-items:center;gap:10px;background:#f6f8f8;border-radius:8px;padding:9px}.funnel span{font-size:9px;color:#87959b}.funnel b{font-size:12px}.funnel strong{text-align:right}.cards-mini{display:grid;grid-template-columns:1fr 1fr;gap:9px}.cards-mini>div{border:1px solid var(--line);border-radius:10px;padding:12px}.cards-mini b,.cards-mini span{display:block}.cards-mini b{font-size:12px}.cards-mini span{font-size:10px;color:var(--muted);margin-top:5px}.source-panel{margin-top:15px}.source-panel a,.vacancy-card a{font-size:12px;font-weight:750;color:inherit;text-underline-offset:4px}.pipeline-board{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin-bottom:15px}.pipeline-board article{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px;min-height:130px}.pipeline-board span,.pipeline-board small{display:block;color:var(--muted);font-size:9px}.pipeline-board h3{font-size:13px;min-height:34px;margin:8px 0}.pipeline-board b{font-size:25px}.level-stack{display:grid;gap:7px}.level-stack>div{display:grid;grid-template-columns:80px 1fr;gap:5px 12px;border:1px solid var(--line);border-radius:9px;padding:11px}.level-stack span{font-size:9px;color:var(--violet);font-weight:850}.level-stack b{font-size:12px}.level-stack small{grid-column:2;font-size:10px;color:var(--muted)}.score-list{display:grid;gap:0}.score-list>div{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line);font-size:12px}.program-grid,.vacancy-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-bottom:15px}.program-card ul,.vacancy-card ul{padding-left:18px;color:var(--muted);font-size:12px;line-height:1.65}.program-card>small{font-size:10px;color:#849197}.cohort-row,.candidate-list>div{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;align-items:center;border-top:1px solid var(--line);padding:12px 0;font-size:11px}.cohort-row{border-top:0}.compact{min-height:130px}.compact strong{font-size:26px}.learning-flow{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin-bottom:15px}.learning-flow article{background:#fff;border:1px solid var(--line);border-radius:12px;padding:15px;min-height:110px}.learning-flow span,.learning-flow b,.learning-flow small{display:block}.learning-flow span{font-size:9px;color:var(--violet);font-weight:850}.learning-flow b{font-size:13px;margin:9px 0}.learning-flow small{font-size:10px;color:var(--muted)}.analytics-table{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden}.analytics-table>div{display:grid;grid-template-columns:1.1fr .5fr 1fr 1fr;gap:12px;padding:11px 14px;border-top:1px solid var(--line);font-size:11px}.analytics-table>div:first-child{border-top:0}.analytics-table .table-head{background:#f0f4f4;font-weight:850;color:#64747b;text-transform:uppercase;font-size:9px}.analytics-table b{font-size:17px}.status-stack{display:grid;gr