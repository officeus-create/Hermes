---
import BaseLayout from "../../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../../../components/SiteFooter.astro";
import "../../../../../../styles/hermes-academy-app.css";
---

<BaseLayout
  title="Academy Business CRM | Hermes Connect"
  description="Private Hermes Connect workspace for academies, courses, schools and business clubs."
  robots="noindex,nofollow"
  htmlLang="uk"
  locale="uk"
>
  <div class="academy-app-page">
    <SiteHeader activePath="/services/hermes-connect/" locale="uk" />
    <main id="main-content" class="academy-app-shell">
      <div class="academy-owner-toolbar">
        <a href="/services/hermes-connect/" data-i18n="back">← Hermes Connect</a>
        <div class="academy-owner-lang" aria-label="Language">
          <button type="button" data-lang="uk" class="active">UA</button>
          <button type="button" data-lang="en">EN</button>
        </div>
      </div>

      <div class="academy-app-alert" data-workspace-alert role="status"></div>

      <section class="academy-app-hero" data-workspace-loading>
        <article class="academy-app-card">
          <p class="academy-app-eyebrow">Hermes Connect · Academy Business CRM</p>
          <h2 class="academy-app-loading-title" data-i18n="loading">Завантажуємо ваш робочий простір…</h2>
          <p data-i18n="loadingCopy">Перевіряємо Hermes-акаунт та профіль навчального бізнесу.</p>
        </article>
      </section>

      <div class="academy-app-hidden" data-workspace-content>
        <section class="academy-app-hero">
          <article class="academy-app-card">
            <p class="academy-app-eyebrow" data-i18n="ownerWorkspace">Робочий простір власника</p>
            <h1><span data-business-name>Academy</span> · <span data-i18n="crm">Academy CRM</span></h1>
            <p data-i18n="heroCopy">CRM адаптована під навчальний бізнес: продаж програм, учасники, потоки, навчання, завдання, перевірки, маркетинг, HR та повторні продажі працюють як один pipeline.</p>
            <div class="academy-app-actions">
              <a class="academy-app-button intelligence" href="#crm" data-i18n="openPipeline">Відкрити sales pipeline</a>
              <a class="academy-app-button" data-catalog-link href="/businesses/" data-i18n="catalogProfile">Профіль у Catalog</a>
              <a class="academy-app-button" href="/services/hermes-connect/academy/business/auth/" data-i18n="settings">Налаштування бізнесу</a>
              <button class="academy-app-button" type="button" data-logout data-i18n="logout">Вийти</button>
            </div>
          </article>
          <aside class="academy-app-card academy-app-dark">
            <span class="academy-app-status" data-i18n="vertical">Academy vertical</span>
            <h2 data-i18n="different">Не універсальна CRM.</h2>
            <p data-i18n="differentCopy">Repair Shop отримує записи, автомобілі та графік СТО. Academy отримує ліди, консультації, учасників, cohorts, lessons, assignments, reviews і retention. Hermes identity спільна, робочий процес — різний.</p>
          </aside>
        </section>

        <section class="academy-owner-kpis" data-academy-crm-metrics>
          <article><span data-i18n="leads">Нові ліди</span><strong data-crm-metric="totalLeads">—</strong><small>CRM Core · live data</small></article>
          <article><span data-i18n="consultations">Консультації</span><strong data-crm-metric="consultationsBooked">—</strong><small>booked · live data</small></article>
          <article><span data-i18n="qualified">Кваліфікація</span><strong data-crm-metric="consultationsQualified">—</strong><small>consultation qualified</small></article>
          <article><span data-i18n="enrolled">Зарахований</span><strong data-crm-metric="enrolled">—</strong><small>CRM Core · live data</small></article>
          <article><span>Revenue</span><strong data-crm-revenue>—</strong><small data-i18n="realOnly">лише з реальних даних</small></article>
        </section>

        <section class="academy-app-panel" id="crm">
          <div class="academy-owner-panel-head"><div><p class="academy-app-eyebrow">SALES CRM</p><h2 data-i18n="pipeline">Лід → консультація → програма → зарахування → навчання → renewal</h2></div><span class="academy-app-status" data-i18n="sampleBoard">Демо-дошка</span></div>
          <div class="academy-owner-pipeline">
            <div><b data-i18n="newLead">Нова заявка</b><article><strong>Demo · Ірина</strong><small>Instagram · SMB owner</small></article><article><strong>Demo · Максим</strong><small>Webinar · warm lead</small></article></div>
            <div><b data-i18n="qualified">Кваліфікація</b><article><strong>Demo · Олена</strong><small data-i18n="need">Потреба: систематизація продажів</small></article></div>
            <div><b data-i18n="consultBooked">Консультацію призначено</b><article><strong>Demo · Андрій</strong><small>Next action · 16:30</small></article></div>
            <div><b data-i18n="consultDone">Консультацію проведено</b></div>
            <div><b data-i18n="programSelected">Програму підібрано</b><article><strong>Demo · Сергій</strong><small data-i18n="programFit">Program fit · owner growth</small></article></div>
            <div><b data-i18n="decision">Рішення / follow-up</b></div>
            <div><b data-i18n="enrolled">Зарахований</b><article><strong>Demo · Наталія</strong><small>Cohort · 7-week growth</small></article></div>
            <div><b data-i18n="activeLearner">Активний учасник</b></div>
            <div><b data-i18n="completed">Завершив / alumni</b><article><strong>Demo · Віктор</strong><small>Completion · reviewed</small></article></div>
            <div><b data-i18n="renewal">Renewal / наступна програма</b></div>
          </div>
        </section>

        <section class="academy-app-panel academy-crm-core" id="crm-core" data-academy-crm-core>
          <div class="academy-owner-panel-head">
            <div><p class="academy-app-eyebrow">CRM CORE · OWNER-SCOPED</p><h2>Реальні ліди, консультації та наступні дії</h2></div>
            <span class="academy-app-status">LIVE DATA · PRIVATE</span>
          </div>
          <p>Цей блок читає та зберігає приватні CRM-записи поточного власника Academy Business. Demo pipeline вище залишається лише моделлю майбутнього повного workspace. Revenue не вважається відомим без окремого source reference.</p>
          <form class="academy-crm-core-form" data-crm-lead-form>
            <label><span>Контакт *</span><input name="contactName" required maxlength="160" autocomplete="name" placeholder="Ім’я / компанія"/></label>
            <label><span>Джерело</span><input name="sourceChannel" maxlength="80" placeholder="instagram / threads / website"/></label>
            <label><span>Content ID</span><input name="contentId" maxlength="160" placeholder="reel-001"/></label>
            <label><span>Campaign ID</span><input name="campaignId" maxlength="160" placeholder="organic-october"/></label>
            <label><span>Основна потреба</span><input name="primaryPain" maxlength="600" placeholder="Що потрібно вирішити"/></label>
            <label><span>Рекомендований модуль</span><input name="recommendedModule" maxlength="180" placeholder="W6 · Sales System"/></label>
            <label><span>Stage</span><select name="businessStage"><option value="new">New</option><option value="contacted">Contacted</option><option value="qualified">Qualified</option><option value="consultation_booked">Consultation booked</option><option value="consultation_attended">Consultation attended</option><option value="program_fit">Program fit</option><option value="decision">Decision</option><option value="enrolled">Enrolled</option><option value="active">Active</option><option value="completed">Completed</option><option value="lost">Lost</option><option value="renewal">Renewal</option></select></label>
            <label><span>Consultation</span><select name="consultationStatus"><option value="not_scheduled">Not scheduled</option><option value="booked">Booked</option><option value="attended">Attended</option><option value="qualified">Qualified</option><option value="no_show">No-show</option><option value="cancelled">Cancelled</option><option value="not_fit">Not fit</option></select></label>
            <label class="academy-crm-core-wide"><span>Next action</span><input name="nextAction" maxlength="400" placeholder="Наступна конкретна дія"/></label>
            <label><span>Next contact</span><input name="nextContactAt" type="datetime-local"/></label>
            <button class="academy-app-button intelligence" type="submit">Зберегти lead</button>
          </form>
          <p class="academy-crm-core-status" data-crm-form-status aria-live="polite"></p>
          <div class="academy-crm-recent" data-crm-recent>
            <p>Завантажуємо реальні CRM-записи…</p>
          </div>
        </section>

        <section class="academy-owner-modules">
          <article class="academy-app-panel"><p class="academy-app-eyebrow">LEARNER 360</p><h2 data-i18n="learner360">Картка учасника</h2><ul><li data-i18n="source">Джерело ліда, менеджер і консультація</li><li data-i18n="progress">Прогрес за модулями та відвідування</li><li data-i18n="assignments">Домашні завдання і reviewer feedback</li><li data-i18n="baseline">Business KPI baseline / before → after</li><li data-i18n="retention">Завершення, feedback, наступна програма, клуб</li></ul></article>
          <article class="academy-app-panel"><p class="academy-app-eyebrow">ACADEMY OPS</p><h2 data-i18n="delivery">Навчальний delivery</h2><ul><li data-i18n="cohorts">Потоки / cohorts</li><li data-i18n="lessons">Уроки та записи</li><li data-i18n="weekly">Щотижневі розбори</li><li>VIP sessions</li><li data-i18n="privateGroup">Закрита / private group</li><li data-i18n="nextAction">Наступна дія по кожному учаснику</li></ul></article>
          <article class="academy-app-panel"><p class="academy-app-eyebrow">MARKETING</p><h2>CAC · LTV · ROMI</h2><p data-i18n="marketingCopy">Канал → lead → consultation → sale → revenue. Фінансові показники не вигадуються: вони з’являються після підключення реальних витрат і CRM revenue.</p></article>
          <article class="academy-app-panel"><p class="academy-app-eyebrow">SALES CONTROL</p><h2 data-i18n="salesControl">Sales plan + CRM reporting</h2><ul><li data-i18n="salesPlan">План vs факт по менеджеру, консультаціях, угодах і revenue — лише з реальних CRM даних.</li><li data-i18n="crmReporting">Щотижневий CRM report: source → stage → next action → outcome reason.</li></ul></article>
          <article class="academy-app-panel"><p class="academy-app-eyebrow">HR / RECRUITING</p><h2 data-i18n="hiring">Команда академії</h2><p>Applicant → Screen → Interview → Test Assignment → Scorecard → Final Interview → Offer / No → Adaptation.</p><p data-i18n="hiringCopy">Recruiting зберігається окремо від learner progression та не перетворює навчальні оцінки на автоматичні кадрові рішення.</p></article>
        </section>

        <section class="academy-app-panel" id="workspace-access">
          <div class="academy-owner-panel-head">
            <div><p class="academy-app-eyebrow">TEAM ACCESS · RBAC</p><h2 data-i18n="accessTitle">Одна Academy CRM — різні робочі ролі.</h2></div>
            <span class="academy-app-status" data-i18n="accessState">Product structure · permission backend pending</span>
          </div>
          <p data-i18n="accessCopy">Власник бачить весь бізнес-контур. Команді потрібен мінімально необхідний доступ за модулем: marketing не отримує приватні HR-рішення, sales не отримує reviewer power, а reviewer не отримує фінансові або кадрові права автоматично.</p>
          <div class="academy-role-grid">
            <article><span>OWNER</span><b data-i18n="roleOwner">Власник</b><small data-i18n="roleOwnerCopy">Business settings · programs · teams · reports · final approvals.</small></article>
            <article><span>ADMIN</span><b data-i18n="roleAdmin">Адміністратор</b><small data-i18n="roleAdminCopy">Workspace configuration and approved operating support.</small></article>
            <article><span>MARKETING</span><b>Marketing</b><small data-i18n="roleMarketingCopy">Campaigns · content attribution · funnel · KPI inputs.</small></article>
            <article><span>SALES</span><b>Sales</b><small data-i18n="roleSalesCopy">Leads · diagnostics · consultations · deals · next actions.</small></article>
            <article><span>HR</span><b>HR / Recruiting</b><small data-i18n="roleHrCopy">Vacancies · candidate stages · assessment templates · human decisions.</small></article>
            <article><span>CURATOR</span><b data-i18n="roleCurator">Куратор</b><small data-i18n="roleCuratorCopy">Cohorts · attendance · assignments · participant follow-up.</small></article>
            <article><span>REVIEWER</span><b>Reviewer</b><small data-i18n="roleReviewerCopy">Evidence review only within authorized program scope.</small></article>
            <article><span>READ ONLY</span><b data-i18n="roleReadonly">Тільки перегляд</b><small data-i18n="roleReadonlyCopy">Selected dashboards and reports without operational writes.</small></article>
          </div>
          <p class="academy-owner-boundary" data-i18n="accessBoundary">Це цільова permission-модель для Academy Business. На поточній demo-стадії вона не заявляється як повністю активований multi-user RBAC: реальні team memberships і company-scoped permissions мають бути підключені окремо перед зберіганням client staff/candidate data.</p>
        </section>

        <section class="academy-app-panel" id="acquisition-control">
          <div class="academy-owner-panel-head"><div><p class="academy-app-eyebrow">ACQUISITION CONTROL</p><h2 data-i18n="acquisitionTitle">Organic baseline → paid learning → offer hypothesis → consultation → program.</h2></div><span class="academy-app-status" data-i18n="sampleBoard">Демо-дошка</span></div>
          <p data-i18n="acquisitionCopy">До offer-test CRM зберігає source asset, organic/paid state, campaign, content hypothesis і baseline. Offer/CTA стає робочою гіпотезою тільки після organic + paid learning gate; після lead додаються pain, diagnostic gap, recommended module і next action.</p>
          <div class="academy-acquisition-table">
            <div class="academy-acq-head"><b data-i18n="acqSource">Джерело</b><b data-i18n="acqOffer">Observed CTA / hypothesis</b><b data-i18n="acqGap">Diagnostic gap</b><b data-i18n="acqModule">Рекомендований модуль</b><b data-i18n="acqNext">Наступна дія</b></div>
            <div><span>Instagram · Reel</span><span>Free business review · “+”</span><span>Sales system</span><span>W6 · Sales</span><span>Consultation</span></div>
            <div><span>Instagram · Bio</span><span>Certificate 283€</span><span>Needs diagnosis</span><span>Pending</span><span>Business diagnostic</span></div>
            <div><span>Threads · Content</span><span>Content unpacking video</span><span>Positioning / marketing</span><span>W1 · Marketing</span><span>Diagnostic → consult</span></div>
            <div><span>TikTok · Profile</span><span>Consultation</span><span>Program fit</span><span>Pending diagnosis</span><span>Qualify</span></div>
          </div>
          <p class="academy-owner-boundary" data-i18n="acquisitionBoundary">Рядки вище — публічно спостережувані CTA / hypotheses для демонстрації attribution, а не рекомендація запускати їх зараз і не реальні leads КНБ. До offer/funnel потрібні internal analytics, organic baseline і paid learning; revenue/conversion з’являються тільки з дозволених реальних джерел.</p>
        </section>

        <section class="academy-app-panel" id="proof-registry">
          <div class="academy-owner-panel-head"><div><p class="academy-app-eyebrow">CLAIMS / PROOF REGISTRY</p><h2 data-i18n="proofTitle">Контроль доказів для marketing, site і sales.</h2></div><span class="academy-app-status" data-i18n="configurable">Налаштовується</span></div>
          <p data-i18n="proofCopy">Кожен публічний result claim має source, observed_at, definition, evidence owner, approved wording і review date. Якщо джерела конфліктують, система не обирає цифру автоматично — статус переходить у Needs review.</p>
          <div class="academy-proof-table">
            <div><b data-i18n="proofClaim">Claim</b><b data-i18n="proofSource">Source</b><b data-i18n="proofState">State</b><b data-i18n="proofNext">Next action</b></div>
            <div><span>Audience / participant scale</span><span>Multiple public pages</span><span>Needs review</span><span>Choose canonical evidence</span></div>
            <div><span>Program outcome %</span><span>Client-owned claim</span><span>Needs definition</span><span>Population + period + method</span></div>
            <div><span>Renewal / club continuation</span><span>Program page</span><span>Needs freshness</span><span>Confirm current cohort scope</span></div>
          </div>
          <p class="academy-owner-boundary" data-i18n="proofBoundary">Це governance-demo, а не висновок про достовірність конкретної client claim. Canonical wording затверджує уповноважена людина після evidence review.</p>
          <div class="academy-measurement-live" data-academy-measurement-live>
            <div class="academy-owner-panel-head">
              <div><p class="academy-app-eyebrow">LIVE EVIDENCE · PRIVATE</p><h3>Evidence → attribution → economics</h3></div>
              <span class="academy-app-status">UNKNOWN ≠ 0</span>
            </div>
            <p>Це приватний реєстр доказів поточного Academy Business. Spend, revenue, CAC, LTV і ROMI не змішуються між валютами та не стають “відомими” без source reference, періоду й attribution scope.</p>
            <form class="academy-measurement-form" data-measurement-form>
              <label><span>Evidence kind *</span><select name="kind">
                <option value="organic_baseline">Organic baseline</option>
                <option value="paid_spend">Paid spend</option>
                <option value="ltv">LTV evidence</option>
                <option value="result_claim">Result claim</option>
                <option value="business_result">Business result</option>
                <option value="retention">Retention</option>
                <option value="other">Other</option>
              </select></label>
              <label><span>Source channel</span><input name="sourceChannel" maxlength="80" placeholder="instagram / website"/></label>
              <label><span>Campaign ID</span><input name="campaignId" maxlength="160" placeholder="paid-october"/></label>
              <label><span>Content ID</span><input name="contentId" maxlength="160" placeholder="reel-001"/></label>
              <label><span>Metric key</span><input name="metricKey" maxlength="120" placeholder="reach / retention"/></label>
              <label><span>Metric value</span><input name="metricValue" type="number" step="any" placeholder="12500"/></label>
              <label><span>Metric unit</span><input name="metricUnit" maxlength="40" placeholder="accounts / %"/></label>
              <label><span>Money amount</span><input name="amountMajor" type="number" min="0" step="0.01" placeholder="100.00"/></label>
              <label><span>Currency</span><input name="currency" maxlength="3" placeholder="EUR / USD / UAH"/></label>
              <label><span>Observed at *</span><input name="observedAt" type="datetime-local" required/></label>
              <label><span>Period start</span><input name="periodStart" type="date"/></label>
              <label><span>Period end</span><input name="periodEnd" type="date"/></label>
              <label class="academy-measurement-wide"><span>Source reference *</span><input name="sourceRef" required maxlength="600" placeholder="URL / document / CRM / ads export"/></label>
              <label class="academy-measurement-wide"><span>Definition *</span><input name="definition" required maxlength="1200" placeholder="Population · period · calculation · exclusions"/></label>
              <label><span>Evidence owner *</span><input name="evidenceOwnerLabel" required maxlength="180" placeholder="Marketing / Finance / Program owner"/></label>
              <label><span>Claim state</span><select name="claimState">
                <option value="evidence_only">Evidence only</option>
                <option value="needs_review">Needs review</option>
                <option value="approved">Approved</option>
                <option value="rejected">Rejected</option>
                <option value="expired">Expired</option>
              </select></label>
              <label class="academy-measurement-wide"><span>Claim text</span><input name="claimText" maxlength="1200" placeholder="What we may want to say publicly"/></label>
              <label class="academy-measurement-wide"><span>Approved wording</span><input name="approvedWording" maxlength="1200" placeholder="Human-approved site/social/sales wording"/></label>
              <label><span>Review date</span><input name="reviewAt" type="date"/></label>
              <button class="academy-app-button intelligence" type="submit">Save evidence</button>
            </form>
            <p class="academy-crm-core-status" data-measurement-status aria-live="polite"></p>
            <div class="academy-measurement-economics" data-measurement-economics><p>Loading evidence economics…</p></div>
            <div class="academy-measurement-records" data-measurement-records><p>Loading evidence registry…</p></div>
          </div>
        </section>

        <section class="academy-owner-extended">
          <article class="academy-app-panel">
            <div class="academy-owner-panel-head"><div><p class="academy-app-eyebrow">PROGRAMS & COHORTS</p><h2 data-i18n="programPortfolio">Портфель програм і потоки</h2></div><span class="academy-app-status" data-i18n="configurable">Налаштовується</span></div>
            <p data-i18n="programPortfolioCopy">Кожна програма має свій sales fit, ціну після підключення billing, потоки, уроки, assignments, reviewer flow, completion і наступну пропозицію.</p>
            <div class="academy-program-flow">
              <div><span>01</span><b data-i18n="programCatalog">Каталог програм</b><small data-i18n="programCatalogCopy">Назва · формат · тривалість · eligibility</small></div>
              <div><span>02</span><b data-i18n="cohortPlanning">Планування cohort</b><small data-i18n="cohortPlanningCopy">Старт · capacity · owner · schedule</small></div>
              <div><span>03</span><b data-i18n="enrollment">Enrollment</b><small data-i18n="enrollmentCopy">Deal → learner → cohort</small></div>
              <div><span>04</span><b data-i18n="deliveryReview">Delivery & review</b><small data-i18n="deliveryReviewCopy">Lessons · evidence · feedback</small></div>
              <div><span>05</span><b data-i18n="completionRenewal">Completion & renewal</b><small data-i18n="completionRenewalCopy">Alumni · club · next program</small></div>
            </div>
          
            <div class="academy-program-live" data-academy-programs-cohorts>
              <p class="academy-owner-boundary"><b>LIVE DATA · PRIVATE.</b> Program/cohort definitions are owner + company scoped. Deal → learner → cohort linking now uses an explicit authenticated Hermes specialist claim. Email/name matching still never enrolls a person, and KNB custom programs are not written into shared Hermes Academy <code>academy_enrollments</code>.</p>
              <div class="academy-program-live-grid">
                <form data-academy-program-form>
                  <strong>Program / Програма</strong>
                  <input name="name" required maxlength="180" placeholder="Program name / Назва"/>
