    en:{back:"← Hermes Connect",loading:"Loading your workspace…",loadingCopy:"Checking your Hermes account and education-business profile.",ownerWorkspace:"Owner workspace",crm:"Academy CRM",heroCopy:"CRM adapted to an education business: program sales, learners, cohorts, learning, assignments, reviews, marketing, HR, and repeat sales in one pipeline.",openPipeline:"Open sales pipeline",catalogProfile:"Catalog profile",settings:"Business settings",logout:"Log out",vertical:"Academy vertical",different:"Not a universal CRM.",differentCopy:"Repair Shops get appointments, vehicles, and shop scheduling. Academy gets leads, consultations, learners, cohorts, lessons, assignments, reviews, and retention. Hermes identity stays shared while workflow changes by vertical.",leads:"New leads",consultations:"Consultations",learners:"Active learners",review:"Awaiting review",sample:"demo data",realOnly:"real data only",pipeline:"Lead → consultation → program → enrollment → learning → renewal",sampleBoard:"Demo board",newLead:"New lead",qualified:"Qualified",need:"Need: sales systemization",consultBooked:"Consultation booked",consultDone:"Consultation completed",programSelected:"Program selected",programFit:"Program fit · business growth",decision:"Decision / follow-up",enrolled:"Enrolled",activeLearner:"Active learner",completed:"Completed / alumni",renewal:"Renewal / next program",learner360:"Learner 360",source:"Lead source, manager, and consultation",progress:"Module progress and attendance",assignments:"Assignments and reviewer feedback",baseline:"Business KPI baseline / before → after",retention:"Completion, feedback, next program, club",delivery:"Learning delivery",cohorts:"Cohorts",lessons:"Lessons and recordings",weekly:"Weekly reviews",privateGroup:"Private group",nextAction:"Next action for every learner",marketingCopy:"Channel → organic baseline → paid learning → validated offer → lead → consultation → sale. Financial metrics are never fabricated; they appear after real spend and CRM revenue are connected.",salesControl:"Sales plan + CRM reporting",salesPlan:"Plan vs actual by manager, consultations, deals, and revenue — only from real CRM data.",crmReporting:"Weekly CRM report: source → stage → next action → outcome reason.",hiring:"Academy team",hiringCopy:"Recruiting stays separate from learner progression and does not turn learning scores into automated employment decisions.",accessTitle:"One Academy CRM — different working roles.",accessState:"Product structure · permission backend pending",accessCopy:"The owner sees the full business system. Team members should receive only the minimum module access they need: marketing does not inherit private HR decisions, sales does not inherit reviewer power, and reviewers do not automatically receive financial or employment permissions.",roleOwner:"Owner",roleOwnerCopy:"Business settings · programs · teams · reports · final approvals.",roleAdmin:"Administrator",roleAdminCopy:"Workspace configuration and approved operating support.",roleMarketingCopy:"Campaigns · content attribution · funnel · KPI inputs.",roleSalesCopy:"Leads · diagnostics · consultations · deals · next actions.",roleHrCopy:"Vacancies · candidate stages · assessment templates · human decisions.",roleCurator:"Curator",roleCuratorCopy:"Cohorts · attendance · assignments · participant follow-up.",roleReviewerCopy:"Evidence review only within authorized program scope.",roleReadonly:"Read only",roleReadonlyCopy:"Selected dashboards and reports without operational writes.",accessBoundary:"This is the target permission model for Academy Business. At the current demo stage it is not presented as fully activated multi-user RBAC: real team memberships and company-scoped permissions must be connected separately before storing client staff or candidate data.",acquisitionTitle:"Organic baseline → paid learning → offer hypothesis → consultation → program.",acquisitionCopy:"Before offer testing, CRM keeps the source asset, organic/paid state, campaign, content hypothesis, and baseline. Offer/CTA becomes a working hypothesis only after the organic + paid-learning gate; once a lead exists, add pain, diagnostic gap, recommended module, and next action.",acqSource:"Source",acqOffer:"Observed CTA / hypothesis",acqGap:"Diagnostic gap",acqModule:"Recommended module",acqNext:"Next action",acquisitionBoundary:"The rows above are publicly observed CTA/hypotheses for attribution demonstration, not a recommendation to launch them now and not real KNB leads. Offer/funnel testing requires internal analytics, an organic baseline, and paid learning first; revenue/conversion appears only from permitted real sources.",proofTitle:"Evidence control for marketing, site, and sales.",proofCopy:"Every public result claim keeps source, observed_at, definition, evidence owner, approved wording, and review date. When sources conflict, the system does not choose a number automatically; the state becomes Needs review.",proofClaim:"Claim",proofSource:"Source",proofState:"State",proofNext:"Next action",proofBoundary:"This is a governance demo, not a conclusion about whether a specific client claim is true. Canonical wording is approved by an authorized human after evidence review.",programPortfolio:"Program portfolio & cohorts",configurable:"Configurable",programPortfolioCopy:"Each program can have its own sales fit, price after billing is connected, cohorts, lessons, assignments, reviewer flow, completion, and next offer.",programCatalog:"Program catalog",programCatalogCopy:"Name · format · duration · eligibility",cohortPlanning:"Cohort planning",cohortPlanningCopy:"Start · capacity · owner · schedule",enrollment:"Enrollment",enrollmentCopy:"Deal → learner → cohort",deliveryReview:"Delivery & review",deliveryReviewCopy:"Lessons · evidence · feedback",completionRenewal:"Completion & renewal",completionRenewalCopy:"Alumni · club · next program",salesHierarchy:"Multi-level sales structure",salesHierarchyCopy:"CRM supports up to four sales-management levels for businesses that need them. Role names and permissions are defined by the business; the structure does not automate employment decisions.",levelRole:"Business-defined role",levelMetrics:"Plan · conversion · next action",kpiDictionary:"Define the metric before showing a number.",kpiDictionaryCopy:"The template is ready for financial and commercial KPI, but values stay blank until a trusted source is connected.",assessmentTitle:"Candidate test assignments stay separate from learner education.",assessmentTemplate:"Template · Marketing",assessmentCopy:"HR can create reusable assessment templates for a specific role. The candidate receives the brief, deadline, sources, submission format and rubric; a reviewer scores evidence, thinking and execution, while the final employment decision remains human.",assessmentClient:"Client / role",assessmentDeadline:"Deadline",assessmentFormat:"Submission",assessmentReady:"Template ready",trainingMethodTitle:"Four-column method before writing content",trainingMethodCopy:"Fill columns 2–4 first, then return to 1: Question → Awareness → Understanding → Application.",trainingCol1:"1 · Blank first → leading questions",trainingCol2:"2 · Awareness",trainingCol3:"3 · Understanding",trainingCol4:"4 · Application",assessmentTask1:"Social-channel analysis",assessmentTask1Copy:"Choose any business social channel, complete a concise audit, and explain what you would implement immediately as the channel lead and which growth paths you see.",assessmentTask2:"Program sales funnel",assessmentTask2Copy:"The original brief asks for a funnel + offer for the seven-week program. A strong answer first proves readiness: which internal Meta/CRM data is required, how to build the organic baseline, how to run paid learning on winners, and only then shows the offer as a hypothesis and a future funnel.",rubric1:"1 · Evidence & diagnosis",rubric1Copy:"Does the conclusion use observable facts, content and metrics rather than generic statements.",rubric2:"2 · Audience & positioning",rubric2Copy:"Is it clear who the offer is for, which problem it solves, and why it matters.",rubric3:"3 · Sequence / funnel logic",rubric3Copy:"Are the organic baseline and paid-learning gate preserved before offer/funnel, with a measurable downstream handoff.",rubric4:"4 · Readiness & offer hypothesis",rubric4Copy:"Does the candidate distinguish a public audit from a validated offer and avoid spending budget before sufficient signal.",rubric5:"5 · KPI & measurement",rubric5Copy:"Are conversion, CAC, LTV/retention, revenue attribution and success criteria defined.",rubric6:"6 · Execution thinking",rubric6Copy:"Can the work become a 3–6 month media plan: organic → paid learning → offer validation → scale, with owners, priorities, and next actions.",assessmentDecision:"Decision · Pending human review",boundary:"For now, operating cards and metrics on this page are a vertical demo structure. The business profile and Hermes identity are persisted; CRM modules are activated incrementally without presenting demo data as real."}
  } as const;
  type Lang=keyof typeof dict;
  const params=new URLSearchParams(location.search);let lang:Lang=params.get("lang")==="en"?"en":"uk";
  const apply=(next:Lang)=>{lang=next;document.documentElement.lang=next;try{localStorage.setItem("hermes-connect-language",next)}catch{};document.querySelectorAll<HTMLAnchorElement>('a[href^="/services/hermes-connect/"]').forEach(link=>{const url=new URL(link.getAttribute("href")||"/",window.location.origin);url.searchParams.set("lang",next);link.href=url.pathname+url.search+url.hash;});document.querySelectorAll<HTMLElement>("[data-i18n]").forEach(n=>{const k=n.dataset.i18n as keyof typeof dict.uk;const v=dict[next][k];if(v)n.textContent=v});document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach(b=>b.classList.toggle("active",b.dataset.lang===next));};
  document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach(b=>b.addEventListener("click",()=>{const next:Lang=b.dataset.lang==="en"?"en":"uk";const url=new URL(window.location.href);url.searchParams.set("lang",next);window.location.assign(url.pathname+url.search+url.hash);}));apply(lang);

  const loading=document.querySelector<HTMLElement>("[data-workspace-loading]");const content=document.querySelector<HTMLElement>("[data-workspace-content]");const alert=document.querySelector<HTMLElement>("[data-workspace-alert]");
  const json=async(url:string,options:RequestInit={})=>{const r=await fetch(url,{...options,headers:{Accept:"application/json",...(options.headers||{})},credentials:"same-origin",cache:"no-store"});const p=await r.json().catch(()=>({}));if(!r.ok)throw Object.assign(new Error(p.error||`request_${r.status}`),{status:r.status,payload:p});return p;};
  const fail=(message:string)=>{if(alert){alert.textContent=message;alert.className="academy-app-alert show error";}};
  void(async()=>{
    try{
      await json("/api/auth/me");
      const state=await json("/api/hermes-connect/academy/business");
      if(!state.academyBusiness){location.assign("/services/hermes-connect/academy/business/auth/?mode=register");return;}
      const b=state.academyBusiness;const name=document.querySelector<HTMLElement>("[data-business-name]");if(name)name.textContent=b.businessName||"Academy";
      const link=document.querySelector<HTMLAnchorElement>("[data-catalog-link]");if(link)link.href=b.catalogOptIn?`/businesses/connect/academy/${encodeURIComponent(b.slug)}/`:"/businesses/";
      loading?.classList.add("academy-app-hidden");content?.classList.remove("academy-app-hidden");
    }catch(error:any){if(error?.status===401){location.assign("/services/hermes-connect/academy/business/auth/?mode=login");return;}fail(String(error?.message||"Could not load workspace"));}
  })();
  document.querySelector<HTMLButtonElement>("[data-logout]")?.addEventListener("click",async()=>{await fetch("/api/auth/logout",{method:"POST",credentials:"same-origin"}).catch(()=>null);location.assign("/services/hermes-connect/academy/business/auth/?mode=login");});
</script>

