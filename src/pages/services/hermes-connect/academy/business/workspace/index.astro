    uk:{back:"← Hermes Connect",loading:"Завантажуємо ваш робочий простір…",loadingCopy:"Перевіряємо Hermes-акаунт та профіль навчального бізнесу.",ownerWorkspace:"Робочий простір власника",crm:"Academy CRM",heroCopy:"CRM адаптована під навчальний бізнес: продаж програм, учасники, потоки, навчання, завдання, перевірки, маркетинг, HR та повторні продажі працюють як один pipeline.",openPipeline:"Відкрити sales pipeline",catalogProfile:"Профіль у Catalog",settings:"Налаштування бізнесу",logout:"Вийти",vertical:"Academy vertical",different:"Не універсальна CRM.",differentCopy:"Repair Shop отримує записи, автомобілі та графік СТО. Academy отримує ліди, консультації, учасників, cohorts, lessons, assignments, reviews і retention. Hermes identity спільна, робочий процес — різний.",leads:"Нові ліди",consultations:"Консультації",learners:"Активні учасники",review:"На перевірці",sample:"demo data",realOnly:"лише з реальних даних",pipeline:"Лід → консультація → програма → зарахування → навчання → renewal",sampleBoard:"Демо-дошка",newLead:"Нова заявка",qualified:"Кваліфікація",need:"Потреба: систематизація продажів",consultBooked:"Консультацію призначено",consultDone:"Консультацію проведено",programSelected:"Програму підібрано",programFit:"Program fit · розвиток бізнесу",decision:"Рішення / follow-up",enrolled:"Зарахований",activeLearner:"Активний учасник",completed:"Завершив / alumni",renewal:"Renewal / наступна програма",learner360:"Картка учасника",source:"Джерело ліда, менеджер і консультація",progress:"Прогрес за модулями та відвідування",assignments:"Домашні завдання і reviewer feedback",baseline:"Business KPI baseline / before → after",retention:"Завершення, feedback, наступна програма, клуб",delivery:"Навчальний delivery",cohorts:"Потоки / cohorts",lessons:"Уроки та записи",weekly:"Щотижневі розбори",privateGroup:"Закрита / private group",nextAction:"Наступна дія по кожному учаснику",marketingCopy:"Канал → organic baseline → paid learning → validated offer → lead → consultation → sale. Фінансові показники не вигадуються: вони з’являються після підключення реальних витрат і CRM revenue.",salesControl:"Sales plan + CRM reporting",salesPlan:"План vs факт по менеджеру, консультаціях, угодах і revenue — лише з реальних CRM даних.",crmReporting:"Щотижневий CRM report: source → stage → next action → outcome reason.",hiring:"Команда академії",hiringCopy:"Recruiting зберігається окремо від learner progression та не перетворює навчальні оцінки на автоматичні кадрові рішення.",accessTitle:"Одна Academy CRM — різні робочі ролі.",accessState:"Product structure · permission backend pending",accessCopy:"Власник бачить весь бізнес-контур. Команді потрібен мінімально необхідний доступ за модулем: marketing не отримує приватні HR-рішення, sales не отримує reviewer power, а reviewer не отримує фінансові або кадрові права автоматично.",roleOwner:"Власник",roleOwnerCopy:"Business settings · programs · teams · reports · final approvals.",roleAdmin:"Адміністратор",roleAdminCopy:"Workspace configuration and approved operating support.",roleMarketingCopy:"Campaigns · content attribution · funnel · KPI inputs.",roleSalesCopy:"Leads · diagnostics · consultations · deals · next actions.",roleHrCopy:"Vacancies · candidate stages · assessment templates · human decisions.",roleCurator:"Куратор",roleCuratorCopy:"Cohorts · attendance · assignments · participant follow-up.",roleReviewerCopy:"Evidence review only within authorized program scope.",roleReadonly:"Тільки перегляд",roleReadonlyCopy:"Selected dashboards and reports without operational writes.",accessBoundary:"Це цільова permission-модель для Academy Business. На поточній demo-стадії вона не заявляється як повністю активований multi-user RBAC: реальні team memberships і company-scoped permissions мають бути підключені окремо перед зберіганням client staff/candidate data.",acquisitionTitle:"Organic baseline → paid learning → offer hypothesis → consultation → program.",acquisitionCopy:"До offer-test CRM зберігає source asset, organic/paid state, campaign, content hypothesis і baseline. Offer/CTA стає робочою гіпотезою тільки після organic + paid learning gate; після lead додаються pain, diagnostic gap, recommended module і next action.",acqSource:"Джерело",acqOffer:"Observed CTA / hypothesis",acqGap:"Diagnostic gap",acqModule:"Рекомендований модуль",acqNext:"Наступна дія",acquisitionBoundary:"Рядки вище — публічно спостережувані CTA / hypotheses для демонстрації attribution, а не рекомендація запускати їх зараз і не реальні leads КНБ. До offer/funnel потрібні internal analytics, organic baseline і paid learning; revenue/conversion з’являються тільки з дозволених реальних джерел.",proofTitle:"Контроль доказів для marketing, site і sales.",proofCopy:"Кожен публічний result claim має source, observed_at, definition, evidence owner, approved wording і review date. Якщо джерела конфліктують, система не обирає цифру автоматично — статус переходить у Needs review.",proofClaim:"Claim",proofSource:"Source",proofState:"State",proofNext:"Наступна дія",proofBoundary:"Це governance-demo, а не висновок про достовірність конкретної client claim. Canonical wording затверджує уповноважена людина після evidence review.",programPortfolio:"Портфель програм і потоки",configurable:"Налаштовується",programPortfolioCopy:"Кожна програма має свій sales fit, ціну після підключення billing, потоки, уроки, assignments, reviewer flow, completion і наступну пропозицію.",programCatalog:"Каталог програм",programCatalogCopy:"Назва · формат · тривалість · eligibility",cohortPlanning:"Планування cohort",cohortPlanningCopy:"Старт · capacity · owner · schedule",enrollment:"Enrollment",enrollmentCopy:"Deal → learner → cohort",deliveryReview:"Delivery & review",deliveryReviewCopy:"Lessons · evidence · feedback",completionRenewal:"Completion & renewal",completionRenewalCopy:"Alumni · club · next program",salesHierarchy:"Багаторівнева sales-структура",salesHierarchyCopy:"CRM підтримує до чотирьох рівнів sales-management для бізнесів, яким це потрібно. Назви ролей і права задає сам бізнес — структура не створює кадрові рішення автоматично.",levelRole:"Роль бізнесу",levelMetrics:"Plan · conversion · next action",kpiDictionary:"Спочатку визначення метрики — потім цифра.",kpiDictionaryCopy:"Шаблон готовий до фінансових і комерційних показників, але значення залишаються порожніми, доки не підключене надійне джерело.",assessmentTitle:"Тестові завдання кандидатів — окремо від навчання студентів.",assessmentTemplate:"Шаблон · Marketing",assessmentCopy:"HR може створювати багаторазові assessment templates для конкретної ролі. Кандидат отримує brief, deadline, джерела, формат здачі та rubric; reviewer оцінює evidence, мислення й виконання, а фінальне кадрове рішення залишається за людиною.",assessmentClient:"Client / role",assessmentDeadline:"Deadline",assessmentFormat:"Submission",assessmentReady:"Template ready",trainingMethodTitle:"Метод 4 колонок перед написанням контенту",trainingMethodCopy:"Спочатку заповнюємо 2–4, потім повертаємося до 1: Питання → Усвідомлення → Розуміння → Застосування.",trainingCol1:"1 · Спочатку порожньо → наводящі питання",trainingCol2:"2 · Усвідомлення",trainingCol3:"3 · Розуміння",trainingCol4:"4 · Застосування",assessmentTask1:"Аналіз соціальної мережі",assessmentTask1Copy:"Оберіть будь-яку соцмережу бізнесу, зробіть короткий аудит і сформулюйте, що б ви впровадили одразу як керівник напряму та які шляхи розвитку бачите.",assessmentTask2:"Воронка продажу програми",assessmentTask2Copy:"Оригінальний brief просить funnel + offer для 7-тижневої програми. Сильна відповідь спочатку має довести readiness: які internal Meta/CRM data потрібні, як підняти organic baseline, як провести paid learning на winners, і лише після цього показати offer як hypothesis та майбутню funnel-схему.",rubric1:"1 · Evidence & diagnosis",rubric1Copy:"Чи спирається висновок на факти, контент і метрики, а не на загальні фрази.",rubric2:"2 · Audience & positioning",rubric2Copy:"Чи зрозуміло, кому продаємо, яку проблему вирішуємо і чому це важливо.",rubric3:"3 · Sequence / funnel logic",rubric3Copy:"Чи не пропущені organic baseline і paid-learning gate перед offer/funnel; чи downstream handoff вимірюваний.",rubric4:"4 · Readiness & offer hypothesis",rubric4Copy:"Чи кандидат відрізняє public audit від validated offer і не запускає budget до достатнього signal.",rubric5:"5 · KPI & measurement",rubric5Copy:"Чи визначені conversion, CAC, LTV/retention, revenue attribution та критерій успіху.",rubric6:"6 · Execution thinking",rubric6Copy:"Чи можна з роботи зробити 3–6 month media plan: organic → paid learning → offer validation → scale, з owners, priorities і next actions.",assessmentDecision:"Decision · Pending human review",boundary:"Поки що операційні картки та показники на цій сторінці — демонстраційна структура vertical. Бізнес-профіль і Hermes-акаунт зберігаються реально; CRM-модулі активуються поетапно без підміни demo-даних реальними."},
    en:{back:"← Hermes Connect",loading:"Loading your workspace…",loadingCopy:"Checking your Hermes account and education-business profile.",ownerWorkspace:"Owner workspace",crm:"Academy CRM",heroCopy:"CRM adapted to an education business: program sales, learners, cohorts, learning, assignments, reviews, marketing, HR, and repeat sales in one pipeline.",openPipeline:"Open sales pipeline",catalogProfile:"Catalog profile",settings:"Business settings",logout:"Log out",vertical:"Academy vertical",different:"Not a universal CRM.",differentCopy:"Repair Shops get appointments, vehicles, and shop scheduling. Academy gets leads, consultations, learners, cohorts, lessons, assignments, reviews, and retention. Hermes identity stays shared while workflow changes by vertical.",leads:"New leads",consultations:"Consultations",learners:"Active learners",review:"Awaiting review",sample:"demo data",realOnly:"real data only",pipeline:"Lead → consultation → program → enrollment → learning → renewal",sampleBoard:"Demo board",newLead:"New lead",qualified:"Qualified",need:"Need: sales systemization",consultBooked:"Consultation booked",consultDone:"Consultation completed",programSelected:"Program selected",programFit:"Program fit · business growth",decision:"Decision / follow-up",enrolled:"Enrolled",activeLearner:"Active learner",completed:"Completed / alumni",renewal:"Renewal / next program",learner360:"Learner 360",source:"Lead source, manager, and consultation",progress:"Module progress and attendance",assignments:"Assignments and reviewer feedback",baseline:"Business KPI baseline / before → after",retention:"Completion, feedback, next program, club",delivery:"Learning delivery",cohorts:"Cohorts",lessons:"Lessons and recordings",weekly:"Weekly reviews",privateGroup:"Private group",nextAction:"Next action for every learner",marketingCopy:"Channel → organic baseline → paid learning → validated offer → lead → consultation → sale. Financial metrics are never fabricated; they appear after real spend and CRM revenue are connected.",salesControl:"Sales plan + CRM reporting",salesPlan:"Plan vs actual by manager, consultations, deals, and revenue — only from real CRM data.",crmReporting:"Weekly CRM report: source → stage → next action → outcome reason.",hiring:"Academy team",hiringCopy:"Recruiting stays separate from learner progression and does not turn learning scores into automated employment decisions.",accessTitle:"One Academy CRM — different working roles.",accessState:"Product structure · permission backend pending",accessCopy:"The owner sees the full business system. Team members should receive only the minimum module access they need: marketing does not inherit private HR decisions, sales does not inherit reviewer power, and reviewers do not automatically receive financial or employment permissions.",roleOwner:"Owner",roleOwnerCopy:"Business settings · programs · teams · reports · final approvals.",roleAdmin:"Administrator",roleAdminCopy:"Workspace configuration and approved operating support.",roleMarketingCopy:"Campaigns · content attribution · funnel · KPI inputs.",roleSalesCopy:"Leads · diagnostics · consultations · deals · next actions.",roleHrCopy:"Vacancies · candidate stages · assessment templates · human decisions.",roleCurator:"Curator",roleCuratorCopy:"Cohorts · attendance · assignments · participant follow-up.",roleReviewerCopy:"Evidence review only within authorized program scope.",roleReadonly:"Read only",roleReadonlyCopy:"Selected dashboards and reports without operational writes.",accessBoundary:"This is the target permission model for Academy Business. At the current demo stage it is not presented as fully activated multi-user RBAC: real team memberships and company-scoped permissions must be connected separately before storing client staff or candidate data.",acquisitionTitle:"Organic baseline → paid learning → offer hypothesis → consultation → program.",acquisitionCopy:"Before offer testing, CRM keeps the source asset, organic/paid state, campaign, content hypothesis, and baseline. Offer/CTA becomes a working hypothesis only after the organic + paid-learning gate; once a lead exists, add pain, diagnostic gap, recommended module, and next action.",acqSource:"Source",acqOffer:"Observed CTA / hypothesis",acqGap:"Diagnostic gap",acqModule:"Recommended module",acqNext:"Next action",acquisitionBoundary:"The rows above are publicly observed CTA/hypotheses for attribution demonstration, not a recommendation to launch them now and not real KNB leads. Offer/funnel testing requires internal analytics, an organic baseline, and paid learning first; revenue/conversion appears only from permitted real sources.",proofTitle:"Evidence control for marketing, site, and sales.",proofCopy:"Every public result claim keeps source, observed_at, definition, evidence owner, approved wording, and review date. When sources conflict, the system does not choose a number automatically; the state becomes Needs review.",proofClaim:"Claim",proofSource:"Source",proofState:"State",proofNext:"Next action",proofBoundary:"This is a governance demo, not a conclusion about whether a specific client claim is true. Canonical wording is approved by an authorized human after evidence review.",programPortfolio:"Program portfolio & cohorts",configurable:"Configurable",programPortfolioCopy:"Each program can have its own sales fit, price after billing is connected, cohorts, lessons, assignments, reviewer flow, completion, and next offer.",programCatalog:"Program catalog",programCatalogCopy:"Name · format · duration · eligibility",cohortPlanning:"Cohort planning",cohortPlanningCopy:"Start · capacity · owner · schedule",enrollment:"Enrollment",enrollmentCopy:"Deal → learner → cohort",deliveryReview:"Delivery & review",deliveryReviewCopy:"Lessons · evidence · feedback",completionRenewal:"Completion & renewal",completionRenewalCopy:"Alumni · club · next program",salesHierarchy:"Multi-level sales structure",salesHierarchyCopy:"CRM supports up to four sales-management levels for businesses that need them. Role names and permissions are defined by the business; the structure does not automate employment decisions.",levelRole:"Business-defined role",levelMetrics:"Plan · conversion · next action",kpiDictionary:"Define the metric before showing a number.",kpiDictionaryCopy:"The template is ready for financial and commercial KPI, but values stay blank until a trusted source is connected.",assessmentTitle:"Candidate test assignments stay separate from learner education.",assessmentTemplate:"Template · Marketing",assessmentCopy:"HR can create reusable assessment templates for a specific role. The candidate receives the brief, deadline, sources, submission format and rubric; a reviewer scores evidence, thinking and execution, while the final employment decision remains human.",assessmentClient:"Client / role",assessmentDeadline:"Deadline",assessmentFormat:"Submission",assessmentReady:"Template ready",trainingMethodTitle:"Four-column method before writing content",trainingMethodCopy:"Fill columns 2–4 first, then return to 1: Question → Awareness → Understanding → Application.",trainingCol1:"1 · Blank first → leading questions",trainingCol2:"2 · Awareness",trainingCol3:"3 · Understanding",trainingCol4:"4 · Application",assessmentTask1:"Social-channel analysis",assessmentTask1Copy:"Choose any business social channel, complete a concise audit, and explain what you would implement immediately as the channel lead and which growth paths you see.",assessmentTask2:"Program sales funnel",assessmentTask2Copy:"The original brief asks for a funnel + offer for the seven-week program. A strong answer first proves readiness: which internal Meta/CRM data is required, how to build the organic baseline, how to run paid learning on winners, and only then shows the offer as a hypothesis and a future funnel.",rubric1:"1 · Evidence & diagnosis",rubric1Copy:"Does the conclusion use observable facts, content and metrics rather than generic statements.",rubric2:"2 · Audience & positioning",rubric2Copy:"Is it clear who the offer is for, which problem it solves, and why it matters.",rubric3:"3 · Sequence / funnel logic",rubric3Copy:"Are the organic baseline and paid-learning gate preserved before offer/funnel, with a measurable downstream handoff.",rubric4:"4 · Readiness & offer hypothesis",rubric4Copy:"Does the candidate distinguish a public audit from a validated offer and avoid spending budget before sufficient signal.",rubric5:"5 · KPI & measurement",rubric5Copy:"Are conversion, CAC, LTV/retention, revenue attribution and success criteria defined.",rubric6:"6 · Execution thinking",rubric6Copy:"Can the work become a 3–6 month media plan: organic → paid learning → offer validation → scale, with owners, priorities, and next actions.",assessmentDecision:"Decision · Pending human review",boundary:"For now, operating cards and metrics on this page are a vertical demo structure. The business profile and Hermes identity are persisted; CRM modules are activated incrementally without presenting demo data as real."}
  } as const;
  type Lang=keyof typeof dict;
  const params=new URLSearchParams(location.search);let lang:Lang=params.get("lang")==="en"?"en":"uk";
  const apply=(next:Lang)=>{lang=next;document.documentElement.lang=next;try{localStorage.setItem("hermes-connect-language",next)}catch{};document.querySelectorAll<HTMLAnchorElement>('a[href^="/services/hermes-connect/"]').forEach(link=>{const url=new URL(link.getAttribute("href")||"/",window.location.origin);url.searchParams.set("lang",next);link.href=url.pathname+url.search+url.hash;});document.querySelectorAll<HTMLElement>("[data-i18n]").forEach(n=>{const k=n.dataset.i18n as keyof typeof dict.uk;const v=dict[next][k];if(v)n.textContent=v});document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach(b=>b.classList.toggle("active",b.dataset.lang===next));};
  document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach(b=>b.addEventListener("click",()=>{const next:Lang=b.dataset.lang==="en"?"en":"uk";const url=new URL(window.location.href);url.searchParams.set("lang",next);window.location.assign(url.pathname+url.search+url.hash);}));apply(lang);

  const loading=document.querySelector<HTMLElement>("[data-workspace-loading]");const content=document.querySelector<HTMLElement>("[data-workspace-content]");const alert=document.querySelector<HTMLElement>("[data-workspace-alert]");
  const json=async(url:string,options:RequestInit={})=>{const r=await fetch(url,{...options,headers:{Accept:"application/json",...(options.headers||{})},credentials:"same-origin",cache:"no-store"});const p=await r.json().catch(()=>({}));if(!r.ok)throw Object.assign(new Error(p.error||`request_${r.status}`),{status:r.status,payload:p});return p;};
  const fail=(message:string)=>{if(alert){alert.textContent=message;alert.className="academy-app-alert show error";}};
  const money=(cents:number|null|undefined,currency:string|null|undefined)=>{
    const code=String(currency||"").toUpperCase();
    if(cents===null||cents===undefined||!/^[A-Z]{3}$/.test(code))return "—";
    try{return new Intl.NumberFormat(lang==="uk"?"uk-UA":"en-US",{style:"currency",currency:code}).format(Number(cents)/100);}
    catch{return `${(Number(cents)/100).toFixed(2)} ${code}`;}
  };
  const revenueLabel=(metrics:any)=>{
    const rows=Array.isArray(metrics?.revenueByCurrency)?metrics.revenueByCurrency:[];
    if(!rows.length)return "—";
    return rows.map((row:any)=>money(Number(row.cents),row.currency)).join(" · ");
  };
  const renderCrmCore=(state:any)=>{
    const metrics=state?.metrics||{};
    document.querySelectorAll<HTMLElement>("[data-crm-metric]").forEach(node=>{const key=node.dataset.crmMetric||"";node.textContent=Number.isFinite(Number(metrics[key]))?String(metrics[key]):"—";});
    const revenue=document.querySelector<HTMLElement>("[data-crm-revenue]");
    if(revenue)revenue.textContent=revenueLabel(metrics);
    const revenueKpi=document.querySelector<HTMLElement>('[data-live-kpi="revenue"]');
    if(revenueKpi)revenueKpi.textContent=revenueLabel(metrics);
    const target=document.querySelector<HTMLElement>("[data-crm-recent]");
    if(!target)return;
    const leads=Array.isArray(state?.recentLeads)?state.recentLeads:[];
    if(!leads.length){target.innerHTML="<p>CRM Core поки не має реальних lead-записів.</p>";return;}
    target.replaceChildren(...leads.map((lead:any)=>{
      const article=document.createElement("article");
      const strong=document.createElement("strong");strong.textContent=lead.contactName||"Lead";
      const meta=document.createElement("small");meta.textContent=[lead.sourceChannel||"direct",lead.businessStage||"new",lead.consultationStatus||"not_scheduled"].join(" · ");
      const next=document.createElement("span");next.textContent=lead.nextAction?"Next: "+lead.nextAction:"Next action: —";
      article.append(strong,meta,next);
      return article;
    }));
  };
  const loadCrmCore=async()=>{const state=await json("/api/hermes-connect/academy/crm?module=dashboard");renderCrmCore(state);};
  document.querySelector<HTMLFormElement>("[data-crm-lead-form]")?.addEventListener("submit",async(event)=>{
    event.preventDefault();
    const form=event.currentTarget as HTMLFormElement;
    const status=document.querySelector<HTMLElement>("[data-crm-form-status]");
    const values=Object.fromEntries(new FormData(form).entries());
    if(status){status.textContent="Зберігаємо…";status.className="academy-crm-core-status";}
    try{
      await json("/api/hermes-connect/academy/crm",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"create_lead",...values})});
      form.reset();
      if(status){status.textContent="Lead збережено і перечитано з CRM.";status.className="academy-crm-core-status ok";}
      await Promise.all([loadCrmCore(),loadProgramsCohorts(),loadMeasurement(),loadParticipants()]);
    }catch(error:any){
      const detail=Array.isArray(error?.payload?.errors)?error.payload.errors.join(", "):String(error?.message||"crm_save_failed");
      if(status){status.textContent=detail;status.className="academy-crm-core-status error";}
    }
  });

  const renderMeasurement=(state:any)=>{
    const measurement=state?.measurement||{};
    const economics=Array.isArray(measurement.economics)?measurement.economics:[];
    const records=Array.isArray(state?.recentEvidence)?state.recentEvidence:[];
    const economicsTarget=document.querySelector<HTMLElement>("[data-measurement-economics]");
    if(economicsTarget){
      if(!economics.length)economicsTarget.innerHTML="<p>No source-gated paid economics yet / Доказаних paid economics ще немає.</p>";
      else economicsTarget.replaceChildren(...economics.map((item:any)=>{
        const article=document.createElement("article");
        const title=document.createElement("strong");
        title.textContent=[item.sourceChannel||"source",item.campaignId||"",item.contentId||""].filter(Boolean).join(" · ");
        const scope=document.createElement("small");
        scope.textContent=[item.periodStart||"period ?",item.periodEnd||"?",item.currency||""].filter(Boolean).join(" → ");
        const values=document.createElement("span");
        const cac=item.cacCents===null||item.cacCents===undefined?"CAC: UNKNOWN":"CAC: "+money(item.cacCents,item.currency);
        const revenue=item.revenueCents===null||item.revenueCents===undefined?"Revenue: UNKNOWN":"Revenue: "+money(item.revenueCents,item.currency);
        const romi=item.romiRatio===null||item.romiRatio===undefined?"ROMI: UNKNOWN":"ROMI: "+(Number(item.romiRatio)*100).toFixed(1)+"%";
        values.textContent=`${cac} · ${revenue} · ${romi}`;
        article.append(title,scope,values);return article;
      }));
    }
    const recordsTarget=document.querySelector<HTMLElement>("[data-measurement-records]");
    if(recordsTarget){
      if(!records.length)recordsTarget.innerHTML="<p>No persisted evidence yet / Доказів ще немає.</p>";
      else recordsTarget.replaceChildren(...records.slice(0,20).map((item:any)=>{
        const article=document.createElement("article");
        const title=document.createElement("strong");title.textContent=item.kind||"evidence";
        const meta=document.createElement("small");
        meta.textContent=[item.sourceChannel||"",item.campaignId||"",item.claimState||"",item.observedAt||""].filter(Boolean).join(" · ");
        const definition=document.createElement("span");definition.textContent=item.approvedWording||item.claimText||item.definition||item.sourceRef||"";
        article.append(title,meta,definition);return article;
      }));
    }
    const cac=document.querySelector<HTMLElement>('[data-live-kpi="cac"]');
    const romi=document.querySelector<HTMLElement>('[data-live-kpi="romi"]');
    const ltv=document.querySelector<HTMLElement>('[data-live-kpi="ltv"]');
    const one=economics.length===1?economics[0]:null;
    if(cac)cac.textContent=one&&one.cacCents!==null?money(one.cacCents,one.currency):(economics.length>1?"MULTI":"—");
    if(romi)romi.textContent=one&&one.romiRatio!==null?(Number(one.romiRatio)*100).toFixed(1)+"%":(economics.length>1?"MULTI":"—");
    const ltvRows=Array.isArray(measurement.ltvEvidence)?measurement.ltvEvidence:[];
    if(ltv)ltv.textContent=ltvRows.length===1?money(ltvRows[0].amountCents,ltvRows[0].currency):(ltvRows.length>1?"MULTI":"—");
  };
  const loadMeasurement=async()=>{const state=await json("/api/hermes-connect/academy/measurement?module=dashboard");renderMeasurement(state);};
  document.querySelector<HTMLFormElement>("[data-measurement-form]")?.addEventListener("submit",async(event)=>{
    event.preventDefault();
    const form=event.currentTarget as HTMLFormElement;
    const status=document.querySelector<HTMLElement>("[data-measurement-status]");
    const values:any=Object.fromEntries(new FormData(form).entries());
    const amountMajor=String(values.amountMajor||"").trim();
    delete values.amountMajor;
    if(amountMajor){
      const parsed=Number(amountMajor);
      if(!Number.isFinite(parsed)||parsed<0){if(status){status.textContent="Invalid money amount";status.className="academy-crm-core-status error";}return;}
      values.amountCents=Math.round(parsed*100);
    }
    for(const key of ["metricValue","sourceChannel","campaignId","contentId","metricKey","metricUnit","currency","periodStart","periodEnd","claimText","approvedWording","reviewAt"]){
      if(values[key]==="")delete values[key];
    }
    if(status){status.textContent="Saving evidence…";status.className="academy-crm-core-status";}
    try{
      await json("/api/hermes-connect/academy/measurement",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"create_evidence",...values})});
      form.reset();
      const observed=form.querySelector<HTMLInputElement>('[name="observedAt"]');
      if(observed){const now=new Date();observed.value=new Date(now.getTime()-now.getTimezoneOffset()*60000).toISOString().slice(0,16);}
      if(status){status.textContent="Evidence saved and reread.";status.className="academy-crm-core-status ok";}
      await Promise.all([loadMeasurement(),loadCrmCore()]);
    }catch(error:any){
      const detail=Array.isArray(error?.payload?.errors)?error.payload.errors.join(", "):String(error?.message||"evidence_save_failed");
      if(status){status.textContent=detail;status.className="academy-crm-core-status error";}
    }
  });
  const setMeasurementObservedNow=()=>{
    const observed=document.querySelector<HTMLInputElement>('[data-measurement-form] [name="observedAt"]');
    if(!observed||observed.value)return;
    const now=new Date();observed.value=new Date(now.getTime()-now.getTimezoneOffset()*60000).toISOString().slice(0,16);
  };
  setMeasurementObservedNow();

  const assessmentTemplateSelect=()=>document.querySelector<HTMLSelectElement>("[data-assessment-template-select]");
  const assessmentReviewSelect=()=>document.querySelector<HTMLSelectElement>("[data-assessment-review-select]");
  const renderAssessments=(state:any)=>{
    const templates=Array.isArray(state?.templates)?state.templates:[];
    const assignments=Array.isArray(state?.assignments)?state.assignments:[];
    const templateSelect=assessmentTemplateSelect();
    if(templateSelect){
      const current=templateSelect.value;
      templateSelect.replaceChildren(new Option("Select template",""),...templates.map((item:any)=>new Option(`${item.title||"Template"} · ${item.roleTitle||"Role"}`,item.id)));
      if(templates.some((item:any)=>item.id===current))templateSelect.value=current;
    }
    const reviewSelect=assessmentReviewSelect();
    if(reviewSelect){
      const current=reviewSelect.value;
      const reviewable=assignments.filter((item:any)=>["submitted","reviewed"].includes(String(item.state)));
      reviewSelect.replaceChildren(new Option("Select submitted assignment",""),...reviewable.map((item:any)=>new Option(`${item.id.slice(-8)} · ${item.state} · ${item.candidateId||"candidate"}`,item.id)));
      if(reviewable.some((item:any)=>item.id===current))reviewSelect.value=current;
    }
    const templateTarget=document.querySelector<HTMLElement>("[data-assessment-template-list]");
    if(templateTarget){
      if(!templates.length)templateTarget.innerHTML="<p>No persisted assessment templates yet.</p>";
      else templateTarget.replaceChildren(...templates.map((item:any)=>{
        const article=document.createElement("article");
        const title=document.createElement("strong");title.textContent=item.title||"Template";
        const meta=document.createElement("small");meta.textContent=[item.roleTitle||"",item.submissionFormat||"",item.rubricVersion||""].filter(Boolean).join(" · ");
        const brief=document.createElement("span");brief.textContent=item.brief||"";
        article.append(title,meta,brief);return article;
      }));
    }
    const assignmentTarget=document.querySelector<HTMLElement>("[data-assessment-assignment-list]");
    if(assignmentTarget){
      if(!assignments.length)assignmentTarget.innerHTML="<p>No persisted assessment assignments yet.</p>";
      else assignmentTarget.replaceChildren(...assignments.map((item:any)=>{
        const article=document.createElement("article");
        const title=document.createElement("strong");title.textContent=`${item.state||"issued"} · ${item.id.slice(-8)}`;
        const meta=document.createElement("small");meta.textContent=`Deadline: ${item.deadlineAt||"UNKNOWN"} · Candidate: ${item.candidateId||"UNCLAIMED"}`;
        const detail=document.createElement("span");
        if(item.review)detail.textContent=`Human score: ${item.review.totalScore}/30 · ${item.review.decision}`;
        else if(item.submission)detail.textContent="Submission received · human review pending";
        else detail.textContent="Waiting for explicit candidate claim/submission";
        article.append(title,meta,detail);return article;
      }));
    }
  };
  const loadAssessments=async()=>{const state=await json("/api/hermes-connect/academy/assessments?module=dashboard");renderAssessments(state);};

  document.querySelector<HTMLFormElement>("[data-assessment-template-form]")?.addEventListener("submit",async(event)=>{
    event.preventDefault();
    const form=event.currentTarget as HTMLFormElement;
    const status=form.querySelector<HTMLElement>("[data-assessment-template-status]");
    const values:any=Object.fromEntries(new FormData(form).entries());
    const sources=String(values.sourcesText||"").split(/[\n,]+/).map((value)=>value.trim()).filter(Boolean);
    delete values.sourcesText;
    if(status)status.textContent="Saving template…";
    try{
      await json("/api/hermes-connect/academy/assessments",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"create_template",...values,sources})});
      form.reset();if(status)status.textContent="Template saved.";await loadAssessments();
    }catch(error:any){if(status)status.textContent=Array.isArray(error?.payload?.errors)?error.payload.errors.join(", "):String(error?.message||"assessment_template_failed");}
  });

  document.querySelector<HTMLFormElement>("[data-assessment-assignment-form]")?.addEventListener("submit",async(event)=>{
    event.preventDefault();
    const form=event.currentTarget as HTMLFormElement;
    const status=form.querySelector<HTMLElement>("[data-assessment-assignment-status]");
    const secret=form.querySelector<HTMLElement>("[data-assessment-assignment-secret]");
    const values:any=Object.fromEntries(new FormData(form).entries());
    if(status)status.textContent="Creating assignment…";
    if(secret){secret.hidden=true;secret.textContent="";}
    try{
      const result=await json("/api/hermes-connect/academy/assessments",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"create_assignment",...values})});
      if(status)status.textContent="Assignment created. Copy the token now — it is returned once.";
      if(secret){secret.hidden=false;secret.textContent=`Assignment ID: ${result.assignment.id}\nOne-time token: ${result.assignmentToken}`;}
      form.reset();await loadAssessments();
    }catch(error:any){if(status)status.textContent=Array.isArray(error?.payload?.errors)?error.payload.errors.join(", "):String(error?.message||"assessment_assignment_failed");}
  });

  document.querySelector<HTMLFormElement>("[data-assessment-review-form]")?.addEventListener("submit",async(event)=>{
    event.preventDefault();
    const form=event.currentTarget as HTMLFormElement;
    const status=form.querySelector<HTMLElement>("[data-assessment-review-status]");
    const values:any=Object.fromEntries(new FormData(form).entries());
    const scoreKeys=["evidence_diagnosis","audience_positioning","funnel_logic","readiness_offer","kpi_measurement","execution_thinking"];
    const scores:any={};for(const key of scoreKeys){scores[key]=Number(values[key]);delete values[key];}
    if(status)status.textContent="Recording human review…";
    try{
      const result=await json("/api/hermes-connect/academy/assessments",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"review_submission",...values,scores})});
      form.reset();if(status)status.textContent=`Human review saved · ${result.assignment?.review?.totalScore??"—"}/30`;await loadAssessments();
    }catch(error:any){if(status)status.textContent=Array.isArray(error?.payload?.errors)?error.payload.errors.join(", "):String(error?.message||"assessment_review_failed");}
  });

      const programSelect=()=>document.querySelector<HTMLSelectElement>("[data-academy-program-select]");
  const renderProgramsCohorts=(state:any)=>{
    const programs=Array.isArray(state?.programs)?state.programs:[];
    const cohorts=Array.isArray(state?.cohorts)?state.cohorts:[];
    const select=programSelect();
    if(select){
      const current=select.value;
      select.replaceChildren(new Option("Select program",""),...programs.map((p:any)=>new Option(p.name||"Program",p.id)));
      if(programs.some((p:any)=>p.id===current))select.value=current;
    }
    const programTarget=document.querySelector<HTMLElement>("[data-academy-program-list]");
    if(programTarget){
      if(!programs.length){programTarget.innerHTML="<p>No persisted programs yet / Програм ще немає.</p>";}
      else programTarget.replaceChildren(...programs.map((p:any)=>{
        const article=document.createElement("article");
        const title=document.createElement("strong");title.textContent=p.name||"Program";
        const meta=document.createElement("small");meta.textContent=[p.status||"draft",p.formatText||"format —",p.durationText||"duration —"].join(" · ");
        const price=document.createElement("span");price.textContent=p.priceCents===null?"Price: UNKNOWN":"Price: "+(Number(p.priceCents||0)/100).toFixed(2)+(p.currency?" "+p.currency:"");
        article.append(title,meta,price);return article;
      }));
    }
    const cohortTarget=document.querySelector<HTMLElement>("[data-academy-cohort-list]");
    if(cohortTarget){
      if(!cohorts.length){cohortTarget.innerHTML="<p>No persisted cohorts yet / Потоків ще немає.</p>";}
      else cohortTarget.replaceChildren(...cohorts.map((c:any)=>{
        const article=document.createElement("article");
        const title=document.createElement("strong");title.textContent=c.name||"Cohort";
        const meta=document.createElement("small");meta.textContent=[c.programName||"Program",c.status||"planned",c.code||""].filter(Boolean).join(" · ");
        const dates=document.createElement("span");dates.textContent="Start: "+(c.startDate||"UNKNOWN")+" · Capacity: "+(c.capacity??"UNKNOWN");
        article.append(title,meta,dates);return article;
      }));
    }
  };
  const renderParticipantBridge=(participantState:any,crmState:any,programState:any)=>{
    const invites=Array.isArray(participantState?.invites)?participantState.invites:[];
    const participants=Array.isArray(participantState?.participants)?participantState.participants:[];
    const leads=Array.isArray(crmState?.recentLeads)?crmState.recentLeads.filter((lead:any)=>["enrolled","active","completed","renewal"].includes(String(lead.businessStage))):[];
    const cohorts=Array.isArray(programState?.cohorts)?programState.cohorts.filter((cohort:any)=>["enrolling","active"].includes(String(cohort.status))):[];
    const leadSelect=document.querySelector<HTMLSelectElement>("[data-participant-lead-select]");
    if(leadSelect){
      const current=leadSelect.value;
      leadSelect.replaceChildren(new Option("Select enrolled lead",""),...leads.map((lead:any)=>new Option(`${lead.contactName||"Lead"} · ${lead.businessStage||""}`,lead.id)));
      if(leads.some((lead:any)=>lead.id===current))leadSelect.value=current;
    }
    const cohortSelect=document.querySelector<HTMLSelectElement>("[data-participant-cohort-select]");
    if(cohortSelect){
      const current=cohortSelect.value;
      cohortSelect.replaceChildren(new Option("Select enrolling / active cohort",""),...cohorts.map((cohort:any)=>{
        const option=new Option(`${cohort.programName||"Program"} · ${cohort.name||"Cohort"} · ${cohort.code||""}`,cohort.id);
        option.dataset.programId=cohort.programId||"";
        return option;
      }));
      if(cohorts.some((cohort:any)=>cohort.id===current))cohortSelect.value=current;
    }
    const inviteTarget=document.querySelector<HTMLElement>("[data-participant-invite-list]");
    if(inviteTarget){
      if(!invites.length)inviteTarget.innerHTML="<p>No participant invites yet.</p>";
      else inviteTarget.replaceChildren(...invites.slice(0,50).map((item:any)=>{
        const article=document.createElement("article");
        const title=document.createElement("strong");title.textContent=`${item.leadContactName||"Lead"} · ${item.state||"issued"}`;
        const meta=document.createElement("small");meta.textContent=[item.programName||"",item.cohortName||"",item.cohortCode||"",item.expiresAt||""].filter(Boolean).join(" · ");
        article.append(title,meta);return article;
      }));
    }
    const participantTarget=document.querySelector<HTMLElement>("[data-participant-list]");
    if(participantTarget){
      if(!participants.length)participantTarget.innerHTML="<p>No claimed participants yet.</p>";
      else participantTarget.replaceChildren(...participants.slice(0,100).map((item:any)=>{
        const article=document.createElement("article");
        const title=document.createElement("strong");title.textContent=`${item.leadContactName||"Participant"} · ${item.state||"enrolled"}`;
        const meta=document.createElement("small");meta.textContent=[item.programName||"",item.cohortName||"",item.cohortCode||"",item.specialistId||""].filter(Boolean).join(" · ");
        article.append(title,meta);return article;
      }));
    }
  };
  const loadParticipants=async()=>{
    const [participantState,crmState,programState]=await Promise.all([
      json("/api/hermes-connect/academy/participants"),
      json("/api/hermes-connect/academy/crm?module=dashboard"),
      json("/api/hermes-connect/academy/programs"),
    ]);
    renderParticipantBridge(participantState,crmState,programState);
  };
  const setParticipantExpiry=()=>{
    const input=document.querySelector<HTMLInputElement>('[data-participant-invite-form] [name="expiresAt"]');
    if(!input||input.value)return;
    const target=new Date(Date.now()+14*24*60*60*1000);
    input.value=new Date(target.getTime()-target.getTimezoneOffset()*60000).toISOString().slice(0,16);
  };
  setParticipantExpiry();
  document.querySelector<HTMLFormElement>("[data-participant-invite-form]")?.addEventListener("submit",async(event)=>{
    event.preventDefault();
    const form=event.currentTarget as HTMLFormElement;
    const status=form.querySelector<HTMLElement>("[data-participant-invite-status]");
    const secret=form.querySelector<HTMLElement>("[data-participant-invite-secret]");
    const values:any=Object.fromEntries(new FormData(form).entries());
    const cohortSelect=form.querySelector<HTMLSelectElement>('[name="cohortId"]');
    const selected=cohortSelect?.selectedOptions?.[0];
    values.programId=selected?.dataset?.programId||"";
    if(values.expiresAt)values.expiresAt=new Date(String(values.expiresAt)).toISOString();
    if(status)status.textContent="Creating invite…";
    if(secret){secret.hidden=true;secret.textContent="";}
    try{
      const result=await json("/api/hermes-connect/academy/participants",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"create_invite",...values})});
      if(status)status.textContent="Invite created. Copy the token now — it is returned once.";
      if(secret){secret.hidden=false;secret.textContent=`Invite ID: ${result.invite.id}\nOne-time token: ${result.inviteToken}`;}
      form.reset();setParticipantExpiry();await loadParticipants();
    }catch(error:any){
      const detail=Array.isArray(error?.payload?.errors)?error.payload.errors.join(", "):String(error?.payload?.error||error?.message||"participant_invite_failed");
      if(status)status.textContent=detail;
    }
  });

  const loadProgramsCohorts=async()=>{const state=await json("/api/hermes-connect/academy/programs");renderProgramsCohorts(state);};
  document.querySelector<HTMLFormElement>("[data-academy-program-form]")?.addEventListener("submit",async(event)=>{
    event.preventDefault();
    const form=event.currentTarget as HTMLFormElement;
    const status=document.querySelector<HTMLElement>("[data-academy-program-status]");
    const values=Object.fromEntries(new FormData(form).entries());
    const payload:any={action:"create_program",...values};
    if(!payload.priceCents)delete payload.priceCents;
    if(status)status.textContent="Saving / Зберігаємо…";
    try{
      await json("/api/hermes-connect/academy/programs",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
      form.reset();if(status)status.textContent="Saved / Збережено";await Promise.all([loadProgramsCohorts(),loadParticipants()]);
    }catch(error:any){if(status)status.textContent=Array.isArray(error?.payload?.errors)?error.payload.errors.join(", "):String(error?.message||"program_save_failed");}
  });
  document.querySelector<HTMLFormElement>("[data-academy-cohort-form]")?.addEventListener("submit",async(event)=>{
    event.preventDefault();
    const form=event.currentTarget as HTMLFormElement;
    const status=document.querySelector<HTMLElement>("[data-academy-cohort-status]");
    const values=Object.fromEntries(new FormData(form).entries());
    const payload:any={action:"create_cohort",...values};
    if(!payload.capacity)delete payload.capacity;
    if(!payload.startDate)delete payload.startDate;
    if(!payload.endDate)delete payload.endDate;
    if(status)status.textContent="Saving / Зберігаємо…";
    try{
      await json("/api/hermes-connect/academy/programs",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
      const selected=String(values.programId||"");form.reset();if(programSelect())programSelect()!.value=selected;
      if(status)status.textContent="Saved / Збережено";await Promise.all([loadProgramsCohorts(),loadParticipants()]);
    }catch(error:any){if(status)status.textContent=Array.isArray(error?.payload?.errors)?error.payload.errors.join(", "):String(error?.message||"cohort_save_failed");}
  });

  void(async()=>{
    try{
      await json("/api/auth/me");
      const state=await json("/api/hermes-connect/academy/business");
      if(!state.academyBusiness){location.assign("/services/hermes-connect/academy/business/auth/?mode=register");return;}
      const b=state.academyBusiness;const name=document.querySelector<HTMLElement>("[data-business-name]");if(name)name.textContent=b.businessName||"Academy";
      const link=document.querySelector<HTMLAnchorElement>("[data-catalog-link]");if(link)link.href=b.catalogOptIn?`/businesses/connect/academy/${encodeURIComponent(b.slug)}/`:"/businesses/";
      loading?.classList.add("academy-app-hidden");content?.classList.remove("academy-app-hidden");
      await Promise.all([loadCrmCore(),loadProgramsCohorts(),loadMeasurement(),loadAssessments(),loadParticipants()]);
    }catch(error:any){if(error?.status===401){location.assign("/services/hermes-connect/academy/business/auth/?mode=login");return;}fail(String(error?.message||"Could not load workspace"));}
  })();
  document.querySelector<HTMLButtonElement>("[data-logout]")?.addEventListener("click",async()=>{await fetch("/api/auth/logout",{method:"POST",credentials:"same-origin"}).catch(()=>null);location.assign("/services/hermes-connect/academy/business/auth/?mode=login");});
</script>

<style>
  .academy-owner-toolbar{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:22px}.academy-owner-toolbar>a{font-weight:800;text-decoration:none}
  .academy-owner-lang{display:flex;border:1px solid rgba(148,163,184,.35);border-radius:999px;padding:3px;background:#fff}.academy-owner-lang button{border:0;background:transparent;border-radius:999px;padding:7px 10px;font-weight:900;cursor:pointer}.academy-owner-lang button.active{background:#111827;color:#fff}
