, "n3": " Ваша компанія стає власником доступу до Load Board.", "n4s": "Каталог.", "n4": " Якщо ви погодитесь, безпечна картка компанії може з’явитися в Каталозі Hermes до завершення перевірки.", "n5s": "Робота.", "n5": " Дилери та відправники самі керують своїми заявками. Перевізникам потрібні схвалення Hermes і призначений диспетчер, перш ніж запитувати вантажі.", "seeCatalog": "Відкрити Каталог Hermes →", "signedInAs": "Ви увійшли як {name}.", "hermesUser": "користувач Hermes", "createOrSign": "Створіть акаунт Hermes або увійдіть, щоб продовжити.", "googleSigning": "Безпечний вхід через Google…", "googleCreated": "Акаунт Google підтверджено. Додайте компанію, щоб продовжити.", "googleVerified": "Акаунт Google підтверджено.", "e_existing_account_signin_required": "Для цього email уже є акаунт Hermes. Спершу увійдіть за паролем або email нижче, потім підключіть Google.", "e_provider_identity_conflict": "Цей акаунт Google уже підключено до іншого акаунта Hermes. Увійдіть через email нижче або зверніться до підтримки.", "googleFailed": "Не вдалося увійти через Google: {error}", "creating": "Створюємо акаунт Hermes…", "created": "Акаунт створено. Додайте компанію для перевірки за вашою роллю.", "emailTaken": "Для цього email уже є акаунт Hermes. Натисніть «Увійти».", "createFailed": "Не вдалося створити акаунт: {error}", "signing": "Входимо…", "signedIn": "Вхід виконано. Додайте або підтвердьте компанію.", "signFailed": "Не вдалося увійти: {error}", "saving": "Зберігаємо компанію та добираємо робочий простір…", "savedCatalog": "Компанію збережено в Каталозі Hermes, перевірка не завершена. Відкриваємо потрібний простір…", "saved": "Компанію збережено. Відкриваємо робочий простір…", "savedRestricted": "Компанію збережено. Вантажі лише для перевізників залишаються закритими до схвалення Hermes.", "saveFailed": "Не вдалося зберегти компанію: {error}", "googleAria": "Продовжити через Google", "badLogin": "Неправильний email або пароль.", "tryAgain": "Щось пішло не так. Спробуйте ще раз трохи згодом.", "phone": "Телефон для зворотного дзвінка", "phoneNote": "необов’язково · не публікується"}};
      const pickLang = () => {
        const wanted = (new URLSearchParams(location.search).get('lang') || '').toLowerCase();
        if (DICT[wanted]) return wanted;
        let stored = '';
        try { stored = localStorage.getItem('hermes-connect-language') || ''; } catch {}
        if (stored === 'ru' || stored === 'uk') return stored;
        return 'en';
      };
      const lang = pickLang();
      const T = (key, vars = {}) => String((DICT[lang] && DICT[lang][key]) || DICT.en[key] || key).replace(/\{(\w+)\}/g, (_, name) => vars[name] ?? '');
      document.documentElement.lang = lang;
      // The Connect chrome says this page is English-only; once translated that notice would be false.
      if (lang !== 'en') {
        const dropEnglishOnlyNotice = () => document.querySelectorAll('[data-hc-english-only]').forEach((node) => node.remove());
        dropEnglishOnlyNotice();
        // The shared Connect chrome adds the notice after DOM ready, so keep removing it briefly.
        const watcher = new MutationObserver(dropEnglishOnlyNotice);
        watcher.observe(document.documentElement, { childList: true, subtree: true });
        window.setTimeout(() => watcher.disconnect(), 6000);
      }
      document.querySelectorAll('[data-i18n]').forEach((node) => { node.textContent = T(node.dataset.i18n); });
      document.querySelectorAll('[data-i18n-aria]').forEach((node) => node.setAttribute('aria-label', T(node.dataset.i18nAria)));
      const authCard = document.querySelector('[data-auth-card]');
      const companyCard = document.querySelector('[data-company-card]');
      const authState = document.querySelector('[data-auth-state]');
      const authMessage = document.querySelector('[data-auth-message]');
      const companyMessage = document.querySelector('[data-company-message]');
      const registerForm = document.querySelector('[data-register-form]');
      const loginForm = document.querySelector('[data-login-form]');
      const companyForm = document.querySelector('[data-company-form]');
      const authTabs = document.querySelector('[data-auth-tabs]');
      const socialAuth = document.querySelector('[data-social-auth]');
      const googleButton = document.querySelector('[data-google-auth-button]');
      const tabs = [...document.querySelectorAll('[data-auth-tab]')];

      const message = (node, text, error = false) => {
        if (!(node instanceof HTMLElement)) return;
        node.textContent = text || '';
        node.dataset.error = error ? 'true' : 'false';
      };
      const json = async (url, options = {}) => {
        const response = await fetch(url, { ...options, headers: { Accept: 'application/json', 'Content-Type': 'application/json', ...(options.headers || {}) }, cache: 'no-store' });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw Object.assign(new Error(payload.error || payload.errors?.join(', ') || `request_${response.status}`), { status: response.status, payload });
        return payload;
      };
      const showCompany = async (specialist) => {
        // The read-only staff review path never creates a company record or grants privileges.
        if (new URLSearchParams(location.search).get("source")==="role-review") {
          window.location.assign("/services/hermes-connect/load-board/role-preview/");
          return;
        }
        if (authState) authState.textContent = T('signedInAs', { name: specialist?.name || specialist?.email || T('hermesUser') });
        if (authCard instanceof HTMLElement) authCard.classList.add('is-complete');
        if (authTabs instanceof HTMLElement) authTabs.hidden = true;
        if (socialAuth instanceof HTMLElement) socialAuth.hidden = true;
        if (registerForm instanceof HTMLElement) registerForm.hidden = true;
        if (loginForm instanceof HTMLElement) loginForm.hidden = true;
        if (companyCard instanceof HTMLElement) companyCard.hidden = false;
        try {
          const existing = await json('/api/hermes-connect/company');
          if (existing.company && companyForm instanceof HTMLFormElement) {
            for (const [key, value] of Object.entries({
              companyName: existing.company.companyName, companyType: existing.company.companyType,
              city: existing.company.city, state: existing.company.state, website: existing.company.website || '',
            })) {
              const input = companyForm.elements.namedItem(key);
              if (input && 'value' in input) input.value = String(value || '');
            }
            const opt = companyForm.elements.namedItem('catalogOptIn');
            if (opt instanceof HTMLInputElement) opt.checked = Boolean(existing.company.catalogOptIn);
          }
        } catch {}
        companyCard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      const loadGoogleIdentityScript = () => new Promise((resolve, reject) => {
        if (globalThis.google?.accounts?.id) return resolve(globalThis.google);
        const existing = document.querySelector('script[data-hermes-google-identity]');
        if (existing) {
          existing.addEventListener('load', () => resolve(globalThis.google), { once: true });
          existing.addEventListener('error', reject, { once: true });
          return;
        }
        const script = document.createElement('script');
        script.src = `https://accounts.google.com/gsi/client?hl=${lang}`;
        script.async = true;
        script.defer = true;
        script.dataset.hermesGoogleIdentity = '';
        script.addEventListener('load', () => resolve(globalThis.google), { once: true });
        script.addEventListener('error', reject, { once: true });
        document.head.appendChild(script);
      });

      const setupSocialAuth = async () => {
        try {
          const providers = await json('/api/auth/providers');
          if (!providers?.google?.enabled || !providers.google.client_id || !(googleButton instanceof HTMLElement)) return;
          await loadGoogleIdentityScript();
          if (!globalThis.google?.accounts?.id) return;
          if (socialAuth instanceof HTMLElement) socialAuth.hidden = false;
          globalThis.google.accounts.id.initialize({
            client_id: providers.google.client_id,
            auto_select: false,
            callback: async (response) => {
              const credential = String(response?.credential || '');
              if (!credential) return;
              message(authMessage, T('googleSigning'));
              try {
                const payload = await json('/api/auth/google', { method: 'POST', body: JSON.stringify({ credential }) });
                message(authMessage, payload.state === 'created' ? T('googleCreated') : T('googleVerified'));
                await showCompany(payload.specialist);
              } catch (error) {
                const refusal = ['existing_account_signin_required', 'provider_identity_conflict'].includes(error.message) ? T('e_' + error.message) : '';
                message(authMessage, refusal || T('googleFailed', { error: error.message }), true);
              }
            },
          });
          globalThis.google.accounts.id.renderButton(googleButton, {
            type: 'standard', theme: 'outline', size: 'large', text: 'continue_with', shape: 'rectangular', logo_alignment: 'left', width: 320, locale: lang,
          });
        } catch {
          // Social providers are optional. Email/password stays available if provider discovery or Google is unavailable.
        }
      };

      tabs.forEach((tab) => tab.addEventListener('click', () => {
        const mode = tab.getAttribute('data-auth-tab');
        tabs.forEach((item) => item.classList.toggle('is-active', item === tab));
        if (registerForm instanceof HTMLElement) registerForm.hidden = mode !== 'register';
        if (loginForm instanceof HTMLElement) loginForm.hidden = mode !== 'login';
        message(authMessage, '');
      }));

      registerForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(registerForm instanceof HTMLFormElement)) return;
        const data = new FormData(registerForm);
        const button = registerForm.querySelector('button[type="submit"]');
        if (button instanceof HTMLButtonElement) button.disabled = true;
        message(authMessage, T('creating'));
        try {
          const payload = await json('/api/auth/register', { method: 'POST', body: JSON.stringify({
            name: data.get('name'), email: data.get('email'), password: data.get('password'), role: data.get('role'), location: data.get('location'),
            bio: 'Hermes Connect Load Board access account for carrier operations and company registration.',
          }) });
          message(authMessage, T('created'));
          await showCompany(payload.specialist);
        } catch (error) {
          const text = error?.payload?.error === 'email_already_registered' ? T('emailTaken') : T('createFailed', { error: error.message });
          message(authMessage, text, true);
        } finally { if (button instanceof HTMLButtonElement) button.disabled = false; }
      });

      loginForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(loginForm instanceof HTMLFormElement)) return;
        const data = new FormData(loginForm);
        const button = loginForm.querySelector('button[type="submit"]');
        if (button instanceof HTMLButtonElement) button.disabled = true;
        message(authMessage, T('signing'));
        try {
          await json('/api/auth/login', { method: 'POST', body: JSON.stringify({ email: data.get('email'), password: data.get('password') }) });
          const me = await json('/api/auth/me');
          message(authMessage, T('signedIn'));
          await showCompany(me.specialist);
        } catch (error) { message(authMessage, error.status === 401 ? T('badLogin') : error.status >= 500 ? T('tryAgain') : T('signFailed', { error: error.message }), true); }
        finally { if (button instanceof HTMLButtonElement) button.disabled = false; }
      });

      companyForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(companyForm instanceof HTMLFormElement)) return;
        const data = new FormData(companyForm);
        const button = companyForm.querySelector('button[type="submit"]');
        if (button instanceof HTMLButtonElement) button.disabled = true;
        message(companyMessage, T('saving'));
        try {
          const payload = await json('/api/hermes-connect/company', { method: 'POST', body: JSON.stringify({
            companyName: data.get('companyName'), companyType: data.get('companyType'), city: data.get('city'), state: data.get('state'),
            website: data.get('website'), authorityNumber: data.get('authorityNumber'), callbackPhone: data.get('callbackPhone'), catalogOptIn: data.get('catalogOptIn') === 'on',
          }) });
          message(companyMessage, payload.catalog?.listed ? T('savedCatalog') : T('saved'));
          const companyType = String(data.get('companyType') || '');
          const sourceIntent = new URLSearchParams(window.location.search).get('source');
          const nextUrl = ['dealer','shipper'].includes(companyType)
            ? '/services/hermes-connect/load-board/partners/'
            : ['carrier','owner_operator','fleet'].includes(companyType)
              ? '/services/hermes-connect/load-board/carrier/'
              : (sourceIntent === 'post-load' ? '/load-board/?post=load#live-marketplace' : '/load-board/');
          message(companyMessage, T('savedRestricted'));
          window.location.assign(nextUrl);
        } catch (error) { message(companyMessage, T('saveFailed', { error: error.message }), true); }
        finally { if (button instanceof HTMLButtonElement) button.disabled = false; }
      });

      if (new URLSearchParams(window.location.search).get('mode') === 'login') {
        document.querySelector('[data-auth-tab="login"]')?.click();
      }

      void (async () => {
        try {
          const me = await json('/api/auth/me');
          await showCompany(me.specialist);
        } catch {
          if (authState) authState.textContent = T('createOrSign');
          await setupSocialAuth();
        }
      })();
    })();
  </script>

  <style>
    .lb-access{background:var(--hermes-pearl);color:var(--hermes-ink);min-height:100vh}.lb-access-shell{width:min(1120px,calc(100% - 32px));margin:0 auto}.lb-access-hero{padding:72px 0 44px;background:radial-gradient(circle at 85% 5%,rgba(124,92,255,.10),transparent 28rem),radial-gradient(circle at 12% 35%,rgba(90,200,250,.08),transparent 24rem),var(--hermes-pearl);color:var(--hermes-ink);border-bottom:1px solid var(--hermes-line-light-soft)}.lb-back{display:inline-block;margin-bottom:32px;color:var(--hermes-muted);text-decoration:none;font-weight:750}.lb-kicker{margin:0 0 10px;text-transform:uppercase;letter-spacing:.12em;font-size:.72rem;font-weight:900;color:var(--hermes-violet)}.lb-access-hero .lb-kicker{color:var(--hermes-violet)}.lb-access-hero h1{margin:0;max-width:860px;font-size:clamp(2.4rem,6vw,5.2rem);line-height:.95;letter-spacing:-.045em}.lb-lead{max-width:780px;margin:22px 0 0;color:var(--hermes-muted);font-size:1.05rem;line-height:1.7}.lb-flow{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:34px}.lb-flow>div{padding:16px;border:1px solid var(--hermes-line-light);border-radius:16px;background:rgba(255,255,255,.78);box-shadow:var(--hermes-shadow-card);display:grid;gap:5px}.lb-flow strong{font-size:1.5rem}.lb-flow span{font-weight:850}.lb-flow small{color:var(--hermes-muted)}.lb-access-body{padding:44px 0 80px}.lb-access-grid{display:grid;grid-template-columns:1fr 1fr .86fr;gap:16px;align-items:start}.lb-access-card,.lb-access-side{background:#fff;border:1px solid #dfe4ef;border-radius:20px;padding:24px;box-shadow:0 12px 32px rgba(20,31,60,.06)}.lb-access-card.is-complete{border-color:#a8d7c3}.lb-card-head h2,.lb-access-side h2{margin:0 0 8px;font-size:1.55rem}.lb-card-head p:last-child,.lb-access-side{line-height:1.6;color:#58647d}.lb-social-auth{display:grid;gap:12px;margin:20px 0 16px}.lb-social-auth[hidden]{display:none}.lb-google-button{min-height:44px;display:flex;justify-content:center}.lb-or{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;color:#7a859c}.lb-or span{height:1px;background:#e0e5ef}.lb-or small{font-size:.7rem;font-weight:750;text-transform:uppercase;letter-spacing:.08em}.lb-tabs{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:5px;margin:20px 0;background:#eef1f7;border-radius:12px}.lb-tabs button{border:0;border-radius:9px;padding:10px;background:transparent;font-weight:800;color:#647089;cursor:pointer}.lb-tabs button.is-active{background:#fff;color:#0d1833;box-shadow:0 2px 8px rgba(20,31,60,.08)}.lb-form{display:grid;gap:14px}.lb-form label{display:grid;gap:6px;font-size:.78rem;font-weight:850;color:#35415b}.lb-form label span{font-weight:600;color:#7a859c}.lb-form label .lb-t{font-weight:850;color:#35415b}.lb-check .lb-ct,.lb-access-side .lb-ct{font-weight:inherit;color:inherit}.lb-form input,.lb-form select{width:100%;box-sizing:border-box;border:1px solid #cfd6e4;border-radius:11px;padding:11px 12px;background:#fff;color:#0d1833;font:inherit;font-weight:600}.lb-form-row{display:grid;grid-template-columns:1fr 92px;gap:10px}.lb-check{display:grid!important;grid-template-columns:auto 1fr;align-items:start;gap:10px!important;padding:12px;border:1px solid #e0e5ef;border-radius:12px;background:#f9fafc}.lb-check input{width:auto;margin-top:3px}.lb-check span{line-height:1.5}.lb-primary{border:0;border-radius:12px;padding:13px 16px;background:var(--hermes-obsidian);color:#fff;font-weight:900;cursor:pointer}.lb-primary:disabled{opacity:.55;cursor:wait}.lb-message{min-height:1.35em;margin:14px 0 0;color:#197a55;font-size:.78rem;font-weight:750}.lb-message[data-error="true"]{color:#b33c43}.lb-access-side{position:sticky;top:18px}.lb-access-side ol{padding-left:20px}.lb-access-side li{margin:.75rem 0}.lb-access-side a{color:var(--hermes-violet);font-weight:850;text-decoration:none}@media(max-width:980px){.lb-access-grid{grid-template-columns:1fr 1fr}.lb-access-side{grid-column:1/-1;position:static}.lb-flow{grid-template-columns:1fr 1fr}}@media(max-width:680px){.lb-access-hero{padding-top:52px}.lb-access-grid{grid-template-columns:1fr}.lb-access-side{grid-column:auto}.lb-flow{grid-template-columns:1fr}.lb-form-row{grid-template-columns:1fr}.lb-access-card,.lb-access-side{padding:19px}}
  </style>
</BaseLayout>
