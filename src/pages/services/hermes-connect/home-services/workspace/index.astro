---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../../components/SiteHeader.astro";
---
<BaseLayout
  title="Home Services CRM | Hermes Connect"
  description="Private Hermes Connect workspace for home and local service businesses: leads, quotes, jobs, costs, revenue, follow-up and reviews."
  robots="noindex,nofollow"
>
  <SiteHeader theme="light" activePath="/services/hermes-connect/" />
  <main class="hs-page" id="main-content">
    <div class="hs-shell">
      <header class="hs-header">
        <div>
          <p class="eyebrow">Hermes Connect · Home & Local Services</p>
          <h1 data-company-name>Business workspace</h1>
          <p class="sub">Lead → Quote → Booked → Completed → Revenue → Review</p>
        </div>
        <div class="header-actions">
          <a href="/services/hermes-connect/access/">Account</a>
          <a data-catalog-link href="/businesses/" hidden>Published Catalog profile</a>
          <span data-catalog-private class="catalog-private">Catalog not published</span>
          <button type="button" data-refresh>Refresh</button>
        </div>
      </header>

      <p class="alert" data-alert hidden></p>

      <section class="kpis" aria-label="Business metrics">
        <article><span>Leads</span><strong data-kpi="totalLeads">0</strong><small>all tracked</small></article>
        <article><span>Booked rate</span><strong data-kpi="bookedRate">0%</strong><small>booked + active + completed</small></article>
        <article><span>Revenue</span><strong data-kpi="revenueCents">UNKNOWN</strong><small data-money-evidence="revenue">source-verified final amounts</small></article>
        <article><span>Tracked gross</span><strong data-kpi="grossAfterTrackedCostsCents">UNKNOWN</strong><small data-money-evidence="gross">verified revenue − lead cost − disposal</small></article>
        <article><span>Avg ticket</span><strong data-kpi="averageTicketCents">UNKNOWN</strong><small data-money-evidence="averageTicket">verified completed jobs</small></article>
        <article><span>Review rate</span><strong data-kpi="reviewRate">0%</strong><small>received / completed</small></article>
      </section>

      <section class="panel public-assets" data-public-assets hidden>
        <div class="panel-head"><div><p class="eyebrow">Public growth assets</p><h2>Source-backed content for your business</h2></div></div>
        <p class="asset-intro">These are public editorial or growth assets matched to your authenticated company website. They are not leads, revenue, reviews or private CRM outcomes.</p>
        <div class="public-asset-list" data-public-assets-list></div>
      </section>

      <section class="grid">
        <article class="panel new-lead">
          <div class="panel-head"><div><p class="eyebrow">New lead / job</p><h2>Capture the full chain once</h2></div></div>
          <form data-lead-form>
            <input type="hidden" name="id" />
            <div class="form-grid">
              <label>Customer name<input name="customerName" required /></label>
              <label>Phone<input name="customerPhone" inputmode="tel" /></label>
              <label>Email<input name="customerEmail" type="email" /></label>
              <label>Lead source
                <select name="source">
                  <option>Google Search</option><option>Google Business Profile</option><option>Thumbtack</option>
                  <option>Organic Website</option><option>Instagram</option><option>Facebook</option>
                  <option>Referral</option><option>Direct</option><option>Other</option>
                </select>
              </label>
              <label class="wide">Search query / keyword<input name="searchQuery" placeholder="when available" /></label>
              <label>City<input name="city" /></label>
              <label>ZIP<input name="postalCode" /></label>
              <label class="wide">Address<input name="addressLine1" /></label>
              <label>Job type<input name="jobType" placeholder="Garage cleanout, furniture, appliance…" /></label>
              <label>Approx. volume<input name="approximateVolume" placeholder="1/4 trailer, full trailer…" /></label>
              <label>Lead cost ($)<input name="leadCost" type="number" min="0" step="0.01" /></label>
              <label>Quote ($)<input name="quote" type="number" min="0" step="0.01" /></label>
              <label class="wide">Lead cost source / evidence<input name="leadCostSourceRef" maxlength="300" placeholder="Ads export, provider invoice, CRM receipt…" /></label>
              <label class="wide">Quote source / evidence<input name="quoteSourceRef" maxlength="300" placeholder="Quote document, estimate ID, CRM record…" /></label>
              <label>Status
                <select name="status">
                  <option value="new">New</option><option value="contacted">Contacted</option><option value="quoted">Quoted</option>
                  <option value="follow_up">Follow-up</option><option value="booked">Booked</option><option value="in_progress">In progress</option>
                  <option value="completed">Completed</option><option value="lost">Lost</option><option value="cancelled">Cancelled</option>
                </select>
              </label>
              <label>Job date / time<input name="jobStartAt" type="datetime-local" /></label>
              <label>Assigned driver<input name="assignedDriver" /></label>
              <label>Final amount ($)<input name="finalAmount" type="number" min="0" step="0.01" /></label>
              <label>Dump / landfill ($)<input name="disposalCost" type="number" min="0" step="0.01" /></label>
              <label class="wide">Final amount source / evidence<input name="finalAmountSourceRef" maxlength="300" placeholder="Paid invoice, receipt, transaction / job record…" /></label>
              <label class="wide">Disposal cost source / evidence<input name="disposalCostSourceRef" maxlength="300" placeholder="Landfill / dump receipt, vendor record…" /></label>
              <label>Duration (minutes)<input name="durationMinutes" type="number" min="0" step="1" /></label>
              <label>Payment
                <select name="paymentMethod"><option value="">—</option><option value="cash">Cash</option><option value="card">Card</option>
                  <option value="check">Check</option><option value="zelle">Zelle</option><option value="venmo">Venmo</option>
                  <option value="apple_pay">Apple Pay</option><option value="other">Other</option></select>
              </label>
              <label class="wide">Photo references<input name="photoRefs" placeholder="Private Drive/photo URLs, comma separated" /></label>
              <label class="wide">Loss reason<input name="lossReason" /></label>
              <label>Follow-up<input name="followUpAt" type="datetime-local" /></label>
              <label>Review requested<input name="reviewRequestedAt" type="datetime-local" /></label>
              <label>Review received<input name="reviewReceivedAt" type="datetime-local" /></label>
              <label class="wide">Notes<textarea name="notes" rows="3"></textarea></label>
            </div>
            <p class="privacy-note">Financial amount may be saved as observed, including a real $0. Revenue / cost / gross KPI remains <strong>UNKNOWN</strong> until the required amounts have private source references. Missing amount is never converted to $0.</p>
            <div class="form-actions"><button type="submit" class="primary">Save lead / job</button><button type="button" data-form-reset>Clear</button></div>
          </form>
        </article>

        <article class="panel profile-panel">
          <div class="panel-head"><div><p class="eyebrow">Business setup</p><h2>Catalog + CRM source of truth</h2></div></div>
          <form data-profile-form>
            <label>Service subtype<input name="serviceSubtype" value="junk_removal" /></label>
            <label>Services<textarea name="services" rows="7" placeholder="One service per line"></textarea></label>
            <label>Service areas<textarea name="serviceAreas" rows="8" placeholder="One city per line"></textarea></label>
            <label>Public summary<textarea name="publicSummary" rows="4"></textarea></label>
            <label>Semantic core reference<input name="semanticCoreRef" /></label>
            <button class="primary" type="submit">Save business profile</button>
          </form>
          <p class="privacy-note">Only approved business facts belong in the public Catalog. Lead names, phones, addresses, photos, pricing and job economics stay private in CRM.</p>
        </article>
      </section>

      <section class="panel">
        <div class="panel-head"><div><p class="eyebrow">Pipeline</p><h2>All leads and jobs</h2></div><input class="search" data-search placeholder="Search customer, city, source, query, job…" /></div>
        <div class="table-wrap"><table>
          <thead><tr><th>Customer</th><th>Source / query</th><th>City</th><th>Job</th><th>Status</th><th>Quote</th><th>Revenue</th><th>Disposal</th><th>Driver</th><th>Review</th><th></th></tr></thead>
          <tbody data-leads-body><tr><td colspan="11">Loading…</td></tr></tbody>
        </table></div>
      </section>

      <section class="analytics-grid">
        <article class="panel"><p class="eyebrow">Cities</p><h2>Where jobs convert</h2><div data-breakdown="byCity"></div></article>
        <article class="panel"><p class="eyebrow">Sources</p><h2>Which channels pay back</h2><div data-breakdown="bySource"></div></article>
        <article class="panel"><p class="eyebrow">Job types</p><h2>What produces revenue</h2><div data-breakdown="byJobType"></div></article>
        <article class="panel"><p class="eyebrow">Search queries</p><h2>Queries that become jobs</h2><div data-breakdown="bySearchQuery"></div></article>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  type Lead = Record<string, any>;
  let allLeads: Lead[] = [];
  let dashboard: any = null;
  const $ = <T extends Element = HTMLElement>(selector: string) => document.querySelector<T>(selector);
  const money = (cents: number | null | undefined) =>
    cents === null || cents === undefined
      ? "UNKNOWN"
      : new Intl.NumberFormat("en-US",{style:"currency",currency:"USD",maximumFractionDigits:0}).format(Number(cents)/100);
  const percent = (value: number) => `${Math.round((Number(value)||0)*100)}%`;
  const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c] || c));
  const api = async (url: string, options: RequestInit = {}) => {
    const response = await fetch(url,{credentials:"same-origin",headers:{"Accept":"application/json","Content-Type":"application/json",...(options.headers||{})},...options});
    const data = await response.json().catch(()=>({}));
    if (response.status === 401) { location.assign("/services/hermes-connect/access/?lang=en"); throw new Error("authentication_required"); }
    if (!response.ok || data?.success === false) throw new Error(data?.error || "request_failed");
    return data;
  };
  const showAlert = (message = "") => { const node=$<HTMLElement>("[data-alert]"); if(!node)return; node.textContent=message; node.hidden=!message; };

  function renderBreakdown(key: string) {
    const node = $<HTMLElement>(`[data-breakdown="${key}"]`); if(!node) return;
    const rows = dashboard?.metrics?.[key] || [];
    node.innerHTML = rows.length ? rows.slice(0,12).map((row:any)=>`
      <div class="break-row"><div><strong>${escapeHtml(row.key)}</strong><small>${row.leads} leads · ${percent(row.bookedRate)} booked</small></div>
      <div><b>${money(row.revenueCents)}</b><small>${money(row.grossAfterTrackedCostsCents)} tracked gross · ${row.moneyEvidence?.revenue?.verifiedCount??0}/${row.moneyEvidence?.revenue?.requiredCount??0} revenue evidence</small></div></div>`).join("") : '<p class="empty">No tracked data yet.</p>';
  }

  function renderLeads(filter = "") {
    const body=$<HTMLElement>("[data-leads-body]"); if(!body)return;
    const q=filter.trim().toLowerCase();
    const list=allLeads.filter((lead)=>!q || [lead.customerName,lead.source,lead.searchQuery,lead.city,lead.jobType,lead.status,lead.assignedDriver].join(" ").toLowerCase().includes(q));
    body.innerHTML=list.length?list.map((lead)=>`<tr>
      <td><strong>${escapeHtml(lead.customerName)}</strong><small>${escapeHtml(lead.customerPhone)}</small></td>
      <td>${escapeHtml(lead.source)}<small>${escapeHtml(lead.searchQuery)}</small></td>
      <td>${escapeHtml(lead.city)}</td><td>${escapeHtml(lead.jobType)}</td><td><span class="status-chip">${escapeHtml(String(lead.status).replaceAll("_"," "))}</span></td>
      <td>${money(lead.quoteCents)}</td><td>${money(lead.finalAmountCents)}</td><td>${money(lead.disposalCostCents)}</td>
      <td>${escapeHtml(lead.assignedDriver)}</td><td>${lead.reviewReceivedAt?"Received":lead.reviewRequestedAt?"Requested":"—"}</td>
      <td><button type="button" class="edit" data-edit-id="${escapeHtml(lead.id)}">Edit</button></td>
    </tr>`).join(""):'<tr><td colspan="11">No leads match this view.</td></tr>';
    body.querySelectorAll<HTMLButtonElement>("[data-edit-id]").forEach((button)=>button.addEventListener("click",()=>editLead(button.dataset.editId||"")));
  }

  function dateForInput(value: string | null) { if(!value)return ""; const d=new Date(value); if(Number.isNaN(d.getTime()))return value.slice(0,16); const local=new Date(d.getTime()-d.getTimezoneOffset()*60000); return local.toISOString().slice(0,16); }
  function dollars(cents:number|null|undefined){return cents===null||cents===undefined?"":String(Number(cents)/100);}
  function editLead(id:string){
    const lead=allLeads.find((item)=>item.id===id); const form=$<HTMLFormElement>("[data-lead-form]"); if(!lead||!form)return;
    const set=(name:string,value:any)=>{const field=form.elements.namedItem(name) as HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement|null;if(field)field.value=String(value??"");};
    set("id",lead.id);set("customerName",lead.customerName);set("customerPhone",lead.customerPhone);set("customerEmail",lead.customerEmail);set("source",lead.source);
    set("searchQuery",lead.searchQuery);set("city",lead.city);set("postalCode",lead.postalCode);set("addressLine1",lead.addressLine1);set("jobType",lead.jobType);
    set("approximateVolume",lead.approximateVolume);set("leadCost",dollars(lead.leadCostCents));set("quote",dollars(lead.quoteCents));
    set("leadCostSourceRef",lead.leadCostSourceRef);set("quoteSourceRef",lead.quoteSourceRef);set("status",lead.status);
    set("jobStartAt",dateForInput(lead.jobStartAt));set("assignedDriver",lead.assignedDriver);set("finalAmount",dollars(lead.finalAmountCents));set("disposalCost",dollars(lead.disposalCostCents));
    set("finalAmountSourceRef",lead.finalAmountSourceRef);set("disposalCostSourceRef",lead.disposalCostSourceRef);
    set("durationMinutes",lead.durationMinutes||"");set("paymentMethod",lead.paymentMethod);set("photoRefs",(lead.photoRefs||[]).join(", "));set("lossReason",lead.lossReason);
    set("followUpAt",dateForInput(lead.followUpAt));set("reviewRequestedAt",dateForInput(lead.reviewRequestedAt));set("reviewReceivedAt",dateForInput(lead.reviewReceivedAt));set("notes",lead.notes);
    form.scrollIntoView({behavior:"smooth",block:"start"});
  }
  function resetLeadForm(){const form=$<HTMLFormElement>("[data-lead-form]");form?.reset();const id=form?.elements.namedItem("id") as HTMLInputElement|null;if(id)id.value="";}

  function populateProfile(profile:any){
    const form=$<HTMLFormElement>("[data-profile-form]");if(!form||!profile)return;
    const set=(name:string,value:any)=>{const field=form.elements.namedItem(name) as HTMLInputElement|HTMLTextAreaElement|null;if(field)field.value=String(value??"");};
    set("serviceSubtype",profile.serviceSubtype);set("services",(profile.services||[]).join("\n"));set("serviceAreas",(profile.serviceAreas||[]).join("\n"));
    set("publicSummary",profile.publicSummary);set("semanticCoreRef",profile.semanticCoreRef);
  }

  function renderPublicAssets(assets:any[] = []){
    const panel=$<HTMLElement>("[data-public-assets]");
    const list=$<HTMLElement>("[data-public-assets-list]");
    if(!panel||!list)return;
    const safe=Array.isArray(assets)?assets.filter((asset)=>asset&&asset.href&&asset.title):[];
    panel.hidden=safe.length===0;
    list.innerHTML=safe.map((asset)=>`<article class="public-asset">
      <div><small>${escapeHtml(String(asset.kind||"public asset").replaceAll("_"," "))} · ${escapeHtml(asset.publishedAt||"")}</small>
      <strong>${escapeHtml(asset.title)}</strong><p>${escapeHtml(asset.summary||"")}</p></div>
      <div class="public-asset-actions"><a href="${escapeHtml(asset.href)}">Open Hermes analysis</a>
      ${asset.sourceUrl?`<a href="${escapeHtml(asset.sourceUrl)}" target="_blank" rel="noopener noreferrer">Open official source ↗</a>`:""}</div>
    </article>`).join("");
  }

  async function load(){
    showAlert("");
    try{
      const [dashboardResult,all,publicAssets]=await Promise.all([
        api("/api/hermes-connect/home-services/crm?module=dashboard"),
        api("/api/hermes-connect/home-services/crm?module=leads"),
        api("/api/hermes-connect/home-services/crm?module=public_assets"),
      ]);
      dashboard=dashboardResult;
      allLeads=Array.isArray(all.leads)?all.leads:[];
      renderPublicAssets(publicAssets.assets);
      const name=$<HTMLElement>("[data-company-name]");if(name)name.textContent=dashboard?.company?.name||"Home Services";
      const catalog=$<HTMLAnchorElement>("[data-catalog-link]");
      const privateNotice=$<HTMLElement>("[data-catalog-private]");
      // Dynamic public Home Services profiles only exist when owner opts in AND saves a public-facing profile.
      const isPublished=Boolean(dashboard?.company?.slug && dashboard?.company?.catalogOptIn &&
        ["self_submitted","verified_public"].includes(dashboard?.company?.catalogStatus) && dashboard?.profile?.id);
      if(catalog){catalog.hidden=!isPublished;if(isPublished)catalog.href="/businesses/connect/company/"+encodeURIComponent(dashboard.company.slug)+"/";}
      if(privateNotice){privateNotice.hidden=isPublished;privateNotice.textContent=dashboard?.company?.catalogOptIn
        ? "Catalog pending public business profile" : "Catalog private · owner opt-in required";}
      const metrics=dashboard.metrics||{};const total=$<HTMLElement>('[data-kpi="totalLeads"]');if(total)total.textContent=String(metrics.totalLeads||0);
      for(const key of ["revenueCents","grossAfterTrackedCostsCents","averageTicketCents"]){const n=$<HTMLElement>(`[data-kpi="${key}"]`);if(n)n.textContent=money(metrics[key]);}
      const evidence=metrics.moneyEvidence||{};
      const revenueEvidence=$<HTMLElement>('[data-money-evidence="revenue"]');
      if(revenueEvidence)revenueEvidence.textContent=`${evidence.revenue?.verifiedCount??0}/${evidence.revenue?.requiredCount??0} completed jobs source-verified`;
      const grossEvidence=$<HTMLElement>('[data-money-evidence="gross"]');
      if(grossEvidence)grossEvidence.textContent=`revenue ${evidence.revenue?.verifiedCount??0}/${evidence.revenue?.requiredCount??0} · lead cost ${evidence.leadCost?.verifiedCount??0}/${evidence.leadCost?.requiredCount??0} · disposal ${evidence.disposalCost?.verifiedCount??0}/${evidence.disposalCost?.requiredCount??0}`;
      const averageEvidence=$<HTMLElement>('[data-money-evidence="averageTicket"]');
      if(averageEvidence)averageEvidence.textContent=`${evidence.revenue?.verifiedCount??0}/${evidence.revenue?.requiredCount??0} completed jobs source-verified`;
      for(const key of ["bookedRate","reviewRate"]){const n=$<HTMLElement>(`[data-kpi="${key}"]`);if(n)n.textContent=percent(metrics[key]||0);}
      populateProfile(dashboard.profile);renderLeads($<HTMLInputElement>("[data-search]")?.value||"");
      ["byCity","bySource","byJobType","bySearchQuery"].forEach(renderBreakdown);
    }catch(error:any){if(error?.message!=="authentication_required")showAlert(`Unable to load workspace: ${error?.message||"unknown error"}`);}
  }

  $<HTMLFormElement>("[data-lead-form]")?.addEventListener("submit",async(event)=>{
    event.preventDefault();showAlert("");const form=event.currentTarget as HTMLFormElement;const data=new FormData(form);
    const cents=(name:string)=>{const raw=String(data.get(name)??"").trim();if(!raw)return null;const value=Number(raw);return Number.isFinite(value)&&value>=0?Math.round(value*100):Number.NaN;};
    const toIso=(name:string)=>{const value=String(data.get(name)||"");return value?new Date(value).toISOString():"";};
    const id=String(data.get("id")||"");
    const payload:any={action:id?"update_lead":"create_lead",id,customerName:data.get("customerName"),customerPhone:data.get("customerPhone"),customerEmail:data.get("customerEmail"),
      source:data.get("source"),searchQuery:data.get("searchQuery"),city:data.get("city"),postalCode:data.get("postalCode"),addressLine1:data.get("addressLine1"),
      jobType:data.get("jobType"),approximateVolume:data.get("approximateVolume"),
      leadCostCents:cents("leadCost"),leadCostSourceRef:data.get("leadCostSourceRef"),
      quoteCents:cents("quote"),quoteSourceRef:data.get("quoteSourceRef"),status:data.get("status"),
      jobStartAt:toIso("jobStartAt"),assignedDriver:data.get("assignedDriver"),
      finalAmountCents:cents("finalAmount"),finalAmountSourceRef:data.get("finalAmountSourceRef"),
      disposalCostCents:cents("disposalCost"),disposalCostSourceRef:data.get("disposalCostSourceRef"),
      durationMinutes:Number(data.get("durationMinutes"))||0,paymentMethod:data.get("paymentMethod"),photoRefs:String(data.get("photoRefs")||"").split(",").map(v=>v.trim()).filter(Boolean),
      lossReason:data.get("lossReason"),followUpAt:toIso("followUpAt"),reviewRequestedAt:toIso("reviewRequestedAt"),reviewReceivedAt:toIso("reviewReceivedAt"),notes:data.get("notes")};
    try{await api("/api/hermes-connect/home-services/crm",{method:"POST",body:JSON.stringify(payload)});resetLeadForm();await load();}
    catch(error:any){showAlert(`Could not save: ${error?.message||"unknown error"}`);}
  });

  $<HTMLFormElement>("[data-profile-form]")?.addEventListener("submit",async(event)=>{
    event.preventDefault();showAlert("");const data=new FormData(event.currentTarget as HTMLFormElement);
    const lines=(name:string)=>String(data.get(name)||"").split("\n").map(v=>v.trim()).filter(Boolean);
    try{await api("/api/hermes-connect/home-services/crm",{method:"POST",body:JSON.stringify({action:"upsert_profile",serviceSubtype:data.get("serviceSubtype"),services:lines("services"),serviceAreas:lines("serviceAreas"),publicSummary:data.get("publicSummary"),semanticCoreRef:data.get("semanticCoreRef"),contentStatus:"active_content_planning"})});await load();}
    catch(error:any){showAlert(`Could not save business profile: ${error?.message||"unknown error"}`);}
  });
  $("[data-form-reset]")?.addEventListener("click",resetLeadForm);$("[data-refresh]")?.addEventListener("click",load);
  $<HTMLInputElement>("[data-search]")?.addEventListener("input",(event)=>renderLeads((event.target as HTMLInputElement).value));
  void load();
</script>

<style>
  .hs-page{min-height:100vh;background:#f4f6f8;color:#172033;padding:110px 20px 70px}.hs-shell{width:min(1440px,100%);margin:auto}.hs-header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px}.eyebrow{margin:0 0 7px;color:#256aa5;text-transform:uppercase;letter-spacing:.1em;font-size:10px;font-weight:900}.hs-header h1{margin:0;font-size:clamp(34px,5vw,58px);letter-spacing:-.045em}.sub{margin:7px 0 0;color:#68778a}.header-actions{display:flex;gap:8px;flex-wrap:wrap}.header-actions [hidden]{display:none!important}.catalog-private{display:inline-flex;align-items:center;font-size:11px;color:#6a7989;padding:0 8px}.header-actions a,.header-actions button,.form-actions button,.edit{min-height:40px;padding:0 12px;border:1px solid #d2dce6;border-radius:10px;background:#fff;color:#315676;text-decoration:none;font-weight:800;cursor:pointer}.alert{padding:12px 14px;border:1px solid #efc5c5;border-radius:12px;background:#fff1f1;color:#8d2e2e}.kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:14px}.kpis article,.panel{border:1px solid #dfe5eb;border-radius:18px;background:#fff;box-shadow:0 10px 30px rgba(22,38,66,.035)}.kpis article{padding:15px}.kpis span,.kpis small{display:block;color:#778597;font-size:10px}.kpis strong{display:block;margin:7px 0 4px;font-size:24px;letter-spacing:-.035em}.public-assets{margin-bottom:14px}.asset-intro{margin:-4px 0 14px;color:#68778a;font-size:11px;line-height:1.55}.public-asset-list{display:grid;gap:10px}.public-asset{display:flex;justify-content:space-between;gap:18px;padding:14px;border:1px solid #e3e8ee;border-radius:13px;background:#f8fafc}.public-asset small,.public-asset strong,.public-asset p{display:block}.public-asset small{color:#718096;font-size:9px;text-transform:uppercase;letter-spacing:.05em}.public-asset strong{margin:5px 0;font-size:13px}.public-asset p{margin:0;color:#657487;font-size:10px;line-height:1.55}.public-asset-actions{display:flex;align-ite