---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
---

<BaseLayout
  title="Вхід і реєстрація | Hermes Connect"
  description="Один Hermes-акаунт і CRM, що підлаштовується під тип бізнесу: Repair Shop, Academy / Courses та інші vertical-specific workspaces."
  robots="noindex,nofollow"
  htmlLang="uk"
  locale="uk"
>
  <SiteHeader activePath="/paths/technology/" theme="light" locale="uk" />
  <main id="main-content" class="access-page">
    <div class="access-shell">
      <div class="access-toolbar">
        <a href="/services/hermes-connect/" data-route data-i18n="back">← Hermes Connect</a>
      </div>

      <section class="access-intro">
        <p class="eyebrow" data-i18n="eyebrow">Hermes Connect · один акаунт</p>
        <h1 data-i18n="title">Один вхід. CRM — під ваш тип бізнесу.</h1>
        <p data-i18n="lead">Hermes identity спільна, але робоче середовище не універсальне. СТО отримує автомобілі, записи й послуги. Академія отримує ліди, консультації, учасників, потоки, завдання, маркетингові KPI та retention.</p>
      </section>

      <section class="access-grid">
        <article class="access-card access-login" aria-labelledby="access-title">
          <div data-access-loading>
            <p class="status" data-i18n="secure">Безпечна сесія</p>
            <h2 id="access-title" data-i18n="checking">Перевіряємо ваш Hermes-акаунт…</h2>
          </div>

          <div data-access-active hidden>
            <p class="status success" data-i18n="sessionActive">Сесія активна</p>
            <h2><span data-i18n="welcome">Вітаємо,</span> <span data-access-name>Hermes user</span>.</h2>
            <p data-access-email class="muted"></p>
            <p class="muted" data-i18n="activeCopy">Ваші бізнеси та дозволені workspaces доступні через Hermes account switcher у верхньому меню.</p>
            <div class="actions">
              <a class="primary" href="/services/hermes-connect/" data-route data-open-connect data-i18n="openConnect">Відкрити Hermes Connect</a>
              <button type="button" data-access-logout data-i18n="logout">Вийти</button>
            </div>
          </div>

          <form data-access-form hidden>
            <p class="status" data-i18n="accountAccess">Вхід в акаунт</p>
            <h2 data-i18n="signIn">Увійти</h2>
            <p class="muted" data-i18n="signInCopy">Використовуйте email і пароль вашої спільної Hermes identity.</p>
            <p class="alert" data-access-alert role="status"></p>
            <label>Email<input name="email" type="email" autocomplete="username" required /></label>
            <label><span data-i18n="password">Пароль</span><input name="password" type="password" autocomplete="current-password" minlength="8" required /></label>
            <button class="primary" type="submit" data-i18n="secureLogin">Безпечний вхід</button>
          </form>
        </article>

        <article class="access-card business-router">
          <p class="status" data-i18n="newBusiness">Новий бізнес</p>
          <h2 data-i18n="chooseType">Оберіть тип — Hermes відкриє правильну CRM.</h2>
          <div class="business-options">
            <a class="business-option live" href="/services/hermes-connect/repair-shops/auth/?mode=register" data-route>
              <span class="option-state" data-i18n="live">LIVE</span>
              <strong data-i18n="repair">Repair Shop / СТО</strong>
              <small data-i18n="repairCopy">Записи, клієнти, автомобілі, послуги, availability і follow-up.</small>
              <em data-i18n="register">Зареєструвати →</em>
            </a>

            <a class="business-option academy" href="/services/hermes-connect/academy/business/auth/?mode=register" data-route>
              <span class="option-state" data-i18n="available">ДОСТУПНО</span>
              <strong data-i18n="academyOwner">Academy / Courses / Business Club</strong>
              <small data-i18n="academyOwnerCopy">Sales CRM, learners, cohorts, lessons, assignments, reviews, CAC/LTV/ROMI, HR і retention.</small>
              <em data-i18n="register">Зареєструвати →</em>
            </a>

            <a class="business-option learner" href="/services/hermes-connect/academy/auth/?mode=register" data-route>
              <span class="option-state neutral" data-i18n="learnerState">УЧАСНИК</span>
              <strong data-i18n="academyLearner">Academy learner</strong>
              <small data-i18n="academyLearnerCopy">Окремий learner workspace для навчання, evidence, прогресу та support.</small>
              <em data-i18n="createLearner">Створити learner account →</em>
            </a>
          </div>
        </article>
      </section>

      <section class="vertical-map" aria-labelledby="vertical-map-title">
        <div>
          <p class="eyebrow" data-i18n="architecture">Архітектура Hermes Connect</p>
          <h2 id="vertical-map-title" data-i18n="notUniversal">Не одна CRM для всіх бізнесів.</h2>
          <p data-i18n="notUniversalCopy">Один canonical business profile може мати vertical-specific workspace. Нові verticals підключаються до тієї ж Hermes identity і Catalog, а не створюють дублікати компаній.</p>
        </div>
        <div class="vertical-list">
          <article><span>01</span><strong data-i18n="repairShort">Repair Shop</strong><small data-i18n="liveProduct">Live product</small></article>
          <article><span>02</span><strong data-i18n="academyShort">Academy</strong><small data-i18n="businessCrm">Business CRM + learner</small></article>
          <article class="preparing"><span>03</span><strong>Beauty & Wellness</strong><small data-i18n="privateFoundation">Private foundation</small></article>
          <article class="preparing"><span>04</span><strong data-i18n="logistics">Logistics</strong><small data-i18n="preparing">Готується</small></article>
          <article class="preparing"><span>05</span><strong data-i18n="marketing">Marketing</strong><small data-i18n="preparing">Готується</small></article>
          <article class="preparing"><span>06</span><strong data-i18n="professional">Professional Services</strong><small data-i18n="preparing">Готується</small></article>
        </div>
      </section>

      <p class="access-boundary" data-i18n="boundary">Реєстрація Hermes-акаунта не публікує бізнес у Catalog автоматично. Публікація бізнес-профілю — окремий opt-in. Приватні CRM-дані не стають публічними.</p>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { syncConnectAuthChrome } from "../../../../lib/connect-auth-chrome";

  const dictionary = {
    uk: {
      back:"← Hermes Connect",eyebrow:"Hermes Connect · один акаунт",title:"Один вхід. CRM — під ваш тип бізнесу.",
      lead:"Hermes identity спільна, але робоче середовище не універсальне. СТО отримує автомобілі, записи й послуги. Академія отримує ліди, консультації, учасників, потоки, завдання, маркетингові KPI та retention.",
      secure:"Безпечна сесія",checking:"Перевіряємо ваш Hermes-акаунт…",sessionActive:"Сесія активна",welcome:"Вітаємо,",activeCopy:"Ваші бізнеси та дозволені workspaces доступні через Hermes account switcher у верхньому меню.",openConnect:"Відкрити Hermes Connect",logout:"Вийти",
      accountAccess:"Вхід в акаунт",signIn:"Увійти",signInCopy:"Використовуйте email і пароль вашої спільної Hermes identity.",password:"Пароль",secureLogin:"Безпечний вхід",
      newBusiness:"Новий бізнес",chooseType:"Оберіть тип — Hermes відкриє правильну CRM.",live:"LIVE",available:"ДОСТУПНО",repair:"Repair Shop / СТО",repairCopy:"Записи, клієнти, автомобілі, послуги, availability і follow-up.",register:"Зареєструвати →",
      learnerState:"УЧАСНИК",academyOwner:"Academy / Courses / Business Club",academyOwnerCopy:"Sales CRM, learners, cohorts, lessons, assignments, reviews, CAC/LTV/ROMI, HR і retention.",academyLearner:"Academy learner",academyLearnerCopy:"Окремий learner workspace для навчання, evidence, прогресу та support.",createLearner:"Створити learner account →",
      architecture:"Архітектура Hermes Connect",notUniversal:"Не одна CRM для всіх бізнесів.",notUniversalCopy:"Один canonical business profile може мати vertical-specific workspace. Нові verticals підключаються до тієї ж Hermes identity і Catalog, а не створюють дублікати компаній.",
      repairShort:"Repair Shop",academyShort:"Academy",liveProduct:"Live product",businessCrm:"Business CRM + learner",privateFoundation:"Private foundation",logistics:"Logistics",marketing:"Marketing",professional:"Professional Services",preparing:"Готується",
      boundary:"Реєстрація Hermes-акаунта не публікує бізнес у Catalog автоматично. Публікація бізнес-профілю — окремий opt-in. Приватні CRM-дані не стають публічними.",
      loginError:"Не вдалося увійти. Перевірте email і пароль."
    },
    en: {
      back:"← Hermes Connect",eyebrow:"Hermes Connect · one account",title:"One sign-in. A CRM matched to your business.",
      lead:"Hermes identity is shared, but the workspace is not universal. Repair Shops get vehicles, bookings and services. Academies get leads, consultations, learners, cohorts, assignments, marketing KPI and retention.",
      secure:"Secure session",checking:"Checking your Hermes account…",sessionActive:"Session active",welcome:"Welcome,",activeCopy:"Your businesses and authorized workspaces are available through the Hermes account switcher in the header.",openConnect:"Open Hermes Connect",logout:"Log out",
      accountAccess:"Account access",signIn:"Sign in",signInCopy:"Use the email and password attached to your shared Hermes identity.",password:"Password",secureLogin:"Secure login",
      newBusiness:"New business",chooseType:"Choose a type — Hermes opens the right CRM.",live:"LIVE",available:"AVAILABLE",repair:"Repair Shop",repairCopy:"Bookings, customers, vehicles, services, availability and follow-up.",register:"Register →",
      learnerState:"LEARNER",academyOwner:"Academy / Courses / Business Club",academyOwnerCopy:"Sales CRM, learners, cohorts, lessons, assignments, reviews, CAC/LTV/ROMI, HR and retention.",academyLearner:"Academy learner",academyLearnerCopy:"A separate learner workspace for learning, evidence, progress and support.",createLearner:"Create learner account →",
      architecture:"Hermes Connect architecture",notUniversal:"Not one CRM for every business.",notUniversalCopy:"One canonical business profile can have a vertical-specific workspace. New verticals attach to the same Hermes identity and Catalog instead of creating duplicate companies.",
      repairShort:"Repair Shop",academyShort:"Academy",liveProduct:"Live product",businessCrm:"Business CRM + learner",privateFoundation:"Private foundation",logistics:"Logistics",marketing:"Marketing",professional:"Professional Services",preparing:"Preparing",
      boundary:"Creating a Hermes account does not publish the business to Catalog automatically. Public business listing is a separate opt-in. Private CRM data never becomes public by registration alone.",
      loginError:"We could not sign you in. Check your email and password."
    }
  } as const;
  type Lang = keyof typeof dictionary;
  const params = new URLSearchParams(window.location.search);
  // Match the shared Connect shell: explicit choice, then saved choice, then English.
  let savedLanguage: string | null = null;
  try { savedLanguage = window.localStorage.getItem("hermes-connect-language"); } catch {}
  let lang: Lang = (params.has("lang") ? params.get("lang") : savedLanguage) === "uk" ? "uk" : "en";

  const withLang = (path: string) => {
    const url = new URL(path, window.location.origin);
    url.searchParams.set("lang", lang);
    return url.pathname + url.search + url.hash;
  };
  const applyLanguage = (next: Lang) => {
    syncConnectAuthChrome(next);
    lang = next;
    document.documentElement.lang = next;
    try { localStorage.setItem("hermes-connect-language", next); } catch {}
    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((node) => {
      const key = node.dataset.i18n as keyof typeof dictionary.uk;
      const value = dictionary[next][key];
      if (value) node.textContent = value;
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-route]").forEach((link) => {
      link.href = withLang(link.getAttribute("href") || "/");
    });
  };
  applyLanguage(lang);

  const loading = document.querySelector<HTMLElement>("[data-access-loading]");
  const active = document.querySelector<HTMLElement>("[data-access-active]");
  const form = document.querySelector<HTMLFormElement>("[data-access-form]");
  const alert = document.querySelector<HTMLElement>("[data-access-alert]");
  const show = (target: HTMLElement | null) => {
    [loading, active, form].forEach((node) => { if (node) node.hidden = node !== target; });
  };

  const accountDestination = async () => {
    try {
      const response = await fetch("/api/hermes-connect/account", { credentials: "same-origin", headers: { Accept: "application/json" } });
      const data = await response.json().catch(() => ({}));
      const owned = Array.isArray(data?.owned_businesses) ? data.owned_businesses.filter((item: any) => item?.href) : [];
      if (response.ok && data?.success && owned.length === 1) return String(owned[0].href);
    } catch {}
    return "/services/hermes-connect/";
  };

  const check = async () => {
    show(loading);
    try {
      const response = await fetch("/api/auth/me", { credentials: "same-origin" });
      const data = await response.json().catch(() => ({}));
      if (response.ok && data?.success && data?.specialist) {
        document.querySelectorAll<HTMLElement>("[data-access-name]").forEach((node) => { node.textContent = data.specialist.name || "Hermes user"; });
        document.querySelectorAll<HTMLElement>("[data-access-email]").forEach((node) => { node.textContent = data.specialist.email || ""; });
        const destination = await accountDestination();
        const open = document.querySelector<HTMLAnchorElement>("[data-open-connect]");
        if (open) open.href = withLang(destination);
        show(active);
        return;
      }
    } catch {}
    show(form);
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (alert) alert.textContent = "";
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    try {
      const values = new FormData(form);
      const response = await fetch("/api/auth/login", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: values.get("email"), password: values.get("password") })
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data?.success) throw new Error("login_failed");
      const destination = await accountDestination();
      window.location.assign(withLang(destination));
    } catch {
      if (alert) alert.textContent = dictionary[lang].loginError;
    } finally {
      if (submit) submit.disabled = false;
    }
  });

  document.querySelector<HTMLElement>("[data-access-logout]")?.addEventListener("click", async () => {
    await fetch("/api/auth/logout", { method: "POST", credentials: "same-origin" }).catch(() => null);
    await check();
  });
  check();
</script>

<style>
  .access-page{min-height:100vh;padding:118px 24px 82px;background:radial-gradient(circle at 82% 8%,rgba(124,92,255,.11),transparent 30rem),#f4f6f8;color:#152033}.access-shell{width:min(1120px,100%);margin:auto}.access-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:22px}.access-toolbar>a{color:#334d69;text-decoration:none;font-weight:850}
  .access-intro{max-width:940px;margin-bottom:28px}.eyebrow,.status{margin:0 0 10px;color:#6d56d9;font-size:11px;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.access-intro h1{max-width:900px;margin:0;font-size:clamp(46px,7vw,82px);line-height:.96;letter-spacing:-.055em}.access-intro>p:last-child{max-width:850px;color:#617087;line-height:1.7;font-size:17px}
  .access-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:18px;align-items:start}.access-card{padding:26px;border:1px solid #dce4ed;border-radius:22px;background:#fff;box-shadow:0 24px 60px rgba(24,40,68,.07)}.access-card h2{margin:0 0 10px;font-size:clamp(27px,3vw,36px);letter-spacing:-.025em}.muted{color:#68778a;line-height:1.6}.status.success{color:#16815f}.access-card form{display:grid;gap:14px}.access-card label{display:grid;gap:6px;font-size:12px;font-weight:800}.access-card input{width:100%;box-sizing:border-box;padding:12px 13px;border:1px solid #cfd9e4;border-radius:10px;font:inherit}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.primary,.access-card button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 15px;border-radius:11px;text-decoration:none;font-weight:800}.primary,.access-card button.primary{border:1px solid #151b27;background:#151b27;color:#fff}.access-card button:not(.primary){border:1px solid #cfd9e4;background:#fff;color:#244c73}.alert{min-height:1.4em;margin:0;color:#a33b3b;font-size:12px}
  .business-options{display:grid;gap:10px;margin-top:18px}.business-option{display:grid;grid-template-columns:1fr auto;gap:6px 14px;padding:16px;border:1px solid #dce4ed;border-radius:16px;background:#fbfcfe;color:#1e2d40;text-decoration:none;transition:.15s ease}.business-option:hover,.business-option:focus-visible{transform:translateY(-1px);border-color:#9daec2;box-shadow:0 12px 28px rgba(32,58,88,.08)}.business-option.academy{border-color:#cfc5f0;background:linear-gradient(135deg,#fff,#f7f3ff)}.business-option.live{border-color:#bfd9ef;background:linear-gradient(135deg,#fff,#f2f9ff)}.business-option strong{font-size:17px}.business-option small{grid-column:1/-1;color:#68778a;line-height:1.5}.business-option em{grid-row:1;font-style:normal;color:#265e92;font-size:12px;font-weight:900;align-self:center}.option-state{display:inline-flex;width:max-content;padding:4px 7px;border-radius:999px;background:#eaf5ff;color:#14679e;font-size:9px;font-weight:900;letter-spacing:.08em}.academy .option-state{background:#efe9ff;color:#6547af}.option-state.neutral{background:#edf1f5;color:#536479}
  .vertical-map{display:grid;grid-template-columns:.75fr 1.25fr;gap:22px;margin-top:20px;padding:26px;border:1px solid #dce4ed;border-radius:22px;background:#fff}.vertical-map h2{margin:4px 0 10px;font-size:clamp(28px,4vw,44px);letter-spacing:-.035em}.vertical-map>div>p:last-child{color:#67768a;line-height:1.65}.vertical-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.vertical-list article{display:grid;grid-template-columns:auto 1fr;column-gap:10px;align-items:center;padding:13px;border:1px solid #e0e6ed;border-radius:14px;background:#fbfcfd}.vertical-list article>span{grid-row:1/3;color:#8995a5;font-size:10px;font-weight:900}.vertical-list strong{font-size:13px}.vertical-list small{color:#627287;font-size:10px}.vertical-list .preparing{opacity:.72}
  .access-boundary{margin:18px 0 0;padding:15px 17px;border:1px solid #f1dfb9;border-radius:14px;background:#fff9ec;color:#76571d;line-height:1.6;font-size:12px}
  @media(max-width:850px){.access-page{padding:100px 16px 60px}.access-grid,.vertical-map{grid-template-columns:1fr}.access-intro h1{font-size:clamp(44px,13vw,66px)}}@media(max-width:560px){.vertical-list{grid-template-columns:1fr}.access-toolbar{align-items:flex-start}}
</style>
