---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
---
<BaseLayout title="Email sign in | Hermes Connect" description="Use a one-time email link to create a Hermes account or sign in." robots="noindex,nofollow" htmlLang="en" locale="en">
  <SiteHeader activePath="/paths/technology/" theme="light" locale="en" />
  <main id="main-content" class="email-verify">
    <section class="email-panel" aria-labelledby="email-title">
      <p class="eyebrow">Hermes Connect · email identity</p>
      <h1 id="email-title">Continue with email</h1>
      <p>We'll send a one-time verification link to your email when transactional email sign-in is available.</p>
      <form data-email-form hidden>
        <label>Your email<input name="email" type="email" autocomplete="email" required /></label>
        <button type="submit">Send secure sign-in link</button>
      </form>
      <p class="status" data-email-status role="status">Checking whether secure email sign-in is available…</p>
      <a href="/services/hermes-connect/access/">Sign in with an existing account</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>("[data-email-form]");
  const status = document.querySelector<HTMLElement>("[data-email-status]");
  const enable = async () => {
    try {
      const res = await fetch("/api/auth/email/start", { credentials: "same-origin" });
      const payload = await res.json().catch(() => ({}));
      if (res.ok && payload.enabled === true) {
        if (form) form.hidden = false;
        if (status) status.textContent = "A valid link expires after 15 minutes.";
        return;
      }
    } catch {}
    if (status) status.textContent = "Email-link sign-in is not available yet. Existing account login remains available.";
  };
  void enable();
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    try {
      const email = new FormData(form).get("email");
      const res = await fetch("/api/auth/email/start", {
        method: "POST", credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      if (!res.ok) throw new Error("unavailable");
      if (status) status.textContent = "If this address is eligible, a link will arrive. Check your inbox.";
    } catch {
      if (status) status.textContent = "Email sign-in cannot be completed currently. Use your existing account login.";
    } finally { if (button) button.disabled = false; }
  });
</script>
<style>
.email-verify{min-height:70vh;display:grid;place-items:center;padding:132px 20px 70px;background:#f4f6f8;color:#142238}.email-panel{width:min(480px,100%);background:white;border:1px solid #dbe3ee;border-radius:20px;padding:32px;display:grid;gap:16px}.email-panel h1{font-size:34px;letter-spacing:-.03em;margin:0}.email-panel p{line-height:1.55;margin:0}.email-panel .eyebrow{font-size:12px;font-weight:800;color:#4867a2}.email-panel .status{font-size:13px;color:#4a5c75}.email-panel form{display:grid;gap:13px}.email-panel form[hidden]{display:none}.email-panel label{display:grid;gap:6px;font-weight:750;font-size:13px}.email-panel input{border:1px solid #cbd5e1;border-radius:10px;padding:12px}.email-panel button{background:#142238;border:0;border-radius:11px;padding:14px 16px;color:#fff;font:inherit;font-weight:800;cursor:pointer}.email-panel button:disabled{opacity:.5;cursor:default}.email-panel a{color:#335e9c;font-size:13px}
</style>
