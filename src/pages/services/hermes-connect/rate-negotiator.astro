---
import { ArrowLeft, ArrowRight, Bot, Handshake, MessageSquareText, ShieldCheck, Sparkles, TrendingUp } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HermesConnectLauncher from "../../../components/HermesConnectLauncher.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { HERMES_CONNECT_PRICING } from "../../../data/hermes-connect-pricing";

const canonicalUrl = "https://hermeslogisticsus.com/services/hermes-connect/rate-negotiator/";

const faqs = [
  {
    question: "What is the AI Freight Rate Negotiator?",
    answer: "The Rate Negotiator builds professional broker counter-offer messages based on targeted profit margins, equipment type, and lane urgency."
  },
  {
    question: "What counter-offer strategies are supported?",
    answer: "The tool generates three distinct counter-offer formats: 1) Firm & Professional Target Rate, 2) Cost-Justified Breakdown (fuel + deadhead), and 3) Quick-Close Instant Commitment Rate."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Hermes Connect AI Rate Negotiator",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: canonicalUrl,
    description: "Automated broker counter-offer message generator for car haulers and freight dispatchers.",
    offers: {
      "@type": "Offer",
      price: HERMES_CONNECT_PRICING.pro.priceMonthly,
      priceCurrency: "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(faq => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
      { "@type": "ListItem", position: 3, name: "Rate Negotiator", item: canonicalUrl }
    ]
  }
];
---

<BaseLayout
  title="AI Rate Negotiator & Broker Counter-Offer Builder | Hermes Connect"
  description="Generate professional broker counter-offer emails and messages instantly with the Hermes Connect AI Rate Negotiator."
  schema={schema}
>
  <SiteHeader />

  <main id="main-content" class="hc-feature-page">
    <div class="page-container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li><a href="/services/hermes-connect/">Hermes Connect</a></li>
          <li aria-current="page">Rate Negotiator</li>
        </ol>
      </nav>

      <header class="hero-section">
        <div class="badge">✦ Public Beta Tool</div>
        <h1>AI Freight Rate Negotiator</h1>
        <p class="hero-lead">
          Stop leaving money on the load board. Generate professional, persuasive broker counter-offers in seconds.
        </p>

        <div class="cta-group">
          <a class="btn primary-btn" href="https://connect.hermeslogisticsus.com/workspace?tool=rate-negotiator">
            <Handshake size={18} aria-hidden="true" />
            Try Rate Negotiator in Workspace
          </a>
          <HermesConnectLauncher variant="header" />
        </div>
      </header>

      <section class="feature-overview">
        <h2>Key Counter-Offer Strategies</h2>
        <div class="card-grid">
          <div class="card">
            <Bot class="icon" size={28} />
            <h3>Firm Professional Target</h3>
            <p>Direct, respectful counter-offer stating target RPM and pickup timeline guarantee.</p>
          </div>
          <div class="card">
            <TrendingUp class="icon" size={28} />
            <h3>Cost-Justified Breakdown</h3>
            <p>Itemizes fuel surcharges, deadhead distance, and equipment requirements to justify higher rates.</p>
          </div>
          <div class="card">
            <MessageSquareText class="icon" size={28} />
            <h3>Quick-Close Commitment</h3>
            <p>High-speed dispatch text offer for immediate rate confirmation and rate lock.</p>
          </div>
        </div>
      </section>

      <section class="demo-boundary-notice">
        <ShieldCheck size={20} class="notice-icon" />
        <div>
          <strong>Public Beta Transparency Notice:</strong> Generated counter-offers can be copied or exported. Direct EDI/broker API dispatch dispatching is marked <em>Simulated / Beta</em>.
        </div>
      </section>

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-grid">
          {faqs.map(faq => (
            <div class="faq-item">
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hc-feature-page { padding: 3rem 1.5rem 5rem; max-width: 1100px; margin: 0 auto; color: var(--color-text, #f3f4f6); }
  .breadcrumb-list { display: flex; gap: 0.5rem; list-style: none; padding: 0; margin-bottom: 2rem; font-size: 0.9rem; color: #9ca3af; }
  .breadcrumb-list a { color: #38bdf8; text-decoration: none; }
  .hero-section { text-align: center; margin-bottom: 4rem; }
  .badge { display: inline-block; padding: 0.35rem 0.85rem; background: rgba(56, 189, 248, 0.15); color: #38bdf8; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 1rem; }
  h1 { font-size: 2.75rem; font-weight: 800; margin-bottom: 1.25rem; line-height: 1.2; }
  .hero-lead { font-size: 1.25rem; color: #9ca3af; max-width: 800px; margin: 0 auto 2rem; line-height: 1.6; }
  .cta-group { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.75rem; border-radius: 10px; font-weight: 600; text-decoration: none; transition: transform 0.2s, background 0.2s; }
  .primary-btn { background: #38bdf8; color: #090d16; }
  .primary-btn:hover { background: #7dd3fc; transform: translateY(-2px); }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
  .card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 1.75rem; }
  .card .icon { color: #38bdf8; margin-bottom: 1rem; }
  .card h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .card p { color: #9ca3af; font-size: 0.95rem; line-height: 1.5; }
  .demo-boundary-notice { display: flex; align-items: center; gap: 0.75rem; background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.25); color: #fde047; padding: 1.25rem; border-radius: 12px; margin: 3rem 0; font-size: 0.95rem; }
  .notice-icon { flex-shrink: 0; }
  .faq-section { margin-top: 4rem; }
  .faq-grid { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  .faq-item { background: rgba(255,255,255,0.02); border-radius: 12px; padding: 1.25rem; border: 1px solid rgba(255,255,255,0.05); }
  .faq-item h3 { font-size: 1.1rem; margin-bottom: 0.5rem; color: #f3f4f6; }
  .faq-item p { color: #9ca3af; font-size: 0.95rem; margin: 0; }
</style>
