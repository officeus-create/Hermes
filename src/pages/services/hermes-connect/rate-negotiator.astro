---
import HermesConnectCapabilityPage from "../../../components/HermesConnectCapabilityPage.astro";

const faqs = [
  {
    question: "Does Rate Negotiator send broker counter-offers automatically?",
    answer: "No. This page documents a reference capability. It does not claim live broker, EDI, email, or messaging execution.",
  },
  {
    question: "What negotiation support is the capability designed for?",
    answer: "It is designed to help an operator draft firm target-rate, cost-justified, and quick-close counter-offer language for human review before sending.",
  },
];

const capabilities = [
  { title: "Target-rate framing", body: "Draft a concise professional counter-offer around the operator's selected target and timing assumptions." },
  { title: "Cost-justified reasoning", body: "Explain fuel, deadhead, equipment, and timing constraints without inventing live broker or market data." },
  { title: "Human-controlled close", body: "Prepare quick-close language while keeping final outbound communication and rate acceptance under operator control." },
];
---

<HermesConnectCapabilityPage
  name="Rate Negotiator"
  pageTitle="Rate Negotiator Reference Capability | Hermes Connect"
  description="Reference documentation for the Hermes Connect Rate Negotiator capability. No automatic broker communication is claimed."
  canonicalUrl="https://hermeslogisticsus.com/services/hermes-connect/rate-negotiator/"
  lead="A negotiation-assistance concept for drafting clear freight counter-offers while keeping all outbound communication and commercial acceptance under human control."
  capabilities={capabilities}
  boundary="Direct EDI, broker API dispatching, automatic messaging, and autonomous rate acceptance are not part of the current live Repair Shop pilot and are not represented here as production functionality."
  faqs={faqs}
/>
