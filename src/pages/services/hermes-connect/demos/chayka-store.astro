</div></main><SiteFooter/>
</BaseLayout>
<style>main{background:#f4f6f8;color:#172033;min-height:80vh}.shell{width:min(1180px,calc(100% - 32px));margin:auto;padding:60px 0 80px}header{display:flex;justify-content:space-between;gap:30px;align-items:end;padding:30px;background:#fff;border:1px solid #dfe5eb;border-radius:22px}header p,.kicker{font-size:11px;font-weight:900;letter-spacing:.13em;color:#2168a6}h1{font-size:clamp(44px,7vw,78px);margin:8px 0;letter-spacing:-.05em}.status{font-size:11px;padding:7px 9px;border-radius:999px;background:#fff2d2;color:#775508;font-weight:900}.actions{display:flex;gap:8px;flex-wrap:wrap}.actions a,.links a{padding:11px 13px;border:1px solid #dbe3eb;border-radius:11px;text-decoration:none;color:#235d8f;background:#fff;font-weight:800}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:14px}.stats article,.grid article,.pipeline,.work,.privacy{background:#fff;border:1px solid #dfe5eb;border-radius:18px;padding:22px}.stats article{display:grid;gap:7px}.stats small,.stats span,.note,.privacy span{color:#758295}.stats b{font-size:20px}.grid{display:grid;grid-template-columns:1.2fr .8fr;gap:14px;margin-top:14px}.grid h2,.pipeline h2,.work h2{font-size:30px;margin:8px 0 16px}.grid dl div{display:grid;grid-template-columns:110px 1fr;gap:12px;padding:9px 0;border-top:1px solid #edf1f4}.grid dt{color:#7b8795}.grid dd{margin:0}.links{display:grid;gap:8px}.note{line-height:1.6}.pipeline,.work,.privacy{margin-top:14px}.pipeline>div{display:flex;gap:9px;flex-wrap:wrap;align-items:center}.pipeline span{padding:10px 12px;border-radius:10px;background:#f5f8fb;font-size:12px;font-weight:800}.pipeline i{color:#8fa0b0}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.cards article{display:grid;gap:7px;padding:15px;background:#f6f8fa;border-radius:12px}.cards span{font-size:12px;color:#718095;line-height:1.45}.privacy{display:flex;justify-content:space-between;gap:20px;background:#172033;color:#fff}.privacy span{max-width:700px;color:#bdc8d2}@media(max-width:780px){header,.privacy{align-items:start;flex-direction:column}.stats,.grid,.cards{grid-template-columns:1fr}.shell{padding-top:30px}}</style>