---
import { ArrowLeft, ArrowRight, Plus, ShieldCheck, Sparkles } from "@lucide/astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import HermesConnectExperience from "../../../../components/HermesConnectExperience.astro";
import HermesConnectAccountSwitcher from "../../../../components/HermesConnectAccountSwitcher.astro";
---

<BaseLayout
  title="Website Factory | Hermes Connect"
  description="Create a reviewable website build brief from your business sources, goals, references and owner instructions."
  robots="noindex,nofollow"
>
  <SiteHeader activePath="/paths/technology/" />
  <HermesConnectExperience />

  <main id="main-content" class="factory-page" data-hermes-vertical="technology">
    <div class="factory-shell">
      <a class="factory-back" href="/services/hermes-connect/"><ArrowLeft size={16} /> Hermes Connect</a>

      <header class="factory-hero">
        <div>
          <p class="factory-kicker"><Sparkles size={15} /> Hermes Connect · Technology</p>
          <h1>Build the brief before the website.</h1>
          <p>Give Hermes the business truth, the outcome you want and three useful references. The result is a saved, reviewable website brief — not a fake promise that a production build has already started.</p>
        </div>
        <span class="factory-boundary"><ShieldCheck size={16} /> Private · noindex</span>
      </header>

      <section class="factory-state" data-factory-loading role="status">
        <strong>Checking your Hermes account…</strong>
        <span>Website Factory uses the same Hermes identity and session as the rest of Hermes Connect.</span>
      </section>

      <section class="factory-auth hidden" data-factory-auth aria-labelledby="factory-auth-title">
        <div class="factory-auth-copy">
          <p class="factory-kicker">One Hermes identity</p>
          <h2 id="factory-auth-title">Sign in or create your Hermes account.</h2>
          <p>No separate Website Factory password store is created. This form uses the shared Hermes account endpoints; drafts are owner-scoped to that authenticated identity.</p>
          <div class="factory-auth-tabs" role="tablist" aria-label="Authentication mode">
            <button type="button" class="active" data-auth-tab="login">Sign in</button>
            <button type="button" data-auth-tab="register">Create account</button>
          </div>
        </div>
        <div>
          <div class="factory-alert hidden" data-auth-alert role="alert"></div>
          <form class="factory-auth-form active" data-auth-form="login">
            <label>Email<input name="email" type="email" autocomplete="email" required /></label>
            <label>Password<input name="password" type="password" autocomplete="current-password" required /></label>
            <button class="factory-primary" type="submit">Sign in <ArrowRight size={16} /></button>
          </form>
          <form class="factory-auth-form" data-auth-form="register">
            <label>Full name<input name="name" autocomplete="name" minlength="2" required /></label>
            <label>Email<input name="email" type="email" autocomplete="email" required /></label>
            <label>Password<input name="password" type="password" autocomplete="new-password" minlength="8" required /></label>
            <label>Country and city<input name="location" autocomplete="address-level2" minlength="2" required /></label>
            <button class="factory-primary" type="submit">Create Hermes account <ArrowRight size={16} /></button>
          </form>
        </div>
      </section>

      <section class="factory-app hidden" data-factory-app>
        <section class="factory-account-context" aria-label="Hermes account and workspaces">
          <HermesConnectAccountSwitcher current="neutral" />
          <div class="factory-workspace-toolbar">
            <div><span>Draft sync</span><strong data-save-state aria-live="polite">Saved</strong></div>
            <button type="button" class="factory-secondary" data-logout>Log out</button>
          </div>
        </section>

        <section class="factory-resume" data-resume-view>
          <div class="factory-section-head">
            <div>
              <p class="factory-kicker">Your website briefs</p>
              <h2>Resume or start a new website.</h2>
              <p>Drafts autosave to your Hermes account. Submitted briefs stay immutable as a handoff snapshot.</p>
            </div>
            <button type="button" class="factory-primary" data-new-draft><Plus size={17} /> Start new website</button>
          </div>
          <div class="factory-draft-list" data-draft-list></div>
        </section>

        <section class="factory-wizard hidden" data-wizard-view>
          <div class="factory-progress" aria-label="Website brief progress">
            <div class="factory-progress-top"><strong data-step-name>Sources</strong><span data-step-count>Step 1 of 9</span></div>
            <div class="factory-progress-track"><span data-progress-bar></span></div>
            <nav data-step-nav aria-label="Brief steps"></nav>
          </div>

          <div class="factory-wizard-head">
            <div><button type="button" class="factory-text-button" data-back-drafts><ArrowLeft size={15} /> All drafts</button><h2 data-draft-title-heading>Website brief</h2></div>
            <label class="factory-title-field">Draft title<input data-draft-title maxlength="120" placeholder="My new website" /></label>
          </div>

          <div class="factory-alert hidden" data-wizard-alert role="status"></div>

          <section class="factory-step" data-step="1">
            <p class="factory-kicker">01 · Sources</p><h3>Where does your business already exist?</h3>
            <p>Add public URLs only. Hermes never asks for social-media passwords here. B1 saves these sources for the brief; automated source reading is not yet connected, so imported facts remain owner-entered for now.</p>
            <form class="source-input" data-source-form><label>Public business URL<input data-source-url type="url" inputmode="url" placeholder="https://…" /></label><button class="factory-secondary" type="submit"><Plus size={16} /> Add source</button></form>
            <label class="factory-check"><input type="checkbox" data-start-zero /><span><strong>I’m starting from zero</strong><small>Continue without an existing website or public profile.</small></span></label>
            <div class="source-list" data-source-list></div>
          </section>

          <section class="factory-step hidden" data-step="2">
            <p class="factory-kicker">02 · Business truth</p><h3>Confirm the facts the website should use.</h3>
            <p>Until automated extraction is connected, these are owner-confirmed facts. Nothing is silently inferred from a public profile.</p>
            <div class="factory-form-grid">
              <label>Business name<input data-fact="business_name" /></label><label>Category<input data-fact="category" /></label>
              <label class="span-2">Short description<textarea data-fact="description"></textarea></label>
              <label>Phone<input data-fact="phone" inputmode="tel" /></label><label>Public email<input data-fact="email" type="email" /></label>
              <label class="span-2">Address or service area<input data-fact="address" /></label>
              <label class="span-2">Services / products <small>One per line</small><textarea data-services></textarea></label>
            </div>
          </section>

          <section class="factory-step hidden" data-step="3">
            <p class="factory-kicker">03 · Outcome</p><h3>What should the website do for the business?</h3>
            <div class="factory-form-grid">
              <label>Primary goal<select data-goal-primary><option value="">Choose primary goal</option><option>Get calls</option><option>Collect leads</option><option>Bookings / appointments</option><option>Sell services</option><option>Show portfolio / work</option><option>Explain a complex offer</option><option>Recruit people</option><option>Support local SEO</option><option>Establish credibility</option><option>Other</option></select></label>
              <label>Primary visitor action<input data-goal-action placeholder="Call, request quote, book…" /></label>
              <label class="span-2">Target customer<textarea data-goal-customer></textarea></label>
              <label>Geography / market<input data-goal-geography /></label><label>Languages<input data-goal-languages placeholder="English, Russian…" /></label>
            </div>
          </section>

          <section class="factory-step hidden" data-step="4">
            <p class="factory-kicker">04 · Owner brief</p><h3>Explain what you want naturally.</h3>
            <p>Write what should change, what matters most, what you dislike and any constraints. Your original text is preserved as owner input.</p>
            <label class="factory-wide-label">Typed brief<textarea data-brief-text class="brief-text" placeholder="Tell Hermes what you want the new site to achieve, emphasize, remove or feel like…"></textarea></label>
            <div class="factory-boundary-card"><strong>Voice brief boundary</strong><p>Secure audio storage/transcription is not connected in B1, so this version does not pretend to save voice recordings. The typed brief is fully production-persisted; voice will be enabled only with an observable storage/transcription path.</p></div>
            <div class="factory-form-grid"><label>Brand tone<input data-brief-tone placeholder="Premium, calm, direct…" /></label><label>Constraints<input data-brief-constraints placeholder="One per line or comma separated" /></label></div>
          </section>

          <section class="factory-step hidden" data-step="5">
            <p class="factory-kicker">05 · References</p><h3>Three references, three different jobs.</h3>
            <p>These teach principles. Hermes is not instructed to clone competitor text, layout or assets.</p>
            <div class="reference-grid">
              <article><strong>Visual direction</strong><span>Which site has the visual feeling you want?</span><label>HTTPS URL<input type="url" data-ref-url="visual" /></label><label>What do you like?<textarea data-ref-note="visual"></textarea></label></article>
              <article><strong>Functionality</strong><span>Which site works the way you want yours to work?</span><label>HTTPS URL<input type="url" data-ref-url="functionality" /></label><label>What works well?<textarea data-ref-note="functionality"></textarea></label></article>
              <article><strong>Structure / content</strong><span>Which site explains or organizes the business well?</span><label>HTTPS URL<input type="url" data-ref-url="structure" /></label><label>What is organized well?<textarea data-ref-note="structure"></textarea></label></article>
            </div>
          </section>

          <section class="factory-step hidden" data-step="6">
            <p class="factory-kicker">06 · Pages & capabilities</p><h3>Choose the first build brief scope.</h3>
            <div class="factory-two-column"><div><h4>Pages</h4><div class="choice-grid" data-pages></div></div><div><h4>Capabilities</h4><div class="choice-grid" data-capabilities></div></div></div>
          </section>

          <section class="factory-step hidden" data-step="7">
            <p class="factory-kicker">07 · Brand</p><h3>Use what already exists — or describe the direction.</h3>
            <div class="factory-form-grid"><label class="span-2">Existing public logo URL <small>Optional HTTPS URL</small><input type="url" data-brand-logo /></label><label>Known colors<input data-brand-colors placeholder="#11161F, #7C5CFF" /></label><label>Brand notes<input data-brand-notes /></label></div>
            <div class="factory-boundary-card"><strong>File upload boundary</strong><p>B1 does not invent an upload backend. Logo/photo uploads stay deferred until secure object storage, retention and delete behavior are connected. A public logo URL and brand notes are saved now.</p></div>
          </section>

          <section class="factory-step hidden" data-step="8">
            <p class="factory-kicker">08 · Review</p><h3>Review what Hermes understands.</h3>
            <div class="review-grid" data-review></div>
            <div class="readiness" data-readiness role="status"></div>
          </section>

          <section class="factory-step hidden" data-step="9">
            <p class="factory-kicker">09 · Handoff</p><h3>Create the website brief.</h3>
            <p>The handoff freezes this version as a reviewable snapshot. It does <strong>not</strong> claim a production website worker has started.</p>
            <div class="handoff-card" data-handoff-state><strong>Ready when the required inputs are complete.</strong><span>Your brief ID and submitted time will appear here.</span></div>
            <button class="factory-primary factory-submit" type="button" data-submit-brief>Create website brief <ArrowRight size={17} /></button>
          </section>

          <div class="factory-step-actions"><button type="button" class="factory-secondary" data-prev>Previous</button><button type="button" class="factory-primary" data-next>Save & continue <ArrowRight size={16} /></button></div>
        </section>
      </section>
    </div>
  </main>

  <SiteFooter />
  <script type="module" src="/scripts/website-factory-client.mjs"></script>
  <script type="module" src="/scripts/website-factory-locale.mjs"></script>
</BaseLayout>

<style>
  .factory-page{min-height:100vh;background:radial-gradient(circle at 88% 4%,color-mix(in srgb,var(--hermes-technology,#ff7a00) 9%,transparent),transparent 28rem),radial-gradient(circle at 8% 6%,rgba(124,92,255,.06),transparent 30rem),var(--hermes-pearl,#f7f6f3);color:var(--hermes-ink,#11161f)}
  .factory-shell{width:min(1120px,calc(100% - 2rem));margin:auto;padding:7.5rem 0 5rem}.factory-back,.factory-text-button{display:inline-flex;align-items:center;gap:.4rem;color:#5e697a;text-decoration:none;font-weight:750}.factory-text-button{min-height:44px;padding:0;border:0;background:none;cursor:pointer}
  .factory-hero{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;margin:1.2rem 0 1.5rem}.factory-hero h1{max-width:16ch;margin:.35rem 0 .8rem;font-size:clamp(2.4rem,6vw,4.8rem);line-height:.94;letter-spacing:-.055em;text-wrap:balance}.factory-hero>div>p:last-child{max-width:760px;color:var(--hermes-muted,#657083);line-height:1.65}.factory-kicker{display:flex;align-items:center;gap:.4rem;margin:0;color:#b95400;font-size:.72rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.factory-boundary{display:inline-flex;align-items:center;gap:.4rem;white-space:nowrap;padding:.5rem .7rem;border:1px solid rgba(255,122,0,.22);border-radius:999px;background:rgba(255,122,0,.07);color:#8e4300;font-size:.74rem;font-weight:800}
  .factory-state,.factory-auth,.factory-resume,.factory-wizard{border:1px solid var(--hermes-line-light,rgba(17,22,31,.1));border-radius:var(--hermes-radius-card,22px);background:rgba(255,255,255,.9);box-shadow:var(--hermes-shadow-card,0 18px 44px rgba(24,32,48,.07))}.factory-state{display:grid;gap:.35rem;padding:1.2rem}.factory-state span,.factory-auth p,.factory-section-head p,.factory-step>p,.factory-boundary-card p{color:var(--hermes-muted,#657083);line-height:1.6}
  .factory-auth{display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding:1.4rem}.factory-auth h2,.factory-section-head h2{margin:.4rem 0 .6rem}.factory-auth-tabs{display:flex;gap:.4rem;margin-top:1rem}.factory-auth-tabs button{min-height:44px;padding:.55rem .8rem;border:1px solid #dfe4ec;border-radius:.7rem;background:#fff;cursor:pointer;font:inherit;font-weight:800}.factory-auth-tabs button.active{background:var(--hermes-obsidian,#11161f);color:#fff;border-color:var(--hermes-obsidian,#11161f)}.factory-auth-form{display:none;gap:.8rem}.factory-auth-form.active{display:grid}
  .factory-auth-form label,.factory-form-grid label,.factory-wide-label,.reference-grid label,.factory-title-field,.source-input label{display:grid;gap:.35rem;color:#4f5a6b;font-size:.78rem;font-weight:800}.factory-auth-form input,.factory-form-grid input,.factory-form-grid textarea,.factory-form-grid select,.factory-wide-label textarea,.reference-grid input,.reference-grid textarea,.factory-title-field input,.source-input input{width:100%;min-width:0;min-height:46px;padding:.7rem .8rem;border:1px solid #d7dde7;border-radius:var(--hermes-radius-control,.75rem);background:#fff;color:var(--hermes-ink,#11161f);font:inherit}.factory-form-grid textarea,.factory-wide-label textarea,.reference-grid textarea{min-height:110px;resize:vertical}.brief-text{min-height:210px!important}
  .factory-primary,.factory-secondary,.factory-icon-button{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:44px;border-radius:var(--hermes-radius-control,.75rem);font:inherit;font-weight:800;cursor:pointer}.factory-primary{padding:.65rem .9rem;border:1px solid var(--hermes-obsidian,#11161f);background:var(--hermes-obsidian,#11161f);color:#fff;box-shadow:0 10px 24px rgba(11,13,18,.08)}.factory-secondary{padding:.65rem .9rem;border:1px solid #d7dde7;background:#fff;color:var(--hermes-ink,#11161f)}.factory-icon-button{width:44px;border:1px solid #d7dde7;background:#fff;color:#8b3340;font-size:1.2rem}.factory-primary:disabled,.factory-secondary:disabled,.factory-icon-button:disabled{cursor:not-allowed;opacity:.45}
  .factory-alert{margin:0 0 1rem;padding:.8rem .9rem;border:1px solid rgba(205,70,80,.22);border-radius:.8rem;background:rgba(205,70,80,.07);color:#9c3340;font-weight:700}.factory-alert.success{border-color:rgba(32,145,100,.2);background:rgba(32,145,100,.07);color:#16704f}
  .factory-account-context{margin-bottom:1rem}.factory-workspace-toolbar{display:flex;justify-content:flex-end;align-items:center;gap:.8rem;margin-top:-.2rem;padding:.1rem .2rem .7rem}.factory-workspace-toolbar>div{display:grid;text-align:right}.factory-workspace-toolbar span{color:#7b8697;font-size:.65rem;text-transform:uppercase;letter-spacing:.08em}.factory-workspace-toolbar strong{color:#4f5a6b;font-size:.75rem}
  .factory-resume,.factory-wizard{padding:1.25rem}.factory-section-head{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start}.factory-draft-list{display:grid;gap:.7rem;margin-top:1rem}.draft-card,.source-card{display:flex;justify-content:space-between;gap:1rem;align-items:center;min-width:0;padding:.9rem;border:1px solid #e0e5ed;border-radius:.9rem;background:#fff}.draft-card strong,.draft-card span,.source-card strong,.source-card a{display:block;min-width:0}.draft-card span{margin-top:.2rem;color:#778294;font-size:.72rem}.source-card>div{min-width:0}.source-card a{max-width:680px;margin-top:.2rem;color:#315f99;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.draft-card>div:last-child{display:flex;gap:.45rem}.factory-empty{display:grid;gap:.3rem;padding:1.2rem;border:1px dashed #cfd6e1;border-radius:1rem;color:#657083}
  .factory-progress{position:sticky;top:70px;z-index:5;margin:-.25rem -.25rem 1.2rem;padding:.75rem;border:1px solid rgba(17,22,31,.09);border-radius:1rem;background:rgba(255,255,255,.96);backdrop-filter:blur(16px)}.factory-progress-top{display:flex;justify-content:space-between;gap:1rem;font-size:.78rem}.factory-progress-top span{color:#747f90}.factory-progress-track{height:4px;margin:.55rem 0;background:#eef1f5;border-radius:999px;overflow:hidden}.factory-progress-track span{display:block;height:100%;background:var(--hermes-technology,#ff7a00);transition:width .2s ease}.factory-progress nav{display:flex;gap:.35rem;overflow-x:auto}.factory-progress nav button{display:grid;place-items:center;min-width:44px;height:44px;border:1px solid #e0e5ed;border-radius:999px;background:#fff;color:#687386;cursor:pointer}.factory-progress nav button.active{border-color:var(--hermes-obsidian,#11161f);background:var(--hermes-obsidian,#11161f);color:#fff}.factory-progress nav button:disabled{opacity:.38;cursor:not-allowed}
  .factory-wizard-head{display:flex;justify-content:space-between;gap:1.5rem;align-items:end;padding-bottom:1rem;border-bottom:1px solid #e8ebf0}.factory-wizard-head h2{margin:.35rem 0 0}.factory-title-field{width:min(330px,100%)}.factory-step{padding:1.5rem 0}.factory-step h3{margin:.35rem 0 .55rem;font-size:clamp(1.6rem,3vw,2.2rem)}.factory-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:.85rem;margin-top:1rem}.span-2{grid-column:1/-1}.source-input{display:grid;grid-template-columns:1fr auto;gap:.7rem;align-items:end;margin-top:1rem}.factory-check{display:flex;align-items:flex-start;gap:.65rem;margin:1rem 0;padding:.85rem;border:1px solid #e0e5ed;border-radius:.9rem;background:#fff}.factory-check input,.choice-card input{width:20px;height:20px;min-height:20px;accent-color:var(--hermes-technology,#ff7a00)}.factory-check span,.factory-check strong,.factory-check small{display:block}.factory-check small{margin-top:.15rem;color:#737e8f}.source-list{display:grid;gap:.6rem}
  .factory-boundary-card{margin-top:1rem;padding:1rem;border:1px solid rgba(255,122,0,.18);border-radius:1rem;background:rgba(255,122,0,.045)}.factory-boundary-card p{margin:.35rem 0 0}.reference-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin-top:1rem}.reference-grid article{display:grid;gap:.7rem;min-width:0;padding:1rem;border:1px solid #e0e5ed;border-radius:1rem;background:#fff}.reference-grid article>span{min-height:3em;color:#737e8f;font-size:.8rem;line-height:1.45}
  .factory-two-column{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.choice-grid{display:grid;gap:.5rem}.choice-card{display:flex;align-items:center;gap:.6rem;min-height:46px;padding:.65rem .75rem;border:1px solid #e0e5ed;border-radius:.8rem;background:#fff;font-weight:700}.review-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin-top:1rem}.review-grid article{display:grid;gap:.3rem;min-width:0;padding:.9rem;border:1px solid #e0e5ed;border-radius:.85rem;background:#fff}.review-grid span{color:#697586;line-height:1.5;overflow-wrap:anywhere}.readiness,.handoff-card{display:grid;gap:.3rem;margin-top:1rem;padding:1rem;border-radius:.9rem}.readiness.ready{border:1px solid rgba(31,144,96,.2);background:rgba(31,144,96,.07);color:#176b4d}.readiness.needs{border:1px solid rgba(205,70,80,.2);background:rgba(205,70,80,.06);color:#8f3340}.readiness span,.handoff-card span{line-height:1.5}.handoff-card{border:1px solid #e0e5ed;background:#fff}.factory-submit{margin-top:1rem}.factory-step-actions{display:flex;justify-content:space-between;gap:.75rem;padding-top:1rem;border-top:1px solid #e8ebf0}
  .hidden{display:none!important}.factory-page :where(a,button,input,select,textarea):focus-visible{outline:3px solid rgba(255,122,0,.35);outline-offset:2px}
  @media(max-width:760px){.factory-shell{width:min(100% - 1rem,1120px);padding-top:6rem}.factory-hero,.factory-section-head,.factory-wizard-head{flex-direction:column;align-items:stretch}.factory-boundary{align-self:flex-start}.factory-auth{grid-template-columns:1fr}.factory-workspace-toolbar{justify-content:space-between;margin-top:0}.factory-workspace-toolbar>div{text-align:left}.factory-progress{top:64px}.factory-progress nav{padding-bottom:.1rem}.factory-form-grid,.reference-grid,.factory-two-column,.review-grid{grid-template-columns:1fr}.span-2{grid-column:auto}.source-input{grid-template-columns:1fr}.source-input .factory-secondary{width:100%}.draft-card,.source-card{align-items:flex-start}.draft-card{flex-direction:column}.draft-card>div:last-child{width:100%}.draft-card>div:last-child .factory-secondary{flex:1}.factory-title-field{width:100%}.factory-step-actions .factory-primary,.factory-step-actions .factory-secondary{flex:1}}
  @media(max-width:430px){.factory-resume,.factory-wizard,.factory-auth{padding:.9rem}.factory-hero h1{font-size:2.55rem}.factory-workspace-toolbar{display:grid;grid-template-columns:1fr}.factory-workspace-toolbar .factory-secondary{width:100%}.source-card{flex-direction:column}.source-card .factory-icon-button{align-self:flex-end}.factory-step-actions{display:grid;grid-template-columns:1fr 1fr}}
  @media(prefers-reduced-motion:reduce){.factory-progress-track span{transition:none}.factory-page *{scroll-behavior:auto!important}}
</style>