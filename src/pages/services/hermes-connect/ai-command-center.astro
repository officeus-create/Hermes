---
import HermesConnectCapabilityPage from "../../../components/HermesConnectCapabilityPage.astro";

const faqs = [
  {
    question: "Is AI Command Center a current live Hermes Connect product?",
    answer: "No. This page documents a reference capability in the Hermes Connect product family. Repair Shops is the current live pilot.",
  },
  {
    question: "What is the intended role of AI Command Center?",
    answer: "The capability is designed to classify incoming requests, surface intent and urgency signals, and organize recommended operational actions in one decision view.",
  },
];

const capabilities = [
  { title: "Intent scoring", body: "Classify request intent and confidence so operators can see which conversations need attention first." },
  { title: "Action queue", body: "Group time-sensitive requests and recommended next actions into one prioritized operational view." },
  { title: "Product-family orchestration", body: "Provide a shared decision layer that can eventually coordinate specialized Hermes Connect workflows without creating separate product silos." },
];
---

<HermesConnectCapabilityPage
  name="AI Command Center"
  pageTitle="AI Command Center Reference Capability | Hermes Connect"
  description="Reference documentation for the Hermes Connect AI Command Center capability. Repair Shops is the current live pilot."
  canonicalUrl="https://hermeslogisticsus.com/services/hermes-connect/ai-command-center/"
  lead="A decision-layer concept for classifying incoming requests, prioritizing operational work, and presenting recommended next actions inside the Hermes Connect product family."
  capabilities={capabilities}
  boundary="This capability is not presented as a current public beta or production runtime. External ERP/CRM synchronization and autonomous operational actions are not claimed as live. Use the Repair Shop product for the current pilot flow."
  faqs={faqs}
/>
