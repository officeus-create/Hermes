---
import { ArrowLeft, ArrowRight, CalendarDays, Check, Globe, LayoutDashboard, MessageSquareText, ShieldCheck, Sparkles, UsersRound } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HermesConnectLauncher from "../../../components/HermesConnectLauncher.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";

const categories = [
  { name: "Beauty & wellness", detail: "Salons, barbers, nail, spa, and independent specialists" },
  { name: "Fitness & coaching", detail: "Personal trainers, studios, coaches, and programs" },
  { name: "Professional services", detail: "Consultants, agencies, experts, and client-facing teams" },
  { name: "Logistics & field services", detail: "Transport, dispatch, mobile teams, and operational requests" },
  { name: "Auto service & repair", detail: "Repair shops, mobile mechanics, detailers, diagnostics, and maintenance" },
  { name: "Truck & car-hauler repair", detail: "Commercial trucks, trailers, diesel service, and car-hauler equipment" },
  { name: "Heavy equipment service", detail: "Construction, agricultural, and industrial equipment support" },
  { name: "Oversize & specialty equipment", detail: "Specialty vehicles, machinery, oversize units, and coordinated review" },
  { name: "Education & events", detail: "Tutors, academies, workshops, and cohort programs" },
  { name: "Home & local services", detail: "Cleaning, repair, photography, pet care, and local teams" },
];

const capabilities = [
  { title: "Clear business profile", body: "Present the shop, location, service area, business details, and client promise in one focused web experience.", icon: LayoutDashboard },
  { title: "Service catalog", body: "Publish repair services, durations, requirements, and operational details from the owner workspace.", icon: Sparkles },
  { title: "Availability windows", body: "Set working hours and controlled booking availability without forcing customers into long message threads.", icon: CalendarDays },
  { title: "Structured booking intake", body: "Collect the customer and vehicle information needed to create and process a repair booking.", icon: MessageSquareText },
];

const faqs = [
  {
    question: "What is the current live Hermes Connect product?",
    answer: "Repair Shop Partner Beta is the current live pilot. Shop owners can register, create a profile, configure services and availability, share a public booking link, process booking statuses, use the customer CRM, submit private feedback, and send a consented corporate partner offer. Other Hermes Connect modules are retained as clearly labeled demo capabilities until real-user evidence justifies further development.",
  },
  {
    question: "Is Hermes Connect a mobile app or a Web App?",
    answer: "The current product is a responsive Web App. It works in a modern browser on desktop, tablet, and phone without requiring an App Store or Google Play installation.",
  },
  {
    question: "Can a Repair Shop owner create an account now?",
    answer: "Yes. The current Repair Shop beta has a real owner registration and login flow. After signing in, the owner can configure the shop profile, services, availability, customers, bookings, and feedback inside the same canonical Hermes Connect product.",
  },
  {
    question: "Are the other Hermes Connect modules live production tools?",
    answer: "No. Modules outside the current Repair Shop pilot are product demonstrations or capability previews unless a page explicitly says otherwise. They are not a second Hermes Connect runtime and should not be presented as independently released production products.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Hermes Connect Repair Shop Partner Beta",
    serviceType: "Repair-shop operations and booking Web App",
    url: "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/",
    description: "The current Hermes Connect live pilot for repair shops: owner profile, services, availability, customer booking, booking operations, CRM, feedback, and corporate partner intake.",
    provider: {
      "@type": "Organization",
      name: "Hermes IT Development",
      url: "https://hermeslogisticsus.com/paths/technology/",
    },
    audience: {
      "@type": "BusinessAudience",
      audienceType: "Repair shops and commercial vehicle service businesses",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Hermes Connect",
    url: "https://hermeslogisticsus.com/services/hermes-connect/",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any modern web browser",
    description: "Hermes Connect is the canonical Web App product. Repair Shop Partner Beta is its current live production pilot; other modules are clearly labeled demos.",
    creator: {
      "@type": "Organization",
      name: "Hermes IT Development",
      url: "https://hermeslogisticsus.com/paths/technology/",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "IT Development", item: "https://hermeslogisticsus.com/paths/technology/" },
      { "@type": "ListItem", position: 3, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
    ],
  },
];

import "../../../styles/features/hermes-connect-service.css";
import "../../../styles/features/hermes-connect-faq.css";
---

<BaseLayout
  title="Hermes Connect | Repair Shop Partner Beta & Product Hub"
  description="Explore the canonical Hermes Connect Web App. Repair Shop Partner Beta is the current live pilot; other Hermes Connect modules are clearly labeled demos."
  schema={schema}
>
  <SiteHeader activePath="/paths/technology/" />
  <main id="main-content" class="connect-service-page">
    <section class="connect-service-hero" id="top" aria-labelledby="connect-service-title">
      <div class="connect-service-orbit connect-service-orbit-one"></div>
      <div class="connect-service-orbit connect-service-orbit-two"></div>
      <div class="shell connect-service-hero-grid">
        <div class="connect-service-hero-copy">
          <a class="detail-back" href="/paths/technology/"><ArrowLeft size={18} aria-hidden="true" />Hermes IT Development</a>
          <p class="eyebrow hero-eyebrow">Hermes Connect · Current product</p>
          <h1 id="connect-service-title">One Hermes Connect. One current live pilot: Repair Shops.</h1>
          <p>Hermes Connect is the canonical browser-based product. The Repair Shop Partner Beta is the current live workflow for real shop owners and customers. Other modules remain visible as product demos, not separate production applications.</p>
          <div class="connect-service-actions">
            <a class="button button-primary" href="/services/hermes-connect/repair-shops/">Open Repair Shop Partner Beta <ArrowRight size={18} aria-hidden="true" /></a>
            <a class="button button-ghost" href="/services/hermes-connect/repair-shops/auth/">Owner Login / Get Started</a>
          </div>
          <ul class="connect-service-trust" aria-label="Hermes Connect release boundaries">
            <li><Globe size={17} aria-hidden="true" />Responsive Web App on desktop and mobile</li>
            <li><ShieldCheck size={17} aria-hidden="true" />One shared owner identity and protected data flow</li>
            <li><UsersRound size={17} aria-hidden="true" />Repair Shops are live beta; other modules are labeled demo</li>
          </ul>
        </div>

        <div class="connect-service-product" aria-label="Hermes Connect Web App interface preview">
          <div class="connect-service-window">
            <div class="connect-service-window-bar"><span></span><span></span><span></span><p>hermeslogisticsus.com · Hermes Connect</p><b>Web App</b></div>
            <div class="connect-service-window-body">
              <aside><strong>H</strong><i class="is-active"></i><i></i><i></i><i></i></aside>
              <div class="connect-service-screen">
                <div class="connect-service-profile">
                  <span>RS</span>
                  <div><small>Repair Shop · Partner Beta</small><h2>Shop Owner Workspace</h2></div>
                  <button type="button" tabindex="-1">Booking</button>
                </div>
                <p>Configure the shop, publish services and hours, share a booking link, and process customer requests in one workflow.</p>
                <div class="connect-service-offers">
                  <article><span>01</span><strong>Shop profile</strong><small>Owner managed</small></article>
                  <article><span>02</span><strong>Services & hours</strong><small>Bookable</small></article>
                  <article><span>03</span><strong>Booking inbox</strong><small>Status workflow</small></article>
                </div>
                <div class="connect-service-times"><span>Profile</span><span>Availability</span><span>Bookings</span></div>
              </div>
            </div>
          </div>
          <div class="connect-service-floating"><span></span><div><small>Current live path</small><strong>Register → configure → share → book</strong></div></div>
        </div>
      </div>
    </section>

    <section class="section connect-service-problem" aria-labelledby="connect-problem-title">
      <div class="shell connect-service-problem-grid">
        <div>
          <p class="eyebrow">Current product focus</p>
          <h2 id="connect-problem-title">Give a Repair Shop one usable operating path instead of another disconnected demo.</h2>
        </div>
        <div>
          <p>The current priority is not adding more feature concepts. It is making the existing Repair Shop product easy for a real owner to activate, configure, share, and use with customers.</p>
          <p>The same canonical Hermes Connect identity and data architecture stays underneath the product while future modules wait for real-user evidence.</p>
        </div>
      </div>
    </section>

    <section class="section connect-service-capabilities" aria-labelledby="connect-capabilities-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Repair Shop foundation</p><h2 id="connect-capabilities-title">The live beta already covers the core owner-to-booking workflow.</h2></div>
          <p>The current release focuses on activation and real use: create the shop, publish services and hours, share the public booking link, process bookings, manage customers, and submit feedback.</p>
        </div>
        <div class="connect-service-capability-grid">
          {capabilities.map((capability, index) => {
            const Icon = capability.icon;
            return (
              <article>
                <span>0{index + 1}</span>
                <Icon size={23} aria-hidden="true" />
                <h3>{capability.title}</h3>
                <p>{capability.body}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section connect-service-feature-modules" aria-labelledby="connect-features-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Demo capability library</p><h2 id="connect-features-title">Explore existing concepts without confusing them with the current live product.</h2></div>
          <p>These modules remain available as demonstrations and possible donors of useful functionality. They are not separate production Hermes Connect products.</p>
        </div>
        <div class="connect-service-capability-grid">
          <article>
            <h3><a href="/services/hermes-connect/ai-command-center/">AI Command Center &rarr;</a></h3>
            <p>Demo capability: lead classification, intent scoring, and an operational task queue.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/unified-inbox/">Unified Command Inbox &rarr;</a></h3>
            <p>Demo capability: multi-channel client inbox and status lifecycle concepts.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/load-analyzer/">B2B Freight Load Analyzer &rarr;</a></h3>
            <p>Demo capability: RPM, fuel-cost, and margin calculations for freight workflows.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/rate-negotiator/">AI Rate Negotiator &rarr;</a></h3>
            <p>Demo capability: professional broker counter-offer message building.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/proposal-builder/">Instant Proposal Builder &rarr;</a></h3>
            <p>Demo capability: itemized commercial quote and proposal generation.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/roi-calculator/">Business ROI Calculator &rarr;</a></h3>
            <p>Demo capability: financial modeling for staff time and recovered revenue.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/business-automation/">Multi-Vertical Automation &rarr;</a></h3>
            <p>Demo capability: intake and workflow automation concepts for additional service industries.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/repair-shops/">Repair Shop Partner Beta &rarr;</a></h3>
            <p><strong>Current live pilot:</strong> owner workspace, services, availability, booking, customers, feedback, and partner intake.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section connect-service-categories" id="categories" aria-labelledby="connect-categories-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Future category library</p><h2 id="connect-categories-title">One architecture can serve more categories later—without forking the product now.</h2></div>
          <p>These categories describe future or demo use cases. They do not mean each category is currently released as a live production vertical.</p>
        </div>
        <div class="connect-service-category-grid">
          {categories.map((category, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{category.name}</h3>
              <p>{category.detail}</p>
              <Check size={18} aria-hidden="true" />
            </article>
          ))}
        </div>
        <p class="connect-service-category-note">
          <strong>Repair Shops and Commercial Truck Repair is the current focused live beta.</strong> Other category concepts remain demo/planned until real-user evidence from the first Repair Shop cohort identifies what should be ported into the canonical product next.
        </p>
      </div>
    </section>

    <section class="section connect-service-process" aria-labelledby="connect-process-title">
      <div class="shell connect-service-process-grid">
        <div>
          <p class="eyebrow">Real-user beta loop</p>
          <h2 id="connect-process-title">The next product decision comes from real Repair Shop usage.</h2>
          <p>The current release is ready for a small controlled cohort. The purpose is to measure activation, time to first value, first booking, operational errors, support questions, and requested missing functionality.</p>
        </div>
        <ol>
          <li><span>01</span><div><strong>Register owner</strong><small>Create a real Repair Shop owner account in the canonical product.</small></div></li>
          <li><span>02</span><div><strong>Configure shop</strong><small>Add profile, services, and working hours.</small></div></li>
          <li><span>03</span><div><strong>Share booking link</strong><small>Let a real customer submit the first booking request.</small></div></li>
          <li><span>04</span><div><strong>Process and learn</strong><small>Complete the workflow, collect feedback, and fix observed friction before adding features.</small></div></li>
        </ol>
      </div>
    </section>

    <section class="section connect-service-faq" aria-labelledby="connect-faq-title">
      <div class="shell connect-service-faq-grid">
        <div>
          <p class="eyebrow">Hermes Connect FAQ</p>
          <h2 id="connect-faq-title">What is live now—and what remains demo.</h2>
          <p>These answers describe the current canonical product boundary so managers and Repair Shop owners can tell production beta functionality from demonstrations.</p>
        </div>
        <div class="connect-service-faq-list">
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}<span aria-hidden="true">+</span></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <HermesConnectLauncher variant="banner" context="general" />

    <section class="connect-service-final" aria-labelledby="connect-final-title">
      <div class="shell connect-service-final-grid">
        <div>
          <p class="eyebrow hero-eyebrow">Hermes Connect · Repair Shop Partner Beta</p>
          <h2 id="connect-final-title">Start with a real Repair Shop owner and a real booking—not another prototype.</h2>
          <p>The current beta is for controlled real-user testing. No payment or subscription is created automatically, and demo modules remain separate from the live Repair Shop workflow.</p>
        </div>
        <HermesConnectLauncher variant="inline" href="/services/hermes-connect/repair-shops/auth/" label="Owner Login / Get Started" />
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>