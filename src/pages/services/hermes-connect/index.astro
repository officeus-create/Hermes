---
import { ArrowLeft, ArrowRight, CalendarDays, Check, Globe, LayoutDashboard, MessageSquareText, ShieldCheck, Sparkles, UsersRound } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HermesConnectLauncher from "../../../components/HermesConnectLauncher.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";

const categories = [
  { name: "Beauty & wellness", detail: "Salons, barbers, nail, spa, and independent specialists" },
  { name: "Fitness & coaching", detail: "Personal trainers, studios, coaches, and programs" },
  { name: "Professional services", detail: "Consultants, agencies, experts, and client-facing teams" },
  { name: "Logistics & field services", detail: "Transport, dispatch, mobile teams, and operational requests" },
  { name: "Auto service & repair", detail: "Repair shops, mobile mechanics, detailers, diagnostics, and maintenance" },
  { name: "Truck & car-hauler repair", detail: "Commercial trucks, trailers, diesel service, and car-hauler equipment" },
  { name: "Heavy equipment service", detail: "Construction, agricultural, and industrial equipment support" },
  { name: "Oversize & specialty equipment", detail: "Specialty vehicles, machinery, oversize units, and coordinated review" },
  { name: "Education & events", detail: "Tutors, academies, workshops, and cohort programs" },
  { name: "Home & local services", detail: "Cleaning, repair, photography, pet care, and local teams" },
];

const capabilities = [
  { title: "Clear business profile", body: "Present the service, category, location, languages, and client promise in one focused web experience.", icon: LayoutDashboard },
  { title: "Service and request catalog", body: "Turn scattered offers into clear services, durations, requirements, and request types.", icon: Sparkles },
  { title: "Availability windows", body: "Show controlled request times or availability without forcing clients into long message threads.", icon: CalendarDays },
  { title: "Structured client intake", body: "Collect the minimum information needed to understand and review the next client step.", icon: MessageSquareText },
];

const faqs = [
  {
    question: "Is Hermes Connect a mobile app or a Web App?",
    answer: "The current approved product is a responsive Web App. It is designed to work in a modern browser on desktop, tablet, and phone without requiring an App Store or Google Play installation.",
  },
  {
    question: "What happens after I request Web App access?",
    answer: "Hermes reviews the business category and the must-have workflow before sending access instructions. The request does not automatically create an account, booking, payment, subscription, or guaranteed acceptance.",
  },
  {
    question: "Which business categories can use Hermes Connect?",
    answer: "The current funnel supports beauty and wellness, fitness and coaching, professional services, logistics and field services, auto service and repair, truck and car-hauler repair, heavy equipment service, oversize and specialty equipment, education and events, and home and local services. Other service businesses can choose the closest category and describe their workflow.",
  },
  {
    question: "Does Hermes Connect already connect calendars, payments, or client databases?",
    answer: "Not by default in the current controlled release. The foundation focuses on the business profile, service catalog, availability windows, and structured client requests. Advanced integrations require separate review and verification.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Hermes Connect Web App access and workflow review",
    serviceType: "Category-aware service-business Web App",
    url: "https://hermeslogisticsus.com/services/hermes-connect/",
    description: "A reviewed Web App path for service businesses that need a clearer way to present services, availability, and client requests.",
    provider: {
      "@type": "Organization",
      name: "Hermes IT Development",
      url: "https://hermeslogisticsus.com/paths/technology/",
    },
    audience: {
      "@type": "BusinessAudience",
      audienceType: "Service businesses",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Hermes Connect",
    url: "https://connect.hermeslogisticsus.com/",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any modern web browser",
    description: "A category-aware web application for service businesses to present services, availability, and a clear client request path.",
    creator: {
      "@type": "Organization",
      name: "Hermes IT Development",
      url: "https://hermeslogisticsus.com/paths/technology/",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "IT Development", item: "https://hermeslogisticsus.com/paths/technology/" },
      { "@type": "ListItem", position: 3, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
    ],
  },
];

import "../../../styles/features/hermes-connect-service.css";
import "../../../styles/features/hermes-connect-faq.css";
---

<BaseLayout
  title="Hermes Connect Web App for Service Businesses"
  description="Explore Hermes Connect, a category-aware web app for service businesses to present services, availability, and a clear client request path."
  schema={schema}
>
  <SiteHeader activePath="/paths/technology/" />
  <main id="main-content" class="connect-service-page">
    <section class="connect-service-hero" id="top" aria-labelledby="connect-service-title">
      <div class="connect-service-orbit connect-service-orbit-one"></div>
      <div class="connect-service-orbit connect-service-orbit-two"></div>
      <div class="shell connect-service-hero-grid">
        <div class="connect-service-hero-copy">
          <a class="detail-back" href="/paths/technology/"><ArrowLeft size={18} aria-hidden="true" />Hermes IT Development</a>
          <p class="eyebrow hero-eyebrow">Hermes product · Web App</p>
          <h1 id="connect-service-title">Give clients one clear place to understand, choose, and request your service.</h1>
          <p>Hermes Connect is a browser-based product for service businesses. It combines a professional business page, clear services, availability windows, and structured client requests in one category-aware experience.</p>
          <div class="connect-service-actions">
            <a class="button button-primary" href="https://connect.hermeslogisticsus.com/#apply">Request Web App access <ArrowRight size={18} aria-hidden="true" /></a>
            <a class="button button-ghost" href="/demos/hermes-connect-brand-v1/workspace.html">Open interactive workspace</a>
          </div>
          <ul class="connect-service-trust" aria-label="Hermes Connect release boundaries">
            <li><Globe size={17} aria-hidden="true" />Works in a modern browser</li>
            <li><ShieldCheck size={17} aria-hidden="true" />Human-reviewed access</li>
            <li><UsersRound size={17} aria-hidden="true" />Interactive workspace uses clearly labeled demo data</li>
          </ul>
        </div>

        <div class="connect-service-product" aria-label="Hermes Connect Web App interface preview">
          <div class="connect-service-window">
            <div class="connect-service-window-bar"><span></span><span></span><span></span><p>connect.hermeslogisticsus.com</p><b>Web App</b></div>
            <div class="connect-service-window-body">
              <aside><strong>H</strong><i class="is-active"></i><i></i><i></i><i></i></aside>
              <div class="connect-service-screen">
                <div class="connect-service-profile">
                  <span>PS</span>
                  <div><small>Professional services · Web profile</small><h2>Atlas Advisory</h2></div>
                  <button type="button" tabindex="-1">Request</button>
                </div>
                <p>Explain the offer, qualify the request, and give prospects a professional next step.</p>
                <div class="connect-service-offers">
                  <article><span>01</span><strong>Strategy session</strong><small>45 min</small></article>
                  <article><span>02</span><strong>Operations review</strong><small>60 min</small></article>
                  <article><span>03</span><strong>Project discovery</strong><small>30 min</small></article>
                </div>
                <div class="connect-service-times"><span>Tue · 10:30</span><span>Tue · 14:00</span><span>Wed · 09:00</span></div>
              </div>
            </div>
          </div>
          <div class="connect-service-floating"><span></span><div><small>Client path</small><strong>Discover → choose → request</strong></div></div>
        </div>
      </div>
    </section>

    <section class="section connect-service-problem" aria-labelledby="connect-problem-title">
      <div class="shell connect-service-problem-grid">
        <div>
          <p class="eyebrow">The problem it solves</p>
          <h2 id="connect-problem-title">Stop making every client reconstruct your business from messages.</h2>
        </div>
        <div>
          <p>Many service businesses spread their offer across social profiles, chats, screenshots, calendars, and individual explanations. The client has to ask what is available, how it works, and what to do next.</p>
          <p>Hermes Connect is being built as one controlled web layer that makes the service journey visible before private client details are requested.</p>
        </div>
      </div>
    </section>

    <section class="section connect-service-capabilities" aria-labelledby="connect-capabilities-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Web App foundation</p><h2 id="connect-capabilities-title">A useful first release, not a list of disconnected features.</h2></div>
          <p>The first controlled release focuses on the client path that most service businesses need before advanced integrations: understand the offer, choose a service, see availability, and send a request.</p>
        </div>
        <div class="connect-service-capability-grid">
          {capabilities.map((capability, index) => {
            const Icon = capability.icon;
            return (
              <article>
                <span>0{index + 1}</span>
                <Icon size={23} aria-hidden="true" />
                <h3>{capability.title}</h3>
                <p>{capability.body}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section connect-service-feature-modules" aria-labelledby="connect-features-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Interactive Modules &amp; Tools</p><h2 id="connect-features-title">Explore Hermes Connect Specialized Feature Tools</h2></div>
          <p>Deep-dive into each specialized module built into our responsive Public Beta Web App.</p>
        </div>
        <div class="connect-service-capability-grid">
          <article>
            <h3><a href="/services/hermes-connect/ai-command-center/">AI Command Center &rarr;</a></h3>
            <p>Automated lead classification, intent scoring, and real-time operational task queue.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/unified-inbox/">Unified Command Inbox &rarr;</a></h3>
            <p>Single multi-channel client inbox with status lifecycle management (NEW, QUALIFIED, PROPOSAL_SENT).</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/load-analyzer/">B2B Freight Load Analyzer &rarr;</a></h3>
            <p>Interactive profit calculator computing Rate-Per-Mile (RPM), fuel costs, and net margin %.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/rate-negotiator/">AI Rate Negotiator &rarr;</a></h3>
            <p>Professional broker counter-offer message builder for dispatchers and freight operators.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/proposal-builder/">Instant Proposal Builder &rarr;</a></h3>
            <p>Itemized commercial quote and contract proposal generator with HTML/PDF export.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/roi-calculator/">Business ROI Calculator &rarr;</a></h3>
            <p>Interactive financial modeling tool projecting staff hours saved and recovered revenue.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/business-automation/">Multi-Vertical Automation &rarr;</a></h3>
            <p>Tailored intake and workflow automation engines for 7 service industry verticals.</p>
          </article>
          <article>
            <h3><a href="/services/hermes-connect/repair-shops/">Repair Shop Partner Beta &rarr;</a></h3>
            <p>On-demand roadside service dispatch, shop bay capacity management, and corporate partner offers.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section connect-service-categories" id="categories" aria-labelledby="connect-categories-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Category-aware product</p><h2 id="connect-categories-title">One platform. Different service language for each business.</h2></div>
          <p>The same product structure adapts the services, examples, request language, and client next step to the selected category.</p>
        </div>
        <div class="connect-service-category-grid">
          {categories.map((category, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{category.name}</h3>
              <p>{category.detail}</p>
              <Check size={18} aria-hidden="true" />
            </article>
          ))}
        </div>
        <p class="connect-service-category-note">
          <strong>Repair Shops and Commercial Truck Repair is our first focused outbound commercial pilot.</strong> Beauty, fitness, and other service categories remain supported Beta verticals. Hermes Connect is being built as an independently operated platform around controlled service-business workflows, clear client handoffs, and reviewable product releases.
        </p>
      </div>
    </section>

    <section class="section connect-service-process" aria-labelledby="connect-process-title">
      <div class="shell connect-service-process-grid">
        <div>
          <p class="eyebrow">Connected development loop</p>
          <h2 id="connect-process-title">Your recurring need can become the next reviewed product task.</h2>
          <p>Applications are reviewed for patterns. Hermes converts repeated needs into bounded briefs, AI-assisted implementation, human review, automated tests, and controlled web releases.</p>
        </div>
        <ol>
          <li><span>01</span><div><strong>Request access</strong><small>Choose the category and describe one must-have workflow.</small></div></li>
          <li><span>02</span><div><strong>Human review</strong><small>Hermes checks fit, privacy boundaries, and repeated demand.</small></div></li>
          <li><span>03</span><div><strong>AI-assisted build</strong><small>Approved work is implemented on a reviewable branch with tests.</small></div></li>
          <li><span>04</span><div><strong>Controlled web release</strong><small>Verified changes move through CI with a rollback boundary.</small></div></li>
        </ol>
      </div>
    </section>

    <section class="section connect-service-faq" aria-labelledby="connect-faq-title">
      <div class="shell connect-service-faq-grid">
        <div>
          <p class="eyebrow">Hermes Connect FAQ</p>
          <h2 id="connect-faq-title">What the current Web App path does—and does not do.</h2>
          <p>These answers describe the controlled access release. Future integrations require separate scope, testing, and release approval.</p>
        </div>
        <div class="connect-service-faq-list">
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}<span aria-hidden="true">+</span></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <HermesConnectLauncher variant="banner" context="general" />

    <section class="connect-service-final" aria-labelledby="connect-final-title">
      <div class="shell connect-service-final-grid">
        <div>
          <p class="eyebrow hero-eyebrow">Hermes Connect Web App</p>
          <h2 id="connect-final-title">Choose your category and show us the client workflow that matters most.</h2>
          <p>The access request does not create an account, booking, payment, or subscription automatically. Hermes reviews the request before sending access instructions.</p>
        </div>
        <HermesConnectLauncher variant="inline" href="https://connect.hermeslogisticsus.com/#apply" label="Request Web App access" />
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>