---
import { ArrowRight, CheckCircle2, ShieldCheck, Sparkles, Wrench } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";

const verticals = [
  {
    id: "repair-shops",
    name: "Repair Shops",
    status: "LIVE PRODUCT",
    tone: "violet",
    body: "Bookings, services, availability, customers, vehicles, follow-up, and owner operations in one workspace.",
    modules: ["Bookings", "Services", "Customers", "Vehicles"],
    href: "/services/hermes-connect/repair-shops/",
  },
  {
    id: "logistics",
    name: "Logistics",
    status: "PREVIEW CONFIGURATION",
    tone: "blue",
    body: "Loads, carriers, dispatch, documents, freight decisions, and operating visibility around one shared workflow.",
    modules: ["Loads", "Carriers", "Dispatch", "Documents"],
  },
  {
    id: "marketing",
    name: "Marketing Agency",
    status: "PREVIEW CONFIGURATION",
    tone: "coral",
    body: "Leads, clients, content, campaigns, sales handoff, meetings, and AI-assisted follow-up in one operating view.",
    modules: ["Leads", "Clients", "Campaigns", "Pipeline"],
  },
  {
    id: "academy",
    name: "Academy & Training",
    status: "PREVIEW CONFIGURATION",
    tone: "gold",
    body: "Students, programs, assignments, practice, progress, coaching, and AI mentorship around measurable learning work.",
    modules: ["Students", "Programs", "Practice", "Progress"],
  },
  {
    id: "beauty",
    name: "Beauty & Wellness",
    status: "PREVIEW CONFIGURATION",
    tone: "rose",
    body: "Appointments, clients, services, specialists, repeat visits, reviews, and relationship management in one system.",
    modules: ["Appointments", "Clients", "Services", "Retention"],
  },
  {
    id: "fitness",
    name: "Fitness & Coaching",
    status: "PREVIEW CONFIGURATION",
    tone: "mint",
    body: "Members, sessions, programs, availability, progress, reminders, and client communication around the coaching journey.",
    modules: ["Members", "Sessions", "Programs", "Progress"],
  },
  {
    id: "real-estate",
    name: "Real Estate",
    status: "PREVIEW CONFIGURATION",
    tone: "sage",
    body: "Leads, properties, showings, follow-up, deals, documents, and client relationships in a recognizable Hermes workspace.",
    modules: ["Leads", "Properties", "Showings", "Deals"],
  },
  {
    id: "professional",
    name: "Professional Services",
    status: "PREVIEW CONFIGURATION",
    tone: "graphite",
    body: "Requests, clients, proposals, projects, tasks, documents, and follow-up for consultants and service businesses.",
    modules: ["Requests", "Clients", "Projects", "Tasks"],
  },
];

const labs = [
  { name: "AI Command Center", href: "/services/hermes-connect/ai-command-center/" },
  { name: "Unified Inbox", href: "/services/hermes-connect/unified-inbox/" },
  { name: "Load Analyzer", href: "/services/hermes-connect/load-analyzer/" },
  { name: "Rate Negotiator", href: "/services/hermes-connect/rate-negotiator/" },
  { name: "Proposal Builder", href: "/services/hermes-connect/proposal-builder/" },
  { name: "ROI Calculator", href: "/services/hermes-connect/roi-calculator/" },
  { name: "Business Automation", href: "/services/hermes-connect/business-automation/" },
];

const faqs = [
  {
    question: "Which Hermes Connect configuration is live today?",
    answer: "Repair Shops is the current live product vertical. The other industry configurations on this page are product previews that show how the shared Hermes workspace can adapt without implying that those verticals are released production runtimes.",
  },
  {
    question: "Is Hermes Connect one product or many separate apps?",
    answer: "One product family. The shared identity, workspace principles, intelligence layer, and operating model stay recognizable while terminology and workflows adapt to the selected business.",
  },
  {
    question: "Are the preview dashboards showing real customer data?",
    answer: "No. Product-preview dashboards and workflow examples use sample presentation data unless a surface is explicitly identified as a live product flow.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Hermes Connect",
    url: "https://hermeslogisticsus.com/services/hermes-connect/",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Modern web browser",
    description: "Hermes Connect is an adaptive AI operating-system product family for business. Repair Shops is the current live vertical; other industry configurations are product previews.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
    ],
  },
];
---

<BaseLayout
  title="Hermes Connect | AI Operating System for Business"
  description="Run your business with AI. Hermes Connect adapts one operating system to different business workflows, with Repair Shops as the current live product vertical."
  schema={schema}
>
  <SiteHeader activePath="/paths/technology/" theme="light" />

  <main id="main-content" class="hc-os-page hc-hub-page">
    <section class="hc-os-hero" aria-labelledby="hc-os-title">
      <div class="hc-os-shell hc-os-hero-grid">
        <div class="hc-os-copy">
          <p class="hc-os-eyebrow"><Sparkles size={14} aria-hidden="true" />AI operating system for business</p>
          <h1 id="hc-os-title">Run your business <span>with AI.</span></h1>
          <p class="hc-os-lead">
            One operating system for leads, bookings, customers, operations, and growth. Choose your business — Hermes adapts the workspace and workflow around how your team actually works.
          </p>
          <div class="hc-os-actions">
            <a class="hc-os-primary" href="/services/hermes-connect/repair-shops/"><Wrench size={18} aria-hidden="true" />Open Repair Shops <ArrowRight size={18} aria-hidden="true" /></a>
            <a class="hc-os-secondary" href="#choose-your-business">Choose your business</a>
          </div>
          <div class="hc-os-truth" aria-label="Current Hermes Connect product status">
            <span><CheckCircle2 size={15} aria-hidden="true" />Repair Shops is live</span>
            <span><ShieldCheck size={15} aria-hidden="true" />Other industries are previews</span>
            <span><CheckCircle2 size={15} aria-hidden="true" />One shared product family</span>
          </div>
        </div>

        <div class="hc-os-visual" aria-label="Hermes Connect product preview">
          <div class="hc-os-light-stage">
            <p class="hc-os-stage-label">Example AI workflow · sample presentation</p>
            <div class="hc-glass-knot" aria-hidden="true">
              <span class="hc-glass-loop hc-glass-loop-a"></span>
              <span class="hc-glass-loop hc-glass-loop-b"></span>
              <span class="hc-glass-loop hc-glass-loop-c"></span>
              <span class="hc-glass-core"></span>
            </div>
            <div class="hc-flow-rail" aria-hidden="true">
              <div><span class="hc-flow-dot"></span><p><strong>New customer request</strong><small>Signal received</small></p></div>
              <div><span class="hc-flow-dot"></span><p><strong>Hermes qualified it</strong><small>Intent + next step</small></p></div>
              <div><span class="hc-flow-dot"></span><p><strong>Booking confirmed</strong><small>Workflow example</small></p></div>
              <div><span class="hc-flow-dot"></span><p><strong>Follow-up prepared</strong><small>Human-review ready</small></p></div>
            </div>
          </div>

          <div class="hc-dashboard-preview">
            <div class="hc-dashboard-topbar"><span>HERMES CONNECT</span><span class="hc-sample-badge">WORKSPACE PREVIEW · SAMPLE DATA</span></div>
            <div class="hc-dashboard-body">
              <aside aria-hidden="true">
                <strong>H</strong>
                <span class="is-active">Home</span><span>Inbox</span><span>Calendar</span><span>Customers</span><span>Operations</span><span>AI Agents</span><span>Reports</span>
              </aside>
              <div class="hc-dashboard-main">
                <div class="hc-dashboard-welcome"><p>Good morning.</p><small>Here’s what needs attention today.</small></div>
                <div class="hc-dashboard-metrics">
                  <article><small>Bookings</small><strong>32</strong><span>sample</span></article>
                  <article><small>New leads</small><strong>18</strong><span>sample</span></article>
                  <article><small>AI conversations</small><strong>43</strong><span>sample</span></article>
                </div>
                <div class="hc-dashboard-panels">
                  <article><small>AI agents</small><p><span></span>Reception workflow <b>Preview</b></p><p><span></span>Sales workflow <b>Preview</b></p><p><span></span>Operations workflow <b>Preview</b></p></article>
                  <article class="hc-chart-card"><small>Activity overview</small><div class="hc-chart-line" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div><p>Sample visualization</p></article>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="hc-os-section hc-vertical-section" id="choose-your-business" aria-labelledby="vertical-title">
      <div class="hc-os-shell">
        <div class="hc-section-heading">
          <div>
            <p class="hc-os-kicker">Adaptive by business</p>
            <h2 id="vertical-title">One system. Different business realities.</h2>
          </div>
          <p>Select the business model. The language, modules, and operating emphasis change while Hermes stays recognizable.</p>
        </div>

        <div class="hc-vertical-grid">
          {verticals.map((vertical) => (
            <article class={`hc-vertical-card hc-tone-${vertical.tone} ${vertical.href ? "is-live" : "is-preview"}`}>
              <div class="hc-vertical-card-top">
                <span class="hc-vertical-status">{vertical.status}</span>
                <span class="hc-vertical-number">{String(verticals.indexOf(vertical) + 1).padStart(2, "0")}</span>
              </div>
              <h3>{vertical.name}</h3>
              <p>{vertical.body}</p>
              <div class="hc-module-chips" aria-label={`${vertical.name} example modules`}>
                {vertical.modules.map((module) => <span>{module}</span>)}
              </div>
              {vertical.href ? (
                <a href={vertical.href}>Open live product <ArrowRight size={16} aria-hidden="true" /></a>
              ) : (
                <span class="hc-preview-note">Configuration preview · not a released vertical</span>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hc-workspace-section" aria-labelledby="workspace-title">
      <div class="hc-os-shell">
        <div class="hc-workspace-heading">
          <p class="hc-os-kicker">One Hermes workspace</p>
          <h2 id="workspace-title">Pearl outside. Obsidian where work gets serious.</h2>
          <p>The public experience explains the system. The working environment stays calm, dense, and operational. Business terminology changes; the product identity does not.</p>
        </div>

        <div class="hc-workspace-frame">
          <div class="hc-workspace-sidebar" aria-hidden="true">
            <div class="hc-mini-mark">H</div>
            <span class="active">Home</span><span>Inbox</span><span>Calendar</span><span>Customers</span><span>Operations</span><span>AI Agents</span><span>Analytics</span><span>Reports</span><span>Settings</span>
          </div>
          <div class="hc-workspace-content">
            <div class="hc-workspace-bar"><div><small>REPAIR SHOPS · LIVE PRODUCT</small><strong>Owner workspace</strong></div><span>Sample shell</span></div>
            <div class="hc-workspace-cards">
              <article><small>Today</small><strong>8 bookings</strong><p>Appointments and service workflow</p></article>
              <article><small>Availability</small><strong>2 open windows</strong><p>Booking hours and capacity</p></article>
              <article><small>Customers</small><strong>18 active</strong><p>Booking-derived relationship view</p></article>
              <article class="hc-ai-panel"><small>Hermes Intelligence</small><strong>What needs attention next?</strong><ul><li>Review 2 new requests</li><li>Confirm tomorrow’s schedule</li><li>Follow up with 3 recent customers</li></ul><span>Illustrative UI — not autonomous action</span></article>
            </div>
          </div>
        </div>

        <div class="hc-config-strip" aria-label="How the workspace adapts by business">
          <article><strong>Repair Shops</strong><span>Bookings · Services · Vehicles</span></article>
          <article><strong>Logistics</strong><span>Loads · Carriers · Dispatch</span></article>
          <article><strong>Marketing</strong><span>Leads · Campaigns · Pipeline</span></article>
          <article><strong>Academy</strong><span>Students · Practice · Progress</span></article>
          <article><strong>Beauty</strong><span>Appointments · Clients · Retention</span></article>
          <article><strong>Real Estate</strong><span>Properties · Showings · Deals</span></article>
        </div>
      </div>
    </section>

    <section class="hc-os-section hc-labs-section" aria-labelledby="labs-title">
      <div class="hc-os-shell hc-labs-grid">
        <div>
          <p class="hc-os-kicker">Hermes Connect Labs</p>
          <h2 id="labs-title">Capabilities stay visible without pretending they are separate live products.</h2>
          <p>These reference modules help test product ideas. They remain subordinate to the current Repair Shops live vertical until each capability has production evidence.</p>
        </div>
        <div class="hc-lab-links">
          {labs.map((lab) => <a href={lab.href}><span>REFERENCE</span>{lab.name}<ArrowRight size={15} aria-hidden="true" /></a>)}
        </div>
      </div>
    </section>

    <section class="hc-os-section hc-truth-section" aria-labelledby="truth-title">
      <div class="hc-os-shell">
        <div class="hc-section-heading compact">
          <div><p class="hc-os-kicker">Product truth</p><h2 id="truth-title">Clear status. No fake live surface.</h2></div>
          <p>Preview UI is labeled as preview or sample data. Repair Shops remains the only current live vertical on this product hub.</p>
        </div>
        <div class="hc-faq-grid">
          {faqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style is:global>
  .hc-experience body:has(.hc-os-page) .hc-intelligence-core{display:none!important}
</style>

<style>
  :global(html){scroll-behavior:smooth}
  .hc-os-page{--pearl:#f7f6f3;--paper:#fffdfa;--ink:#0b0d12;--muted:#646b78;--violet:#7c5cff;--blue:#5ac8fa;--line:rgba(11,13,18,.09);color:var(--ink);background:var(--pearl)}
  .hc-os-shell{width:min(1420px,calc(100% - 2.4rem));margin:0 auto}
  .hc-os-hero{overflow:hidden;padding:clamp(7.6rem,10vw,9rem) 0 1.5rem;background:radial-gradient(circle at 40% 38%,rgba(124,92,255,.11),transparent 24rem),radial-gradient(circle at 55% 30%,rgba(90,200,250,.08),transparent 22rem),var(--pearl)}
  .hc-os-hero-grid{display:grid;grid-template-columns:minmax(360px,.78fr) minmax(640px,1.42fr);gap:clamp(1.5rem,3vw,3.2rem);align-items:center;min-height:640px}
  .hc-os-copy{position:relative;z-index:2;padding:2rem 0}
  .hc-os-eyebrow,.hc-os-kicker{display:flex;align-items:center;gap:.45rem;margin:0 0 .9rem;color:#6550d8;font-size:.72rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}
  .hc-os-copy h1{max-width:620px;margin:0;font-size:clamp(4rem,7vw,7.3rem);line-height:.88;letter-spacing:-.07em;text-wrap:balance}
  .hc-os-copy h1 span{display:block;background:linear-gradient(90deg,#765cff 0%,#5aa7ff 58%,#5ac8fa 100%);background-clip:text;-webkit-background-clip:text;color:transparent}
  .hc-os-lead{max-width:610px;margin:1.45rem 0 0;color:var(--muted);font-size:clamp(1.02rem,1.5vw,1.18rem);line-height:1.68}
  .hc-os-actions{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.7rem}
  .hc-os-primary,.hc-os-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:48px;padding:.78rem 1.08rem;border-radius:14px;text-decoration:none;font-weight:780;transition:transform .18s ease,box-shadow .18s ease}
  .hc-os-primary{color:#fff;background:#0b0d12;box-shadow:0 14px 32px rgba(11,13,18,.14)}
  .hc-os-secondary{color:#0b0d12;border:1px solid rgba(11,13,18,.12);background:rgba(255,255,255,.66)}
  .hc-os-primary:hover,.hc-os-secondary:hover{transform:translateY(-1px)}
  .hc-os-truth{display:flex;gap:.45rem;flex-wrap:wrap;margin-top:1.25rem;color:#69707d;font-size:.76rem}
  .hc-os-truth span{display:inline-flex;align-items:center;gap:.34rem}.hc-os-truth svg{color:#2da77f}

  .hc-os-visual{position:relative;display:grid;grid-template-columns:minmax(330px,.92fr) minmax(400px,1.08fr);min-height:570px;border:1px solid rgba(11,13,18,.08);border-radius:32px;overflow:hidden;background:#fff;box-shadow:0 35px 100px rgba(49,39,96,.12)}
  .hc-os-light-stage{position:relative;min-height:570px;overflow:hidden;background:radial-gradient(circle at 48% 48%,rgba(124,92,255,.12),transparent 15rem),linear-gradient(160deg,#fffdfa 0%,#f8f7f4 62%,#f0eff6 100%)}
  .hc-os-stage-label{position:absolute;z-index:3;top:1.2rem;left:1.25rem;margin:0;color:#8a909b;font-size:.66rem;font-weight:780;letter-spacing:.08em;text-transform:uppercase}
  .hc-glass-knot{position:absolute;left:7%;top:19%;width:290px;height:290px;filter:drop-shadow(0 32px 32px rgba(88,68,155,.17));animation:hc-glass-float 7.5s ease-in-out infinite}
  .hc-glass-loop{position:absolute;left:50%;top:50%;width:215px;height:112px;border:24px solid rgba(255,255,255,.48);border-radius:999px;box-shadow:inset 8px 8px 20px rgba(255,255,255,.9),inset -10px -8px 18px rgba(92,113,255,.16),0 0 0 1px rgba(124,92,255,.16),0 14px 30px rgba(91,75,170,.14);backdrop-filter:blur(5px);transform-origin:center}
  .hc-glass-loop::after{position:absolute;inset:-18px;border-radius:inherit;background:linear-gradient(115deg,rgba(124,92,255,.18),rgba(90,200,250,.16) 48%,rgba(255,210,183,.18));filter:blur(12px);content:"";z-index:-1}
  .hc-glass-loop-a{transform:translate(-50%,-50%) rotate(34deg)}.hc-glass-loop-b{transform:translate(-50%,-50%) rotate(-38deg);border-color:rgba(237,235,255,.58)}.hc-glass-loop-c{width:184px;height:94px;transform:translate(-50%,-50%) rotate(92deg);border-width:21px;opacity:.78}
  .hc-glass-core{position:absolute;left:50%;top:50%;width:54px;height:54px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 8%,#d7d0ff 28%,rgba(124,92,255,.58) 62%,rgba(90,200,250,.24));box-shadow:0 0 48px rgba(124,92,255,.25);transform:translate(-50%,-50%)}
  .hc-flow-rail{position:absolute;z-index:4;right:1rem;top:50%;display:grid;gap:.6rem;width:min(225px,48%);transform:translateY(-50%)}
  .hc-flow-rail>div{position:relative;display:flex;gap:.65rem;align-items:center;padding:.72rem .82rem;border:1px solid rgba(11,13,18,.07);border-radius:13px;background:rgba(255,255,255,.88);box-shadow:0 10px 24px rgba(42,32,90,.07);backdrop-filter:blur(12px)}
  .hc-flow-rail>div:not(:last-child)::after{position:absolute;left:1.05rem;top:100%;width:1px;height:.62rem;background:linear-gradient(#8b73ff,#66b9ff);content:""}.hc-flow-dot{width:9px;height:9px;flex:0 0 auto;border-radius:50%;background:linear-gradient(135deg,#7c5cff,#5ac8fa);box-shadow:0 0 0 4px rgba(124,92,255,.09)}
  .hc-flow-rail p{display:grid;gap:.12rem;margin:0}.hc-flow-rail strong{font-size:.72rem}.hc-flow-rail small{color:#858b97;font-size:.62rem}

  .hc-dashboard-preview{min-width:0;color:#eef2f7;background:radial-gradient(circle at 88% 10%,rgba(124,92,255,.11),transparent 18rem),#090d14}
  .hc-dashboard-topbar{display:flex;justify-content:space-between;gap:.5rem;align-items:center;padding:1rem 1.1rem;border-bottom:1px solid rgba(255,255,255,.07);font-size:.63rem;font-weight:800;letter-spacing:.08em}.hc-sample-badge{color:#93a0b3;font-size:.53rem}
  .hc-dashboard-body{display:grid;grid-template-columns:92px 1fr;min-height:510px}
  .hc-dashboard-body aside{display:grid;align-content:start;gap:.45rem;padding:1rem .65rem;border-right:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.018)}
  .hc-dashboard-body aside strong{display:grid;place-items:center;width:30px;height:30px;margin-bottom:.3rem;border:1px solid rgba(255,255,255,.14);border-radius:9px;color:#b7aaff}.hc-dashboard-body aside span{padding:.45rem .5rem;border-radius:7px;color:#8995a7;font-size:.58rem}.hc-dashboard-body aside .is-active{color:#fff;background:rgba(124,92,255,.12)}
  .hc-dashboard-main{padding:1.2rem}.hc-dashboard-welcome p{margin:0;font-size:1.1rem;font-weight:750}.hc-dashboard-welcome small{color:#8490a3;font-size:.65rem}
  .hc-dashboard-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;margin-top:1rem}.hc-dashboard-metrics article,.hc-dashboard-panels article{border:1px solid rgba(255,255,255,.07);border-radius:12px;background:rgba(255,255,255,.025)}.hc-dashboard-metrics article{display:grid;gap:.18rem;padding:.75rem}.hc-dashboard-metrics small,.hc-dashboard-panels small{color:#8490a3;font-size:.58rem}.hc-dashboard-metrics strong{font-size:1.18rem}.hc-dashboard-metrics span{color:#60d1a8;font-size:.53rem}
  .hc-dashboard-panels{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-top:.65rem}.hc-dashboard-panels article{min-height:165px;padding:.82rem}.hc-dashboard-panels p{display:flex;align-items:center;gap:.4rem;margin:.72rem 0;color:#cad2de;font-size:.62rem}.hc-dashboard-panels p span{width:7px;height:7px;border-radius:50%;background:#7c5cff}.hc-dashboard-panels b{margin-left:auto;color:#69d4ad;font-size:.5rem;font-weight:700}.hc-chart-card p{color:#6f7b8f!important}.hc-chart-line{display:flex;align-items:end;gap:5px;height:84px;padding-top:1rem}.hc-chart-line i{flex:1;border-radius:4px 4px 1px 1px;background:linear-gradient(#7c5cff,#4c7cff)}.hc-chart-line i:nth-child(1){height:24%}.hc-chart-line i:nth-child(2){height:42%}.hc-chart-line i:nth-child(3){height:38%}.hc-chart-line i:nth-child(4){height:62%}.hc-chart-line i:nth-child(5){height:56%}.hc-chart-line i:nth-child(6){height:82%}

  .hc-os-section{padding:clamp(4.5rem,7vw,7rem) 0}.hc-section-heading{display:grid;grid-template-columns:1fr minmax(280px,.55fr);gap:2rem;align-items:end;margin-bottom:2rem}.hc-section-heading>div{max-width:850px}.hc-section-heading h2,.hc-workspace-heading h2,.hc-labs-grid h2{margin:0;font-size:clamp(2.7rem,5.5vw,5.7rem);line-height:.92;letter-spacing:-.065em;text-wrap:balance}.hc-section-heading>p,.hc-workspace-heading>p,.hc-labs-grid>div>p{max-width:590px;margin:0;color:var(--muted);font-size:1rem;line-height:1.7}.hc-section-heading.compact h2{font-size:clamp(2.4rem,4.2vw,4rem)}
