---
import { ArrowRight, CheckCircle2, ShieldCheck, Wrench } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";

const modules = [
  { name: "Repair Shops", href: "/services/hermes-connect/repair-shops/", status: "Current live pilot", body: "Owner registration, shop profile, services, availability, public booking, booking operations, customers, private feedback, and corporate partner intake." },
  { name: "AI Command Center", href: "/services/hermes-connect/ai-command-center/", status: "Reference capability", body: "Decision-layer concept for request classification, prioritization, and recommended next actions." },
  { name: "Unified Inbox", href: "/services/hermes-connect/unified-inbox/", status: "Reference capability", body: "Shared intake and lifecycle concept for approved business-request sources." },
  { name: "Load Analyzer", href: "/services/hermes-connect/load-analyzer/", status: "Reference capability", body: "Freight decision-support concept for RPM, cost, deadhead, driver-pay, and margin estimates." },
  { name: "Rate Negotiator", href: "/services/hermes-connect/rate-negotiator/", status: "Reference capability", body: "Human-controlled counter-offer drafting concept for freight negotiation." },
  { name: "Proposal Builder", href: "/services/hermes-connect/proposal-builder/", status: "Reference capability", body: "Structured proposal assembly without publishing historical subscription pricing as current." },
  { name: "ROI Calculator", href: "/services/hermes-connect/roi-calculator/", status: "Reference capability", body: "Scenario modeling for time savings and potential revenue recovery using explicit assumptions." },
  { name: "Business Automation", href: "/services/hermes-connect/business-automation/", status: "Reference capability", body: "Reusable workflow patterns for future verified verticals without creating product forks." },
];

const faqs = [
  { question: "What is the current live Hermes Connect product?", answer: "Repair Shops is the current live pilot. Other listed modules are reference capabilities and are not presented as separate production runtimes." },
  { question: "Does Hermes Connect currently publish Starter, Pro, or Enterprise subscription pricing?", answer: "No current public Hermes Connect subscription pricing is published on this product family. Historical planning prices are not treated as live commercial offers." },
  { question: "Is there a separate Brand V1 or second workspace users should open?", answer: "No. The website presents one canonical Hermes Connect product family. Preserved legacy surfaces are compatibility or historical assets, not the primary product path." },
  { question: "Is Hermes Connect available as a public mobile-store release?", answer: "The current product path is browser-first and responsive. No App Store, Google Play, or public APK release is claimed here." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Hermes Connect",
    url: "https://hermeslogisticsus.com/services/hermes-connect/",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Modern web browser",
    description: "Hermes Connect is one product family. Repair Shops is the current live pilot; other modules are reference capabilities pending production verification.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
  },
];
---

<BaseLayout
  title="Hermes Connect | Product Family & Repair Shop Live Pilot"
  description="Hermes Connect is one product family. Repair Shops is the current live pilot; other modules are reference capabilities pending production verification."
  schema={schema}
>
  <SiteHeader activePath="/paths/technology/" />

  <main id="main-content" class="hc-hub-page">
    <section class="hc-hub-hero">
      <div class="hc-hub-shell">
        <p class="hc-kicker">Hermes Connect · Product family</p>
        <h1>One product family. One current live pilot.</h1>
        <p class="hc-hub-lead">Repair Shops is the active Hermes Connect product path today. The rest of the family remains visible as reference capabilities so useful concepts can be evaluated without being confused with released production functionality.</p>
        <div class="hc-hub-actions">
          <a class="hc-hub-primary" href="/services/hermes-connect/repair-shops/"><Wrench size={18} aria-hidden="true" />Open Repair Shops <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="hc-hub-secondary" href="/services/hermes-connect/repair-shops/auth/">Owner Login / Get Started</a>
        </div>
        <div class="hc-hub-trust">
          <span><CheckCircle2 size={16} aria-hidden="true" />Canonical browser-based product family</span>
          <span><CheckCircle2 size={16} aria-hidden="true" />No historical pricing presented as current</span>
          <span><ShieldCheck size={16} aria-hidden="true" />Live vs reference status is explicit</span>
        </div>
      </div>
    </section>

    <section class="hc-hub-section" aria-labelledby="family-title">
      <div class="hc-hub-shell">
        <div class="hc-hub-heading">
          <p class="hc-kicker">Product hierarchy</p>
          <h2 id="family-title">Every Hermes Connect module has one clear status.</h2>
        </div>
        <div class="hc-module-grid">
          {modules.map((module) => (
            <article class={module.name === "Repair Shops" ? "is-live" : "is-reference"}>
              <div class="hc-module-status">{module.status}</div>
              <h3><a href={module.href}>{module.name} <ArrowRight size={15} aria-hidden="true" /></a></h3>
              <p>{module.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hc-hub-section" aria-labelledby="rules-title">
      <div class="hc-hub-shell hc-rules">
        <div>
          <p class="hc-kicker">Release rules</p>
          <h2 id="rules-title">What we will not imply before it is verified.</h2>
        </div>
        <ul>
          <li>Reference capability does not mean public beta, live integration, or production runtime.</li>
          <li>No current subscription price is published until commercial terms are explicitly approved.</li>
          <li>No mocked success state is presented as completed delivery, approval, payment, or external message.</li>
          <li>No Brand V1, old workspace, or mobile-store path is presented as the primary Hermes Connect product.</li>
        </ul>
      </div>
    </section>

    <section class="hc-hub-section hc-faq-section" aria-labelledby="hub-faq-title">
      <div class="hc-hub-shell">
        <div class="hc-hub-heading"><p class="hc-kicker">Product clarity</p><h2 id="hub-faq-title">Frequently asked questions</h2></div>
        <div class="hc-hub-faq-grid">
          {faqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hc-hub-page{color:#f8fafc;min-height:70vh}.hc-hub-shell{width:min(1160px,calc(100% - 2rem));margin:0 auto}.hc-hub-hero{padding:clamp(3.5rem,8vw,7rem) 0 4rem;background:radial-gradient(circle at 20% 10%,rgba(90,200,250,.12),transparent 30rem),radial-gradient(circle at 80% 20%,rgba(157,136,255,.14),transparent 32rem)}
  .hc-kicker{margin:0 0 .65rem;color:#9d88ff;font-size:.78rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.hc-hub-hero h1{max-width:900px;margin:0;font-size:clamp(2.7rem,7vw,5.8rem);line-height:.98;letter-spacing:-.055em}.hc-hub-lead{max-width:800px;margin:1.35rem 0 0;color:#aeb9cb;font-size:clamp(1.05rem,2vw,1.25rem);line-height:1.7}
  .hc-hub-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.6rem}.hc-hub-primary,.hc-hub-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:46px;padding:.75rem 1rem;border-radius:11px;text-decoration:none;font-weight:750}.hc-hub-primary{background:linear-gradient(135deg,#8b5cf6,#5ac8fa);color:#07101c}.hc-hub-secondary{color:#f8fafc;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.035)}
  .hc-hub-trust{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.4rem;color:#aeb9cb;font-size:.82rem}.hc-hub-trust span{display:inline-flex;align-items:center;gap:.4rem}.hc-hub-trust svg{color:#34d399}.hc-hub-section{padding:3.5rem 0}.hc-hub-heading{max-width:760px;margin-bottom:1.4rem}.hc-hub-heading h2,.hc-rules h2{margin:0;font-size:clamp(1.7rem,4vw,2.8rem);letter-spacing:-.035em}
  .hc-module-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.hc-module-grid article,.hc-hub-faq-grid article{padding:1.25rem;border:1px solid rgba(255,255,255,.09);border-radius:18px;background:linear-gradient(160deg,rgba(255,255,255,.045),rgba(255,255,255,.018));box-shadow:0 18px 55px rgba(0,0,0,.16)}.hc-module-grid article.is-live{border-color:rgba(52,211,153,.32);background:linear-gradient(160deg,rgba(52,211,153,.08),rgba(255,255,255,.018))}.hc-module-status{margin-bottom:.75rem;color:#fbbf24;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.is-live .hc-module-status{color:#6ee7b7}.hc-module-grid h3{margin:0 0 .55rem}.hc-module-grid h3 a{display:inline-flex;align-items:center;gap:.3rem;color:#f8fafc;text-decoration:none}.hc-module-grid p,.hc-hub-faq-grid p{margin:0;color:#98a6bb;line-height:1.6;font-size:.9rem}
  .hc-rules{display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem;padding:2rem;border:1px solid rgba(157,136,255,.18);border-radius:20px;background:rgba(157,136,255,.045)}.hc-rules ul{margin:0;padding-left:1.2rem;color:#aeb9cb;line-height:1.75}.hc-hub-faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.hc-hub-faq-grid h3{margin:0 0 .5rem;font-size:1rem}
  @media(max-width:900px){.hc-module-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hc-rules{grid-template-columns:1fr}}
  @media(max-width:620px){.hc-hub-shell{width:min(100% - 1rem,1160px)}.hc-module-grid,.hc-hub-faq-grid{grid-template-columns:1fr}.hc-hub-actions{flex-direction:column}.hc-hub-primary,.hc-hub-secondary{width:100%}.hc-hub-trust{flex-direction:column}.hc-rules{padding:1.25rem}}
</style>
