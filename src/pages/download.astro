---
import { ArrowRight, MonitorSmartphone, ShieldCheck, UserRound, Wrench } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { languageAlternates } from "../data/locales";

const title = "Hermes Connect Access Center | Repair Shop Partner Beta";
const description = "Open the current Hermes Connect Repair Shop Partner Beta in a browser. Mobile store and APK distribution are not part of the current release.";
const canonicalUrl = "https://hermeslogisticsus.com/download/";

const faqs = [
  {
    question: "What can I use in Hermes Connect now?",
    answer: "Repair Shop Partner Beta is the current live pilot. A shop owner can register, configure the shop profile, services and hours, share a public booking link, process bookings, manage customers, submit private feedback, and send a consented corporate partner offer."
  },
  {
    question: "Is the Hermes Connect Android APK available?",
    answer: "No public Android APK is part of the current release. The current product is browser-first. Historical mobile source is preserved for technical salvage and release research, not for public distribution."
  },
  {
    question: "Do I need an App Store or Google Play installation?",
    answer: "No. The current Repair Shop beta is a responsive Web App and is intended to be used directly in a modern browser on desktop, tablet, or phone."
  },
  {
    question: "Are the other Hermes Connect modules live products?",
    answer: "No. Other Hermes Connect modules are capability demos unless explicitly labeled otherwise. Repair Shops are the current live pilot and the priority for real-user testing."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Hermes Connect Repair Shop Partner Beta access",
    description,
    url: canonicalUrl,
    provider: {
      "@type": "Organization",
      name: "Hermes Logistics",
      url: "https://hermeslogisticsus.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
      { "@type": "ListItem", position: 3, name: "Access", item: canonicalUrl }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer }
    }))
  }
];
---

<BaseLayout title={title} description={description} alternates={languageAlternates} schema={schema}>
  <SiteHeader />

  <main id="main-content" class="connect-access-page">
    <section class="access-hero">
      <div class="shell access-hero-grid">
        <div>
          <p class="access-kicker">Hermes Connect · Current beta</p>
          <h1>Repair Shop Partner Beta is the current live product.</h1>
          <p class="access-lede">Use the canonical Hermes Connect Web App in your browser. Repair Shops are the active real-user pilot; older workspace and mobile experiments are not the primary product entry.</p>
          <div class="access-actions">
            <a class="access-primary" href="/services/hermes-connect/repair-shops/">Open Repair Shop Partner Beta <ArrowRight size={18} aria-hidden="true" /></a>
            <a class="access-secondary" href="/services/hermes-connect/repair-shops/auth/">Owner Login / Get Started</a>
          </div>
          <div class="access-trust">
            <span><ShieldCheck size={17} aria-hidden="true" />Canonical browser route</span>
            <span><MonitorSmartphone size={17} aria-hidden="true" />Desktop + mobile responsive</span>
            <span><Wrench size={17} aria-hidden="true" />Repair Shop live pilot</span>
          </div>
        </div>

        <aside class="access-status-card" aria-label="Hermes Connect current release status">
          <span class="status-pill">CURRENT BETA · LIVE PILOT</span>
          <h2>What managers should share</h2>
          <ol>
            <li><strong>1.</strong><span>Send the Repair Shop Partner Beta link.</span></li>
            <li><strong>2.</strong><span>The owner registers or logs in.</span></li>
            <li><strong>3.</strong><span>The owner adds shop profile, services, and hours.</span></li>
            <li><strong>4.</strong><span>The shop shares its public booking link with a customer.</span></li>
          </ol>
        </aside>
      </div>
    </section>

    <section class="access-section">
      <div class="shell">
        <div class="access-heading">
          <p class="access-kicker">Current access paths</p>
          <h2>Use the live Repair Shop workflow. Keep experiments out of the customer path.</h2>
        </div>
        <div class="access-grid">
          <article>
            <UserRound size={24} aria-hidden="true" />
            <span>SHOP OWNER</span>
            <h3>Owner workspace</h3>
            <p>Register, manage the shop profile, services, availability, customers, booking statuses, and private feedback.</p>
            <a href="/services/hermes-connect/repair-shops/auth/">Open owner access <ArrowRight size={16} aria-hidden="true" /></a>
          </article>
          <article>
            <Wrench size={24} aria-hidden="true" />
            <span>REPAIR SHOP</span>
            <h3>Partner Beta</h3>
            <p>Use the current product landing page for shop onboarding, partnership context, and the real corporate partner offer.</p>
            <a href="/services/hermes-connect/repair-shops/">Open Repair Shop Beta <ArrowRight size={16} aria-hidden="true" /></a>
          </article>
          <article class="mobile-status-card">
            <MonitorSmartphone size={24} aria-hidden="true" />
            <span>MOBILE STATUS</span>
            <h3>Browser-first release</h3>
            <p>No public APK, App Store, or Google Play release is part of the current pilot. Historical mobile source remains preserved for later technical salvage only.</p>
            <strong>NO PUBLIC MOBILE RELEASE</strong>
          </article>
        </div>
      </div>
    </section>

    <section class="access-faq">
      <div class="shell access-faq-grid">
        <div>
          <p class="access-kicker">Access FAQ</p>
          <h2>Current product boundaries</h2>
          <p>These answers distinguish the live Repair Shop beta from retained demos and historical mobile experiments.</p>
        </div>
        <div>
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}<span aria-hidden="true">+</span></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .connect-access-page {
    min-height: 100vh;
    color: #f8fafc;
    background:
      radial-gradient(circle at 10% 0%, rgba(90, 200, 250, 0.1), transparent 28rem),
      radial-gradient(circle at 90% 10%, rgba(157, 136, 255, 0.12), transparent 32rem),
      #090d16;
  }
  .access-hero { padding: 7rem 0 4.5rem; border-bottom: 1px solid rgba(255,255,255,.08); }
  .access-hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); gap: 3rem; align-items: center; }
  .access-kicker { margin: 0 0 .75rem; color: #8dd7ff; font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 800px; margin: 0; font-size: clamp(2.6rem, 6vw, 5rem); line-height: .98; letter-spacing: -.045em; }
  .access-lede { max-width: 740px; margin: 1.4rem 0 0; color: rgba(248,250,252,.72); font-size: 1.08rem; line-height: 1.7; }
  .access-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.8rem; }
  .access-primary, .access-secondary { display: inline-flex; align-items: center; gap: .45rem; padding: .8rem 1rem; border-radius: 10px; font-weight: 750; text-decoration: none; }
  .access-primary { background: linear-gradient(135deg,#6d28d9,#4c1d95); color: #fff; }
  .access-secondary { border: 1px solid rgba(255,255,255,.16); color: #f8fafc; background: rgba(255,255,255,.04); }
  .access-trust { display: flex; flex-wrap: wrap; gap: .65rem 1rem; margin-top: 1.5rem; color: rgba(248,250,252,.7); font-size: .82rem; }
  .access-trust span { display: inline-flex; align-items: center; gap: .35rem; }
  .access-status-card, .access-grid article { border: 1px solid rgba(255,255,255,.1); border-radius: 20px; background: rgba(13,19,32,.72); box-shadow: 0 24px 70px rgba(0,0,0,.28); }
  .access-status-card { padding: 1.4rem; }
  .status-pill { display: inline-flex; padding: .35rem .55rem; border-radius: 999px; color: #6ee7b7; background: rgba(52,211,153,.1); border: 1px solid rgba(52,211,153,.25); font-size: .7rem; font-weight: 850; letter-spacing: .06em; }
  .access-status-card h2 { margin: 1rem 0; font-size: 1.35rem; }
  .access-status-card ol { display: grid; gap: .75rem; padding: 0; margin: 0; list-style: none; }
  .access-status-card li { display: grid; grid-template-columns: 2rem 1fr; gap: .65rem; color: rgba(248,250,252,.75); }
  .access-status-card li strong { color: #9d88ff; }
  .access-section { padding: 4.5rem 0; }
  .access-heading { max-width: 780px; margin-bottom: 1.8rem; }
  .access-heading h2, .access-faq h2 { margin: 0; font-size: clamp(1.9rem,4vw,3rem); letter-spacing: -.03em; }
  .access-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .access-grid article { padding: 1.3rem; }
  .access-grid article > span { display: block; margin-top: 1rem; color: #8dd7ff; font-size: .7rem; font-weight: 800; letter-spacing: .08em; }
  .access-grid h3 { margin: .45rem 0; font-size: 1.25rem; }
  .access-grid p { color: rgba(248,250,252,.68); line-height: 1.6; }
  .access-grid a { display: inline-flex; align-items: center; gap: .35rem; color: #c4b5fd; font-weight: 700; text-decoration: none; }
  .mobile-status-card strong { color: #fbbf24; font-size: .78rem; }
  .access-faq { padding: 1rem 0 6rem; }
  .access-faq-grid { display: grid; grid-template-columns: .75fr 1.25fr; gap: 3rem; }
  .access-faq-grid > div:first-child p:last-child { color: rgba(248,250,252,.65); line-height: 1.6; }
  details { border-top: 1px solid rgba(255,255,255,.1); padding: 1rem 0; }
  summary { display: flex; justify-content: space-between; gap: 1rem; cursor: pointer; font-weight: 750; }
  details p { color: rgba(248,250,252,.68); line-height: 1.65; }
  @media (max-width: 820px) {
    .access-hero { padding-top: 5.5rem; }
    .access-hero-grid, .access-grid, .access-faq-grid { grid-template-columns: 1fr; }
    .access-hero-grid, .access-faq-grid { gap: 1.5rem; }
  }
</style>