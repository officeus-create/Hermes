---
import { ArrowRight, CheckCircle2, MonitorSmartphone, ShieldCheck, Wrench } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

const faqs = [
  { question: "What Hermes Connect access is available now?", answer: "The current supported product path is the responsive Repair Shop Web App in a modern browser. Shop owners can register or sign in from the canonical Hermes Connect Repair Shops flow." },
  { question: "Is there a public Android APK or app-store release?", answer: "No public mobile-store or direct APK release is currently presented as available. Mobile users should use the responsive browser experience while release verification remains separate." },
  { question: "Can I add Hermes Connect to my home screen?", answer: "Where the browser supports standard Add to Home Screen behavior, you may use that browser feature. The website does not simulate a successful native installation." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Hermes Connect Access Center",
    url: "https://hermeslogisticsus.com/download/",
    description: "Current browser-first access to the Hermes Connect Repair Shop live pilot, with clear mobile distribution boundaries.",
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Hermes Connect Repair Shop Web App Access",
    serviceType: "Browser-based repair shop operations software access",
    provider: { "@type": "Organization", name: "Hermes Logistics LLC", url: "https://hermeslogisticsus.com/" },
    url: "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/",
    description: "Browser-first access to the current Hermes Connect Repair Shop live pilot. No native mobile-store release or subscription offer is claimed here.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
      { "@type": "ListItem", position: 3, name: "Access Center", item: "https://hermeslogisticsus.com/download/" },
    ],
  },
];
---

<BaseLayout
  title="Hermes Connect Access Center | Current Web App"
  description="Open the current Hermes Connect Repair Shop Web App in your browser. Public mobile-store and direct APK distribution are not currently released."
  schema={schema}
>
  <SiteHeader />

  <main id="main-content" class="hc-access-page">
    <section class="hc-access-hero">
      <div class="hc-access-shell">
        <p class="hc-access-kicker">Hermes Connect · Access Center</p>
        <h1>Use the current product in your browser.</h1>
        <p class="hc-access-lead">Repair Shops is the current Hermes Connect live pilot. Desktop, tablet, and mobile users use the same responsive product family—without a separate legacy workspace or an unverified native-app promise.</p>
        <div class="hc-access-actions">
          <a class="hc-access-primary" href="/services/hermes-connect/repair-shops/"><Wrench size={18} aria-hidden="true" />Open Repair Shops <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="hc-access-secondary" href="/services/hermes-connect/repair-shops/auth/">Owner Login / Get Started</a>
        </div>
      </div>
    </section>

    <section class="hc-access-section" aria-labelledby="access-options-title">
      <div class="hc-access-shell">
        <div class="hc-access-heading"><p class="hc-access-kicker">Current distribution</p><h2 id="access-options-title">One supported access path, clear device guidance.</h2></div>
        <div class="hc-access-grid">
          <article class="is-current">
            <MonitorSmartphone size={26} aria-hidden="true" />
            <div class="hc-access-status">Current</div>
            <h3>Responsive Web App</h3>
            <p>Use the canonical Repair Shop product in a modern browser on desktop, tablet, iPhone, or Android.</p>
            <a href="/services/hermes-connect/repair-shops/">Open current product <ArrowRight size={15} aria-hidden="true" /></a>
          </article>
          <article>
            <CheckCircle2 size={26} aria-hidden="true" />
            <div class="hc-access-status">Browser feature</div>
            <h3>Add to Home Screen</h3>
            <p>If your browser provides a standard Add to Home Screen option, you may use it as a shortcut. Hermes does not report a simulated install as successful.</p>
          </article>
          <article>
            <ShieldCheck size={26} aria-hidden="true" />
            <div class="hc-access-status">Not released</div>
            <h3>Native mobile distribution</h3>
            <p>No public APK, Google Play, or App Store release is currently claimed. Native distribution stays blocked until release signing and clean-device verification are separately complete.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="hc-access-section hc-access-faq" aria-labelledby="access-faq-title">
      <div class="hc-access-shell">
        <div class="hc-access-heading"><p class="hc-access-kicker">Access clarity</p><h2 id="access-faq-title">Frequently asked questions</h2></div>
        <div class="hc-access-faq-grid">{faqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hc-access-page{min-height:70vh;color:#f8fafc;background:radial-gradient(circle at 15% 8%,rgba(90,200,250,.09),transparent 30rem),radial-gradient(circle at 85% 10%,rgba(157,136,255,.1),transparent 32rem),#090d16}.hc-access-shell{width:min(1080px,calc(100% - 2rem));margin:0 auto}.hc-access-hero{padding:clamp(4rem,9vw,7rem) 0 3.5rem}.hc-access-kicker{margin:0 0 .65rem;color:#9d88ff;font-size:.77rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.hc-access-hero h1{max-width:800px;margin:0;font-size:clamp(2.6rem,7vw,5.4rem);line-height:1;letter-spacing:-.05em}.hc-access-lead{max-width:760px;margin:1.25rem 0 0;color:#a9b5c8;font-size:clamp(1rem,2vw,1.2rem);line-height:1.7}.hc-access-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.5rem}.hc-access-primary,.hc-access-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:46px;padding:.75rem 1rem;border-radius:11px;text-decoration:none;font-weight:750}.hc-access-primary{background:linear-gradient(135deg,#8b5cf6,#5ac8fa);color:#07101c}.hc-access-secondary{border:1px solid rgba(255,255,255,.14);color:#fff;background:rgba(255,255,255,.03)}.hc-access-section{padding:3rem 0}.hc-access-heading{max-width:720px;margin-bottom:1.25rem}.hc-access-heading h2{margin:0;font-size:clamp(1.65rem,4vw,2.6rem);letter-spacing:-.035em}.hc-access-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.hc-access-grid article,.hc-access-faq-grid article{padding:1.3rem;border:1px solid rgba(255,255,255,.09);border-radius:18px;background:linear-gradient(160deg,rgba(255,255,255,.045),rgba(255,255,255,.018));box-shadow:0 18px 55px rgba(0,0,0,.15)}.hc-access-grid article.is-current{border-color:rgba(52,211,153,.3)}.hc-access-grid svg{color:#5ac8fa}.hc-access-status{margin:.8rem 0 .45rem;color:#9d88ff;font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.is-current .hc-access-status{color:#6ee7b7}.hc-access-grid h3,.hc-access-faq-grid h3{margin:.2rem 0 .5rem}.hc-access-grid p,.hc-access-faq-grid p{margin:0;color:#98a6bb;line-height:1.62;font-size:.9rem}.hc-access-grid a{display:inline-flex;align-items:center;gap:.3rem;margin-top:.8rem;color:#c4b5fd;text-decoration:none;font-size:.82rem;font-weight:750}.hc-access-faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  @media(max-width:760px){.hc-access-shell{width:min(100% - 1rem,1080px)}.hc-access-grid,.hc-access-faq-grid{grid-template-columns:1fr}.hc-access-actions{flex-direction:column}.hc-access-primary,.hc-access-secondary{width:100%}}
</style>
