---
import { ArrowRight, CheckCircle2, MonitorSmartphone, ShieldCheck, Wrench } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

const faqs = [
  { question: "What Hermes Connect access is available now?", answer: "The most mature current public product path is the responsive Repair Shop Web App in a modern browser. Use the canonical Hermes Connect Repair Shops flow for the access options that are available in the current environment." },
  { question: "Is there a public Android APK or app-store release?", answer: "No public mobile-store or direct APK release is currently presented as available. Mobile users should use the responsive browser experience while release verification remains separate." },
  { question: "Can I add Hermes Connect to my home screen?", answer: "Where the browser supports standard Add to Home Screen behavior, you may use that browser feature. The website does not simulate a successful native installation." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Hermes Connect Access Center",
    url: "https://hermeslogisticsus.com/download/",
    description: "Current browser-first access guidance for the most mature Hermes Connect Repair Shops vertical, with clear mobile distribution boundaries.",
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Hermes Connect Repair Shop Web App Access",
    serviceType: "Browser-based repair shop operations software access",
    provider: { "@id": "https://hermeslogisticsus.com/#organization" },
    url: "https://hermeslogisticsus.com/services/hermes-connect/repair-shops/",
    description: "Browser-first access guidance for the most mature current Hermes Connect Repair Shops vertical. No native mobile-store release, universal availability, or subscription offer is claimed here.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Hermes Connect", item: "https://hermeslogisticsus.com/services/hermes-connect/" },
      { "@type": "ListItem", position: 3, name: "Access Center", item: "https://hermeslogisticsus.com/download/" },
    ],
  },
];
---

<BaseLayout
  title="Hermes Connect Access Center | Current Web App"
  description="Open the current Hermes Connect Repair Shop Web App in your browser. Public mobile-store and direct APK distribution are not currently released."
  schema={schema}
>
  <SiteHeader theme="light" />

  <main id="main-content" class="hc-access-page">
    <section class="hc-access-hero">
      <div class="hc-access-shell">
        <p class="hc-access-kicker">Hermes Connect · Access Center</p>
        <h1>Use the current product in your browser.</h1>
        <p class="hc-access-lead">Repair Shops is the most mature current Hermes Connect vertical. Desktop, tablet, and mobile users use the same responsive product family—without a separate legacy workspace or an unverified native-app promise.</p>
        <div class="hc-access-actions">
          <a class="hc-access-primary" href="/services/hermes-connect/repair-shops/"><Wrench size={18} aria-hidden="true" />Open Repair Shops <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="hc-access-secondary" href="/services/hermes-connect/repair-shops/auth/">Owner Login / Get Started</a>
        </div>
      </div>
    </section>

    <section class="hc-access-section" aria-labelledby="access-options-title">
      <div class="hc-access-shell">
        <div class="hc-access-heading"><p class="hc-access-kicker">Current distribution</p><h2 id="access-options-title">One supported access path, clear device guidance.</h2></div>
        <div class="hc-access-grid">
          <article class="is-current">
            <MonitorSmartphone size={26} aria-hidden="true" />
            <div class="hc-access-status">Current</div>
            <h3>Responsive Web App</h3>
            <p>Use the canonical Repair Shop product in a modern browser on desktop, tablet, iPhone, or Android.</p>
            <a href="/services/hermes-connect/repair-shops/">Open current product <ArrowRight size={15} aria-hidden="true" /></a>
          </article>
          <article>
            <CheckCircle2 size={26} aria-hidden="true" />
            <div class="hc-access-status">Browser feature</div>
            <h3>Add to Home Screen</h3>
            <p>If your browser provides a standard Add to Home Screen option, you may use it as a shortcut. Hermes does not report a simulated install as successful.</p>
          </article>
          <article>
            <ShieldCheck size={26} aria-hidden="true" />
            <div class="hc-access-status">Not released</div>
            <h3>Native mobile distribution</h3>
            <p>No public APK, Google Play, or App Store release is currently claimed. Native distribution stays blocked until release signing and clean-device verification are separately complete.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="hc-access-section hc-access-faq" aria-labelledby="access-faq-title">
      <div class="hc-access-shell">
        <div class="hc-access-heading"><p class="hc-access-kicker">Access clarity</p><h2 id="access-faq-title">Frequently asked questions</h2></div>
        <div class="hc-access-faq-grid">{faqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hc-access-page{
    min-height:70vh;
    color:#0b0d12;
    background:
      radial-gradient(circle at 78% 6%,rgba(124,92,255,.09),transparent 28rem),
      radial-gradient(circle at 18% 14%,rgba(90,200,250,.07),transparent 24rem),
      #f7f6f3;
  }
  .hc-access-shell{width:min(1120px,calc(100% - 2rem));margin:0 auto}
  .hc-access-hero{padding:clamp(8.5rem,12vw,11rem) 0 clamp(4rem,7vw,6.5rem);border-bottom:1px solid rgba(11,13,18,.08)}
  .hc-access-kicker{margin:0 0 .8rem;color:#6f59df;font-size:.72rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
  .hc-access-hero h1{max-width:880px;margin:0;font-size:clamp(3rem,7.2vw,6.2rem);line-height:.94;letter-spacing:-.065em;text-wrap:balance}
  .hc-access-lead{max-width:760px;margin:1.5rem 0 0;color:#626979;font-size:clamp(1rem,1.7vw,1.18rem);line-height:1.7}
  .hc-access-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.8rem}
  .hc-access-primary,.hc-access-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:48px;padding:.78rem 1.05rem;border-radius:999px;text-decoration:none;font-weight:760;transition:transform .18s ease,box-shadow .18s ease,background-color .18s ease}
  .hc-access-primary{background:#0b0d12;color:#fff;box-shadow:0 14px 30px rgba(11,13,18,.12)}
  .hc-access-primary:hover,.hc-access-secondary:hover{transform:translateY(-1px)}
  .hc-access-secondary{border:1px solid rgba(11,13,18,.13);color:#0b0d12;background:rgba(255,255,255,.62)}
  .hc-access-section{padding:clamp(3.5rem,6vw,5.5rem) 0}
  .hc-access-heading{max-width:760px;margin-bottom:1.6rem}
  .hc-access-heading h2{margin:0;font-size:clamp(2rem,4.4vw,3.45rem);line-height:1.02;letter-spacing:-.05em;text-wrap:balance}
  .hc-access-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .hc-access-grid article,.hc-access-faq-grid article{position:relative;padding:1.5rem;border:1px solid rgba(11,13,18,.09);border-radius:24px;background:rgba(255,255,255,.72);box-shadow:0 18px 55px rgba(42,32,90,.06);backdrop-filter:blur(16px)}
  .hc-access-grid article.is-current{border-color:rgba(124,92,255,.25);box-shadow:0 22px 65px rgba(96,72,200,.09)}
  .hc-access-grid svg{color:#7560ee}
  .hc-access-status{display:inline-flex;margin:.9rem 0 .55rem;padding:.3rem .5rem;border-radius:999px;background:#f0edff;color:#6b55de;font-size:.65rem;font-weight:850;text-transform:uppercase;letter-spacing:.08em}
  .is-current .hc-access-status{background:#e8f8f1;color:#23775b}
  .hc-access-grid h3,.hc-access-faq-grid h3{margin:.2rem 0 .55rem;color:#11131a}
  .hc-access-grid p,.hc-access-faq-grid p{margin:0;color:#697080;line-height:1.62;font-size:.92rem}
  .hc-access-grid a{display:inline-flex;align-items:center;gap:.3rem;margin-top:1rem;color:#5f49d5;text-decoration:none;font-size:.84rem;font-weight:780}
  .hc-access-faq{background:#0b0d12;color:#f8fafc}
  .hc-access-faq .hc-access-kicker{color:#9d88ff}
  .hc-access-faq .hc-access-heading h2{color:#fff}
  .hc-access-faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .hc-access-faq-grid article{border-color:rgba(255,255,255,.08);background:rgba(255,255,255,.035);box-shadow:none}
  .hc-access-faq-grid h3{color:#fff}
  .hc-access-faq-grid p{color:#9ea8b9}
  @media(max-width:760px){
    .hc-access-shell{width:min(100% - 1rem,1120px)}
    .hc-access-hero{padding-top:7.5rem}
    .hc-access-grid,.hc-access-faq-grid{grid-template-columns:1fr}
    .hc-access-actions{flex-direction:column}
    .hc-access-primary,.hc-access-secondary{width:100%}
    .hc-access-grid article,.hc-access-faq-grid article{border-radius:20px}
  }
  @media(prefers-reduced-motion:reduce){.hc-access-primary,.hc-access-secondary{transition:none}}
</style>