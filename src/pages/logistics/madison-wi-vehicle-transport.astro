---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "Madison Vehicle Transport | Hermes Logistics";
const description = "Request vehicle transport to or from Madison, Wisconsin for dealer, auction, business, university, or private moves. Hermes reviews route, timing, condition, and equipment needs.";
const canonicalUrl = new URL("/logistics/madison-wi-vehicle-transport/", Astro.site).toString();
const directTransportIntake = "/logistics/request-vehicle-transport/?role=customer&request=customer_delivery#transport-intake";
const loadBoardDemo = "/load-board/?role=private_party&origin=Madison%2C%20WI#post-load";
const faq = [
  { question: "How much does vehicle transport to or from Madison cost?", answer: "Pricing depends on the exact route, vehicle size and condition, open or enclosed equipment, pickup and delivery access, timing, season, and carrier availability." },
  { question: "Can Hermes review dealer and auction vehicle moves in Madison?", answer: "Yes. Submit route, release status, vehicle condition, facility rules, timing, and contact details for review." },
  { question: "Can multiple vehicles be included in one request?", answer: "Yes. Provide a complete unit list, condition details, pickup and delivery requirements, access restrictions, and preferred timing." },
  { question: "Does a submitted request guarantee transport?", answer: "No. A request must first be reviewed. Coordination depends on route, compliance, equipment fit, timing, capacity, and final confirmation." },
];
const schema = [
  { "@context": "https://schema.org", "@type": "Service", name: "Madison vehicle transport request coordination", description, url: canonicalUrl, serviceType: "Vehicle transport request review and carrier coordination", areaServed: [{ "@type": "City", name: "Madison", containedInPlace: { "@type": "State", name: "Wisconsin" } }, { "@type": "AdministrativeArea", name: "Dane County, Wisconsin" }, { "@type": "Country", name: "United States" }], provider: { "@type": "Organization", name: "Hermes Logistics", url: "https://hermeslogisticsus.com/paths/logistics/" } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" }, { "@type": "ListItem", position: 2, name: "Logistics", item: "https://hermeslogisticsus.com/paths/logistics/" }, { "@type": "ListItem", position: 3, name: "Madison Vehicle Transport", item: canonicalUrl }] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) },
];
import "../../styles/features/appleton.css";
---
<BaseLayout title={title} description={description} schema={schema}>
  <SiteHeader theme="dark" activePath="/paths/logistics/" />
  <main id="main-content">
    <section class="section"><div class="shell"><nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/paths/logistics/">Logistics</a> / <span aria-current="page">Madison vehicle transport</span></nav><p class="eyebrow">Hermes Logistics · Madison, Wisconsin</p><h1>Vehicle transport to and from Madison, Wisconsin.</h1><p>Hermes reviews transport requests for dealers, auction customers, businesses, university-related moves, and private customers. Start with the exact route, vehicle condition, timing, access requirements, and preferred equipment.</p><div class="logistics-audience-actions"><a class="button button-primary" href={directTransportIntake} data-madison-direct-intake>Prepare a transport request</a><a class="button" href={loadBoardDemo} data-madison-demo>Preview the Madison Load Board demo</a><a class="button" href="/load-board/?role=carrier&amp;area=Madison%2C%20WI#carrier-access">Carrier: share capacity in demo</a></div><p>The direct intake starts a Logistics Sales review. It does not publish a request, notify a carrier, confirm capacity, create a booking, or guarantee price, timing, equipment, or carrier availability.</p></div></section>
    <section class="section"><div class="shell"><p class="eyebrow">Transport request types</p><h2>Single vehicles, dealer inventory, and scheduled multi-unit moves.</h2><div class="appleton-card-grid"><article><h3>Auto dealers</h3><p>Purchased, sold, traded, or transferred inventory with route and delivery requirements.</p></article><article><h3>Auction customers</h3><p>Pickup planning with release status, facility rules, condition, and storage deadlines.</p></article><article><h3>Private and university-related moves</h3><p>Relocation, purchase, sale, or planned delivery to a known recipient.</p></article><article><h3>Carriers</h3><p>Share equipment, authority, operating area, capacity, and schedule for review.</p></article></div></div></section>
    <section class="section"><div class="shell"><p class="eyebrow">Prepare the request</p><h2>Complete details reduce avoidable delays.</h2><ul><li>Pickup and delivery city, state, or ZIP code</li><li>Vehicle year, make, model, quantity, and condition</li><li>Whether each vehicle starts, rolls, steers, and brakes</li><li>Earliest pickup date and required delivery window</li><li>Open or enclosed equipment preference</li><li>Facility hours, release references, and access restrictions</li></ul><p>Use the <a href="/logistics/resources/auction-vehicle-pickup-checklist/">Auction Vehicle Pickup Checklist</a> for auction moves and the <a href="/logistics/resources/car-hauler-capacity-checklist/">Car Hauler Capacity Checklist</a> when sharing carrier availability.</p></div></section>
    <section class="section logistics-faq" aria-labelledby="madison-faq-title"><div class="shell faq-layout"><div><p class="eyebrow">FAQ</p><h2 id="madison-faq-title">Before you submit.</h2></div><div class="faq-list">{faq.map((item) => (<details><summary>{item.question}</summary><p>{item.answer}</p></details>))}</div></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
