---
import LogisticsCommercialPage from "../../../components/LogisticsCommercialPage.astro";

const content = {
  title: "Dealer Vehicle Transportation Services | Hermes Logistics",
  description: "Dealer vehicle transportation coordination for dealership inventory, auction pickups, dealer-to-dealer transfers, multi-unit moves, and open or enclosed equipment requests.",
  eyebrow: "Hermes Logistics · Dealer Vehicle Transportation",
  h1: "Dealer Vehicle Transportation Services",
  intro: "Hermes helps dealerships and vehicle-market partners organize transportation requests, review route and equipment requirements, coordinate documentation, and maintain clear communication from pickup planning through delivery updates. Every request is reviewed before carrier coordination begins.",
  image: "/images/path-logistics-system.jpg",
  imageAlt: "Dealer vehicle transportation and carrier coordination network",
  audience: [
    "Dealerships moving inventory between locations",
    "Dealers buying vehicles from auctions or other dealers",
    "Brokers and shippers coordinating repeat vehicle movement",
    "Businesses that need open, enclosed, multi-vehicle, or specialty capacity",
  ],
  benefits: [
    { title: "Dealer-to-dealer transfers", body: "Coordination for inventory transfers between dealerships, recon facilities, storage locations, customer-delivery points, and other authorized destinations." },
    { title: "Auction vehicle pickup", body: "Pickup requirements, release information, vehicle condition, operability, facility hours, storage deadlines, timing, and delivery expectations are organized before carrier matching." },
    { title: "Multi-vehicle planning", body: "Requests involving several vehicles are reviewed by unit count, dimensions, operability, pickup readiness, delivery sequence, route, and equipment fit." },
    { title: "Open and enclosed options", body: "Equipment requests are evaluated against vehicle type, value, condition, timing, access, and actual carrier availability. Availability is never guaranteed before confirmation." },
    { title: "Qualified carrier review", body: "Carrier authority, insurance, equipment, operating area, documentation, and available compliance information are reviewed before assignment when data is available." },
    { title: "Clear information flow", body: "Hermes acts as a coordination layer between the transportation request and available carrier capacity, without claiming ownership of trucks that are not owned by Hermes." },
    { title: "Documented exception path", body: "When timing or vehicle condition becomes disputed, the next step is to preserve the bill of lading or condition report, time-stamped photographs, facility notices, and communication records for review by the responsible carrier, insurer, or contractual party." },
  ],
  process: [
    { title: "Request intake", body: "We collect origin, destination, vehicle count, year, make, model, operability, open or enclosed preference, timing, release status, contact rules, and access requirements." },
    { title: "Requirement review", body: "The request is checked for missing release details, special equipment needs, restricted access, inoperable units, storage deadlines, and realistic pickup and delivery expectations." },
    { title: "Carrier and equipment matching", body: "Qualified capacity is evaluated based on authority, insurance, equipment, geography, schedule, vehicle condition, and the available shipment information." },
    { title: "Customer confirmation", body: "The dealer or authorized customer reviews the available terms and carrier information before the transportation arrangement is confirmed." },
    { title: "Pickup and delivery coordination", body: "Hermes supports communication and document flow while the motor carrier remains responsible for transportation, safety, and legal operation. Timing changes or condition issues require direct notice and separate review under the applicable arrangement." },
  ],
  faq: [
    { question: "Can Hermes guarantee same-day dealer pickup?", answer: "No. Pickup timing depends on carrier availability, location, vehicle readiness, release requirements, weather, market conditions, access, and final carrier acceptance." },
    { question: "Do you support auction pickups?", answer: "Auction pickup coordination may be available when the exact facility, release information, buyer or stock reference, vehicle condition, pickup hours, storage deadline, timing, and destination are provided." },
    { question: "Can I prepare a Copart, IAA, or Manheim pickup request?", answer: "Yes. Those names may be selected as facility context so the review can ask for release status, buyer or stock reference, hours, storage deadline, keys, operability, and loading access. Hermes does not claim affiliation with Copart, IAA, or Manheim, and the facility's own requirements still control pickup." },
    { question: "Can several dealer vehicles move together?", answer: "Yes, when compatible carrier capacity is available. Vehicle count, size, operability, pickup location, delivery location, requested sequence, and timing must be reviewed first." },
    { question: "Is enclosed transportation available?", answer: "Enclosed capacity may be requested for luxury, classic, specialty, or higher-protection moves, subject to route, timing, equipment, access, and carrier availability." },
    { question: "What should we do if pickup or delivery timing changes?", answer: "Notify the agreed Hermes coordination contact and the assigned motor carrier as soon as the change is known. Keep facility notices, appointment or release information, timestamps, and communication records available so the authorized parties can confirm the cause and revised plan. Hermes can coordinate updates, but it does not guarantee a revised pickup or delivery time." },
    { question: "What should we do if vehicle condition changes or damage is reported?", answer: "Record the vehicle condition before accepting delivery whenever possible, note visible exceptions on the bill of lading or condition report, take time-stamped photographs, and notify the transporting carrier and Hermes promptly. Hermes can coordinate the information flow, but liability, coverage, claim deadlines, review, and payment are determined by the motor carrier, insurer, applicable agreement, transportation documents, and law." },
    { question: "Can Wisconsin dealers use a local request page?", answer: "Yes. Wisconsin dealers can use the dedicated dealer transport, auction pickup, multi-vehicle, enclosed transport, city-level pages, and Wisconsin car shipping cost guide to prepare more specific requests." },
    { question: "Can a dealer request inland transport from a U.S. port or terminal?", answer: "Yes. Use the Port Vehicle Pickup page when the vehicle is being collected from a port, terminal, airport, warehouse, or similar facility and the review needs release status, access, storage deadline, timing, vehicle condition, and inland equipment context. Hermes does not represent customs brokerage or terminal operation on that page." },
    { question: "Does Hermes own the transporting fleet?", answer: "Hermes coordinates transportation information and carrier relationships. Unless explicitly stated for a specific transaction, transportation is performed by independent authorized motor carriers." },
    { question: "What information is needed for a quote or capacity review?", answer: "Provide origin and destination, vehicle year, make, model, number of vehicles, operability, release status, desired timing, open or enclosed preference, facility access, and authorized contact details. VIN and sensitive release details should be exchanged through a secure direct channel." },
  ],
  primaryAction: {
    label: "Prepare a dealer transport request",
    href: "/logistics/request-vehicle-transport/?role=dealer&request=dealer_inventory#transport-intake",
  },
  handoffNote: "Use the direct customer intake to prepare route, timing, quantity, condition, equipment preference, auction context, release status, and recurring-need details. The separate Load Board remains a fictional product preview.",
  related: [
    { label: "Start Dealer Transport Request", href: "/logistics/request-vehicle-transport/?role=dealer&request=dealer_inventory#transport-intake" },
    { label: "Direct Vehicle Transport Network", href: "/logistics/direct-vehicle-transport-network/" },
    { label: "Auction Vehicle Pickup", href: "/logistics/auction-vehicle-pickup/" },
    { label: "Port Vehicle Pickup", href: "/logistics/port-vehicle-pickup/" },
    { label: "Wisconsin Car Shipping Cost Guide", href: "/logistics/resources/wisconsin-car-shipping-cost-guide/" },
    { label: "Wisconsin Dealer Vehicle Transport", href: "/logistics/wisconsin-dealer-vehicle-transport/" },
    { label: "Wisconsin Multi-Vehicle Dealer Transport", href: "/logistics/wisconsin-multi-vehicle-dealer-transport/" },
    { label: "Wisconsin Enclosed Vehicle Transport", href: "/logistics/wisconsin-enclosed-vehicle-transport/" },
    { label: "Preview the Load Board Demo", href: "/load-board/?role=dealer#post-load" },
    { label: "Car Hauling Dispatch Services", href: "/logistics/car-hauling-dispatch/" },
    { label: "Contact Hermes", href: "/contacts/" },
  ],
};
---

<LogisticsCommercialPage content={content} />
