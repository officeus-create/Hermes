---
import LogisticsCommercialPage from "../../../components/LogisticsCommercialPage.astro";

const content = {
  title: "Car Hauling Dispatch Services for Owner-Operators | Hermes Logistics",
  description: "Car hauling dispatch services for owner-operators and small fleets: load search, broker calls, route review, paperwork, invoicing, new-authority readiness, and carrier-controlled booking.",
  eyebrow: "Hermes Logistics · Car Hauling Dispatch",
  h1: "Car Hauling Dispatch Services for Owner-Operators and Small Fleets",
  intro: "Hermes supports car-hauling carriers with load search, route and equipment review, broker communication, paperwork coordination, invoicing follow-through, and a structured process for developing stronger freight relationships. The carrier reviews and approves every load before booking.",
  image: "/images/path-logistics-system.jpg",
  imageAlt: "Vehicle transportation routes and car hauling operations network",
  primaryAction: {
    label: "Start car-hauling dispatch review",
    href: "/logistics/start-car-hauling-dispatch/",
  },
  handoffNote: "Use the direct carrier intake so Logistics Sales can review authority, insurance, equipment, capacity, operating area, availability, and dispatch scope. The separate Load Board remains a fictional product preview and is not the commercial intake path.",
  audience: [
    "Owner-operators running hotshot, open, enclosed, wedge, or multi-car equipment",
    "Small fleets with equipment that can transport from one vehicle through multi-car capacity",
    "Carriers seeking support with load search, broker calls, setup packets, paperwork, invoicing, and communication",
    "New authorities that need a realistic readiness review before active dispatch or load access",
  ],
  benefits: [
    { title: "Daily load and route review", body: "Load search, route evaluation, deadhead awareness, broker calls, rate discussion, pickup and delivery requirements, and operating-fit review around the carrier's equipment and preferences." },
    { title: "Carrier back office", body: "Support with setup packets, insurance certificates, rate confirmations, document organization, invoicing, and accounts-receivable follow-up." },
    { title: "Direct demand development", body: "Hermes is building an additional demand layer that connects public dealer, shipper, business, and customer transport requests with reviewed carrier operating profiles. Verified operating patterns can inform evidence-gated route or service research, but no route page, ranking, direct load, lane, rate, or revenue is guaranteed." },
    { title: "Equipment-aware matching", body: "One-car, two- to three-car, open multi-car, enclosed, inoperable-capable, hotshot, wedge, and other vehicle-transport equipment are reviewed according to actual capacity and restrictions." },
    { title: "Authority and insurance checks", body: "MC, DOT, operating authority, insurance status, equipment, service area, documentation, and authority age are reviewed before active work begins." },
    { title: "Carrier-controlled booking", body: "Hermes coordinates information and communication. The carrier makes the final operating decision and approves each load before booking." },
    { title: "Dispatch versus self-dispatch review", body: "A carrier may keep load-board search, broker calls, route planning, setup packets, documents, invoicing, and follow-up in-house or delegate approved coordination. The right model depends on time, experience, equipment, lanes, authority readiness, and the control the carrier wants to retain." },
    { title: "Scope and fee review", body: "Dispatch fees and included work must be confirmed in the applicable agreement. Compare the percentage or fee with the actual scope: load search, negotiation support, broker setup, paperwork, invoicing, after-hours communication, and reporting." },
  ],
  process: [
    { title: "Carrier intake", body: "Share your role, company, MC or USDOT number, equipment class, capacity, availability, home area, and contact information in the direct dispatch-review workspace." },
    { title: "Qualification", body: "Logistics Sales reviews authority status and age, insurance readiness, equipment, operating area, preferred lanes, availability, fleet size, current dispatch relationship, and operating constraints." },
    { title: "Operating profile", body: "We document truck and trailer capacity, home base, preferred regions, minimum rate expectations, communication rules, carrier approval rules, and required paperwork." },
    { title: "First 24–48 hours after approval", body: "After the carrier is approved and the required authority, insurance, equipment, contact, and communication details are available, the first 24–48 hours are used to confirm the operating profile, current availability, lane and equipment filters, broker-setup readiness, carrier approval rules, escalation contacts, and the first candidate-load review workflow. This is a setup and review window, not a guarantee of dispatcher assignment, response time, load availability, booking, rate, mileage, lane consistency, or revenue. Missing documents, market conditions, broker requirements, or carrier changes can extend the sequence." },
    { title: "Load and lane review", body: "Potential loads are checked against equipment, deadhead, timing, route, pickup and delivery requirements, source, documents, offered rate, and disclosed operating preferences." },
    { title: "Carrier approval and follow-through", body: "The carrier makes the final decision before booking. Hermes coordinates approved communication and documents while the carrier remains responsible for safe and lawful transportation." },
  ],
  faq: [
    { question: "Does Hermes guarantee loads, rates, or revenue?", answer: "No. Freight availability, rates, timing, lane consistency, and broker requirements change with the market. Hermes provides dispatch and coordination support without guaranteeing revenue, mileage, rates, lanes, response time, or specific loads." },
    { question: "Who makes the final decision on a load?", answer: "The carrier does. Hermes can research, communicate, negotiate, and coordinate information, but the carrier approves every load before booking." },
    { question: "How is Hermes developing direct demand around carrier operating areas?", answer: "Hermes maintains public vehicle-transport pages and a direct request path for dealers, shippers, brokers, businesses, and private customers. Approved carrier profiles help Logistics understand equipment, capacity, service areas, preferences, and restrictions. Completed or verified operating patterns may identify useful route or service topics for separate SEO research and human-reviewed publication. This process does not automatically publish private lanes and does not guarantee a route page, ranking, customer, direct load, timing, rate, mileage, utilization, or revenue." },
    { question: "What happens during the first 24–48 hours after approval?", answer: "If the carrier has been approved and the required authority, insurance, equipment, contact, and communication information is available, the initial window is used to confirm the operating profile, current availability, lane and equipment filters, broker-setup readiness, carrier approval rules, escalation contacts, and the first candidate-load review workflow. It does not guarantee dispatcher assignment, a fixed response time, load availability, booking, rate, mileage, lane consistency, or revenue. Missing documents, changing availability, broker requirements, and market conditions can extend the sequence." },
    { question: "What does a car hauler dispatcher do?", answer: "The approved scope may include searching load boards and direct sources, checking route and equipment fit, calling brokers or dealers, discussing rates and requirements, preparing setup packets, organizing rate confirmations and transport documents, coordinating updates, supporting invoicing, and tracking follow-up. The dispatcher does not replace the carrier's authority, safety responsibility, or final booking decision." },
    { question: "Is dispatch service better than self-dispatch?", answer: "Not for every carrier. Self-dispatch can fit an owner-operator who has the time, tools, broker relationships, paperwork discipline, and lane knowledge to manage the full process. Dispatch support can reduce administrative workload and increase search coverage, but the carrier should compare scope, fee, control, communication, and actual operating needs before deciding." },
    { question: "How much does car hauling dispatch service cost?", answer: "Pricing depends on the approved service scope and agreement. Before signing, confirm whether the fee covers only load search or also broker communication, setup packets, paperwork, invoicing, collections follow-up, reporting, safety coordination, and after-hours support. Hermes does not publish an unapproved universal percentage or promise that a fee will produce a specific rate or revenue result." },
    { question: "What equipment and capacity can be reviewed?", answer: "Support may be available for one-car equipment, two- to three-car hotshot or wedge trailers, open multi-car haulers, enclosed trailers, and other vehicle-transport configurations after actual capacity and operating requirements are reviewed." },
    { question: "Can a new authority start immediately?", answer: "Not always. Broker requirements, insurance, safety profile, authority age, documentation, and equipment readiness must be reviewed first. A new authority may qualify for a readiness process before it qualifies for ordinary active dispatch or specific load access." },
    { question: "Does Hermes operate the trucks?", answer: "Hermes provides dispatch, information, communication, and back-office support. The motor carrier controls the truck, driver, safety decisions, and transportation service." },
    { question: "What happens after I complete the carrier intake?", answer: "The direct workspace prepares a qualified request for Logistics Sales. Secure delivery is used only when the approved receiver confirms it; otherwise the prepared email and direct phone remain available. Submission does not automatically create an account, assign a dispatcher, book a load, or guarantee acceptance." },
    { question: "How do we begin?", answer: "Open the direct carrier intake and provide your MC or USDOT number, authority status, equipment, capacity, home base, preferred operating area, availability, fleet size, current dispatch status, and business contact information. Do not place sensitive shipment details in public URLs." },
  ],
  related: [
    { label: "Start Car Hauling Dispatch Review", href: "/logistics/start-car-hauling-dispatch/" },
    { label: "Direct Vehicle Transport Network", href: "/logistics/direct-vehicle-transport-network/" },
    { label: "Dispatch Service vs Self-Dispatch", href: "/logistics/resources/dispatch-service-vs-self-dispatch/" },
    { label: "Owner-Operator Logistics Path", href: "/paths/logistics/carriers/owner-operators/" },
    { label: "Fleet Owner Logistics Path", href: "/paths/logistics/carriers/fleet-owners/" },
    { label: "New Authority Carrier Support", href: "/paths/logistics/carriers/new-authority/" },
    { label: "Car Hauler Capacity Checklist", href: "/logistics/resources/car-hauler-capacity-checklist/" },
    { label: "Dealer Vehicle Transportation", href: "/logistics/dealer-vehicle-transportation/" },
    { label: "Preview the Load Board Demo", href: "/load-board/?role=carrier&equipment=car_hauler#available-loads" },
    { label: "Contact Hermes", href: "/contacts/" },
  ],
};
---

<LogisticsCommercialPage content={content} />
