---
import LogisticsCommercialPage from "../../../components/LogisticsCommercialPage.astro";

const content = {
  title: "Car Hauling Dispatch Services for Owner-Operators | Hermes Logistics",
  description: "Car hauling dispatch for owner-operators and small fleets: today's load work plus lane, shipper, dealer, direct-demand, paperwork, invoicing, and carrier-controlled planning.",
  eyebrow: "Hermes Logistics · Car Hauling Dispatch",
  h1: "Car Hauling Dispatch for Today's Loads and Tomorrow's Demand",
  intro: "You do not get just a dispatcher looking at today's board. The approved Hermes scope can combine two workstreams: one team handles the truck that needs to move now; another develops the routes, customer research, and direct-demand opportunities that can reduce dependence on third-party load boards over time. The carrier still approves every load before booking.",
  image: "/images/path-logistics-system.jpg",
  imageAlt: "Vehicle transportation routes and car hauling operations network",
  primaryAction: {
    label: "Start car-hauling dispatch review",
    href: "/logistics/start-car-hauling-dispatch/",
  },
  handoffNote: "Use the direct carrier intake so Logistics Sales can review authority, insurance, equipment, capacity, operating area, availability, and the exact support scope. No load, rate, lane, customer, ranking, or revenue is guaranteed. The separate Load Board remains a fictional product preview and is not the commercial intake path.",
  audience: [
    "Owner-operators running hotshot, open, enclosed, wedge, or multi-car equipment",
    "Small fleets with equipment that can transport from one vehicle through multi-car capacity",
    "Carriers that want help with today's load search, broker calls, setup packets, paperwork, invoicing, and communication",
    "Carriers that also want structured lane, shipper, dealer, and direct-demand research for longer-term development",
  ],
  benefits: [
    { title: "Team 1: keep today's truck moving", body: "Current-load work can include load-board and source research, route and deadhead review, broker calls, rate discussion, setup packets, rate confirmations, document coordination, invoicing, and follow-up. Every candidate load still goes back to the carrier for approval." },
    { title: "Team 2: build tomorrow's demand", body: "The development workstream can research shippers, dealers, repeat-customer opportunities, operating patterns, lane hypotheses, public search demand, SEO visibility, and inbound vehicle-transport requests. The goal is to create more ways for relevant demand to find Hermes and suitable carriers; it is not a promise of direct freight or ranking on a fixed timeline." },
    { title: "One operating picture", body: "Today's load activity and longer-term development are more useful when they share the same equipment, capacity, home-base, lane, deadhead, availability, and carrier-approval context instead of operating as separate sales stories." },
    { title: "Carrier back office", body: "Support can include setup packets, insurance certificates, rate confirmations, document organization, invoicing, accounts-receivable follow-up, and agreed communication handoffs." },
    { title: "Equipment-aware review", body: "One-car, two- to three-car, open multi-car, enclosed, inoperable-capable, hotshot, wedge, and other vehicle-transport equipment are reviewed according to actual capacity and restrictions." },
    { title: "Authority and insurance checks", body: "MC, DOT, operating authority, insurance status, equipment, service area, documentation, and authority age are reviewed before active work begins." },
    { title: "Carrier-controlled booking", body: "Hermes can research, communicate, negotiate within instructions, and coordinate information. The carrier makes the final operating decision and may accept or reject each load before booking." },
    { title: "Fee follows the scope", body: "The percentage should be compared with the work actually included. The Full Partnership option is presented as 8% when the signed scope includes the broader two-workstream model; a narrower or custom scope can use different terms. The exact fee must match the applicable signed Appendix A." },
  ],
  process: [
    { title: "Tell us what you run", body: "Share your company, MC or USDOT number, equipment, capacity, home area, preferred operating area, current availability, and the support you need." },
    { title: "Define today's operating rules", body: "Logistics Sales reviews authority and insurance readiness, equipment, preferred lanes, minimum expectations, current dispatch relationship, communication rules, and the points where carrier approval is required." },
    { title: "Set Team 1 in motion", body: "After approval and required information are available, the current-load workstream can begin reviewing market options, route fit, deadhead, timing, source requirements, broker setup, paperwork, and candidate loads. This is a process commitment, not a load or rate guarantee." },
    { title: "Build Team 2 around real operating data", body: "The development workstream uses approved carrier operating context to research shippers, dealers, repeat-demand patterns, route opportunities, search demand, and inbound-request paths without publishing private carrier, customer, shipment, VIN, rate, or exact live-location data." },
    { title: "Carrier decides; Hermes follows through", body: "The carrier accepts or rejects each load. Hermes coordinates the approved communication, documents, follow-up, and agreed development work while the motor carrier remains responsible for safe and lawful transportation." },
  ],
  faq: [
    { question: "Does Hermes guarantee loads, rates, direct customers, or revenue?", answer: "No. Freight availability, rates, timing, customer demand, broker requirements, search visibility, and lane consistency change. Hermes can improve the process, search coverage, follow-up, research, and inbound paths, but it cannot guarantee a load, rate, customer, ranking date, mileage, lane, utilization, or revenue result." },
    { question: "Can I reject a load?", answer: "Yes. The carrier controls the truck and makes the final operating decision. Hermes can research, communicate, negotiate within instructions, and prepare the handoff, but the carrier approves or rejects every load before booking." },
    { question: "Why can the Full Partnership option be 8%?", answer: "Because that option is designed around a broader scope than load search alone. The signed scope can include the current-load workstream plus broker setup, documents, invoicing and follow-up, and a second development workstream for shipper/dealer research, lane research, direct-demand development, public search visibility, and inbound transportation paths. The exact 8% applies only when it is the confirmed term in the carrier's signed Appendix A; narrower or custom scopes may differ." },
    { question: "What is the difference between Team 1 and Team 2?", answer: "Team 1 works on the truck and the operating day: load options, rates, routes, brokers, setup, documents, invoicing, and follow-up. Team 2 works on reducing future dependence on a single source of freight by researching shippers, dealers, repeat demand, lanes, SEO/search visibility, and inbound transport requests. Neither team can promise a specific market result." },
    { question: "Is the goal to stop using load boards?", answer: "The long-term goal is to reduce dependence on any single third-party source when real direct or inbound demand can be developed. Load boards can still remain useful. Hermes does not promise that direct freight will replace them, or that this will happen on a fixed schedule." },
    { question: "Who makes the final decision on a load?", answer: "The carrier does. Hermes can research, communicate, negotiate, and coordinate information, but the carrier approves every load before booking." },
    { question: "What happens during the first 24–48 hours after approval?", answer: "If the carrier has been approved and the required authority, insurance, equipment, contact, and communication information is available, the initial window is used to confirm the operating profile, current availability, lane and equipment filters, broker-setup readiness, carrier approval rules, escalation contacts, and the first candidate-load review workflow. It does not guarantee dispatcher assignment, a fixed response time, load availability, booking, rate, mileage, lane consistency, or revenue. Missing documents, changing availability, broker requirements, and market conditions can extend the sequence." },
    { question: "What does a car hauler dispatcher do?", answer: "The approved scope may include searching load boards and direct sources, checking route and equipment fit, calling brokers or dealers, discussing rates and requirements, preparing setup packets, organizing rate confirmations and transport documents, coordinating updates, supporting invoicing, and tracking follow-up. The dispatcher does not replace the carrier's authority, safety responsibility, or final booking decision." },
    { question: "Is dispatch support better than self-dispatch?", answer: "Not for every carrier. Self-dispatch can fit an owner-operator who has the time, tools, relationships, paperwork discipline, and lane knowledge to manage the full process. Dispatch support can reduce administrative workload and expand search and follow-up coverage, but the carrier should compare scope, fee, control, communication, and actual operating needs before deciding." },
    { question: "How much does car hauling dispatch cost?", answer: "The exact fee depends on the approved service scope and signed agreement. Hermes currently presents a broader Full Partnership option at 8%, while narrower or custom scopes may use different terms. Before signing, confirm exactly what the percentage covers and make sure the same term appears in Appendix A. No fee is represented as a guarantee of a particular rate or revenue result." },
    { question: "What equipment and capacity can be reviewed?", answer: "Support may be available for one-car equipment, two- to three-car hotshot or wedge trailers, open multi-car haulers, enclosed trailers, and other vehicle-transport configurations after actual capacity and operating requirements are reviewed." },
    { question: "Can a new authority start immediately?", answer: "Not always. Broker requirements, insurance, safety profile, authority age, documentation, and equipment readiness must be reviewed first. A new authority may qualify for a readiness process before it qualifies for ordinary active dispatch or specific load access." },
    { question: "Does Hermes operate the trucks?", answer: "Hermes provides dispatch, information, communication, research, and back-office support. The motor carrier controls the truck, driver, safety decisions, and transportation service." },
    { question: "What happens after I complete the carrier intake?", answer: "The direct workspace prepares a qualified request for Logistics Sales. Secure delivery is used only when the approved receiver confirms it; otherwise the prepared email and direct phone remain available. Submission does not automatically create an account, assign a dispatcher, book a load, or guarantee acceptance." },
    { question: "How do we begin?", answer: "Open the direct carrier intake and provide your MC or USDOT number, authority status, equipment, capacity, home base, preferred operating area, availability, fleet size, current dispatch status, and business contact information. Do not place sensitive shipment details in public URLs." },
  ],
  related: [
    { label: "Start Car Hauling Dispatch Review", href: "/logistics/start-car-hauling-dispatch/" },
    { label: "Review Carrier Support Options", href: "/logistics/carrier-offer/" },
    { label: "Direct Vehicle Transport Network", href: "/logistics/direct-vehicle-transport-network/" },
    { label: "Dispatch Support vs Self-Dispatch", href: "/logistics/resources/dispatch-service-vs-self-dispatch/" },
    { label: "Owner-Operator Logistics Path", href: "/paths/logistics/carriers/owner-operators/" },
    { label: "Fleet Owner Logistics Path", href: "/paths/logistics/carriers/fleet-owners/" },
    { label: "New Authority Carrier Support", href: "/paths/logistics/carriers/new-authority/" },
    { label: "Car Hauler Capacity Checklist", href: "/logistics/resources/car-hauler-capacity-checklist/" },
    { label: "Dealer Vehicle Transportation", href: "/logistics/dealer-vehicle-transportation/" },
    { label: "Preview the Load Board Demo", href: "/load-board/?role=carrier&equipment=car_hauler#available-loads" },
    { label: "Contact Hermes", href: "/contacts/" },
  ],
};
---

<LogisticsCommercialPage content={content} />