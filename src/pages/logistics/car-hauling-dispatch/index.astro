---
import LogisticsCommercialPage from "../../../components/LogisticsCommercialPage.astro";

const content = {
  title: "Car Hauling Dispatch Services for Owner-Operators | Hermes Logistics",
  description: "Car hauling dispatch services and back-office support for owner-operators and small fleets, including load review, broker communication, paperwork, invoicing, and carrier-controlled booking.",
  eyebrow: "Hermes Logistics · Car Hauling Dispatch",
  h1: "Car Hauling Dispatch Services for Owner-Operators and Small Fleets",
  intro: "Hermes supports car-hauling carriers with load search, route and equipment review, broker communication, paperwork coordination, invoicing follow-through, and a structured process for developing stronger freight relationships. The carrier reviews and approves every load before booking.",
  image: "/images/path-logistics-system.jpg",
  imageAlt: "Vehicle transportation routes and car hauling operations network",
  primaryAction: {
    label: "Request car-hauling dispatch review",
    href: "/load-board/?role=carrier#carrier-access",
  },
  handoffNote: "Start with the carrier intake so Logistics Sales can review your authority, equipment, capacity, operating area, and availability. The preview does not create an account, assign a dispatcher, or guarantee a load, rate, lane, revenue, or response time.",
  audience: [
    "Owner-operators running hotshot, open, enclosed, or multi-car equipment",
    "Small fleets with equipment that can transport from one vehicle through multi-car capacity",
    "Carriers seeking support with broker setup, documents, invoicing, and communication",
    "New authorities that need a realistic readiness review before active dispatch",
  ],
  benefits: [
    { title: "Daily load and route review", body: "Load search, route evaluation, deadhead awareness, broker calls, rate discussion, pickup and delivery requirements, and operating-fit review around the carrier's equipment and preferences." },
    { title: "Carrier back office", body: "Support with setup packets, insurance certificates, rate confirmations, document organization, invoicing, and accounts-receivable follow-up." },
    { title: "Direct freight development", body: "A separate long-term process for identifying repeat dealer, auction, broker, and shipper relationships. No guaranteed lanes or revenue claims." },
    { title: "Equipment-aware matching", body: "One-car, two- to three-car, open multi-car, enclosed, inoperable-capable, hotshot, and other vehicle-transport equipment are reviewed according to actual capacity and restrictions." },
    { title: "Authority and insurance checks", body: "MC, DOT, operating authority, insurance status, equipment, service area, and documentation are reviewed before active work begins." },
    { title: "Carrier-controlled booking", body: "Hermes coordinates information and communication. The carrier makes the final operating decision and approves each load before booking." },
  ],
  process: [
    { title: "Carrier intake", body: "Share your role, company, MC or USDOT number, equipment class, capacity, availability, home area, and contact information in the carrier workspace." },
    { title: "Qualification", body: "Logistics Sales reviews authority status, insurance readiness, equipment, operating area, preferred lanes, availability, and operating constraints." },
    { title: "Operating profile", body: "We document truck and trailer capacity, home base, preferred regions, minimum rate expectations, communication rules, and required paperwork." },
    { title: "Load and lane review", body: "Potential loads are checked against equipment, timing, route, pickup and delivery requirements, available information, and disclosed operating preferences." },
    { title: "Carrier approval and follow-through", body: "The carrier makes the final decision before booking. Hermes coordinates approved communication and documents while the carrier remains responsible for safe and lawful transportation." },
  ],
  faq: [
    { question: "Does Hermes guarantee loads, rates, or revenue?", answer: "No. Freight availability, rates, timing, lane consistency, and broker requirements change with the market. Hermes provides dispatch and coordination support without guaranteeing revenue, mileage, rates, lanes, response time, or specific loads." },
    { question: "Who makes the final decision on a load?", answer: "The carrier does. Hermes can research, communicate, negotiate, and coordinate information, but the carrier approves every load before booking." },
    { question: "What equipment and capacity can be reviewed?", answer: "Support may be available for one-car equipment, two- to three-car hotshot or wedge trailers, open multi-car haulers, enclosed trailers, and other vehicle-transport configurations after actual capacity and operating requirements are reviewed." },
    { question: "Can a new authority start immediately?", answer: "Not always. Broker requirements, insurance, safety profile, authority age, documentation, and equipment readiness must be reviewed first." },
    { question: "Does Hermes operate the trucks?", answer: "Hermes provides dispatch, information, communication, and back-office support. The motor carrier controls the truck, driver, safety decisions, and transportation service." },
    { question: "What happens after I complete the carrier intake?", answer: "The current workspace prepares a reviewed request for Logistics Sales. In preview mode it does not automatically create an account, assign a dispatcher, send data, or guarantee acceptance. Email and phone remain available as direct fallback routes." },
    { question: "How do we begin?", answer: "Open the carrier intake and provide your MC or USDOT number, equipment, capacity, home base, preferred operating area, availability, and business contact information. Do not place sensitive shipment details in public URLs." },
  ],
  related: [
    { label: "Owner-Operator Logistics Path", href: "/paths/logistics/carriers/owner-operators/" },
    { label: "Fleet Owner Logistics Path", href: "/paths/logistics/carriers/fleet-owners/" },
    { label: "New Authority Carrier Support", href: "/paths/logistics/carriers/new-authority/" },
    { label: "Car Hauler Capacity Checklist", href: "/logistics/resources/car-hauler-capacity-checklist/" },
    { label: "Dealer Vehicle Transportation", href: "/logistics/dealer-vehicle-transportation/" },
    { label: "Open Carrier Intake", href: "/load-board/?role=carrier#carrier-access" },
    { label: "Contact Hermes", href: "/contacts/" },
  ],
};
---

<LogisticsCommercialPage content={content} />
