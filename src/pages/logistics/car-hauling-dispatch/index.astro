---
import LogisticsCommercialPage from "../../../components/LogisticsCommercialPage.astro";

const content = {
  title: "Car Hauling Dispatch Services for Owner-Operators | Hermes Logistics",
  description: "Car hauling dispatch support for U.S. owner-operators and small fleets: multi-source load search, broker calls, paperwork, invoicing, direct-demand development.",
  eyebrow: "Hermes Logistics · Car Hauling Dispatch",
  h1: "Car Hauling Dispatch Services for Owner-Operators and Small Fleets",
  intro: "Hermes can support the work that keeps the truck moving today, expand load-search coverage beyond one source, and develop stronger freight relationships over time. The carrier reviews and approves every load before booking.",
  image: "/images/path-logistics-system.jpg",
  imageAlt: "Vehicle transportation routes and car hauling operations network",
  primaryAction: {
    label: "Start car-hauling dispatch review",
    href: "/logistics/start-car-hauling-dispatch/",
  },
  handoffNote: "Use the direct carrier intake so Logistics Sales can review authority, insurance, equipment, capacity, operating area, availability, and the support scope that actually fits the business. The public Load Board remains an illustrative product preview and is not the commercial intake path.",
  audience: [
    "Owner-operators running hotshot, open, enclosed, wedge, or multi-car equipment",
    "Small fleets that need more search coverage without giving up final load control",
    "Carriers that need broker calls, setup packets, paperwork, invoicing, and daily coordination",
    "Carriers that want broader marketplace coverage plus long-term dealer, auction, broker, shipper, and repeat-customer research",
    "Car haulers operating in the current 25-market GEO launch across Colorado Front Range, Puget Sound, Missouri/Kansas, the Chicago area, and Fremont / the Bay Area; these are carrier-acquisition search markets, not Hermes office locations or freight guarantees",
  ],
  benefits: [
    { title: "Workstream 1 · Find the next candidate load", body: "Start with the truck's current area, open capacity, equipment, timing, destination preference, deadhead tolerance, and carrier instructions. Research candidate loads and present operating facts for carrier approval." },
    { title: "Workstream 2 · Expand search + back office", body: "When approved access and the signed scope allow it, widen research across auto-transport marketplaces, carrier networks, broker and dealer portals, auctions, and other sources while supporting broker calls, rate discussion, setup packets, documents, invoicing, and follow-up." },
    { title: "Workstream 3 · Develop direct demand", body: "Once the operating profile is understood, a separate long-term workstream can research dealers, auctions, brokers, shippers, and repeat customers that fit the carrier's equipment and operating needs. Timing, responses, direct customers, lanes, rates, volume, and revenue are not guaranteed." },
    { title: "25-market carrier GEO launch", body: "The current search and carrier-acquisition launch focuses on Colorado Springs, Puyallup, Denver, Springfield, Aurora, Kansas City, Chicago-area markets, St. Louis, Puget Sound markets, Fremont, and the rest of the published 25-market set. The market pages describe search context, not local Hermes offices or live freight inventory." },
    { title: "One operating profile", body: "MC, DOT, operating authority, insurance status, equipment, capacity, home market, preferred regions, restrictions, availability, minimum-rate expectations, communication rules, and carrier approval rules can be reviewed in one working picture so approved support follows the same operating goals." },
    { title: "Carrier back office", body: "Support can include setup packets, insurance certificates, rate confirmations, document organization, invoicing, accounts-receivable follow-up, and routine coordination that otherwise stays on the owner-operator's desk." },
    { title: "Carrier-controlled booking", body: "Hermes researches, communicates, discusses rates within approved instructions, and coordinates information. The carrier makes the final operating decision, reviews and approves every load before booking, and can reject any candidate load." },
    { title: "Dispatch versus self-dispatch review", body: "A carrier may keep load-board search, broker calls, route planning, setup packets, documents, invoicing, and follow-up in-house or delegate an approved scope. The right model depends on time, experience, equipment, lanes, authority readiness, and the control the carrier wants to retain." },
    { title: "Scope and fee review", body: "Scope before percentage: compare the fee with the work behind it. Load-search-only support is different from a broader approved scope that includes daily dispatch, documents, billing, operating follow-through, and long-term direct-demand research." },
  ],
  process: [
    { title: "Carrier intake", body: "Share your role, company, MC or USDOT number, equipment class, capacity, availability, home area, and contact information in the direct dispatch-review workspace." },
    { title: "Qualification", body: "Logistics Sales reviews authority status and age, insurance readiness, equipment, operating area, preferred lanes, availability, fleet size, current dispatch relationship, and operating constraints." },
    { title: "Operating profile", body: "We document truck and trailer capacity, home base, preferred regions, minimum-rate expectations, communication rules, carrier approval rules, and required paperwork so daily dispatch and longer-term development work from the same facts." },
    { title: "Initial setup and candidate-load workflow", body: "After approval and receipt of the required authority, insurance, equipment, contact, and communication details, the initial setup confirms availability, lane and equipment filters, broker-setup readiness, carrier approval rules, escalation contacts, and the candidate-load review workflow. This is not a guarantee of dispatcher assignment, response time, load availability, booking, rate, mileage, lane consistency, or revenue." },
    { title: "Today and tomorrow run in parallel", body: "Candidate loads are checked against equipment, deadhead, timing, route, requirements, source, documents, and offered rate while an approved long-term development scope can research repeat customers and direct prospects." },
    { title: "Carrier approval and follow-through", body: "The carrier makes the final decision before booking. Hermes coordinates approved communication and documents while the carrier remains responsible for safe and lawful transportation." },
  ],
  faq: [
    { question: "Does Hermes guarantee loads, rates, or revenue?", answer: "No. Freight availability, rates, timing, lane consistency, customer demand, search visibility, and source requirements change with the market. Hermes commits to an approved support process, not a guaranteed market result." },
    { question: "Can I reject a load?", answer: "Yes. The carrier controls the truck and makes the final load decision. Hermes can research, call, discuss rates within instructions, and prepare the information, but a candidate load is not booked until the carrier approves it." },
    { question: "Which U.S. markets is Hermes prioritizing for car-hauler acquisition?", answer: "The current first launch is the published 25-market Car Hauler Load Search set, led by Colorado Front Range, Puget Sound, Missouri/Kansas, Chicago-area markets, and Fremont / the Bay Area. These are search and carrier-acquisition markets, not Hermes office locations, and they do not guarantee freight, rates, lane consistency, utilization, or revenue." },
    { question: "Does Hermes search more than one car-hauling source?", answer: "Depending on carrier eligibility, account access, source rules, and the signed scope, research can include major auto-transport marketplaces and carrier networks together with broker, dealer, auction, shipper, and direct-customer sources. Mentioning a third-party platform does not imply partnership, guaranteed access, exclusive freight, or guaranteed availability." },
    { question: "Why can the Full Partnership option be 8%?", answer: "The current carrier proposal presents Full Partnership at 8% because the scope is broader than load search alone: daily dispatch support plus lane and schedule planning, customer research, route development, operational follow-up, and approved Hermes handoffs. The exact commercial term must match the carrier-specific Appendix A. An 8% fee does not guarantee loads, rates, mileage, customers, or revenue." },
    { question: "How do the three workstreams fit together?", answer: "The first focuses on the immediate operating need and candidate-load search. The second expands approved source coverage and back-office support. The third is a separate long-term direct-demand research and relationship-development process. These describe workstreams, not a promise of three dedicated employees; exact people and responsibilities depend on the signed scope." },
    { question: "How is Hermes developing direct demand around carrier operating areas?", answer: "An approved long-term scope can research dealers, auctions, brokers, shippers, businesses, and repeat customers that fit the carrier's equipment and operating needs. Public search pages may support that acquisition strategy without publishing private carrier lanes. A page, ranking, customer, direct load, timing, rate, mileage, utilization, or revenue is not guaranteed." },
    { question: "What does a car hauler dispatcher do?", answer: "The approved scope may include searching load boards and direct sources, checking route and equipment fit, calling brokers or dealers, discussing rates and requirements, preparing setup packets, organizing rate confirmations and transport documents, coordinating updates, supporting invoicing, and tracking follow-up. The dispatcher does not replace the carrier's authority, safety responsibility, or final booking decision." },
    { question: "Is dispatch service better than self-dispatch?", answer: "Not for every carrier. Self-dispatch can fit an owner-operator who has the time, tools, source relationships, paperwork discipline, and lane knowledge to manage the full process. Dispatch support can reduce administrative workload and increase search coverage, but the carrier should compare scope, fee, control, communication, and actual operating needs before deciding." },
    { question: "How much does car hauling dispatch service cost?", answer: "The current private carrier proposal separates a narrower Dispatch Support option from a broader Full Partnership option and allows a carrier-specific proposal. The exact percentage and scope are confirmed in the applicable agreement and Appendix A. Compare what is actually included rather than treating one percentage as universal." },
    { question: "What equipment and capacity can be reviewed?", answer: "Support may be available for one-car equipment, two- to three-car hotshot or wedge trailers, open multi-car haulers, enclosed trailers, and other vehicle-transport configurations after actual capacity and operating requirements are reviewed." },
    { question: "Can a new authority start immediately?", answer: "Not always. Broker requirements, insurance, safety profile, authority age, documentation, and equipment readiness must be reviewed first. A new authority may qualify for a readiness process before it qualifies for ordinary active dispatch or specific source access." },
    { question: "Does Hermes operate the trucks?", answer: "Hermes provides dispatch, information, communication, and back-office support. The motor carrier controls the truck, driver, safety decisions, compliance, and transportation service." },
    { question: "What happens after I complete the carrier intake?", answer: "The direct workspace prepares a qualified request for Logistics Sales. Secure delivery is used only when the approved receiver confirms it; otherwise the prepared email and direct phone remain available. Submission does not automatically create an account, assign a dispatcher, book a load, or guarantee acceptance." },
    { question: "How do we begin?", answer: "Open the direct carrier intake and provide your MC or USDOT number, authority status, equipment, capacity, home base, preferred operating area, availability, fleet size, current dispatch status, and business contact information. Do not place sensitive shipment details in public URLs." },
  ],
  related: [
    { label: "Car Hauler Load Search by U.S. Market", href: "/logistics/car-hauler-loads/" },
    { label: "Start Car Hauling Dispatch Review", href: "/logistics/start-car-hauling-dispatch/" },
    { label: "Direct Vehicle Transport Network", href: "/logistics/direct-vehicle-transport-network/" },
    { label: "Dispatch Service vs Self-Dispatch", href: "/logistics/resources/dispatch-service-vs-self-dispatch/" },
    { label: "Broker Setup Packet Checklist", href: "/logistics/resources/broker-setup-packet-checklist/" },
    { label: "New Authority Car Hauler Readiness Checklist", href: "/logistics/resources/new-authority-car-hauler-readiness-checklist/" },
    { label: "Owner-Operator Logistics Path", href: "/paths/logistics/carriers/owner-operators/" },
    { label: "Fleet Owner Logistics Path", href: "/paths/logistics/carriers/fleet-owners/" },
    { label: "New Authority Carrier Support", href: "/paths/logistics/carriers/new-authority/" },
    { label: "Car Hauler Capacity Checklist", href: "/logistics/resources/car-hauler-capacity-checklist/" },
    { label: "Dealer Vehicle Transportation", href: "/logistics/dealer-vehicle-transportation/" },
    { label: "Hermes Connect for Repair Shops", href: "/services/hermes-connect/repair-shops/" },
    { label: "Preview the Load Board Demo", href: "/load-board/#role=carrier&equipment=car_hauler&target=available-loads" },
    { label: "Carrier Plans and Agreement", href: "/carrier/" },
    { label: "Contact Hermes", href: "/contacts/" },
  ],
};
---

<LogisticsCommercialPage content={content} />