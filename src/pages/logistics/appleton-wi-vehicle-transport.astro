---
import {
  ArrowLeft,
  ArrowRight,
  Building2,
  Car,
  Check,
  ClipboardCheck,
  MapPin,
  ShieldCheck,
  Truck,
} from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";

const title = "Appleton Vehicle Transport | Hermes Logistics";
const description =
  "Request vehicle transport to or from Appleton, Wisconsin for dealer, auction, business, or private moves. Hermes reviews route, timing, and equipment.";
const canonicalUrl = new URL("/logistics/appleton-wi-vehicle-transport/", Astro.site).toString();

const faq = [
  {
    question: "How much does vehicle transport to or from Appleton cost?",
    answer:
      "Pricing depends on the exact route, vehicle size and condition, open or enclosed equipment, pickup and delivery access, timing, season, and current carrier availability. Submit the complete request for review instead of relying on a generic city estimate.",
  },
  {
    question: "How long does Appleton vehicle transport take?",
    answer:
      "Timing depends on route distance, pickup readiness, scheduling flexibility, equipment availability, weather, traffic, and legal operating limits. A requested date is not confirmed until the transport arrangement is accepted and scheduled.",
  },
  {
    question: "Can Hermes review an inoperable vehicle?",
    answer:
      "Yes. State whether the vehicle starts, rolls, steers, and brakes so the equipment and handling requirements can be evaluated before carrier coordination.",
  },
  {
    question: "What information helps with an auction pickup?",
    answer:
      "Provide the exact facility, vehicle and lot or stock reference, release status, pickup hours, storage deadline, vehicle condition, and correct pickup contact. Requirements vary by facility.",
  },
  {
    question: "Can a dealer request transport for multiple vehicles?",
    answer:
      "Yes. Include a complete unit list, vehicle conditions, pickup and delivery requirements, access restrictions, preferred timing, and any required delivery sequence.",
  },
  {
    question: "Does submitting a request guarantee a carrier?",
    answer:
      "No. Hermes first reviews the request. Carrier coordination depends on route, equipment, compliance, timing, capacity, and final confirmation.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Appleton vehicle transport request coordination",
    description,
    url: canonicalUrl,
    serviceType: "Vehicle transport request review and carrier coordination",
    areaServed: [
      { "@type": "City", name: "Appleton", containedInPlace: { "@type": "State", name: "Wisconsin" } },
      { "@type": "AdministrativeArea", name: "Fox Valley, Wisconsin" },
      { "@type": "Country", name: "United States" },
    ],
    provider: {
      "@type": "Organization",
      name: "Hermes Logistics",
      url: "https://hermeslogisticsus.com/paths/logistics/",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Logistics", item: "https://hermeslogisticsus.com/paths/logistics/" },
      { "@type": "ListItem", position: 3, name: "Appleton Vehicle Transport", item: canonicalUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
import "../../styles/features/appleton.css";
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="appleton-service-page">
    <SiteHeader theme="dark" activePath="/paths/logistics/" />
    <main id="main-content">
      <section class="appleton-hero" id="top">
        <div class="shell">
          <nav class="appleton-breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span>
            <a href="/paths/logistics/">Logistics</a><span aria-hidden="true">/</span>
            <span aria-current="page">Appleton vehicle transport</span>
          </nav>
          <a class="detail-back" href="/paths/logistics/"><ArrowLeft size={18} aria-hidden="true" />Hermes Logistics</a>
          <div class="appleton-hero-grid">
            <div>
              <p class="eyebrow">Hermes Logistics · Appleton and Fox Valley</p>
              <h1>Vehicle transport to and from Appleton, Wisconsin.</h1>
              <p class="appleton-hero-copy">
                Hermes reviews transport requests for dealers, auction buyers and sellers, businesses, and private
                customers. Start with the exact route, vehicle condition, timing, and access details.
              </p>
              <div class="logistics-audience-actions">
                <a class="button button-primary" href="/load-board/?role=private_party&amp;origin=Appleton%2C%20WI#post-load">
                  Prepare a transport request <ArrowRight size={18} aria-hidden="true" />
                </a>
                <a class="button" href="/load-board/?role=carrier&amp;area=Appleton%2C%20WI#carrier-access">
                  Carrier: share capacity
                </a>
              </div>
              <p class="appleton-boundary">
                Submitting the form prepares a request for Logistics Sales review. It does not guarantee price, timing,
                equipment, or carrier availability.
              </p>
            </div>
            <aside class="appleton-hero-panel" aria-label="Request review summary">
              <MapPin size={28} aria-hidden="true" />
              <p class="eyebrow">Route-first review</p>
              <h2>One vehicle or a multi-unit move.</h2>
              <ul>
                <li><Check size={17} aria-hidden="true" />To or from Appleton and Fox Valley</li>
                <li><Check size={17} aria-hidden="true" />Operable or disclosed inoperable vehicles</li>
                <li><Check size={17} aria-hidden="true" />Open or enclosed equipment requests</li>
                <li><Check size={17} aria-hidden="true" />Dealer, auction, business, and private moves</li>
              </ul>
            </aside>
          </div>
        </div>
      </section>

      <section class="section appleton-audiences" aria-labelledby="appleton-audiences-title">
        <div class="shell">
          <div class="section-heading split-heading">
            <div>
              <p class="eyebrow">Who we help</p>
              <h2 id="appleton-audiences-title">Start with the type of move.</h2>
            </div>
            <p>Each request follows the same review, but the details needed can differ by customer and pickup location.</p>
          </div>
          <div class="appleton-card-grid">
            <article>
              <Building2 size={25} aria-hidden="true" />
              <h3>Auto dealers</h3>
              <p>Purchased, sold, traded, or transferred vehicles, including multi-unit inventory moves.</p>
              <a href="/load-board/?role=dealer&amp;origin=Appleton%2C%20WI#post-load">Dealer request <ArrowRight size={16} aria-hidden="true" /></a>
            </article>
            <article>
              <ClipboardCheck size={25} aria-hidden="true" />
              <h3>Auction buyers and sellers</h3>
              <p>Pickup planning with release status, facility requirements, vehicle condition, and storage deadlines.</p>
              <a href="/load-board/?role=shipper&amp;origin=Appleton%2C%20WI#post-load">Prepare auction pickup <ArrowRight size={16} aria-hidden="true" /></a>
            </article>
            <article>
              <Car size={25} aria-hidden="true" />
              <h3>Private customers</h3>
              <p>Relocation, purchase, sale, or a vehicle move for a family member or another known recipient.</p>
              <a href="/load-board/?role=private_party&amp;origin=Appleton%2C%20WI#post-load">Private vehicle request <ArrowRight size={16} aria-hidden="true" /></a>
            </article>
            <article>
              <Truck size={25} aria-hidden="true" />
              <h3>Carriers and car haulers</h3>
              <p>Share Appleton-area equipment, authority, operating area, capacity, and availability for review.</p>
              <a href="/load-board/?role=carrier&amp;area=Appleton%2C%20WI#carrier-access">Share capacity <ArrowRight size={16} aria-hidden="true" /></a>
            </article>
          </div>
        </div>
      </section>

      <section class="section appleton-preparation" aria-labelledby="appleton-prepare-title">
        <div class="shell appleton-two-column">
          <div>
            <p class="eyebrow">Information to prepare</p>
            <h2 id="appleton-prepare-title">Good routing begins with complete details.</h2>
            <p>
              Complete information supports a more accurate review and reduces avoidable clarification before carrier
              coordination can begin.
            </p>
          </div>
          <ul class="appleton-checklist">
            <li><Check size={18} aria-hidden="true" /><span>Pickup and delivery city, state, or ZIP code</span></li>
            <li><Check size={18} aria-hidden="true" /><span>Vehicle year, make, model, quantity, and dimensions when unusual</span></li>
            <li><Check size={18} aria-hidden="true" /><span>Whether every vehicle starts, rolls, steers, and brakes</span></li>
            <li><Check size={18} aria-hidden="true" /><span>Earliest pickup date and any required delivery window</span></li>
            <li><Check size={18} aria-hidden="true" /><span>Open or enclosed transport preference</span></li>
            <li><Check size={18} aria-hidden="true" /><span>Facility access, pickup hours, release references, and storage deadlines</span></li>
            <li><Check size={18} aria-hidden="true" /><span>Reliable pickup and delivery contact information</span></li>
          </ul>
        </div>
      </section>

      <section class="section appleton-planning" aria-labelledby="appleton-planning-title">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow">Auction and dealer planning</p>
            <h2 id="appleton-planning-title">The address is only one part of pickup readiness.</h2>
          </div>
          <div class="appleton-planning-grid">
            <article>
              <h3>Confirm release and authorization</h3>
              <p>Make sure the vehicle is released and the pickup party will have the correct lot, stock, buyer, or authorization reference. Use the <a href="/logistics/resources/auction-vehicle-pickup-checklist/">auction vehicle pickup checklist</a> before requesting transport.</p>
            </article>
            <article>
              <h3>Disclose the exact condition</h3>
              <p>A vehicle that does not run, roll, steer, or brake may need different loading equipment and handling.</p>
            </article>
            <article>
              <h3>Check access and deadlines</h3>
              <p>Facility hours, loading rules, storage deadlines, keys, dimensions, and receiving restrictions can affect the workable plan.</p>
            </article>
          </div>
          <p class="appleton-non-affiliation">
            Hermes is not presented as affiliated with any Appleton auction, dealership, storage facility, or public agency.
            Requirements must be confirmed with the actual pickup location.
          </p>
          <a class="appleton-section-link" href="/logistics/resources/auction-vehicle-pickup-checklist/">
            Open the national Auction Vehicle Pickup Checklist <ArrowRight size={16} aria-hidden="true" />
          </a>
        </div>
      </section>

      <section class="section appleton-process" aria-labelledby="appleton-process-title">
        <div class="shell">
          <div class="section-heading split-heading">
            <div>
              <p class="eyebrow">How the review works</p>
              <h2 id="appleton-process-title">From exact request to confirmed next step.</h2>
            </div>
            <p>No shipment is represented as booked until the applicable arrangement has been accepted and confirmed.</p>
          </div>
          <ol class="appleton-process-grid">
            <li><span>01</span><h3>Submit the details</h3><p>Provide route, vehicle, condition, timing, access, and contact information.</p></li>
            <li><span>02</span><h3>Request review</h3><p>Logistics Sales checks completeness and compatibility with the current service process.</p></li>
            <li><span>03</span><h3>Clarify when needed</h3><p>Missing release, condition, access, or scheduling details are confirmed.</p></li>
            <li><span>04</span><h3>Coordinate by fit</h3><p>A qualified request can proceed based on route, equipment, compliance, and availability.</p></li>
            <li><span>05</span><h3>Confirm the next step</h3><p>The applicable next action is communicated; submission alone is not a booking.</p></li>
          </ol>
        </div>
      </section>

      <section class="section appleton-equipment" aria-labelledby="appleton-equipment-title">
        <div class="shell appleton-two-column">
          <div>
            <p class="eyebrow">Equipment request</p>
            <h2 id="appleton-equipment-title">Open or enclosed vehicle transport.</h2>
          </div>
          <div>
            <p>
              Open transport is commonly considered for standard vehicle moves and can offer broader equipment
              availability. Enclosed transport may be requested for vehicles needing additional protection, including
              certain classic, specialty, high-value, or sensitive vehicles.
            </p>
            <p>
              The appropriate option depends on the vehicle, route, timing, handling requirements, and available
              equipment. Hermes reviews these details as part of the request.
            </p>
          </div>
        </div>
      </section>

      <section class="section logistics-faq appleton-faq" aria-labelledby="appleton-faq-title">
        <div class="shell faq-layout">
          <div>
            <p class="eyebrow">FAQ</p>
            <h2 id="appleton-faq-title">Before you submit.</h2>
          </div>
          <div class="faq-list">
            {faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section appleton-carrier-note" aria-labelledby="appleton-carrier-title">
        <div class="shell appleton-carrier-card">
          <ShieldCheck size={34} aria-hidden="true" />
          <div>
            <p class="eyebrow">For carriers and car haulers</p>
            <h2 id="appleton-carrier-title">Share Appleton-area capacity for review.</h2>
            <p>
              Provide equipment type, operating authority, preferred routes, capacity, and schedule. Sharing availability
              does not guarantee a load; compliance, timing, equipment fit, and the current operating process must be confirmed.
            </p>
            <a class="appleton-section-link" href="/logistics/resources/car-hauler-capacity-checklist/">
              Review the Car Hauler Capacity Checklist <ArrowRight size={16} aria-hidden="true" />
            </a>
          </div>
          <a class="button button-primary" href="/load-board/?role=carrier&amp;area=Appleton%2C%20WI#carrier-access">
            Open carrier intake <ArrowRight size={18} aria-hidden="true" />
          </a>
        </div>
      </section>

      <section class="section appleton-final-cta" id="contact" aria-labelledby="appleton-cta-title">
        <div class="shell appleton-final-card">
          <div>
            <p class="eyebrow">Plan the move</p>
            <h2 id="appleton-cta-title">Prepare an Appleton vehicle transport request.</h2>
            <p>
              Send the route, vehicle information, condition, timing, and access details. The current form prepares a
              structured Logistics Sales email for your review; it does not automatically publish a load or contact a carrier.
            </p>
          </div>
          <div class="appleton-final-actions">
            <a class="button button-primary" href="/load-board/?role=private_party&amp;origin=Appleton%2C%20WI#post-load">
              Prepare customer request <ArrowRight size={18} aria-hidden="true" />
            </a>
            <a class="button" href="/logistics/shipper-dealer/">Shipper and dealer information</a>
            <a class="appleton-text-link" href="/load-board/">See the honest Load Board preview</a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
