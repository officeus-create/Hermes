---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "Waukesha Vehicle Transport | Hermes Logistics";
const description = "Request vehicle transport to or from Waukesha, Wisconsin for dealer, auction, business, or private moves. Hermes reviews route, timing, vehicle condition, and equipment needs.";
const canonicalUrl = new URL("/logistics/waukesha-wi-vehicle-transport/", Astro.site).toString();

const faq = [
  { question: "How much does vehicle transport to or from Waukesha cost?", answer: "Pricing depends on route distance, vehicle size and condition, equipment type, access, timing, season, and current carrier availability. Submit complete details for review." },
  { question: "Can Hermes review dealer and auction vehicle moves?", answer: "Yes. Dealers, auction buyers and sellers, businesses, and private customers can submit route, release, condition, access, and timing details for review." },
  { question: "Can inoperable vehicles be reviewed?", answer: "Yes. State whether the vehicle starts, rolls, steers, and brakes so equipment and handling requirements can be evaluated." },
  { question: "Does submitting a request guarantee pickup?", answer: "No. Coordination depends on route, equipment, compliance, timing, capacity, and final confirmation." },
];

const schema = [
  { "@context": "https://schema.org", "@type": "Service", name: "Waukesha vehicle transport request coordination", description, url: canonicalUrl, serviceType: "Vehicle transport request review and carrier coordination", areaServed: [{ "@type": "City", name: "Waukesha", containedInPlace: { "@type": "State", name: "Wisconsin" } }, { "@type": "AdministrativeArea", name: "Waukesha County, Wisconsin" }, { "@type": "Country", name: "United States" }], provider: { "@type": "Organization", name: "Hermes Logistics", url: "https://hermeslogisticsus.com/paths/logistics/" } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" }, { "@type": "ListItem", position: 2, name: "Logistics", item: "https://hermeslogisticsus.com/paths/logistics/" }, { "@type": "ListItem", position: 3, name: "Waukesha Vehicle Transport", item: canonicalUrl }] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <SiteHeader theme="dark" activePath="/paths/logistics/" />
  <main id="main-content">
    <section class="section"><div class="shell">
      <nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/paths/logistics/">Logistics</a> / <span aria-current="page">Waukesha vehicle transport</span></nav>
      <p class="eyebrow">Hermes Logistics · Waukesha, Wisconsin</p>
      <h1>Vehicle transport to and from Waukesha, Wisconsin.</h1>
      <p>Hermes reviews requests for dealers, auction buyers and sellers, businesses, and private customers. Provide the exact route, vehicle condition, timing, access requirements, and preferred equipment.</p>
      <div class="logistics-audience-actions"><a class="button button-primary" href="/load-board/?role=private_party&amp;origin=Waukesha%2C%20WI#post-load">Prepare a transport request</a><a class="button" href="/load-board/?role=carrier&amp;area=Waukesha%2C%20WI#carrier-access">Carrier: share capacity</a></div>
      <p>Submitting a request does not guarantee price, timing, equipment, or carrier availability.</p>
    </div></section>
    <section class="section"><div class="shell">
      <p class="eyebrow">Local transport planning</p><h2>Dealer, auction, business, and private vehicle moves.</h2>
      <p>Complete pickup and delivery details help reduce avoidable delays before review. Include city or ZIP, vehicle year, make, model, condition, earliest pickup date, delivery window, release references, and facility access rules.</p>
      <p>Use the <a href="/logistics/resources/auction-vehicle-pickup-checklist/">Auction Vehicle Pickup Checklist</a> for facility pickups and the <a href="/logistics/resources/car-hauler-capacity-checklist/">Car Hauler Capacity Checklist</a> when sharing carrier availability.</p>
    </div></section>
    <section class="section logistics-faq" aria-labelledby="waukesha-faq-title"><div class="shell faq-layout"><div><p class="eyebrow">FAQ</p><h2 id="waukesha-faq-title">Before you submit.</h2></div><div class="faq-list">{faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
