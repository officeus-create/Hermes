---
import LogisticsCommercialPage from "../../../components/LogisticsCommercialPage.astro";

const content = {
  title: "Fleet-Owner Dispatch Support | Hermes Logistics",
  description: "Dispatch and operations support for small car-hauling fleets, including equipment profiles, load review, broker communication, documents, invoicing, fleet-controlled approval, and a written operating plan.",
  eyebrow: "Hermes Logistics · Small Fleets",
  h1: "Fleet-Owner Dispatch and Operations Support",
  intro: "Hermes supports small car-hauling fleets with structured equipment profiles, load and route review, broker communication, paperwork coordination, invoicing follow-through, and operating communication across multiple trucks. The fleet owner retains control and approves each operating commitment. Before active work, the parties can document a Fleet Operating Plan covering contacts, approval rules, exceptions, status information, and the reporting rhythm included in the agreed scope.",
  image: "/images/path-logistics-system.jpg",
  imageAlt: "Small car hauling fleet dispatch and operations coordination",
  primaryAction: {
    label: "Start fleet dispatch review",
    href: "/logistics/start-car-hauling-dispatch/",
  },
  handoffNote: "Use the direct carrier intake so Logistics Sales can review authority, insurance, truck and trailer profiles, fleet size, home bases, operating regions, driver availability structure, approval contacts, current dispatch status, and reporting needs before a Fleet Operating Plan or support scope is discussed. Submission does not assign coverage or guarantee acceptance, loads, utilization, rates, lanes, response time, profit, or revenue.",
  audience: [
    "Small car-hauling fleets managing multiple trucks or trailers",
    "Fleet owners needing dispatch and back-office structure",
    "Operations teams coordinating different equipment profiles",
    "Carriers requiring centralized communication without surrendering control",
  ],
  benefits: [
    { title: "Truck-by-truck profiles", body: "Each truck and trailer can be documented by capacity, dimensions, location, driver availability, equipment type, restrictions, and operating preferences." },
    { title: "Central load review", body: "Potential opportunities are evaluated against the correct truck, route, timing, access, pickup and delivery requirements, and available information." },
    { title: "Written Fleet Operating Plan", body: "The approved workflow can identify the primary fleet contact, backup contact or escalation route, truck-status fields, carrier approval limits, document ownership, exception communication, and the reporting cadence actually included in the agreement." },
    { title: "Broker and document coordination", body: "Setup packets, insurance certificates, rate confirmations, pickup and delivery documents, invoices, and follow-up can be organized centrally." },
    { title: "Availability awareness", body: "Current truck location, schedule, home-time constraints, equipment fit, and service area can inform review without publishing private operating data." },
    { title: "Fleet-owner approval", body: "The fleet owner or authorized manager makes the final decision before any load is booked or committed." },
    { title: "No performance guarantees", body: "Loads, revenue, utilization, rates, mileage, return loads, lane consistency, response time, and uninterrupted coverage are not guaranteed." },
  ],
  process: [
    { title: "Fleet qualification", body: "Authority, insurance, equipment, truck count, drivers, operating area, documentation, and communication structure are reviewed." },
    { title: "Equipment registry", body: "Each truck and trailer profile is documented with capacity, dimensions, location, restrictions, and availability rules." },
    { title: "Operating-plan confirmation", body: "Before active work, confirm who may approve loads, the primary and backup communication route, required truck-status fields, exception and document ownership, privacy boundaries, and whether any daily, weekly, or other report is included." },
    { title: "Opportunity assignment review", body: "Potential loads are evaluated against the appropriate equipment, driver schedule, route, timing, broker requirements, and access." },
    { title: "Fleet approval", body: "The fleet owner or authorized manager reviews the available terms and approves the commitment before booking." },
    { title: "Operations follow-through", body: "Hermes supports the communication, documents, and agreed status reporting within the approved scope while the motor carrier remains responsible for drivers, safety, compliance, and transportation." },
  ],
  faq: [
    { question: "Can Hermes manage decisions for the fleet owner?", answer: "Hermes can coordinate information and communication, but the fleet owner or authorized manager approves each operating commitment unless a written agreement defines another lawful approval boundary." },
    { question: "What is included in a Fleet Operating Plan?", answer: "The plan can identify each truck and trailer profile, the primary fleet contact, an approved backup contact or escalation route, who may approve loads, required status information, document and invoice responsibilities, exception communication, privacy boundaries, and the reporting cadence included in the agreed scope. It does not automatically create 24/7 staffing or uninterrupted coverage." },
    { question: "What happens if the normal fleet contact is unavailable?", answer: "The agreed workflow should identify whether a backup fleet contact, deferred decision, or another approved escalation route applies. Hermes does not assume permission to commit a truck, change a rate, or accept a load when the required fleet approver is unavailable." },
    { question: "Does every fleet receive daily or weekly reports?", answer: "Not automatically. The written scope should state whether status reporting is included, which fields are reviewed, who receives it, and the agreed cadence. A public page does not promise a specific dashboard, report, response time, or monitoring schedule." },
    { question: "Can different equipment types be supported?", answer: "They may be reviewed separately by truck and trailer profile, including hotshot, open, enclosed, multi-car, inoperable-capable, and specialty configurations." },
    { question: "Are fleet utilization or revenue guaranteed?", answer: "No. Utilization, revenue, rates, mileage, profit, freight availability, lane consistency, and uninterrupted dispatch coverage are not guaranteed." },
    { question: "Can paperwork be centralized?", answer: "Hermes can support setup packets, insurance certificates, rate confirmations, document organization, invoicing, and follow-up within the agreed workflow." },
    { question: "Is private truck-location data published?", answer: "No. Private operating information should remain inside approved internal workflows and should not be exposed through public pages, URLs, or analytics." },
    { question: "How does a fleet begin?", answer: "Provide MC, DOT, authority status, insurance, truck and trailer profiles, driver availability structure, home bases, operating regions, decision contacts, communication rules, and the reporting needs that should be reviewed for the written scope." },
  ],
  related: [
    { label: "Carrier Plans and Packet", href: "/carrier/" },
    { label: "Car Hauling Dispatch Services", href: "/logistics/car-hauling-dispatch/" },
    { label: "Owner-Operator Dispatch Support", href: "/logistics/owner-operator-dispatch-support/" },
    { label: "Fleet-Owner Carrier Path", href: "/paths/logistics/carriers/fleet-owners/" },
    { label: "Car Hauler Capacity Checklist", href: "/logistics/resources/car-hauler-capacity-checklist/" },
    { label: "Dealer Vehicle Transportation", href: "/logistics/dealer-vehicle-transportation/" },
    { label: "Contact Hermes", href: "/contacts/" },
  ],
};
---

<LogisticsCommercialPage content={content} />
