---
import LogisticsCommercialPage from "../../../components/LogisticsCommercialPage.astro";

const content = {
  title: "Fleet-Owner Dispatch Support | Hermes Logistics",
  description: "Dispatch and operations support for small car-hauling fleets, including equipment profiles, load review, broker communication, documents, invoicing, and fleet-controlled approval.",
  eyebrow: "Hermes Logistics · Small Fleets",
  h1: "Fleet-Owner Dispatch and Operations Support",
  intro: "Hermes supports small car-hauling fleets with structured equipment profiles, load and route review, broker communication, paperwork coordination, invoicing follow-through, and operating communication across multiple trucks. The fleet owner retains control and approves each operating commitment.",
  image: "/images/path-logistics-system.jpg",
  imageAlt: "Small car hauling fleet dispatch and operations coordination",
  audience: [
    "Small car-hauling fleets managing multiple trucks or trailers",
    "Fleet owners needing dispatch and back-office structure",
    "Operations teams coordinating different equipment profiles",
    "Carriers requiring centralized communication without surrendering control",
  ],
  benefits: [
    { title: "Truck-by-truck profiles", body: "Each truck and trailer can be documented by capacity, dimensions, location, driver availability, equipment type, restrictions, and operating preferences." },
    { title: "Central load review", body: "Potential opportunities are evaluated against the correct truck, route, timing, access, pickup and delivery requirements, and available information." },
    { title: "Broker and document coordination", body: "Setup packets, insurance certificates, rate confirmations, pickup and delivery documents, invoices, and follow-up can be organized centrally." },
    { title: "Availability awareness", body: "Current truck location, schedule, home-time constraints, equipment fit, and service area can inform review without publishing private operating data." },
    { title: "Fleet-owner approval", body: "The fleet owner or authorized manager makes the final decision before any load is booked or committed." },
    { title: "No performance guarantees", body: "Loads, revenue, utilization, rates, mileage, return loads, and lane consistency are not guaranteed." },
  ],
  process: [
    { title: "Fleet qualification", body: "Authority, insurance, equipment, truck count, drivers, operating area, documentation, and communication structure are reviewed." },
    { title: "Equipment registry", body: "Each truck and trailer profile is documented with capacity, dimensions, location, restrictions, and availability rules." },
    { title: "Opportunity assignment review", body: "Potential loads are evaluated against the appropriate equipment, driver schedule, route, timing, broker requirements, and access." },
    { title: "Fleet approval", body: "The fleet owner or authorized manager reviews the available terms and approves the commitment before booking." },
    { title: "Operations follow-through", body: "Hermes supports communication and documents while the motor carrier remains responsible for drivers, safety, compliance, and transportation." },
  ],
  faq: [
    { question: "Can Hermes manage decisions for the fleet owner?", answer: "Hermes can coordinate information and communication, but the fleet owner or authorized manager approves each operating commitment." },
    { question: "Can different equipment types be supported?", answer: "They may be reviewed separately by truck and trailer profile, including hotshot, open, enclosed, multi-car, inoperable-capable, and specialty configurations." },
    { question: "Are fleet utilization or revenue guaranteed?", answer: "No. Utilization, revenue, rates, mileage, profit, freight availability, and lane consistency are not guaranteed." },
    { question: "Can paperwork be centralized?", answer: "Hermes can support setup packets, insurance certificates, rate confirmations, document organization, invoicing, and follow-up within the agreed workflow." },
    { question: "Is private truck-location data published?", answer: "No. Private operating information should remain inside approved internal workflows and should not be exposed through public pages or URLs." },
    { question: "How does a fleet begin?", answer: "Provide MC, DOT, authority status, insurance, truck and trailer profiles, driver availability structure, home bases, operating regions, and contact information." },
  ],
  related: [
    { label: "Car Hauling Dispatch Services", href: "/logistics/car-hauling-dispatch/" },
    { label: "Owner-Operator Dispatch Support", href: "/logistics/owner-operator-dispatch-support/" },
    { label: "Fleet-Owner Carrier Path", href: "/paths/logistics/carriers/fleet-owners/" },
    { label: "Car Hauler Capacity Checklist", href: "/logistics/resources/car-hauler-capacity-checklist/" },
    { label: "Dealer Vehicle Transportation", href: "/logistics/dealer-vehicle-transportation/" },
    { label: "Contact Hermes", href: "/contacts/" },
  ],
};
