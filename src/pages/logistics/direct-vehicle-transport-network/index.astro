---
import LogisticsCommercialPage from "../../../components/LogisticsCommercialPage.astro";

const content = {
  title: "Direct Vehicle Transport Network | Hermes Logistics",
  description: "See how Hermes connects reviewed vehicle-transport requests from dealers, shippers and customers with suitable car-hauling capacity while developing direct demand beyond load boards.",
  eyebrow: "Hermes Logistics · Direct Demand Development",
  h1: "A Direct Vehicle Transport Network Built Around Real Demand and Carrier Fit",
  intro: "Hermes is building a two-sided vehicle-transport demand system. Dealers, shippers, brokers, businesses, and private customers can reach public transport guidance and prepare a reviewed request. Approved carrier operating profiles help Hermes understand equipment, service areas, timing, capacity, and restrictions. Verified operating patterns may then inform which public route or service topics are worth researching—without publishing private lane data or promising direct loads, rankings, rates, or revenue.",
  image: "/images/path-logistics-system.jpg",
  imageAlt: "Direct vehicle transportation request and car-hauling carrier network",
  primaryAction: {
    label: "Request vehicle transportation",
    href: "/logistics/request-vehicle-transport/#transport-intake",
  },
  handoffNote: "Customer requests are reviewed before carrier matching. Route-specific SEO publication is evidence-gated and never guarantees ranking, traffic, direct loads, capacity, rates, timing, mileage, utilization, or revenue.",
  audience: [
    "Car-hauling owner-operators and small fleets that want a longer-term direct-demand layer alongside ordinary load research",
    "Dealers and auction buyers that need a clear way to prepare vehicle transportation requests",
    "Shippers, brokers, and businesses with one-time, repeat, or recurring vehicle-movement needs",
    "Private customers that need a reviewed path from pickup and delivery details to suitable equipment and carrier capacity",
  ],
  benefits: [
    { title: "Direct customer intake", body: "Dealers, shippers, brokers, businesses, and private customers can prepare a real vehicle-transport request with route, timing, vehicle condition, quantity, and equipment context for Logistics Sales review." },
    { title: "Carrier operating profile", body: "Approved carriers can be reviewed by authority, insurance, equipment, capacity, home area, preferred markets, availability, restrictions, and carrier-controlled approval rules." },
    { title: "Evidence-gated route discovery", body: "Completed or verified operating history can help identify route and service topics worth researching. It does not automatically create a public page, expose a private lane, or establish current demand." },
    { title: "Search as a long-term acquisition layer", body: "Useful public transport pages can help customers discover Hermes through search when the topic has real service fit and enough evidence. Search visibility is an acquisition channel to develop, not a guaranteed source of rankings or loads." },
    { title: "Reviewed equipment and capacity fit", body: "A request is evaluated against vehicle condition, quantity, route, timing, authority, insurance, equipment, operating area, and actual carrier availability before an option is represented as suitable." },
    { title: "Carrier-controlled acceptance", body: "Hermes can prepare and coordinate opportunities, but no public page or customer request automatically books freight. The carrier reviews and approves each load before booking." },
    { title: "Private operations stay private", body: "Carrier identities, customer records, shipment rows, VINs, exact private rates, release data, and internal operating notes are not turned into public SEO content." },
    { title: "Beyond a single load source", body: "The model complements load boards, brokers, dealer relationships, and other approved sources. The goal is to develop an additional direct-customer channel rather than claim that third-party load boards can be eliminated on a fixed timeline." },
  ],
  process: [
    { title: "Build the carrier operating profile", body: "Carrier intake establishes authority status, equipment, capacity, home area, preferred markets, availability, restrictions, communication rules, and carrier approval boundaries." },
    { title: "Review verified operating patterns", body: "Completed or otherwise verified operating history may be analyzed privately for repeated markets, equipment fit, service demand, and useful customer questions. Private shipment records are not published." },
    { title: "Research a public demand opportunity", body: "A route or service topic must earn publication through service fit, useful original content, privacy review, search intent, internal-link fit, and a clear customer next step. Hermes does not mass-publish thin route pages." },
    { title: "Let customers reach a real request path", body: "A dealer, shipper, broker, business, or private customer can discover a public Hermes page or arrive directly, then prepare a reviewed vehicle-transport request with the operating details needed for the next step." },
    { title: "Review carrier and equipment fit", body: "Logistics Sales checks the request against route, timing, condition, equipment needs, authority, insurance, operating area, and current availability before presenting an option." },
    { title: "Confirm separately", body: "No page view, form submission, search impression, or customer inquiry creates a booking. Terms, carrier information, and the applicable arrangement are reviewed separately, and the carrier keeps final load approval." },
  ],
  faq: [
    { question: "Does joining Hermes guarantee direct loads?", answer: "No. Joining Hermes does not guarantee direct loads, customer demand, a route page, ranking, rate, mileage, utilization, or revenue. The direct-demand model is a long-term acquisition and coordination process whose results depend on real customer demand, market conditions, useful public content, carrier fit, and separate review of each request." },
    { question: "Will Hermes automatically publish the routes a carrier runs?", answer: "No. Carrier operating history can identify research candidates, but public route or service content requires a separate evidence, usefulness, privacy, and publication review. Private carrier lanes and shipment records are not automatically published." },
    { question: "How long does SEO take to generate vehicle-transport requests?", answer: "There is no guaranteed timeline. Crawling, indexing, rankings, search demand, competition, click-through, and conversion vary by topic and market. Hermes measures the channel over time instead of promising that a page will rank or create a load within a fixed number of weeks or months." },
    { question: "Is this the Hermes Load Board?", answer: "No. The public Load Board is a fictional product preview used to demonstrate load evaluation and workflow ideas. The direct-demand network described here uses real public service and request paths, followed by human review before any carrier match or transportation arrangement is represented as available." },
    { question: "Can carriers still use load boards and broker relationships?", answer: "Yes. Direct-demand development is an additional acquisition layer. A carrier may still use approved load boards, brokers, dealers, shippers, repeat customers, and other lawful sources according to its operating model and agreements." },
    { question: "What happens when a customer submits a transport request?", answer: "Logistics Sales reviews route, timing, vehicle condition, quantity, release context, equipment needs, and contact information. Carrier authority, insurance, equipment, geography, schedule, and actual availability are then reviewed before an option is represented as suitable. Submission itself is not a booking." },
    { question: "What carrier information can help Hermes understand operating fit?", answer: "Authority status, insurance readiness, equipment type, capacity, home area, preferred markets, availability, operating restrictions, communication rules, and carrier approval requirements can be reviewed through the carrier intake. Sensitive shipment and customer data should remain in approved private channels." },
    { question: "Can a dealer, shipper, or private customer use this system now?", answer: "Yes. The current website provides a direct vehicle-transport request workspace for dealers, shippers, brokers, businesses, and private customers. The request is reviewed by Logistics Sales before any carrier or equipment option is confirmed." },
  ],
  related: [
    { label: "Request Vehicle Transportation", href: "/logistics/request-vehicle-transport/#transport-intake" },
    { label: "Car Hauling Dispatch Services", href: "/logistics/car-hauling-dispatch/" },
    { label: "Start Car Hauling Dispatch Review", href: "/logistics/start-car-hauling-dispatch/" },
    { label: "Dealer Vehicle Transportation", href: "/logistics/dealer-vehicle-transportation/" },
    { label: "Auction Vehicle Pickup", href: "/logistics/auction-vehicle-pickup/" },
    { label: "Car Hauling Load Board Preview", href: "/load-board/" },
    { label: "RPM & Load Profitability Calculator", href: "/logistics/resources/rpm-calculator/" },
    { label: "Factoring vs Direct Payment Calculator", href: "/logistics/resources/factoring-vs-direct-payment-calculator/" },
    { label: "Contact Hermes", href: "/contacts/" },
  ],
};
---

<LogisticsCommercialPage content={content} />
