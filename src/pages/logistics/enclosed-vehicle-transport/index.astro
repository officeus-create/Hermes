---
import LogisticsCommercialPage from "../../../components/LogisticsCommercialPage.astro";

const content = {
  title: "Enclosed Vehicle Transport Services | Hermes Logistics",
  description: "Enclosed vehicle transport request coordination for classic, luxury, specialty, high-value, and sensitive vehicles across the United States.",
  eyebrow: "Hermes Logistics · Enclosed Vehicle Transport",
  h1: "Enclosed Vehicle Transport Services",
  intro: "Hermes reviews enclosed vehicle transport requests for classic, luxury, specialty, high-value, and sensitive vehicles. Route, dimensions, condition, operability, ground clearance, handling needs, timing, and access must be disclosed before equipment fit can be evaluated.",
  image: "/images/path-logistics-system.jpg",
  imageAlt: "Enclosed vehicle transport and protected carrier coordination",
  audience: [
    "Owners of classic, collector, luxury, or specialty vehicles",
    "Dealers moving sensitive or higher-protection inventory",
    "Auction buyers and sellers requesting enclosed equipment",
    "Businesses coordinating authorized protected vehicle moves",
  ],
  benefits: [
    { title: "Vehicle-specific review", body: "Dimensions, weight when unusual, ground clearance, modifications, operability, sensitive surfaces, and handling needs are reviewed before coordination." },
    { title: "Enclosed equipment request", body: "The request is evaluated against route, access, timing, vehicle fit, compliance, and actual enclosed-carrier availability." },
    { title: "Pickup and delivery access", body: "Street width, facility rules, loading space, appointment requirements, and receiving restrictions are considered before confirming equipment fit." },
    { title: "Condition and operability disclosure", body: "Whether the vehicle starts, rolls, steers, and brakes must be stated, along with any unusual damage or loading concerns." },
    { title: "Clear communication", body: "Pickup contacts, delivery contacts, timing, and handling instructions are organized before the next step is confirmed." },
    { title: "No unsupported guarantees", body: "Enclosed equipment, timing, and availability are not guaranteed until the applicable arrangement is accepted and confirmed." },
  ],
  process: [
    { title: "Describe the vehicle", body: "Provide year, make, model, dimensions when unusual, condition, operability, ground clearance, modifications, and special handling needs." },
    { title: "Provide the exact route", body: "Include pickup and delivery locations, access restrictions, contacts, facility hours, and appointment requirements." },
    { title: "Review equipment fit", body: "Enclosed capacity is evaluated against the vehicle, route, access, timing, compliance, and current availability." },
    { title: "Confirm handling expectations", body: "Known loading, protection, communication, and delivery requirements are clarified before confirmation." },
    { title: "Approve the arrangement", body: "No move is represented as booked until the applicable terms and carrier information are accepted and confirmed." },
  ],
  faq: [
    { question: "When should enclosed transport be considered?", answer: "It may be considered for classic, collector, luxury, specialty, high-value, sensitive, or otherwise protected vehicles when route, timing, and equipment availability support the request." },
    { question: "Is enclosed transport always available?", answer: "No. Availability varies by route, timing, vehicle dimensions, access, compliance, and current carrier capacity." },
    { question: "Can a non-running vehicle use enclosed equipment?", answer: "It may be reviewed, but loading capability must be confirmed. State whether the vehicle starts, rolls, steers, and brakes." },
    { question: "Does enclosed transport eliminate all risk?", answer: "No transport method eliminates all risk. Accurate disclosure and equipment matching support a better-informed transportation arrangement." },
    { question: "What access details matter?", answer: "Loading space, street access, facility hours, appointment rules, gates, low-clearance concerns, and receiving restrictions should be disclosed." },
    { question: "How do I begin?", answer: "Submit the exact route, vehicle details, condition, operability, access, timing, and protected-handling request for review." },
  ],
  related: [
    { label: "Luxury and Classic Vehicle Transport", href: "/paths/logistics/customers/luxury-classic-vehicle/" },
    { label: "Open Vehicle Transport", href: "/logistics/open-vehicle-transport/" },
