---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "Wisconsin Enclosed Vehicle Transport | Hermes Logistics";
const description = "Request enclosed vehicle transport in Wisconsin for classic, specialty, high-value, or sensitive vehicles. Hermes reviews route, handling, timing, and equipment fit.";
const canonicalUrl = new URL("/logistics/wisconsin-enclosed-vehicle-transport/", Astro.site).toString();
const faq = [
  { question: "When can enclosed transport be requested?", answer: "Enclosed equipment may be requested for classic, specialty, high-value, sensitive, or otherwise protected vehicle moves. The workable option depends on route, timing, handling needs, and availability." },
  { question: "Is enclosed transport always available?", answer: "No. Equipment availability varies by route, timing, vehicle dimensions, compliance, and current carrier capacity." },
  { question: "What vehicle details should be provided?", answer: "Provide year, make, model, dimensions when unusual, condition, operability, ground clearance concerns, modifications, and any special loading or handling needs." },
  { question: "Does enclosed equipment guarantee damage-free delivery?", answer: "No transport method eliminates all risk. The request review helps match disclosed vehicle and handling requirements to an appropriate equipment option." },
];
const schema = [
  { "@context": "https://schema.org", "@type": "Service", name: "Wisconsin enclosed vehicle transport request coordination", description, url: canonicalUrl, serviceType: "Enclosed vehicle transport request review and carrier coordination", areaServed: [{ "@type": "State", name: "Wisconsin" }, { "@type": "Country", name: "United States" }], provider: { "@type": "Organization", name: "Hermes Logistics", url: "https://hermeslogisticsus.com/paths/logistics/" } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" }, { "@type": "ListItem", position: 2, name: "Wisconsin Vehicle Transport", item: "https://hermeslogisticsus.com/logistics/wisconsin-vehicle-transport/" }, { "@type": "ListItem", position: 3, name: "Wisconsin Enclosed Vehicle Transport", item: canonicalUrl }] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) },
];
---
<BaseLayout title={title} description={description} schema={schema}>
  <SiteHeader theme="dark" activePath="/paths/logistics/" />
  <main id="main-content">
    <section class="section"><div class="shell"><nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/logistics/wisconsin-vehicle-transport/">Wisconsin vehicle transport</a> / <span aria-current="page">Enclosed vehicle transport</span></nav><p class="eyebrow">Hermes Logistics · Enclosed equipment requests</p><h1>Enclosed vehicle transport in Wisconsin.</h1><p>Hermes reviews enclosed equipment requests for classic, specialty, high-value, sensitive, or otherwise protected vehicle moves. The exact route, dimensions, condition, operability, handling needs, and timing must be disclosed.</p><div class="logistics-audience-actions"><a class="button button-primary" href="/load-board/?role=private_party&amp;origin=Wisconsin&amp;equipment=enclosed#post-load">Prepare an enclosed transport request</a><a class="button" href="/paths/logistics/customers/luxury-classic-vehicle/">Classic and specialty vehicle guidance</a></div><p>Enclosed equipment is a request, not a guarantee, until route and availability are confirmed.</p></div></section>
    <section class="section"><div class="shell"><p class="eyebrow">Equipment fit</p><h2>Provide details that affect loading and protection.</h2><ul><li>Vehicle year, make, model, dimensions, and weight when unusual</li><li>Ground clearance, modifications, loose parts, or sensitive surfaces</li><li>Whether the vehicle starts, rolls, steers, and brakes</li><li>Pickup and delivery access for enclosed equipment</li><li>Required timing and any facility appointment rules</li><li>Reliable pickup and delivery contacts</li></ul></div></section>
    <section class="section"><div class="shell"><p class="eyebrow">Related services</p><h2>Choose the correct Wisconsin transport path.</h2><p><a href="/logistics/wisconsin-auction-vehicle-pickup/">Auction vehicle pickup</a> · <a href="/logistics/wisconsin-dealer-vehicle-transport/">Dealer vehicle transport</a> · <a href="/logistics/wisconsin-vehicle-transport/">All Wisconsin vehicle transport</a></p></div></section>
    <section class="section logistics-faq" aria-labelledby="enclosed-faq-title"><div class="shell faq-layout"><div><p class="eyebrow">FAQ</p><h2 id="enclosed-faq-title">Enclosed transport questions.</h2></div><div class="faq-list">{faq.map((item) => (<details><summary>{item.question}</summary><p>{item.answer}</p></details>))}</div></div></section>
  </main><SiteFooter />
</BaseLayout>
