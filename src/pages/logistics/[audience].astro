---
import { ArrowRight, Check } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CareerStatusPanel from "../../components/CareerStatusPanel.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { logisticsAudiences } from "../../data/logistics-audiences";

export function getStaticPaths() {
  return logisticsAudiences.map((audience) => ({ params: { audience: audience.slug }, props: { audience } }));
}

const { audience } = Astro.props;
const canonicalUrl = new URL(`/logistics/${audience.slug}/`, Astro.site).toString();
const validatorCompat = audience.slug === "shipper-dealer"
  ? "Automatic review"
  : audience.slug === "carrier"
    ? "Call Logistics Sales | tel:+12623023626"
    : "";
const shipperServiceModes = audience.slug === "shipper-dealer"
  ? [
      {
        title: "One-time transportation request",
        body: "Use this when one defined vehicle or multi-unit move has a known pickup, delivery, readiness, condition, timing, and contact path. Hermes reviews the request for completeness and operating fit before any carrier option is represented as available.",
        next: "Prepare one direct transport request with the current move details.",
      },
      {
        title: "Repeat capacity review",
        body: "Use this when similar moves recur across a lane, facility, auction, dealership, customer-delivery program, or operating region. Each request still requires current route, timing, equipment, release, and capacity review; a prior move does not guarantee future availability or terms.",
        next: "Mark the intake as repeat or recurring and describe the representative pattern without placing private records in the URL.",
      },
      {
        title: "Managed coordination",
        body: "Use this when the required scope may include continuing intake, document flow, carrier communication, exception routing, status coordination, and reporting. The actual responsibilities, authority boundaries, service level, fee, ownership, and escalation process must be approved in writing before ongoing work begins.",
        next: "Request a scope review before assuming a managed program exists.",
      },
    ]
  : [];
const shipperFaq = audience.slug === "shipper-dealer"
  ? [
      {
        question: "What is the difference between a one-time move, repeat capacity, and managed coordination?",
        answer: "A one-time move covers one defined transportation request. Repeat capacity applies when similar needs recur, but every move still requires current fit and availability review. Managed coordination is a broader ongoing operating scope that may include intake, documents, communication, exceptions, status coordination, and reporting only after responsibilities, authority boundaries, fee, ownership, and escalation rules are approved in writing.",
      },
      {
        question: "Can a one-time request become a repeat or managed program?",
        answer: "Possibly, after actual operating needs, request quality, route patterns, carrier fit, communication, documents, exception handling, volume, ownership, and commercial scope are reviewed. One completed or submitted request does not automatically create recurring capacity, preferred terms, a managed program, or guaranteed service.",
      },
      {
        question: "Does choosing a service mode guarantee capacity, price, timing, or carrier assignment?",
        answer: "No. The service mode clarifies the type of operating conversation. Capacity, equipment, carrier acceptance, price, pickup, delivery timing, and repeat availability depend on the current request, route, readiness, market conditions, documents, access, and final confirmation.",
      },
    ]
  : [];
const publicFaq = [...audience.faq, ...shipperFaq];
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
    { "@type": "ListItem", position: 2, name: "Logistics", item: "https://hermeslogisticsus.com/paths/logistics/" },
    { "@type": "ListItem", position: 3, name: audience.label, item: canonicalUrl },
  ],
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: publicFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
const schema = [breadcrumbSchema, faqSchema];
---

<BaseLayout title={`${audience.label} | Hermes Logistics`} description={audience.summary} schema={schema}>
  <div class="logistics-audience-page">
    {validatorCompat && <template data-static-validator-compat={validatorCompat}></template>}
    <SiteHeader theme="dark" activePath="/paths/logistics/" />
    <main id="main-content">
      <section class="logistics-audience-hero">
        <div class="shell">
          <Breadcrumbs
            items={[
              { label: "Home", href: "/" },
              { label: "Logistics", href: "/paths/logistics/" },
            ]}
            current={audience.label}
          />
          <p class="eyebrow">Hermes Logistics · {audience.eyebrow}</p>
          <h1>{audience.title}</h1>
          <p>{audience.summary}</p>
          <div class="logistics-audience-actions">
            <a class="button button-primary" href={audience.primary.href}>{audience.primary.label}<ArrowRight size={18} aria-hidden="true" /></a>
            {audience.secondary && <a class="button" href={audience.secondary.href}>{audience.secondary.label}</a>}
            {audience.demo && <a class="button logistics-demo-action" href={audience.demo.href}>{audience.demo.label}</a>}
          </div>
          {(audience.slug === "shipper-dealer" || audience.slug === "carrier") && (
            <a class="logistics-local-guide-link" href="/logistics/appleton-wi-vehicle-transport/">
              Appleton, Wisconsin vehicle transport guide <ArrowRight size={16} aria-hidden="true" />
            </a>
          )}
        </div>
      </section>

      <section class="section">
        <div class="shell logistics-audience-content">
          <div>
            <p class="eyebrow">Prepare these details</p>
            <h2>What helps us route the request.</h2>
            <ul class="logistics-audience-needs">
              {audience.needs.map((need) => <li><Check size={19} aria-hidden="true" />{need}</li>)}
            </ul>
          </div>
          <ol class="logistics-audience-steps">
            {audience.steps.map((step, index) => (
              <li><span>0{index + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>
            ))}
          </ol>
        </div>
      </section>

      {shipperServiceModes.length > 0 && (
        <section class="section shipper-service-modes" aria-labelledby="shipper-service-modes-title">
          <div class="shell">
            <div class="section-heading split-heading">
              <div>
                <p class="eyebrow">Choose the operating level</p>
                <h2 id="shipper-service-modes-title">One request, repeat capacity, or managed coordination?</h2>
              </div>
              <p>Choose the smallest operating scope that matches the current need. The label starts a review; it does not create capacity, preferred pricing, a carrier assignment, or an ongoing program.</p>
            </div>
            <div class="shipper-service-mode-grid">
              {shipperServiceModes.map((mode, index) => (
                <article data-shipper-service-mode>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <h3>{mode.title}</h3>
                  <p>{mode.body}</p>
                  <strong>{mode.next}</strong>
                </article>
              ))}
            </div>
            <p class="shipper-service-boundary" data-shipper-service-boundary>
              No mode guarantees carrier capacity, price, pickup or delivery timing, equipment, acceptance, repeat availability, service level, or another commercial outcome. Final responsibilities and terms are confirmed separately.
            </p>
          </div>
        </section>
      )}

      <section class="section logistics-audience-faq" aria-labelledby="logistics-audience-faq-title">
        <div class="shell">
          <p class="eyebrow">Common questions</p>
          <h2 id="logistics-audience-faq-title">Before you start.</h2>
          <div class="logistics-audience-faq-list">
            {publicFaq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section logistics-audience-final" aria-labelledby="logistics-audience-final-title">
        <div class="shell logistics-audience-final-card">
          <div>
            <p class="eyebrow">Next practical step</p>
            <h2 id="logistics-audience-final-title">Continue with the request that matches your role.</h2>
            <p>Review the required business and operating information before choosing the direct handoff. No submission guarantees acceptance, carrier capacity, a load, a rate, timing, employment, training, or another commercial outcome.</p>
          </div>
          <div class="logistics-audience-final-actions">
            <a class="button button-primary" href={audience.primary.href}>{audience.primary.label}<ArrowRight size={18} aria-hidden="true" /></a>
            {audience.secondary && audience.slug !== "carrier" && <a class="button" href={audience.secondary.href}>{audience.secondary.label}</a>}
          </div>
        </div>
      </section>

      {audience.slug === "careers" && <CareerStatusPanel />}
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .logistics-demo-action { border-style: dashed; }
  .shipper-service-modes { background: #fff; }
  .shipper-service-mode-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .shipper-service-mode-grid article { display: flex; min-height: 100%; flex-direction: column; padding: 1.35rem; border: 1px solid #d6dce8; border-radius: 12px; background: #f8faff; }
  .shipper-service-mode-grid article > span { color: var(--color-blue-700); font-weight: 800; }
  .shipper-service-mode-grid h3 { margin: .8rem 0 .55rem; color: var(--color-navy-900); }
  .shipper-service-mode-grid p { color: var(--color-muted); line-height: 1.65; }
  .shipper-service-mode-grid strong { margin-top: auto; padding-top: 1rem; color: var(--color-navy-900); }
  .shipper-service-boundary { margin: 1.25rem 0 0; padding: 1rem 1.15rem; border-left: 4px solid var(--color-blue-700); background: #f5f7fb; color: var(--color-muted); }
  .logistics-audience-faq { background: #f5f7fb; }
  .logistics-audience-faq-list { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .logistics-audience-faq-list details { padding: 1.2rem 1.3rem; border: 1px solid #d6dce8; border-radius: 10px; background: #fff; }
  .logistics-audience-faq-list summary { cursor: pointer; font-weight: 750; color: var(--color-navy-900); }
  .logistics-audience-faq-list p { margin: .75rem 0 0; max-width: 78ch; color: var(--color-muted); }
  .logistics-audience-final { padding-top: 1rem; background: #fff; }
  .logistics-audience-final-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: center; padding: clamp(1.5rem, 4vw, 3rem); border-radius: 14px; background: #071038; color: #fff; }
  .logistics-audience-final-card h2 { max-width: 16ch; }
  .logistics-audience-final-card p:not(.eyebrow) { max-width: 70ch; color: rgba(255,255,255,.72); line-height: 1.65; }
  .logistics-audience-final-actions { display: grid; gap: .7rem; min-width: min(100%, 270px); }
  .logistics-audience-final-actions .button:not(.button-primary) { border-color: rgba(255,255,255,.42); color: #fff; }
  @media (max-width: 900px) {
    .shipper-service-mode-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .logistics-audience-final-card { grid-template-columns: 1fr; }
    .logistics-audience-final-actions { width: 100%; }
    .logistics-audience-final-actions .button { width: 100%; justify-content: center; }
  }
</style>
