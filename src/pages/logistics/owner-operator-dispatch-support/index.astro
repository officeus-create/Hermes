  ],
  benefits: [
    { title: "Load and route review", body: "Potential opportunities are evaluated against equipment, route, timing, pickup and delivery requirements, deadhead awareness, and operating preferences." },
    { title: "Broker communication", body: "Hermes can support broker calls, available-information review, rate discussion, setup coordination, and document follow-through." },
