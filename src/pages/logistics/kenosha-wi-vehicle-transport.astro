---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "Kenosha Vehicle Transport | Hermes Logistics";
const description = "Request vehicle transport to or from Kenosha, Wisconsin for dealer, auction, business, or private moves. Hermes reviews route, timing, condition, and equipment needs.";
const canonicalUrl = new URL("/logistics/kenosha-wi-vehicle-transport/", Astro.site).toString();
const faq = [
  { question: "How is Kenosha vehicle transport priced?", answer: "Pricing depends on route distance, vehicle size and condition, equipment type, pickup and delivery access, timing, season, and current carrier availability." },
  { question: "Can Hermes review dealership inventory moves?", answer: "Yes. Include the complete unit list, vehicle conditions, pickup and delivery requirements, access restrictions, and preferred timing." },
  { question: "Can enclosed transport be requested?", answer: "Yes. State the vehicle type and protection requirements so open and enclosed equipment options can be reviewed." },
  { question: "Is a carrier guaranteed after form submission?", answer: "No. Submission begins a review. Coordination depends on route, equipment, compliance, timing, capacity, and final confirmation." },
];
const schema = [
  { "@context": "https://schema.org", "@type": "Service", name: "Kenosha vehicle transport request coordination", description, url: canonicalUrl, serviceType: "Vehicle transport request review and carrier coordination", areaServed: [{ "@type": "City", name: "Kenosha", containedInPlace: { "@type": "State", name: "Wisconsin" } }, { "@type": "AdministrativeArea", name: "Kenosha County, Wisconsin" }, { "@type": "Country", name: "United States" }], provider: { "@type": "Organization", name: "Hermes Logistics", url: "https://hermeslogisticsus.com/paths/logistics/" } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" }, { "@type": "ListItem", position: 2, name: "Logistics", item: "https://hermeslogisticsus.com/paths/logistics/" }, { "@type": "ListItem", position: 3, name: "Kenosha Vehicle Transport", item: canonicalUrl }] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) },
];
---
<BaseLayout title={title} description={description} schema={schema}>
  <SiteHeader theme="dark" activePath="/paths/logistics/" />
  <main id="main-content">
    <section class="section"><div class="shell">
      <nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/paths/logistics/">Logistics</a> / <span aria-current="page">Kenosha vehicle transport</span></nav>
      <p class="eyebrow">Hermes Logistics · Kenosha, Wisconsin</p>
      <h1>Vehicle transport to and from Kenosha, Wisconsin.</h1>
      <p>Hermes reviews vehicle transport requests for dealers, auction customers, businesses, and private owners. Start with the exact route, vehicle condition, timing, access details, and equipment preference.</p>
      <div class="logistics-audience-actions"><a class="button button-primary" href="/load-board/?role=private_party&amp;origin=Kenosha%2C%20WI#post-load">Prepare a transport request</a><a class="button" href="/load-board/?role=carrier&amp;area=Kenosha%2C%20WI#carrier-access">Carrier: share capacity</a></div>
      <p>Submitting a request does not guarantee price, pickup date, equipment, or carrier availability.</p>
    </div></section>
    <section class="section"><div class="shell"><p class="eyebrow">Request readiness</p><h2>Prepare the route and vehicle details before review.</h2><p>Include pickup and delivery city or ZIP, year, make, model, quantity, operability, earliest pickup date, delivery window, facility hours, release references, and access restrictions.</p><p>For auction pickups, review the <a href="/logistics/resources/auction-vehicle-pickup-checklist/">Auction Vehicle Pickup Checklist</a>. Carriers can use the <a href="/logistics/resources/car-hauler-capacity-checklist/">Car Hauler Capacity Checklist</a>.</p></div></section>
    <section class="section logistics-faq" aria-labelledby="kenosha-faq-title"><div class="shell faq-layout"><div><p class="eyebrow">FAQ</p><h2 id="kenosha-faq-title">Before you submit.</h2></div><div class="faq-list">{faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
