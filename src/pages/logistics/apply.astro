---
import { ArrowRight } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { hrIntakeRolePolicy } from "../../data/hr-intake-policy";

const canonicalUrl = "https://hermeslogisticsus.com/logistics/apply/";
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
    { "@type": "ListItem", position: 2, name: "Logistics", item: "https://hermeslogisticsus.com/paths/logistics/" },
    { "@type": "ListItem", position: 3, name: "Application", item: canonicalUrl },
  ],
};
const publicIntakePolicy = Object.fromEntries(
  Object.entries(hrIntakeRolePolicy).filter(([, policy]) => policy.classification !== "internal_hr_pilot"),
);
import "../../styles/features/load.css";
---

<BaseLayout title="Logistics Application | Hermes" description="Apply for a Hermes logistics career or prepare a remote-agency inquiry." schema={schema}>
  <div class="logistics-application-page">
    <SiteHeader theme="dark" activePath="/paths/logistics/" />
    <main id="main-content">
      <section class="logistics-audience-hero logistics-application-hero">
        <div class="shell">
          <Breadcrumbs
            items={[
              { label: "Home", href: "/" },
              { label: "Logistics", href: "/paths/logistics/" },
            ]}
            current="Application"
          />
          <p class="eyebrow">Hermes Logistics · Candidate intake</p>
          <h1>Prepare a reviewable logistics application.</h1>
          <p>Accepted career submissions are sent to and stored in the private Hermes HR review queue only after the server returns a receipt. A receipt confirms storage, not that a reviewer has read the submission or will respond within a particular time. Remote-agency interest remains a local preview and is not sent.</p>
          <p>No public vacancy is currently verified open. A role-specific submission is accepted only when its approved role ID is active; a general professional inquiry is classified separately and is not an application to a paused role.</p>
          <p data-application-context hidden></p>
        </div>
      </section>
      <template data-hr-intake-policy={JSON.stringify(publicIntakePolicy)}></template>
      <section class="section">
        <div class="shell logistics-application-grid">
          <form class="load-board-form" data-logistics-application novalidate>
            <label>Application type *
              <select name="application_type" required>
                <option value="">Choose one</option>
                <option value="career">Work with Hermes</option>
                <option value="agency">Open a remote agency</option>
              </select>
            </label>
            <div class="field-row">
              <label>Full name *<input name="name" maxlength="100" autocomplete="name" required /></label>
              <label>Email *<input name="email" type="email" maxlength="160" autocomplete="email" required /></label>
            </div>
            <div class="field-row">
              <label>Country and city *<input name="location" maxlength="160" autocomplete="address-level2" required /></label>
              <label>Languages *<input name="languages" maxlength="160" required /></label>
            </div>
            <label>Role or agency interest *<input name="interest" maxlength="180" required /></label>
            <label>Relevant experience and measurable results *<textarea name="experience" rows="5" minlength="20" maxlength="1800" required></textarea></label>
            <label>Availability and preferred working hours *<textarea name="availability" rows="3" minlength="15" maxlength="800" required></textarea></label>
            <label class="consent-field"><input type="checkbox" name="consent" required /><span>I agree that Hermes may use these details to review this application. Career submissions are stored privately for authorized HR review; agency inquiries are not sent from this pilot yet. <a href="/privacy/">Privacy notice</a>.</span></label>
            <button class="button button-primary" type="submit" data-application-submit><span data-application-submit-label>Continue application</span> <ArrowRight size={18} aria-hidden="true" /></button>
          </form>
          <aside class="load-board-result" data-application-result hidden aria-live="polite">
            <p class="eyebrow" data-application-result-eyebrow>Application</p>
            <h2 data-application-result-title>Ready to review</h2>
            <p data-application-result-copy></p>
            <pre data-application-preview tabindex="0"></pre>
            <button class="button" type="button" data-copy-application>Copy receipt</button>
            <p role="status" data-application-copy-status></p>
          </aside>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script>
  const HR_API = "/api/hr/candidate";
  const PENDING_KEY = "hermes-logistics-career-intake-v1";
  const SAFE_ATTRIBUTION_KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "creative", "market", "placement"];

  const form = document.querySelector<HTMLFormElement>("[data-logistics-application]");
  const result = document.querySelector<HTMLElement>("[data-application-result]");
  const resultEyebrow = document.querySelector<HTMLElement>("[data-application-result-eyebrow]");
  const resultTitle = document.querySelector<HTMLElement>("[data-application-result-title]");
  const resultCopy = document.querySelector<HTMLElement>("[data-application-result-copy]");
  const preview = document.querySelector<HTMLElement>("[data-application-preview]");
  const copy = document.querySelector<HTMLButtonElement>("[data-copy-application]");
  const copyStatus = document.querySelector<HTMLElement>("[data-application-copy-status]");
  const submit = document.querySelector<HTMLButtonElement>("[data-application-submit]");
  const submitLabel = document.querySelector<HTMLElement>("[data-application-submit-label]");
  const type = form?.querySelector<HTMLSelectElement>('select[name="application_type"]');
  const interest = form?.querySelector<HTMLInputElement>('input[name="interest"]');
  const context = document.querySelector<HTMLElement>("[data-application-context]");
  let activePreview = "";
  let memoryPending: Record<string, unknown> | null = null;

  const sanitize = (value: FormDataEntryValue | string | null, max = 1800) => String(value ?? "").replace(/[<>\u0000-\u001f\u007f]/g, "").trim().slice(0, max);
  const params = new URLSearchParams(window.location.search);
  const requestedType = params.get("for");
  type RolePolicy = {
    label: string;
    track: "logistics" | "sales" | "marketing";
    classification: "general_interest" | "approved_role";
    acceptsApplications: boolean;
    publicVacancy: boolean;
  };
  const policyNode = document.querySelector<HTMLTemplateElement>("[data-hr-intake-policy]");
  const rolePolicy = JSON.parse(policyNode?.dataset.hrIntakePolicy ?? "{}") as Record<string, RolePolicy>;
  const allowedSources = new Set(["hermes_careers", "workua", "staffam", "linkedin", "indeed", "google", "referral"]);
  const requestedRole = params.get("role") ?? "";
  const requestedRolePolicy = requestedRole ? rolePolicy[requestedRole] ?? null : null;
  const defaultRoleId = "general-logistics-interest";
  const source = allowedSources.has(params.get("source") ?? "") ? params.get("source")! : "direct";
  const uiLanguage = document.documentElement.lang.toLowerCase().startsWith("ru")
    ? "ru"
    : document.documentElement.lang.toLowerCase().startsWith("uk") ? "uk" : "en";

  const randomPart = () => crypto.randomUUID().replaceAll("-", "");
  const newCandidateId = () => `hr_${randomPart()}`;
  const newCandidateToken = () => `hrtok_${randomPart()}_${randomPart()}`;
  const newEvidenceId = () => `evidence_${randomPart()}`;
  const newEventId = () => `evt_${randomPart()}`;

  const readPending = () => {
    try { return JSON.parse(sessionStorage.getItem(PENDING_KEY) || "null") as Record<string, unknown> | null; }
    catch { return memoryPending; }
  };
  const writePending = (value: Record<string, unknown>) => {
    memoryPending = value;
    try { sessionStorage.setItem(PENDING_KEY, JSON.stringify(value)); } catch { /* in-memory retry remains available */ }
  };
  const getOrCreatePending = (email: string, roleId: string) => {
    const existing = readPending();
    const evidenceIds = existing?.evidence_ids as Record<string, unknown> | undefined;
    if (
      existing?.email === email && existing?.role_id === roleId &&
      /^hr_[a-zA-Z0-9][a-zA-Z0-9_-]{20,100}$/.test(String(existing.candidate_id || "")) &&
      String(existing.token || "").length >= 48 &&
      evidenceIds?.languages && evidenceIds?.experience && evidenceIds?.availability && existing?.event_id && existing?.submitted_at
    ) return existing;

    const created = {
      email,
      role_id: roleId,
      candidate_id: newCandidateId(),
      token: newCandidateToken(),
      evidence_ids: {
        languages: newEvidenceId(),
        experience: newEvidenceId(),
        availability: newEvidenceId(),
      },
      event_id: newEventId(),
      submitted_at: new Date().toISOString(),
    };
    writePending(created);
    return created;
  };

  const buildAttribution = () => {
    const attribution: Record<string, string> = { landing_path: window.location.pathname };
    for (const key of SAFE_ATTRIBUTION_KEYS) {
      const value = sanitize(params.get(key), 240);
      if (value) attribution[key] = value;
    }
    return attribution;
  };

  const responseJson = async (response: Response) => {
    try { return await response.json() as Record<string, unknown>; }
    catch { return {}; }
  };

  const setResult = (eyebrow: string, title: string, copyText: string, receipt: string) => {
    if (resultEyebrow) resultEyebrow.textContent = eyebrow;
    if (resultTitle) resultTitle.textContent = title;
    if (resultCopy) resultCopy.textContent = copyText;
    activePreview = receipt;
    if (preview) preview.textContent = receipt;
    if (result) result.hidden = false;
  };

  const updateSubmitLabel = () => {
    if (!submitLabel) return;
    submitLabel.textContent = type?.value === "career" ? "Submit for HR review" : type?.value === "agency" ? "Preview agency inquiry" : "Continue application";
  };

  if (type && ["career", "agency"].includes(requestedType ?? "")) type.value = requestedType ?? "";
  if (interest && requestedRolePolicy) interest.value = requestedRolePolicy.label;
  if (context && requestedRolePolicy) {
    context.hidden = false;
    context.textContent = requestedRolePolicy.acceptsApplications
      ? `Application context: ${requestedRolePolicy.label} · source ${source}. No personal information is stored in this URL.`
      : `${requestedRolePolicy.label} is paused and is not accepting applications. This page will not send a role-specific submission.`;
  }
  updateSubmitLabel();
  type?.addEventListener("change", updateSubmitLabel);

  form?.addEventListener("input", () => {
    if (result) result.hidden = true;
    activePreview = "";
    if (copyStatus) copyStatus.textContent = "";
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) return form.reportValidity();
    const data = new FormData(form);
    const applicationType = sanitize(data.get("application_type"), 40);

    if (applicationType !== "career") {
      const agencyPreview = [
        "Hermes Logistics Agency Inquiry (Preview)",
        `Application type: ${applicationType}`,
        `Role/source: ${sanitize(data.get("interest"), 180)} / ${source}`,
        `Name: ${sanitize(data.get("name"), 100)}`,
        `Email: ${sanitize(data.get("email"), 160)}`,
        `Location: ${sanitize(data.get("location"), 160)}`,
        `Languages: ${sanitize(data.get("languages"), 160)}`,
        `Experience/results: ${sanitize(data.get("experience"))}`,
        `Availability: ${sanitize(data.get("availability"), 800)}`,
        "Delivery: preview only — no application was sent or stored.",
      ].join("\n");
      setResult("Agency inquiry preview", "Ready to copy", "This agency inquiry remains local to your browser and has not been submitted.", agencyPreview);
      return;
    }

    if (requestedRole && (!requestedRolePolicy || !requestedRolePolicy.acceptsApplications)) {
      setResult(
        "Hermes HR",
        "Role-specific application not accepted",
        "This role is paused or is not on the approved role-ID allowlist. No candidate data was sent to the HR endpoint.",
        `Hermes HR submission: not sent\nRole ID: ${requestedRole}\nReason: role_not_accepting_applications`,
      );
      return;
    }

    const roleId = requestedRole || defaultRoleId;
    const activeRolePolicy = rolePolicy[roleId];
    if (!activeRolePolicy?.acceptsApplications) {
      setResult("Hermes HR", "Application not accepted", "No approved HR intake classification is available.", "Hermes HR submission: not sent");
      return;
    }

    const name = sanitize(data.get("name"), 100);
    const email = sanitize(data.get("email"), 160).toLowerCase();
    const location = sanitize(data.get("location"), 160);
    const languages = sanitize(data.get("languages"), 160);
    const experience = sanitize(data.get("experience"), 1800);
    const availability = sanitize(data.get("availability"), 800);
    const pending = getOrCreatePending(email, roleId);
    const candidateId = String(pending.candidate_id || "");
    const token = String(pending.token || "");
    const submittedAt = String(pending.submitted_at || new Date().toISOString());
    const evidenceIds = pending.evidence_ids as Record<string, string>;
    const eventId = String(pending.event_id || "");

    if (submit) submit.disabled = true;
    if (submitLabel) submitLabel.textContent = "Submitting…";
    try {
      const startResponse = await fetch(HR_API, {
        method: "POST",
        credentials: "same-origin",
        headers: {
          "Content-Type": "application/json",
          "Idempotency-Key": candidateId,
          "X-HR-Candidate-Token": token,
        },
        body: JSON.stringify({
          candidate_id: candidateId,
          name,
          email,
          country: location,
          language: uiLanguage,
          source,
          track: activeRolePolicy.track,
          role_id: roleId,
          intake_classification: activeRolePolicy.classification,
          attribution: buildAttribution(),
          consent: data.get("consent") === "on",
          submitted_at: submittedAt,
        }),
      });
      const startPayload = await responseJson(startResponse);
      if (!startResponse.ok || startPayload.success !== true) {
        const reason = String(startPayload.error || `http_${startResponse.status}`);
        setResult(
          "Hermes HR",
          "Application not submitted",
          "The private HR intake did not accept this application. Nothing is marked complete; you can retry from this browser.",
          `Hermes HR submission: not completed\nReason: ${reason}`,
        );
        return;
      }

      const evidenceResponse = await fetch(HR_API, {
        method: "PUT",
        credentials: "same-origin",
        headers: {
          "Content-Type": "application/json",
          "X-HR-Candidate-Token": token,
        },
        body: JSON.stringify({
          candidate_id: candidateId,
          answers: [
            { evidence_id: evidenceIds.languages, question_id: "application_languages", phase: "APPLICATION_INTAKE", answer: `Reported languages: ${languages}`, answered_at: submittedAt },
            { evidence_id: evidenceIds.experience, question_id: "application_experience", phase: "APPLICATION_INTAKE", answer: experience, answered_at: submittedAt },
            { evidence_id: evidenceIds.availability, question_id: "application_availability", phase: "APPLICATION_INTAKE", answer: availability, answered_at: submittedAt },
          ],
          events: [
            {
              event_id: eventId,
              type: "public_logistics_application_submitted",
              occurred_at: submittedAt,
              payload: {
                application_type: "career",
                role_id: roleId,
                intake_classification: activeRolePolicy.classification,
                source,
                landing_path: window.location.pathname,
              },
            },
          ],
          completed_at: submittedAt,
        }),
      });
      const evidencePayload = await responseJson(evidenceResponse);
      if (!evidenceResponse.ok || evidencePayload.success !== true) {
        setResult(
          "Hermes HR",
          "Application evidence needs retry",
          "Your candidate record was created, but the intake evidence did not finish syncing. Submit again from this browser to retry the same candidate record instead of creating a duplicate.",
          `Hermes HR candidate receipt\nCandidate ID: ${candidateId}\nStatus: intake evidence sync incomplete\nHuman review: not ready yet`,
        );
        return;
      }

      writePending({ ...pending, completed: true });
      setResult(
        "Hermes HR",
        "Application stored in the private HR queue",
        "This receipt confirms private storage of the application and intake evidence. It does not confirm reviewer assignment, human readback, or response time. Any next step requires an authorized human decision.",
        [
          "Hermes HR application receipt",
          `Candidate ID: ${candidateId}`,
          "Track: Logistics",
          `Role ID: ${roleId}`,
          `Classification: ${activeRolePolicy.classification}`,
          `Source: ${source}`,
          "Status: stored · reviewer ownership and response time not confirmed",
        ].join("\n"),
      );
    } catch {
      setResult(
        "Hermes HR",
        "Application not confirmed",
        "The HR endpoint could not be reached. This page does not claim a submission without a server receipt; retry from this browser when the connection is available.",
        "Hermes HR submission: not confirmed\nNo completed application receipt was returned.",
      );
    } finally {
      if (submit) submit.disabled = false;
      updateSubmitLabel();
    }
  });

  copy?.addEventListener("click", async () => {
    if (!activePreview || !copyStatus) return;
    try { await navigator.clipboard.writeText(activePreview); copyStatus.textContent = "Receipt copied."; }
    catch { copyStatus.textContent = "Copy did not work. Select the receipt text and copy it manually."; }
  });
</script>
