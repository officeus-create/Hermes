---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "Milwaukee Vehicle Transport | Hermes Logistics";
const description = "Request vehicle transport to or from Milwaukee, Wisconsin for dealer, auction, business, or private moves. Hermes reviews route, timing, vehicle condition, and equipment needs.";
const canonicalUrl = new URL("/logistics/milwaukee-wi-vehicle-transport/", Astro.site).toString();

const faq = [
  {
    question: "How much does vehicle transport to or from Milwaukee cost?",
    answer: "Pricing depends on route distance, vehicle size and condition, equipment type, access, timing, season, and current carrier availability. Submit complete details for review rather than relying on a generic city estimate.",
  },
  {
    question: "Can Hermes review dealer or auction vehicle transport in Milwaukee?",
    answer: "Yes. Dealers, auction buyers and sellers, businesses, and private customers can submit a transport request with route, release, vehicle condition, access, and timing details.",
  },
  {
    question: "Can an inoperable vehicle be reviewed?",
    answer: "Yes. State clearly whether the vehicle starts, rolls, steers, and brakes so the equipment and handling requirements can be evaluated before coordination begins.",
  },
  {
    question: "Does submitting a request guarantee a carrier or pickup date?",
    answer: "No. Hermes first reviews the request. Any carrier coordination depends on route, equipment, compliance, timing, capacity, and final confirmation.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Milwaukee vehicle transport request coordination",
    description,
    url: canonicalUrl,
    serviceType: "Vehicle transport request review and carrier coordination",
    areaServed: [
      { "@type": "City", name: "Milwaukee", containedInPlace: { "@type": "State", name: "Wisconsin" } },
      { "@type": "AdministrativeArea", name: "Southeastern Wisconsin" },
      { "@type": "Country", name: "United States" },
    ],
    provider: {
      "@type": "Organization",
      name: "Hermes Logistics",
      url: "https://hermeslogisticsus.com/paths/logistics/",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://hermeslogisticsus.com/" },
      { "@type": "ListItem", position: 2, name: "Logistics", item: "https://hermeslogisticsus.com/paths/logistics/" },
      { "@type": "ListItem", position: 3, name: "Milwaukee Vehicle Transport", item: canonicalUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <SiteHeader theme="dark" activePath="/paths/logistics/" />
  <main id="main-content">
    <section class="section">
      <div class="shell">
        <nav aria-label="Breadcrumb">
          <a href="/">Home</a> / <a href="/paths/logistics/">Logistics</a> / <span aria-current="page">Milwaukee vehicle transport</span>
        </nav>
        <p class="eyebrow">Hermes Logistics · Milwaukee, Wisconsin</p>
        <h1>Vehicle transport to and from Milwaukee, Wisconsin.</h1>
        <p>
          Hermes reviews vehicle transport requests for auto dealers, auction buyers and sellers, businesses, and private customers. Start with the exact pickup and delivery route, vehicle condition, timing, access requirements, and preferred equipment.
        </p>
        <div class="logistics-audience-actions">
          <a class="button button-primary" href="/load-board/?role=private_party&amp;origin=Milwaukee%2C%20WI#post-load">Prepare a transport request</a>
          <a class="button" href="/load-board/?role=carrier&amp;area=Milwaukee%2C%20WI#carrier-access">Carrier: share capacity</a>
        </div>
        <p>Submitting a request does not guarantee price, timing, equipment, or carrier availability.</p>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <p class="eyebrow">Who this page serves</p>
        <h2>Dealer, auction, business, and private vehicle moves.</h2>
        <div class="appleton-card-grid">
          <article>
            <h3>Auto dealers</h3>
            <p>Purchased, sold, traded, or transferred vehicles, including multi-unit inventory moves.</p>
          </article>
          <article>
            <h3>Auction buyers and sellers</h3>
            <p>Pickup planning with release status, facility rules, vehicle condition, and storage deadlines.</p>
          </article>
          <article>
            <h3>Private customers</h3>
            <p>Relocation, purchase, sale, or another planned vehicle move to or from Milwaukee.</p>
          </article>
          <article>
            <h3>Carriers and car haulers</h3>
            <p>Share equipment, authority, operating area, capacity, and schedule for review.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <p class="eyebrow">Prepare the request</p>
        <h2>Complete information supports a faster review.</h2>
        <ul>
          <li>Pickup and delivery city, state, or ZIP code</li>
          <li>Vehicle year, make, model, quantity, and condition</li>
          <li>Whether each vehicle starts, rolls, steers, and brakes</li>
          <li>Earliest pickup date and required delivery window</li>
          <li>Open or enclosed transport preference</li>
          <li>Facility hours, release references, and access restrictions</li>
        </ul>
        <p>
          For auction moves, use the <a href="/logistics/resources/auction-vehicle-pickup-checklist/">Auction Vehicle Pickup Checklist</a>. Carriers can review the <a href="/logistics/resources/car-hauler-capacity-checklist/">Car Hauler Capacity Checklist</a> before sharing availability.
        </p>
      </div>
    </section>

    <section class="section logistics-faq" aria-labelledby="milwaukee-faq-title">
      <div class="shell faq-layout">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2 id="milwaukee-faq-title">Before you submit.</h2>
        </div>
        <div class="faq-list">
          {faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
