---
import "../styles/global.css";
import MotionLayer from "../components/MotionLayer.astro";
import SiteIntro from "../components/SiteIntro.astro";
import { localeConfig, type SiteLocale } from "../data/locales";

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  locale?: SiteLocale;
  alternates?: { lang: string; href: string }[];
}

const { title, description, image = "/images/hermes-social-share-2026.jpg", schema, locale = "en", alternates = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const ogLocale = localeConfig[locale].ogLocale;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1152" />
    <meta property="og:image:alt" content="Hermes ecosystem with four illuminated business portals" />
    <meta property="og:site_name" content="Hermes" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Hermes ecosystem with four illuminated business portals" />
    <meta name="theme-color" content="#0a164f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const canAnimate = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const firstHomeView = window.location.pathname === "/" && !window.location.hash && !window.sessionStorage.getItem("hermes-intro-seen");
        if (canAnimate && firstHomeView) document.documentElement.classList.add("intro-pending");
      } catch {
        // Continue directly to the page when browser storage is unavailable.
      }
    </script>
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <title>{title}</title>
  </head>
  <body>
    <!--email_off-->
    <SiteIntro />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <MotionLayer />
    <!--/email_off-->
  </body>
</html>
