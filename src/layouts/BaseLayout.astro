---
import "../styles/global.css";
import CarrierQualificationEnhancer from "../components/CarrierQualificationEnhancer.astro";
import ContactLinkEnhancer from "../components/ContactLinkEnhancer.astro";
import MotionLayer from "../components/MotionLayer.astro";
import SeoIntakeEnhancer from "../components/SeoIntakeEnhancer.astro";
import SiteIntro from "../components/SiteIntro.astro";
import { localeConfig, type SiteLocale } from "../data/locales";

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  locale?: SiteLocale;
  alternates?: { lang: string; href: string }[];
  robots?: string;
  preloadImage?: string;
}

const {
  title,
  description,
  image = "/images/hermes-social-share-2026.jpg",
  schema,
  locale = "en",
  alternates = [],
  robots = "index,follow,max-image-preview:large",
  preloadImage,
} = Astro.props;

const conciseDescription = (value: string, maxLength = 170) => {
  const normalized = value.replace(/\s+/g, " ").trim();
  if (normalized.length <= maxLength) return normalized;

  const sentenceWindow = normalized.slice(0, maxLength + 1);
  const sentenceEnd = Math.max(
    sentenceWindow.lastIndexOf(". "),
    sentenceWindow.lastIndexOf("! "),
    sentenceWindow.lastIndexOf("? "),
  );
  if (sentenceEnd >= 100) return sentenceWindow.slice(0, sentenceEnd + 1).trim();

  const wordWindow = normalized.slice(0, maxLength - 1);
  const wordEnd = wordWindow.lastIndexOf(" ");
  const trimmed = wordWindow.slice(0, wordEnd > 100 ? wordEnd : wordWindow.length).replace(/[,:;\-–—\s]+$/g, "").trim();
  return `${trimmed}…`;
};

const metaDescription = conciseDescription(description);
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const ogLocale = localeConfig[locale].ogLocale;
const alternateOgLocales = alternates
.filter((alternate) => alternate.lang !== locale && alternate.lang !== "x-default")
.map((alternate) => localeConfig[alternate.lang as SiteLocale]?.ogLocale)
.filter((value, index, all): value is string => Boolean(value) && all.indexOf(value) === index);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />)}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
<link rel="preconnect" href="https://www.googletagmanager.com" />
<link rel="preconnect" href="https://www.google-analytics.com" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:url" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1152" />
    <meta property="og:image:alt" content="Hermes ecosystem with four illuminated business portals" />
    <meta property="og:site_name" content="Hermes" />
    <meta property="og:locale" content={ogLocale} />
{alternateOgLocales.map((altLocale) => <meta property="og:locale:alternate" content={altLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Hermes ecosystem with four illuminated business portals" />
    <meta name="theme-color" content="#0a164f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Google Analytics 4: deployed site-wide -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RY26321PVW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RY26321PVW');
    </script>
    <script is:inline>
      try {
        const canAnimate = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const firstHomeView = window.location.pathname === "/" && !window.location.hash && !window.sessionStorage.getItem("hermes-intro-seen");
        if (canAnimate && firstHomeView) document.documentElement.classList.add("intro-pending");
      } catch {
        // Continue directly to the page when browser storage is unavailable.
      }
    </script>
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <title>{title}</title>
  </head>
  <body>
    <!--email_off-->
    <SiteIntro />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <ContactLinkEnhancer />
    <SeoIntakeEnhancer />
    <CarrierQualificationEnhancer />
    <MotionLayer />
    <!--/email_off-->
  </body>
</html>