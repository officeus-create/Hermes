---
import "../styles/global.css";
import "../styles/hermes-brand-system.css";
import "../styles/hermes-connect-workspace.css";
import "../styles/shared-resource.css";
import "../styles/repair-company-schedule-polish.css";
import "../styles/hermes-public-pearl-shell.css";
import socialCardImage from "../assets/hermes-social-card.jpg";
import CarrierContractJourney from "../components/CarrierContractJourney.astro";
import CarrierContractSafetyEnhancer from "../components/CarrierContractSafetyEnhancer.astro";
import CarrierQualificationEnhancer from "../components/CarrierQualificationEnhancer.astro";
import ContactLinkEnhancer from "../components/ContactLinkEnhancer.astro";
import LoadBoardCapacityEnhancer from "../components/LoadBoardCapacityEnhancer.astro";
import MoneyPageActionBar from "../components/MoneyPageActionBar.astro";
import MotionLayer from "../components/MotionLayer.astro";
import ProductionContactMode from "../components/ProductionContactMode.astro";
import RepairBookingGrowthEnhancer from "../components/RepairBookingGrowthEnhancer.astro";
import RepairPartnerOfferEnhancer from "../components/RepairPartnerOfferEnhancer.astro";
import RepairShopActivationEnhancer from "../components/RepairShopActivationEnhancer.astro";
import RepairShopFreeLaunchOffer from "../components/RepairShopFreeLaunchOffer.astro";
import RouteEstimateEnhancer from "../components/RouteEstimateEnhancer.astro";
import Seo4ConversionEnhancer from "../components/Seo4ConversionEnhancer.astro";
import SeoIntakeEnhancer from "../components/SeoIntakeEnhancer.astro";
import SeoSupportingIntakeEnhancer from "../components/SeoSupportingIntakeEnhancer.astro";
import TrackingConsent from "../components/TrackingConsent.astro";
import SiteTrafficCollector from "../components/SiteTrafficCollector.astro";
import VehicleTransportCtaEnhancer from "../components/VehicleTransportCtaEnhancer.astro";
import WebsiteProjectScopeEnhancer from "../components/WebsiteProjectScopeEnhancer.astro";
import { localeConfig, type SiteLocale } from "../data/locales";
import { HERMES_CONNECT_SOCIAL_CARD } from "../lib/hermes-connect-social-card";
import HermesConnectCommandPalette from "../components/HermesConnectCommandPalette.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  locale?: SiteLocale;
  alternates?: { lang: string; href: string }[];
  robots?: string;
  preloadImage?: string;
  htmlLang?: string;
  ogLocaleOverride?: string;
  ogType?: "website" | "article";
  feedUrl?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  schema,
  locale = "en",
  alternates = [],
  robots = "index,follow,max-image-preview:large",
  preloadImage,
  htmlLang = locale,
  ogLocaleOverride,
  ogType = "website",
  feedUrl,
  articlePublishedTime,
  articleModifiedTime,
} = Astro.props;

const isRepairShopLaunchRoute = Astro.url.pathname.startsWith("/services/hermes-connect/repair-shops");
const isRepairShopBookingRoute = Astro.url.pathname.replace(/\/+$/, "") === "/services/hermes-connect/repair-shops/booking";
const isHermesConnectProductHub = Astro.url.pathname === "/services/hermes-connect/";
// Public page family for direction-tinted accents (eyebrows, numbers, active states). Product
// surfaces keep their own accents and are not tagged: Load Board, Hermes Connect, Insights and the
// Catalog. The approved /paths/<direction>/ owners of Technology, Academy and Marketing keep their
// reviewed styling; their inner pages follow the family.
const familyPath = Astro.url.pathname;
type DirectionFamily = "logistics" | "technology" | "academy" | "marketing";
let directionFamilyValue: DirectionFamily | undefined;
const directionFamilyPatterns: Array<[DirectionFamily, RegExp]> = [
  ["logistics", /^\/(?:paths\/)?logistics\/|^\/carrier(?:-[a-z-]+)?\/|^\/(?:ru|ua|es|it|fr)\/(?:logistics|logistica|logistique)\//],
  ["academy", /^\/academy\/|^\/(?:ru|ua|es|it|fr)\/(?:academy|academia|academie)\/|^\/(?:(?:ru|ua)\/)?gb\/london\/(?:academy|us-logistics-training|guides\/(?:b2-english-us-logistics|dispatcher-vs-load-planner|training-curriculum|us-logistics-roles))\//],
  ["technology", /^\/services\/(?:website-|auto-repair-website-design\/)|^\/case\/it-development\/|^\/resources\/website-project-brief-template\/|^\/(?:ru|ua|es|it|fr)\/(?:technology|tecnologia|technologie)\/|^\/(?:(?:ru|ua)\/)?gb\/london\/(?:it-web-development|website-development|landing-page-development|crm-automation|guides\/small-business-website-guide)\//],
  ["marketing", /^\/services\/(?:seo|local-seo)|^\/(?:(?:ru|ua)\/)?business-growth\/|^\/(?:ru|ua|es|it|fr)\/marketing\/|^\/resources\/(?:technical-seo-checklist|search-to-inquiry-conversion-checklist|logistics-seo-audit-sample)\/|^\/case\/appleton-vehicle-transport-seo\/|^\/(?:(?:ru|ua)\/)?gb\/london\/(?:marketing|seo-services|local-seo|marketing-audit|guides|meta-ads|social-media-management|google-business-profile|content-reels-scripts|[a-z-]+-marketing)\//],
];
for (const [family, pattern] of directionFamilyPatterns) {
  if (pattern.test(familyPath)) { directionFamilyValue = family; break; }
}
const directionFamily = directionFamilyValue;
const isHermesConnectExperienceRoute = Astro.url.pathname.startsWith("/services/hermes-connect") || Astro.url.pathname.startsWith("/load-board");
const CLARITY_BLOCKED_PATH_PREFIXES = [
  "/services/hermes-connect",
  "/logistics/carrier-onboarding",
  "/logistics/apply",
  "/sign",
  "/privacy-choices",
];
const clarityEligible = !robots.toLowerCase().includes("noindex")
  && !CLARITY_BLOCKED_PATH_PREFIXES.some((prefix) => Astro.url.pathname.startsWith(prefix));
const useHermesConnectSocialCard = isHermesConnectProductHub && !image;
const defaultSocialImage = useHermesConnectSocialCard
  ? {
      path: HERMES_CONNECT_SOCIAL_CARD.path,
      type: "image/png",
      alt: HERMES_CONNECT_SOCIAL_CARD.alt,
      width: HERMES_CONNECT_SOCIAL_CARD.width,
      height: HERMES_CONNECT_SOCIAL_CARD.height,
    }
  : {
      path: socialCardImage.src,
      type: "image/jpeg",
      alt: "Hermes — U.S. Logistics, Marketing, Academy & AI Systems",
      width: socialCardImage.width,
      height: socialCardImage.height,
    };
const socialImagePath = image ?? defaultSocialImage.path;
const socialImageType = image
  ? socialImagePath.toLowerCase().split(/[?#]/)[0].endsWith(".png")
    ? "image/png"
    : socialImagePath.toLowerCase().split(/[?#]/)[0].endsWith(".webp")
      ? "image/webp"
      : "image/jpeg"
  : defaultSocialImage.type;
const socialImageAlt = imageAlt ?? defaultSocialImage.alt;
const socialImageWidth = imageWidth ?? defaultSocialImage.width;
const socialImageHeight = imageHeight ?? defaultSocialImage.height;

const PUBLIC_TEXT_REPLACEMENTS = new Map([
  ["freight_301@hermeslogisticsus.com", "officeus@hermeslogisticsus.com"],
  ["USA · Europe · International email coordination", "U.S. logistics · International email coordination"],
  ["Contact submission pending connection", "Website inquiry delivery is active through the approved email workflow"],
]);

const replaceRetiredPublicText = (value: unknown): unknown => {
  if (typeof value === "string") {
    let next = value;
    for (const [retired, current] of PUBLIC_TEXT_REPLACEMENTS) next = next.replaceAll(retired, current);
    return next;
  }
  if (Array.isArray(value)) return value.map(replaceRetiredPublicText);
  if (value && typeof value === "object") {
    return Object.fromEntries(
      Object.entries(value as Record<string, unknown>).map(([key, item]) => [key, replaceRetiredPublicText(item)]),
    );
  }
  return value;
};

const conciseDescription = (value: string, maxLength = 170) => {
  const normalized = value.replace(/\s+/g, " ").trim();
  if (normalized.length <= maxLength) return normalized;

  const sentenceWindow = normalized.slice(0, maxLength + 1);
  const sentenceEnd = Math.max(
    sentenceWindow.lastIndexOf(". "),
    sentenceWindow.lastIndexOf("! "),
    sentenceWindow.lastIndexOf("? "),
  );
  if (sentenceEnd >= 100) return sentenceWindow.slice(0, sentenceEnd + 1).trim();

  const wordWindow = normalized.slice(0, maxLength - 1);
  const wordEnd = wordWindow.lastIndexOf(" ");
  const trimmed = wordWindow.slice(0, wordEnd > 100 ? wordEnd : wordWindow.length).replace(/[,:;\-–—\s]+$/g, "").trim();
  return `${trimmed}…`;
};

const metaDescription = conciseDescription(String(replaceRetiredPublicText(description)));
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(socialImagePath, Astro.site);
const ogLocale = ogLocaleOverride ?? localeConfig[locale].ogLocale;
const alternateOgLocales = alternates
  .filter((alternate) => alternate.lang !== locale && alternate.lang !== "x-default")
  .map((alternate) => localeConfig[alternate.lang as SiteLocale]?.ogLocale)
  .filter((value, index, all): value is string => Boolean(value) && all.indexOf(value) === index);
const safeSchema = schema
  ? replaceRetiredPublicText(schema) as Record<string, unknown> | Record<string, unknown>[]
  : undefined;
const schemaEntities = safeSchema ? (Array.isArray(safeSchema) ? safeSchema : [safeSchema]) : [];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="msvalidate.01" content="6C08FCA62443E761BAB1CCF747A4A7A7" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />)}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/source-sans-3-latin.woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {feedUrl && <link rel="alternate" type="application/rss+xml" title="Hermes Insights RSS" href={new URL(feedUrl, Astro.site)} />}
    <meta property="og:type" content={ogType} />
    {ogType === "article" && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {ogType === "article" && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:url" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={String(socialImageWidth)} />
    <meta property="og:image:height" content={String(socialImageHeight)} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:site_name" content="Hermes" />
    <meta property="og:locale" content={ogLocale} />
    {alternateOgLocales.map((altLocale) => <meta property="og:locale:alternate" content={altLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="theme-color" content="#0a164f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/design-owner-polish.css" />
    <script is:inline src="/design-owner-polish.js" defer={Astro.url.pathname !== "/services/hermes-connect/repair-shops/dashboard/"}></script>
    {isHermesConnectExperienceRoute && <script is:inline src="/hermes-connect-product-priority.js" defer></script>}
    <script is:inline>
      (() => {
        if (!window.location.pathname.startsWith("/services/hermes-connect")) return;

        const supported = new Set(["en", "uk", "ru", "es", "it", "fr"]);
        const params = new URLSearchParams(window.location.search);
        const requested = params.get("lang")?.toLowerCase() ?? null;
        let stored = null;
        try { stored = window.localStorage.getItem("hermes-connect-language"); } catch {}
        const hasExplicitLocale = requested !== null;
        const cleanEnglishEntry = window.location.pathname === "/services/hermes-connect/"
          || window.location.pathname === "/services/hermes-connect/access/";
        const active = hasExplicitLocale
          ? (requested && supported.has(requested) ? requested : "en")
          : (!cleanEnglishEntry && stored && supported.has(stored) ? stored : "en");
        document.documentElement.lang = active;
        try { window.localStorage.setItem("hermes-connect-language", active); } catch {}

        if (!hasExplicitLocale && active !== "en") {
          const normalized = new URL(window.location.href);
          normalized.searchParams.set("lang", active);
          window.history.replaceState(window.history.state, "", normalized.pathname + normalized.search + normalized.hash);
        }

        document.addEventListener("DOMContentLoaded", () => {
          const current = new URL(window.location.href);

          document.querySelectorAll("[data-language-menu] a[lang], .mobile-language-switcher a[lang]").forEach((node) => {
            if (!(node instanceof HTMLAnchorElement)) return;
            const target = node.getAttribute("lang") || "en";
            if (!supported.has(target)) return;

            const next = new URL(current.href);
            if (target === "en") next.searchParams.delete("lang");
            else next.searchParams.set("lang", target);
            node.href = `${next.pathname}${next.search}${next.hash}`;

            node.addEventListener("click", (event) => {
              event.preventDefault();
              try { window.localStorage.setItem("hermes-connect-language", target); } catch {}
              window.location.assign(node.href);
            });
          });

          document.querySelectorAll('a[href^="/services/hermes-connect/"]:not([lang])').forEach((node) => {
            if (!(node instanceof HTMLAnchorElement)) return;
            const next = new URL(node.getAttribute("href") || "", window.location.origin);
            if (active === "en") next.searchParams.delete("lang");
            else next.searchParams.set("lang", active);
            node.href = `${next.pathname}${next.search}${next.hash}`;
          });
        }, { once: true });
      })();
    </script>
    <script is:inline>
      if (window.location.pathname === "/logistics/carrier-onboarding/") {
        const selectedPlan = new URLSearchParams(window.location.search).get("plan");
        if (["essential", "pro", "custom"].includes(selectedPlan || "")) {
          document.addEventListener("DOMContentLoaded", () => {
            const radio = document.querySelector(`input[name="selected_plan"][value="${selectedPlan}"]`);
            if (!(radio instanceof HTMLInputElement)) return;
            radio.checked = true;
            radio.dispatchEvent(new Event("change", { bubbles: true }));
          }, { once: true });
        }
      }
    </script>
    {/* One JSON-LD block per entity: a top-level array is valid JSON-LD, but third-party parsers
        (Microsoft Clarity) read `["@context"]` on the parsed root and throw on arrays. */}
    {schemaEntities.map((entity) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entity)} />)}
    {isRepairShopBookingRoute && <script is:inline src="/repair-shop-public-read-dedupe.js"></script>}
    {isRepairShopLaunchRoute && <script is:inline src="/repair-shop-local-demo.js"></script>}
    <title>{title}</title>
  </head>
  <body data-direction-family={directionFamily}>
    <!--email_off-->
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    {isHermesConnectExperienceRoute && <HermesConnectCommandPalette />}
    <LoadBoardCapacityEnhancer />
    {isRepairShopLaunchRoute && <RepairShopFreeLaunchOffer />}
    <TrackingConsent clarityEligible={clarityEligible} locale={locale} />
    <SiteTrafficCollector />
    <MoneyPageActionBar />
    <CarrierContractJourney />
    <CarrierContractSafetyEnhancer />
    <ProductionContactMode />
    <RepairBookingGrowthEnhancer />
    <RepairPartnerOfferEnhancer />
    <RepairShopActivationEnhancer />
    <ContactLinkEnhancer />
    <SeoIntakeEnhancer />
    <SeoSupportingIntakeEnhancer />
    <WebsiteProjectScopeEnhancer />
    <CarrierQualificationEnhancer />
    <Seo4ConversionEnhancer />
    <VehicleTransportCtaEnhancer />
    <RouteEstimateEnhancer />
    <MotionLayer />
    <!--/email_off-->
  </body>
</html>
