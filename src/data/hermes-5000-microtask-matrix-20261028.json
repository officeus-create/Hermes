  "source_head": "ea9afa2f755a01d50cdd2e6ad4ad91bd0f6d00cf",
  "purpose": "Deterministic 5000-microtask repository hygiene matrix: 200 real Markdown artifacts x 25 bounded integrity/safety checks.",
  "artifact_count": 200,
  "checks_per_artifact": 25,
  "expected_microtasks": 5000,
  "task_id_range": "M0001..M5000",
  "no_live_write": true,
  "no_second_control_plane": true,
  "no_paid_fallback": true,
  "selection": {
    "roots": [
      "docs/",
      "ai-collaboration/"
    ],
    "extension": ".md",
    "max_bytes": 200000,
    "ordering": "lexicographic path",
    "selected": "first 200 matching blobs from source_head"
  },
  "task_id_formula": "M + zeroPad(((artifact.rank - 1) * 25) + check.rank, 4)",
  "checks": [
    {
      "rank": 1,
      "id": "C01",
      "key": "manifest_path_present",
      "description": "Manifest path is a non-empty string."
